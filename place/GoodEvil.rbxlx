		<Item class="ModuleScript" referent="RBXF070D5DAD6774E95BCE2ADD406C8E320">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PlayerService.luau : join/leave lifecycle, attribute mirroring, leaderstats, spawn/respawn, MaxHealth/WalkSpeed,
-- playtime, Regular's Luck minutes, the no-player-collision group (addendum A7-5), fall rescue (A10), slope limit
-- (A11-R2), camera zoom limits (A12) and BindToClose.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local TAG = "PlayerService"

local PlayerService = {}

-- public signals (top level so they exist before any Init)
PlayerService.PlayerReady = Util.Signal.new() -- (player, data)
PlayerService.PlayerLeaving = Util.Signal.new() -- (player, data) fired once, BEFORE the final save
PlayerService.CharacterSpawned = Util.Signal.new() -- (player, character, humanoid)
PlayerService.CharacterDied = Util.Signal.new() -- (player, character)

local S = nil

local ready = {} -- [Player] = true
local joining = {} -- [Player] = true while the data load runs
local finalizing = {} -- [Player] = true while FinalizeLeave runs
local removed = setmetatable({}, { __mode = "k" }) -- [Player] = true once PlayerRemoving fired
local conns = {} -- [Player] = { RBXScriptConnection }
local lastActive = {} -- [Player] = os.clock() of the last input/combat
local regularMinutes = {} -- [Player] = active minutes on this server
local mirrored = {} -- [key] = true for every key of Config.Data.Mirrored
local closing = false

local COLLISION_GROUP = Config.Player.CollisionGroup or "Players"
local collisionGroupOk = false

local CHILD_TIMEOUT = 5 -- seconds to wait for Humanoid / HumanoidRootPart / parenting
local CLOSE_TIMEOUT = 25 -- BindToClose budget
local FINALIZE_WAIT = 30 -- a second FinalizeLeave call waits this long for the first one
local LEADERSTAT_KEYS = { "Level", "BankGold", "CarriedGold", "Rebirths", "Honor", "Infamy", "Faction" }

-- A10: a player below this Y (anywhere: sea, river bed, out of the world) is put back on their home spawn.
-- Swimming stays enabled on player Humanoids (the water surface is at Y = -1.2).
local FALL_RESCUE_Y = -20
local FALL_CHECK_INTERVAL = Config.Travel.ZoneTick or 0.5
local MAX_SLOPE_ANGLE = 46 -- A11-R2: Terrain ridges (>= 50 deg) cannot be walked over
local CAMERA_MAX_ZOOM = 40 -- A12: players never see the whole world (kaiju may raise it while transformed)
local CAMERA_MIN_ZOOM = 6
------------------------------------------------------------------ helpers
local lastLoopWarn = {}
local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= 10 then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

local function addConn(player, conn)
	local list = conns[player]
	if not list then
		list = {}
		conns[player] = list
	end
	table.insert(list, conn)
end

-- persisted value (data table first, attribute as fallback)
local function stat(player, key, default)
	local data = S.DataService.Get(player)
	local v = data and data[key]
	if v == nil then v = player:GetAttribute(key) end
	if v == nil then return default end
	return v
end

local function classDef(player)
	local cs = S.ClassService
	if cs and cs.GetClassDef then
		local ok, def = pcall(cs.GetClassDef, player)
		if ok and type(def) == "table" then return def end
	end
	return Config.Classes[stat(player, "Class", "Warrior")] or Config.Classes.Warrior
end

local function healthMult(player)
	local js = S.JusticeService
	if js and js.GetHealthMult then
		local ok, m = pcall(js.GetHealthMult, player)
		if ok and type(m) == "number" and m == m and m > 0 and m < math.huge then return m end
	end
	return 1
end

local function computeMaxHealth(player)
	local level = tonumber(stat(player, "Level", 1)) or 1
	local faction = stat(player, "Faction", "None")
	local class = stat(player, "Class", "Warrior")
	return math.max(1, math.floor(Config.MaxHealth(level, faction, class) * healthMult(player)))
end

-- health/speed formula on a given humanoid (used on spawn and by RefreshCharacter)
local function applyStats(player, humanoid, fullHeal)
	local maxHP = computeMaxHealth(player)
	if humanoid.Health <= 0 then
		humanoid.MaxHealth = maxHP -- never revive
		return
	end
	local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
	humanoid.MaxHealth = maxHP
	if fullHeal then
		humanoid.Health = maxHP
	else
		humanoid.Health = math.clamp(ratio * maxHP, 1, maxHP)
	end
	humanoid.WalkSpeed = Config.Player.WalkSpeed * (classDef(player).WalkSpeedMult or 1)
end

local function spawnCFrame(zoneId)
	local zs = S.ZoneService
	if zs and zs.GetSpawnCFrame then
		local ok, cf = pcall(zs.GetSpawnCFrame, zoneId)
		if ok and typeof(cf) == "CFrame" then return cf end
		if not ok then Util.Warn(TAG, "GetSpawnCFrame failed: " .. tostring(cf)) end
	end
	local z = Config.Zones[zoneId] or Config.Zones.Crossroads
	return CFrame.new(z.Spawn + Vector3.new(0, 4, 0))
end

local function loadCharacter(player)
	if player.Parent == nil then return end
	local ok, err = pcall(player.LoadCharacter, player)
	if not ok then
		Util.Warn(TAG, "LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
end

-- A12: on join and on every CharacterAdded (max first, so min never exceeds max)
local function applyCameraLimits(player)
	local ok, err = pcall(function()
		player.CameraMaxZoomDistance = CAMERA_MAX_ZOOM
		player.CameraMinZoomDistance = CAMERA_MIN_ZOOM
	end)
	if not ok then
		loopWarn("camera limits", err)
	end
end

-- A10: below FALL_RESCUE_Y -> home spawn (the sack / kaiju state is untouched, like the enemy-town bounce)
local function rescueIfFallen(player)
	local character = Util.GetCharacter(player)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or root.Position.Y >= FALL_RESCUE_Y then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	character:PivotTo(spawnCFrame(Config.HomeZoneId(stat(player, "Faction", "None"))))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

------------------------------------------------------------------ collision group (A7-5)
local function setupCollisionGroup()
	local ok, err = pcall(function()
		if not PhysicsService:IsCollisionGroupRegistered(COLLISION_GROUP) then
			PhysicsService:RegisterCollisionGroup(COLLISION_GROUP)
		end
		PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, COLLISION_GROUP, false)
	end)
	collisionGroupOk = ok
	if not ok then
		Util.Warn(TAG, "collision group setup failed: " .. tostring(err))
	end
end

local function setPartGroup(inst)
	if inst:IsA("BasePart") then
		inst.CollisionGroup = COLLISION_GROUP
	end
end

local function assignCollisionGroup(character)
	if not collisionGroupOk then return end
	for _, d in character:GetDescendants() do
		setPartGroup(d)
	end
	-- the connection dies with the character
	character.DescendantAdded:Connect(setPartGroup)
end

------------------------------------------------------------------ leaderstats
local function toInt(v)
	v = tonumber(v) or 0
	if v ~= v or v == math.huge or v == -math.huge then return 0 end
	return math.floor(v)
end

local function buildLeaderstats(player)
	local old = player:FindFirstChild("leaderstats")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local function intValue(name)
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = folder
		return v
	end
	-- creation order = column order in the player list
	local levelV = intValue("레벨")
	local goldV = intValue("골드")
	local rebirthV = intValue("환생")
	local fameV = intValue("명성")

	local function update()
		levelV.Value = toInt(player:GetAttribute("Level"))
		goldV.Value = toInt(player:GetAttribute("BankGold")) + toInt(player:GetAttribute("CarriedGold"))
		rebirthV.Value = toInt(player:GetAttribute("Rebirths"))
		local f = player:GetAttribute("Faction")
		if f == "Halo" then
			fameV.Value = toInt(player:GetAttribute("Honor"))
		elseif f == "Horns" then
			fameV.Value = toInt(player:GetAttribute("Infamy"))
		else
			fameV.Value = 0 -- None / Neutral (phase 2 adds 장인 명성)
		end
	end
	update()
	folder.Parent = player

	for _, key in LEADERSTAT_KEYS do
		addConn(player, player:GetAttributeChangedSignal(key):Connect(update))
	end
end

------------------------------------------------------------------ character lifecycle
local function onCharacterAdded(player, character)
	assignCollisionGroup(character)

	local humanoid = character:WaitForChild("Humanoid", CHILD_TIMEOUT)
	local root = character:WaitForChild("HumanoidRootPart", CHILD_TIMEOUT)
	if not humanoid or not root or not humanoid:IsA("Humanoid") then
		if player.Character == character then
			Util.Warn(TAG, "character of " .. player.Name .. " has no Humanoid/HumanoidRootPart; skipped")
		end
		return
	end
	humanoid.MaxSlopeAngle = MAX_SLOPE_ANGLE -- A11-R2 (Swimming stays enabled for players, A10)
	if player.Character ~= character or not ready[player] then return end
	applyCameraLimits(player)

	-- CharacterAdded can fire before the model is parented: wait until it is in the world before placing it
	local t0 = os.clock()
	while character.Parent == nil and os.clock() - t0 < CHILD_TIMEOUT do
		task.wait()
	end
	if player.Character ~= character or character.Parent == nil or not ready[player] then return end

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	applyStats(player, humanoid, true)
	character:PivotTo(spawnCFrame(Config.HomeZoneId(stat(player, "Faction", "None"))))

	humanoid.Died:Once(function()
		-- a character already replaced by LoadCharacter (Respawn) is not a death
		if not ready[player] or player.Parent == nil or player.Character ~= character then return end
		PlayerService.CharacterDied:Fire(player, character)
		task.delay(Config.Player.RespawnTime, function()
			if player.Parent and player.Character == character and ready[player] then
				loadCharacter(player)
			end
		end)
	end)

	PlayerService.CharacterSpawned:Fire(player, character, humanoid)
end

------------------------------------------------------------------ join
local function onJoin(player)
	if ready[player] or joining[player] or finalizing[player] then return end
	applyCameraLimits(player) -- A12: before the first character
	joining[player] = true
	local ok, data = pcall(S.DataService.Load, player)
	joining[player] = nil
	if not ok then
		Util.Warn(TAG, "load error for " .. player.Name .. ": " .. tostring(data))
		data = nil
	end
	if player.Parent == nil then return end

	-- left (or the server started closing) while the load was finishing: hand the data straight back
	if data ~= nil and (removed[player] or closing) then
		pcall(S.DataService.Release, player)
		return
	end
	if data == nil then
		player:Kick(string.format(Config.Text.LoadFailed))
		return
	end

	for _, key in Config.Data.Mirrored do
		local v = data[key]
		if v ~= nil and type(v) ~= "table" then
			player:SetAttribute(key, v)
		end
	end
	regularMinutes[player] = 0
	player:SetAttribute("RegularMinutes", 0)
	buildLeaderstats(player)

	-- connected before PlayerReady so a Respawn() from a PlayerReady handler is never missed
	addConn(player, player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end))

	ready[player] = true
	player:SetAttribute("DataLoaded", true)
	PlayerService.PlayerReady:Fire(player, data)

	if ready[player] then
		loadCharacter(player)
	end
end

------------------------------------------------------------------ shutdown
local function onClose()
	closing = true
	local targets = {}
	for _, p in Players:GetPlayers() do
		targets[p] = true
	end
	for p in ready do
		targets[p] = true
	end

	local pending = 0
	for p in targets do
		pending += 1
		task.spawn(function()
			local ok, err = pcall(PlayerService.FinalizeLeave, p)
			if not ok then Util.Warn(TAG, "FinalizeLeave on close failed: " .. tostring(err)) end
			pending -= 1
		end)
	end

	local t0 = os.clock()
	while (pending > 0 or next(finalizing) ~= nil or next(joining) ~= nil) and os.clock() - t0 < CLOSE_TIMEOUT do
		task.wait(0.1)
	end
end

------------------------------------------------------------------ public API
function PlayerService.Init(registry)
	S = registry
	Players.CharacterAutoLoads = false
	for _, key in Config.Data.Mirrored do
		mirrored[key] = true
	end
	setupCollisionGroup()
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onJoin, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		removed[player] = true
		PlayerService.FinalizeLeave(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end

	game:BindToClose(onClose)

	-- playtime
	task.spawn(function()
		local step = Config.Player.PlaytimeTick
		while true do
			task.wait(step)
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(PlayerService.AddStat, p, "PlaytimeSeconds", step)
				if not ok then loopWarn("playtime loop", err) end
			end
		end
	end)

	-- A10 fall rescue (sea / out of the world)
	task.spawn(function()
		while true do
			task.wait(FALL_CHECK_INTERVAL)
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(rescueIfFallen, p)
				if not ok then loopWarn("fall rescue loop", err) end
			end
		end
	end)

	-- Regular's Luck: one minute counts if the player had input/combat within it
	task.spawn(function()
		local period = Config.Luck.MinuteSeconds
		while true do
			task.wait(period)
			local now = os.clock()
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(function()
					local t = lastActive[p]
					if t and now - t <= period then
						local n = (regularMinutes[p] or 0) + 1
						regularMinutes[p] = n
						p:SetAttribute("RegularMinutes", n)
					end
				end)
				if not ok then loopWarn("regular-minutes loop", err) end
			end
		end
	end)

	print("[PlayerService] started")
end

function PlayerService.IsReady(player)
	return player ~= nil and ready[player] == true
end

function PlayerService.GetReadyPlayers()
	local out = {}
	for _, p in Players:GetPlayers() do
		if ready[p] then
			table.insert(out, p)
		end
	end
	return out
end

function PlayerService.GetData(player)
	return S.DataService.Get(player)
end

function PlayerService.SetStat(player, key, value)
	local data = S.DataService.Get(player)
	if not data then return end
	data[key] = value
	if mirrored[key] then
		player:SetAttribute(key, value)
	end
end

function PlayerService.AddStat(player, key, delta)
	local data = S.DataService.Get(player)
	if not data then return 0 end
	local newValue = (tonumber(data[key]) or 0) + (tonumber(delta) or 0)
	PlayerService.SetStat(player, key, newValue)
	return newValue
end

function PlayerService.Respawn(player)
	if not ready[player] or player.Parent == nil then return end
	task.spawn(loadCharacter, player)
end

-- recompute MaxHealth + WalkSpeed of the current character (keeps the HP ratio unless fullHeal)
function PlayerService.RefreshCharacter(player, fullHeal)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid then return end
	applyStats(player, humanoid, fullHeal == true)
end

-- idempotent: PlayerLeaving + final save once; always clears per-player state
function PlayerService.FinalizeLeave(player)
	if finalizing[player] then
		local t0 = os.clock()
		while finalizing[player] and os.clock() - t0 < FINALIZE_WAIT do
			task.wait(0.1)
		end
		return
	end

	if ready[player] then
		finalizing[player] = true
		PlayerService.PlayerLeaving:Fire(player, S.DataService.Get(player))
		ready[player] = nil -- loops and remotes stop touching the player while the final save runs
		local ok, err = pcall(S.DataService.Release, player)
		if not ok then
			Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(err))
		end
		finalizing[player] = nil
	end

	ready[player] = nil
	Util.ClearPlayer(player)
	lastActive[player] = nil
	regularMinutes[player] = nil
	local list = conns[player]
	conns[player] = nil
	if list then
		for _, c in list do
			c:Disconnect()
		end
	end
end

function PlayerService.MarkActive(player)
	if ready[player] then
		lastActive[player] = os.clock()
	end
end

function PlayerService.GetRegularMinutes(player)
	return regularMinutes[player] or 0
end

return PlayerService
]]></ProtectedString>
				<string name="ScriptGuid">{9CB03D85-BD6E-43A3-A623-30E8318DAD97}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PlayerService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f3690000241f</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXC4CFE0F88F2E47009F415211DDF01BFB">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ZoneService.luau : zone tracking, level gates, enemy-town bounce, Travel remote, teleport pads, spawn CFrames.
--
-- Zones are XZ rectangles from Config (Config.ZoneAt); the current zone of every ready player is cached here and
-- mirrored to the attributes ZoneId / ZonePvP / ZoneTown. Addendum A3-L1 + A6: a Halo/Horns/Neutral player standing in a
-- faction town that is not theirs (Neutral: either faction town) is bounced to the Crossroads spawn
-- (kaiju and sack carriers too; the sack keeps its state). "None" (no faction chosen yet) is not bounced.
-- An Active kaiju may enter no faction town at all (not even its own): Halo is bounced out of HornsTown, so a kaiju
-- waiting there could never be reached; it is bounced to Crossroads, where Halo can still hit it.
-- A10: a player below Y = -20 (fell under the Terrain world) is teleported to their home spawn.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local ZoneService = {}

ZoneService.ZoneChanged = Util.Signal.new() -- (player, newZoneId, oldZoneId)

local TAG = "ZoneService"
local DEFAULT_ZONE = "Crossroads"
local SPAWN_JITTER = 6 -- random XZ offset in [-6, 6]
local SPAWN_LIFT = 4 -- spawn CFrame is 4 studs above the ground
local GATE_NOTIFY_INTERVAL = 3 -- NeedLevel / enemy-town toast at most once per 3 s
local WARN_INTERVAL = 10
local MAX_DEST_LENGTH = 64
local RESCUE_Y = -20 -- addendum A10: below this (anywhere) -> home spawn
local ENEMY_TOWN_FALLBACK = "상대 진영 마을에는 들어갈 수 없어요!" -- used only if Config.Text.EnemyTown is missing
local KAIJU_TOWN_FALLBACK = "괴수는 마을에 들어갈 수 없어요!" -- TODO(config): Config.Text.KaijuNoTown (used if present)

local S = nil
local zoneIds = {} -- [Player] = cached zone id
local lastGateNotify = {} -- [Player] = os.clock() of the last bounce toast
local lastPadTouch = {} -- [Player] = os.clock() of the last handled pad touch
local hookedPads = setmetatable({}, { __mode = "k" }) -- [BasePart] = true
local lastWarnAt = {}

-- "Home" plus every real zone id listed in Config.Travel.Destinations
local validDestinations = {}
for _, d in Config.Travel.Destinations do
	if d.Id ~= "Home" and Config.Zones[d.Id] then
		validDestinations[d.Id] = true
	end
end

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_INTERVAL then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, msg)
end

local function fmt(key, ...)
	local s = Config.Text[key]
	if type(s) ~= "string" then return nil end
	return string.format(s, ...)
end

local function notify(player, text, kind)
	if type(text) == "string" and text ~= "" then
		Net.Notify(player, text, kind)
	end
end

local function getFaction(player)
	if S and S.FactionService then
		return S.FactionService.GetFaction(player)
	end
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function getLevel(player)
	return tonumber(player:GetAttribute("Level")) or 1
end

local function kaijuState(player)
	local ks = S.KaijuService and S.KaijuService.GetState(player)
	return type(ks) == "string" and ks or "None"
end

local function isKaiju(player)
	local ks = kaijuState(player)
	return ks == "Siren" or ks == "Active"
end

local function hasSack(player)
	return S.GrudgeService ~= nil and S.GrudgeService.HasSack(player) == true
end

local function getStars(player)
	local n = S.PvPService and S.PvPService.GetStars(player)
	return tonumber(n) or 0
end

local function inCombat(player)
	return S.CombatService ~= nil and S.CombatService.IsInCombat(player) == true
end

local function lastDamagedAt(player)
	local t = S.CombatService and S.CombatService.GetLastDamagedAt(player)
	return tonumber(t) or 0
end

-- pivots the character to a zone spawn; false when there is no character / root
local function teleport(player, zoneId)
	local character = Util.GetCharacter(player)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	character:PivotTo(ZoneService.GetSpawnCFrame(zoneId))
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function notifyBounce(player, text)
	if not text then return end
	local now = os.clock()
	local last = lastGateNotify[player]
	if last and now - last < GATE_NOTIFY_INTERVAL then return end
	lastGateNotify[player] = now
	notify(player, text, "bad")
end

-- bounce toast text when the player may not stand in this faction town, else nil.
-- A3-L1 / A6: a faction town that is not the player's own; "None" (no side chosen yet) is never bounced.
-- An Active kaiju: every faction town (see header).
local function forbiddenTownText(player, zone)
	if not zone.Town or zone.Faction == nil then return nil end
	if kaijuState(player) == "Active" then
		return fmt("KaijuNoTown") or KAIJU_TOWN_FALLBACK
	end
	local f = getFaction(player)
	if f == "None" or f == zone.Faction then return nil end
	return fmt("EnemyTown") or ENEMY_TOWN_FALLBACK
end

-- the zone-loop body (also run on CharacterSpawned and right after a teleport)
local function updateZone(player)
	if not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return end
	local root = Util.GetRoot(player)
	if not root then return end
	if root.Position.Y < RESCUE_Y then
		-- A10 rescue (an Active kaiju goes to Crossroads directly: it may not stand in its home town)
		local home = (kaijuState(player) == "Active") and DEFAULT_ZONE or Config.HomeZoneId(getFaction(player))
		teleport(player, home)
		return
	end
	local zone = Config.ZoneAt(root.Position)

	if getLevel(player) < zone.MinLevel then
		teleport(player, DEFAULT_ZONE)
		notifyBounce(player, fmt("NeedLevel", zone.MinLevel))
		return
	end
	local townText = forbiddenTownText(player, zone)
	if townText then
		teleport(player, DEFAULT_ZONE)
		notifyBounce(player, townText)
		return
	end

	local old = zoneIds[player] or DEFAULT_ZONE
	if zone.Id == old then return end
	zoneIds[player] = zone.Id
	player:SetAttribute("ZoneId", zone.Id)
	player:SetAttribute("ZonePvP", zone.PvP == true)
	player:SetAttribute("ZoneTown", zone.Town == true)

	local oldZone = Config.Zones[old]
	local wasPvP = oldZone ~= nil and oldZone.PvP == true
	if zone.PvP and not wasPvP then
		notify(player, fmt("EnteredPvP"), "bad")
	elseif not zone.PvP and wasPvP then
		notify(player, fmt("EnteredSafe"), "good")
	end
	ZoneService.ZoneChanged:Fire(player, zone.Id, old)
end

local function cleanup(player)
	zoneIds[player] = nil
	lastGateNotify[player] = nil
	lastPadTouch[player] = nil
end

------------------------------------------------------------------ public API
function ZoneService.GetZoneId(player)
	return zoneIds[player] or DEFAULT_ZONE
end

function ZoneService.GetZone(player)
	return Config.Zones[ZoneService.GetZoneId(player)] or Config.Zones[DEFAULT_ZONE]
end

function ZoneService.IsPvPZone(player)
	return ZoneService.GetZone(player).PvP == true
end

function ZoneService.IsTown(player)
	return ZoneService.GetZone(player).Town == true
end

-- zone.Spawn + random XZ offset in [-6, 6] + (0, 4, 0), facing into the zone. Pure: safe to call any time.
function ZoneService.GetSpawnCFrame(zoneId)
	local zone = Config.Zones[zoneId] or Config.Zones[DEFAULT_ZONE]
	local base = zone.Spawn
	local pos = Vector3.new(
		base.X + Util.Random:NextNumber(-SPAWN_JITTER, SPAWN_JITTER),
		base.Y + SPAWN_LIFT,
		base.Z + Util.Random:NextNumber(-SPAWN_JITTER, SPAWN_JITTER)
	)
	local look = Vector3.new(zone.Center.X, pos.Y, zone.Center.Z)
	if (look - pos).Magnitude > 1 then
		return CFrame.lookAt(pos, look)
	end
	return CFrame.new(pos)
end

-- "Home" -> Config.HomeZoneId(faction); others must be a zone id in Config.Travel.Destinations
function ZoneService.ResolveDestination(player, destId)
	if type(destId) ~= "string" then return nil end
	if destId == "Home" then
		return Config.HomeZoneId(getFaction(player))
	end
	if validDestinations[destId] then return destId end
	return nil
end

local function finishChannel(player, zoneId, start)
	if player.Parent == nil then return end
	player:SetAttribute("TravelingUntil", 0)
	local zone = Config.Zones[zoneId]
	local canGo = zone ~= nil
		and S.PlayerService.IsReady(player)
		and Util.IsAlive(player)
		and lastDamagedAt(player) < start
		and not inCombat(player) -- swings / releases landed during the channel tag the attacker (no escape by Travel)
		and not hasSack(player)
		and not isKaiju(player)
		and getStars(player) < Config.PvP.NoTravelStars
		and getLevel(player) >= zone.MinLevel
	if canGo and teleport(player, zoneId) then
		updateZone(player)
	else
		notify(player, fmt("TravelCancelled"), "bad")
	end
end

-- (ok, reasonText?) — instant = pads; otherwise a ChannelSeconds channel cancelled by damage / combat tag / sack / kaiju / stars
function ZoneService.Travel(player, destId, instant)
	if not Util.IsAlive(player) then return false, nil end
	local zoneId = ZoneService.ResolveDestination(player, destId)
	local zone = zoneId and Config.Zones[zoneId]
	if not zone then return false, nil end
	if getLevel(player) < zone.MinLevel then
		return false, fmt("NeedLevel", zone.MinLevel)
	end
	if isKaiju(player) then
		return false, fmt("TravelBlockedKaiju")
	end
	if hasSack(player) then
		return false, fmt("TravelBlockedSack")
	end
	if getStars(player) >= Config.PvP.NoTravelStars then
		return false, fmt("TravelBlockedStars")
	end
	if inCombat(player) then
		return false, fmt("TravelBlockedCombat")
	end
	if (tonumber(player:GetAttribute("TravelingUntil")) or 0) > Util.Now() then
		return false, nil
	end

	if instant then
		if not teleport(player, zoneId) then return false, nil end
		updateZone(player)
		return true, nil
	end

	player:SetAttribute("TravelingUntil", Util.Now() + Config.Travel.ChannelSeconds)
	notify(player, fmt("Traveling"), "info")
	local start = os.clock()
	task.delay(Config.Travel.ChannelSeconds, function()
		local ok, err = pcall(finishChannel, player, zoneId, start)
		if not ok then
			warnThrottled("channel", "travel channel error: " .. tostring(err))
			if player.Parent then player:SetAttribute("TravelingUntil", 0) end
		end
	end)
	return true, nil
end

------------------------------------------------------------------ remote / pads
local function onTravelRemote(player, destId)
	if not S.PlayerService.IsReady(player) then return end
	if type(destId) ~= "string" or #destId > MAX_DEST_LENGTH then return end
	if not Util.RateLimit(player, "Travel", Config.RateLimits.Travel) then return end
	S.PlayerService.MarkActive(player)
	local ok, accepted, reason = pcall(ZoneService.Travel, player, destId, false)
	if not ok then
		warnThrottled("travel", "Travel error: " .. tostring(accepted))
		return
	end
	if not accepted and reason then
		notify(player, reason, "bad")
	end
end

local function playerFromHit(hit)
	local node = hit and hit.Parent
	while node and node ~= workspace do
		if node:IsA("Model") then
			local p = Players:GetPlayerFromCharacter(node)
			if p then return p end
		end
		node = node.Parent
	end
	return nil
end

local function onPadTouched(pad, hit)
	local dest = pad:GetAttribute("TravelTo")
	if type(dest) ~= "string" then return end
	local player = playerFromHit(hit)
	if not player or not S.PlayerService.IsReady(player) then return end
	local now = os.clock()
	local last = lastPadTouch[player]
	if last and now - last < Config.Travel.PadDebounce then return end
	lastPadTouch[player] = now
	local ok, accepted, reason = pcall(ZoneService.Travel, player, dest, true)
	if not ok then
		warnThrottled("pad", "pad travel error: " .. tostring(accepted))
		return
	end
	if not accepted and reason then
		notify(player, reason, "bad")
	end
end

local function hookPad(pad)
	if hookedPads[pad] or not pad:IsA("BasePart") then return end
	if pad:GetAttribute("TravelTo") == nil then return end
	hookedPads[pad] = true
	pad.Touched:Connect(function(hit)
		onPadTouched(pad, hit)
	end)
end

local function hookPadsFolder(map)
	local pads = map and map:FindFirstChild("Pads")
	if not pads then
		Util.Warn(TAG, "workspace.Map.Pads not found; travel pads are inactive")
		return
	end
	for _, child in pads:GetChildren() do
		hookPad(child)
	end
	-- pads added later (e.g. MapBuilder.Build re-creating a missing pad)
	pads.ChildAdded:Connect(function(child)
		task.defer(hookPad, child) -- attributes are set right after parenting
	end)
end

------------------------------------------------------------------ lifecycle
function ZoneService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player)
		zoneIds[player] = DEFAULT_ZONE
		player:SetAttribute("ZoneId", DEFAULT_ZONE)
		player:SetAttribute("ZonePvP", false)
		player:SetAttribute("ZoneTown", true)
		player:SetAttribute("TravelingUntil", 0)
	end)
	S.PlayerService.CharacterSpawned:Connect(function(player)
		updateZone(player)
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		-- deferred: other PlayerLeaving handlers may still read the cached zone
		task.defer(cleanup, player)
	end)
end

function ZoneService.Start()
	Net.Get("Travel").OnServerEvent:Connect(onTravelRemote)

	hookPadsFolder(workspace:FindFirstChild("Map"))
	-- MapBuilder.Rebuild() replaces workspace.Map: hook the new pads too
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Map" then
			task.defer(hookPadsFolder, child)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		task.defer(cleanup, player)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Travel.ZoneTick)
			for _, player in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(updateZone, player)
				if not ok then
					warnThrottled("loop", "zone loop error: " .. tostring(err))
				end
			end
		end
	end)

	print("[ZoneService] started")
end

return ZoneService
]]></ProtectedString>
				<string name="ScriptGuid">{69E89686-D00F-4087-A40F-27BDE2906E4A}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ZoneService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f3690000242b</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXDFC573710BAD423EB20F846C339DAED7">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- GooseService.luau : golden goose tug-of-war ("황금 거위 줄다리기"), Regular's Luck rare rewards, cheer stars.
-- Owner: G9. Public surface (TECH_SPEC §4.16): GooseFinished, Init, Start, IsActive, GetPosition, RegisterHit, DebugStart.
-- SPEC_ADDENDUM A1: ServerStorage.CustomModels.GoldenGoose (Model or BasePart) replaces the procedural body visually.
-- SPEC_ADDENDUM A6: only Halo/Horns players add tug counts and receive tug rewards (Neutral/None count 0).
-- Review fixes: a reward needs >= MIN_MANUAL_HITS manual counts (auto-only AFK players still pull, never get paid), and a
-- faction switch mid-event forfeits that player's entry (no pulling for one side and collecting the other's win).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "GooseService"
local GOOSE_LABEL = "황금 거위" -- billboard text required verbatim by TECH_SPEC §4.16
local CUSTOM_FOLDER = (Config.CustomModels and Config.CustomModels.FolderName) or "CustomModels" -- A1
local CUSTOM_ID = (Config.CustomModels and Config.CustomModels.GooseId) or "GoldenGoose" -- A1
-- review fix (anti-AFK): rewards (and GooseFinished participation) need this many ACCEPTED manual counts this event;
-- auto-attack counts still move the tug but alone never pay. Candidate for Config.Goose.MinManualHits (G1).
local MIN_MANUAL_HITS = 3
local TXT_NEED_MANUAL = "황금 거위 보상은 직접 %d번 이상 때린 사람만 받아요! (자동 공격만으로는 보상 없음)"
local MAX_SIDE_OFFSET = 6 -- studs; tug pivot clamp (§4.16)
local VISUAL_BOTTOM = -2.0 -- procedural body bottom relative to the goose center
local VISUAL_HEIGHT = 6.9 -- procedural body height (body bottom -> crown-shard tip)
local BOB_AMPLITUDE = 0.35
local BOB_SPEED = 2.4
local SWAY_ANGLE = math.rad(12)
local SWAY_SPEED = 0.8
local SIDE_LERP = 2.5 -- per second
local WARN_INTERVAL = 10

local COLOR_GOLD = Color3.fromRGB(255, 200, 40)
local COLOR_GOLD_DARK = Color3.fromRGB(225, 160, 25)
local COLOR_BEAK = Color3.fromRGB(255, 135, 30)
local COLOR_EYE = Color3.fromRGB(20, 20, 20)
local COLOR_SHARD = Color3.fromRGB(255, 245, 170)
local COLOR_LIGHT = Color3.fromRGB(255, 215, 110)
local COLOR_LABEL_STROKE = Color3.fromRGB(90, 55, 0)

-- procedural body, offsets relative to the goose center (local -Z = forward / the goose's LookVector)
local PROCEDURAL_PARTS = {
	{ Name = "Body", Class = "Part", Size = Vector3.new(4, 4, 4), At = CFrame.new(0, 0, 0.2), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Chest", Class = "Part", Size = Vector3.new(3, 3, 3), At = CFrame.new(0, 0.5, -1.1), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Tail", Class = "WedgePart", Size = Vector3.new(1.6, 1.2, 1.6), At = CFrame.new(0, 0.9, 2.3) * CFrame.Angles(0, math.pi, 0), Color = COLOR_GOLD_DARK },
	{ Name = "Neck", Class = "Part", Size = Vector3.new(0.9, 2.4, 0.9), At = CFrame.new(0, 2.0, -1.8), Color = COLOR_GOLD, Shiny = true },
	{ Name = "Head", Class = "Part", Size = Vector3.new(1.6, 1.6, 1.6), At = CFrame.new(0, 3.4, -1.9), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Beak", Class = "WedgePart", Size = Vector3.new(0.55, 0.45, 1.0), At = CFrame.new(0, 3.25, -3.0), Color = COLOR_BEAK },
	{ Name = "EyeL", Class = "Part", Size = Vector3.new(0.32, 0.32, 0.32), At = CFrame.new(-0.6, 3.6, -2.45), Color = COLOR_EYE, Ball = true },
	{ Name = "EyeR", Class = "Part", Size = Vector3.new(0.32, 0.32, 0.32), At = CFrame.new(0.6, 3.6, -2.45), Color = COLOR_EYE, Ball = true },
	{ Name = "WingL", Class = "Part", Size = Vector3.new(0.35, 1.6, 2.8), At = CFrame.new(-2.0, 0.35, 0.3) * CFrame.Angles(0, 0, math.rad(25)), Color = COLOR_GOLD_DARK },
	{ Name = "WingR", Class = "Part", Size = Vector3.new(0.35, 1.6, 2.8), At = CFrame.new(2.0, 0.35, 0.3) * CFrame.Angles(0, 0, math.rad(-25)), Color = COLOR_GOLD_DARK },
	{ Name = "CrownShard", Class = "WedgePart", Size = Vector3.new(0.35, 0.9, 0.7), At = CFrame.new(0, 4.45, -1.9) * CFrame.Angles(0, math.rad(90), math.rad(12)), Color = COLOR_SHARD, Neon = true },
}

local GooseService = {}
GooseService.GooseFinished = Util.Signal.new() -- (result: "Halo" | "Horns" | "Tie", counts: { [Player]: number })

local S = nil
local gameState = nil

-- event state
local active = false
local endsAt = 0
local nextAt = 0
local rescue = 0
local poach = 0
local counts = {} -- [Player] = number (faction-scaled tug counts this event)
local manualHits = {} -- [Player] = accepted MANUAL counts this event (reward eligibility)
local sideOf = {} -- [Player] = faction the player's counts were made for ("Halo" | "Horns")
local hitTimes = {} -- [Player] = { os.clock() } accepted counts within the rolling 1 s window
local publishedRescue = -1
local publishedPoach = -1

-- model state
local gooseModel = nil
local gooseRoot = nil
local motionConn = nil
local sideOffset = 0
local sideTarget = 0

local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	if now - (lastWarnAt[key] or -math.huge) >= WARN_INTERVAL then
		lastWarnAt[key] = now
		Util.Warn(TAG, tostring(msg))
	end
end

-- pcall-protected call into another service; returns its FIRST result, or nil (and warns, throttled) on failure
local function call(serviceName, fnName, ...)
	local svc = S and S[serviceName]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		warnThrottled(serviceName .. "." .. fnName, "missing " .. serviceName .. "." .. fnName)
		return nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warnThrottled(serviceName .. "." .. fnName, serviceName .. "." .. fnName .. " failed: " .. tostring(result))
		return nil
	end
	return result
end

local function getGameState()
	if gameState and gameState.Parent then return gameState end
	local ok, gs = pcall(Net.GameState)
	if ok and gs then gameState = gs end
	return gameState
end

local function setGame(key, value)
	local gs = getGameState()
	if gs then gs:SetAttribute(key, value) end
end

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player")
end

local function isReady(p)
	return isPlayer(p) and p.Parent ~= nil and call("PlayerService", "IsReady", p) == true
end

local function factionOf(p)
	local f = call("FactionService", "GetFaction", p)
	if type(f) ~= "string" then return "None" end
	return f
end

local function isTugFaction(f)
	return f == "Halo" or f == "Horns"
end

-- persisted numeric stat: live data table first, mirrored attribute as fallback
local function getNum(p, key)
	local data = call("PlayerService", "GetData", p)
	local v = (type(data) == "table") and data[key] or nil
	if type(v) ~= "number" then v = p:GetAttribute(key) end
	return tonumber(v) or 0
end

local function round1(x)
	return math.floor(x * 10 + 0.5) / 10
end

local function gooseCenter()
	return Config.Goose.Position + Vector3.new(0, Config.Goose.HoverHeight, 0)
end

-- the goose faces the Crossroads fountain
local function baseRotation()
	local c = gooseCenter()
	local f = Config.Map.FountainPosition
	local look = Vector3.new(f.X, c.Y, f.Z)
	if (look - c).Magnitude < 0.1 then return CFrame.new() end
	local cf = CFrame.lookAt(c, look)
	return cf - cf.Position
end

-- next goose start: aligned to WarService's round end minus OffsetFromWarEnd, advanced by Interval past `now`
local function computeNextAt(now, fallback)
	local base = fallback
	local roundEnd = call("WarService", "GetRoundEndsAt")
	if type(roundEnd) == "number" and roundEnd == roundEnd and roundEnd > now - 86400 then
		base = roundEnd - Config.Goose.OffsetFromWarEnd
	end
	if type(base) ~= "number" or base ~= base or base < now - 86400 then
		base = now + Config.Goose.OffsetFromWarEnd
	end
	local interval = math.max(1, Config.Goose.Interval)
	if base <= now then
		base += (math.floor((now - base) / interval) + 1) * interval
	end
	return base
end

------------------------------------------------------------------ goose model
local function prepVisualPart(p)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
end

local function getCustomTemplate()
	local folder = ServerStorage:FindFirstChild(CUSTOM_FOLDER)
	if not folder then return nil end
	local t = folder:FindFirstChild(CUSTOM_ID)
	if t and (t:IsA("Model") or t:IsA("BasePart")) then return t end
	return nil
end

-- world-space vertical extent of a set of parts (exact for box-shaped parts)
local function worldYRange(parts)
	local minY, maxY = math.huge, -math.huge
	for _, p in parts do
		local cf, s = p.CFrame, p.Size
		local half = math.abs(cf.RightVector.Y) * s.X / 2 + math.abs(cf.UpVector.Y) * s.Y / 2 + math.abs(cf.LookVector.Y) * s.Z / 2
		minY = math.min(minY, cf.Position.Y - half)
		maxY = math.max(maxY, cf.Position.Y + half)
	end
	return minY, maxY
end

local function buildProcedural(model, root, rootCF)
	for _, def in PROCEDURAL_PARTS do
		local p = Util.MakePart({
			ClassName = def.Class,
			Name = def.Name,
			Size = def.Size,
			CFrame = rootCF * def.At,
			Color = def.Color,
			Material = def.Neon and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			Reflectance = def.Shiny and 0.15 or 0,
		})
		if def.Ball and p:IsA("Part") then p.Shape = Enum.PartType.Ball end
		prepVisualPart(p)
		p.Parent = model
		Util.Weld(root, p)
	end
end

-- A1: clone the custom visual, scale it to the procedural height, put its bottom where the procedural body's is,
-- face the root's LookVector and weld every part to the root. Returns true on success.
local function buildCustom(model, root, rootCF, template)
	local clone = template:Clone()
	local rot = rootCF - rootCF.Position
	local targetBottom = rootCF.Position.Y + VISUAL_BOTTOM
	local parts = {}
	if clone:IsA("BasePart") then
		prepVisualPart(clone)
		local h = clone.Size.Y
		if h > 0.01 then clone.Size = clone.Size * (VISUAL_HEIGHT / h) end
		clone.CFrame = CFrame.new(rootCF.Position.X, targetBottom + clone.Size.Y / 2, rootCF.Position.Z) * rot
		table.insert(parts, clone)
	else
		for _, d in clone:GetDescendants() do
			if d:IsA("BasePart") then
				prepVisualPart(d)
				table.insert(parts, d)
			elseif d:IsA("BaseScript") then
				d:Destroy() -- a purely cosmetic visual never runs code
			end
		end
		if #parts == 0 then
			clone:Destroy()
			return false
		end
		clone:PivotTo(CFrame.new(rootCF.Position) * rot)
		local minY, maxY = worldYRange(parts)
		local height = maxY - minY
		if height > 0.01 then
			local okScale = pcall(function()
				clone:ScaleTo(clone:GetScale() * (VISUAL_HEIGHT / height))
			end)
			if not okScale then warnThrottled("customScale", "custom GoldenGoose could not be scaled; using its own size") end
		end
		minY = worldYRange(parts)
		clone:PivotTo(clone:GetPivot() + Vector3.new(0, targetBottom - minY, 0))
	end
	clone.Name = "Visual"
	clone.Parent = model
	for _, p in parts do
		Util.Weld(root, p)
	end
	return true
end

local function destroyModel()
	if motionConn then
		motionConn:Disconnect()
		motionConn = nil
	end
	if gooseModel then
		gooseModel:Destroy()
	end
	gooseModel = nil
	gooseRoot = nil
end

local function startMotion(rot)
	if motionConn then motionConn:Disconnect() end
	local t0 = os.clock()
	motionConn = RunService.Heartbeat:Connect(function(dt)
		local root = gooseRoot
		if not root or not root.Parent then return end
		sideOffset += (sideTarget - sideOffset) * math.min(1, dt * SIDE_LERP)
		local t = os.clock() - t0
		local bob = math.sin(t * BOB_SPEED) * BOB_AMPLITUDE
		local sway = math.sin(t * SWAY_SPEED) * SWAY_ANGLE
		root.CFrame = CFrame.new(gooseCenter() + Vector3.new(sideOffset, bob, 0)) * rot * CFrame.Angles(0, sway, 0)
	end)
end

local function spawnModel()
	destroyModel()
	local effects = Util.GetFolder(workspace, "Effects")
	local old = effects:FindFirstChild("GoldenGoose")
	if old then old:Destroy() end

	local rot = baseRotation()
	local rootCF = CFrame.new(gooseCenter()) * rot

	local model = Instance.new("Model")
	model.Name = "GoldenGoose"

	-- invisible anchored root: one CFrame write moves the whole goose (bob + tug pivot)
	local root = Util.MakePart({
		Name = "Root",
		Size = Vector3.new(3, 3, 3),
		CFrame = rootCF,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	root.Parent = model
	model.PrimaryPart = root

	local template = getCustomTemplate()
	local built = false
	if template then
		local ok, res = pcall(buildCustom, model, root, rootCF, template)
		built = ok and res == true
		if not built then
			warnThrottled("custom", "custom GoldenGoose failed, using the procedural goose: " .. tostring(res))
			local partial = model:FindFirstChild("Visual")
			if partial then partial:Destroy() end
		end
	end
	if not built then
		buildProcedural(model, root, rootCF)
	end

	local light = Instance.new("PointLight")
	light.Color = COLOR_LIGHT
	light.Brightness = 2
	light.Range = 16
	light.Shadows = false
	light.Parent = root

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkles"
	sparkles.Color = ColorSequence.new(COLOR_SHARD)
	sparkles.LightEmission = 1
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(1.5, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	sparkles.Parent = root

	local gui = Instance.new("BillboardGui")
	gui.Name = "GooseLabel"
	gui.Size = UDim2.fromOffset(220, 44)
	gui.StudsOffset = Vector3.new(0, 6.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	gui.Adornee = root
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = COLOR_GOLD
	label.TextStrokeColor3 = COLOR_LABEL_STROKE
	label.TextStrokeTransparency = 0.2
	label.Text = GOOSE_LABEL
	local sizeLimit = Instance.new("UITextSizeConstraint")
	sizeLimit.MinTextSize = 11
	sizeLimit.MaxTextSize = 36
	sizeLimit.Parent = label
	label.Parent = gui
	gui.Parent = root

	model.Parent = effects
	gooseModel = model
	gooseRoot = root
	sideOffset, sideTarget = 0, 0
	startMotion(rot)
end

------------------------------------------------------------------ event flow
local function publishTotals(force)
	local r, p = round1(rescue), round1(poach)
	if force or r ~= publishedRescue then
		publishedRescue = r
		setGame("GooseRescue", r)
	end
	if force or p ~= publishedPoach then
		publishedPoach = p
		setGame("GoosePoach", p)
	end
end

local function start()
	if active then return end
	active = true
	endsAt = Util.Now() + Config.Goose.Duration
	rescue, poach = 0, 0
	counts = {}
	manualHits = {}
	sideOf = {}
	hitTimes = {}
	publishTotals(true)
	setGame("GooseEndsAt", endsAt)
	setGame("GooseActive", true)

	local players = call("PlayerService", "GetReadyPlayers")
	if type(players) == "table" then
		for _, p in players do
			if p.Parent then p:SetAttribute("GooseCount", 0) end
		end
	end

	local ok, err = pcall(spawnModel)
	if not ok then
		warnThrottled("spawn", "goose model failed: " .. tostring(err))
	end
	Net.NotifyAll(string.format(Config.Story.GooseStart))
end

-- forget a player's entry for this event; what they already pulled stays in the side totals (like a leaver)
local function dropEntry(p)
	counts[p] = nil
	manualHits[p] = nil
	sideOf[p] = nil
	hitTimes[p] = nil
	if isPlayer(p) and p.Parent then
		p:SetAttribute("GooseCount", 0)
	end
end

-- f = the side the player's counts were made for, re-verified against the current faction by finish()
local function rewardPlayer(p, result, f)
	if not isTugFaction(f) then return end -- A6: Neutral (and None) get no tug rewards
	local won = (result == f)

	local rare
	if getNum(p, "CheerStars") >= Config.Goose.CheerStarsForRare then
		rare = true
		call("PlayerService", "AddStat", p, "CheerStars", -Config.Goose.CheerStarsForRare)
	else
		local minutes = tonumber(call("PlayerService", "GetRegularMinutes", p)) or 0
		rare = Util.Random:NextNumber() < Config.RareChance(minutes)
	end

	local level = math.max(1, math.floor(getNum(p, "Level")))
	local gold, xp = Config.GooseReward(level, f, won, rare)
	if gold > 0 then call("ProgressionService", "AddBankGold", p, gold, "Event") end
	if xp > 0 then call("ProgressionService", "AddXP", p, xp) end
	Net.Notify(p, string.format(Config.Text.GooseReward, Util.FormatNumber(gold), Util.FormatNumber(xp)), "reward")

	if rare then
		Net.Fx(p, "Rare", { Gold = gold, XP = xp })
		Net.NotifyAll(string.format(Config.Text.RareAnnounce, p.DisplayName), "info")
	end

	if not won then -- loss or tie: +1 cheer star
		local cheer = getNum(p, "CheerStars")
		if cheer < Config.Goose.CheerStarsForRare then
			local newCount = call("PlayerService", "AddStat", p, "CheerStars", 1)
			cheer = tonumber(newCount) or (cheer + 1)
		end
		Net.Notify(p, string.format(Config.Text.GooseCheer, math.floor(cheer)), "info")
	end
end

local function finish()
	if not active then return end
	active = false
	-- schedule the next goose FIRST so a failure below can never re-trigger an event every tick
	endsAt = 0
	nextAt = computeNextAt(Util.Now(), nextAt)
	setGame("GooseNextAt", nextAt)

	local result = (rescue > poach) and "Halo" or ((poach > rescue) and "Horns" or "Tie")
	local fxPos = (gooseRoot and gooseRoot.Parent) and gooseRoot.Position or gooseCenter()
	local finalCounts, finalManual, finalSide = counts, manualHits, sideOf
	counts = {}
	manualHits = {}
	sideOf = {}
	hitTimes = {}

	-- paid participants: counts > 0, still on the side they pulled for, and enough MANUAL hits (auto-only = AFK)
	local rewarded = {}
	for p, n in finalCounts do
		if type(n) == "number" and n > 0 and isReady(p) then
			local f = factionOf(p)
			if isTugFaction(f) and finalSide[p] == f then
				if (finalManual[p] or 0) >= MIN_MANUAL_HITS then
					rewarded[p] = n
					local ok, err = pcall(rewardPlayer, p, result, f)
					if not ok then warnThrottled("reward", "goose reward failed for " .. p.Name .. ": " .. tostring(err)) end
				else
					pcall(Net.Notify, p, string.format(TXT_NEED_MANUAL, MIN_MANUAL_HITS), "info")
				end
			end
		end
	end

	if result ~= "Tie" then
		call("WarService", "AddFactionPoints", result, Config.Goose.WinWarPoints)
	end
	local okSend, sendErr = pcall(function()
		Net.NotifyAll(string.format(Config.Story.GooseResult[result]))
		Net.Fx(nil, "GooseEnd", { Pos = fxPos, Winner = result })
	end)
	if not okSend then warnThrottled("send", "goose result broadcast failed: " .. tostring(sendErr)) end

	destroyModel()
	for p in finalCounts do
		if isPlayer(p) and p.Parent then p:SetAttribute("GooseCount", 0) end
	end
	publishTotals(true)
	setGame("GooseActive", false)
	setGame("GooseEndsAt", 0)

	-- same shape as the spec's counts ({ [Player]: number }), limited to the players who were actually paid,
	-- so quest progress never goes to AFK auto-swingers or side-switchers
	GooseService.GooseFinished:Fire(result, rewarded)
end

local function tick()
	local now = Util.Now()
	if not active then
		if now >= nextAt then start() end
		return
	end
	if now >= endsAt then
		finish()
		return
	end
	local total = rescue + poach
	sideTarget = math.clamp((poach - rescue) / math.max(1, total) * MAX_SIDE_OFFSET, -MAX_SIDE_OFFSET, MAX_SIDE_OFFSET)
	publishTotals(false)
end

------------------------------------------------------------------ public API
function GooseService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player)
		if isPlayer(player) and player.Parent then
			player:SetAttribute("GooseCount", 0)
		end
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		-- the leaver's contribution stays in the side totals
		counts[player] = nil
		manualHits[player] = nil
		sideOf[player] = nil
		hitTimes[player] = nil
	end)
	-- review fix: switching sides mid-event (altar is next to the perch) forfeits this event's entry, so nobody can pull
	-- for one side and then collect the winner share of the other. Pulling again after the switch starts a new entry.
	local fs = S.FactionService
	if fs and fs.FactionChanged then
		fs.FactionChanged:Connect(function(player)
			if counts[player] ~= nil or hitTimes[player] ~= nil then
				dropEntry(player)
			end
		end)
	else
		warnThrottled("factionChanged", "FactionService.FactionChanged missing; side switches are caught at finish only")
	end
end

function GooseService.Start()
	getGameState()
	nextAt = computeNextAt(Util.Now(), nil)
	setGame("GooseNextAt", nextAt)
	setGame("GooseActive", false)
	setGame("GooseEndsAt", 0)
	publishTotals(true)

	task.spawn(function()
		while true do
			task.wait(Config.Goose.Tick)
			local ok, err = pcall(tick)
			if not ok then warnThrottled("loop", "tick error: " .. tostring(err)) end
		end
	end)

	print("[GooseService] custom model for " .. CUSTOM_ID .. ": " .. (getCustomTemplate() and "yes" or "no"))
	print("[GooseService] started")
end

function GooseService.IsActive()
	return active
end

function GooseService.GetPosition()
	if not active then return nil end
	return gooseCenter()
end

function GooseService.RegisterHit(player, isManual)
	if not active then return end
	if not isReady(player) then return end
	local f = factionOf(player)
	if not isTugFaction(f) then return end -- A6: Neutral swings on the goose count 0
	if sideOf[player] ~= nil and sideOf[player] ~= f then
		dropEntry(player) -- defensive: faction changed without a FactionChanged signal -> fresh entry for the new side
	end

	-- rolling 1 s window: at most MaxCountsPerSecond accepted counts per player
	local now = os.clock()
	local list = hitTimes[player]
	if not list then
		list = {}
		hitTimes[player] = list
	end
	while list[1] and now - list[1] >= 1 do
		table.remove(list, 1)
	end
	if #list >= Config.Goose.MaxCountsPerSecond then return end
	table.insert(list, now)

	local scale = tonumber(call("JusticeService", "GetFactionScale", f)) or 1
	if scale ~= scale or scale <= 0 then scale = 1 end
	local amount = ((isManual == true) and Config.Goose.ManualCount or Config.Goose.AutoCount) * scale
	counts[player] = (counts[player] or 0) + amount
	sideOf[player] = f
	if isManual == true then
		manualHits[player] = (manualHits[player] or 0) + 1
	end
	if f == "Halo" then
		rescue += amount
	else
		poach += amount
	end
	player:SetAttribute("GooseCount", math.floor(counts[player]))
end

function GooseService.DebugStart()
	if active then return end
	local ok, err = pcall(start)
	if not ok then warnThrottled("debug", "DebugStart failed: " .. tostring(err)) end
end

return GooseService
]]></ProtectedString>
				<string name="ScriptGuid">{28515B98-7D3F-491B-9F7D-E4FB0A98F0A6}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GooseService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f36900002435</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0299A9DE02994237AAF4C67D5F7109BB">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- WarService.luau : crown war meter ("왕관 쟁탈전") — 10-minute rounds, faction points, blessing, sky color, war chests.
--
-- Story: each round decides which side "holds the crown"; the sky turns the crown's color (Dawn gold / Eclipse blood).
-- Only Halo and Horns take part (addendum A6): Neutral and None never earn war points, never get a chest and never
-- hold the blessing; per-capita scores use FactionService.GetCounts (Halo vs Horns only).
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local WarService = {}

local TAG = "WarService"
local WAR_FACTIONS = { Halo = true, Horns = true }
local WARN_INTERVAL = 10

-- docs/ART_DIRECTION.md 3.1: fixed lighting applied once in Start (this service owns Lighting; no Atmosphere, A9-3).
-- Values match the A11 Elden-Ring mood baked by tools/preview_map.lua (ShadowSoftness 0.2, Bloom 24/1.4, rays spread 0.4)
-- so the server start does not change the look the creator approved in Studio.
local LIGHTING_FIXED = {
	GlobalShadows = true, ShadowSoftness = 0.2, GeographicLatitude = 35,
	EnvironmentDiffuseScale = 0.3, EnvironmentSpecularScale = 0.3,
}
local TINT_FIXED = { Brightness = 0.02, Contrast = 0.1, Saturation = 0.2 } -- only TintColor is tweened
local SKY_FIXED = { SunAngularSize = 14, MoonAngularSize = 18, StarCount = 3000 }
local BLOOM_FIXED = { Size = 24, Threshold = 1.4 }
local SUNRAYS_FIXED = { Spread = 0.4 }
-- ART_DIRECTION 3.2 per-sky values used only where Config.Sky[name] has no key of its own (Config.Sky stays the source
-- for everything it carries: FogStart / ExposureCompensation / BloomIntensity are read from the preset first).
-- Neutral = A11 (exposure -0.1, bloom 0.4) + preview sun rays 0.08.
local SKY_EXTRAS = {
	Neutral = { Exposure = -0.1, Bloom = 0.4, SunRays = 0.08, Clouds = Color3.fromRGB(255, 255, 255) },
	Dawn = { Exposure = 0.15, Bloom = 0.6, SunRays = 0.12, Clouds = Color3.fromRGB(255, 225, 190) },
	Eclipse = { Exposure = 0.35, Bloom = 0.7, SunRays = 0, Clouds = Color3.fromRGB(110, 40, 50) }, -- monsters stay visible at night
}

local S = nil
local points = { Halo = 0, Horns = 0 } -- faction pools of the current round
local personal = {} -- [Player] = personal points of the current round
local blessing = "None" -- faction holding the crown (decided at each round end, lasts one round)
local roundEndsAt = 0
local warTint = nil
local skyTweens = {}
local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_INTERVAL then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, msg)
end

local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function getFaction(player)
	if S and S.FactionService then
		local ok, f = pcall(S.FactionService.GetFaction, player)
		if ok and type(f) == "string" then return f end
	end
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function isValidAmount(n)
	return type(n) == "number" and n == n and n > 0 and n < math.huge
end

local function round1(x)
	return math.floor(x * 10 + 0.5) / 10
end

local function setPersonal(player, value)
	personal[player] = value
	if player.Parent then
		player:SetAttribute("WarPoints", value)
	end
end

------------------------------------------------------------------ sky
-- sets each property in its own pcall (newer Lighting properties may be missing on older engines)
local function setProps(inst, props)
	for k, v in props do
		local ok, err = pcall(function()
			inst[k] = v
		end)
		if not ok then
			warnThrottled("prop:" .. k, ("could not set %s.%s: %s"):format(inst.ClassName, k, tostring(err)))
		end
	end
end

local function findOrCreate(parent, className)
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Parent = parent
	end
	return inst
end

local function ensureTint()
	if warTint and warTint.Parent == Lighting then return warTint end
	local existing = Lighting:FindFirstChild("WarTint")
	if existing and existing:IsA("ColorCorrectionEffect") then
		warTint = existing
	else
		if existing then
			existing.Name = "WarTint_Old" -- something else took the contract name; keep it, but out of the way
		end
		warTint = Instance.new("ColorCorrectionEffect")
		warTint.Name = "WarTint"
		setProps(warTint, TINT_FIXED)
		warTint.Parent = Lighting
	end
	return warTint
end

-- ART_DIRECTION 3.1, once in Start
local function bootstrapLighting()
	pcall(function()
		Lighting.LightingStyle = Enum.LightingStyle.Soft
	end)
	pcall(function()
		Lighting.PrioritizeLightingQuality = true
	end)
	setProps(Lighting, LIGHTING_FIXED)
	setProps(ensureTint(), TINT_FIXED)
	setProps(findOrCreate(Lighting, "Sky"), SKY_FIXED)
	setProps(findOrCreate(Lighting, "BloomEffect"), BLOOM_FIXED)
	setProps(findOrCreate(Lighting, "SunRaysEffect"), SUNRAYS_FIXED)
	if Lighting:FindFirstChildOfClass("Atmosphere") then
		Util.Warn(TAG, "Lighting has an Atmosphere: it hides the FogColor/FogEnd war sky (addendum A9-3). Remove it.")
	end
end

local function skyNameFor(winner)
	if winner == "Halo" then return "Dawn" end
	if winner == "Horns" then return "Eclipse" end
	return "Neutral"
end

local function num(v)
	return (type(v) == "number" and v == v) and v or nil
end

-- applies Config.Sky[name] to Lighting + WarTint (FogStart / ExposureCompensation / BloomIntensity when the preset has
-- them, addendum A9-4/A11/A12), plus the ART_DIRECTION extras for whatever the preset does not carry
local function applySky(name, animate)
	local preset = Config.Sky[name]
	if type(preset) ~= "table" then return end
	local extras = SKY_EXTRAS[name] or SKY_EXTRAS.Neutral
	for _, t in skyTweens do
		t:Cancel()
	end
	table.clear(skyTweens)

	local lightingGoal = {
		ClockTime = preset.ClockTime, Brightness = preset.Brightness, Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient, FogColor = preset.FogColor, FogEnd = preset.FogEnd,
		FogStart = num(preset.FogStart), -- nil (left as is) when the preset has none
		ExposureCompensation = num(preset.ExposureCompensation) or extras.Exposure,
	}
	local fogStart, fogEnd = lightingGoal.FogStart, num(preset.FogEnd)
	if fogStart and fogEnd and fogStart >= fogEnd then
		lightingGoal.FogStart = math.max(0, fogEnd - 1) -- FogStart must stay below FogEnd
	end
	local goals = { { Lighting, lightingGoal } }
	if preset.Tint then
		table.insert(goals, { ensureTint(), { TintColor = preset.Tint } })
	end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then table.insert(goals, { bloom, { Intensity = num(preset.BloomIntensity) or extras.Bloom } }) end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then table.insert(goals, { rays, { Intensity = extras.SunRays } }) end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then table.insert(goals, { clouds, { Color = extras.Clouds } }) end

	if animate then
		local info = TweenInfo.new(Config.Sky.TweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		for _, g in goals do
			local ok, tweenOrErr = pcall(TweenService.Create, TweenService, g[1], info, g[2])
			if ok then
				table.insert(skyTweens, tweenOrErr)
				tweenOrErr:Play()
			else
				warnThrottled("tween", "sky tween failed: " .. tostring(tweenOrErr))
				setProps(g[1], g[2])
			end
		end
	else
		for _, g in goals do
			setProps(g[1], g[2])
		end
	end
end

------------------------------------------------------------------ round state
local function getCounts()
	if not (S and S.FactionService) then return 0, 0 end
	local ok, halo, horns = pcall(S.FactionService.GetCounts)
	if not ok then
		warnThrottled("counts", "GetCounts failed: " .. tostring(halo))
		return 0, 0
	end
	return tonumber(halo) or 0, tonumber(horns) or 0
end

local function modeFor(halo, horns)
	if halo == 0 and horns == 0 then return "Idle" end
	if halo == 0 or horns == 0 then return "Siege" end
	return "Normal"
end

-- writes the per-capita scores, mode and round end to GameState; returns (haloScore, hornsScore, mode)
local function publish(halo, horns)
	local haloScore = points.Halo / math.max(1, halo)
	local hornsScore = points.Horns / math.max(1, horns)
	local mode = modeFor(halo, horns)
	local gs = Net.GameState()
	gs:SetAttribute("WarHaloScore", round1(haloScore))
	gs:SetAttribute("WarHornsScore", round1(hornsScore))
	gs:SetAttribute("WarRoundEndsAt", roundEndsAt)
	gs:SetAttribute("WarMode", mode)
	return haloScore, hornsScore, mode
end

local function decideWinner(mode, haloScore, hornsScore, halo, horns)
	if mode == "Normal" then
		if haloScore > hornsScore then return "Halo" end
		if hornsScore > haloScore then return "Horns" end
		return "None"
	elseif mode == "Siege" then
		local present = (halo > 0) and "Halo" or "Horns"
		local score = (present == "Halo") and haloScore or hornsScore
		if score >= Config.War.SiegeTarget then return present end
		return "None"
	end
	return "None" -- Idle
end

local function payChests(winner, snapshot)
	for _, player in S.PlayerService.GetReadyPlayers() do
		local ok, err = pcall(function()
			local f = getFaction(player)
			if not WAR_FACTIONS[f] then return end
			if (snapshot[player] or 0) < Config.War.ChestMinPoints then return end
			local level = tonumber(player:GetAttribute("Level")) or 1
			local perLevel = (winner ~= "None" and f == winner) and Config.War.WinnerChestPerLevel or Config.War.LoserChestPerLevel
			local amount = math.floor(level * perLevel)
			if amount <= 0 then return end
			S.ProgressionService.AddBankGold(player, amount, "War")
			Net.Notify(player, string.format(Config.Text.WarChest, Util.FormatNumber(amount)), "reward")
		end)
		if not ok then
			warnThrottled("chest", "war chest error: " .. tostring(err))
		end
	end
end

local function endRound(mode, haloScore, hornsScore, halo, horns)
	-- advance + reset first so a failure below can never re-trigger the same round end every tick
	local snapshot = table.clone(personal)
	roundEndsAt = Util.Now() + Config.War.RoundSeconds
	points.Halo = 0
	points.Horns = 0
	for player in snapshot do
		setPersonal(player, 0)
	end

	local winner = decideWinner(mode, haloScore, hornsScore, halo, horns)
	blessing = winner
	Net.GameState():SetAttribute("WarBlessing", winner)
	applySky(skyNameFor(winner), true)

	payChests(winner, snapshot)

	if mode ~= "Idle" then
		if winner ~= "None" and Config.Story.WarWin[winner] then
			Net.NotifyAll(string.format(Config.Story.WarWin[winner]))
		else
			Net.NotifyAll(string.format(Config.Story.WarDraw))
		end
	end

	publish(halo, horns)
end

local function tick()
	local halo, horns = getCounts()
	local haloScore, hornsScore, mode = publish(halo, horns)
	if Util.Now() >= roundEndsAt then
		endRound(mode, haloScore, hornsScore, halo, horns)
	end
end

------------------------------------------------------------------ public API
-- personal + faction pool (monster kills, rewarded PvP KOs)
function WarService.AddPoints(player, n)
	if not isPlayer(player) or not isValidAmount(n) then return end
	if not (S and S.PlayerService.IsReady(player)) then return end
	local f = getFaction(player)
	if not WAR_FACTIONS[f] then return end -- None / Neutral never earn war points
	points[f] += n
	setPersonal(player, (personal[player] or 0) + n)
end

-- faction pool only (events: goose, kaiju)
function WarService.AddFactionPoints(factionId, n)
	if not WAR_FACTIONS[factionId] or not isValidAmount(n) then return end
	points[factionId] += n
end

-- blessing faction == player's faction (Halo/Horns only)
function WarService.HasBlessing(player)
	if not isPlayer(player) or blessing == "None" then return false end
	local f = getFaction(player)
	return WAR_FACTIONS[f] == true and f == blessing
end

function WarService.GetBlessingFaction()
	return blessing
end

function WarService.GetPersonalPoints(player)
	return personal[player] or 0
end

-- server time of the current round end; valid after Start
function WarService.GetRoundEndsAt()
	if roundEndsAt <= 0 then
		return Util.Now() + Config.War.RoundSeconds
	end
	return roundEndsAt
end

------------------------------------------------------------------ lifecycle
function WarService.Init(registry)
	S = registry
	ensureTint()

	if S.MonsterService and S.MonsterService.MonsterKilled then
		S.MonsterService.MonsterKilled:Connect(function(player, info)
			if type(info) == "table" then
				WarService.AddPoints(player, info.WarPoints)
			end
		end)
	else
		Util.Warn(TAG, "MonsterService.MonsterKilled missing; monster kills give no war points")
	end

	if S.PvPService and S.PvPService.PlayerKO then
		S.PvPService.PlayerKO:Connect(function(killer, _victim, info)
			if type(info) == "table" and info.Rewarded == true then
				local stars = tonumber(info.VictimStars) or 0
				WarService.AddPoints(killer, Config.War.PvPKOPoints + Config.War.PvPKOPerStar * stars)
			end
		end)
	else
		Util.Warn(TAG, "PvPService.PlayerKO missing; PvP KOs give no war points")
	end

	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player)
			if isPlayer(player) then setPersonal(player, 0) end
		end)
	end

	S.PlayerService.PlayerReady:Connect(function(player)
		setPersonal(player, 0)
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		personal[player] = nil
	end)
end

function WarService.Start()
	bootstrapLighting()
	applySky("Neutral", false)
	roundEndsAt = Util.Now() + Config.War.RoundSeconds
	Net.GameState():SetAttribute("WarBlessing", blessing)
	local halo, horns = getCounts()
	publish(halo, horns)

	task.spawn(function()
		while true do
			task.wait(Config.War.Tick)
			local ok, err = pcall(tick)
			if not ok then
				warnThrottled("tick", "tick error: " .. tostring(err))
			end
		end
	end)

	print("[WarService] started")
end

return WarService
]]></ProtectedString>
				<string name="ScriptGuid">{5D7136B1-7C51-49FA-AB38-5D314572FB0A}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">WarService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f36900002439</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX9B04D10FAD924DF09737E5DE4F00280D">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- MapBuilder.luau : reuses (or minimally builds) workspace.Map: zone floors, walls, gates, pads, altar, board, goose perch.
--
-- Build() is also run from the Studio command bar in EDIT mode to pre-bake the map:
--     require(game.ServerScriptService.MapBuilder).Build()
-- so it never touches S, never yields and is idempotent: every named element is looked up first and only the missing
-- pieces are created; existing functional pieces get their functional bits re-applied (pad TravelTo, AltarPrompt,
-- BoardGui.BoardText, zone floor ZoneId + invisibility, the two-line gate signs).
--
-- The real world is the Studio-saved place built by tools/preview_map.lua (addendum A8/A10/A11: Terrain landscape,
-- sea, rivers, ridges, bridges, sky crown). A reused map is adopted as-is: the four "Wall" parts get the contract names
-- (matched by orientation/side), its gate billboards get the spec text, and NOTHING is added to its ground or decor
-- (A10-V3-1: never a ground plate over the Bounds; it would cover the sea/rivers and z-fight the Terrain land).
-- A11-R3: with no workspace.Map at all, Build() warns and builds only minimal flat ground (Config.Map.Lands plates +
-- bridge decks named "Bridge_*" in Decor) plus the functional pieces; no Terrain, no decorative set.
-- A11-R1: zone floor parts are contract markers only: invisible, CanCollide/CanQuery/CanTouch false (build and reuse).
-- Lighting is never touched here: WarService owns it (addendum A9-3: no Atmosphere, no per-zone ColorCorrection).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local MapBuilder = {}

local TAG = "MapBuilder"
local FOLDER_NAMES = { "Ground", "Zones", "Walls", "Gates", "Pads", "Landmarks", "Decor" }
local WALL_NAMES = { "Wall_MinX", "Wall_MaxX", "Wall_MinZ", "Wall_MaxZ" }
local WALL_THICKNESS = 2
local WALL_ADOPT_LENGTH = 100 -- a pre-baked part at least this long in the Walls folder is a bounds wall
local GATE_HALF_SPAN = 10 -- pillar centers 20 apart (17-stud passage)
local EXTREME_MIN_LEVEL = 25 -- PvP zones from this level use the "extreme" danger color
local SIGN_MAX_DISTANCE = 150
local MAX_LIGHTS = 40 -- whole map
local MAX_LIGHT_RANGE = 40
local MAX_LIGHT_BRIGHTNESS = 2
local PERCH_DIAMETER = 10
local PERCH_HEIGHT = 1
local GROUND_THICKNESS = 4 -- minimal ground plates: top at Y = 0
local BRIDGE_WIDTH = 18 -- default deck width when Config.Map.Bridges has no Width
local ALTAR_PROMPT_KEY = Enum.KeyCode.G -- not E: HUD binds Q/E to Release (would spend stacks while holding the prompt)

local RGB = Color3.fromRGB
local SP = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)

local DANGER = { Safe = RGB(80, 220, 120), PvP = RGB(255, 150, 40), Extreme = RGB(255, 60, 60) }
local LORE_COLOR = RGB(235, 225, 195)
local GATE_STYLE = { SlimeMeadow = "Meadow", GoblinWoods = "Goblin", SkeletonRuins = "Ruins", HaloTown = "Halo", HornsTown = "Horns" }

local S = nil -- registry (stored by Init; Build/Rebuild never use it)

------------------------------------------------------------------ instance helpers
-- ctx = { parts = BaseParts created, pieces = missing named pieces built, lights = PointLights created }
local function newCtx()
	return { parts = 0, pieces = 0, lights = 0 }
end

-- every map part: anchored, locked, SmoothPlastic unless told otherwise, Shape applied before Size, parented last;
-- small (< 4 studs) and Neon parts cast no shadow
local function part(ctx, props, parent, className)
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.Locked = true
	p.Material = SP
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	for k, v in props do
		if k ~= "Shape" then
			p[k] = v
		end
	end
	local s = p.Size
	if math.max(s.X, s.Y, s.Z) < 4 or p.Material == NEON then
		p.CastShadow = false
	end
	p.Parent = parent
	ctx.parts += 1
	return p
end

-- small decoration: no collision, no queries, no touches
local function prop(ctx, props, parent, className)
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return part(ctx, props, parent, className)
end

local function model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	if parent then m.Parent = parent end
	return m
end

local function light(ctx, p, color, range, brightness)
	if ctx.lights >= MAX_LIGHTS then return nil end
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = math.min(range or 16, MAX_LIGHT_RANGE)
	l.Brightness = math.min(brightness or 1.5, MAX_LIGHT_BRIGHTNESS)
	l.Shadows = false
	l.Parent = p
	ctx.lights += 1
	return l
end

local function billboard(adornee, name, text, offsetY, color, width, maxDist, height)
	local bb = Instance.new("BillboardGui")
	bb.Name = name
	bb.Size = UDim2.fromOffset(width or 260, height or 46)
	bb.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = maxDist or SIGN_MAX_DISTANCE
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.RichText = true
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = color or WHITE
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = t
	t.Parent = bb
	bb.Parent = adornee
	return bb
end

-- upright cylinder: props.Size = (diameter, height, diameter), props.Position = center
local function cyl(ctx, props, parent)
	local d, h = props.Size.X, props.Size.Y
	props.Size = Vector3.new(h, d, d)
	props.CFrame = CFrame.new(props.Position) * CFrame.Angles(0, 0, math.rad(90))
	props.Position = nil
	props.Shape = Enum.PartType.Cylinder
	return part(ctx, props, parent)
end

local function disc(ctx, pos, diameter, thickness, color, parent, material)
	return cyl(ctx, {
		Name = "Disc", Size = Vector3.new(diameter, thickness, diameter), Position = pos,
		Color = color, Material = material or SP, CanCollide = false,
	}, parent)
end

-- horizontal ring of n block segments
local function ring(ctx, center, radius, n, size, color, parent, material)
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		prop(ctx, {
			Name = "RingSeg", Size = size,
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)) * CFrame.Angles(0, -a, 0),
			Color = color, Material = material or NEON,
		}, parent)
	end
end

local function getChildFolder(parent, name)
	local f = parent:FindFirstChild(name)
	if f then return f, false end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f, true
end

local function countParts(root)
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

-- moves a wrong-class instance out of the way of a contract name (never destroys user content)
local function retire(inst, suffix)
	Util.Warn(TAG, inst:GetFullName() .. " has the wrong class (" .. inst.ClassName .. "); renamed and rebuilt")
	inst.Name = inst.Name .. suffix
end

------------------------------------------------------------------ text helpers
local function dangerColor(zone)
	if not zone.PvP then return DANGER.Safe end
	if zone.MinLevel >= EXTREME_MIN_LEVEL then return DANGER.Extreme end
	return DANGER.PvP
end

local function hex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function escapeRich(s)
	return (string.gsub(tostring(s), "[<>&]", { ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;" }))
end

local function gateLore(zoneId)
	local lore = Config.Story and Config.Story.ZoneLore
	return (lore and lore[zoneId]) or ""
end

-- line 1 = zone.Name .. "  Lv " .. MinLevel .. "+  " .. ("PvP 지역" | "안전 지역") (safety word in the danger color),
-- line 2 = Config.Story.ZoneLore[zoneId]
local function gateSignText(zoneId, zone)
	local line1 = string.format('%s  Lv %d+  <font color="%s">%s</font>', escapeRich(zone.Name), zone.MinLevel,
		hex(dangerColor(zone)), zone.PvP and "PvP 지역" or "안전 지역")
	local lore = gateLore(zoneId)
	if lore == "" then return line1 end
	return line1 .. string.format('<br/><font color="%s">%s</font>', hex(LORE_COLOR), escapeRich(lore))
end

local function padLabel(zone)
	return "→ " .. zone.Name .. " (Lv " .. zone.MinLevel .. "+)"
end

------------------------------------------------------------------ ground / zones / walls
-- one flat plate, top at Y = 0
local function groundPlate(ctx, folder, name, minX, maxX, minZ, maxZ, color, material)
	if folder:FindFirstChild(name) or maxX <= minX or maxZ <= minZ then return end
	part(ctx, {
		Name = name,
		Size = Vector3.new(maxX - minX, GROUND_THICKNESS, maxZ - minZ),
		Position = Vector3.new((minX + maxX) / 2, -GROUND_THICKNESS / 2, (minZ + maxZ) / 2),
		Color = color, Material = material,
	}, folder)
	ctx.pieces += 1
end

-- deck (top at Y = 0.2, like tools/preview_map.lua) + two collidable rails, as Decor model "Bridge_<Name>"
-- (A11-R1: ground raycasts include workspace.Map.Decor children named "Bridge_*")
local function buildBridge(ctx, decor, entry)
	local name = "Bridge_" .. tostring(entry.Name)
	if decor:FindFirstChild(name) then return end
	local from, to = entry.From, entry.To
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then return end
	from = Vector3.new(from.X, 0, from.Z)
	to = Vector3.new(to.X, 0, to.Z)
	local len = (to - from).Magnitude
	if len < 1 then return end
	local width = tonumber(entry.Width) or BRIDGE_WIDTH
	local cf = CFrame.lookAt((from + to) / 2, to)
	local br = model(name)
	local deck = part(ctx, {
		Name = "Deck", Size = Vector3.new(width, 1, len + 4), CFrame = cf * CFrame.new(0, -0.3, 0),
		Color = RGB(150, 110, 70), Material = Enum.Material.WoodPlanks,
	}, br)
	for _, side in { -1, 1 } do
		part(ctx, {
			Name = "Rail", Size = Vector3.new(0.8, 0.8, len + 4), CFrame = cf * CFrame.new(side * (width / 2 - 0.4), 2.8, 0),
			Color = RGB(110, 80, 50), Material = Enum.Material.Wood,
		}, br)
	end
	br.PrimaryPart = deck
	br.Parent = decor
	ctx.pieces += 1
end

local function terrainHasLand()
	local ok, cells = pcall(function()
		return workspace.Terrain:CountCells()
	end)
	return ok and type(cells) == "number" and cells > 0
end

-- A11-R3: only for a from-scratch build (no workspace.Map). Release builds come from the Studio-saved place (Terrain).
-- Config.Map.Lands plates + Config.Map.Bridges decks; an older Config without Lands gets one plate per zone rectangle.
-- Never one plate over the whole Bounds (A10-V3-1). When Terrain already exists (e.g. Rebuild() in the saved place)
-- the Terrain is the ground: no plates (they would z-fight its Y = 0 top), bridges only.
local function buildLandPlates(ctx, ground)
	local grass, grassColor = Enum.Material.Grass, RGB(106, 150, 72)
	local lands = Config.Map.Lands
	if type(lands) == "table" and #lands > 0 then
		for i, l in lands do
			local minX, maxX, minZ, maxZ = tonumber(l.MinX), tonumber(l.MaxX), tonumber(l.MinZ), tonumber(l.MaxZ)
			if minX and maxX and minZ and maxZ then
				groundPlate(ctx, ground, tostring(l.Name or ("Land" .. i)), minX, maxX, minZ, maxZ, grassColor, grass)
			end
		end
		return
	end
	for _, id in Config.ZoneOrder do
		local z = Config.Zones[id]
		if z then
			local hx, hz = z.Size.X / 2, z.Size.Z / 2
			groundPlate(ctx, ground, "Ground_" .. id, z.Center.X - hx, z.Center.X + hx, z.Center.Z - hz, z.Center.Z + hz,
				z.FloorColor or grassColor, z.FloorMaterial or grass)
		end
	end
end

local function buildMinimalGround(ctx, ground, decor)
	if not terrainHasLand() then
		buildLandPlates(ctx, ground)
	end
	if type(Config.Map.Bridges) == "table" then
		for _, entry in Config.Map.Bridges do
			if type(entry) == "table" then
				buildBridge(ctx, decor, entry)
			end
		end
	end
end

-- A11-R1: zone floors are contract markers only (players and monsters stand on Terrain / Map.Ground)
local function applyFloorMarker(floor)
	if not floor:IsA("BasePart") then return end
	floor.Transparency = 1
	floor.CanCollide = false
	floor.CanQuery = false
	floor.CanTouch = false
	floor.CastShadow = false
end

local function ensureZones(ctx, folder)
	for _, id in Config.ZoneOrder do
		local z = Config.Zones[id]
		if z then
			local floor = folder:FindFirstChild(id)
			if not floor then
				floor = part(ctx, {
					Name = id,
					Size = Vector3.new(z.Size.X, 1, z.Size.Z),
					Position = Vector3.new(z.Center.X, -0.45, z.Center.Z), -- top at Y = 0.05
					Color = z.FloorColor, Material = z.FloorMaterial,
				}, folder)
				ctx.pieces += 1
			end
			applyFloorMarker(floor)
			floor:SetAttribute("ZoneId", id)
		end
	end
end

local function wallSpecs()
	local b = Config.Map.Bounds
	local h = Config.Map.WallHeight
	local t = WALL_THICKNESS
	local lenX = b.MaxX - b.MinX + 2 * t -- overlap the corners
	local lenZ = b.MaxZ - b.MinZ + 2 * t
	local cx, cz = (b.MinX + b.MaxX) / 2, (b.MinZ + b.MaxZ) / 2
	return {
		Wall_MinX = { Size = Vector3.new(t, h, lenZ), Position = Vector3.new(b.MinX - t / 2, h / 2, cz) },
		Wall_MaxX = { Size = Vector3.new(t, h, lenZ), Position = Vector3.new(b.MaxX + t / 2, h / 2, cz) },
		Wall_MinZ = { Size = Vector3.new(lenX, h, t), Position = Vector3.new(cx, h / 2, b.MinZ - t / 2) },
		Wall_MaxZ = { Size = Vector3.new(lenX, h, t), Position = Vector3.new(cx, h / 2, b.MaxZ + t / 2) },
	}
end

-- which bounds edge a pre-baked wall stands on: long along X -> a Z edge, long along Z -> an X edge; side from the
-- map center. Works even when the pre-baked map uses different bounds than Config.
local function classifyWall(wall, center)
	local s = wall.Size
	if math.max(s.X, s.Z) < WALL_ADOPT_LENGTH then return nil end
	if s.X >= s.Z then
		return (wall.Position.Z < center.Z) and "Wall_MinZ" or "Wall_MaxZ"
	end
	return (wall.Position.X < center.X) and "Wall_MinX" or "Wall_MaxX"
end

local function ensureWalls(ctx, folder)
	local specs = wallSpecs()
	local b = Config.Map.Bounds
	local center = Vector3.new((b.MinX + b.MaxX) / 2, 0, (b.MinZ + b.MaxZ) / 2)
	-- adopt pre-baked walls with other names (the preview script calls all four "Wall")
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and specs[child.Name] == nil then
			local name = classifyWall(child, center)
			if name and not folder:FindFirstChild(name) then
				child.Name = name
			end
		end
	end
	for _, name in WALL_NAMES do
		if not folder:FindFirstChild(name) then
			local spec = specs[name]
			part(ctx, {
				Name = name, Size = spec.Size, Position = spec.Position,
				Transparency = 1, CanCollide = true, CastShadow = false,
			}, folder)
			ctx.pieces += 1
		end
	end
end

------------------------------------------------------------------ gates
-- the two-line sign; a pre-baked billboard is adopted (renamed "GateSign", its style kept). Returns 1 if created.
local function ensureGateSign(gate, zoneId, zone)
	local built = 0
	local sign = gate:FindFirstChild("GateSign", true)
	if not (sign and sign:IsA("BillboardGui")) then
		sign = gate:FindFirstChildWhichIsA("BillboardGui", true)
		if sign then
			sign.Name = "GateSign"
			if sign.Size.Y.Offset < 56 then
				sign.Size = UDim2.fromOffset(math.max(sign.Size.X.Offset, 300), 60)
			end
		else
			local anchor = gate:FindFirstChild("Lintel", true)
			if not (anchor and anchor:IsA("BasePart")) then
				anchor = gate:IsA("BasePart") and gate or gate:FindFirstChildWhichIsA("BasePart", true)
			end
			if not anchor then return 0 end
			sign = billboard(anchor, "GateSign", "", 6, WHITE, 320, SIGN_MAX_DISTANCE, 60)
			built = 1
		end
	end
	local label = sign:FindFirstChildWhichIsA("TextLabel", true)
	if not label then
		label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.Parent = sign
	end
	label.RichText = true
	label.TextScaled = true
	label.TextColor3 = WHITE
	label.Text = gateSignText(zoneId, zone)
	return built
end

local function buildGate(ctx, parent, entry, zone)
	local gate = model("Gate_" .. entry.Zone)
	local style = GATE_STYLE[entry.Zone] or (zone.PvP and "Goblin" or "Meadow")
	local pos = entry.Position
	-- the path runs from the gate toward the zone center; the pillars stand across it
	local alongX = math.abs(zone.Center.X - pos.X) >= math.abs(zone.Center.Z - pos.Z)
	local off = alongX and Vector3.new(0, 0, GATE_HALF_SPAN) or Vector3.new(GATE_HALF_SPAN, 0, 0)
	local span = GATE_HALF_SPAN * 2 + 3
	local lintelSize = alongX and Vector3.new(3, 2.5, span) or Vector3.new(span, 2.5, 3)
	-- statues face the incoming path (toward the side away from the zone center)
	local fx = (pos.X - zone.Center.X) >= 0 and 1 or -1
	local lintel

	if style == "Halo" then
		for _, s in { -1, 1 } do
			cyl(ctx, { Name = "Tower", Size = Vector3.new(6, 22, 6), Position = pos + off * s + Vector3.new(0, 11, 0), Color = RGB(245, 242, 235) }, gate)
			part(ctx, {
				Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(6.4, 6.4, 6.4),
				Position = pos + off * s + Vector3.new(0, 22, 0), Color = RGB(212, 175, 55),
			}, gate)
		end
		lintel = part(ctx, { Name = "Lintel", Size = lintelSize, Position = pos + Vector3.new(0, 19, 0), Color = RGB(245, 242, 235) }, gate)
		ring(ctx, pos + Vector3.new(0, 25, 0), 3.5, 8, Vector3.new(0.5, 0.5, 2.8), RGB(255, 225, 130), gate)
	elseif style == "Horns" then
		for _, s in { -1, 1 } do
			part(ctx, {
				Name = "Pillar", Size = Vector3.new(4, 18, 4), Position = pos + off * s + Vector3.new(0, 9, 0),
				Color = RGB(45, 30, 35), Material = Enum.Material.Basalt,
			}, gate)
			for k = 1, 3 do
				local tilt = alongX and CFrame.Angles(math.rad(15 * k * s), 0, 0) or CFrame.Angles(0, 0, math.rad(-15 * k * s))
				prop(ctx, {
					Name = "Horn", Size = Vector3.new(2.4 - k * 0.5, 3, 2.4 - k * 0.5),
					CFrame = CFrame.new(pos + off * s * (1 - k * 0.12) + Vector3.new(0, 18 + k * 2.4, 0)) * tilt,
					Color = RGB(60, 40, 45), Material = Enum.Material.Basalt,
				}, gate, "WedgePart")
			end
			prop(ctx, {
				Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8),
				Position = pos + off * s * 0.92 + Vector3.new(0, 16, 0), Color = RGB(255, 60, 40), Material = NEON,
			}, gate)
		end
		lintel = part(ctx, {
			Name = "Lintel", Size = lintelSize, Position = pos + Vector3.new(0, 17, 0),
			Color = RGB(130, 25, 30), Material = Enum.Material.Fabric,
		}, gate)
	else
		local col = ({ Meadow = RGB(140, 100, 65), Goblin = RGB(110, 80, 50), Ruins = RGB(225, 220, 200) })[style]
		local mat = (style == "Ruins") and SP or Enum.Material.Wood
		for _, s in { -1, 1 } do
			part(ctx, { Name = "Pillar", Size = Vector3.new(3, 18, 3), Position = pos + off * s + Vector3.new(0, 9, 0), Color = col, Material = mat }, gate)
		end
		lintel = part(ctx, { Name = "Lintel", Size = lintelSize, Position = pos + Vector3.new(0, 18.5, 0), Color = col, Material = mat }, gate)
		local top = pos + Vector3.new(0, 24, 0)
		if style == "Meadow" then -- slime statue
			part(ctx, { Name = "SlimeStatue", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), Position = top, Color = RGB(120, 230, 150) }, gate)
			for _, ez in { -1.5, 1.5 } do
				prop(ctx, {
					Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4),
					Position = top + Vector3.new(3.4 * fx, 1, ez), Color = RGB(30, 30, 30),
				}, gate)
			end
		elseif style == "Goblin" then -- goblin totem + crossed spears
			part(ctx, { Name = "Totem", Size = Vector3.new(4, 7, 4), Position = top + Vector3.new(0, 0.5, 0), Color = RGB(80, 120, 50) }, gate)
			prop(ctx, {
				Name = "TotemEyes", Size = Vector3.new(0.4, 0.8, 2.6), Position = top + Vector3.new(2.1 * fx, 2, 0),
				Color = RGB(255, 220, 60), Material = NEON,
			}, gate)
			for _, a in { 35, -35 } do
				prop(ctx, {
					Name = "Spear", Size = Vector3.new(0.5, 12, 0.5),
					CFrame = CFrame.new(top + Vector3.new(0, 1, 0)) * CFrame.Angles(math.rad(a), 0, 0),
					Color = RGB(120, 90, 55), Material = Enum.Material.Wood,
				}, gate)
			end
		else -- skull arch
			part(ctx, { Name = "Skull", Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Position = top + Vector3.new(0, 2, 0), Color = RGB(225, 220, 200) }, gate)
			for _, ez in { -2.6, 2.6 } do
				local eye = prop(ctx, {
					Name = "SkullEye", Shape = Enum.PartType.Ball, Size = Vector3.new(2.5, 2.5, 2.5),
					Position = top + Vector3.new(5.2 * fx, 3, ez), Color = RGB(150, 110, 255), Material = NEON,
				}, gate)
				if ez < 0 then light(ctx, eye, RGB(150, 110, 255), 18, 1.5) end
			end
			prop(ctx, { Name = "Jaw", Size = Vector3.new(4, 2, 6), Position = top + Vector3.new(3.5 * fx, -3.5, 0), Color = RGB(205, 200, 180) }, gate)
		end
	end

	gate.PrimaryPart = lintel
	gate.Parent = parent
	return gate
end

local function ensureGates(ctx, folder)
	for _, entry in Config.Map.Gates do
		local zone = Config.Zones[entry.Zone]
		if zone then
			local gate = folder:FindFirstChild("Gate_" .. entry.Zone)
			if not gate then
				gate = buildGate(ctx, folder, entry, zone)
				ctx.pieces += 1
			end
			ctx.pieces += ensureGateSign(gate, entry.Zone, zone)
		end
	end
end

------------------------------------------------------------------ pads
local function ensurePads(ctx, folder)
	local size = Config.Map.PadSize
	for _, entry in Config.Map.Pads do
		local zone = Config.Zones[entry.Dest]
		local name = "Pad_" .. entry.Dest
		local pad = folder:FindFirstChild(name)
		if not pad then
			local center = Vector3.new(entry.Position.X, 0.5 - size.Y / 2, entry.Position.Z) -- top at Y = 0.5
			pad = part(ctx, { Name = name, Size = size, Position = center, Color = RGB(80, 200, 255), Material = NEON }, folder)
			if zone then
				ring(ctx, Vector3.new(center.X, 0.55, center.Z), 6.2, 12, Vector3.new(0.6, 0.3, 3.4), dangerColor(zone), pad)
			end
			ctx.pieces += 1
		end
		-- functional bits (re-applied on reuse)
		pad:SetAttribute("TravelTo", entry.Dest)
		if pad:IsA("BasePart") then
			pad.CanTouch = true
			pad.CanCollide = true
		end
		if zone and not pad:FindFirstChildWhichIsA("BillboardGui") then
			billboard(pad, "PadSign", padLabel(zone), 4, RGB(200, 240, 255))
			ctx.pieces += 1
		end
	end
end

------------------------------------------------------------------ landmarks (contract)
local function buildFountain(ctx, parent)
	local f = Config.Map.FountainPosition
	local m = model("Fountain")
	local marble = Enum.Material.Marble
	local stone, water = RGB(225, 225, 230), RGB(90, 180, 255)
	local base = cyl(ctx, { Name = "Tier1", Size = Vector3.new(26, 2, 26), Position = f + Vector3.new(0, 1, 0), Color = stone, Material = marble }, m)
	cyl(ctx, { Name = "Water1", Size = Vector3.new(23, 0.3, 23), Position = f + Vector3.new(0, 2.05, 0), Color = water, Transparency = 0.3, CanCollide = false }, m)
	cyl(ctx, { Name = "Tier2", Size = Vector3.new(14, 3, 14), Position = f + Vector3.new(0, 3.5, 0), Color = stone, Material = marble }, m)
	cyl(ctx, { Name = "Water2", Size = Vector3.new(12, 0.3, 12), Position = f + Vector3.new(0, 5.05, 0), Color = water, Transparency = 0.3, CanCollide = false }, m)
	cyl(ctx, { Name = "Tier3", Size = Vector3.new(6, 2, 6), Position = f + Vector3.new(0, 6, 0), Color = stone, Material = marble }, m)
	m.PrimaryPart = base
	m.Parent = parent
	return m
end

local function buildAltar(ctx, parent)
	local pos = Config.Map.AltarPosition
	local altar = part(ctx, {
		Name = "Altar", Size = Vector3.new(8, 4, 8), Position = pos + Vector3.new(0, 2, 0), -- bottom on the ground
		Color = RGB(110, 100, 130), Material = Enum.Material.Slate,
	}, parent)
	-- the top glows half gold (Halo) and half red (Horns)
	local topHalo = part(ctx, {
		Name = "AltarGlowHalo", Size = Vector3.new(6, 0.4, 3), Position = pos + Vector3.new(0, 4.2, -1.5),
		Color = RGB(255, 215, 90), Material = NEON, CanCollide = false,
	}, altar)
	part(ctx, {
		Name = "AltarGlowHorns", Size = Vector3.new(6, 0.4, 3), Position = pos + Vector3.new(0, 4.2, 1.5),
		Color = RGB(220, 50, 60), Material = NEON, CanCollide = false,
	}, altar)
	light(ctx, topHalo, RGB(255, 180, 160), 18, 1.5)
	for _, cx in { -6, 6 } do
		for _, cz in { -6, 6 } do
			part(ctx, {
				Name = "AltarColumn", Size = Vector3.new(2, 10, 2), Position = pos + Vector3.new(cx, 5, cz),
				Color = RGB(150, 140, 165), Material = Enum.Material.Slate,
			}, altar)
		end
	end
	billboard(altar, "AltarSign", "운명의 제단", 8, RGB(230, 210, 255))
	return altar
end

-- returns 1 when the prompt had to be created
local function ensureAltarPrompt(altar)
	local built = 0
	local prompt = altar:FindFirstChild("AltarPrompt")
	if prompt and not prompt:IsA("ProximityPrompt") then
		retire(prompt, "_Old")
		prompt = nil
	end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "AltarPrompt"
		built = 1
	end
	prompt.ActionText = "진영 바꾸기"
	prompt.ObjectText = "운명의 제단"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = ALTAR_PROMPT_KEY
	prompt.Enabled = true
	prompt.Parent = altar
	return built
end

local function buildBoard(ctx, parent)
	local pos = Config.Map.BoardPosition
	local board = part(ctx, {
		Name = "MostWantedBoard", Size = Vector3.new(1, 12, 20), Position = pos + Vector3.new(0, 6, 0),
		Color = RGB(90, 60, 40), Material = Enum.Material.WoodPlanks,
	}, parent)
	for _, dz in { -10.5, 10.5 } do
		part(ctx, {
			Name = "BoardPost", Size = Vector3.new(1.2, 14, 1.2), Position = pos + Vector3.new(0, 7, dz),
			Color = RGB(70, 45, 30), Material = Enum.Material.Wood,
		}, board)
	end
	return board
end

-- SurfaceGui "BoardGui" on the +X face with TextLabel "BoardText". Returns the number of pieces created.
local function ensureBoardGui(board)
	local built = 0
	local gui = board:FindFirstChild("BoardGui")
	if gui and not gui:IsA("SurfaceGui") then
		retire(gui, "_Old")
		gui = nil
	end
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = "BoardGui"
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(400, 240)
		built += 1
	end
	gui.Face = Enum.NormalId.Right -- faces +X
	gui.LightInfluence = 0 -- readable under every sky
	gui.Parent = board
	local text = gui:FindFirstChild("BoardText")
	if text and not text:IsA("TextLabel") then
		retire(text, "_Old")
		text = nil
	end
	if not text then
		text = Instance.new("TextLabel")
		text.Name = "BoardText"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundColor3 = RGB(30, 25, 25)
		text.BackgroundTransparency = 0
		text.TextColor3 = WHITE
		text.Font = Enum.Font.GothamBold
		text.Text = "현상수배 게시판"
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 10)
		padding.PaddingRight = UDim.new(0, 10)
		padding.PaddingTop = UDim.new(0, 8)
		padding.PaddingBottom = UDim.new(0, 8)
		padding.Parent = text
		text.Parent = gui
		built += 1
	end
	text.TextScaled = true
	text.TextWrapped = true
	return built
end

-- round gold platform (Cylinder Ø10 × 1, top at Y = 1, Marble) + the event-stage ring and gold posts
local function buildGoosePerch(ctx, parent)
	local gp = Config.Goose.Position
	local perch = cyl(ctx, {
		Name = "GoosePerch", Size = Vector3.new(PERCH_DIAMETER, PERCH_HEIGHT, PERCH_DIAMETER),
		Position = Vector3.new(gp.X, PERCH_HEIGHT / 2, gp.Z), Color = RGB(255, 200, 60), Material = Enum.Material.Marble,
	}, parent)
	disc(ctx, Vector3.new(gp.X, 0.08, gp.Z), 22, 0.2, RGB(255, 240, 200), perch)
	for k = 0, 3 do
		local a = k * math.pi / 2 + math.pi / 4
		part(ctx, {
			Name = "GoldPost", Size = Vector3.new(1, 6, 1),
			Position = Vector3.new(gp.X + math.cos(a) * 10, 3, gp.Z + math.sin(a) * 10), Color = RGB(212, 175, 55),
		}, perch)
	end
	billboard(perch, "PerchSign", "황금 거위 둥지", 5, RGB(255, 225, 120))
	return perch
end

-- Part = true: a BasePart contract (other services read .Position / children)
local CONTRACT_LANDMARKS = {
	{ Name = "Fountain", Build = buildFountain },
	{ Name = "Altar", Build = buildAltar, Part = true },
	{ Name = "MostWantedBoard", Build = buildBoard, Part = true },
	{ Name = "GoosePerch", Build = buildGoosePerch },
}

local function ensureLandmarks(ctx, folder)
	for _, def in CONTRACT_LANDMARKS do
		local inst = folder:FindFirstChild(def.Name)
		if inst and def.Part and not inst:IsA("BasePart") then
			retire(inst, "_Decor")
			inst = nil
		end
		if not inst then
			def.Build(ctx, folder)
			ctx.pieces += 1
		end
	end
	local altar = folder:FindFirstChild("Altar")
	if altar then
		ctx.pieces += ensureAltarPrompt(altar)
	end
	local board = folder:FindFirstChild("MostWantedBoard")
	if board then
		ctx.pieces += ensureBoardGui(board)
	end
end

-- invisible, non-colliding SpawnLocation (PlayerService places characters; this only avoids spawning at the origin)
local function buildPreviewSpawn(ctx, landmarks)
	if landmarks:FindFirstChild("PreviewSpawn") then return end
	local spawn = part(ctx, {
		Name = "PreviewSpawn", Size = Vector3.new(8, 1, 8), Position = Config.Zones.Crossroads.Spawn + Vector3.new(0, 0.1, 0),
		Color = RGB(200, 200, 200), Transparency = 1, CanCollide = false,
	}, landmarks, "SpawnLocation")
	spawn.Neutral = true
	spawn.Duration = 0 -- spawn protection is PvPService's ForceField, not the SpawnLocation's
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then decal:Destroy() end
end

------------------------------------------------------------------ public API
-- ENSURE: reuse workspace.Map if present, create only what is missing. No S, no yields, idempotent.
-- A reused map never gets ground or decor (its world is Terrain); a fresh one gets the A11-R3 minimal ground.
function MapBuilder.Build()
	local ctx = newCtx()
	local map = workspace:FindFirstChild("Map")
	local fresh = map == nil
	if fresh then
		Util.Warn(TAG, "no pre-built map: building minimal ground")
		map = Instance.new("Folder")
		map.Name = "Map" -- parented at the end: nobody sees (or touches) a half-built map
	end

	local folders = {}
	for _, name in FOLDER_NAMES do
		local folder, created = getChildFolder(map, name)
		folders[name] = folder
		if created and not fresh then ctx.pieces += 1 end
	end

	if fresh then
		buildMinimalGround(ctx, folders.Ground, folders.Decor)
	end
	ensureZones(ctx, folders.Zones)
	ensureWalls(ctx, folders.Walls)
	ensureGates(ctx, folders.Gates)
	ensurePads(ctx, folders.Pads)
	ensureLandmarks(ctx, folders.Landmarks)

	if fresh then
		buildPreviewSpawn(ctx, folders.Landmarks)
		map.Parent = workspace
	end

	-- shared runtime folders + the custom-model drop folder (addendum A1)
	Util.GetFolder(workspace, "Monsters")
	Util.GetFolder(workspace, "Effects")
	Util.GetFolder(ServerStorage, "CustomModels")

	if fresh then
		local total = countParts(map)
		if total > Config.Map.MaxParts then
			Util.Warn(TAG, ("built %d map parts; Config.Map.MaxParts is %d"):format(total, Config.Map.MaxParts))
		end
		print(("[MapBuilder] built workspace.Map (%d parts)"):format(total))
	else
		print(("[MapBuilder] reused workspace.Map (+%d missing pieces built)"):format(ctx.pieces))
	end
	return map
end

-- destroy workspace.Map, then Build() (Studio command bar helper)
function MapBuilder.Rebuild()
	local old = workspace:FindFirstChild("Map")
	if old then old:Destroy() end
	return MapBuilder.Build()
end

local function findLandmark(name)
	local map = workspace:FindFirstChild("Map")
	local landmarks = map and map:FindFirstChild("Landmarks")
	return landmarks and landmarks:FindFirstChild(name)
end

local function findAltar()
	local altar = findLandmark("Altar")
	if altar and altar:IsA("BasePart") and altar:FindFirstChild("AltarPrompt") then return altar end
	return nil
end

local function findBoardLabel()
	local board = findLandmark("MostWantedBoard")
	local gui = board and board:FindFirstChild("BoardGui")
	local label = gui and gui:FindFirstChild("BoardText")
	if label and label:IsA("TextLabel") then return label end
	return nil
end

-- workspace.Map.Landmarks.Altar (child ProximityPrompt "AltarPrompt"); rebuilt on demand if it went missing
function MapBuilder.GetAltar()
	local altar = findAltar()
	if not altar then
		MapBuilder.Build()
		altar = findAltar()
	end
	return altar
end

-- workspace.Map.Landmarks.MostWantedBoard.BoardGui.BoardText; rebuilt on demand if it went missing
function MapBuilder.GetBoardLabel()
	local label = findBoardLabel()
	if not label then
		MapBuilder.Build()
		label = findBoardLabel()
	end
	return label
end

function MapBuilder.Init(registry)
	S = registry
end

function MapBuilder.Start()
	MapBuilder.Build() -- synchronous
	print("[MapBuilder] started")
end

return MapBuilder
]]></ProtectedString>
				<string name="ScriptGuid">{507094C6-B9FD-4E02-A20A-1AB26E3B022C}</string>
