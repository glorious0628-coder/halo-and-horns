				<ProtectedString name="Source"><![CDATA[-- Globally unique, broadcast-filtered game nicknames. Roblox account names are never modified.
-- A user directory + durable operation token recover uncertain writes without blind retries.
-- Old claims remain owned by that user: no delayed rollback can free somebody else's name.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local NicknameService = {}
local S = nil
local store = nil
local states = {}
local MESSAGES = {
	Active = "Nickname saved.", Available = "You can set a nickname.",
	Invalid = "Nicknames need 2-20 characters. Hidden characters, line breaks, #, <, > and & are not allowed.",
	Filtered = "This nickname can't be used. Please try another one.",
	Taken = "That nickname is already taken.", Busy = "Checking the nickname...",
	Unknown = "We couldn't confirm the save, so your old nickname stays. Tap again to check first.",
	Unavailable = "Can't reach the nickname storage, so your old nickname stays.",
	FilterUnavailable = "Can't reach the nickname filter. Please try again soon.",
	Recovered = "We found your last save result. Tap again to change it.",
	Cooldown = "Please wait a bit before changing your nickname again.", Loading = "Loading your nickname...",
}

-- A bounded supplemental policy, not a language model or a replacement for Roblox filtering.
-- Match complete risky phrases or an explicit target + abusive action. Never ban syllables such
-- as 성/신/교, ordinary affection, fantasy class names, or a religion's name alone.
-- Sources: https://create.roblox.com/docs/ui/text-filtering
--          https://about.roblox.com/community-standards
local POLICY = {
	Korean = {
		"성관계", "성행위", "성매매", "음란물", "야동", "포르노", "섹스", "강간",
		"알몸사진", "벗은사진", "누드사진", "나체사진", "야한사진보내", "미성년자성착취",
		"예수믿어", "예수를믿", "예수믿으", "예수믿자", "예수천국", "불신지옥",
		"하나님믿", "하느님믿", "알라믿", "부처믿", "교회오세요", "교회나와",
		"종교가입해", "종교가입하", "개종해라", "개종하세요", "개종하라",
		"무료로벅스", "공짜로벅스", "로벅스무료", "로벅스공짜", "로벅스복사",
		"비밀번호입력", "비번입력", "비밀번호알려", "비번알려", "인증번호줘", "토큰보내",
		"전화번호줘", "폰번호줘", "카톡아이디", "디코아이디", "인스타아이디",
		"디스코드와", "디코로와", "카톡으로와", "우리집주소", "집주소는", "계좌번호",
		"공식운영자", "진짜운영자", "공식관리자", "공식개발자", "공식GM",
		"로블록스운영", "로블록스관리", "로블록스직원", "로블록스본사",
		"깜둥이", "짱깨", "씨발", "자살해라", "자살하세요", "자해해라",
	},
	KoreanTargets = {
		"기독교", "불교", "천주교", "이슬람", "힌두교", "유대인", "무슬림",
		"흑인", "백인", "아시아인", "여자", "남자", "장애인", "동성애자",
	},
	KoreanAbuse = { "죽어", "죽여", "죽이자", "박멸", "추방", "꺼져", "쓰레기", "열등", "멸종" },
	EnglishWords = { "sex", "porn", "porno", "nudes", "rape", "rapist", "nigger", "faggot" },
	EnglishPhrases = {
		"sex master", "sex slave", "sex king", "sex queen", "porn star", "porn hub", "child porn",
		"send nudes", "nudes please", "want nudes", "nude photos", "naked photos", "jesus saves", "believe in jesus", "accept jesus",
		"convert to islam", "convert to christ", "join my church", "join our church", "join my religion",
		"free robux", "robux generator", "send password", "give password", "password please",
		"send otp", "send token", "add me discord", "discord me", "kill yourself", "hurt yourself",
		"official admin", "official developer", "official moderator", "real admin", "roblox staff",
		"roblox admin", "roblox moderator", "roblox employee", "game admin", "game moderator",
	},
	EnglishTargets = { "christians", "muslims", "jews", "hindus", "buddhists", "black people", "white people", "asians", "women", "men", "gay people", "disabled people" },
	EnglishAbuse = { "kill", "exterminate", "death to" },
	EnglishDegrade = { "die", "are trash", "are inferior" },
	Reserved = { "운영자", "관리자", "개발자", "게임운영자", "공식운영자", "gm", "admin", "moderator", "developer", "gamemaster" },
	Domains = { "com", "net", "org", "gg", "io", "kr", "me" },
}

local function policyForms(text)
	-- Only the comparison copy folds full-width ASCII/camel case/separators. Display and the
	-- global canonical stay unchanged; no Unicode normalization changes ownership semantics.
	local chars = {}
	for _, cp in utf8.codes(text) do
		if cp >= 0xFF01 and cp <= 0xFF5E then cp -= 0xFEE0 end
		chars[#chars + 1] = utf8.char(cp)
	end
	local folded = table.concat(chars)
	local words = string.gsub(folded, "(%l)(%u)", "%1 %2")
	words = string.lower(words)
	words = string.gsub(words, "[ _%.%-]+", " ")
	local compact = string.lower(string.gsub(folded, "[ _%.%-]+", ""))
	return string.lower(folded), words, compact
end

local function englishPhrase(text, phrase)
	-- ASCII letter boundaries avoid the classic substring false positives (Essex/Scunthorpe).
	-- Numeric decorations do not make an explicit phrase safe.
	local from = 1
	while true do
		local first, last = string.find(text, phrase, from, true)
		if not first then return false end
		local before, after = string.sub(text, first - 1, first - 1), string.sub(text, last + 1, last + 1)
		if not string.find(before, "[a-z]") and not string.find(after, "[a-z]") then return true end
		from = last + 1
	end
end

local function englishRisk(words, compact, phrase)
	return englishPhrase(words, phrase) or englishPhrase(compact, string.gsub(phrase, " ", ""))
end

local function policyAllowed(text)
	local folded, words, compact = policyForms(text)
	if not Util.ValidateNickname(folded) then return false end
	for _, phrase in POLICY.Korean do
		if string.find(compact, string.lower(phrase), 1, true) then return false end
	end
	for _, target in POLICY.KoreanTargets do
		for _, abuse in POLICY.KoreanAbuse do
			if string.find(compact, target .. abuse, 1, true)
				or string.find(compact, target .. "는" .. abuse, 1, true)
				or string.find(compact, target .. "은" .. abuse, 1, true)
				or string.find(compact, target .. "을" .. abuse, 1, true)
				or string.find(compact, target .. "를" .. abuse, 1, true) then return false end
		end
	end
	for _, phrase in POLICY.EnglishWords do if englishRisk(words, compact, phrase) then return false end end
	for _, phrase in POLICY.EnglishPhrases do if englishRisk(words, compact, phrase) then return false end end
	for _, target in POLICY.EnglishTargets do
		for _, abuse in POLICY.EnglishAbuse do
			if englishRisk(words, compact, abuse .. " " .. target) then return false end
		end
		for _, abuse in POLICY.EnglishDegrade do
			if englishRisk(words, compact, target .. " " .. abuse) then return false end
		end
	end
	for _, role in POLICY.Reserved do
		if compact == role or string.match(compact, "^" .. role .. "%d+$") then return false end
	end
	-- Match contact/credential shapes, not all long numeric nicknames or all mentions of a phone.
	if string.find(folded, "%S+@%S+%.%w+") or string.find(folded, "https?://")
		or string.find(folded, "www%.") then return false end
	for phone in string.gmatch(folded, "%+%d[%d %.%-]+%d") do
		local digits = string.gsub(phone, "%D", "")
		if #digits >= 8 and #digits <= 15 then return false end
	end
	for _, domain in POLICY.Domains do
		if string.find(folded, "[%w%-]+%." .. domain .. "%f[^a-z]") then return false end
	end
	for number in string.gmatch(compact, "%d+") do
		if #number == 11 and string.match(number, "^01[016789]") then return false end
	end
	if string.find(folded, "%d%d%d[%s%.%-]%d%d%d%d?[%s%.%-]%d%d%d%d")
		or string.find(folded, "%d%d%d%d%d%d%-[1-4]%d%d%d%d%d%d")
		or string.find(folded, "%d%d%d%d[%s%-]%d%d%d%d[%s%-]%d%d%d%d[%s%-]%d%d%d%d") then return false end
	return true
end

local function live(player, st)
	return states[player] == st and player.Parent == Players and S.PlayerService.IsReady(player)
end

local function status(player, code)
	if player.Parent == Players then player:SetAttribute("NicknameStatus", code) end
end

local function reply(player, code)
	if player.Parent ~= Players then return end
	status(player, code)
	Net.Get("NicknameResult"):FireClient(player, {
		Status = code, Message = MESSAGES[code] or MESSAGES.Unavailable,
		Nickname = player:GetAttribute("NicknameVerified") == true and player:GetAttribute("Nickname") or "",
	})
end

local function tokenValid(token)
	return type(token) == "string" and #token >= 16 and #token <= 80 and not string.find(token, "[^%w%-]")
end

local function identityValid(identity, active)
	if type(identity) ~= "table" or not Util.ValidateNickname(identity.Text)
		or identity.Canonical ~= Util.NicknameCanonical(identity.Text) or not tokenValid(identity.Token) then return false end
	return not active or tokenValid(identity.ClaimToken)
end

local function directoryValid(directory, userId)
	return type(directory) == "table" and directory.Version == 1 and directory.UserId == userId
		and type(directory.Revision) == "number" and directory.Revision >= 0
		and directory.Revision == math.floor(directory.Revision) and directory.Revision < 1e12
		and (directory.Active == nil or identityValid(directory.Active, true))
		and (directory.Pending == nil or identityValid(directory.Pending, false))
end

local function newDirectory(userId)
	return { Version = 1, UserId = userId, Revision = 0 }
end

local function userKey(userId)
	return "U_" .. tostring(userId)
end

local function claimKey(canonical)
	-- Bounded ASCII key (<50 bytes). Hash collisions fail closed via the full canonical value below.
	-- Both products stay below 2^53, preserving exact integer arithmetic in Luau numbers.
	local a, b = 5381, 0
	for i = 1, #canonical do
		local byte = string.byte(canonical, i)
		a = (a * 33 + byte) % 4294967296
		b = (b * 131 + byte) % 4294967296
	end
	return string.format("N_%08x%08x_%d", a, b, #canonical)
end

local function readFresh(key)
	-- No cached read may decide whether an uncertain write happened.
	return pcall(function()
		local options = Instance.new("DataStoreGetOptions")
		options.UseCache = false
		return store:GetAsync(key, options)
	end)
end

local function update(key, transform)
	-- Exactly one call. An exception is Unknown, never proof that the write failed.
	return pcall(store.UpdateAsync, store, key, transform)
end

local function filtered(player, raw)
	if not Util.ValidateNickname(raw) then return nil, "Invalid" end
	if not policyAllowed(raw) then return nil, "Filtered" end
	local ok, text = pcall(function()
		local result = TextService:FilterStringAsync(raw, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then return nil, "FilterUnavailable" end
	-- Use the broadcast result for both the visible text and the global canonical claim.
	if not Util.ValidateNickname(text) or not policyAllowed(text) then return nil, "Filtered" end
	return text
end

local function claimMatches(claim, userId, canonical, token)
	return type(claim) == "table" and claim.Version == 1 and claim.UserId == userId
		and claim.Canonical == canonical and tokenValid(claim.Token) and (token == nil or claim.Token == token)
end

local function applyName(player, st, text)
	if not live(player, st) then return end
	S.PlayerService.SetStat(player, "Nickname", text or "") -- filtered cache only, not the uniqueness authority
	player:SetAttribute("Nickname", text or "")
	player:SetAttribute("NicknameVerified", text ~= nil)
	local humanoid = Util.GetHumanoid(player)
	if humanoid then pcall(function() humanoid.DisplayName = Util.PlayerDisplayName(player) end) end
end

local function showActive(player, st, active)
	if not active then applyName(player, st, nil); return "Available" end
	local ok, claim = readFresh(claimKey(active.Canonical))
	if not ok then return "Unavailable" end
	if not claimMatches(claim, player.UserId, active.Canonical, active.ClaimToken) then return "Unavailable" end
	local text, why = filtered(player, active.Text)
	if not text then return why end
	-- If today's filter transforms an old name, do not display it under somebody else's canonical claim.
	if text ~= active.Text then return "Filtered" end
	applyName(player, st, text)
	return "Active"
end

local function clearPending(player, pending)
	local ok, directory = update(userKey(player.UserId), function(old)
		if not directoryValid(old, player.UserId) then return nil end
		if not old.Pending or old.Pending.Token ~= pending.Token then return old end
		local nextDirectory = Util.DeepCopy(old)
		nextDirectory.Pending = nil
		nextDirectory.Revision += 1
		return nextDirectory
	end)
	return ok and directoryValid(directory, player.UserId) and directory.Pending == nil
end

local function finishPending(player, st, pending)
	-- Recovery re-filters persisted text. Only a still-identical broadcast result may complete this intent.
	local text, why = filtered(player, pending.Text)
	if not text then
		if why == "Filtered" or why == "Invalid" then
			return clearPending(player, pending) and "Filtered" or "Unknown"
		end
		return why
	end
	if text ~= pending.Text then
		return clearPending(player, pending) and "Filtered" or "Unknown"
	end
	local key = claimKey(pending.Canonical)
	local okRead, claim = readFresh(key)
	if not okRead then return "Unknown" end
	if claim == nil then
		local okClaim
		okClaim, claim = update(key, function(old)
			if old ~= nil then return old end
			return { Version = 1, UserId = player.UserId, Canonical = pending.Canonical, Token = pending.Token }
		end)
		if not okClaim then return "Unknown" end
	end
	if not claimMatches(claim, player.UserId, pending.Canonical) then
		-- Cancel only this user's exact intent. Claims themselves are never removed or overwritten.
		return clearPending(player, pending) and "Taken" or "Unknown"
	end
	local okCommit, directory = update(userKey(player.UserId), function(old)
		if not directoryValid(old, player.UserId) then return nil end
		if not old.Pending or old.Pending.Token ~= pending.Token then return old end
		if old.Pending.Canonical ~= pending.Canonical or old.Pending.Text ~= pending.Text then return nil end
		local nextDirectory = Util.DeepCopy(old)
		nextDirectory.Active = {
			Text = text, Canonical = pending.Canonical, Token = pending.Token, ClaimToken = claim.Token,
		}
		nextDirectory.Pending = nil
		nextDirectory.Revision += 1
		return nextDirectory
	end)
	if not okCommit or not directoryValid(directory, player.UserId) or directory.Pending ~= nil
		or not directory.Active or directory.Active.Token ~= pending.Token
		or directory.Active.ClaimToken ~= claim.Token or directory.Active.Canonical ~= pending.Canonical then
		return "Unknown"
	end
	applyName(player, st, text)
	return "Active"
end

local function resolve(player, st)
	local ok, directory = readFresh(userKey(player.UserId))
	if not ok then return "Unknown" end
	if directory == nil then directory = newDirectory(player.UserId) end
	if not directoryValid(directory, player.UserId) then return "Unknown" end
	local activeStatus = showActive(player, st, directory.Active)
	if directory.Pending then return finishPending(player, st, directory.Pending) end
	return activeStatus
end

local function available()
	return store ~= nil and S.DataService.IsPersistentReady()
end

function NicknameService.SetNickname(player, raw)
	if not S.PlayerService.IsReady(player) or player.Parent ~= Players then return end
	local st = states[player]
	if not st or not st.Loaded then reply(player, "Loading"); return end
	if not Util.ValidateNickname(raw) then reply(player, "Invalid"); return end
	if st.Busy then reply(player, "Busy"); return end
	if not Util.RateLimit(player, "SetNickname", Config.Nickname.ChangeInterval) then reply(player, "Cooldown"); return end
	if not available() then reply(player, "Unavailable"); return end
	st.Busy = true
	status(player, "Busy")
	local ok, code = pcall(function()
		if st.Unknown then
			-- Resolve the previous token first. This call never starts the newly supplied request.
			local result = resolve(player, st)
			st.Unknown = result == "Unknown" or result == "FilterUnavailable"
			return (result == "Active" or result == "Available") and "Recovered" or result
		end
		local text, why = filtered(player, raw)
		if not text then return why end
		local okRead, directory = readFresh(userKey(player.UserId))
		if not okRead then return "Unavailable" end
		if directory == nil then directory = newDirectory(player.UserId) end
		if not directoryValid(directory, player.UserId) then st.Unknown = true; return "Unknown" end
		if directory.Pending then
			st.Unknown = true
			return "Unknown" -- an existing intent is resolved on the next explicit request
		end
		local pending = { Text = text, Canonical = Util.NicknameCanonical(text), Token = HttpService:GenerateGUID(false) }
		local revision = directory.Revision
		local okBegin, result = update(userKey(player.UserId), function(old)
			if old == nil then old = newDirectory(player.UserId) end
			if not directoryValid(old, player.UserId) then return nil end
			if old.Pending or old.Revision ~= revision then return old end
			local nextDirectory = Util.DeepCopy(old)
			nextDirectory.Pending = pending -- contains only the filtered broadcast text
			nextDirectory.Revision += 1
			return nextDirectory
		end)
		if not okBegin or not directoryValid(result, player.UserId) or not result.Pending
			or result.Pending.Token ~= pending.Token then st.Unknown = true; return "Unknown" end
		local final = finishPending(player, st, result.Pending)
		st.Unknown = final == "Unknown" or final == "FilterUnavailable"
		return final
	end)
	if not ok then st.Unknown = true; code = "Unknown" end
	st.Busy = false
	if live(player, st) then reply(player, code) end
end

local function load(player)
	local st = { Busy = true, Loaded = false, Unknown = false }
	states[player] = st
	local code = "Unavailable"
	if available() then
		local ok, result = pcall(resolve, player, st)
		code = ok and result or "Unknown"
		st.Unknown = code == "Unknown" or code == "FilterUnavailable"
	end
	st.Busy = false
	st.Loaded = true
	if live(player, st) then status(player, code) end
end

function NicknameService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player) task.spawn(load, player) end)
	S.PlayerService.PlayerLeaving:Connect(function(player) states[player] = nil end)
	S.PlayerService.CharacterSpawned:Connect(function(player, _, humanoid)
		pcall(function() humanoid.DisplayName = Util.PlayerDisplayName(player) end)
	end)
end

function NicknameService.Start()
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, Config.Nickname.StoreName)
	if ok then store = result end
	Net.Get("SetNickname").OnServerEvent:Connect(NicknameService.SetNickname)
	print("[NicknameService] started")
end

return NicknameService
]]></ProtectedString>
				<string name="ScriptGuid">{5CCC9C74-B506-4493-96E3-914AC4C2E675}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">NicknameService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e53000008bb</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXFB9359A892844A8DB798381A3534202D">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ShopService.luau : chosen basic weapons at the blacksmith and potions from their merchant.
-- UpgradeWeapon is the legacy purchase remote name; it does not enhance the current weapon.
-- CharacterVisuals rebuilds the weapon model from the WeaponTier attribute change.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local M = {}

local S = nil
local BLACKSMITH = { PromptName = "HHC_BlacksmithPrompt", Distance = 12, PromptRate = 0.5 }

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function notifyBad(player, key, ...)
	Net.Notify(player, string.format(Config.Text[key], ...), "bad")
end

local function onUpgradeWeapon(player, selectedTier)
	-- Client chooses only the catalog tier. Price, ownership and all eligibility stay on the server.
	if not finite(selectedTier) or selectedTier ~= math.floor(selectedTier) or selectedTier < 1
		or selectedTier > Config.MaxWeaponTier then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "UpgradeWeapon", Config.RateLimits.UpgradeWeapon) then return end
	-- Recheck the physical shop on EVERY purchase, even if its panel was opened earlier.
	if not M.CanBuyWeapon(player) then
		Net.Notify(player, Config.Text.WeaponShopFar, "bad")
		return
	end

	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end

	local maxTier = Config.MaxWeaponTier
	local tier = data.WeaponTier
	-- A23-34: 0 = bare hands (a new player buys the optional wood weapon before or after the free M1_1 tier 1)
	if not finite(tier) or tier ~= math.floor(tier) or tier < 0 or tier > maxTier then return end
	local shop = Config.WeaponShop
	local saleLimit = type(shop) == "table" and shop.MaxSoldTier or nil
	-- An absent/malformed sale list must never silently expose rare tiers for gold.
	if not finite(saleLimit) or saleLimit ~= math.floor(saleLimit) or saleLimit < 1 or saleLimit > maxTier then
		Util.Warn("ShopService", "invalid WeaponShop.MaxSoldTier; weapon purchase refused")
		return
	end
	if selectedTier > saleLimit then
		Net.Notify(player, Config.Text.WeaponNotSold, "info")
		return
	end
	local selectedDef = Config.Weapons[selectedTier]
	if type(selectedDef) ~= "table" then return end
	local ownedMask = data.WeaponOwnedMask
	local validMask = bit32.lshift(1, maxTier) - 1
	-- A23-34: no bit is required any more (0 = nothing owned; tier 1 is owned only after the M1_1 gift)
	if not finite(ownedMask) or ownedMask ~= math.floor(ownedMask) or ownedMask < 0
		or ownedMask > validMask then return end
	local selectedBit = bit32.lshift(1, selectedTier - 1)
	local alreadyOwned = bit32.band(ownedMask, selectedBit) ~= 0
	if selectedTier == 1 and not alreadyOwned then -- tier 1 is never sold: the M1_1 blacksmith gives it (A23-34)
		Net.Notify(player, Config.Text.WeaponFromQuest, "info")
		return
	end

	-- A23-28: MinLevel gates the purchase AND the equip, an owned weapon too (after a rebirth / Lv5+ free class change
	-- it is equippable again once the level is back; same rule as LootService.onEquipWeapon, Config.WeaponUsable)
	local level, minLevel = data.Level, selectedDef.MinLevel
	if not finite(level) or not finite(minLevel) then return end
	if level < minLevel then
		notifyBad(player, alreadyOwned and "EquipNeedLevel" or "WeaponNeedLevel", minLevel)
		return
	end

	-- the faction weapon needs a chosen faction (Halo, Horns or Neutral — never "None")
	local faction = S.FactionService.GetFaction(player)
	if type(faction) ~= "string" then faction = "None" end
	if selectedDef.RequiresFaction and faction == "None" then
		notifyBad(player, "NeedFaction")
		return
	end
	-- review B6: the same state rules as the item-list equip (LootService.onEquipWeapon): alive (CanBuyWeapon above)
	-- and not in PvP combat. Checked before any gold is spent; a purchase always equips, so it is refused too.
	if S.CombatService.IsInCombat(player) then
		Net.Notify(player, Config.Loot.Text.EquipCombat, "bad")
		return
	end

	if not alreadyOwned then
		local price = selectedDef.Price
		if not finite(price) or price <= 0 or price ~= math.floor(price) then
			Util.Warn("ShopService", "invalid weapon price; weapon purchase refused")
			return
		end
		-- No yields between debit, ownership and equipment: duplicate requests cannot debit twice.
		if not S.ProgressionService.SpendGold(player, price, "Weapon") then
			notifyBad(player, "NotEnoughGold")
			return
		end
		S.PlayerService.SetStat(player, "WeaponOwnedMask", bit32.bor(ownedMask, selectedBit))
	end

	S.PlayerService.SetStat(player, "WeaponTier", selectedTier)
	S.PlayerService.SetStat(player, "BlacksmithVisited", true) -- A23-4: a verified anvil trade counts as the visit
	S.PlayerService.MarkActive(player)
	local weaponName = Config.WeaponName(selectedTier, S.ClassService.GetClass(player), faction)
	local equipFmt = (Config.Loot and Config.Loot.Text and Config.Loot.Text.Equip) or Config.Text.WeaponBought
	Net.Notify(player, string.format(alreadyOwned and equipFmt or Config.Text.WeaponBought, weaponName), alreadyOwned and "info" or "reward",
		nil, "Equip")
	if tier ~= selectedTier then Net.Fx(player, "Upgrade", { Tier = selectedTier }) end
end

local function onSellWeapon(player, selectedTier)
	if not finite(selectedTier) or selectedTier ~= math.floor(selectedTier) or selectedTier < 2
		or selectedTier > Config.MaxWeaponTier then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "SellWeapon", Config.RateLimits.SellWeapon or Config.RateLimits.UpgradeWeapon) then return end
	if not M.CanBuyWeapon(player) then
		Net.Notify(player, Config.Text.WeaponSellFar, "bad")
		return
	end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end
	local maxTier = Config.MaxWeaponTier
	local shop = Config.WeaponShop
	local saleLimit = type(shop) == "table" and shop.MaxSoldTier or nil
	if not finite(saleLimit) or saleLimit ~= math.floor(saleLimit) or saleLimit < 1 or saleLimit > maxTier then return end
	if selectedTier > saleLimit then return end
	local tier, ownedMask = data.WeaponTier, data.WeaponOwnedMask
	if not finite(tier) or tier ~= math.floor(tier) or tier < 0 or tier > maxTier then return end -- A23-34: 0 = bare hands
	local validMask = bit32.lshift(1, maxTier) - 1
	if not finite(ownedMask) or ownedMask ~= math.floor(ownedMask) or ownedMask < 0
		or ownedMask > validMask then return end
	local selectedBit = bit32.lshift(1, selectedTier - 1)
	if bit32.band(ownedMask, selectedBit) == 0 then return end
	local definition = Config.Weapons[selectedTier]
	local price = type(definition) == "table" and definition.Price or nil
	if not finite(price) or price <= 0 or price ~= math.floor(price) then return end
	local proceeds = math.floor(price * 0.1)
	-- Remove ownership before emitting any gold signal: a repeated or reentrant sale cannot pay twice.
	local leftMask = bit32.band(ownedMask, bit32.bnot(selectedBit))
	S.PlayerService.SetStat(player, "WeaponOwnedMask", leftMask)
	-- A23-34: selling the equipped weapon equips the best weapon still owned and usable (0 = bare hands), never an
	-- unowned tier 1
	if tier == selectedTier then S.PlayerService.SetStat(player, "WeaponTier", Config.BestUsableWeapon(leftMask, data.Level)) end
	S.ProgressionService.AddCarriedGold(player, proceeds, "Sale")
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	S.PlayerService.MarkActive(player)
	local weaponName = Config.WeaponName(selectedTier, S.ClassService.GetClass(player), S.FactionService.GetFaction(player))
	Net.Notify(player, string.format(Config.Text.WeaponSold, weaponName, tostring(proceeds)), "good")
end

local function finitePosition(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

local function blacksmithAnvil()
	local map = workspace:FindFirstChild("Map")
	if not map or map.Parent ~= workspace or (not map:IsA("Folder") and not map:IsA("Model")) then return nil end
	local landmarks = map:FindFirstChild("Landmarks")
	if not landmarks or not landmarks:IsA("Folder") or landmarks.Parent ~= map then return nil end
	local guild = landmarks:FindFirstChild("ArtisanGuild")
	if not guild or not guild:IsA("Model") or guild.Parent ~= landmarks then return nil end
	local anvil = guild:FindFirstChild("Anvil")
	if not anvil or not anvil:IsA("BasePart") or anvil.Parent ~= guild or not anvil.Anchored then return nil end
	return anvil
end

-- Attach the interaction to the existing approved map prop; create no new NPC or scenery.
function M.EnsureBlacksmithPrompt()
	local anvil = blacksmithAnvil()
	if not anvil then return false end
	local prompt = anvil:FindFirstChild(BLACKSMITH.PromptName)
	if prompt and not prompt:IsA("ProximityPrompt") then return false end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = BLACKSMITH.PromptName
	end
	prompt.ActionText, prompt.ObjectText = Config.Text.BlacksmithPromptAction, Config.Text.BlacksmithPromptObject
	prompt.KeyboardKeyCode = Enum.KeyCode.E -- standard interact key; the skill is Q only (2026-10-06 playtest)
	prompt.HoldDuration, prompt.MaxActivationDistance = 0, BLACKSMITH.Distance -- a shop opens on a tap, no hold
	prompt.RequiresLineOfSight, prompt.Enabled = false, true
	prompt.Parent = anvil
	return true
end

local function blacksmith()
	local anvil = blacksmithAnvil()
	if not anvil then return nil end
	local prompt = anvil:FindFirstChild(BLACKSMITH.PromptName)
	if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Parent ~= anvil or not prompt.Enabled then return nil end
	return anvil, prompt
end

function M.CanBuyWeapon(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" or data.ClassChosen ~= true then return false end
	local anvil, prompt = blacksmith()
	local root = Util.GetRoot(player)
	if not anvil or not root or not root:IsA("BasePart")
		or not finitePosition(anvil.Position) or not finitePosition(root.Position) then return false end
	local activation = prompt.MaxActivationDistance
	if not finite(activation) or activation <= 0 then return false end
	-- Increasing a prompt's radius never expands the purchase radius beyond the server contract.
	local distance = (root.Position - anvil.Position).Magnitude
	return finite(distance) and distance <= math.min(BLACKSMITH.Distance, activation)
end

local function onBlacksmithPrompt(prompt, player)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt")
		or prompt.Name ~= BLACKSMITH.PromptName or not M.CanBuyWeapon(player) then return end
	local _, expected = blacksmith()
	if expected ~= prompt then return end -- cloned/renamed prompts cannot open the weapon shop
	if not Util.RateLimit(player, "BlacksmithPrompt", BLACKSMITH.PromptRate) then return end
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	-- A23-34: an active M1_1 finishes right here, so its free first weapon is in hand before the shop opens
	local story = S.StoryQuestService
	if type(story) == "table" and type(story.Refresh) == "function" then pcall(story.Refresh, player) end
	Net.Get("OpenPanel"):FireClient(player, "WeaponShop")
end

function M.CanBuyPotions(player)
	if Config.Vitals.MerchantEnabled ~= true or typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
	if player.Parent ~= Players or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false end
	local map = workspace:FindFirstChild("Map")
	if not map or map.Parent ~= workspace or (not map:IsA("Folder") and not map:IsA("Model")) then return false end
	local npcs = map:FindFirstChild("NPCs")
	if not npcs or not npcs:IsA("Folder") or npcs.Parent ~= map then return false end
	local merchant = npcs:FindFirstChild(Config.Vitals.PotionMerchantName)
	local part = merchant and merchant:IsA("Model") and merchant:GetAttribute("HHC_PotionMerchant") == true and merchant.PrimaryPart
	local root = Util.GetRoot(player)
	if not merchant or merchant.Parent ~= npcs or not part or not part:IsA("BasePart")
		or not part:IsDescendantOf(merchant) or not root or not root:IsA("BasePart")
		or not finitePosition(part.Position) or not finitePosition(root.Position) then return false end
	local prompt = part:FindFirstChild(Config.Vitals.PotionMerchantPrompt)
	-- Direct BuyPotion calls require the same live server prompt as opening the shop, including its enabled state.
	if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Parent ~= part or not prompt.Enabled then return false end
	local limit = Config.Vitals.PotionMerchantDistance
	if not finite(limit) or limit <= 0 then return false end
	local distance = (root.Position - part.Position).Magnitude
	return finite(distance) and distance <= limit
end

local function onPotionPrompt(prompt, player)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return end
	if prompt.Name ~= Config.Vitals.PotionMerchantPrompt or not M.CanBuyPotions(player) then return end
	local map = workspace:FindFirstChild("Map")
	local npcs = map and map:FindFirstChild("NPCs")
	local merchant = npcs and npcs:FindFirstChild(Config.Vitals.PotionMerchantName)
	local part = merchant and merchant.PrimaryPart
	if not part or prompt.Parent ~= part or part:FindFirstChild(Config.Vitals.PotionMerchantPrompt) ~= prompt then return end
	if not Util.RateLimit(player, "PotionMerchantPrompt", Config.Vitals.PotionMerchantPromptRate) then return end
	Net.Get("OpenPanel"):FireClient(player, "PotionShop")
end

function M.BuyPotion(player, kind, amount)
	local key = Config.PotionStockKey(kind)
	if not key or type(amount) ~= "number" or (amount ~= 1 and amount ~= 5) then return false, "Invalid" end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false, "NotReady" end
	if not Util.RateLimit(player, "BuyPotion", Config.RateLimits.BuyPotion) then return false, "Cooldown" end
	if not M.CanBuyPotions(player) then
		Net.Notify(player, Config.Text.PotionShopFar, "bad")
		return false, "MerchantDistance"
	end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return false, "NotReady" end
	local count, cap = data[key], Config.Vitals.PotionInventoryCap
	if not finite(count) or count < 0 or count ~= math.floor(count) or count > cap then return false, "InvalidStock" end
	if count + amount > cap then
		Net.Notify(player, string.format(Config.Text.PotionStockFull, cap), "bad")
		return false, "FullStock"
	end
	local price = Config.Vitals.PotionPrices[kind]
	if not finite(price) or price <= 0 or price ~= math.floor(price) then return false, "InvalidPrice" end
	-- Validate the whole purchase before debiting. SpendGold and SetStat do not yield; no request can interleave here.
	-- No datastore write, prompt callback, Notify or remote call occurs between these two mutations.
	if not S.ProgressionService.SpendGold(player, price * amount, "Potion") then
		notifyBad(player, "NotEnoughGold")
		return false, "NotEnoughGold"
	end
	S.PlayerService.SetStat(player, key, count + amount)
	S.PlayerService.MarkActive(player)
	Net.Notify(player, string.format(Config.Text.PotionBought, kind, amount), "good", nil, "Spend")
	return true, "Bought"
end

function M.Init(registry)
	S = registry
end

function M.Start()
	if not M.EnsureBlacksmithPrompt() then
		-- Minimal/headless maps may intentionally omit this optional town prop.
		print("[ShopService] no ArtisanGuild.Anvil; weapon shop stays closed")
	end
	-- Global, exact-instance validation survives a MapBuilder rebuild and rejects cloned/renamed prompts.
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local ok, err = pcall(onPotionPrompt, prompt, player)
		if not ok then Util.Warn("ShopService", "potion prompt: " .. tostring(err)) end
		local shopOk, shopErr = pcall(onBlacksmithPrompt, prompt, player)
		if not shopOk then Util.Warn("ShopService", "blacksmith prompt: " .. tostring(shopErr)) end
	end)
	Net.Get("UpgradeWeapon").OnServerEvent:Connect(function(player, ...)
		-- Exactly one catalog tier is accepted; prices, quantities or extra payloads are rejected.
		if select("#", ...) ~= 1 then return end
		local ok, err = pcall(onUpgradeWeapon, player, ...)
		if not ok then Util.Warn("ShopService", "weapon purchase: " .. tostring(err)) end
	end)
	Net.Get("SellWeapon").OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then return end
		local ok, err = pcall(onSellWeapon, player, ...)
		if not ok then Util.Warn("ShopService", "weapon sale: " .. tostring(err)) end
	end)
	Net.Get("BuyPotion").OnServerEvent:Connect(function(player, kind, amount)
		local ok, err = pcall(M.BuyPotion, player, kind, amount)
		if not ok then Util.Warn("ShopService", tostring(err)) end
	end)
	print("[ShopService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{AD6C270A-50BE-40F5-9027-01A047C982C5}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ShopService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e530002152d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXC5E6CDDFA32642CE910413D82D190D3B">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- StoryQuestService.luau : "부서진 왕관 이야기" story quests (Config.StoryQuests; design
-- docs/design/quest_chain_2026-10-06.md, user OK 2026-10-06). One main chain after the first mission
-- (TutorialStep 99) + automatically accepted sub quests (S0 "내 싸움을 배우는 왕관 조각" right after the class pick).
-- Server-authoritative: progress comes only from server signals / server state; the client may only confirm a
-- Talk page or pick a Choice option of the step that is active right now (remote "StoryAction"). A finished step is
-- saved before any reward is paid, so nothing can be paid twice. QuestService puts the rows into the quest list.
--
-- data.Story = { Main = { Id, St, P, T, Claim } | { Id = "" }, Subs = { [id] = { St, P, T, Claim } },
--                Done = { [id] = true }, Pick = { [id] = "Good" | "Evil" | "A" | "B" | "Purify" | "Devour" },
--                First = { [key] = true } }     (St = 1-based step, P = progress, T = trial progress table)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local StoryQuestService = {}
local S = nil
local TAG = "StoryQuestService"
local SQ = Config.StoryQuests
local TXT = SQ.Text
local DEFS = SQ.Defs
local TUT_DONE = Config.Tutorial.Steps.Done -- 99
local MAIN_INDEX = {}
for i, id in SQ.Main do MAIN_INDEX[id] = i end
local TICK = 1
-- E4 Near.Stay: [Player] = { [questId .. ":" .. step] = os.clock() when the player came inside } (never saved: a rejoin
-- or leaving the spot starts the count again)
local stays = {}
-- story_depth E1 / E2 / E3: a pick's side (Good / Purify / A on one side, Evil / Devour / B on the other)
local SIDE = { Good = "Good", Purify = "Good", A = "Good", Evil = "Evil", Devour = "Evil", B = "Evil" }

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return default or 0
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

local function faction(player)
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function dirty(player)
	if S.QuestService and type(S.QuestService.MarkDirty) == "function" then
		pcall(S.QuestService.MarkDirty, player)
	end
end

-- BB1: '{Auto}'-style key tokens -> this player's saved key labels (Config.KeyMap of data.Settings.Keys), for toasts.
-- Quest rows keep the raw tokens: the client fills them (HUD L.QuestText: a phone shows the button name, A23-21) and
-- redraws them when the keys change.
local function keyText(data, text)
	if type(text) ~= "string" or not string.find(text, "{", 1, true) then return text end
	local settings = type(data) == "table" and data.Settings or nil
	return Config.FillKeys(text, (Config.KeyMap(type(settings) == "table" and settings.Keys or nil, nil)))
end

local function notify(player, text, kind, sound)
	if type(text) == "string" and text ~= "" then
		pcall(Net.Notify, player, keyText(getData(player), text), kind or "info", nil, sound)
	end
end

------------------------------------------------------------------ data
local function story(data)
	local st = data.Story
	if type(st) ~= "table" then
		st = {}
		data.Story = st
	end
	for _, k in { "Subs", "Done", "Pick", "First" } do
		if type(st[k]) ~= "table" then st[k] = {} end
	end
	if type(st.Main) ~= "table" then st.Main = { Id = "" } end
	return st
end

-- drop unknown ids / bad numbers (fillDefaults only fills the top level)
local function sanitize(data)
	local st = story(data)
	local function fixTrack(tr, id)
		local def = DEFS[id]
		if type(tr) ~= "table" or not def then return nil end
		tr.St = math.clamp(math.floor(num(tr.St, 1)), 1, #def.Steps)
		tr.P = math.max(0, num(tr.P))
		if type(tr.T) ~= "table" then tr.T = {} end
		tr.Claim = tr.Claim == true
		return tr
	end
	if st.Main.Id ~= "" then
		if not DEFS[st.Main.Id] or DEFS[st.Main.Id].Kind ~= "Main" or st.Done[st.Main.Id] then
			st.Main = { Id = "" }
		else
			fixTrack(st.Main, st.Main.Id)
		end
	end
	for id, tr in st.Subs do
		if not DEFS[id] or DEFS[id].Kind ~= "Sub" or st.Done[id] or not fixTrack(tr, id) then st.Subs[id] = nil end
	end
	for id in st.Done do
		if not DEFS[id] then st.Done[id] = nil end
	end
	if st.LastSide ~= "Good" and st.LastSide ~= "Evil" then st.LastSide = nil end -- E2: the side of the last real pick
end

------------------------------------------------------------------ step helpers
-- the step definition for this player's faction (a step may carry a Neutral override)
local function stepOf(player, def, index)
	local step = def.Steps[index]
	if not step then return nil end
	local f = faction(player)
	if step[f] and type(step[f]) == "table" then
		local over = table.clone(step)
		for k, v in step[f] do over[k] = v end
		return over
	end
	return step
end

-- E2: the LinesBy entry this player sees (game dev 1's Story window reads it as Var): the exact pick of LinesBy.From
-- when listed, else its side, else Default (an old save has no picks: every LinesBy has a Default). nil = plain Lines.
local function varFor(data, step)
	local by = step and step.LinesBy
	if type(by) ~= "table" or type(data) ~= "table" then return nil end
	local pick = story(data).Pick[by.From]
	if pick ~= nil and by[pick] ~= nil then return pick end
	local side = SIDE[pick]
	if side ~= nil and by[side] ~= nil then return side end
	return "Default"
end

local function homeZone(player)
	return Config.HomeZoneId(faction(player))
end

local function zoneMatches(player, want, zoneId)
	local zone = Config.Zones[zoneId]
	if want == "OwnTown" then return zoneId == homeZone(player) end
	if want == "AnyTown" then return zone ~= nil and zone.Town == true end
	return zoneId == want
end

local function currentZone(player)
	local ok, z = pcall(S.ZoneService.GetZoneId, player)
	return ok and z or player:GetAttribute("ZoneId")
end

-- A23-46: a step with Npc is talked through that town NPC (game dev 1 tags its model SQ.NpcTag with the attribute
-- NpcId). True when the player stands within SQ.NpcRange of it, or when no such NPC exists in the world yet.
local function npcNear(player, npcId)
	if type(npcId) ~= "string" then return true end
	local okTag, tagged = pcall(function()
		return game:GetService("CollectionService"):GetTagged(SQ.NpcTag or "StoryNpc")
	end)
	if not okTag or type(tagged) ~= "table" then return true end
	local root = Util.GetRoot(player)
	local found = false
	for _, inst in tagged do
		if inst:GetAttribute("NpcId") == npcId then
			found = true
			local okPos, pos = pcall(function()
				if inst:IsA("Model") then return inst:GetPivot().Position end
				return inst.Position
			end)
			if okPos and root and typeof(pos) == "Vector3" and Util.FlatDistance(root.Position, pos) <= (SQ.NpcRange or 16) then
				return true
			end
		end
	end
	return not found
end

local function ownsIron(player)
	local mask = math.floor(num(player:GetAttribute("WeaponOwnedMask"), 1))
	return bit32.btest(mask, bit32.lshift(1, 2)) or num(player:GetAttribute("WeaponTier"), 1) >= 3
end

local function stateTrue(player, key)
	if key == "BlacksmithVisited" then return player:GetAttribute("BlacksmithVisited") == true end
	if key == "AutoOn" then return player:GetAttribute("AutoCombatEnabled") == true end
	if key == "OwnIron" then return ownsIron(player) end
	if key == "Graduated" then -- E7 (quest_volume): no Sprout Shield any more (PvPService.IsRookie)
		local pvp = S.PvPService
		if type(pvp) ~= "table" or type(pvp.IsRookie) ~= "function" then return false end
		local ok, rookie = pcall(pvp.IsRookie, player)
		return ok and rookie == false
	end
	return false
end

-- A23-71: the step is a skill hit, or a trial list with a skill-hit trial not done yet
local function needsSkill(obj, track)
	if obj.Type == "SkillHit" then return true end
	if obj.Type ~= "Trials" or type(obj.List) ~= "table" then return false end
	for _, sub in obj.List do
		if sub.Type == "SkillHit" and num(type(track.T) == "table" and track.T[sub.Key]) < num(sub.Count, 1) then return true end
	end
	return false
end

-- a Level step is reached; A23-71 Skill = also once the first skill is learned (Q kept after a free class change took
-- the level back to 1, or a rebirth)
local function levelReached(data, obj)
	if num(data.Level, 1) >= num(obj.Level) then return true end
	return obj.Skill == true and Config.SkillLearned(data.SkillSlots, data.Level, data.Rebirths)
end

-- the opening line(s) of a quest that just started: its Start, then (A23-71 S8) its first Level step's own Start while
-- that level is still ahead (past it, the step passes at once and the next step's Start is said instead)
local function announceStart(player, data, def)
	if def.Hidden then return end -- E5: a hidden sub stays secret
	if def.Start then notify(player, def.Start, "info") end
	local first = stepOf(player, def, 1)
	local obj = first and first.Obj
	if first and first.Start and type(obj) == "table" and obj.Type == "Level" and not levelReached(data, obj) then
		notify(player, first.Start, "info")
	end
end

-- how much one event moves an objective (0 = not this objective)
local function eventAmount(player, obj, ev)
	local t = obj.Type
	if ev.Kind == "Kill" then
		local info = ev.Info
		if info.Personal == true then return 0 end
		if t == "WarPoints" then return math.max(0, num(info.WarPoints)) end
		if t ~= "Kill" and t ~= "BasicKill" and t ~= "SafeKill" and t ~= "AutoKill" then return 0 end
		if obj.Kind and Config.QuestKind(info.Kind) ~= obj.Kind then return 0 end -- a pumpkin slime counts as a slime
		if obj.Zone and info.ZoneId ~= obj.Zone then return 0 end
		if obj.Golden and info.Golden ~= true then return 0 end
		if obj.Near then
			local spot = SQ.Landmarks[obj.Near]
			if not spot or typeof(info.Position) ~= "Vector3" or Util.FlatDistance(info.Position, spot) > (obj.Radius or 40) then return 0 end
		end
		if t == "BasicKill" and info.SkillHit == true then return 0 end
		if t == "AutoKill" and player:GetAttribute("AutoCombatEnabled") ~= true then return 0 end
		if t == "SafeKill" then
			local hum = Util.GetHumanoid(player)
			if not hum or hum.MaxHealth <= 0 or hum.Health / hum.MaxHealth < (obj.MinHP or 0.5) then return 0 end
		end
		return 1
	elseif ev.Kind == "Skill" then
		if t ~= "SkillHit" or ev.Info.Auto == true then return 0 end
		return num(ev.Info.MonstersHit) >= (obj.Min or 1) and 1 or 0
	elseif ev.Kind == "Gold" then
		if t == "EarnGold" and (obj.Source == nil or obj.Source == ev.Source) then return math.floor(num(ev.Amount)) end
		if t == "WarChest" and ev.Source == "War" then return 1 end
		return 0
	elseif ev.Kind == "Goose" then
		return t == "Goose" and 1 or 0
	end
	return 0
end

-- E11: BoardService judges its jobs (Kill / BasicKill / SafeKill / AutoKill / SkillHit / EarnGold ...) by these rules
function StoryQuestService.EventAmount(player, obj, ev)
	return eventAmount(player, obj, ev)
end

------------------------------------------------------------------ rewards / finishing
-- E6 / Reward.Item: an item or potions through LootService.GrantItem (its caps and full notices); the "+Name" part of the
-- reward line, or nil when nothing was given
local function grantItem(player, id, n)
	local loot = S.LootService
	if type(id) ~= "string" or type(loot) ~= "table" or type(loot.GrantItem) ~= "function" then return nil end
	local ok, res = pcall(loot.GrantItem, player, id, math.floor(num(n, 1)))
	if not ok then Util.Warn(TAG, "GrantItem: " .. tostring(res)) end
	local given = ok and math.floor(num(res)) or 0
	if given <= 0 then return nil end
	local item = Config.Loot.Items[id]
	local name = (item and item.Name) or Config.Loot.Text.Potion[id] or id
	return given > 1 and string.format(Config.Loot.Text.GotN, name, given) or string.format(Config.Loot.Text.Got, name)
end

local function payReward(player, def)
	local r = def.Reward
	if type(r) ~= "table" then return nil end
	local level = math.max(1, math.floor(num(player:GetAttribute("Level"), 1)))
	local g, x = 0, 0
	if num(r.Gold) > 0 then g = select(1, Config.HuntValue(level, r.Gold)) end
	if num(r.XP) > 0 then x = select(2, Config.HuntValue(level, r.XP)) end
	-- A23-46: exact gold and a share of the current level's XP bar (the town people's quests)
	if num(r.GoldN) > 0 then g += math.floor(num(r.GoldN)) end
	if num(r.XPBar) > 0 then x += math.floor(Config.XPToNext(level) * num(r.XPBar)) end
	if g > 0 then S.ProgressionService.AddBankGold(player, g, "Quest") end
	if x > 0 then S.ProgressionService.AddXP(player, x) end
	if g > 0 and x > 0 then return string.format(TXT.RewardXP, def.Title, Util.FormatNumber(g), Util.FormatNumber(x)) end
	if g > 0 then return string.format(TXT.Reward, def.Title, Util.FormatNumber(g)) end
	if x > 0 then return string.format(TXT.RewardOnlyXP, def.Title, Util.FormatNumber(x)) end
	return nil
end

local function complete(player, data, id)
	local st = story(data)
	local def = DEFS[id]
	-- saved first: the quest can never be finished (or paid) twice
	st.Done[id] = true
	if st.Main.Id == id then st.Main = { Id = "" } end
	st.Subs[id] = nil
	local msg = payReward(player, def) or string.format(TXT.Done, def.Title)
	if def.Unlock == "AutoCombat" and S.CombatService and type(S.CombatService.UnlockAutoCombat) == "function" then
		pcall(S.CombatService.UnlockAutoCombat, player)
		notify(player, TXT.Unlocked, "reward", "None") -- the completion line below has the sound
	end
	notify(player, def.Finish or msg, "reward", "QuestDone")
	if def.Finish then notify(player, msg, "reward", "None") end
	-- Reward.Item (e.g. Pip1's scroll): one more line under the reward line
	if type(def.Reward) == "table" and def.Reward.Item then
		local line = grantItem(player, def.Reward.Item, def.Reward.N)
		if line then notify(player, line, "reward", "None") end
	end
	if def.Clue then notify(player, def.Clue, "info") end -- story_depth §2-1: a clue toast after the closing lines
	-- E3: a stat-free title (Reward.Title, or Reward.TitleBy by the side of this quest's own pick), once
	local r = type(def.Reward) == "table" and def.Reward or nil
	local titleId = r and (r.Title or (type(r.TitleBy) == "table" and r.TitleBy[SIDE[st.Pick[id]] or ""]) or nil)
	local titles = S.TitleService
	if type(titleId) == "string" and Config.TitleDefs[titleId] and type(titles) == "table" and type(titles.Grant) == "function" then
		local ok, new = pcall(titles.Grant, player, titleId)
		if not ok then Util.Warn(TAG, "TitleService.Grant: " .. tostring(new)) end
		if ok and new == true then notify(player, string.format(TXT.NewTitle, Config.TitleDefs[titleId].Name), "reward", "RankUp") end
	end
	-- A23-34: the blacksmith's free first weapon (M1_1 GiveWeapon = tier; paid once, LootService.GrantFirstWeapon), its
	-- own "전투력 X → Y" line after the story lines
	if def.GiveWeapon and S.LootService and type(S.LootService.GrantFirstWeapon) == "function" then
		local ok, err = pcall(S.LootService.GrantFirstWeapon, player, def.GiveWeapon)
		if not ok then Util.Warn(TAG, "GrantFirstWeapon: " .. tostring(err)) end
	end
	dirty(player)
end

-- manual = the player asked (StoryAction "Open"); a step talked through a town NPC (Npc) never pops up by itself
local function openStep(player, id, track, manual)
	local def = DEFS[id]
	local step = def and stepOf(player, def, track.St)
	if not step or not step.Panel then return end
	if step.Npc and manual ~= true then return end
	local var = varFor(getData(player), step) -- E2
	pcall(function()
		Net.Get("OpenPanel"):FireClient(player, "Story", { Id = id, St = track.St, Var = var })
	end)
end

-- the active step reached its goal: next step (saved first), or the quest is finished / waits for [받기]
local function advance(player, data, id, track)
	local def = DEFS[id]
	track.P, track.T = 0, {}
	if stays[player] then stays[player][id .. ":" .. tostring(track.St)] = nil end
	if track.St < #def.Steps then
		track.St += 1
		local nextStep = stepOf(player, def, track.St)
		if nextStep and nextStep.Start then notify(player, nextStep.Start, "info") end
		dirty(player)
		openStep(player, id, track)
		return
	end
	if def.Claim then
		track.Claim = true
		notify(player, string.format(TXT.Claim, def.Title), "good")
		dirty(player)
		return
	end
	complete(player, data, id)
end

------------------------------------------------------------------ tracks
local function tracks(data)
	local st = story(data)
	local out = {}
	if st.Main.Id ~= "" and DEFS[st.Main.Id] then table.insert(out, { Id = st.Main.Id, Track = st.Main }) end
	for id, tr in st.Subs do table.insert(out, { Id = id, Track = tr }) end
	return out
end

local function feed(player, ev)
	local data = getData(player)
	if not data then return end
	for _, t in tracks(data) do
		local def, tr = DEFS[t.Id], t.Track
		local step = (not tr.Claim) and stepOf(player, def, tr.St) or nil
		local obj = step and step.Obj
		if obj and obj.Type == "Trials" then
			local changed, doneAll = false, true
			for _, sub in obj.List do
				local cur = num(tr.T[sub.Key])
				if cur < sub.Count then
					local add = eventAmount(player, sub, ev)
					if add > 0 then
						cur = math.min(sub.Count, cur + add)
						tr.T[sub.Key] = cur
						changed = true
						if cur >= sub.Count and sub.Say then notify(player, sub.Say, "info") end -- one line per part done
					end
				end
				if cur < sub.Count then doneAll = false end
			end
			if doneAll then advance(player, data, t.Id, tr) elseif changed then dirty(player) end
		elseif obj and obj.Count then
			local add = eventAmount(player, obj, ev)
			if add > 0 then
				tr.P = math.min(obj.Count, num(tr.P) + add)
				if tr.P >= obj.Count then advance(player, data, t.Id, tr) else dirty(player) end
			end
		end
	end
end

local function requirementsMet(player, data, def)
	local req = def.Requires or {}
	local st = story(data)
	if def.Factions and not def.Factions[faction(player)] then return false end
	-- A23-57: the artisan guild's own quests wait for its switch (a save that is Neutral already keeps what it has)
	if def.Factions and def.Factions.Neutral and not def.Factions.Halo and not def.Factions.Horns
		and not Config.FeatureOn("NeutralFaction") then return false end
	if req.ClassChosen and data.ClassChosen ~= true then return false end
	if req.Tutorial and num(data.TutorialStep) == 0 then return false end
	-- A23-70: TutorialDone = the first mission is claimed (TutorialStep 99); NotDone = none of these quests is done yet
	if req.TutorialDone and num(data.TutorialStep) ~= TUT_DONE then return false end
	for _, gone in req.NotDone or {} do
		if st.Done[gone] then return false end
	end
	if req.Level and num(data.Level, 1) < req.Level then return false end
	for _, need in req.Done or {} do
		if not st.Done[need] then return false end
	end
	-- E1: Requires.Pick = { Id, Is }: Is "Good" / "Evil" = that side of the saved pick (Purify / A count as Good), else the
	-- exact pick
	if type(req.Pick) == "table" then
		local pick = st.Pick[req.Pick.Id]
		if pick == nil or (pick ~= req.Pick.Is and SIDE[pick] ~= req.Pick.Is) then return false end
	end
	return data.ClassChosen == true
end

-- start the next main / newly available subs; check state / level / zone steps (1 s loop and on demand)
local function refresh(player)
	if not S.PlayerService.IsReady(player) then return end
	local data = getData(player)
	if not data then return end
	local st = story(data)
	local changed = false
	-- an old save (no story yet) that is already Lv10+ skips the chapters below its level, never later ones
	-- (story_depth E0, quest_chain rule): Lv10-24 = chapters 1-2, Lv25+ = chapters 1-3 (SQ.SkipChapters); no past
	-- rewards or choice points are paid, the next chapter starts
	if st.Main.Id == "" and next(st.Done) == nil and not st.First.Migrated and num(data.Level, 1) >= 10 then
		local upTo = 0
		for _, row in SQ.SkipChapters or {} do
			if num(data.Level, 1) >= row.Level then upTo = math.max(upTo, row.UpTo) end
		end
		for _, id in SQ.Main do
			local def = DEFS[id]
			if def and num(def.Chapter) <= upTo then st.Done[id] = true end
		end
		changed = true
	end
	st.First.Migrated = true
	-- main chain starts after the first mission is claimed
	if st.Main.Id == "" and num(data.TutorialStep) == TUT_DONE and data.ClassChosen == true then
		for _, id in SQ.Main do
			if not st.Done[id] then
				st.Main = { Id = id, St = 1, P = 0, T = {}, Claim = false }
				announceStart(player, data, DEFS[id])
				changed = true
				openStep(player, id, st.Main)
				break
			end
		end
	end
	for _, id in SQ.Subs do
		local def = DEFS[id]
		if def and not st.Done[id] and not st.Subs[id] and requirementsMet(player, data, def) then
			st.Subs[id] = { St = 1, P = 0, T = {}, Claim = false }
			announceStart(player, data, def) -- E5: a hidden sub stays secret
			if def.Pop then openStep(player, id, st.Subs[id]) end -- A23-70: the card opens by itself, once
			changed = true
		elseif st.Subs[id] and def.Factions and not def.Factions[faction(player)] then
			st.Subs[id] = nil -- faction changed: the faction-only sub leaves (A6 / design 6-3)
			changed = true
		end
	end
	-- state-driven steps
	for _, t in tracks(data) do
		local def, tr = DEFS[t.Id], t.Track
		local step = (not tr.Claim) and stepOf(player, def, tr.St) or nil
		local obj = step and step.Obj
		if obj then
			local done = false
			if obj.Type == "State" then
				done = stateTrue(player, obj.Key)
			elseif obj.Type == "Level" then
				done = levelReached(data, obj)
				if not done then changed = true end -- the row shows "(지금 LvN)"
			elseif obj.Type == "Enter" then
				done = zoneMatches(player, obj.Zone, currentZone(player))
			elseif obj.Type == "Near" then
				-- standing next to a landmark (e.g. the Crossroads fountain), checked by the 1 s loop
				local spot = SQ.Landmarks[obj.Spot]
				local root = Util.GetRoot(player)
				local inside = spot ~= nil and root ~= nil and (obj.Zone == nil or zoneMatches(player, obj.Zone, currentZone(player)))
					and Util.FlatDistance(root.Position, spot) <= (obj.Radius or 20)
				if num(obj.Stay) > 0 then
					-- E4: stay inside for obj.Stay seconds in one go (leaving starts again); P = whole seconds for the row
					local key = t.Id .. ":" .. tostring(tr.St)
					local mine = stays[player]
					if inside then
						if not mine then
							mine = {}
							stays[player] = mine
						end
						mine[key] = mine[key] or os.clock()
						local held = math.min(obj.Stay, math.floor(os.clock() - mine[key]))
						if held ~= num(tr.P) then
							tr.P = held
							changed = true
						end
						done = held >= obj.Stay
					else
						if mine then mine[key] = nil end
						if num(tr.P) ~= 0 then
							tr.P = 0
							changed = true
						end
					end
				else
					done = inside
				end
			end
			if done then advance(player, data, t.Id, tr) end
		end
	end
	-- user 2026-10-05: no window or waiting choice card ever pauses auto combat ("아이템 열어도 그대로 자동 전투"),
	-- and monsters keep attacking as usual; the old ChoicePending flag is cleared for saves/servers that set it
	if player:GetAttribute("ChoicePending") == true then player:SetAttribute("ChoicePending", false) end
	if changed then dirty(player) end
end

-- A23-34: ShopService runs this when the anvil opens, so an active M1_1 finishes (and hands over its weapon) before
-- the weapon shop shows
function StoryQuestService.Refresh(player)
	refresh(player)
end

------------------------------------------------------------------ quest list rows (QuestService.publish)
-- 3rd idea round #1: a step text without its count ('King Slimes %d/%d' -> 'King Slimes', 'The shard's test %d/3' ->
-- 'The shard's test', 'Spy by the woods' edge %d/%d s' -> 'Spy by the woods' edge' + unit 's')
local function countless(template)
	local unit = nil
	local s, n = string.gsub(template, "%s*%%d/%%d%s+s$", "")
	if n > 0 then unit = "s" end
	s = string.gsub(s, "%s*%%d/%%d", "")
	s = string.gsub(s, "%s*%%d/%d+", "")
	return s, unit
end

local function rowFor(player, data, id, track)
	local def = DEFS[id]
	local step = stepOf(player, def, track.St)
	local obj = step and step.Obj or {}
	local text, progress, target = step and step.Text or def.Title, 0, 1
	if track.Claim then
		text = string.format(TXT.Claim, def.Title)
		progress, target = 1, 1
	elseif obj.Type == "Trials" then
		local done = 0
		for _, sub in obj.List do
			if num(track.T[sub.Key]) >= sub.Count then done += 1 end
		end
		text = string.format(step.Text, done)
		progress, target = done, #obj.List
	elseif obj.Type == "Level" then
		text = string.format(step.Text, math.floor(num(data.Level, 1)))
	elseif obj.Type == "Near" and num(obj.Stay) > 0 then
		progress, target = math.floor(num(track.P)), math.floor(obj.Stay) -- E4: "%d/%d s"
		local okF, f = pcall(string.format, step.Text, progress, target)
		text = okF and f or step.Text
	elseif obj.Key == "OwnIron" then
		text = string.format(step.Text, Util.FormatNumber(math.floor(num(data.CarriedGold) + num(data.BankGold))))
	elseif obj.Count then
		progress, target = math.floor(num(track.P)), obj.Count
		local okF, f = pcall(string.format, step.Text, progress, target)
		text = okF and f or step.Text
	end
	-- 3rd idea round #1: the HUD draws a ShowProgress row's numbers itself ('King Slimes 0/2 0/2' on PC), so the text
	-- loses its '%d/%d' (a '%d/%d s' row keeps the unit as ProgressUnit)
	local unit = nil
	if target > 1 and not track.Claim and step and type(step.Text) == "string" then
		text, unit = countless(step.Text)
	end
	-- A23-71: a step that needs a skill hit (or a trial list still missing one) before the first skill says when it comes
	if not track.Claim and needsSkill(obj, track) and not Config.SkillLearned(data.SkillSlots, data.Level, data.Rebirths) then
		text = string.format(TXT.SkillLater, text, math.floor(num((Config.Skills.Unlock or {}).Q, 5)))
	end
	return {
		Id = "story:" .. id, Kind = def.Kind, Pinned = def.Kind == "Main", TutorialStep = TUT_DONE,
		Text = Config.Plural(text), Progress = progress, Target = target, -- raw '{Auto}' tokens (client fills them)
		ProgressUnit = unit, -- "s": a seconds row (its numbers are shown by the HUD)
		ShortName = (step and step.ShortName) or def.ShortName, -- 검수 2026-10-07: the phone HUD quest row (<= 14)
		RewardGold = 0, RewardXP = 0,
		CanClaim = track.Claim == true, ShowProgress = target > 1 and not track.Claim,
		-- Npc (A23-46): the town NPC this step is talked through (game dev 1: '!' over it, the row guides there)
		Story = { Id = id, St = track.St, Panel = step and step.Panel == true or nil, Guide = step and step.Guide or nil,
			Npc = (not track.Claim) and step and step.Npc or nil, Var = (not track.Claim) and varFor(data, step) or nil },
	}
end

-- the pinned main row (nil when no main is active)
function StoryQuestService.MainRow(player, data)
	local st = story(data)
	if st.Main.Id == "" or not DEFS[st.Main.Id] then return nil end
	return rowFor(player, data, st.Main.Id, st.Main)
end

local function visible(player, def)
	if def.Show == "GooseSoon" then
		local gs = workspace:FindFirstChild("GameState") or ReplicatedStorage:FindFirstChild("GameState")
		local ok, state = pcall(Net.GameState)
		gs = ok and state or gs
		if not gs then return false end
		if gs:GetAttribute("GooseActive") == true then return true end
		local nextAt = num(gs:GetAttribute("GooseNextAt"))
		return nextAt > 0 and nextAt - Util.Now() <= 180
	end
	return true
end

-- sub rows, best first, at most Config.StoryQuests.MaxSubs (quest_volume §2-6: 3; the HUD shows 2, the open list all):
-- 0 = a claim or a Talk / Choice card waiting mid-quest (past step 1), 1 = situational (Show), 2 = started (past step 1
-- or with progress) or S0, 3 = a new offer waiting at its first card, 4 = the rest; within a rank the newer quest
-- (later in StoryQuests.Subs) first. With A23-56's many subs a sub in progress is never pushed off by new offers or
-- older background subs, and the order index keeps the rows from swapping between refreshes (table.sort is not stable).
function StoryQuestService.SubRows(player, data)
	local st = story(data)
	local rows = {}
	for order, id in SQ.Subs do
		local tr = st.Subs[id]
		local def = DEFS[id]
		-- E5: a hidden sub shows once it is found (past its first step, or waiting for [Claim])
		local found = tr ~= nil and (tr.Claim or num(tr.St, 1) > 1)
		if tr and def and (tr.Claim or visible(player, def)) and (not def.Hidden or found) then
			-- before the first mission is accepted only S0 shows (A23-3: one goal at a time)
			if num(data.TutorialStep) ~= 0 or id == "S0" then
				local row = rowFor(player, data, id, tr)
				local step = (not tr.Claim) and stepOf(player, def, tr.St) or nil
				local waiting = step ~= nil and step.Panel == true -- a Talk / Choice card waits
				local started = num(tr.St, 1) > 1 or num(tr.P) > 0 or (type(tr.T) == "table" and next(tr.T) ~= nil)
				row.Rank = ((tr.Claim or (waiting and started)) and 0) or (def.Show and 1) or ((started or id == "S0") and 2)
					or (waiting and 3) or 4
				row.Order = order
				table.insert(rows, row)
			end
		end
	end
	table.sort(rows, function(a, b)
		if a.Rank ~= b.Rank then return a.Rank < b.Rank end
		return a.Order > b.Order
	end)
	local out = {}
	for i = 1, math.min(#rows, SQ.MaxSubs or 3) do
		rows[i].Rank, rows[i].Order = nil, nil
		table.insert(out, rows[i])
	end
	return out
end

-- [받기] on a story row (QuestService.onClaimQuest passes "story:<id>")
function StoryQuestService.Claim(player, id)
	local data = getData(player)
	if not data or type(id) ~= "string" then return end
	local st = story(data)
	local tr = (st.Main.Id == id) and st.Main or st.Subs[id]
	if not tr or tr.Claim ~= true or st.Done[id] then return end
	tr.Claim = false
	complete(player, data, id)
end

------------------------------------------------------------------ StoryAction (Talk / Choose / Open)
-- sound_spec 2026-10-07 §4-1: the moment of a story pick (the client plays Purify / Devour on it, never on a score
-- change): Fx "Choice" { Option = "Good" | "Evil" } to the picker (a Neutral A = Good, B = Evil)
local function choiceFx(player, option)
	local ok, err = pcall(Net.Fx, player, "Choice", { Option = option })
	if not ok then Util.Warn(TAG, "choice fx: " .. tostring(err)) end
end

-- A23-58 (user 2026-10-06, every good / evil pick): my side's own score only. Halo: Good = Honor +pts, Evil = Honor
-- -pts; Horns: Evil = Infamy +pts, Good = Infamy -pts; never below 0, the other side's score never moves. A rank the
-- lower score loses (Config.GetTitle) gets one line. PvP fame (GrantFame) and the weekly boards are not touched.
local function pickScore(player, f, option, pts)
	if pts <= 0 then return end
	local stat = f == "Halo" and "Honor" or "Infamy"
	if (f == "Halo") == (option == "Good") then
		S.PlayerService.AddStat(player, stat, pts)
		notify(player, string.format(option == "Good" and TXT.Good or TXT.Evil, pts), "good")
		return
	end
	local data = getData(player)
	local have = math.max(0, math.floor(num(data and data[stat])))
	local take = math.min(have, pts)
	if take <= 0 then
		-- 3rd idea round #5: nothing to take (A23-58 floor), but the pick still answers: no number, the shard leans
		notify(player, (f == "Halo" and TXT.OffSideHaloZero or TXT.OffSideHornsZero) .. " "
			.. (option == "Good" and TXT.LeanGood or TXT.LeanEvil), "info")
		return
	end
	S.PlayerService.SetStat(player, stat, have - take)
	notify(player, string.format(f == "Halo" and TXT.OffSideHalo or TXT.OffSideHorns, take), "info")
	local function rank(score)
		local _, r = Config.GetTitle(f, f == "Halo" and score or 0, f == "Horns" and score or 0)
		return r
	end
	if rank(have - take) < rank(have) then
		notify(player, f == "Halo" and TXT.RankDownHalo or TXT.RankDownHorns, "info")
	end
end

-- E6: the picked side's own reward (side "Good" | "Evil"; a Neutral A takes Good's, B takes Evil's): an item or potions
-- through LootService.GrantItem (its caps and full notices) and gold to the bank, then one line saying what came
local function payChoice(player, obj, side)
	local r = type(obj[side]) == "table" and obj[side].Reward or nil
	if type(r) ~= "table" then return end
	local parts = {}
	local id = r.Item or r.Potion
	local loot = S.LootService
	if type(id) == "string" and type(loot) == "table" and type(loot.GrantItem) == "function" then
		local ok, res = pcall(loot.GrantItem, player, id, math.floor(num(r.N, 1)))
		if not ok then Util.Warn(TAG, "GrantItem: " .. tostring(res)) end
		local given = ok and math.floor(num(res)) or 0
		if given > 0 then
			local item = Config.Loot.Items[id]
			local name = (item and item.Name) or Config.Loot.Text.Potion[id] or id
			table.insert(parts, given > 1 and string.format(Config.Loot.Text.GotN, name, given)
				or string.format(Config.Loot.Text.Got, name))
		end
	end
	local gold = math.floor(num(r.Gold))
	if gold > 0 then
		S.ProgressionService.AddBankGold(player, gold, "Quest")
		table.insert(parts, string.format(TXT.ChoiceGold, Util.FormatNumber(gold)))
	end
	if #parts > 0 then notify(player, table.concat(parts, " · "), "reward", "None") end -- the pick's own Choice sound
end

-- E2 (story_depth §7): a real pick (its Choice carries points) on the other side from the last real pick gets one kind
-- line; its side is saved either way (data.Story.LastSide). 0-point picks (easter eggs) never count.
local function changedMind(player, st, obj, pick)
	local side = SIDE[pick]
	if side == nil or (num(obj.Good and obj.Good.Points) <= 0 and num(obj.Evil and obj.Evil.Points) <= 0) then return end
	if st.LastSide ~= nil and st.LastSide ~= side then
		notify(player, side == "Good" and TXT.ChangedGood or TXT.ChangedEvil, "info")
	end
	st.LastSide = side
end

local function onStoryAction(player, id, action, option, ...)
	if select("#", ...) ~= 0 then return end
	if type(id) ~= "string" or type(action) ~= "string" or (option ~= nil and type(option) ~= "string") then return end
	if not S.PlayerService.IsReady(player) or player:GetAttribute("ClassChosen") ~= true then return end
	if not Util.RateLimit(player, "StoryAction", (Config.RateLimits and Config.RateLimits.StoryAction) or 0.4) then return end
	local def = DEFS[id]
	local data = getData(player)
	if not def or not data then return end
	local st = story(data)
	local tr = (st.Main.Id == id) and st.Main or st.Subs[id]
	if not tr or tr.Claim then return end
	local step = stepOf(player, def, tr.St)
	if not step or not step.Panel then return end
	if step.Npc and not npcNear(player, step.Npc) then return end -- A23-46: talked through the NPC, standing next to it
	local obj = step.Obj
	if action == "Open" then
		openStep(player, id, tr, true)
	elseif action == "Talk" and obj.Type == "Talk" then
		advance(player, data, id, tr)
	elseif action == "Choose" and obj.Type == "Choice" then
		local f = faction(player)
		if f == "Halo" or f == "Horns" then
			if option ~= "Good" and option ~= "Evil" then return end
			local pick = obj[option]
			st.Pick[id] = pick.Pick or option -- saved before the points
			choiceFx(player, option)
			local pts = math.floor(num(pick.Points))
			if pts > 0 then
				pickScore(player, f, option, pts)
			elseif not pick.Reply then
				notify(player, option == "Good" and TXT.LeanGood or TXT.LeanEvil, "info") -- E5: no "+0", the shard leans
			end
			if pick.Reply then notify(player, pick.Reply, "good", "None") end -- A23-70: the other person answers
			changedMind(player, st, obj, st.Pick[id])
			payChoice(player, obj, option)
		else
			if option ~= "A" and option ~= "B" then return end
			st.Pick[id] = option -- Neutral: recorded only (no good/evil score, A6)
			choiceFx(player, option == "A" and "Good" or "Evil")
			local side = obj[option == "A" and "Good" or "Evil"]
			if type(side) == "table" and side.Reply then
				notify(player, side.Reply, "good", "None") -- A23-70: the other person answers
			else
				notify(player, TXT.Recorded, "info")
			end
			changedMind(player, st, obj, option)
			payChoice(player, obj, option == "A" and "Good" or "Evil")
		end
		advance(player, data, id, tr)
	end
end

------------------------------------------------------------------ signals
local function onMonsterKilled(player, info)
	if type(info) ~= "table" or not (typeof(player) == "Instance" and player:IsA("Player")) then return end
	feed(player, { Kind = "Kill", Info = info })
end

local function onReleased(player, info)
	if type(info) ~= "table" then return end
	feed(player, { Kind = "Skill", Info = info })
end

local function onGoldEarned(player, amount, source)
	feed(player, { Kind = "Gold", Amount = amount, Source = source })
end

local function onGooseFinished(result, counts)
	if type(counts) ~= "table" then return end
	for p, c in counts do
		if typeof(p) == "Instance" and p:IsA("Player") and num(c) > 0 then
			local data = getData(p)
			local st = data and story(data)
			local f = faction(p)
			-- first rescue / poach ever: +1 honor (Halo) or infamy (Horns)
			if st and not st.First.Goose and (f == "Halo" or f == "Horns") then
				st.First.Goose = true
				local pts = (DEFS.S1 and DEFS.S1.FirstPoints) or 1
				S.PlayerService.AddStat(p, f == "Halo" and "Honor" or "Infamy", pts)
				notify(p, string.format(f == "Halo" and TXT.GooseFirstHalo or TXT.GooseFirstHorns, pts), "good")
			end
			feed(p, { Kind = "Goose" })
		end
	end
end

local function connect(serviceName, signalName, fn)
	local service = S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function StoryQuestService.Init(registry)
	S = registry
end

function StoryQuestService.Start()
	Net.Get("StoryAction").OnServerEvent:Connect(onStoryAction)
	connect("MonsterService", "MonsterKilled", onMonsterKilled)
	connect("CombatService", "Released", onReleased)
	connect("ProgressionService", "GoldEarned", onGoldEarned)
	connect("GooseService", "GooseFinished", onGooseFinished)
	connect("ZoneService", "ZoneChanged", function(player) pcall(refresh, player) end)
	connect("ProgressionService", "LeveledUp", function(player) pcall(refresh, player) end)
	connect("PlayerService", "PlayerReady", function(player)
		local data = getData(player)
		if data then sanitize(data) end
		pcall(refresh, player)
	end)
	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(refresh, p)
				if not ok then Util.Warn(TAG, "refresh: " .. tostring(err)) end
			end
			for p in stays do
				if p.Parent == nil then stays[p] = nil end -- E4 counts of players who left
			end
		end
	end)
	print("[StoryQuestService] started")
end

return StoryQuestService
]]></ProtectedString>
				<string name="ScriptGuid">{00C4FD06-42F1-493C-89F8-5A9372F31FC0}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">StoryQuestService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">00a781d6b8ab04140ad785ab00006371</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX65AE0B02C92B4035AA4C003D8B5970F0">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- FactionService.luau : Teams, first faction choice, altar faction switch (free / ticket), SetFaction, faction counts.
-- Factions: "Halo", "Horns", "Neutral" (playable, addendum A6) and "None" (not chosen yet).
-- Faction ratios / counts used by war, Size Justice and rebirth bonuses are Halo vs Horns only (A6).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "FactionService"
local RECOUNT_INTERVAL = 10 -- seconds between periodic faction recounts (spec §4.10)
local LEAVE_FORGET_SECONDS = 60 -- how long a leaving player stays in the "leaving" set (they are gone by then)
local ALTAR_PROMPT_RATE = 0.5 -- private rate limit for the altar ProximityPrompt
local WARN_THROTTLE = 10
-- TODO(config): no Config.Text key for a switch that costs nothing (leaving Neutral, addendum A6);
-- Config.Text.SwitchDonePlain is used instead once it exists.
local TEXT_SWITCH_DONE_PLAIN = "You joined the %s!"
local SCORE_NAME = { Halo = "Honor", Horns = "Infamy" } -- score lost by a FREE switch away from that faction
local SCORE_KEY = { Halo = "Honor", Horns = "Infamy" } -- CR-L11: the stat behind SCORE_NAME
local UNDERDOG_IDLE_SECONDS = 120 -- CR-L7: no input / combat for this long = not counted for the underdog bonus

local FactionService = {}

FactionService.FactionChanged = Util.Signal.new() -- (player, newFaction, oldFaction, reason: "Choose" | "Altar" | "Rebirth")

local S = nil
local teams = {} -- [factionId] = Team ("None" = players who have not picked yet)
local NONE_TEAM_NAME = "Choosing a side"
local leaving = {} -- [Player] = true while the player is leaving (excluded from counts)
local lastWarnAt = {}

local KNOWN = { Halo = true, Horns = true, Neutral = true, None = true }

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

-- a faction a player may newly pick / switch to (Config.Pickable: Halo / Horns; the artisan guild only while
-- Config.Features.NeutralFaction is on, A23-57)
local function isPlayable(factionId)
	return Config.Pickable(factionId)
end

-- A23-57: a request for the switched-off artisan guild is refused like any invalid one, with a log line
local function logNeutralRefused(player, factionId)
	if factionId == "Neutral" and not Config.FeatureOn("NeutralFaction") then
		warnThrottled("neutral", ("%s asked for the artisan guild, off for the beta (A23-57)"):format(player.Name))
	end
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

local function notify(player, key, kind, ...)
	local fmt = Config.Text[key]
	if type(fmt) ~= "string" then return end
	Net.Notify(player, string.format(fmt, ...), kind)
end

local function applyTeam(player, factionId)
	local team = teams[factionId]
	local ok, err = pcall(function()
		-- players who have not picked yet sit in the "진영 고르는 중" team, so the player list never shows "Neutral"
		if team and team.Parent then
			player.Neutral = false
			player.Team = team
		else
			player.Team = nil
			player.Neutral = true
		end
	end)
	if not ok then warnThrottled("team", "team assignment failed: " .. tostring(err)) end
end

local function getOrCreateTeam(def)
	if not def or type(def.TeamName) ~= "string" or def.TeamName == "" then return nil end
	local existing = Teams:FindFirstChild(def.TeamName)
	local team = (existing and existing:IsA("Team")) and existing or Instance.new("Team")
	team.Name = def.TeamName
	if def.TeamColor then team.TeamColor = def.TeamColor end
	team.AutoAssignable = false
	team.Parent = Teams
	return team
end

local function recount()
	if not S then return end
	local halo, horns = FactionService.GetCounts()
	local gs = Net.GameState()
	gs:SetAttribute("HaloCount", halo)
	gs:SetAttribute("HornsCount", horns)
	-- CR-L7: rebirth preview (Panels) reads the same counts the server bonus uses
	local uHalo, uHorns = FactionService.GetUnderdogCounts()
	gs:SetAttribute("UnderdogHalo", uHalo)
	gs:SetAttribute("UnderdogHorns", uHorns)
end

local function safeRecount()
	local ok, err = pcall(recount)
	if not ok then warnThrottled("recount", "recount failed: " .. tostring(err)) end
end

local function kaijuState(player)
	local k = S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function wantedStars(player)
	local p = S.PvPService
	if p and p.GetStars then
		local ok, n = pcall(p.GetStars, player)
		if ok and type(n) == "number" then return n end
	end
	return 0
end

local function bullyStacks(player)
	local j = S.JusticeService
	if j and j.GetBullyStacks then
		local ok, n = pcall(j.GetBullyStacks, player)
		if ok and type(n) == "number" then return n end
	end
	return 0
end

-- data value first, mirrored attribute as fallback
local function statNum(player, key)
	local data = S.PlayerService.GetData(player)
	local v = data and data[key]
	if type(v) ~= "number" then v = player:GetAttribute(key) end
	return tonumber(v) or 0
end

local function lastSwitchTime(player)
	return statNum(player, "LastSwitchTime")
end

-- CR-L7: rookies (PvPService.IsRookie) and idlers (PlayerService.GetLastActive, CR-M20) do not count
local function isUnderdogEligible(player, now)
	local pvp = S.PvPService
	if pvp and pvp.IsRookie then
		local ok, rookie = pcall(pvp.IsRookie, player)
		if ok and rookie == true then return false end
	end
	local ps = S.PlayerService
	if ps and ps.GetLastActive then
		local ok, t = pcall(ps.GetLastActive, player)
		if ok and type(t) == "number" and now - t > UNDERDOG_IDLE_SECONDS then return false end
	end
	return true
end

local function nearAltar(player)
	local root = Util.GetRoot(player)
	if not root then return false end
	local ok, altar = pcall(S.MapBuilder.GetAltar)
	if not ok or typeof(altar) ~= "Instance" or not altar:IsA("BasePart") then return false end
	if Util.FlatDistance(root.Position, altar.Position) > Config.Switch.AltarRange then return false end
	-- CR-H2: a root that just teleported is not near. IsPlausible always logs a suspicious move and returns false
	-- only while Config.AntiCheat.Enforce is true (log-only mode: always true)
	local zs = S.ZoneService
	if zs and zs.IsPlausible then
		local okP, plausible = pcall(zs.IsPlausible, player, root.Position)
		if okP and plausible == false then return false end
	end
	return true
end

-- Spec payload is (useTicket: boolean). Addendum A6 makes the target ambiguous with three factions, so an optional
-- target faction id (string) is accepted in either position: (useTicket, target) or (target, useTicket).
local function parseSwitchArgs(a, b)
	if type(a) == "boolean" then
		if b == nil then return a, nil end
		if type(b) == "string" then return a, b end
		return nil, nil
	end
	if type(a) == "string" and type(b) == "boolean" then
		return b, a
	end
	return nil, nil
end

-- target when the client did not name one: Halo <-> Horns as in the spec; Neutral joins the side that needs players
local function defaultTarget(current)
	if current == "Halo" then return "Horns" end
	if current == "Horns" then return "Halo" end
	local weaker = "None"
	local j = S.JusticeService
	if j and j.GetWeakerFaction then
		local ok, w = pcall(j.GetWeakerFaction)
		if ok then weaker = w end
	end
	if weaker == "Halo" or weaker == "Horns" then return weaker end
	local halo, horns = FactionService.GetCounts()
	return (horns < halo) and "Horns" or "Halo"
end

------------------------------------------------------------------ public API
function FactionService.GetFaction(player)
	if not player then return "None" end
	local f = player:GetAttribute("Faction")
	if type(f) == "string" and KNOWN[f] then return f end
	return "None"
end

function FactionService.GetPerks(player)
	return Config.Factions[FactionService.GetFaction(player)] or Config.Factions.None
end

-- ready players only, excluding leaving players; Neutral / None are not counted (A6: ratios are Halo vs Horns)
function FactionService.GetCounts()
	if not S then return 0, 0 end
	local halo, horns = 0, 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = FactionService.GetFaction(p)
			if f == "Halo" then
				halo += 1
			elseif f == "Horns" then
				horns += 1
			end
		end
	end
	return halo, horns
end

-- CR-L7: GetCounts without rookies and 120 s idlers (underdog rebirth bonus + GameState UnderdogHalo/Horns).
-- `always` (optional Player) is counted even if idle, e.g. the player rebirthing at the altar right now.
function FactionService.GetUnderdogCounts(always)
	if not S then return 0, 0 end
	local now = os.clock()
	local halo, horns = 0, 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = FactionService.GetFaction(p)
			if (f == "Halo" or f == "Horns") and (p == always or isUnderdogEligible(p, now)) then
				if f == "Halo" then
					halo += 1
				else
					horns += 1
				end
			end
		end
	end
	return halo, horns
end

function FactionService.GetTeam(factionId)
	local t = teams[factionId]
	if t and t.Parent then return t end
	return nil
end

-- the ONLY writer of the Faction stat. Never touches Honor/Infamy, tickets or cooldowns (callers do).
function FactionService.SetFaction(player, factionId, reason)
	if not player or not S then return end
	if type(factionId) ~= "string" or not KNOWN[factionId] or (factionId ~= "None" and not Config.Factions[factionId]) then
		Util.Warn(TAG, "SetFaction: invalid faction " .. tostring(factionId))
		return
	end
	local old = FactionService.GetFaction(player)
	S.PlayerService.SetStat(player, "Faction", factionId)
	applyTeam(player, factionId)
	FactionService.FactionChanged:Fire(player, factionId, old, reason or "Choose")
	safeRecount()
end

------------------------------------------------------------------ remotes
local function onChooseFaction(player, factionId)
	if not S.PlayerService.IsReady(player) then return end
	if type(factionId) ~= "string" or not isPlayable(factionId) then
		logNeutralRefused(player, factionId)
		return
	end
	if not Util.RateLimit(player, "ChooseFaction", Config.RateLimits.ChooseFaction) then return end
	if FactionService.GetFaction(player) ~= "None" then return end -- silent: first choice only

	-- read BEFORE changing; the sign-on bonus is Halo vs Horns only (A6), GetWeakerFaction never returns "Neutral"
	local wasWeaker = false
	if factionId == "Halo" or factionId == "Horns" then
		wasWeaker = (S.JusticeService.GetWeakerFaction() == factionId)
	end

	FactionService.SetFaction(player, factionId, "Choose")

	if wasWeaker then
		-- CR-L10: the sign-on bonus starts the altar cooldown (no instant free switch after cashing it)
		S.PlayerService.SetStat(player, "LastSwitchTime", os.time())
		S.ProgressionService.AddBankGold(player, Config.Justice.SignOnGold, "Other")
		notify(player, "UnderdogSignOn", "reward", Config.Justice.SignOnGold)
	end
	S.PlayerService.Respawn(player)
end

local function onSwitchFaction(player, a, b)
	if not S.PlayerService.IsReady(player) then return end
	local useTicket, target = parseSwitchArgs(a, b)
	if type(useTicket) ~= "boolean" then return end
	if target ~= nil and not isPlayable(target) then
		logNeutralRefused(player, target)
		return
	end
	if not Util.RateLimit(player, "SwitchFaction", Config.RateLimits.SwitchFaction) then return end

	local old = FactionService.GetFaction(player)
	if old == "None" then return end -- silent
	local new = target or defaultTarget(old)
	if new == old or not isPlayable(new) then return end -- silent
	if not nearAltar(player) then return end -- silent

	if S.GrudgeService.HasSack(player) then
		notify(player, "BlockedSack", "bad")
		return
	end
	if kaijuState(player) ~= "None" then
		notify(player, "BlockedKaiju", "bad")
		return
	end
	if wantedStars(player) > 0 then
		notify(player, "BlockedStars", "bad")
		return
	end
	if S.CombatService.IsInCombat(player) then
		notify(player, "TravelBlockedCombat", "bad")
		return
	end
	-- CR-L9: Neutral sheds bully stacks (A6), so a bully may not reach it through the altar
	if new == "Neutral" and bullyStacks(player) > 0 then
		notify(player, "BlockedBully", "bad")
		return
	end
	local remaining = lastSwitchTime(player) + Config.Switch.Cooldown - os.time()
	if remaining > 0 then
		notify(player, "SwitchCooldown", "bad", Util.FormatTime(remaining))
		return
	end

	-- leaving Neutral costs nothing (A6: no Neutral score yet), so a ticket is never consumed for it
	local lostScore = SCORE_NAME[old]
	-- CR-L11: a score of 0 has nothing to protect, so the ticket is kept then too
	local scoreKey = SCORE_KEY[old]
	local atStake = scoreKey ~= nil and statNum(player, scoreKey) > 0
	local ticketUsed = false
	if useTicket and lostScore and atStake then
		local okTicket, why = S.MonetizationService.UseTicket(player, "Faction")
		if not okTicket then
			-- CR-L25: a purchase still being saved is not "no ticket"
			notify(player, why == "Pending" and "TicketSaving" or "NoTicket", "bad")
			return
		end
		ticketUsed = true
	end

	-- free switch: the score of the faction being LEFT resets ("배신의 대가")
	if not ticketUsed then
		if old == "Halo" then
			S.PlayerService.SetStat(player, "Honor", 0)
		elseif old == "Horns" then
			S.PlayerService.SetStat(player, "Infamy", 0)
		end
	end

	S.PlayerService.AddStat(player, "SwitchCount", 1)
	S.PlayerService.SetStat(player, "LastSwitchTime", os.time())
	FactionService.SetFaction(player, new, "Altar")

	local newName = (Config.Factions[new] and Config.Factions[new].Name) or new
	if ticketUsed then
		notify(player, "SwitchDoneTicket", "good", newName)
	elseif lostScore and atStake then
		notify(player, "SwitchDoneFree", "good", newName, lostScore)
	else
		local fmt = Config.Text.SwitchDonePlain
		Net.Notify(player, string.format(type(fmt) == "string" and fmt or TEXT_SWITCH_DONE_PLAIN, newName), "good")
	end
	S.PlayerService.Respawn(player)
end

local function onPromptTriggered(prompt, player)
	if not prompt or prompt.Name ~= "AltarPrompt" then return end
	local parent = prompt.Parent
	if not parent or parent.Name ~= "Altar" then return end
	if not player or not S.PlayerService.IsReady(player) then return end
	if FactionService.GetFaction(player) == "None" then return end
	if not Util.RateLimit(player, "AltarPrompt", ALTAR_PROMPT_RATE) then return end
	Net.Get("OpenPanel"):FireClient(player, "Altar")
end

------------------------------------------------------------------ lifecycle
local function onPlayerReady(player, data)
	leaving[player] = nil
	local f = data and data.Faction
	if type(f) ~= "string" or not KNOWN[f] or (f ~= "None" and not Config.Factions[f]) then
		-- corrupted / unknown value: fall back to "None" (picker shows again). No FactionChanged during join.
		Util.Warn(TAG, "invalid stored faction " .. tostring(f) .. " for " .. player.Name .. "; reset to None")
		S.PlayerService.SetStat(player, "Faction", "None")
		f = "None"
	end
	applyTeam(player, f)
	safeRecount()
end

local function onPlayerLeaving(player)
	leaving[player] = true
	safeRecount()
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

function FactionService.Init(registry)
	S = registry
	for _, id in { "Halo", "Horns", "Neutral" } do
		local def = Config.Factions[id]
		if def then
			local ok, teamOrErr = pcall(getOrCreateTeam, def)
			if ok then
				teams[id] = teamOrErr
			else
				Util.Warn(TAG, "could not create team for " .. id .. ": " .. tostring(teamOrErr))
			end
		end
	end
	local okNone, noneTeam = pcall(getOrCreateTeam, { TeamName = NONE_TEAM_NAME, TeamColor = BrickColor.new("Medium stone grey") })
	if okNone and noneTeam then
		noneTeam.AutoAssignable = true -- new players join it before they pick a faction
		teams.None = noneTeam
	end
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
end

function FactionService.Start()
	Net.Get("ChooseFaction").OnServerEvent:Connect(onChooseFaction)
	Net.Get("SwitchFaction").OnServerEvent:Connect(onSwitchFaction)

	-- global hook (survives MapBuilder.Rebuild); filtered to workspace.Map.Landmarks.Altar.AltarPrompt
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
	local ok, altar = pcall(S.MapBuilder.GetAltar)
	if not ok or typeof(altar) ~= "Instance" or not altar:FindFirstChild("AltarPrompt") then
		Util.Warn(TAG, "altar or AltarPrompt not found at start; the altar panel cannot open until it exists")
	end

	task.spawn(function()
		while true do
			task.wait(RECOUNT_INTERVAL)
			safeRecount()
		end
	end)
	safeRecount()

	print("[FactionService] started")
end

return FactionService
]]></ProtectedString>
				<string name="ScriptGuid">{064E1610-42EF-469A-830A-15B07DECFAD8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">FactionService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e53000008a9</UniqueId>
			</Properties>
