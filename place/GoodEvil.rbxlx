				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- FirstSteps.luau : A23-68 (user 2026-10-07 "ㅇㅇ 모두 좋다 구현하자"; docs/design/early_churn_research_2026-10-07.md)
-- the first minutes' helpers on this client.
--   #1 after the guide's [Accept] the server sends Fx "Travel" { UserId, To, T } and moves me to the meadow entrance T s
--      later, then always Fx "TravelDone" { UserId } (dev2 324055a, docs/design/early_churn_server_2026-10-07.md): a
--      centre line "Off to Squishy Meadow! 3", 2, 1; the screen fades to black from T - Fade s and back in on
--      TravelDone (T + MaxExtra s at the latest); open windows close. Input is never blocked here (the server ignores
--      attacks until it moved me).
--   #2 during the first mission (TutorialStep 1..98): Idle s within my reach of a monster without a swing of mine -> the
--      attack button hint (C.HUD.Hint "Attack"); in the meadow before my first kill (my first Reward Fx) a small marker
--      over the nearest monster (C.QuestMarker.Focus). Each at most once per session. The "Try your skill!" hint moved
--      to the moment Q is learned (A23-71, SkillBar). The looks are image dev's: every call is pcall'd, so a missing
--      function just skips the hint.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local FirstSteps = {}
local LocalPlayer = Players.LocalPlayer
local C = nil

local TXT = { Travel = "Off to %s!", Count = "%s  %d", Place = "the meadow" }
local TRAVEL = { Fade = 0.4, MaxExtra = 1.5, FadeIn = 0.5, Token = 0, Gui = nil, Black = nil, Line = nil, Done = false }
local HINT = { Idle = 5, Tick = 0.25, Search = 120, MarkerGap = 0.5, NearSince = nil,
	AttackShown = false, Killed = false, MarkerAt = -math.huge, Marked = nil }

local function attr(key, default)
	local v = LocalPlayer:GetAttribute(key)
	if v == nil then return default end
	return v
end

local function call(mod, fn, ...)
	local m = C and C[mod]
	local f = type(m) == "table" and m[fn] or nil
	if type(f) ~= "function" then return false end
	return pcall(f, ...)
end

local function mine(data)
	return type(data) == "table" and data.UserId == LocalPlayer.UserId
end

------------------------------------------------------------------ #1 travel fade
function TRAVEL.Build()
	if TRAVEL.Gui and TRAVEL.Gui.Parent then return end
	local gui = Instance.new("ScreenGui")
	gui.Name = "TravelFade"
	gui.IgnoreGuiInset, gui.ResetOnSpawn, gui.DisplayOrder = true, false, 75
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
	local black = Instance.new("Frame")
	black.Name = "Black"
	black.BackgroundColor3, black.BorderSizePixel, black.BackgroundTransparency = Color3.new(0, 0, 0), 0, 1
	black.Size = UDim2.fromScale(1, 1)
	black.Parent = gui
	local line = Instance.new("TextLabel")
	line.Name = "Line"
	line.AnchorPoint, line.Position, line.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.38), UDim2.new(0.8, 0, 0, 56)
	line.BackgroundTransparency, line.TextScaled, line.Text = 1, true, ""
	line.TextColor3, line.TextStrokeTransparency = Color3.fromRGB(255, 236, 170), 0.2
	line.Font = Enum.Font.GothamBold
	line.ZIndex = 2
	line.Parent = gui
	local kit = C and C.UIKit
	if type(kit) == "table" and type(kit.StyleText) == "function" then pcall(kit.StyleText, line, "Title") end
	gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	TRAVEL.Gui, TRAVEL.Black, TRAVEL.Line = gui, black, line
end

local function fade(to, seconds)
	if not TRAVEL.Black then return end
	TweenService:Create(TRAVEL.Black, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
		{ BackgroundTransparency = to }):Play()
end

-- back in (TravelDone or the time limit): the black lifts, then the gui goes
function TRAVEL.Finish(token)
	if token ~= TRAVEL.Token or TRAVEL.Done then return end
	TRAVEL.Done = true
	if TRAVEL.Line then TRAVEL.Line.Text = "" end
	fade(1, TRAVEL.FadeIn)
	task.delay(TRAVEL.FadeIn + 0.1, function()
		if token == TRAVEL.Token and TRAVEL.Gui then
			TRAVEL.Gui:Destroy()
			TRAVEL.Gui, TRAVEL.Black, TRAVEL.Line = nil, nil, nil
		end
	end)
end

function TRAVEL.Start(data)
	TRAVEL.Token += 1
	local token = TRAVEL.Token
	TRAVEL.Done = false
	local t = math.clamp(tonumber(data.T) or 3, 0.5, 10)
	local zone = type(data.To) == "string" and Config.Zones[data.To] or nil
	local place = zone and zone.Name or TXT.Place
	TRAVEL.Build()
	call("Panels", "Close", false) -- the guide window: the walk is over before it could be read
	local whole = math.floor(t + 0.5)
	for i = 0, whole - 1 do
		task.delay(i, function()
			if token == TRAVEL.Token and not TRAVEL.Done and TRAVEL.Line then
				TRAVEL.Line.Text = string.format(TXT.Count, string.format(TXT.Travel, place), whole - i)
			end
		end)
	end
	task.delay(math.max(0, t - TRAVEL.Fade), function()
		if token == TRAVEL.Token and not TRAVEL.Done then fade(0, TRAVEL.Fade) end
	end)
	task.delay(t + TRAVEL.MaxExtra, function() TRAVEL.Finish(token) end)
end

------------------------------------------------------------------ #2 hints in place
local function firstMission()
	local step = tonumber(attr("TutorialStep", 0)) or 0
	return step >= 1 and step < 99
end

local function myRoot()
	local ch = LocalPlayer.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then return root end
	return nil
end

-- the nearest live monster (mine first: the first mission's slimes are personal) within `limit` studs
function HINT.Nearest(pos, limit)
	local folder = workspace:FindFirstChild("Monsters")
	if not folder then return nil, math.huge end
	local best, bestD, bestMine = nil, limit, false
	for _, m in folder:GetChildren() do
		local r = m:IsA("Model") and (m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")) or nil
		local hum = m:FindFirstChildOfClass("Humanoid")
		if r and (not hum or hum.Health > 0) then
			local d = (r.Position - pos).Magnitude
			local owner = m:GetAttribute("OwnerUserId")
			local isMine = owner == LocalPlayer.UserId
			if d <= limit and (best == nil or (isMine and not bestMine) or (isMine == bestMine and d < bestD)) then
				best, bestD, bestMine = m, d, isMine
			end
		end
	end
	return best, best and bestD or math.huge
end

function HINT.Reach()
	local p = Config.AttackProfile(attr("Class", "Warrior"), tonumber(attr("WeaponTier", 0)) or 0, attr("Faction", "None"))
	return (type(p) == "table" and tonumber(p.Range) or 7) + 2 -- a little slack: standing at the edge counts
end

function HINT.Mark(model)
	if HINT.Marked == model then return end
	HINT.Marked = model
	call("QuestMarker", "Focus", model)
end

function HINT.Step(now)
	if not firstMission() then
		HINT.NearSince = nil
		if HINT.Marked then HINT.Mark(nil) end
		return
	end
	local root = myRoot()
	if not root then return end
	-- the attack hint: Idle s within reach without a swing of mine (a swing restarts the wait)
	if not HINT.AttackShown then
		local _, d = HINT.Nearest(root.Position, HINT.Reach())
		if d < math.huge then
			HINT.NearSince = HINT.NearSince or now
			if now - HINT.NearSince >= HINT.Idle then
				HINT.AttackShown = true
				call("HUD", "Hint", "Attack")
			end
		else
			HINT.NearSince = nil
		end
	end
	-- the marker over the nearest monster, in the meadow, until my first kill
	if HINT.Killed or attr("ZoneId", "") ~= "SlimeMeadow" then
		if HINT.Marked then HINT.Mark(nil) end
	elseif now - HINT.MarkerAt >= HINT.MarkerGap then
		HINT.MarkerAt = now
		HINT.Mark((HINT.Nearest(root.Position, HINT.Search)))
	end
end

function HINT.Kill()
	if HINT.Killed then return end
	HINT.Killed = true
	if HINT.Marked then HINT.Mark(nil) end
end

------------------------------------------------------------------ wiring
function FirstSteps.OnFx(kind, data)
	if kind == "Travel" and mine(data) then
		TRAVEL.Start(data)
	elseif kind == "TravelDone" and mine(data) then
		TRAVEL.Finish(TRAVEL.Token)
	elseif (kind == "Swing" or kind == "Release" or kind == "Skill") and mine(data) then
		HINT.NearSince = nil
	elseif kind == "Reward" then -- sent only to the killer (ProgressionService)
		HINT.Kill()
	end
end

function FirstSteps.Init(registry)
	C = registry
end

function FirstSteps.Start()
	task.spawn(function()
		local ok, err = pcall(function() Net.Get("Fx").OnClientEvent:Connect(FirstSteps.OnFx) end)
		if not ok then warn("[FirstSteps] Fx hookup failed: " .. tostring(err)) end
	end)
	task.spawn(function()
		while true do
			task.wait(HINT.Tick)
			local ok, err = pcall(HINT.Step, os.clock())
			if not ok then warn("[FirstSteps] " .. tostring(err)) task.wait(5) end
		end
	end)
end

-- test aids
FirstSteps.Travel, FirstSteps.Hint, FirstSteps.Text = TRAVEL, HINT, TXT

return FirstSteps
]]></ProtectedString>
					<string name="ScriptGuid">{DDBCC464-84F4-4433-911E-44CA0262EFF0}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">FirstSteps</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300021543</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXD45D58E8F8484C30963306613291CFBA">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- VitalsUI.luau : HP / MP bars beside the HUD portrait and the two potion buttons of the combat cluster (A23-26 HUD v2:
-- HUD places them from HudLayout rects through PlaceBars / PlacePotions), potion keys 1 / 2 (BB1 Keybinds).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Util = require(ReplicatedStorage.Shared.Util)
local VitalsUI = {}
local C, UIKit = nil, nil
local player = Players.LocalPlayer
local ui = { Potions = {}, CharacterConnections = {}, HumanoidConnections = {}, WatchedAttributes = {
	Mana = true, MaxMana = true, HPPotionCount = true, MPPotionCount = true,
	HPPotionReadyAt = true, MPPotionReadyAt = true, ClassChosen = true, DataLoaded = true, KaijuState = true,
} }
local COL = { HP = Color3.fromRGB(239, 45, 51), MP = Color3.fromRGB(30, 171, 245), Dim = Color3.fromRGB(150, 150, 160) }
local ACTION = { HP = "PotionHP", MP = "PotionMP" } -- Config.Keybinds action of each potion button
-- UI round 2 #3 (검수 2026-10-07): with no potions the [Buy] press shows the way to the merchant (HUD.ShowGuide)
local WAY = { Label = "Potion shop", Gap = 1, At = -math.huge }

local function canUse()
	if player.Parent ~= Players or player:GetAttribute("DataLoaded") ~= true
		or player:GetAttribute("ClassChosen") ~= true or not Util.IsAlive(player) then return false end
	if ui.Character ~= player.Character or ui.Humanoid ~= Util.GetHumanoid(player) then return false end
	local kaiju = player:GetAttribute("KaijuState")
	if kaiju == "Active" or kaiju == "Siren" then return false end
	for _, name in { "Intro", "FactionPicker", "ClassPicker", "WorldMap", "Panels" } do
		local module = C[name]
		if module and type(module.IsOpen) == "function" then
			local ok, open = pcall(module.IsOpen)
			if not ok or open then return false end
		end
	end
	return true
end

local function finiteNumber(value, fallback)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge and value or fallback
end

local function potionState(kind)
	local count = Config.NormalizePotionCount(player:GetAttribute(kind .. "PotionCount"))
	local deadline = finiteNumber(player:GetAttribute(kind .. "PotionReadyAt"), 0)
	local left = math.max(0, deadline - workspace:GetServerTimeNow())
	-- Stock is shown in the title: even the narrow touch slot can show stock and the entire countdown.
	if left > 0 then return count, tostring(math.ceil(left)) .. "s", false end
	if player:GetAttribute("DataLoaded") ~= true or player:GetAttribute("ClassChosen") ~= true then return count, "Wait", false end
	if ui.Character ~= player.Character or not Util.IsAlive(player) then return count, "Revive", false end
	local kaiju = player:GetAttribute("KaijuState")
	if kaiju == "Active" or kaiju == "Siren" then return count, "Kaiju", false end
	if count <= 0 then return 0, Config.Vitals.MerchantEnabled == true and "Buy" or "Soon", false end
	if not canUse() then return count, "Wait", false end
	local humanoid = Util.GetHumanoid(player)
	local amount = kind == "HP" and humanoid.Health or finiteNumber(player:GetAttribute("Mana"), 0)
	local maximum = kind == "HP" and humanoid.MaxHealth or finiteNumber(player:GetAttribute("MaxMana"), Config.Vitals.MaxMana)
	if amount >= maximum then return count, "Full", false end
	return count, "Use", true
end

-- the beam to the potion merchant (workspace.Map.NPCs.<PotionMerchantName>) in the Crossroads, else to the way there
function WAY.Show()
	if os.clock() - WAY.At < WAY.Gap then return end
	WAY.At = os.clock()
	local hud, qt = C and C.HUD, C and C.QuestTarget
	if type(hud) ~= "table" or type(hud.ShowGuide) ~= "function" then return end
	local tune = Config.Vitals or {}
	local zone = player:GetAttribute("ZoneId")
	local target = nil
	if zone == "Crossroads" then
		local map = workspace:FindFirstChild("Map")
		local npcs = map and map:FindFirstChild("NPCs")
		local npc = npcs and npcs:FindFirstChild(tune.PotionMerchantName or "PotionMerchant")
		if npc and npc:IsA("Model") then
			target = npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart", true)
		end
	elseif type(qt) == "table" and type(qt.Travel) == "function" then
		local ok, part = pcall(qt.Travel, "Crossroads", zone)
		if ok then target = part end
	end
	if typeof(target) == "Instance" and target:IsA("BasePart") then pcall(hud.ShowGuide, target, WAY.Label) end
end

local function requestPotion(kind)
	local count, label, available = potionState(kind)
	if not available then
		if count <= 0 and label == "Buy" then WAY.Show() end -- no potions: show the way to the merchant
		return
	end
	-- Display checks only: the server alone consumes stock, heals, charges MP and applies the deadline.
	Net.Get("UsePotion"):FireServer(kind)
end

-- HP / MP bars (BarTrack art). Built at their v2 heights (the fill's rounded caps follow the build height); HUD places
-- them with PlaceBars. The text reads '82/152' (no 'HP': it is not mistaken for the potion).
function VitalsUI.BuildStats(parent, touch)
	for i, kind in { "HP", "MP" } do
		local frame, set, text = UIKit.ArtBar({ Name = kind .. "Bar", Parent = parent,
			Size = UDim2.fromOffset(touch and 200 or 262, (touch and 18 or 22) - (i - 1) * 3), Color = COL[kind],
			TextSize = touch and 15 or 12 })
		text.TextWrapped = false
		C.HUD.FitText(text, 11)
		ui[kind] = { Frame = frame, Set = set, Text = text }
	end
end

-- HUD v2: the bars on their HudLayout rects (logical units, HUD root space)
function VitalsUI.PlaceBars(hp, mp)
	for kind, r in { HP = hp, MP = mp } do
		local bar = ui[kind]
		if bar and r then
			bar.Frame.Position = UDim2.fromOffset(r.X, r.Y)
			bar.Frame.Size = UDim2.fromOffset(r.W, r.H)
		end
	end
end

-- potion text sizes follow the button size (count in the socket, status over the icon, key badge)
function VitalsUI.LayoutPotions()
	local scale = UIKit.Gui:FindFirstChildOfClass("UIScale")
	local s = scale and math.max(0.1, scale.Scale) or 1
	for _, potion in ui.Potions do
		local d = potion.Size or 72
		potion.Count.Size = UDim2.fromOffset(math.max(d * 0.3, math.ceil(14 / s)), math.max(d * 0.24, math.ceil(12 / s)))
		potion.Status.Size = UDim2.fromOffset(d * 0.86, math.max(d * 0.26, math.ceil(12 / s)))
		if potion.Key then
			local keyH = math.max(15, math.ceil(12 / s))
			potion.Key.Size = UDim2.fromOffset(keyH, keyH)
		end
	end
end

-- two round potion buttons (Firefly BtnPotion: navy disc, count socket bottom-right) left of the skill button: the potion
-- icon fills the face, the stock sits in the socket, a short status ('3초' / '가득' / '구매') shows over the icon only when
-- the potion cannot be drunk, the key badge (keyboards) sits bottom-left. HUD places the row with PlacePotions.
function VitalsUI.BuildPotions(parent, touch)
	local row = UIKit.Create("Frame", { Name = "Potions", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(152, 72), Parent = parent })
	for _, kind in { "HP", "MP" } do
		local button = UIKit.ArtButton("BtnPotion", { Name = kind .. "Potion", Parent = row,
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(72, 72) }, function() requestPotion(kind) end,
			{ CornerRadius = UDim.new(0.5, 0) })
		local icon = UIKit.ArtImage("IconPotion" .. kind, { Name = "Icon", Parent = button,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.48, 0.47), Size = UDim2.fromScale(0.56, 0.56),
			ZIndex = 3 })
		local count = UIKit.LightText({ Name = "Count", Parent = button, Text = "0",
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.83, 0.8), Size = UDim2.fromOffset(22, 18),
			TextScaled = true, Number = true, MaxTextSize = touch and 18 or 16, ZIndex = 5 })
		local status = UIKit.LightText({ Name = "Status", Parent = button, Text = "",
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(60, 18),
			TextScaled = true, Title = true, MaxTextSize = touch and 16 or 14, ZIndex = 6, Visible = false })
		C.HUD.FitText(count, 13, true)
		C.HUD.FitText(status, 12, true)
		local key = nil
		local kbm = C and C.Keybinds
		local showsKeys = UserInputService.KeyboardEnabled
		if type(kbm) == "table" and type(kbm.ShowsKeys) == "function" then showsKeys = kbm.ShowsKeys() end
		if showsKeys then -- review of 27246d1: the same rule as Keybinds / HUD
			-- BB1: the badge shows the potion's current key (VitalsUI.RefreshKeys) and widens for "Ctrl" / "Num1"
			key = UIKit.LightText({ Name = "Key", Parent = button, Text = "", TextSize = 11, ZIndex = 6,
				AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0.04, 1), Size = UDim2.fromOffset(15, 15),
				AutomaticSize = Enum.AutomaticSize.X })
			C.HUD.FitText(key, 11)
		end
		ui.Potions[kind] = { Button = button, Icon = icon, Count = count, Status = status, Key = key,
			Action = ACTION[kind], Size = 72 }
	end
	ui.Row = row
	VitalsUI.LayoutPotions()
	VitalsUI.RefreshKeys()
	if ui.Refresh then ui.Refresh() end
	return row
end

-- HUD v2: the pair on Rects.potions (logical units): two square-sized cells split by rect.Gap, MP at the right edge
function VitalsUI.PlacePotions(rect)
	if not ui.Row or not rect then return end
	local gap = tonumber(rect.Gap) or 7.5
	local d = math.min(rect.H, (rect.W - gap) / 2)
	ui.Row.Position = UDim2.fromOffset(rect.X, rect.Y)
	ui.Row.Size = UDim2.fromOffset(rect.W, rect.H)
	for i, kind in { "HP", "MP" } do
		local potion = ui.Potions[kind]
		if potion then
			local cx = rect.W - d / 2 - (2 - i) * (d + gap)
			potion.Button.Position = UDim2.fromOffset(cx, rect.H / 2)
			potion.Button.Size = UDim2.fromOffset(d, d)
			potion.Size = d
		end
	end
	VitalsUI.LayoutPotions()
end

-- BB1: each potion badge shows its action's current key (Keybinds.Label); hidden while that action has no key or
-- Settings.KeyBadges is off. Runs on Keybinds.Changed and Settings.Changed.
function VitalsUI.RefreshKeys()
	local kb, st = C and C.Keybinds, C and C.Settings
	local badges = true
	if type(st) == "table" and type(st.Get) == "function" then
		local ok, v = pcall(st.Get, "KeyBadges")
		badges = not ok or v ~= false
	end
	for _, potion in ui.Potions do
		local key = potion.Key
		if key and key.Parent then
			local label, bound = "", false
			if type(kb) == "table" then
				local okL, text = pcall(kb.Label, potion.Action)
				local okK, name = pcall(kb.KeyName, potion.Action)
				label = okL and type(text) == "string" and text or ""
				bound = okK and type(name) == "string" and name ~= ""
			end
			key.Text = label
			key.Visible = badges and bound and label ~= ""
		end
	end
end

local function refresh()
	local humanoid = Util.GetHumanoid(player)
	local hp, maxHP = humanoid and humanoid.Health or 0, humanoid and humanoid.MaxHealth or 1
	local mana = math.max(0, finiteNumber(player:GetAttribute("Mana"), 0))
	local maxMana = math.max(1, finiteNumber(player:GetAttribute("MaxMana"), Config.Vitals.MaxMana))
	for kind, values in { HP = { hp, maxHP }, MP = { mana, maxMana } } do
		local bar = ui[kind]
		if bar then
			bar.Set(values[1] / math.max(1, values[2]))
			bar.Text.Text = string.format("%d/%d", math.ceil(values[1]), math.ceil(values[2]))
		end
		local potion = ui.Potions[kind]
		if potion then
			local count, status, available = potionState(kind)
			potion.Count.Text = tostring(count)
			potion.Status.Text = status
			potion.Status.Visible = not available
			potion.Button.Active = available
			potion.Button:SetAttribute("Disabled", not available)
			if potion.Button:IsA("ImageButton") then
				potion.Button.ImageColor3 = not available and Color3.fromRGB(178, 174, 166) or Color3.new(1, 1, 1)
			end
			if potion.Icon then potion.Icon.ImageColor3 = available and Color3.new(1, 1, 1) or COL.Dim end
		end
	end
end

ui.Refresh = function()
	local ok, err = pcall(refresh)
	if not ok then Util.Warn("VitalsUI", tostring(err)) end
end

local function clearConnections(list)
	for _, connection in list do connection:Disconnect() end
	table.clear(list)
end

local function bindHumanoid(humanoid)
	if ui.Humanoid == humanoid then return end
	clearConnections(ui.HumanoidConnections)
	ui.Humanoid = humanoid
	if humanoid then
		table.insert(ui.HumanoidConnections, humanoid.HealthChanged:Connect(ui.Refresh))
		table.insert(ui.HumanoidConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(ui.Refresh))
	end
	ui.Refresh()
end

local function bindCharacter(character)
	clearConnections(ui.CharacterConnections)
	ui.Character = character
	bindHumanoid(character and character:FindFirstChildOfClass("Humanoid") or nil)
	if not character then return end
	table.insert(ui.CharacterConnections, character.ChildAdded:Connect(function(child)
		if player.Character == character and child:IsA("Humanoid") then bindHumanoid(child) end
	end))
	table.insert(ui.CharacterConnections, character.ChildRemoved:Connect(function(child)
		if ui.Character == character and child == ui.Humanoid then bindHumanoid(nil) end
	end))
	table.insert(ui.CharacterConnections, character.AncestryChanged:Connect(ui.Refresh))
end

function VitalsUI.Init(registry)
	C, UIKit = registry, registry.UIKit
end

function VitalsUI.Start()
	if ui.Started then return end
	ui.Started = true
	-- This game equips custom Parts, so its potion shortcuts own 1/2 and its HP bar owns health display.
	local starterGui = game:GetService("StarterGui")
	pcall(starterGui.SetCoreGuiEnabled, starterGui, Enum.CoreGuiType.Backpack, false)
	pcall(starterGui.SetCoreGuiEnabled, starterGui, Enum.CoreGuiType.Health, false)
	-- BB1: the potion keys come from Keybinds (default 1 / 2); Keybinds forwards every key press (and Dispatch tests)
	local keys = C.Keybinds
	local began = type(keys) == "table" and type(keys.Began) == "table" and keys.Began or UserInputService.InputBegan
	began:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() or type(keys) ~= "table" or keys.IsCapturing() then return end
		local action = keys.ActionFor(input)
		if action == "PotionHP" then requestPotion("HP") end
		if action == "PotionMP" then requestPotion("MP") end
	end)
	-- BB1: the potion badges follow key changes and Settings.KeyBadges
	if type(keys) == "table" and type(keys.Changed) == "table" then keys.Changed:Connect(VitalsUI.RefreshKeys) end
	local st = C.Settings
	if type(st) == "table" and type(st.Changed) == "table" then st.Changed:Connect(VitalsUI.RefreshKeys) end
	VitalsUI.RefreshKeys()
	player.AttributeChanged:Connect(function(name)
		if ui.WatchedAttributes[name] then ui.Refresh() end
	end)
	player.CharacterAdded:Connect(bindCharacter)
	player.CharacterRemoving:Connect(function(character)
		if ui.Character == character then bindCharacter(nil) end
	end)
	bindCharacter(player.Character)
	task.spawn(function()
		while true do
			ui.Refresh()
			task.wait(0.2)
		end
	end)
	print("[VitalsUI] started")
end

return VitalsUI
]]></ProtectedString>
					<string name="ScriptGuid">{CB72B0E9-D1E2-464D-A32E-4A2DF833F6C6}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">VitalsUI</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300021555</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6FD3E0B3CFAA4A778E099A9304411D6D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- HudLayout.luau : A23-40 screen layout B ("보여 준 게임처럼") as one pure function (no instances, no services).
-- The rectangles of docs/design/hud_layout_B_imgdev_2026-10-06.json are real pixels on two reference screens: desktop
-- 1280x720 (MainGui UIScale 0.8; the PC numbers are 검수's docs/design/hud_layout_B_2026-10-06.json) and phone 749x361
-- (UIScale 0.75; 이미지 개발 placed the phone by the A23-40 rules), both with a 58 px top bar.
-- HudLayout.Compute turns them into MainGui logical units (before UIScale) for the current screen: every item keeps its
-- distance to the edge it belongs to (top-left / top-centre / top-right / bottom-centre / bottom-right), the top rows follow
-- the real top-bar inset, the phone combat cluster follows the real jump button, the centre column narrows between the
-- left and right blocks, and on PCs the bottom-centre group moves left when the corner cluster would cover it.
--   PC:    top-left round minimap + 2 quest lines under it, top-centre war meter -> chips -> next event -> notify,
--          bottom-centre face + 'Lv · 전투력' + HP | MP + XP + icon tile row, bottom-right combat cluster, top-right the
--          [메뉴] tile (A23-40 정정: its tiles fold out to the left; the Tab list opens under it).
--   phone: the bottom centre belongs to the thumbstick and the combat buttons, so the face / bars / tile row sit top-right
--          (the quest lines beside the minimap, the centre column between them).
--   A23-40 보강 (user 2026-10-06 "메뉴 위치랑 가운데 바가 로블록스 기본 메뉴랑 위치가 같으면 좋겠어"): on both, [메뉴] and the war
--          meter sit IN the Roblox top bar row (env.Topbar = GuiService.TopbarInset, the free part of the bar right of
--          Roblox's own buttons), on the same middle line as Roblox's buttons; [메뉴] is as big as a Roblox button
--          (TOPBAR.Button real px, >= MIN_TAP on touch) and TOPBAR.Edge px from the bar's free right end; both keep their
--          real px size on every UIScale. The chips, the next-event line and notify start right under the bar, and the
--          [메뉴] fold-out runs left along the bar first, then down.
local HudLayout = {}

-- reference screens of the approved sheets (real px)
local REF = {
	Desktop = { W = 1280, H = 720, Scale = 0.8, Inset = 58 },
	Touch = { W = 749, H = 361, Scale = 0.75, Inset = 58, Jump = { 654, 271, 70, 70 } },
}

-- id = { desktop anchor, desktop { x, y, w, h }, touch { x, y, w, h }, touch anchor (default: the desktop one) }
-- anchors: TL top-left, TC top-centre, TR top-right, BC bottom-centre, BR bottom-right (touch: the jump button)
local ITEMS = {
	minimap = { "TL", { 14, 66, 150, 150 }, { 8, 62, 84, 84 } },
	quest = { "TL", { 14, 226, 300, 52 }, { 98, 62, 150, 45 } },
	-- TB = in the Roblox top bar: x like TC, centred on the bar's middle, its height in REAL px (Roblox's buttons do not
	-- follow our UIScale); the sheet's y = on the middle line of Roblox's buttons (34 px)
	war_meter = { "TB", { 496, 13, 288, 42 }, { 255, 15, 240, 38 } },
	chips = { "TC", { 516, 62, 248, 22 }, { 255, 62, 240, 17 } },
	-- A23-63 (2026-10-07): as wide as the chip row on PC and the whole column on phones - Montserrat runs wider and the
	-- king pill ("Pumpkin King is here! 4:54 left") was squeezed to 150 x 16 px with its words spilling out
	event = { "TC", { 516, 88, 248, 22 }, { 255, 81, 240, 18 } },
	notify = { "TC", { 496, 116, 288, 46 }, { 255, 100, 240, 34 } },
	portrait = { "BC", { 362, 586, 50, 50 }, { 502, 62, 45, 45 }, "TR" },
	power_line = { "BC", { 420, 578, 440, 16 }, { 551, 62, 190, 14 }, "TR" },
	hp_bar = { "BC", { 420, 598, 216, 20 }, { 551, 78, 93, 13 }, "TR" },
	mp_bar = { "BC", { 644, 598, 216, 20 }, { 648, 78, 93, 13 }, "TR" },
	xp_bar = { "BC", { 420, 622, 440, 8 }, { 551, 95, 190, 6 }, "TR" },
	tiles = { "BC", { 420, 640, 440, 52 }, { 502, 112, 239, 45 }, "TR" },
	-- A23-40 정정 + 보강: [메뉴] in the top bar's right end (TB anchor; size and position come from TOPBAR, the rects are
	-- the 1280x720 / 749x361 results). out.fold = its fold-out room
	menu = { "TB", { 1224, 12, 44, 44 }, { 692, 12, 45, 45 } },
	combo = { "BC", { 580, 463, 120, 24 }, { 305, 236, 144, 20 } },
	potions = { "BR", { 926, 646, 122, 58 }, { 337, 298, 112, 54 } },
	-- A23-49 three skills Q · Z · X (docs/design/skill_kit_beta_2026-10-06.md §6-1): the X button joins the cluster; Q / Z /
	-- auto move on PCs and the grudge ghost on phones so the four round buttons keep clear of each other
	ghost = { "BR", { 987, 577, 61, 61 }, { 386, 170, 57, 57 } },
	q = { "BR", { 1052, 596, 77, 77 }, { 455, 252, 72, 72 } },
	z = { "BR", { 1100, 518, 77, 77 }, { 497, 180, 72, 72 } },
	x = { "BR", { 1186, 499, 77, 77 }, { 580, 164, 72, 72 } },
	auto = { "BR", { 1219, 440, 51, 51 }, { 665, 215, 48, 48 } },
	attack = { "BR", { 1146, 592, 118, 118 }, { 534, 241, 112, 112 } },
}
HudLayout.Items = ITEMS
HudLayout.Ref = REF

local CENTER = { "war_meter", "chips", "event", "notify" }
-- the Roblox top bar row (real px, UiSandbox PC + phones 2026-10-06): Left = where Roblox's own buttons end when Roblox
-- reports no TopbarInset (164), Button = their height in a 58 px bar (smaller bars: Inset - 4), Bottom = their gap to the
-- bar's bottom (44 px buttons at y 12..56: middle 34 px), Edge = the gap we keep from the bar's free right end, Tap = the
-- touch floor of [메뉴] (= MIN_TAP at the phone's 0.75 UIScale)
local TOPBAR = { Left = 164, Button = 44, Bottom = 2, Edge = 12, Tap = 45 }
HudLayout.Topbar = TOPBAR
local FOLD_MIN = 4 -- the [메뉴] squares that must fit beside it on the bar (새 소식 · 이동 · 도움말 · 설정)
local MIN_CENTER = 240 -- logical units: narrowest centre column (the war meter stays >= 240du)
-- review 2026-10-07 (user: "이거 위치 왜이래?" on a short Studio window): a mouse / keyboard PC always lays out on the
-- desktop sheet, however small the window; short windows get a smaller UIScale instead (Config.UI.DesktopScaleMin 0.5),
-- which keeps the desktop layout's top and bottom blocks apart. The phone sheet is for touch only (replaces SMALL_PC)
local GAP = 8
-- touch targets never shrink below 60 logical units (~45 real px at the phone's 0.75 UIScale). A scaled down button
-- grows back: the portrait from its top-left corner (the bars beside it give way, the tile row under it moves down), the
-- tiles to MIN_TAP squares (fewer fit the row), the quest lines downwards, the round combat buttons around their centre,
-- the potions upwards and then to the left (both cells: the potions rect holds HP and MP side by side, POTION_GAP apart)
local MIN_TAP = 60
local ROUND_TAPS = { "ghost", "q", "z", "x", "auto", "attack" }
local POTION_GAP = 6 -- real px between the HP and MP buttons on both reference sheets (out.potions.Gap, in du)
HudLayout.PotionGap = POTION_GAP
local TILE_GAP = 3 -- real px: the least gap between two tiles of the icon row (out.tiles.Gap, in du)
local STICK = { X = 0.4, Y = 1 / 3 } -- touch thumbstick zone: x < 0.4 W and y > H / 3
-- desktop: the bottom-centre group (face, power line, bars, XP, tiles) and the corner cluster it must stay clear of
local BC_GROUP = { "portrait", "power_line", "hp_bar", "mp_bar", "xp_bar", "tiles" }
local CLUSTER = { "potions", "ghost", "q", "z", "x", "auto", "attack" }
-- touch: the plate beside the portrait (moves right when the portrait grows back to MIN_TAP)
local PLATE = { "power_line", "hp_bar", "mp_bar", "xp_bar" }
-- [메뉴] fold-out: lines of squares as big as [메뉴], filled from [메뉴] to the left. The first line is [메뉴]'s own (in the
-- top bar, never over Roblox's buttons); more lines go down (A23-38's "위쪽에서만": [메뉴] is the topmost thing now).
-- While open it may run over the centre column's info rows (chips / next event / notify), on phones also over the tile
-- row and the face / bars, but never over the war meter, the minimap, the quest lines, a combat button, the jump button
-- or the thumbstick zone
local FOLD_OVER = { tiles = true, menu = true, chips = true, event = true, notify = true, combo = true }
local FOLD_OVER_TOUCH = { portrait = true, power_line = true, hp_bar = true, mp_bar = true, xp_bar = true }
local FOLD_ROWS = 3
local FOLD_GAP = 4 -- real px between two fold-out squares on PCs

local function rect(x, y, w, h)
	return { X = x, Y = y, W = w, H = h }
end

local function anchorOf(id, touch)
	local def = ITEMS[id]
	if not def then return "TL" end
	return touch and def[4] or def[1]
end
HudLayout.AnchorOf = anchorOf

-- env = { W, H = MainGui size in logical units, Scale = UIScale, Inset = top bar inset (real px), Touch = bool,
--         Jump = { X, Y, W, H } of the touch jump button in logical units or nil, Hidden = { [id] = true },
--         Topbar = { X0, Y0, X1, Y1 } = the free part of the Roblox top bar (GuiService.TopbarInset) in logical units
--         (MainGui space) or nil (then TOPBAR.Left .. W, 0 .. Inset) }
-- returns { [id] = { X, Y, W, H } } in logical units (MainGui space, before UIScale). potions also carries Gap (du between
-- its HP and MP cells: cell width = (W - Gap) / 2); tiles carries Size (square tile side), Gap (least gap) and Count (how
-- many tiles fit the row: the HUD shows that many, the rest go into the [메뉴] tile)
function HudLayout.Compute(env)
	local touch = env.Touch == true
	-- sheet = which approved sheet the rects come from (the phone one on touch only); touch = the finger rules
	local sheet = touch
	local ref = sheet and REF.Touch or REF.Desktop
	local k = 1 / ref.Scale -- reference px -> logical units
	local s = (type(env.Scale) == "number" and env.Scale > 0) and env.Scale or 1
	local W, H = env.W, env.H
	local top = (tonumber(env.Inset) or ref.Inset) / s -- logical y of the top bar's bottom edge
	local jump = touch and env.Jump or nil
	local hidden = env.Hidden or {}
	-- the Roblox top bar row (logical units): its free part and the button size there (real px -> du, no UIScale)
	local tb = type(env.Topbar) == "table" and env.Topbar or nil
	local bar = {
		X0 = tb and tonumber(tb.X0) or TOPBAR.Left / s,
		Y0 = tb and tonumber(tb.Y0) or 0,
		X1 = tb and tonumber(tb.X1) or W,
		Y1 = tb and tonumber(tb.Y1) or top,
	}
	if not (bar.X1 > bar.X0 and bar.Y1 > bar.Y0) then bar = { X0 = TOPBAR.Left / s, Y0 = 0, X1 = W, Y1 = top } end
	local barPx = (bar.Y1 - bar.Y0) * s
	local btn = math.min(TOPBAR.Button, math.max(1, barPx - 4)) / s
	-- the middle of Roblox's own buttons (they sit TOPBAR.Bottom px above the bar's bottom): ours share it
	local barMid = bar.Y1 - TOPBAR.Bottom / s - btn / 2
	-- touch: a safe area narrower / shorter than the reference phone (notch insets: 749x361 -> 655x340) scales the
	-- whole layout down by the same factor, so the stick zone and the gaps stay free
	if sheet then
		k *= math.min(1, W / (ref.W / ref.Scale), H / (ref.H / ref.Scale))
	end
	local rj = touch and ref.Jump or nil -- the approved sheet's jump button (real px)
	local out = {}
	for id, def in ITEMS do
		local r = sheet and def[3] or def[2]
		local x, y, w, h = r[1], r[2], r[3] * k, r[4] * k
		local anchor = anchorOf(id, sheet)
		if anchor == "BC" and jump then anchor = "BR" end -- touch: the combo line rides with the cluster (never under Q)
		local X, Y
		if anchor == "TL" then
			X, Y = x * k, top + (y - ref.Inset) * k
		elseif anchor == "TR" then
			X, Y = W - (ref.W - x) * k, top + (y - ref.Inset) * k
		elseif anchor == "TC" then
			X, Y = W / 2 + (x - ref.W / 2) * k, top + (y - ref.Inset) * k
		elseif anchor == "TB" then
			-- in the Roblox top bar: centred on its middle, as tall as on the sheet in real px (never taller than a button)
			h = math.min(r[4], TOPBAR.Button, math.max(1, barPx - 4)) / s
			X, Y = W / 2 + (x - ref.W / 2) * k, barMid - h / 2
		elseif anchor == "BC" then
			X, Y = W / 2 + (x - ref.W / 2) * k, H - (ref.H - y) * k
		elseif jump and rj then
			-- BR on touch: keep the approved gaps to the live jump button's edges (Roblox draws it 70 or 120 px, so its
			-- centre alone would put a big button over it): left of it -> gap to its left edge, over it (자동) -> centred;
			-- wholly above it -> gap to its top, else the offset to its middle
			if x >= rj[1] then
				X = jump.X + jump.W / 2 + (x + r[3] / 2 - rj[1] - rj[3] / 2) * k - w / 2
			else
				X = jump.X - (rj[1] - x) * k
			end
			if y + r[4] <= rj[2] then
				Y = jump.Y - (rj[2] - y) * k
			else
				Y = jump.Y + jump.H / 2 + (y - rj[2] - rj[4] / 2) * k
			end
		else -- BR
			X, Y = W - (ref.W - x) * k, H - (ref.H - y) * k
		end
		out[id] = rect(X, Y, w, h)
	end
	out.potions.Gap = POTION_GAP * k
	local tileGap = TILE_GAP * k

	if touch then
		-- portrait: grows from its top-left corner; the plate beside it gives way (same right edge), the tile row moves down
		local p = out.portrait
		if p.W < MIN_TAP then
			local g = MIN_TAP - p.W
			p.W, p.H = MIN_TAP, MIN_TAP
			for _, id in PLATE do
				local r = out[id]
				r.X, r.W = r.X + g, math.max(1, r.W - g)
			end
			out.tiles.Y += g
		end
		-- quest lines: one MIN_TAP target (two text lines), grown downward
		if out.quest.H < MIN_TAP then out.quest.H = MIN_TAP end
		for _, id in ROUND_TAPS do
			local r = out[id]
			if r.W < MIN_TAP then
				r.X, r.Y, r.W, r.H = r.X + r.W / 2 - MIN_TAP / 2, r.Y + r.H / 2 - MIN_TAP / 2, MIN_TAP, MIN_TAP
			end
		end
		-- potions: two cells side by side (HP, MP), each >= MIN_TAP. The rect grows upwards, then to the left with the
		-- same right edge (Q sits right of it), but never into the thumbstick zone or onto an item level with it on the
		-- left; a phone without that room keeps the widest cells it can get (the offline test names it as an exception)
		local pot = out.potions
		if pot.H < MIN_TAP then pot.Y, pot.H = pot.Y + pot.H - MIN_TAP, MIN_TAP end
		local potRight = pot.X + pot.W
		local minX = potRight - (2 * MIN_TAP + pot.Gap)
		if pot.Y + pot.H > H * STICK.Y then minX = math.max(minX, W * STICK.X) end
		for oid, o in out do
			if oid ~= "potions" and not hidden[oid] and o.X + o.W <= pot.X + 0.01 and o.Y < pot.Y + pot.H and o.Y + o.H > pot.Y then
				minX = math.max(minX, o.X + o.W + GAP)
			end
		end
		if minX < pot.X then pot.X, pot.W = minX, potRight - minX end
	end

	-- A23-71 (user 2026-10-07 "스킬도 처음에는 없어야 돼"): before Lv5 the skill buttons are not on screen. While Q is
	-- hidden the potions close up to the attack button (the hole Q leaves read as a missing button); Z / X leave their
	-- room above the attack button empty
	if hidden.q then
		local pot, atk = out.potions, out.attack
		local want = atk.X - GAP - pot.W
		if want > pot.X then pot.X = want end
	end

	-- tile row: square tiles as tall as the row (>= MIN_TAP on touch), Count = how many fit with the least gap
	local tiles = out.tiles
	local size = touch and math.max(tiles.H, MIN_TAP) or tiles.H
	tiles.H = size
	tiles.Size = size
	tiles.Gap = tileGap
	tiles.Count = math.max(1, math.floor((tiles.W + tileGap) / (size + tileGap) + 1e-6))
	-- [메뉴]: a Roblox-button-sized square in the top bar, TOPBAR.Edge px from its free right end, centred on the bar's
	-- middle like Roblox's own buttons (A23-40 보강); on touch never under TOPBAR.Tap real px (= MIN_TAP at the phone's
	-- 0.75 UIScale; on tablets MIN_TAP du would no longer fit the 58 px bar)
	local menu = out.menu
	local mSize = touch and math.max(btn, TOPBAR.Tap / s) or btn
	menu.W, menu.H = mSize, mSize
	menu.X = bar.X1 - TOPBAR.Edge / s - mSize
	menu.Y = barMid - mSize / 2
	-- touch (review 2026-10-07, game dev 1: a tap on [메뉴] in the bar never reached it, B opened it): Roblox's top bar
	-- row takes every touch inside it, so on touch devices [메뉴] is the last square of the tile row under the bar
	-- (phones: the plate's row top-right) and the row's own tiles step left of it; mouse / keyboard keep it in the bar
	if touch then
		mSize = size
		menu.W, menu.H = mSize, mSize
		menu.X = tiles.X + tiles.W - mSize
		menu.Y = tiles.Y
		tiles.W = math.max(0, tiles.W - mSize - tileGap)
		tiles.Count = math.max(1, math.floor((tiles.W + tileGap) / (size + tileGap) + 1e-6))
	end

	-- phone sheet: a round button that reaches up into the plate's tile row steps down under it (short / narrow phones: the
	-- plate hangs from the top, the cluster from the jump button, so the X skill can meet the row; A23-49)
	if sheet then
		local rowBottom = tiles.Y + tiles.H + GAP / 2
		for _, id in ROUND_TAPS do
			local r = out[id]
			if r.X < tiles.X + tiles.W and r.X + r.W > tiles.X and r.Y < rowBottom then r.Y = rowBottom end
		end
	end

	-- desktop: the bottom-centre group moves left (keeping its shape) when the corner cluster reaches it, but never past
	-- the left margin; if that is still not enough it is squeezed from its left edge (narrow 4:3 / 5:4 windows)
	if not sheet then
		local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
		for _, id in BC_GROUP do
			local r = out[id]
			minX, maxX = math.min(minX, r.X), math.max(maxX, r.X + r.W)
			minY, maxY = math.min(minY, r.Y), math.max(maxY, r.Y + r.H)
		end
		local clusterLeft = math.huge
		for _, id in CLUSTER do
			local r = out[id]
			if not hidden[id] and r.Y < maxY and r.Y + r.H > minY then clusterLeft = math.min(clusterLeft, r.X) end
		end
		local limit = clusterLeft - GAP
		if maxX > limit then
			local shift = math.min(maxX - limit, math.max(0, minX - GAP))
			for _, id in BC_GROUP do out[id].X -= shift end
			minX, maxX = minX - shift, maxX - shift
			if maxX > limit and maxX - minX > 1 then
				local f = math.max(0.5, (limit - minX) / (maxX - minX))
				for _, id in BC_GROUP do
					local r = out[id]
					r.X = minX + (r.X - minX) * f
					if id ~= "portrait" then r.W *= f end
				end
				tiles.Count = math.max(1, math.floor((tiles.W + tileGap) / (size + tileGap) + 1e-6))
			end
		end
	end

	-- centre column (war meter, chips, next event, notify): the rows share one room (the tightest gap between the left
	-- and right items level with any of them) and one centre x, so the column stays straight and never runs under a
	-- neighbour on narrow phones / small windows
	-- In the top bar row the left neighbour is Roblox's own buttons and the right one [메뉴] with room for FOLD_MIN fold
	-- squares beside it (the war meter never takes the fold's first line)
	local leftEdge, rightEdge = 0, W
	local fGapRow = sheet and tileGap or FOLD_GAP * k
	for _, id in CENTER do
		local c = out[id]
		for oid, o in out do
			local anchor = anchorOf(oid, sheet)
			if not hidden[oid] and anchor ~= "TC" and anchor ~= "BC" and oid ~= "combo" and oid ~= "war_meter"
				and o.Y < c.Y + c.H and o.Y + o.H > c.Y then
				if o.X + o.W / 2 < W / 2 then
					leftEdge = math.max(leftEdge, o.X + o.W + GAP)
				elseif oid == "menu" then
					rightEdge = math.min(rightEdge, o.X - FOLD_MIN * (o.W + fGapRow) - GAP)
				else
					rightEdge = math.min(rightEdge, o.X - GAP)
				end
			end
		end
		if c.Y < bar.Y1 and c.Y + c.H > bar.Y0 then leftEdge = math.max(leftEdge, bar.X0 + GAP) end
	end
	local room, widest = rightEdge - leftEdge, 0
	for _, id in CENTER do
		local r = out[id]
		local w = math.max(math.min(r.W, room), math.min(MIN_CENTER, r.W))
		r.W = w
		widest = math.max(widest, w)
	end
	local cx = math.clamp(W / 2, leftEdge + widest / 2, math.max(leftEdge + widest / 2, rightEdge - widest / 2))
	for _, id in CENTER do
		local r = out[id]
		r.X = cx - r.W / 2
	end

	-- everything stays on screen and below the top bar (big tablets / very short windows); the top bar items stay in it
	for id, r in out do
		r.X = math.clamp(r.X, 0, math.max(0, W - r.W))
		if anchorOf(id, sheet) == "TB" and not (touch and id == "menu") then
			r.Y = math.clamp(r.Y, bar.Y0, math.max(bar.Y0, bar.Y1 - r.H))
		else
			r.Y = math.clamp(r.Y, top, math.max(top, H - r.H))
		end
	end

	-- [메뉴] fold-out room: Lines = { { X, Y, Cols } } right-aligned one gap left of [메뉴]; each line reaches left to the
	-- nearest item it may not cover (an item level with it that reaches under [메뉴] leaves no room: the line closes). X / Y / W / H = the box
	-- around all lines, Cols = the first line's squares, Rows = #Lines
	local m = out.menu
	local fGap = sheet and tileGap or FOLD_GAP * k -- phone sheet: the tile row's gap (the first line lies on that row)
	local fSize = m.H
	local right = m.X - fGap
	local blockers = {}
	for oid, o in out do
		if not hidden[oid] and not FOLD_OVER[oid] and not (sheet and FOLD_OVER_TOUCH[oid]) then table.insert(blockers, o) end
	end
	table.insert(blockers, rect(0, bar.Y0, bar.X0, bar.Y1 - bar.Y0)) -- Roblox's own top bar buttons
	if touch then
		table.insert(blockers, rect(0, H * STICK.Y, W * STICK.X, H - H * STICK.Y))
		if jump then table.insert(blockers, jump) end
	end
	local function colsAt(y0)
		local left = 0
		for _, o in blockers do
			if o.Y < y0 + fSize and o.Y + o.H > y0 and o.X < m.X - 0.01 then
				left = math.max(left, o.X + o.W + GAP)
			end
		end
		return math.max(0, math.floor((right - left + fGap) / (fSize + fGap) + 1e-6))
	end
	-- the first line on [메뉴]'s own line (mouse: the top bar, the next ones from just under the bar down; touch: the
	-- tile row, the next ones up over the plate and never into the bar - "위쪽에서만", A23-38)
	local lines = {}
	local y, step = m.Y, fSize + fGap
	local x0, y0, y1 = right, math.huge, -math.huge
	local yMin = touch and top or math.min(top, bar.Y0)
	while #lines < FOLD_ROWS and y >= yMin - 0.01 and y + fSize <= H + 0.01 do
		local cols = colsAt(y)
		if cols < 1 then break end
		local lx = right - cols * (fSize + fGap) + fGap
		table.insert(lines, { X = lx, Y = y, Cols = cols })
		x0, y0, y1 = math.min(x0, lx), math.min(y0, y), math.max(y1, y + fSize)
		y = touch and (y - step) or math.max(y + step, top + fGap)
	end
	if #lines == 0 then -- no room at all (a tiny window): one square over [메뉴]'s left neighbour
		lines[1] = { X = right - fSize, Y = m.Y, Cols = 1 }
		x0, y0, y1 = right - fSize, m.Y, m.Y + fSize
	end
	out.fold = { X = x0, Y = y0, W = right - x0, H = y1 - y0, Size = fSize, Gap = fGap, Cols = lines[1].Cols,
		Rows = #lines, Lines = lines }
	return out
end

function HudLayout.Init() end
function HudLayout.Start() end

return HudLayout
]]></ProtectedString>
					<string name="ScriptGuid">{15196CFE-8BB1-4E24-AA68-5FBE93DD3B02}</string>
