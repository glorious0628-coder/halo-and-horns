Config.Combo = { ResetSeconds = 4, Milestones = { { 10, "좋아요! x10" }, { 25, "멋져요! x25" }, { 50, "폭주! x50" }, { 100, "전설! x100" } } }

-- addendum A3-H4 / H5 / M1: client layout rules (UI uses IgnoreGuiInset = true)
Config.UI = {
