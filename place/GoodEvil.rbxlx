				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ProgressionService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f68800000919</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX326AB2B5081D4E458FD0611CE2A2E0FD">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PvPService.luau : PvP rules (CanAttack, rookie / spawn protection), bully detection, KO outcomes
-- (plunder -> grudge sack, honor, bounty), Wanted stars + bounty, revenge marks and the Most Wanted board.
-- Server only. See TECH_SPEC §4.13 and SPEC_ADDENDUM A6 / A10-V3-3.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "PvPService"

-- (the A3-M3 "under attack while auto-attack is ON" hint is sent by CombatService.DamagePlayer only)
local LOOP_INTERVAL = 1
local PRUNE_INTERVAL = 60 -- seconds between prunes of the bait damage log
local LOOP_WARN_INTERVAL = 10

-- review-fix tuning knobs (grouped to keep the chunk's local count low)
local GUARD = {
	DmgLogMax = 64, -- CR-M15: hits kept per attacker/victim pair (oldest dropped first)
	RecentHitSeconds = 3, -- CR-L4: a non-PvP death without damage this recent (reset / fall) keeps the stars
	KoLogKeep = math.max(1, Config.Bully.RepeatKOs - 1), -- CR-M4: KO times kept per killer/victim pair ({ t1, t2 })
}

-- Most Wanted board lines (TECH_SPEC §4.13 board text)
local BOARD_WANTED_TITLE = "현상수배 TOP 3"
local BOARD_HONOR_TITLE = Config.Factions.Halo.Name .. " 명예 TOP 3"
local BOARD_EMPTY = "(아직 없음)"
local BOARD_BULLY = "깡패"
local BOARD_HONOR_WORD = "명예"
local BOARD_ROWS = 3

local PvPService = {}

PvPService.PlayerKO = Util.Signal.new() -- (killer, victim, info)

local S = nil

-- per-player state (Player keys; cleaned on PlayerLeaving)
local stars = {} -- [Player] = number
local lastStarChange = {} -- [Player] = os.clock()
local protectedUntil = {} -- [Player] = os.clock() (0 = not protected)
local spawnedAt = {} -- [Player] = os.clock() of the last CharacterSpawned
-- CR-M15: [attacker][victim] = { { T = os.clock(), A = damage }, ... } within Config.Bully.BaitWindow (bait check)
local dmgLog = {}
local revenge = {} -- [Player] = { Target = Player, Until = os.clock() }

-- CR-M4: pair state (minted KO reward, repeat-KO log, claimed bully bounty) lives in the saved PairCD of the player
-- it belongs to, so a server hop or rejoin cannot reset it (pairReady / logKO below; pruned by PlayerService)

-- anti-farm: the minted bully part of a bounty is paid at most once per victim (any killer) per this window,
-- the time a max-stack bully needs to decay back to clean. Stored in the victim's PairCD as "bully:0".
local BULLY_BOUNTY_COOLDOWN = Config.Bully.DecaySeconds * Config.Bully.MaxStacks

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind)
	if isPlaying(p) then
		Net.Notify(p, text, kind)
	end
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function faction(p)
	return S.FactionService.GetFaction(p)
end

-- only Halo and Horns ever take part in PvP ("Neutral" and "None" never do; addendum A6)
local function isFighter(f)
	return f == "Halo" or f == "Horns"
end

local function kstate(p)
	local kaiju = S.KaijuService
	if kaiju and kaiju.GetState then
		return kaiju.GetState(p) or "None"
	end
	return "None"
end

-- persisted stat: live data table first, mirrored attribute as fallback
local function num(p, key, default)
	local data = S.PlayerService.GetData(p)
	local v = data and data[key]
	if v == nil then
		v = p:GetAttribute(key)
	end
	return tonumber(v) or default
end

local function bullyStacksOf(p)
	return tonumber(S.JusticeService.GetBullyStacks(p)) or 0
end

local function classOf(p)
	local C = S.ClassService
	return (C and C.GetClass and C.GetClass(p)) or "Warrior"
end

-- CR-M4: pair cooldown kept in the holder's saved PairCD ("<kind>:<otherUserId>" = os.time()). PlayerService.PairReady
-- owns it; the inline copy follows the same contract. commit = false only checks. No data -> false (no reward).
local function pairReady(holder, otherUserId, kind, cooldown, commit)
	if not holder then
		return false
	end
	local PS = S.PlayerService
	if PS.PairReady then
		local ok, res = pcall(PS.PairReady, holder, otherUserId, kind, cooldown, commit)
		return ok and res == true
	end
	local d = PS.GetData(holder)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = kind .. ":" .. tostring(otherUserId)
	local t = os.time()
	if t - (tonumber(d.PairCD[k]) or 0) < cooldown then
		return false
	end
	if commit ~= false then
		d.PairCD[k] = t
	end
	return true
end

-- CR-M4: the killer's recent KO times on this victim live in the killer's PairCD as "kolog:<victimUserId>" =
-- { t1, t2 } (os.time, oldest first). Records this KO; true when it is the RepeatKOs-th within RepeatWindow.
local function logKO(killer, victim)
	local B = Config.Bully
	local d = S.PlayerService.GetData(killer)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = "kolog:" .. tostring(victim.UserId)
	local t = os.time()
	local times = {}
	local old = d.PairCD[k]
	if type(old) == "table" then
		for _, v in old do
			local x = tonumber(v)
			if x and t - x <= B.RepeatWindow then
				table.insert(times, x)
			end
		end
		table.sort(times)
	end
	table.insert(times, t)
	local repeated = #times >= B.RepeatKOs
	while #times > GUARD.KoLogKeep do
		table.remove(times, 1)
	end
	d.PairCD[k] = times
	return repeated
end

-- bully stacks that still carry a bounty: 0 while this bully's bounty was already claimed (BULLY_BOUNTY_COOLDOWN,
-- the victim's PairCD "bully:0"). The stacks themselves (size / damage penalty, "깡패" tag) stay with JusticeService.
local function bountyBullyStacks(p)
	local n = bullyStacksOf(p)
	if n <= 0 or not pairReady(p, 0, "bully", BULLY_BOUNTY_COOLDOWN, false) then
		return 0
	end
	return n
end

-- marks this bully's bounty as claimed (by any killer) for BULLY_BOUNTY_COOLDOWN
local function claimBullyBounty(p)
	pairReady(p, 0, "bully", 0)
end

-- CR-L5: weak-victim check power WITHOUT the rebirth bonus (that bonus is gold / XP only)
local function combatPower(p)
	local J = S.JusticeService
	if J and J.GetCombatPower then
		local ok, v = pcall(J.GetCombatPower, p)
		if ok and type(v) == "number" then
			return v
		end
	end
	local level = math.max(1, num(p, "Level", 1))
	local tier = math.clamp(math.floor(num(p, "WeaponTier", 1)), 1, Config.MaxWeaponTier)
	-- review B5: the equipped scroll +N counts. Read the attribute directly: data.WeaponEnhance is the per-tier table.
	return Config.PowerOf(level, tier, 1, tonumber(p:GetAttribute("WeaponEnhance")) or 0)
end

-- addendum A10-V3-3: inside a PvP zone, or combat-tagged (Config.PvP.CombatTagTime) anywhere outside a town
-- (Outskirts, bridges, safe hunting land), so a fight or a sack chase does not end at a zone edge
local function inPvP(p)
	return S.ZoneService.IsPvPZone(p) or (not S.ZoneService.IsTown(p) and S.CombatService.IsInCombat(p))
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

-- CR-M15: remove every hit with T < cutoff from an ascending dmgLog list
local function pruneHits(hits, cutoff)
	while hits[1] ~= nil and hits[1].T < cutoff do
		table.remove(hits, 1)
	end
end

-- CR-M15: total damage `attacker` dealt to `victim` within Config.Bully.BaitWindow
local function recentDamage(attacker, victim, now)
	local byVictim = dmgLog[attacker]
	local hits = byVictim and byVictim[victim]
	if not hits then
		return 0
	end
	local sum = 0
	for _, h in hits do
		if now - h.T <= Config.Bully.BaitWindow then
			sum += h.A
		end
	end
	return sum
end

local function computeBounty(p)
	if not isFighter(faction(p)) then
		return 0
	end
	return Config.Bounty(num(p, "Level", 1), stars[p] or 0, bountyBullyStacks(p))
end

local function refreshStarAttrs(p)
	if not isPlaying(p) then
		return
	end
	setAttr(p, "WantedStars", stars[p] or 0)
	setAttr(p, "Bounty", computeBounty(p))
end

-- the newbie PvP shield is meaningless for Neutral (never in PvP at all; addendum A6)
local function rookieAttr(p)
	return faction(p) ~= "Neutral" and PvPService.IsRookie(p)
end

local function announceIfMostWanted(p, before, after)
	if before < Config.PvP.AnnounceStars and after >= Config.PvP.AnnounceStars then
		Net.NotifyAll(fmt("MostWanted", Util.PlayerDisplayName(p), Util.FormatNumber(computeBounty(p))))
	end
end

local function addStar(killer)
	local before = stars[killer] or 0
	local after = math.min(Config.PvP.MaxStars, before + 1)
	stars[killer] = after
	lastStarChange[killer] = os.clock()
	refreshStarAttrs(killer)
	announceIfMostWanted(killer, before, after)
end

local function destroyForceFields(p)
	local character = p.Character
	if not character then
		return
	end
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
end

local function clearRevenge(p)
	revenge[p] = nil
	if isPlaying(p) then
		setAttr(p, "RevengeTargetId", 0)
		setAttr(p, "RevengeUntil", 0)
	end
end

-- clears p's own revenge mark and every other player's mark that targets p
local function clearRevengeInvolving(p)
	local holders = {}
	for holder, r in revenge do
		if holder == p or r.Target == p then
			table.insert(holders, holder)
		end
	end
	for _, holder in holders do
		clearRevenge(holder)
	end
end

------------------------------------------------------------------ public API
function PvPService.GetStars(player)
	return (player and stars[player]) or 0
end

function PvPService.ResetStars(player)
	if not player then
		return
	end
	stars[player] = 0
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
end

function PvPService.DebugSetStars(player, n)
	if not isPlaying(player) then
		return
	end
	local before = stars[player] or 0
	local after = math.clamp(math.floor(tonumber(n) or 0), 0, Config.PvP.MaxStars)
	stars[player] = after
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
	announceIfMostWanted(player, before, after)
end

-- Rebirths == 0 and (Level < RookieLevel or PlaytimeSeconds < RookiePlaytime)
function PvPService.IsRookie(player)
	if not player then
		return false
	end
	if num(player, "Rebirths", 0) ~= 0 then
		return false
	end
	return num(player, "Level", 1) < Config.PvP.RookieLevel
		or num(player, "PlaytimeSeconds", 0) < Config.PvP.RookiePlaytime
end

function PvPService.HasRevenge(attacker, victim)
	local r = attacker and revenge[attacker]
	return r ~= nil and victim ~= nil and r.Target == victim and os.clock() < r.Until
end

function PvPService.Protect(player, seconds)
	if not isPlaying(player) then
		return
	end
	seconds = tonumber(seconds) or 0
	if seconds <= 0 then
		return
	end
	local character = player.Character
	if character and character.Parent and not character:FindFirstChildOfClass("ForceField") then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = character
	end
	protectedUntil[player] = math.max(protectedUntil[player] or 0, os.clock() + seconds)
	setAttr(player, "Protected", true)
end

function PvPService.BreakProtection(player)
	if not player then
		return
	end
	-- cheap early-out: CombatService calls this after every PvP hit
	if (protectedUntil[player] or 0) == 0 and player:GetAttribute("Protected") ~= true then
		return
	end
	protectedUntil[player] = 0
	destroyForceFields(player)
	if isPlaying(player) then
		setAttr(player, "Protected", false)
	end
end

-- (allowed: boolean, reasonKey: string?)
function PvPService.CanAttack(attacker, victim)
	if attacker == nil or victim == nil or attacker == victim then
		return false, "Self"
	end
	local PS = S.PlayerService
	if not PS.IsReady(attacker) or not PS.IsReady(victim) then
		return false, "NotReady"
	end
	if not Util.IsAlive(attacker) or not Util.IsAlive(victim) then
		return false, "Dead"
	end
	local fa, fv = faction(attacker), faction(victim)
	if fa == "Neutral" or fv == "Neutral" then
		return false, "Neutral" -- addendum A6: Neutral never hits / is hit by players, anywhere
	end
	if not isFighter(fa) or not isFighter(fv) or fa == fv then
		return false, "SameFaction"
	end
	-- kaiju exception: Halo may hit the Active kaiju in any zone (rookies allowed, protection ignored)
	if fa == "Halo" and kstate(victim) == "Active" then
		return true, nil
	end
	if not inPvP(attacker) or not inPvP(victim) then
		return false, "SafeZone"
	end
	if PvPService.IsRookie(attacker) or PvPService.IsRookie(victim) then
		return false, "Rookie"
	end
	if victim:GetAttribute("Protected") == true then
		return false, "Protected"
	end
	return true, nil
end

-- called ONLY by CombatService's death pipeline (no kill credit: monster, fall, reset)
function PvPService.HandleNonPvPDeath(victim)
	if not victim then
		return
	end
	if (stars[victim] or 0) >= 1 then
		-- CR-L4: a death in town or without damage in the last few seconds (reset, fall) keeps the stars and bounty:
		-- carried gold is 0 in town, so a reset there would otherwise wipe them for free
		local lastHit = tonumber(S.CombatService.GetLastDamagedAt(victim)) or 0
		if S.ZoneService.IsTown(victim) == true or os.clock() - lastHit > GUARD.RecentHitSeconds then
			return
		end
		local carried = num(victim, "CarriedGold", 0)
		local loss = math.floor(carried * Config.PvP.VillainLossOnWantedPvEDeath)
		if loss > 0 then
			S.ProgressionService.TakeCarriedGold(victim, loss)
		end
	end
	PvPService.ResetStars(victim)
end

-- called ONLY by CombatService's death pipeline (after GrudgeService.OnCarrierDown)
function PvPService.HandleKO(victim, killer)
	if not victim then
		return
	end
	if killer == nil or killer == victim or not isPlaying(killer) then
		PvPService.HandleNonPvPDeath(victim)
		return
	end
	local fk, fv = faction(killer), faction(victim)
	if not isFighter(fk) or not isFighter(fv) or fk == fv then
		-- defensive: Neutral / None / same-faction deaths are never PvP KOs (addendum A6)
		PvPService.HandleNonPvPDeath(victim)
		return
	end

	local P = Config.PvP
	local B = Config.Bully
	local Justice = S.JusticeService
	local Progression = S.ProgressionService
	local now = os.clock()

	-- 1. snapshot + KO log (CR-M4: the log is kept in the killer's save)
	local starsBefore = stars[victim] or 0
	local bullyBefore = bullyStacksOf(victim)
	-- the victim's bully stacks that still pay a bounty (0 once claimed; anti-farm, see BULLY_BOUNTY_COOLDOWN)
	local bountyBully = bountyBullyStacks(victim)
	local repeated = logKO(killer, victim)

	-- 2. bully check (any faction pairing)
	local weak = combatPower(victim) < B.WeakPowerRatio * combatPower(killer) -- CR-L5
	-- CR-M15: bait = the victim dealt >= BaitMinPct of the killer's base MaxHealth to the killer within BaitWindow
	local baitNeed = (B.BaitMinPct or 0.2) * Config.MaxHealth(num(killer, "Level", 1), fk, classOf(killer))
	local baitDealt = recentDamage(victim, killer, now)
	local baited = baitDealt > 0 and baitDealt >= baitNeed
	if weak and baited then
		weak = false -- anti-bait: the victim attacked the killer first
	end
	if weak and B.WantedIgnoresWeakRule and (starsBefore > 0 or bullyBefore > 0) then
		weak = false
	end
	local fresh = spawnedAt[victim] ~= nil and now - spawnedAt[victim] < B.FreshSpawnSeconds
	local bully = weak or fresh or repeated
	-- CR-M14: a fresh / repeat KO of a victim who baited the killer is self-defense (no bully stack, no rewards),
	-- and a kaiju never becomes a bully (that would double its kaiju pool)
	local defense = baited and (fresh or repeated)
	if defense or kstate(killer) ~= "None" then
		bully = false
	end

	-- 3. revenge (always)
	revenge[victim] = { Target = killer, Until = now + Config.Revenge.Duration }
	setAttr(victim, "RevengeTargetId", killer.UserId)
	setAttr(victim, "RevengeUntil", Util.Now() + Config.Revenge.Duration)
	notify(victim, fmt("Revenge", Util.PlayerDisplayName(killer)), "info")
	local killerRevenge = revenge[killer]
	if killerRevenge and killerRevenge.Target == victim then
		local wasActive = now < killerRevenge.Until
		clearRevenge(killer)
		if wasActive then
			notify(killer, fmt("RevengeDone"), "good")
		end
	end

	local info
	if defense then
		-- CR-M14: self-defense KO: no bully stack, stars, plunder, honor/infamy, bounty or war points
		info = { Kind = "Defense", Bully = false, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	elseif bully then
		-- 4. bully KO: no plunder, stars, honor/infamy, bounty or war points
		local n = math.floor(tonumber(Justice.AddBullyStack(killer)) or 0)
		notify(killer, fmt("BullyKO", n), "bad")
		notify(victim, fmt("BullyVictim"), "info")
		refreshStarAttrs(killer) -- bounty doubles while a bully
		info = { Kind = "Bully", Bully = true, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	else
		-- 5. pair cooldown for minted rewards (CR-M4: kept in the killer's save as "ko:<victimUserId>")
		local pairOk = pairReady(killer, victim.UserId, "ko", P.PairRewardCooldown)
		local vLevel = num(victim, "Level", 1)

		if fk == "Horns" then
			-- 6a. Horns KO Halo: plunder into the grudge sack
			if pairOk then
				addStar(killer) -- CR-M3: a farmed pair (inside the cooldown) adds no star
			end
			local stolen = 0
			if not S.GrudgeService.CanSteal(killer, victim) then
				notify(killer, fmt("PlunderTooSoon"), "info")
			else
				local carried = num(victim, "CarriedGold", 0)
				local safeFloor = P.SafeFloorPerLevel * vLevel
				stolen = math.min(math.floor(math.max(0, carried - safeFloor) * P.PlunderRate), P.PlunderCapPerLevel * vLevel)
				if stolen > 0 then
					stolen = math.floor(tonumber(Progression.TakeCarriedGold(victim, stolen)) or 0)
				end
				if stolen > 0 then
					S.GrudgeService.AddToSack(killer, victim, stolen, pairOk and 1 or 0)
					local from, to = rootPos(victim), rootPos(killer)
					if from and to then
						Net.Fx(nil, "Plunder", { From = from, To = to, Amount = stolen })
					end
					notify(victim, fmt("Plundered", Util.PlayerDisplayName(killer), Util.FormatNumber(stolen)), "bad")
					notify(killer, fmt("PlunderGain", Util.FormatNumber(stolen), stars[killer] or 0), "reward")
				end
			end
			if stolen == 0 and pairOk then
				S.PlayerService.AddStat(killer, "Infamy", 1) -- no sack to carry it
			end
			local bullyBounty = 0
			if bountyBully > 0 and pairOk then
				bullyBounty = Config.Bounty(vLevel, 0, bountyBully)
				if bullyBounty > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
					Progression.AddBankGold(killer, bullyBounty, "Bounty")
					notify(killer, fmt("BullyBountyGain", Util.FormatNumber(bullyBounty)), "reward")
				end
			end
			info = {
				Kind = "Plunder", Bully = false, VictimStars = starsBefore,
				Stolen = stolen, Bounty = bullyBounty, Rewarded = pairOk,
			}
		elseif starsBefore == 0 and bountyBully == 0 then
			-- 6b. Halo KO a clean Horns (or a bully whose bounty was already claimed): honor
			if pairOk then
				S.PlayerService.AddStat(killer, "Honor", P.HonorPerKOMin)
				notify(killer, fmt("HonorGain", P.HonorPerKOMin), "reward")
			end
			info = { Kind = "Honor", Bully = false, VictimStars = 0, Stolen = 0, Bounty = 0, Rewarded = pairOk }
		else
			-- 6c. Halo KO a Wanted (or bully) Horns: bounty
			local bounty = pairOk and Config.Bounty(vLevel, starsBefore, bountyBully) or 0
			if bounty > 0 then
				if bountyBully > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
				end
				Progression.AddBankGold(killer, bounty, "Bounty")
			end
			local honor = pairOk and math.max(1, starsBefore) or 0
			if honor > 0 then
				S.PlayerService.AddStat(killer, "Honor", honor)
			end
			if starsBefore > 0 then
				local carried = num(victim, "CarriedGold", 0)
				local loss = math.floor(carried * P.VillainLossOnBountyKO)
				if loss > 0 then
					Progression.TakeCarriedGold(victim, loss)
				end
			end
			if bounty > 0 or honor > 0 then
				notify(killer, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
			end
			if starsBefore >= P.GlowStars and bounty > 0 then
				Net.NotifyAll(fmt("BountyAnnounce", Util.PlayerDisplayName(killer), Util.FormatNumber(bounty)))
			end
			info = {
				Kind = "Bounty", Bully = false, VictimStars = starsBefore,
				Stolen = 0, Bounty = bounty, Rewarded = pairOk,
			}
		end
	end

	-- 7. victim's stars are gone; tell everyone
	PvPService.ResetStars(victim)
	PvPService.PlayerKO:Fire(killer, victim, info)
end

------------------------------------------------------------------ board
local function updateBoard()
	local ok, label = pcall(function()
		return S.MapBuilder.GetBoardLabel()
	end)
	if not ok or not label then
		return
	end

	local wanted, heroes = {}, {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		local bounty = tonumber(p:GetAttribute("Bounty")) or 0
		if bounty > 0 then
			table.insert(wanted, { Name = Util.PlayerDisplayName(p), Bounty = bounty, Stars = stars[p] or 0, Bully = bullyStacksOf(p) })
		end
		if faction(p) == "Halo" then
			local honor = num(p, "Honor", 0)
			if honor > 0 then
				table.insert(heroes, { Name = Util.PlayerDisplayName(p), Honor = honor })
			end
		end
	end
	table.sort(wanted, function(a, b)
		if a.Bounty ~= b.Bounty then
			return a.Bounty > b.Bounty
		end
		return a.Name < b.Name
	end)
	table.sort(heroes, function(a, b)
		if a.Honor ~= b.Honor then
			return a.Honor > b.Honor
		end
		return a.Name < b.Name
	end)

	local lines = { BOARD_WANTED_TITLE }
	if #wanted == 0 then
		table.insert(lines, BOARD_EMPTY)
	else
		for i = 1, math.min(BOARD_ROWS, #wanted) do
			local w = wanted[i]
			local line = string.format("%d. %s", i, w.Name)
			if w.Stars > 0 then
				line ..= " " .. string.rep("★", w.Stars)
			end
			line ..= " " .. Util.FormatNumber(w.Bounty) .. "G"
			if w.Bully > 0 then
				line ..= " " .. BOARD_BULLY
			end
			table.insert(lines, line)
		end
	end
	table.insert(lines, "")
	table.insert(lines, BOARD_HONOR_TITLE)
	if #heroes == 0 then
		table.insert(lines, BOARD_EMPTY)
	else
		for i = 1, math.min(BOARD_ROWS, #heroes) do
			local h = heroes[i]
			table.insert(lines, string.format("%d. %s %s %s", i, h.Name, BOARD_HONOR_WORD, Util.FormatNumber(h.Honor)))
		end
	end

	local text = table.concat(lines, "\n")
	if label.Text ~= text then
		label.Text = text
	end
end

------------------------------------------------------------------ loops
local function tickPlayer(p, now)
	-- protection expiry
	local pu = protectedUntil[p]
	if pu and pu > 0 and now >= pu then
		protectedUntil[p] = 0
		destroyForceFields(p)
		setAttr(p, "Protected", false)
	end

	-- star decay: one star per StarDecaySeconds, paused while queued / siren / active kaiju
	local s = stars[p] or 0
	if s > 0 then
		if kstate(p) ~= "None" then
			lastStarChange[p] = now
		elseif now - (lastStarChange[p] or now) >= Config.PvP.StarDecaySeconds then
			stars[p] = s - 1
			lastStarChange[p] = now
		end
	end
	refreshStarAttrs(p)
	setAttr(p, "Rookie", rookieAttr(p))

	-- revenge expiry
	local r = revenge[p]
	if r and (now >= r.Until or not isPlaying(r.Target)) then
		clearRevenge(p)
	end
end

-- CR-M15: drop bait-log hits older than BaitWindow (pair state itself is in the saves, CR-M4)
local function pruneDmgLog(now)
	local cutoff = now - Config.Bully.BaitWindow
	for attacker, byVictim in dmgLog do
		for victim, hits in byVictim do
			pruneHits(hits, cutoff)
			if #hits == 0 then
				byVictim[victim] = nil
			end
		end
		if next(byVictim) == nil then
			dmgLog[attacker] = nil
		end
	end
end

-- CR-M12: stars saved at leave come back on the next join minus the decay for the time away, capped below the kaiju
-- threshold. Clears the saved fields. Returns (stars, seconds already spent toward the next decay step).
local function takeSavedStars(player, data)
	if type(data) ~= "table" then
		return 0, 0
	end
	local saved = math.floor(tonumber(data.SavedStars) or 0)
	local at = tonumber(data.SavedStarsAt) or 0
	data.SavedStars = 0
	data.SavedStarsAt = 0
	if saved <= 0 or at <= 0 or not isFighter(faction(player)) then
		return 0, 0
	end
	local step = math.max(1, Config.PvP.StarDecaySeconds)
	local away = math.max(0, os.time() - at)
	local decayed = math.floor(away / step)
	local needed = (Config.Kaiju and Config.Kaiju.StarsNeeded) or Config.PvP.MaxStars
	local cap = math.max(0, math.min(Config.PvP.MaxStars, needed - 1))
	local n = math.clamp(saved - decayed, 0, cap)
	return n, away - decayed * step
end

-- CR-M11: a Wanted Horns logging out while combat-tagged pays the bounty (+ honor, like a bounty KO) to the last Halo
-- attacker, once per pair per PairRewardCooldown. Returns true when paid (the stars count as claimed).
local function payLeaveBounty(player)
	-- CR-M11 / CR-M2: a server shutdown is not the player's choice; keep the stars (saved by CR-M12) instead
	local PS = S.PlayerService
	if PS and type(PS.IsShuttingDown) == "function" then
		local okS, closing = pcall(PS.IsShuttingDown)
		if okS and closing == true then
			return false
		end
	end
	local s = stars[player] or 0
	if s < 1 or faction(player) ~= "Horns" or kstate(player) == "Active" then
		return false -- an Active kaiju's logout is resolved by KaijuService
	end
	local C = S.CombatService
	if not C.IsInCombat(player) then
		return false
	end
	local a = C.GetLastPvPAttacker(player)
	if a == nil or a == player or not isPlaying(a) or not S.PlayerService.IsReady(a) or faction(a) ~= "Halo" then
		return false
	end
	if not pairReady(a, player.UserId, "ko", Config.PvP.PairRewardCooldown) then
		return false
	end
	local bully = bountyBullyStacks(player) -- 0 when this bully's bounty was already claimed
	local bounty = Config.Bounty(num(player, "Level", 1), s, bully)
	local honor = math.max(1, s)
	if bounty > 0 then
		if bully > 0 then
			claimBullyBounty(player)
		end
		S.ProgressionService.AddBankGold(a, bounty, "Bounty")
	end
	S.PlayerService.AddStat(a, "Honor", honor)
	notify(a, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
	if s >= Config.PvP.GlowStars and bounty > 0 then
		Net.NotifyAll(fmt("BountyAnnounce", Util.PlayerDisplayName(a), Util.FormatNumber(bounty)))
	end
	return true
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player, data)
	-- CR-M12: bring back the stars saved at the last leave (decayed); failures just start clean
	local okSaved, restored, partial = pcall(takeSavedStars, player, data or S.PlayerService.GetData(player))
	if not okSaved then
		Util.Warn(TAG, "saved stars restore failed: " .. tostring(restored))
		restored, partial = 0, 0
	end
	stars[player] = restored
	lastStarChange[player] = os.clock() - (restored > 0 and partial or 0)
	protectedUntil[player] = 0
	player:SetAttribute("WantedStars", 0)
	player:SetAttribute("Bounty", 0)
	player:SetAttribute("Rookie", rookieAttr(player))
	player:SetAttribute("Protected", false)
	player:SetAttribute("RevengeTargetId", 0)
	player:SetAttribute("RevengeUntil", 0)
	if restored > 0 then
		refreshStarAttrs(player)
	end
end

local function cleanupPlayer(player)
	clearRevengeInvolving(player)
	stars[player] = nil
	lastStarChange[player] = nil
	protectedUntil[player] = nil
	spawnedAt[player] = nil
	revenge[player] = nil
	dmgLog[player] = nil
	for _, byVictim in dmgLog do
		byVictim[player] = nil
	end
end

local function onPlayerLeaving(player, data)
	-- CR-M11: runs before KaijuService's handler (init order) and while JusticeService still reports the bully
	-- stacks (CR-L1 defers their cleanup)
	local okPay, paid = pcall(payLeaveBounty, player)
	if not okPay then
		Util.Warn(TAG, "leave bounty failed: " .. tostring(paid))
		paid = false
	end
	-- CR-M12: save the unclaimed stars so a rejoin cannot wipe them; a paid leave bounty or an Active kaiju
	-- (KaijuService resolves it) leaves none
	local d = data or S.PlayerService.GetData(player)
	if type(d) == "table" then
		local keep = (paid == true or kstate(player) == "Active") and 0 or (stars[player] or 0)
		-- CR-M12: like SavedBullyAt, back-date by the time already spent toward the next decay step this session
		-- (a queued / siren kaiju refreshes lastStarChange every tick, so into ~ 0 there)
		local step = math.max(1, Config.PvP.StarDecaySeconds)
		local now = os.clock()
		local into = math.clamp(math.floor(now - (lastStarChange[player] or now)), 0, step - 1)
		d.SavedStars = keep
		d.SavedStarsAt = keep > 0 and (os.time() - into) or 0
	end
	-- other services' PlayerLeaving handlers (e.g. KaijuService) may still call ResetStars; clean up after them
	clearRevengeInvolving(player)
	task.defer(cleanupPlayer, player)
end

local function onCharacterSpawned(player, _character, _humanoid, cosmetic)
	if cosmetic then return end -- replacing an appearance never renews spawn protection / the spawn clock
	spawnedAt[player] = os.clock()
	PvPService.Protect(player, Config.PvP.SpawnProtection)
end

-- CR-M15: log each PvP hit with its damage (the applied amount once CR-M10 lands) for the bait check
local function onPlayerDamaged(victim, amount, attacker)
	if victim == nil or attacker == nil then
		return
	end
	amount = tonumber(amount) or 0
	if amount ~= amount or amount <= 0 then
		return
	end
	local now = os.clock()
	local byVictim = dmgLog[attacker]
	if not byVictim then
		byVictim = {}
		dmgLog[attacker] = byVictim
	end
	local hits = byVictim[victim]
	if not hits then
		hits = {}
		byVictim[victim] = hits
	end
	pruneHits(hits, now - Config.Bully.BaitWindow)
	table.insert(hits, { T = now, A = amount })
	while #hits > GUARD.DmgLogMax do
		table.remove(hits, 1)
	end
end

local function onFactionChanged(player)
	PvPService.ResetStars(player)
	-- revenge marks never cross a faction change (and Neutral never gives/gets revenge; A6)
	clearRevengeInvolving(player)
	if isPlaying(player) then
		setAttr(player, "Rookie", rookieAttr(player))
	end
end

------------------------------------------------------------------ lifecycle
function PvPService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	S.CombatService.PlayerDamaged:Connect(onPlayerDamaged)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
end

function PvPService.Start()
	local okBoard, errBoard = pcall(updateBoard)
	if not okBoard then
		Util.Warn(TAG, "board update failed: " .. tostring(errBoard))
	end

	task.spawn(function()
		local boardAcc = 0
		local pruneAcc = 0
		while true do
			task.wait(LOOP_INTERVAL)
			local now = os.clock()
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tickPlayer, p, now)
				if not ok then
					warnLoop(err)
				end
			end

			boardAcc += LOOP_INTERVAL
			if boardAcc >= Config.PvP.BoardRefresh then
				boardAcc = 0
				local ok, err = pcall(updateBoard)
				if not ok then
					warnLoop(err)
				end
			end

			pruneAcc += LOOP_INTERVAL
			if pruneAcc >= PRUNE_INTERVAL then
				pruneAcc = 0
				local ok, err = pcall(pruneDmgLog, now)
				if not ok then
					warnLoop(err)
				end
			end
		end
	end)

	print("[PvPService] started")
end

return PvPService
]]></ProtectedString>
				<string name="ScriptGuid">{4B24514A-A4D2-4BAF-BEB8-82F8F77CFBE7}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PvPService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f6880000091b</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX9FAF922802C145D5B9556875C8D91594">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- QuestService.luau : 3 quest slots (KST dailies first, then rolling extras), claim, daily chest, reroll,
-- vacation bonus and quest-list publishing to the owner only via the "Quests" remote (TECH_SPEC §4.20, CR-L50),
-- plus persistent first-hunt guidance (2026-10-04: no personal monster in a safe town)
-- and the faction-filtered quest pool (A6 Neutral).
-- data.Quests is mutated directly (documented exception); every other persisted stat goes through SetStat/AddStat.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "QuestService"

local M = {}

local S = nil

local PUBLISH_INTERVAL = 0.5
local TUTORIAL_TICK = 1
local WARN_THROTTLE = 10
local PROGRESS_EPS = 1e-6 -- Kill/Golden progress is fractional (killWeight)

------------------------------------------------------------------ tutorial constants (A4) — all from Config.Tutorial
local TUT_CFG = Config.Tutorial
local TUT_ID = TUT_CFG.QuestId -- claim id (N1) and quest-list Id of the pinned tutorial entry
local TUT_KIND = "Tutorial"
local STEP_WELCOME = TUT_CFG.Steps.Kill -- 0: faction guide dialogue; only explicit acceptance advances
local STEP_GUIDE = TUT_CFG.Steps.Guide -- 1: HUD guide beam to GuideZone
local STEP_QUEST = TUT_CFG.Steps.Quest -- 2: pinned tutorial quest
local TUT_DONE = TUT_CFG.Steps.Done -- 99
local TUT_TARGET = TUT_CFG.QuestKills
local TUT_GOLD = TUT_CFG.QuestRewardGold
local TUT_XP = TUT_CFG.QuestRewardXP or 0
local TUT_TEXT = string.format(TUT_CFG.QuestText, TUT_TARGET)
local TUT_ZONE = TUT_CFG.GuideZone
local TUT_MESSAGES = TUT_CFG.Text or {}
local TUT_START_TEXT = TUT_MESSAGES.QuestStart or "첫 임무: %s! (보상 %s골드)" -- (TUT_TEXT, gold)
local TUT_READY_TEXT = TUT_MESSAGES.QuestReady or "첫 임무 완료! [받기]를 눌러요."
local TUT_CLAIMED_TEXT = TUT_MESSAGES.Claimed or "첫 임무 보상 +%s골드! 다음 목표를 확인해요."
local RESUME_DELAY_ON_SPAWN = 1
local RESUME_DELAY_ON_CLASS = 0.5

-- kills that count for the tutorial quest: monsters living in Slime Meadow
local TUTORIAL_KINDS = {}
for id, def in Config.MonsterTypes do
	if type(def) == "table" and def.Zone == TUT_ZONE then
		TUTORIAL_KINDS[id] = true
	end
end

------------------------------------------------------------------ templates
local TEMPLATE_BY_ID = {}
for _, t in Config.Quests.Templates do
	TEMPLATE_BY_ID[t.Id] = t
end

-- A6: quests that need a Halo/Horns side (PvP, plunder, bounty, goose tug, kaiju). Neutral and "None" never get them.
local SIDE_ONLY_IDS = { Hunt = true, Plunder = true, Goose = true, Bounty = true, Kaiju = true }

-- A23-14: short, different Lv1-9 dailies and their smaller rewards (nil table = old behaviour everywhere)
local NEWBIE = Config.Quests.Newbie

------------------------------------------------------------------ state (session only)
local dirty = {} -- [Player] = true -> quest list republished by the publish loop
local lastSent = {} -- [Player] = last JSON fired on the "Quests" remote (CR-L50: fire only on change)
local rerollReadyAt = {} -- [Player] = server time
local lastLoopWarn = {} -- [loopName] = os.clock()
local welcomeShown = {} -- [Player] = true after this session's first automatic guide dialogue

------------------------------------------------------------------ helpers
local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default or 0
end

local function loopWarn(loopName, err)
	local now = os.clock()
	local last = lastLoopWarn[loopName]
	if last and now - last < WARN_THROTTLE then return end
	lastLoopWarn[loopName] = now
	Util.Warn(TAG, loopName .. ": " .. tostring(err))
end

local function connectSignal(serviceName, signalName, fn)
	local service = S and S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

local function getData(player)
	if S == nil or player == nil then return nil end
	if not S.PlayerService.IsReady(player) then return nil end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return nil end
	return data
end

local function getFaction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then return "None" end
	return f
end

local function getLevel(data)
	return math.max(1, math.floor(num(data and data.Level, 1)))
end

-- CR-M6: unclaimed rewards never pay more than the CURRENT level's value (free class change / rebirth to Lv1).
-- After a level-up the stored value is the smaller one, so it is paid unchanged.
local function capTo(g, x, capG, capX)
	return math.min(g, math.floor(num(capG))), math.min(x, math.floor(num(capX)))
end

local function isSlotIndex(v)
	return type(v) == "number" and v == v and v % 1 == 0 and v >= 1 and v <= Config.Quests.Slots
end

local function isValidQuest(q)
	return type(q) == "table"
		and type(q.Id) == "string" and TEMPLATE_BY_ID[q.Id] ~= nil
		and (q.Kind == "Daily" or q.Kind == "Extra")
		and type(q.Target) == "number" and q.Target == q.Target and q.Target > 0
		and type(q.Progress) == "number" and q.Progress == q.Progress
		and type(q.RewardGold) == "number" and type(q.RewardXP) == "number"
		and type(q.Text) == "string"
end

local function isComplete(q)
	return q.Progress >= q.Target
end

local function othersExcept(quests, index)
	local out = {}
	for i, q in quests do
		if i ~= index and type(q) == "table" then
			table.insert(out, q)
		end
	end
	return out
end

local function isSide(faction)
	return faction == "Halo" or faction == "Horns"
end

-- A23-14: Lv1..Newbie.MaxLevel get the short newbie dailies and the smaller newbie chest
local function isNewbieLevel(level)
	return type(NEWBIE) == "table" and type(NEWBIE.Dailies) == "table" and #NEWBIE.Dailies > 0
		and level <= num(NEWBIE.MaxLevel, 0)
end

-- full-set chest at one level; Lv1-9 pays Newbie.ChestMinutes of hunting instead of Daily's
local function chestAt(level)
	if isNewbieLevel(level) then
		return Config.HuntValue(level, num(NEWBIE.ChestMinutes, Config.Daily.ChestMinutes))
	end
	return Config.DailyChestReward(level)
end

-- the chest pays the SMALLER of the current level's chest and the chest of the level the day's dailies were generated
-- at (genLevel, saved as data.DailyLevel; 0 = unknown -> current only). A Lv9 player who levels to 10 before the last
-- claim therefore gets the newbie chest (144/240), not the Lv10 one (1920/3360); a reborn player never gets more either.
local function chestReward(level, genLevel)
	local g, x = chestAt(level)
	genLevel = math.floor(num(genLevel))
	if genLevel >= 1 and genLevel ~= level then
		local gg, gx = chestAt(math.min(genLevel, Config.Levels.MaxLevel))
		g, x = math.min(g, gg), math.min(x, gx)
	end
	return g, x
end

local function templateFitsFaction(t, faction)
	if t.Faction ~= nil and t.Faction ~= faction then return false end
	if not isSide(faction) and (t.PvP or SIDE_ONLY_IDS[t.Id]) then return false end
	return true
end

local function pickWeighted(list)
	local total = 0
	for _, t in list do
		total += math.max(0, num(t.Weight))
	end
	if total <= 0 then
		return list[Util.Random:NextInteger(1, #list)]
	end
	local r = Util.Random:NextNumber() * total
	for _, t in list do
		local w = math.max(0, num(t.Weight))
		if w > 0 then
			if r < w then return t end
			r -= w
		end
	end
	return list[#list]
end

------------------------------------------------------------------ quest generation
-- others = quests in the OTHER slots (used for the PvP limit and the "different template" preference)
local function newQuest(player, kind, others)
	local data = S.PlayerService.GetData(player)
	local level = getLevel(data)
	local faction = getFaction(player)
	-- A23-14: Lv1-9 dailies come from Config.Quests.Newbie.Dailies (rows reuse a template Id); everything else as before
	local newbie = kind == "Daily" and isNewbieLevel(level)

	local otherIds, otherPvP = {}, 0
	for _, q in others or {} do
		if type(q) == "table" and type(q.Id) == "string" then
			otherIds[q.Id] = true
			local ot = TEMPLATE_BY_ID[q.Id]
			if ot and ot.PvP then otherPvP += 1 end
		end
	end

	local pvpAllowed = level >= Config.Quests.PvPMinLevel
		and otherPvP < (Config.Quests.MaxPvPQuests or 1)
		and not S.PvPService.IsRookie(player)

	-- rows = templates, or A23-14 newbie rows ({ Id = template Id, Targets, Monster?, Strict? })
	local candidates, preferred = {}, {}
	for _, row in (if newbie then NEWBIE.Dailies else Config.Quests.Templates) do
		local rt = type(row) == "table" and TEMPLATE_BY_ID[row.Id]
		if rt and templateFitsFaction(rt, faction) and (not rt.PvP or pvpAllowed) then
			table.insert(candidates, row)
			if not otherIds[row.Id] then
				table.insert(preferred, row)
			end
		end
	end
	local pool = (#preferred > 0) and preferred or candidates
	local row
	if #pool > 0 then
		row = pickWeighted(pool)
	else
		newbie = false -- nothing fits: the old Kill daily (sizes and reward) is the safe fallback
		row = TEMPLATE_BY_ID.Kill or Config.Quests.Templates[1]
	end
	local t = TEMPLATE_BY_ID[row.Id] or row

	local unitsList
	if newbie then
		unitsList = row.Targets
	else
		unitsList = (kind == "Daily" and t.DailyUnits) or t.Units
	end
	if type(unitsList) ~= "table" or #unitsList == 0 then unitsList = { 1 } end
	local units = num(unitsList[Util.Random:NextInteger(1, #unitsList)], 1)

	local mainId = Config.ZoneMainMonster[Config.QuestZoneForLevel(level)]
	local main = Config.MonsterTypes[mainId]
	-- the monster a Kill/Golden quest counts: the zone's unit monster, or the newbie row's Monster (e.g. BigSlime)
	local unitId = mainId
	if newbie and type(row.Monster) == "string" and type(Config.MonsterTypes[row.Monster]) == "table" then
		unitId = row.Monster
	end
	local unitDef = Config.MonsterTypes[unitId]
	local target = units -- newbie Targets are exact (a Gold row already says gold)
	if t.Id == "Gold" and not newbie then
		target = units * main.Gold
	end
	target = math.max(1, math.floor(target))

	local rewardGold, rewardXP
	if kind == "Daily" then
		if newbie then
			rewardGold, rewardXP = Config.HuntValue(level, num(NEWBIE.RewardMinutes, Config.Daily.QuestMinutes))
		else
			rewardGold, rewardXP = Config.DailyQuestReward(level)
		end
	else
		local per = num(t.RewardPerUnit, 1)
		local mult = Config.Quests.ExtraRewardMult
		rewardGold = math.floor(units * main.Gold * per * mult)
		rewardXP = math.floor(units * main.XP * per * mult)
	end

	local text
	if t.Id == "Gold" then
		text = string.format(t.Text, tostring(target)) -- CR-L31: exact number (FormatNumber rounds to "3.2K")
	elseif t.Id == "Kill" or t.Id == "Golden" then
		text = string.format(t.Text, tostring(unitDef.Short or unitDef.Name), target) -- CR-M27: (monster name, target)
	else
		text = string.format(t.Text, target)
	end

	local progress = 0
	if target >= 5 then
		progress = math.floor(target * Util.Random:NextNumber(Config.Quests.EndowedMin, Config.Quests.EndowedMax))
	end

	return {
		Id = t.Id,
		Kind = kind,
		Target = target,
		Progress = progress,
		RewardGold = math.floor(num(rewardGold)),
		RewardXP = math.floor(num(rewardXP)),
		Text = text,
		MinStacks = t.MinStacks,
		Unit = unitId, -- Kill/Golden progress is measured in kills of this monster (see killWeight)
		Strict = (newbie and row.Strict == true) or nil, -- A23-14: only Unit (or stronger) kills count, 1 each
	}
end

-- exactly Config.Quests.Slots valid quests; missing/invalid entries become fresh extras
local function ensureSlots(player, data)
	local slots = Config.Quests.Slots
	local old = (type(data.Quests) == "table") and data.Quests or {}
	local fixed = {}
	for i = 1, slots do
		local q = old[i]
		if isValidQuest(q) then
			q.Progress = math.clamp(q.Progress, 0, q.Target)
			if q.Id == "Release" then
				q.MinStacks = nil
				q.Text = string.format(TEMPLATE_BY_ID.Release.Text, q.Target)
			end
			fixed[i] = q
		end
	end
	for i = 1, slots do
		if not fixed[i] then
			local others = {}
			for j = 1, slots do
				if j ~= i and fixed[j] then table.insert(others, fixed[j]) end
			end
			fixed[i] = newQuest(player, "Extra", others)
		end
	end
	data.Quests = fixed
end

------------------------------------------------------------------ tutorial (A4 / A5)
local function getStep(player)
	local data = getData(player)
	if not data then return TUT_DONE end
	local step = data.TutorialStep
	if type(step) ~= "number" or step ~= step then return TUT_DONE end
	return step
end

-- A saved counter, not a session cache: 4/5 and unclaimed 5/5 survive a normal save/rejoin.
local function getTutorialKills(data)
	return math.clamp(math.floor(num(data and data.TutorialKills)), 0, TUT_TARGET)
end

local function setStep(player, step)
	if not getData(player) then return end
	local previous = getStep(player)
	S.PlayerService.SetStat(player, "TutorialStep", step)
	dirty[player] = true -- step 0/1 guidance is published too, even before there is a kill quest
	-- defensive mirror in case TutorialStep is missing from Config.Data.Mirrored
	if player:GetAttribute("TutorialStep") ~= step then
		player:SetAttribute("TutorialStep", step)
	end
	if step == STEP_GUIDE then
		if S.ZoneService.GetZoneId(player) == TUT_ZONE then
			setStep(player, STEP_QUEST) -- already standing in the meadow
		end
	elseif step == STEP_QUEST and previous ~= STEP_QUEST then
		Net.Notify(player, string.format(TUT_START_TEXT, TUT_TEXT, Util.FormatNumber(TUT_GOLD)), "good")
	end
end

local function canWelcome(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not Util.IsAlive(player) then return false end
	local data = getData(player)
	local welcome = TUT_CFG.Welcome
	return data ~= nil and data.ClassChosen == true and Config.Classes[data.Class] ~= nil
		and getStep(player) == STEP_WELCOME and type(welcome) == "table"
		and type(welcome[getFaction(player)]) == "table"
end

local function openWelcome(player)
	if not canWelcome(player) then return end
	Net.Get("OpenPanel"):FireClient(player, "Welcome")
	welcomeShown[player] = true
end

local function onRequestTutorial(player, ...)
	if select("#", ...) ~= 0 or not canWelcome(player) then return end
	if not Util.RateLimit(player, "RequestTutorial", TUT_CFG.WelcomeRate or 0.5) then return end
	openWelcome(player)
end

-- A23-9: the client reports the first-time opening ended; only the server writes the saved flag
local function onIntroSeen(player, ...)
	if select("#", ...) ~= 0 or not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "IntroSeen", 1) then return end
	local data = getData(player)
	if not data or data.IntroSeen == true then return end
	S.PlayerService.SetStat(player, "IntroSeen", true)
end

local function onAcceptTutorial(player, ...)
	if select("#", ...) ~= 0 or not canWelcome(player) then return end
	if not Util.RateLimit(player, "AcceptTutorial", TUT_CFG.WelcomeRate or 0.5) then return end
	welcomeShown[player] = true
	S.PlayerService.SetStat(player, "TutorialKills", 0) -- a fresh acceptance never inherits stale kills
	setStep(player, STEP_GUIDE) -- acceptance in the meadow can enter step 2, without crediting any kill
end

-- Restore existing accepted progress. Step 0 only opens dialogue; closing it never accepts a mission.
local function tryTutorial(player)
	local data = getData(player)
	if not data then return end
	local step = getStep(player)
	if step == TUT_DONE then
		-- The existing watchdog observes purchases and level changes; publish deduplicates identical JSON.
		dirty[player] = true
		return
	end
	if step == STEP_GUIDE then
		if S.ZoneService.GetZoneId(player) == TUT_ZONE then
			setStep(player, STEP_QUEST)
		end
		return
	end
	if step ~= STEP_WELCOME or welcomeShown[player] then return end
	openWelcome(player)
end

local function tutorialKill(player, info)
	local data = getData(player)
	if not data then return end
	local cur = getTutorialKills(data)
	if cur >= TUT_TARGET or not TUTORIAL_KINDS[info.Kind] or info.Personal == true
		or info.ZoneId ~= TUT_ZONE then return end
	cur += 1
	S.PlayerService.SetStat(player, "TutorialKills", cur)
	dirty[player] = true
	if cur >= TUT_TARGET then
		Net.Notify(player, string.format(TUT_READY_TEXT), "good")
	end
end

local function claimTutorial(player)
	if getStep(player) ~= STEP_QUEST then return end
	if getTutorialKills(getData(player)) < TUT_TARGET then return end
	setStep(player, TUT_DONE) -- first, so it can never be paid twice
	S.ProgressionService.AddBankGold(player, TUT_GOLD, "Quest")
	if TUT_XP > 0 then
		S.ProgressionService.AddXP(player, TUT_XP)
	end
	Net.Notify(player, string.format(TUT_CLAIMED_TEXT, Util.FormatNumber(TUT_GOLD)), "reward")
end

-- A23-3: one fixed next-goal line after the blacksmith visit, from existing state only (no new reward).
local IRON_TIER = 3
local NEXT_ZONE = "GoblinWoods"
local hadNextGoal = {} -- [Player] = true while the pinned row shows a next goal (GuideDone toast on its end)
local function nextGoalText(data)
	local level = getLevel(data)
	local iron = Config.Weapons[IRON_TIER]
	local owned = math.floor(num(data.WeaponOwnedMask, 1))
	local hasIron = bit32.btest(owned, bit32.lshift(1, IRON_TIER - 1)) or num(data.WeaponTier, 1) >= IRON_TIER
	if iron and not hasIron then
		if level < iron.MinLevel then
			return string.format(TUT_MESSAGES.NextIronLevel, iron.MinLevel, level)
		end
		local gold = math.floor(math.max(0, num(data.CarriedGold)) + math.max(0, num(data.BankGold)))
		return string.format(TUT_MESSAGES.NextIronGold, Util.FormatNumber(iron.Price), Util.FormatNumber(gold))
	end
	local zone = Config.Zones[NEXT_ZONE]
	if zone and level < zone.MinLevel then
		return string.format(TUT_MESSAGES.NextZone, zone.MinLevel, tostring(zone.Name), level)
	end
	return nil
end

local function tutorialEntry(player, data)
	local step = getStep(player)
	local entry = {
		Id = TUT_ID, Kind = TUT_KIND, Pinned = true, TutorialStep = step,
		Progress = 0, Target = 1, RewardGold = 0, RewardXP = 0,
		CanClaim = false, ShowProgress = false,
	}
	if step == STEP_WELCOME then
		entry.Text = TUT_MESSAGES.Welcome or "첫 임무: 메뉴 > 안내자 대화에서 임무를 받아요."
	elseif step == STEP_GUIDE then
		entry.Text = TUT_MESSAGES.Travel or "말랑 초원으로 가요 · 메뉴 > 이동 > 말랑 초원"
	elseif step == STEP_QUEST then
		entry.Progress, entry.Target = getTutorialKills(data), TUT_TARGET
		entry.Text = if entry.Progress >= TUT_TARGET then TUT_READY_TEXT else TUT_TEXT
		entry.RewardGold, entry.RewardXP = TUT_GOLD, TUT_XP
		entry.CanClaim, entry.ShowProgress = true, true
	elseif step == TUT_DONE and data.ClassChosen == true and getFaction(player) ~= "None" then
		if data.BlacksmithVisited ~= true then
			entry.Text = TUT_MESSAGES.VisitBlacksmith
				or "무기 살펴보기 · 교차로 마을 대장간"
		else
			local text = nextGoalText(data)
			if not text then return nil end
			entry.Text = text
			entry.NextGoal = true
		end
	else
		return nil
	end
	return entry
end

------------------------------------------------------------------ publish
local function publish(player)
	dirty[player] = nil
	if player.Parent == nil then
		lastSent[player] = nil -- left: never fire to (or keep state for) a removed player
		hadNextGoal[player] = nil
		return
	end
	local data = getData(player)
	if not data then return end
	local list = {}
	local tutorial = tutorialEntry(player, data)
	-- after the first mission the story main row takes the pinned slot (the next-goal line stays the fallback)
	local story = S.StoryQuestService
	if getStep(player) == TUT_DONE and story and type(story.MainRow) == "function" then
		local okMain, main = pcall(story.MainRow, player, data)
		if okMain and main then tutorial = main end
	end
	if tutorial then table.insert(list, tutorial) end -- always first, never occupies/rerolls a daily slot
	if story and type(story.SubRows) == "function" then
		local okSubs, subs = pcall(story.SubRows, player, data)
		if okSubs and type(subs) == "table" then
			for _, row in subs do table.insert(list, row) end
		end
	end
	-- the guide chain just ran out (iron weapon owned and Lv10 reached): say so once, then the row disappears
	local hasGoal = tutorial ~= nil and (tutorial.NextGoal == true or tutorial.Story ~= nil)
	if hadNextGoal[player] and not hasGoal and getStep(player) == TUT_DONE then
		Net.Notify(player, TUT_MESSAGES.GuideDone or "안내는 여기까지! 이제 사냥하며 강해져요.", "good")
	end
	hadNextGoal[player] = hasGoal or nil
	if type(data.Quests) == "table" then
		-- CR-M6: dailies show what a claim pays now (stored reward capped to the current level; stored value kept)
		local capG, capX = Config.DailyQuestReward(getLevel(data))
		for i, q in ipairs(data.Quests) do
			if type(q) == "table" then
				local rg, rx = num(q.RewardGold), num(q.RewardXP)
				if q.Kind == "Daily" then
					rg, rx = capTo(math.floor(rg), math.floor(rx), capG, capX)
				end
				table.insert(list, {
					Id = tostring(q.Id),
					Kind = q.Kind,
					Text = tostring(q.Text),
					-- CR-M27: Kill/Golden progress is fractional; sent floored to 1 decimal (0.43 -> 0.4)
					Progress = math.floor(num(q.Progress) * 10 + PROGRESS_EPS) / 10,
					Target = num(q.Target),
					RewardGold = rg,
					RewardXP = rx,
					Slot = i, -- N1: clients address quests by Slot, never by array index
				})
			end
		end
	end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, list)
	if not ok then
		Util.Warn(TAG, "quest list encode failed: " .. tostring(json))
		return
	end
	-- CR-L50: owner-only remote instead of the QuestsJson attribute (which replicated to every client), fired only
	-- on change. Payload = the same JSON string the attribute held.
	if lastSent[player] == json then return end
	local okF, err = pcall(function()
		Net.Get("Quests"):FireClient(player, json)
	end)
	if okF then
		lastSent[player] = json
	else
		Util.Warn(TAG, "Quests fire failed: " .. tostring(err))
	end
end

------------------------------------------------------------------ progress & completion
local function payReward(player, gold, xp)
	if gold > 0 then
		S.ProgressionService.AddBankGold(player, gold, "Quest")
	end
	if xp > 0 then
		S.ProgressionService.AddXP(player, xp)
	end
end

-- bonus chest for the full set of dailies (claimed by hand, or completed by the midnight auto-pay: CR-M21).
-- genLevel = level the set was generated at (default data.DailyLevel; the midnight auto-pay passes the OLD day's)
local function payChest(player, data, genLevel)
	if genLevel == nil then genLevel = data.DailyLevel end
	local cg, cx = chestReward(getLevel(data), genLevel)
	cg, cx = math.floor(num(cg)), math.floor(num(cx))
	payReward(player, cg, cx)
	Net.Notify(player, string.format(Config.Text.DailyChest, Util.FormatNumber(cg), Util.FormatNumber(cx)), "reward")
	if Util.Random:NextNumber() < Config.Daily.ChestTicketChance then
		local ok, err = pcall(S.MonetizationService.AddTickets, player, "Class", 1)
		if ok then
			Net.Notify(player, string.format(Config.Text.DailyChestTicket), "reward")
		else
			Util.Warn(TAG, "chest ticket failed: " .. tostring(err))
		end
	end
end

local function completeQuest(player, data, index, q)
	q.Progress = q.Target
	dirty[player] = true
	-- A23-3: before the first mission is accepted the dailies are folded on screen, so no "done" toasts either
	local quiet = getStep(player) == STEP_WELCOME
	if q.Kind == "Extra" then
		-- replace first so the finished quest can never be paid twice
		data.Quests[index] = newQuest(player, "Extra", othersExcept(data.Quests, index))
		payReward(player, math.floor(num(q.RewardGold)), math.floor(num(q.RewardXP)))
		if not quiet then
			Net.Notify(player, string.format(Config.Text.QuestDone, Util.FormatNumber(q.RewardGold)), "reward")
		end
	elseif not quiet then
		-- dailies stay in their slot until claimed
		Net.Notify(player, string.format(Config.Text.DailyReady), "good")
	end
end

-- Kill/Golden progress of one kill of monster `kind`, in units of the quest's monster (q.Unit, fixed at generation):
-- a weaker monster counts def.XP / unit.XP (never more than 1), so quests whose rewards were sized for the player's
-- level zone cannot be farmed on safe low-zone slimes (also not after a free class change or a rebirth).
local function killWeight(q, kind, level)
	local unitId = q.Unit
	if type(unitId) ~= "string" or Config.MonsterTypes[unitId] == nil then
		unitId = Config.ZoneMainMonster[Config.QuestZoneForLevel(level)] -- quests saved before Unit existed
	end
	local unit = Config.MonsterTypes[unitId]
	local def = Config.MonsterTypes[kind]
	local strict = q.Strict == true -- A23-14 "왕 슬라임 3마리": a weaker monster counts 0, not a fraction
	if type(unit) ~= "table" or type(def) ~= "table" or num(unit.XP) <= 0 then
		return if strict and kind ~= unitId then 0 else 1
	end
	local w = math.clamp(num(def.XP) / unit.XP, 0, 1)
	if strict and w < 1 then return 0 end
	return w
end

-- amount: number, or function(q) -> number (per-quest amount); accept(q) optional filter
local function addProgress(player, questId, amount, accept)
	if type(amount) ~= "function" then
		amount = num(amount)
		if amount <= 0 then return end
	end
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return end
	local quests = data.Quests
	for i = 1, #quests do
		local q = quests[i]
		if type(q) == "table" and q.Id == questId and type(q.Progress) == "number" and type(q.Target) == "number"
			and q.Progress < q.Target and (accept == nil or accept(q)) then
			local add = if type(amount) == "function" then num(amount(q)) else amount
			if add > 0 then
				local progress = q.Progress + add
				if progress >= q.Target - PROGRESS_EPS then
					progress = q.Target -- fractional kill weights must never leave a quest at 49.9999 / 50
				end
				q.Progress = progress
				dirty[player] = true
				if q.Progress >= q.Target then
					completeQuest(player, data, i, q)
				end
			end
		end
	end
end

------------------------------------------------------------------ day check / vacation
local function runDayCheck(player)
	local data = getData(player)
	if not data then return end
	local today = Config.DayIndex(os.time())
	local dailyDay = math.floor(num(data.DailyDay))
	if dailyDay == today then return end

	-- build the fresh dailies first (no side effects yet)
	local fresh = {}
	for i = 1, Config.Quests.Slots do
		fresh[i] = newQuest(player, "Daily", fresh)
	end

	-- completed but unclaimed dailies of the old day are paid automatically
	local toPay = {}
	if type(data.Quests) == "table" then
		for _, q in data.Quests do
			if isValidQuest(q) and q.Kind == "Daily" and isComplete(q) then
				table.insert(toPay, q)
			end
		end
	end

	-- CR-M21: dailies of the old day that count as done = claimed ones + the ones auto-paid below
	local slots = Config.Quests.Slots
	local prevClaims = math.clamp(math.floor(num(data.DailyClaims)), 0, slots)
	local claims = math.min(slots, prevClaims + #toPay)
	-- the old day's dailies were generated at this level (0 = unknown save -> the current level's band)
	local oldGenLevel = math.floor(num(data.DailyLevel))
	local level = getLevel(data)

	-- commit: the day flips before anything is paid, so a failure can never double-pay
	S.PlayerService.SetStat(player, "DailyDay", today)
	S.PlayerService.SetStat(player, "DailyClaims", 0)
	data.DailyLevel = level -- the fresh set's band (caps its chest, see chestReward)

	-- CR-M21: vacation days = (1 - f) for the old day + every whole missed day (fractional, no floor), where
	-- f = share of a full day's daily value (3 dailies + chest) earned on the old day. A partly played day
	-- therefore never pays less than an absent one. A23-14 review: f uses the minutes of the old day's band (Lv1-9 =
	-- Newbie 2 x 3 + 4, else Daily 5 x 3 + 10) and Config.VacationReward the current level's band, so a missed
	-- Lv1-9 day (252 gold / 420 XP) pays less than a played one (360 / 600).
	if dailyDay > 0 and today > dailyDay then
		local D = Config.Daily
		local band = oldGenLevel >= 1 and oldGenLevel or level
		local newbieDay = isNewbieLevel(band)
		local perQuest = newbieDay and num(NEWBIE.RewardMinutes, D.QuestMinutes) or D.QuestMinutes
		local chestMin = newbieDay and num(NEWBIE.ChestMinutes, D.ChestMinutes) or D.ChestMinutes
		local fullDay = perQuest * slots + chestMin
		local earned = claims * perQuest + ((claims >= slots) and chestMin or 0)
		local f = if fullDay > 0 then math.clamp(earned / fullDay, 0, 1) else 1
		local add = (1 - f) + math.max(0, today - dailyDay - 1)
		if add > 0 then
			local days = math.min(D.VacationMaxDays, math.max(0, num(data.VacationDays)) + add)
			days = math.floor(days * 1000 + 0.5) / 1000 -- keep the mirrored attribute tidy
			local g, x = Config.VacationReward(getLevel(data), days)
			S.PlayerService.SetStat(player, "VacationDays", days)
			S.PlayerService.SetStat(player, "VacationGold", g)
			S.PlayerService.SetStat(player, "VacationXP", x)
		end
	end

	data.Quests = fresh
	dirty[player] = true

	local capG, capX = Config.DailyQuestReward(getLevel(data)) -- CR-M6
	local paidGold = 0
	for _, q in toPay do
		local g, x = capTo(math.floor(num(q.RewardGold)), math.floor(num(q.RewardXP)), capG, capX)
		paidGold += g
		payReward(player, g, x)
	end
	if paidGold > 0 then
		Net.Notify(player, string.format(Config.Text.DailyAutoPaid, Util.FormatNumber(paidGold)), "reward")
	end
	-- CR-M21: an auto-pay that completes the set also pays the bonus chest (capped to the OLD day's band)
	if prevClaims < slots and claims >= slots then
		payChest(player, data, oldGenLevel)
	end
end

------------------------------------------------------------------ remotes
local function onClaimQuest(player, slot)
	if not S.PlayerService.IsReady(player) then return end
	if type(slot) == "string" and string.sub(slot, 1, 6) == "story:" then -- story rows claim by id
		if not Util.RateLimit(player, "ClaimQuest", Config.RateLimits.ClaimQuest) then return end
		local story = S.StoryQuestService
		if story and type(story.Claim) == "function" then pcall(story.Claim, player, string.sub(slot, 7)) end
		return
	end
	local isTutorial = (slot == TUT_ID)
	if not isTutorial and not isSlotIndex(slot) then return end
	if not Util.RateLimit(player, "ClaimQuest", Config.RateLimits.ClaimQuest) then return end
	local data = getData(player)
	if not data then return end

	if isTutorial then
		claimTutorial(player)
		return
	end

	if type(data.Quests) ~= "table" then return end
	local q = data.Quests[slot]
	if not isValidQuest(q) or q.Kind ~= "Daily" or not isComplete(q) then return end -- silent

	data.Quests[slot] = newQuest(player, "Extra", othersExcept(data.Quests, slot))
	dirty[player] = true

	local g, x = math.floor(num(q.RewardGold)), math.floor(num(q.RewardXP))
	g, x = capTo(g, x, Config.DailyQuestReward(getLevel(data))) -- CR-M6
	payReward(player, g, x)
	Net.Notify(player, string.format(Config.Text.DailyClaimed, Util.FormatNumber(g), Util.FormatNumber(x)), "reward")

	local claims = num(S.PlayerService.AddStat(player, "DailyClaims", 1))
	if claims == Config.Quests.Slots then
		payChest(player, data)
	end
end

local function onRerollQuest(player, slot)
	if not S.PlayerService.IsReady(player) then return end
	if not isSlotIndex(slot) then return end
	if not Util.RateLimit(player, "RerollQuest", Config.RateLimits.RerollQuest) then return end
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return end

	local now = Util.Now()
	if now < (rerollReadyAt[player] or 0) then return end

	local q = data.Quests[slot]
	local kind = "Extra"
	if isValidQuest(q) then
		if isComplete(q) then return end
		kind = q.Kind
	end

	data.Quests[slot] = newQuest(player, kind, othersExcept(data.Quests, slot))
	local readyAt = now + Config.Quests.RerollCooldown
	rerollReadyAt[player] = readyAt
	player:SetAttribute("RerollReadyAt", readyAt)
	dirty[player] = true
end

local function onClaimVacation(player)
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "ClaimVacation", Config.RateLimits.ClaimVacation) then return end
	local data = getData(player)
	if not data then return end
	if num(data.VacationDays) <= 0 then return end -- silent

	local g = math.floor(math.max(0, num(data.VacationGold)))
	local x = math.floor(math.max(0, num(data.VacationXP)))
	g, x = capTo(g, x, Config.VacationReward(getLevel(data), num(data.VacationDays))) -- CR-M6
	-- zero first, so the reward can never be claimed twice
	S.PlayerService.SetStat(player, "VacationDays", 0)
	S.PlayerService.SetStat(player, "VacationGold", 0)
	S.PlayerService.SetStat(player, "VacationXP", 0)
	payReward(player, g, x)
	Net.Notify(player, string.format(Config.Text.VacationClaimed, Util.FormatNumber(g), Util.FormatNumber(x)), "reward")
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player, data)
	if type(data) ~= "table" then data = getData(player) end
	if type(data) ~= "table" then return end

	rerollReadyAt[player] = 0
	player:SetAttribute("RerollReadyAt", 0)

	local step = data.TutorialStep
	if type(step) ~= "number" or step ~= step then step = TUT_DONE end
	if player:GetAttribute("TutorialStep") ~= step then
		player:SetAttribute("TutorialStep", step)
	end
	-- Never reset the saved TutorialKills here: a reconnect can have an unclaimed completed quest.

	ensureSlots(player, data)
	runDayCheck(player)
	tryTutorial(player) -- pending dialogue opens once when choices and a living character are ready
	publish(player)
end

local function onPlayerLeaving(player)
	dirty[player] = nil
	lastSent[player] = nil
	rerollReadyAt[player] = nil
	welcomeShown[player] = nil
	hadNextGoal[player] = nil
end

local function onCharacterSpawned(player)
	-- CR-L50 safety net: resend the quest list once per spawn (the client keeps the last payload; same content)
	lastSent[player] = nil
	dirty[player] = true
	task.delay(RESUME_DELAY_ON_SPAWN, function()
		local ok, err = pcall(tryTutorial, player)
		if not ok then Util.Warn(TAG, "tutorial on spawn: " .. tostring(err)) end
	end)
end

local function onClassChanged(player)
	task.delay(RESUME_DELAY_ON_CLASS, function()
		local ok, err = pcall(tryTutorial, player)
		if not ok then Util.Warn(TAG, "tutorial on class pick: " .. tostring(err)) end
	end)
end

local function onZoneChanged(player, newZoneId)
	if newZoneId == TUT_ZONE and getStep(player) == STEP_GUIDE then
		setStep(player, STEP_QUEST)
	end
end

local function onMonsterKilled(player, info)
	if type(info) ~= "table" then return end
	local data = getData(player)
	if not data then return end
	local step = getStep(player)
	local level = getLevel(data)
	local function weight(q)
		return killWeight(q, info.Kind, level)
	end
	addProgress(player, "Kill", weight)
	if info.Golden == true then
		addProgress(player, "Golden", weight)
	end
	if step == STEP_QUEST then
		tutorialKill(player, info)
	elseif step == STEP_GUIDE and info.Personal ~= true and info.ZoneId == TUT_ZONE
		and TUTORIAL_KINDS[info.Kind] then
		-- The kill signal may precede ZoneChanged by one tick.
		setStep(player, STEP_QUEST)
		tutorialKill(player, info)
	end
end

local function onGoldEarned(player, amount, source)
	if source ~= "Monster" then return end
	addProgress(player, "Gold", math.floor(num(amount)))
end

-- Only a server-confirmed manual skill that hit at least one monster counts (A23-1; no whiffs in town).
local function onReleased(player, info)
	if type(info) ~= "table" then return end
	if info.Auto == true then return end
	if num(info.MonstersHit) < 1 then return end
	addProgress(player, "Release", 1)
end

local function onGooseFinished(_result, counts)
	if type(counts) ~= "table" then return end
	for p, c in counts do
		if typeof(p) == "Instance" and p:IsA("Player") and num(c) > 0 then
			addProgress(p, "Goose", 1)
		end
	end
end

local function onPlayerKO(killer, _victim, info)
	if type(info) ~= "table" or typeof(killer) ~= "Instance" then return end
	if info.Kind == "Bounty" then
		addProgress(killer, "Hunt", 1)
	elseif info.Kind == "Plunder" then
		addProgress(killer, "Plunder", 1)
	end
end

local function onKaijuEnded(_kaiju, outcome, participants)
	if outcome ~= "Defeated" or type(participants) ~= "table" then return end
	for _, p in participants do
		if typeof(p) == "Instance" and p:IsA("Player") then
			addProgress(p, "Hunt", 1)
		end
	end
end

-- regenerate (same Kind) unfinished slots whose template no longer fits the new faction
local function onFactionChanged(player, newFaction)
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return end
	if type(newFaction) ~= "string" then newFaction = getFaction(player) end
	local quests = data.Quests
	for i = 1, #quests do
		local q = quests[i]
		if isValidQuest(q) and not isComplete(q) and not templateFitsFaction(TEMPLATE_BY_ID[q.Id], newFaction) then
			local nq = newQuest(player, q.Kind, othersExcept(quests, i))
			if q.Kind == "Daily" then
				-- CR-L12: a remade daily keeps the reward it had (a rebirth must not shrink it to Lv1 here;
				-- claiming caps it to the current level anyway: CR-M6)
				nq.RewardGold = math.max(nq.RewardGold, math.floor(num(q.RewardGold)))
				nq.RewardXP = math.max(nq.RewardXP, math.floor(num(q.RewardXP)))
			end
			quests[i] = nq
			dirty[player] = true
		end
	end
end

-- dailies keep their stored rewards (capped to the current level when claimed: CR-M6); extras are regenerated
-- for the new (level 1) life. Also runs on ProgressionService.LevelReset (free class change, CR-M6).
local function onRebirthed(player)
	local data = getData(player)
	if not data then return end
	-- CR-M6: re-cap the mirrored vacation reward to the new level, so the vacation panel shows what a claim pays
	local vg = math.floor(math.max(0, num(data.VacationGold)))
	local vx = math.floor(math.max(0, num(data.VacationXP)))
	local cg, cx = capTo(vg, vx, Config.VacationReward(getLevel(data), num(data.VacationDays)))
	if cg ~= num(data.VacationGold) then
		S.PlayerService.SetStat(player, "VacationGold", cg)
	end
	if cx ~= num(data.VacationXP) then
		S.PlayerService.SetStat(player, "VacationXP", cx)
	end
	if type(data.Quests) ~= "table" then return end
	local quests = data.Quests
	for i = 1, Config.Quests.Slots do
		local q = quests[i]
		if not isValidQuest(q) or q.Kind == "Extra" then
			quests[i] = newQuest(player, "Extra", othersExcept(quests, i))
		end
	end
	dirty[player] = true
end

-- CR-M6: the daily cap rises with the level -> republish so the shown (capped) daily rewards follow it
local function onLeveledUp(player)
	dirty[player] = true
end

------------------------------------------------------------------ public API
function M.GetQuests(player)
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return {} end
	return data.Quests
end

-- Studio hook: pretend the player was away for `days` whole days, then run the day check
function M.DebugSimulateAbsence(player, days)
	if not getData(player) then return end
	days = math.max(0, math.floor(num(tonumber(days), 1)))
	local today = Config.DayIndex(os.time())
	S.PlayerService.SetStat(player, "DailyDay", today - (days + 1))
	runDayCheck(player)
	publish(player)
end

------------------------------------------------------------------ lifecycle
function M.Init(registry)
	S = registry
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
	connectSignal("PlayerService", "CharacterSpawned", onCharacterSpawned)
	connectSignal("MonsterService", "MonsterKilled", onMonsterKilled)
	connectSignal("ProgressionService", "GoldEarned", onGoldEarned)
	connectSignal("ProgressionService", "Rebirthed", onRebirthed)
	connectSignal("ProgressionService", "LevelReset", onRebirthed) -- CR-M6
	connectSignal("ProgressionService", "LeveledUp", onLeveledUp) -- CR-M6
	connectSignal("CombatService", "Released", onReleased)
	connectSignal("GooseService", "GooseFinished", onGooseFinished)
	connectSignal("PvPService", "PlayerKO", onPlayerKO)
	connectSignal("KaijuService", "KaijuEnded", onKaijuEnded)
	connectSignal("FactionService", "FactionChanged", onFactionChanged)
	connectSignal("ClassService", "ClassChanged", onClassChanged)
	connectSignal("ZoneService", "ZoneChanged", onZoneChanged)
end

-- StoryQuestService asks for a fresh quest list after story progress
function M.MarkDirty(player)
	if typeof(player) == "Instance" and player:IsA("Player") then dirty[player] = true end
end

function M.Start()
	Net.Get("RequestTutorial").OnServerEvent:Connect(onRequestTutorial)
	Net.Get("AcceptTutorial").OnServerEvent:Connect(onAcceptTutorial)
	Net.Get("IntroSeen").OnServerEvent:Connect(onIntroSeen)
	Net.Get("ClaimQuest").OnServerEvent:Connect(onClaimQuest)
	Net.Get("RerollQuest").OnServerEvent:Connect(onRerollQuest)
	Net.Get("ClaimVacation").OnServerEvent:Connect(onClaimVacation)

	-- publish dirty quest lists
	task.spawn(function()
		while true do
			task.wait(PUBLISH_INTERVAL)
			local list = {}
			for p in dirty do
				table.insert(list, p)
			end
			for _, p in list do
				local ok, err = pcall(publish, p)
				if not ok then loopWarn("publish loop", err) end
			end
		end
	end)

	-- KST day rollover for online players
	task.spawn(function()
		while true do
			task.wait(Config.Daily.CheckInterval)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(runDayCheck, p)
				if not ok then loopWarn("day loop", err) end
			end
		end
	end)

	-- Step 0 only opens the welcome once; entering the meadow advances accepted step 1, never bypasses acceptance.
	task.spawn(function()
		while true do
			task.wait(TUTORIAL_TICK)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tryTutorial, p)
				if not ok then loopWarn("tutorial loop", err) end
				-- the next-goal line reads level/gold; publish() only fires when the JSON really changed
				if getStep(p) == TUT_DONE then dirty[p] = true end
			end
		end
	end)

	print("[QuestService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{ED82A0AA-C7DD-4D47-8EC2-8150FEE2B0A8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">QuestService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f6880000091d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3518F631B79A4388BA027FE0B3843F9F">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ShopService.luau : chosen basic weapons at the blacksmith and potions from their merchant.
-- UpgradeWeapon is the legacy purchase remote name; it does not enhance the current weapon.
-- CharacterVisuals rebuilds the weapon model from the WeaponTier attribute change.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local M = {}

local S = nil
local BLACKSMITH = { PromptName = "HHC_BlacksmithPrompt", Distance = 12, PromptRate = 0.5 }

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function notifyBad(player, key, ...)
	Net.Notify(player, string.format(Config.Text[key], ...), "bad")
end

local function onUpgradeWeapon(player, selectedTier)
	-- Client chooses only the catalog tier. Price, ownership and all eligibility stay on the server.
	if not finite(selectedTier) or selectedTier ~= math.floor(selectedTier) or selectedTier < 1
		or selectedTier > Config.MaxWeaponTier then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "UpgradeWeapon", Config.RateLimits.UpgradeWeapon) then return end
	-- Recheck the physical shop on EVERY purchase, even if its panel was opened earlier.
	if not M.CanBuyWeapon(player) then
		Net.Notify(player, Config.Text.WeaponShopFar, "bad")
		return
	end

	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end

	local maxTier = Config.MaxWeaponTier
	local tier = data.WeaponTier
	if not finite(tier) or tier ~= math.floor(tier) or tier < 1 or tier > maxTier then return end
	local shop = Config.WeaponShop
	local saleLimit = type(shop) == "table" and shop.MaxSoldTier or nil
	-- An absent/malformed sale list must never silently expose rare tiers for gold.
	if not finite(saleLimit) or saleLimit ~= math.floor(saleLimit) or saleLimit < 1 or saleLimit > maxTier then
		Util.Warn("ShopService", "invalid WeaponShop.MaxSoldTier; weapon purchase refused")
		return
	end
	if selectedTier > saleLimit then
		Net.Notify(player, Config.Text.WeaponNotSold, "info")
		return
	end
	local selectedDef = Config.Weapons[selectedTier]
	if type(selectedDef) ~= "table" then return end
	local ownedMask = data.WeaponOwnedMask
	local validMask = bit32.lshift(1, maxTier) - 1
	if not finite(ownedMask) or ownedMask ~= math.floor(ownedMask) or ownedMask < 1
		or ownedMask > validMask or bit32.band(ownedMask, 1) == 0 then return end
	local selectedBit = bit32.lshift(1, selectedTier - 1)
	local alreadyOwned = bit32.band(ownedMask, selectedBit) ~= 0
	if selectedTier == 1 and not alreadyOwned then return end -- starting gear is equip-only, never a purchase

	-- A23-4 / review: MinLevel gates the PURCHASE only; an owned weapon is always a free re-equip (also at Lv1 after a
	-- rebirth or a free class change, same rule as LootService.onEquipWeapon)
	local level, minLevel = data.Level, selectedDef.MinLevel
	if not finite(level) or not finite(minLevel) then return end
	if not alreadyOwned and level < minLevel then
		notifyBad(player, "WeaponNeedLevel", minLevel)
		return
	end

	-- the faction weapon needs a chosen faction (Halo, Horns or Neutral — never "None")
	local faction = S.FactionService.GetFaction(player)
	if type(faction) ~= "string" then faction = "None" end
	if selectedDef.RequiresFaction and faction == "None" then
		notifyBad(player, "NeedFaction")
		return
	end
	-- review B6: the same state rules as the item-list equip (LootService.onEquipWeapon): alive (CanBuyWeapon above)
	-- and not in PvP combat. Checked before any gold is spent; a purchase always equips, so it is refused too.
	if S.CombatService.IsInCombat(player) then
		Net.Notify(player, Config.Loot.Text.EquipCombat, "bad")
		return
	end

	if not alreadyOwned then
		local price = selectedDef.Price
		if not finite(price) or price <= 0 or price ~= math.floor(price) then
			Util.Warn("ShopService", "invalid weapon price; weapon purchase refused")
			return
		end
		-- No yields between debit, ownership and equipment: duplicate requests cannot debit twice.
		if not S.ProgressionService.SpendGold(player, price) then
			notifyBad(player, "NotEnoughGold")
			return
		end
		S.PlayerService.SetStat(player, "WeaponOwnedMask", bit32.bor(ownedMask, selectedBit))
	end

	S.PlayerService.SetStat(player, "WeaponTier", selectedTier)
	S.PlayerService.SetStat(player, "BlacksmithVisited", true) -- A23-4: a verified anvil trade counts as the visit
	S.PlayerService.MarkActive(player)
	local weaponName = Config.WeaponName(selectedTier, S.ClassService.GetClass(player), faction)
	local equipFmt = (Config.Loot and Config.Loot.Text and Config.Loot.Text.Equip) or Config.Text.WeaponBought
	Net.Notify(player, string.format(alreadyOwned and equipFmt or Config.Text.WeaponBought, weaponName), alreadyOwned and "info" or "reward")
	if tier ~= selectedTier then Net.Fx(player, "Upgrade", { Tier = selectedTier }) end
end

local function onSellWeapon(player, selectedTier)
	if not finite(selectedTier) or selectedTier ~= math.floor(selectedTier) or selectedTier < 2
		or selectedTier > Config.MaxWeaponTier then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "SellWeapon", Config.RateLimits.SellWeapon or Config.RateLimits.UpgradeWeapon) then return end
	if not M.CanBuyWeapon(player) then
		Net.Notify(player, Config.Text.WeaponSellFar, "bad")
		return
	end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end
	local maxTier = Config.MaxWeaponTier
	local shop = Config.WeaponShop
	local saleLimit = type(shop) == "table" and shop.MaxSoldTier or nil
	if not finite(saleLimit) or saleLimit ~= math.floor(saleLimit) or saleLimit < 1 or saleLimit > maxTier then return end
	if selectedTier > saleLimit then return end
	local tier, ownedMask = data.WeaponTier, data.WeaponOwnedMask
	if not finite(tier) or tier ~= math.floor(tier) or tier < 1 or tier > maxTier then return end
	local validMask = bit32.lshift(1, maxTier) - 1
	if not finite(ownedMask) or ownedMask ~= math.floor(ownedMask) or ownedMask < 1
		or ownedMask > validMask or bit32.band(ownedMask, 1) == 0 then return end
	local selectedBit = bit32.lshift(1, selectedTier - 1)
	if bit32.band(ownedMask, selectedBit) == 0 then return end
	local definition = Config.Weapons[selectedTier]
	local price = type(definition) == "table" and definition.Price or nil
	if not finite(price) or price <= 0 or price ~= math.floor(price) then return end
	local proceeds = math.floor(price * 0.1)
	-- Remove ownership before emitting any gold signal: a repeated or reentrant sale cannot pay twice.
	S.PlayerService.SetStat(player, "WeaponOwnedMask", bit32.band(ownedMask, bit32.bnot(selectedBit)))
	if tier == selectedTier then S.PlayerService.SetStat(player, "WeaponTier", 1) end
	S.ProgressionService.AddCarriedGold(player, proceeds, "Sale")
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	S.PlayerService.MarkActive(player)
	local weaponName = Config.WeaponName(selectedTier, S.ClassService.GetClass(player), S.FactionService.GetFaction(player))
	Net.Notify(player, string.format(Config.Text.WeaponSold, weaponName, tostring(proceeds)), "good")
end

local function finitePosition(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

local function blacksmithAnvil()
	local map = workspace:FindFirstChild("Map")
	if not map or map.Parent ~= workspace or (not map:IsA("Folder") and not map:IsA("Model")) then return nil end
	local landmarks = map:FindFirstChild("Landmarks")
	if not landmarks or not landmarks:IsA("Folder") or landmarks.Parent ~= map then return nil end
	local guild = landmarks:FindFirstChild("ArtisanGuild")
	if not guild or not guild:IsA("Model") or guild.Parent ~= landmarks then return nil end
	local anvil = guild:FindFirstChild("Anvil")
	if not anvil or not anvil:IsA("BasePart") or anvil.Parent ~= guild or not anvil.Anchored then return nil end
	return anvil
end

-- Attach the interaction to the existing approved map prop; create no new NPC or scenery.
function M.EnsureBlacksmithPrompt()
	local anvil = blacksmithAnvil()
	if not anvil then return false end
	local prompt = anvil:FindFirstChild(BLACKSMITH.PromptName)
	if prompt and not prompt:IsA("ProximityPrompt") then return false end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = BLACKSMITH.PromptName
	end
	prompt.ActionText, prompt.ObjectText = Config.Text.BlacksmithPromptAction, Config.Text.BlacksmithPromptObject
	prompt.KeyboardKeyCode = Enum.KeyCode.E -- standard interact key; the skill is Q only (2026-10-06 playtest)
	prompt.HoldDuration, prompt.MaxActivationDistance = 0, BLACKSMITH.Distance -- a shop opens on a tap, no hold
	prompt.RequiresLineOfSight, prompt.Enabled = false, true
	prompt.Parent = anvil
	return true
end

local function blacksmith()
	local anvil = blacksmithAnvil()
	if not anvil then return nil end
	local prompt = anvil:FindFirstChild(BLACKSMITH.PromptName)
	if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Parent ~= anvil or not prompt.Enabled then return nil end
	return anvil, prompt
end

function M.CanBuyWeapon(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" or data.ClassChosen ~= true then return false end
	local anvil, prompt = blacksmith()
	local root = Util.GetRoot(player)
	if not anvil or not root or not root:IsA("BasePart")
		or not finitePosition(anvil.Position) or not finitePosition(root.Position) then return false end
	local activation = prompt.MaxActivationDistance
	if not finite(activation) or activation <= 0 then return false end
	-- Increasing a prompt's radius never expands the purchase radius beyond the server contract.
	local distance = (root.Position - anvil.Position).Magnitude
	return finite(distance) and distance <= math.min(BLACKSMITH.Distance, activation)
end

local function onBlacksmithPrompt(prompt, player)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt")
		or prompt.Name ~= BLACKSMITH.PromptName or not M.CanBuyWeapon(player) then return end
	local _, expected = blacksmith()
	if expected ~= prompt then return end -- cloned/renamed prompts cannot open the weapon shop
	if not Util.RateLimit(player, "BlacksmithPrompt", BLACKSMITH.PromptRate) then return end
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	Net.Get("OpenPanel"):FireClient(player, "WeaponShop")
end

function M.CanBuyPotions(player)
	if Config.Vitals.MerchantEnabled ~= true or typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
	if player.Parent ~= Players or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false end
	local map = workspace:FindFirstChild("Map")
	if not map or map.Parent ~= workspace or (not map:IsA("Folder") and not map:IsA("Model")) then return false end
	local npcs = map:FindFirstChild("NPCs")
	if not npcs or not npcs:IsA("Folder") or npcs.Parent ~= map then return false end
	local merchant = npcs:FindFirstChild(Config.Vitals.PotionMerchantName)
	local part = merchant and merchant:IsA("Model") and merchant:GetAttribute("HHC_PotionMerchant") == true and merchant.PrimaryPart
	local root = Util.GetRoot(player)
	if not merchant or merchant.Parent ~= npcs or not part or not part:IsA("BasePart")
		or not part:IsDescendantOf(merchant) or not root or not root:IsA("BasePart")
		or not finitePosition(part.Position) or not finitePosition(root.Position) then return false end
	local prompt = part:FindFirstChild(Config.Vitals.PotionMerchantPrompt)
	-- Direct BuyPotion calls require the same live server prompt as opening the shop, including its enabled state.
	if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Parent ~= part or not prompt.Enabled then return false end
	local limit = Config.Vitals.PotionMerchantDistance
	if not finite(limit) or limit <= 0 then return false end
	local distance = (root.Position - part.Position).Magnitude
	return finite(distance) and distance <= limit
end

local function onPotionPrompt(prompt, player)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return end
	if prompt.Name ~= Config.Vitals.PotionMerchantPrompt or not M.CanBuyPotions(player) then return end
	local map = workspace:FindFirstChild("Map")
	local npcs = map and map:FindFirstChild("NPCs")
	local merchant = npcs and npcs:FindFirstChild(Config.Vitals.PotionMerchantName)
	local part = merchant and merchant.PrimaryPart
	if not part or prompt.Parent ~= part or part:FindFirstChild(Config.Vitals.PotionMerchantPrompt) ~= prompt then return end
	if not Util.RateLimit(player, "PotionMerchantPrompt", Config.Vitals.PotionMerchantPromptRate) then return end
	Net.Get("OpenPanel"):FireClient(player, "PotionShop")
end

function M.BuyPotion(player, kind, amount)
	local key = Config.PotionStockKey(kind)
	if not key or type(amount) ~= "number" or (amount ~= 1 and amount ~= 5) then return false, "Invalid" end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false, "NotReady" end
	if not Util.RateLimit(player, "BuyPotion", Config.RateLimits.BuyPotion) then return false, "Cooldown" end
	if not M.CanBuyPotions(player) then
		Net.Notify(player, Config.Text.PotionShopFar, "bad")
		return false, "MerchantDistance"
	end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return false, "NotReady" end
	local count, cap = data[key], Config.Vitals.PotionInventoryCap
	if not finite(count) or count < 0 or count ~= math.floor(count) or count > cap then return false, "InvalidStock" end
	if count + amount > cap then
		Net.Notify(player, string.format(Config.Text.PotionStockFull, cap), "bad")
		return false, "FullStock"
	end
	local price = Config.Vitals.PotionPrices[kind]
	if not finite(price) or price <= 0 or price ~= math.floor(price) then return false, "InvalidPrice" end
	-- Validate the whole purchase before debiting. SpendGold and SetStat do not yield; no request can interleave here.
	-- No datastore write, prompt callback, Notify or remote call occurs between these two mutations.
	if not S.ProgressionService.SpendGold(player, price * amount) then
		notifyBad(player, "NotEnoughGold")
		return false, "NotEnoughGold"
	end
	S.PlayerService.SetStat(player, key, count + amount)
	S.PlayerService.MarkActive(player)
	Net.Notify(player, string.format(Config.Text.PotionBought, kind, amount), "good")
	return true, "Bought"
end

function M.Init(registry)
	S = registry
end

function M.Start()
	if not M.EnsureBlacksmithPrompt() then
		-- Minimal/headless maps may intentionally omit this optional town prop.
		print("[ShopService] no ArtisanGuild.Anvil; weapon shop stays closed")
	end
	-- Global, exact-instance validation survives a MapBuilder rebuild and rejects cloned/renamed prompts.
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local ok, err = pcall(onPotionPrompt, prompt, player)
		if not ok then Util.Warn("ShopService", "potion prompt: " .. tostring(err)) end
		local shopOk, shopErr = pcall(onBlacksmithPrompt, prompt, player)
		if not shopOk then Util.Warn("ShopService", "blacksmith prompt: " .. tostring(shopErr)) end
	end)
	Net.Get("UpgradeWeapon").OnServerEvent:Connect(function(player, ...)
		-- Exactly one catalog tier is accepted; prices, quantities or extra payloads are rejected.
		if select("#", ...) ~= 1 then return end
		local ok, err = pcall(onUpgradeWeapon, player, ...)
		if not ok then Util.Warn("ShopService", "weapon purchase: " .. tostring(err)) end
	end)
	Net.Get("SellWeapon").OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then return end
		local ok, err = pcall(onSellWeapon, player, ...)
		if not ok then Util.Warn("ShopService", "weapon sale: " .. tostring(err)) end
	end)
	Net.Get("BuyPotion").OnServerEvent:Connect(function(player, kind, amount)
		local ok, err = pcall(M.BuyPotion, player, kind, amount)
		if not ok then Util.Warn("ShopService", tostring(err)) end
	end)
	print("[ShopService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{AC24A29F-ECCA-48B2-8D73-DE86E3F2C0AD}</string>
