				<string name="ScriptGuid">{401C18B9-E155-49A7-B7FC-DCEA69B88240}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Main</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">5788d013bf1591860ad23e240000de8d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX68D1A2AFDA694A7C97CF7960D3ED3C2D">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CharacterVisuals.luau : server-built character decorations. Nametag, faction mark (halo / horns / neutral gear), class weapon,
-- gold sack, grudge sack + ghost, rebirth aura, turncoat marks (cape / cracked halo / gray aura), wanted glow and
-- kaiju fire. Every piece is rebuilt on CharacterSpawned and when its watched attributes change.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local CharacterVisuals = {}

------------------------------------------------------------------ constants
local TAG = "CharacterVisuals"
local V = Config.Visuals

local NEUTRAL_ID = "Neutral"
-- CR-L44: "⚙" renders as a tofu box; a missing / empty / unsafe emblem falls back to "장"
local NEUTRAL_EMBLEM = (Config.Factions.Neutral and Config.Factions.Neutral.Emblem) or "장"
if type(NEUTRAL_EMBLEM) ~= "string" or NEUTRAL_EMBLEM == ""
	or (type(Util.GlyphSafe) == "function" and not Util.GlyphSafe(NEUTRAL_EMBLEM)) then
	NEUTRAL_EMBLEM = "장"
end
local MIN_TEXT_SIZE = (Config.UI and Config.UI.MinTextSize) or 11

local WOOD_COLOR = Color3.fromRGB(120, 85, 50)
local DARK_METAL = Color3.fromRGB(60, 60, 70)
local SACK_COLOR = Color3.fromRGB(150, 105, 55)
local SACK_KNOT_COLOR = Color3.fromRGB(110, 75, 40)
local GOLD_SPARK = Color3.fromRGB(255, 210, 60)
local GLOW_FILL = Color3.fromRGB(255, 40, 40)
local GLOW_OUTLINE = Color3.fromRGB(255, 0, 0)
local KAIJU_LIGHT = Color3.fromRGB(255, 60, 30)
local LINE2_COLOR = Color3.fromRGB(235, 235, 240)
local LINE3_COLOR = Color3.fromRGB(255, 70, 70)
local GHOST_TEXT = Color3.fromRGB(220, 170, 255)

local REFRESH_DEBOUNCE = 0.25

-- build order for a full refresh
local PIECE_ORDER = {
	"Nametag", "FactionMark", "WeaponModel", "GoldSack", "GrudgeSack", "GrudgeGhost",
	"RebirthAura", "MarkCape", "MarkHalo", "GrayAura", "WantedGlow", "KaijuFire",
}

-- attribute -> pieces to rebuild ("NametagOffset" = only move the nametag)
local WATCH = {
	Level = { "Nametag", "GoldSack", "GrudgeSack" },
	Class = { "Nametag", "WeaponModel" },
	Faction = { "Nametag", "FactionMark", "WeaponModel", "RebirthAura" },
	Honor = { "Nametag", "FactionMark" },
	Infamy = { "Nametag", "FactionMark" },
	Rebirths = { "Nametag", "RebirthAura" },
	WantedStars = { "Nametag", "WantedGlow" },
	Bounty = { "Nametag" },
	Rookie = { "Nametag" },
	BullyStacks = { "Nametag" },
	SessionTitle = { "Nametag" },
	Nickname = { "Nametag" },
	NicknameVerified = { "Nametag" },
	FallMarks = { "Nametag", "MarkCape", "GrayAura" },
	RedeemMarks = { "Nametag", "MarkHalo", "GrayAura" },
	VisualScale = { "NametagOffset" },
	WeaponTier = { "WeaponModel" },
	CarriedGold = { "GoldSack" },
	SackGold = { "GrudgeSack", "GrudgeGhost" },
	SackVictimName = { "GrudgeGhost" },
	KaijuState = { "WantedGlow", "KaijuFire" },
}

-- body parts whose replacement (e.g. R15 appearance loading) requires a rebuild
local BODY_PARTS = {
	Head = true, RightHand = true, ["Right Arm"] = true, LeftHand = true, ["Left Arm"] = true,
	UpperTorso = true, Torso = true, HumanoidRootPart = true,
}

------------------------------------------------------------------ state
local S = nil
local states = {} -- [Player] = { Conns, CharConns, Dirty, Queued, RefreshQueued }
local builtTier = setmetatable({}, { __mode = "k" }) -- [sack Model] = tier it was built for
local lastWarn = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarn[key]
	if last and now - last < 10 then return end
	lastWarn[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function attrNum(player, name, default)
	local v = player:GetAttribute(name)
	if type(v) == "number" and v == v then return v end
	return default or 0
end

local function attrStr(player, name, default)
	local v = player:GetAttribute(name)
	if type(v) == "string" then return v end
	return default
end

local function getFaction(player)
	return attrStr(player, "Faction", "None")
end

local function getClass(player)
	local c = attrStr(player, "Class", "Warrior")
	if Config.Classes[c] then return c end
	return "Warrior"
end

-- A9-1: every faction colour (Neutral teal included) comes from Config, never a local constant
local function factionColor(f)
	local def = Config.Factions[f] or Config.Factions.None
	return (def and def.Color) or Color3.new(1, 1, 1)
end

local function charScale(character)
	local ok, sc = pcall(character.GetScale, character)
	if ok and type(sc) == "number" and sc > 0 then return sc end
	return 1
end

local function getRoot(character)
	local r = character:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then return r end
	return nil
end

local function clearChild(parent, name)
	if not parent then return end
	local old = parent:FindFirstChild(name)
	while old do
		old:Destroy()
		old = parent:FindFirstChild(name)
	end
end

local function esc(s)
	s = tostring(s)
	s = string.gsub(s, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	s = string.gsub(s, "\"", "&quot;")
	s = string.gsub(s, "'", "&apos;")
	return s
end

-- accessory part: unanchored, massless, no collision / query / touch
local function accPart(props)
	local p = Instance.new(props.ClassName or "Part")
	if props.Shape then p.Shape = props.Shape end
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "ClassName" and k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	return p
end

-- parents the piece model to the character, then welds every part to `base` at its current offset
local function mount(model, parts, character, base)
	for _, p in parts do
		p.Parent = model
	end
	model.Parent = character
	for _, p in parts do
		Util.Weld(base, p)
	end
end

local function newPiece(name)
	local m = Instance.new("Model")
	m.Name = name
	return m
end

local function addLight(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

local function sparkle(parent, color, rate, size)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(0.6, 1.0)
	pe.Speed = NumberRange.new(0.5, 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.LightEmission = 0.8
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = parent
	return pe
end

------------------------------------------------------------------ Nametag
local function makeLine(name, order, height, maxSize, color)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.LayoutOrder = order
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 0, height)
	l.Font = Enum.Font.GothamBold
	l.RichText = true
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.35
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.Text = ""
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize
	c.MinTextSize = MIN_TEXT_SIZE
	c.Parent = l
	return l
end

local function nametagOffset(player)
	return Vector3.new(0, 2.6 * attrNum(player, "VisualScale", 1), 0)
end

local function createNametag(player)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Nametag"
	bb.Size = UDim2.fromOffset(240, 80)
	bb.StudsOffset = nametagOffset(player)
	bb.MaxDistance = V.NametagMaxDistance
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = bb

	makeLine("Line1", 1, 30, 22, Color3.new(1, 1, 1)).Parent = bb
	makeLine("Line2", 2, 24, 17, LINE2_COLOR).Parent = bb
	makeLine("Line3", 3, 24, 17, LINE3_COLOR).Parent = bb
	return bb
end

local function updateNametag(player, bb)
	local f = getFaction(player)
	local classId = getClass(player)
	local level = math.floor(attrNum(player, "Level", 1))
	local rebirths = math.floor(attrNum(player, "Rebirths", 0))

	local title = Config.DisplayTitle(
		f,
		attrNum(player, "Honor", 0),
		attrNum(player, "Infamy", 0),
		attrNum(player, "FallMarks", 0),
		attrNum(player, "RedeemMarks", 0),
		attrStr(player, "SessionTitle", "")
	)
	local line1 = "[" .. tostring(title) .. "] " .. Util.PlayerDisplayName(player)
	if f == NEUTRAL_ID then
		line1 = NEUTRAL_EMBLEM .. " " .. line1
	end

	local line2 = "Lv " .. level .. " · " .. Config.ClassName(classId, f)
	if rebirths > 0 then
		line2 ..= "  환생 " .. rebirths
	end
	if player:GetAttribute("Rookie") == true and f ~= NEUTRAL_ID then
		line2 ..= "  새싹 보호"
	end

	local bits = {}
	local bully = math.floor(attrNum(player, "BullyStacks", 0))
	if bully > 0 then
		table.insert(bits, bully > 1 and ("깡패 ×" .. bully) or "깡패")
	end
	local bounty = attrNum(player, "Bounty", 0)
	if bounty > 0 then
		local stars = math.clamp(math.floor(attrNum(player, "WantedStars", 0)), 0, Config.PvP.MaxStars)
		local starText = string.rep("★", stars)
		local b = "현상금 " .. Util.FormatNumber(bounty)
		table.insert(bits, starText ~= "" and (starText .. " " .. b) or b)
	end
	local line3 = table.concat(bits, "  ")

	local l1 = bb:FindFirstChild("Line1")
	local l2 = bb:FindFirstChild("Line2")
	local l3 = bb:FindFirstChild("Line3")
	if l1 then
		l1.Text = esc(line1)
		l1.TextColor3 = factionColor(f)
	end
	if l2 then
		l2.Text = esc(line2)
	end
	if l3 then
		l3.Text = esc(line3)
		l3.Visible = line3 ~= ""
	end
	bb.StudsOffset = nametagOffset(player)
end

local function buildNametag(player, character, force)
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local bb = head:FindFirstChild("Nametag")
	if force or not (bb and bb:IsA("BillboardGui")) then
		clearChild(head, "Nametag")
		bb = createNametag(player)
		bb.Parent = head
	end
	updateNametag(player, bb)
end

local function updateNametagOffset(player, character)
	local head = Util.FindPart(character, "Head")
	local bb = head and head:FindFirstChild("Nametag")
	if bb and bb:IsA("BillboardGui") then
		bb.StudsOffset = nametagOffset(player)
	end
end

------------------------------------------------------------------ FactionMark (halo disc / horns / neutral gear)
-- A9-1 Neutral: a teal Neon gear 1.6 studs above the head = one thin Cylinder + two crossed Blocks (3 parts), fixed
-- size (does not grow with rank). It stands upright (faces front/back), so at a distance it reads differently from
-- the flat Halo disc, the Horns wedges and the bare None head.
local function buildNeutralGear(head, sc)
	local color = factionColor(NEUTRAL_ID)
	local base = head.CFrame * CFrame.new(0, 1.6 * sc, 0)
	local parts = {
		accPart({
			Name = "GearDisc",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.18, 1.1, 1.1) * sc,
			Material = Enum.Material.Neon,
			Color = color,
			CFrame = base * CFrame.Angles(0, math.pi / 2, 0), -- cylinder axis along the head's look direction
		}),
	}
	for k = 0, 1 do
		table.insert(parts, accPart({
			Name = "GearTeeth" .. (k + 1),
			Size = Vector3.new(1.5, 0.34, 0.14) * sc, -- sticks 0.2 out of the disc rim on both ends = 4 teeth
			Material = Enum.Material.Neon,
			Color = color,
			CFrame = base * CFrame.Angles(0, 0, math.rad(45 + 90 * k)),
		}))
	end
	return parts
end

local function buildFactionMark(player, character)
	clearChild(character, "FactionMark")
	local f = getFaction(player)
	if f ~= "Halo" and f ~= "Horns" and f ~= NEUTRAL_ID then return end -- None: nothing
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local sc = charScale(character)
	if f == NEUTRAL_ID then
		mount(newPiece("FactionMark"), buildNeutralGear(head, sc), character, head)
		return
	end
	local _, rank = Config.GetTitle(f, attrNum(player, "Honor", 0), attrNum(player, "Infamy", 0))
	local scale = 1 + V.MarkScalePerRank * (math.max(1, rank or 1) - 1)

	local model = newPiece("FactionMark")
	local parts = {}
	if f == "Halo" then
		local disc = accPart({
			Name = "HaloDisc",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 2.2 * scale, 2.2 * scale) * sc,
			Material = Enum.Material.Neon,
			Color = Config.Factions.Halo.Color,
			CFrame = head.CFrame * CFrame.new(0, 1.6 * sc, 0) * CFrame.Angles(0, 0, math.pi / 2), -- lying flat
		})
		addLight(disc, Config.Factions.Halo.Color, 8 * sc, 1.2)
		table.insert(parts, disc)
	else
		local h = 1.0 * scale * sc
		for side = -1, 1, 2 do
			local horn = accPart({
				ClassName = "WedgePart",
				Name = side < 0 and "HornL" or "HornR",
				Size = Vector3.new(0.4, 1.0 * scale, 0.6 * scale) * sc,
				Material = Enum.Material.Neon,
				Color = Config.Factions.Horns.Color,
				CFrame = head.CFrame
					* CFrame.new(side * head.Size.X * 0.32, head.Size.Y / 2 + h * 0.4, 0)
					* CFrame.Angles(0, 0, -side * math.rad(25)), -- tilted outward
			})
			table.insert(parts, horn)
		end
	end
	mount(model, parts, character, head)
end

------------------------------------------------------------------ WeaponModel
local function gripCFrame(hand, left)
	local att = hand:FindFirstChild(left and "LeftGripAttachment" or "RightGripAttachment")
	local pos
	if att and att:IsA("Attachment") then
		pos = att.WorldPosition
	else
		pos = (hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, 0)).Position
	end
	local rotation = hand.CFrame.Rotation
	-- Imported costume geometry can carry a verified axis bake (pilot Y180). Its wrist attachment
	-- restores the original bone frame; using the mesh's raw rotation turns the held weapon around.
	-- Personal avatar grips retain their existing frame.
	if hand:GetAttribute("HHC_SourcePart") == hand.Name then
		local wrist = hand:FindFirstChild(left and "LeftWristRigAttachment" or "RightWristRigAttachment")
		if wrist and wrist:IsA("Attachment") then rotation *= wrist.CFrame.Rotation end
	end
	return CFrame.new(pos) * rotation
end

local function buildSword(grip, sc, w, color)
	local L = grip * CFrame.Angles(-math.pi / 2, 0, 0) -- +Y of L points forward
	local handleLen = 1.2
	local handle = accPart({
		Name = "Handle", Size = Vector3.new(0.3, handleLen, 0.3) * sc,
		Material = Enum.Material.Wood, Color = WOOD_COLOR, CFrame = L,
	})
	local guard = accPart({
		Name = "Guard", Size = Vector3.new(1.2, 0.25, 0.4) * sc,
		Material = Enum.Material.Metal, Color = DARK_METAL,
		CFrame = L * CFrame.new(0, (handleLen / 2 + 0.125) * sc, 0),
	})
	local blade = accPart({
		Name = "Blade", Size = Vector3.new(0.25, w.Length, 0.6) * sc,
		Material = w.Material, Color = color,
		CFrame = L * CFrame.new(0, (handleLen / 2 + 0.25 + w.Length / 2) * sc, 0),
	})
	return { handle, guard, blade }, blade
end

local function buildStaff(grip, sc, w, color, tier)
	local shaftLen = w.Length + 1.5
	local base = grip -- the shaft centreline must pass through the actual hand grip
	local shaft = accPart({
		Name = "Shaft", Size = Vector3.new(0.3, shaftLen, 0.3) * sc,
		Material = Enum.Material.Wood, Color = WOOD_COLOR,
		CFrame = base * CFrame.new(0, (shaftLen / 2 - 1.0) * sc, 0),
	})
	local collar = accPart({
		Name = "Collar", Size = Vector3.new(0.45, 0.3, 0.45) * sc,
		Material = w.Material, Color = color,
		CFrame = base * CFrame.new(0, (shaftLen - 1.05) * sc, 0),
	})
	local d = 0.7 + 0.1 * tier
	local tip = accPart({
		Name = "Tip", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d) * sc,
		Material = Enum.Material.Neon, Color = color,
		CFrame = base * CFrame.new(0, (shaftLen - 1.0 + d * 0.35) * sc, 0),
	})
	addLight(tip, color, 8 * sc, 1.5)
	return { shaft, collar, tip }, tip
end

local function buildBow(grip, sc, w, color)
	local H = w.Length
	local half = math.rad(50)
	local R = H / (2 * math.sin(half))
	local sag = R * (1 - math.cos(half))
	-- The centre/grip stays in the hand at every tier; lifting a long bow moved its arrow rest
	-- above the grip, so no arm pose could align the string hand, face and launch axis together.
	local base = grip * CFrame.new(0, 0, -0.1 * sc)
	local segLen = math.max(0.9, 2 * R * math.sin(math.rad(10)) * 1.08)
	local parts = {}
	local main
	for k = 1, 5 do
		local phi = -half + (k - 0.5) * (2 * half / 5)
		local local3 = Vector3.new(0, R * math.sin(phi), -(R * math.cos(phi) - R * math.cos(half)) + sag)
		local seg = accPart({
			Name = "Arc" .. k, Size = Vector3.new(0.2, segLen, 0.2) * sc,
			Material = w.Material, Color = color,
			CFrame = base * CFrame.new(local3 * sc) * CFrame.Angles(phi, 0, 0),
		})
		table.insert(parts, seg)
		if k == 3 then main = seg end
	end
	local string_ = accPart({
		Name = "String", Size = Vector3.new(0.05, H, 0.05) * sc,
		Color = Color3.new(1, 1, 1),
		Transparency = 1, -- two strings share a movable nock for the right-hand draw
		CFrame = base * CFrame.new(0, 0, sag * sc),
	})
	table.insert(parts, string_)
	for _, spec in { { "BowTop", H / 2 }, { "BowBottom", -H / 2 }, { "BowNock", 0 } } do
		local att = Instance.new("Attachment")
		att.Name = spec[1]
		att.Position = Vector3.new(0, spec[2] * sc, 0)
		att.Parent = string_
	end
	for _, name in { "BowTop", "BowBottom" } do
		local beam = Instance.new("Beam")
		beam.Name = name .. "String"
		beam.Attachment0 = string_:FindFirstChild(name)
		beam.Attachment1 = string_:FindFirstChild("BowNock")
		beam.Width0 = 0.05 * sc
		beam.Width1 = 0.05 * sc
		beam.Color = ColorSequence.new(string_.Color)
		beam.FaceCamera = true
		beam.Parent = string_
	end
	return parts, main
end

local function buildWeapon(player, character)
	clearChild(character, "WeaponModel")
	local classId = getClass(player)
	local classDef = Config.Classes[classId] or Config.Classes.Warrior
	local left = classDef.Weapon == "Bow"
	local hand = left and Util.FindPart(character, "LeftHand", "Left Arm")
		or (not left and Util.FindPart(character, "RightHand", "Right Arm"))
	if not hand then return end
	local sc = charScale(character)
	local tier = math.clamp(math.floor(attrNum(player, "WeaponTier", 1)), 1, Config.MaxWeaponTier)
	local w = Config.Weapons[tier]
	local f = getFaction(player)
	local color = Config.WeaponColor(tier, f)
	local grip = gripCFrame(hand, left)

	local parts, main
	if classDef.Weapon == "Staff" then
		parts, main = buildStaff(grip, sc, w, color, tier)
	elseif classDef.Weapon == "Bow" then
		parts, main = buildBow(grip, sc, w, color)
	else
		parts, main = buildSword(grip, sc, w, color)
	end

	if tier >= 6 and main then
		local existing = main:FindFirstChildOfClass("PointLight")
		if existing then
			existing.Brightness = 2.5
			existing.Range = 12 * sc
		else
			addLight(main, color, 10 * sc, 2)
		end
	end
	if tier >= 7 and main then
		sparkle(main, color, 12, 0.35 * sc)
	end

	local model = newPiece("WeaponModel")
	model:SetAttribute("Class", classId)
	model:SetAttribute("GripHand", hand.Name)
	if main then
		local muzzle = Instance.new("Attachment")
		muzzle.Name = "AttackMuzzle"
		if classDef.Weapon == "Bow" then
			muzzle.Position = Vector3.new(0, 0, -0.18 * sc)
		elseif classDef.Weapon == "Staff" then
			muzzle.Position = Vector3.new(0, main.Size.Y * 0.5, 0)
		else
			muzzle.Position = Vector3.new(0, main.Size.Y * 0.5, 0)
		end
		muzzle.Parent = main
		-- Server-built attachment offsets survive both joint types and avoid reading a one-frame-old
		-- hand/weapon pair while their Transform batch is still waiting for the physics step.
		model:SetAttribute("HandMuzzle", hand.CFrame:ToObjectSpace(main.CFrame * muzzle.CFrame))
		if classDef.Weapon == "Bow" then
			for _, part in parts do
				local nock = part:FindFirstChild("BowNock")
				if nock then model:SetAttribute("HandBowRest", hand.CFrame:ToObjectSpace(part.CFrame * nock.CFrame)) end
			end
		end
	end
	mount(model, parts, character, hand)
end

------------------------------------------------------------------ sacks & ghost
local function sackSize(tier)
	local sizes = V.SackSizes
	return sizes[math.clamp(tier, 1, #sizes)]
end

local function buildGoldSack(player, character, force)
	local tier = Config.SackTier(attrNum(player, "CarriedGold", 0), attrNum(player, "Level", 1))
	local existing = character:FindFirstChild("GoldSack")
	if not force then
		if existing and builtTier[existing] == tier then return end
		if not existing and tier <= 0 then return end
	end
	clearChild(character, "GoldSack")
	if tier <= 0 then return end
	local torso = Util.FindPart(character, "UpperTorso", "Torso")
	if not torso then return end
	local sc = charScale(character)
	local d = sackSize(tier) * sc
	local ball = accPart({
		Name = "Sack", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d),
		Material = Enum.Material.Fabric, Color = SACK_COLOR,
		CFrame = torso.CFrame * CFrame.new(0, 0.15 * sc, torso.Size.Z / 2 + d * 0.42),
	})
	local k = d * 0.35
	local knot = accPart({
		Name = "Knot", Shape = Enum.PartType.Ball, Size = Vector3.new(k, k, k),
		Material = Enum.Material.Fabric, Color = SACK_KNOT_COLOR,
		CFrame = ball.CFrame * CFrame.new(0, d * 0.48, 0),
	})
	if tier >= 4 then
		sparkle(ball, GOLD_SPARK, 6, 0.3 * sc)
	end
	local model = newPiece("GoldSack")
	mount(model, { ball, knot }, character, torso)
	builtTier[model] = tier
end

local function buildGrudgeSack(player, character, force)
	local sackGold = attrNum(player, "SackGold", 0)
	local tier = 0
	if sackGold > 0 then
		tier = math.max(1, Config.SackTier(sackGold, attrNum(player, "Level", 1)))
	end
	local existing = character:FindFirstChild("GrudgeSack")
	if not force then
		if existing and builtTier[existing] == tier then return end
		if not existing and tier <= 0 then return end
	end
	clearChild(character, "GrudgeSack")
	if tier <= 0 then return end
	local torso = Util.FindPart(character, "UpperTorso", "Torso")
	if not torso then return end
	local sc = charScale(character)
	local d = sackSize(tier) * sc
	local ball = accPart({
		Name = "Sack", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d),
		Material = Enum.Material.Fabric, Color = V.GrudgeSackColor,
		CFrame = torso.CFrame * CFrame.new(0, -(0.6 * sc + d * 0.3), torso.Size.Z / 2 + d * 0.42),
	})
	sparkle(ball, V.GrudgeSackColor:Lerp(Color3.new(1, 1, 1), 0.25), 8, 0.35 * sc)
	local model = newPiece("GrudgeSack")
	mount(model, { ball }, character, torso)
	builtTier[model] = tier
end

local function buildGrudgeGhost(player, character)
	clearChild(character, "GrudgeGhost")
	if attrNum(player, "SackGold", 0) <= 0 then return end
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local sc = charScale(character)
	local base = head.CFrame * CFrame.new(0, V.GhostHeight * sc, 0)
	local body = accPart({
		Name = "GhostBody", Size = Vector3.new(1.6, 2, 0.8) * sc,
		Material = Enum.Material.Neon, Color = V.GhostColor, Transparency = V.GhostTransparency,
		CFrame = base,
	})
	local ghostHead = accPart({
		Name = "GhostHead", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2) * sc,
		Material = Enum.Material.Neon, Color = V.GhostColor, Transparency = V.GhostTransparency,
		CFrame = base * CFrame.new(0, 1.6 * sc, 0),
	})

	local victim = attrStr(player, "SackVictimName", "")
	if victim == "" then victim = "누군가" end
	local bb = Instance.new("BillboardGui")
	bb.Name = "GhostLabel"
	bb.Size = UDim2.fromOffset(200, 28)
	bb.StudsOffset = Vector3.new(0, 1.3 * sc, 0)
	bb.MaxDistance = V.NametagMaxDistance
	bb.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = GHOST_TEXT
	label.TextStrokeTransparency = 0.3
	label.Text = victim .. "의 원한"
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 18
	c.MinTextSize = MIN_TEXT_SIZE
	c.Parent = label
	label.Parent = bb
	bb.Parent = ghostHead

	mount(newPiece("GrudgeGhost"), { body, ghostHead }, character, head)
end

------------------------------------------------------------------ auras & marks
local function auraEmitter(name, color, rate, lifetime, sc)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = name
	pe.Color = ColorSequence.new(color)
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(lifetime)
	pe.LightEmission = 0.6
	pe.Speed = NumberRange.new(0.5, 1.5)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, 2, 0)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 * sc), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	return pe
end

local function buildRebirthAura(player, character)
	local root = getRoot(character)
	if not root then return end
	clearChild(root, "RebirthAura")
	local rebirths = attrNum(player, "Rebirths", 0)
	if rebirths < 1 then return end
	local color, bestMin, found = nil, -math.huge, false
	for _, a in Config.Rebirth.Auras do
		if rebirths >= a.Min and a.Min >= bestMin then
			bestMin = a.Min
			color = a.Color
			found = true
		end
	end
	if not found then return end
	if color == nil then color = factionColor(getFaction(player)) end
	auraEmitter("RebirthAura", color, 6, 1.2, charScale(character)).Parent = root
end

local function buildMarkCape(player, character)
	clearChild(character, "MarkCape")
	if attrNum(player, "FallMarks", 0) < 1 then return end
	local torso = Util.FindPart(character, "UpperTorso", "Torso")
	if not torso then return end
	local sc = charScale(character)
	local top = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 - 0.1 * sc, torso.Size.Z / 2 + 0.08 * sc)
	local lengths = { 2.4, 1.8, 2.7 }
	local xs = { -0.6, 0, 0.6 }
	local parts = {}
	for i = 1, 3 do
		local len = lengths[i] * sc
		local cf = top
			* CFrame.new(xs[i] * sc, 0, 0)
			* CFrame.Angles(-math.rad(6 + i * 2), 0, math.rad((i - 2) * 4))
			* CFrame.new(0, -len / 2, 0)
		table.insert(parts, accPart({
			Name = "CapeStrip" .. i, Size = Vector3.new(0.62 * sc, len, 0.08 * sc),
			Material = Enum.Material.Fabric, Color = V.CapeColor, CFrame = cf,
		}))
	end
	mount(newPiece("MarkCape"), parts, character, torso)
end

local function buildMarkHalo(player, character)
	clearChild(character, "MarkHalo")
	if attrNum(player, "RedeemMarks", 0) < 1 then return end
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local sc = charScale(character)
	local base = head.CFrame * CFrame.new(0, 2.4 * sc, 0)
	local R = 1.0 * sc
	local chord = 2 * R * math.sin(math.rad(35)) -- each segment spans ~70 deg, 20 deg gaps
	local parts = {}
	for k = 0, 3 do
		local theta = math.rad(k * 90 + 45)
		local tilt = (k % 2 == 0) and math.rad(7) or -math.rad(5) -- cracked look
		local cf = base * CFrame.Angles(0, -theta, 0) * CFrame.new(R, 0, 0) * CFrame.Angles(tilt, 0, 0)
		table.insert(parts, accPart({
			Name = "HaloShard" .. (k + 1), Size = Vector3.new(0.22 * sc, 0.14 * sc, chord),
			Material = Enum.Material.Neon, Color = V.CrackedHaloColor, CFrame = cf,
		}))
	end
	mount(newPiece("MarkHalo"), parts, character, head)
end

local function buildGrayAura(player, character)
	local root = getRoot(character)
	if not root then return end
	clearChild(root, "GrayAura")
	local minMarks = Config.Rebirth.GrayLegendMin
	if attrNum(player, "FallMarks", 0) >= minMarks and attrNum(player, "RedeemMarks", 0) >= minMarks then
		auraEmitter("GrayAura", V.GrayAuraColor, 8, 1.5, charScale(character)).Parent = root
	end
end

------------------------------------------------------------------ wanted glow & kaiju fire
local function buildWantedGlow(player, character)
	clearChild(character, "WantedGlow")
	local glow = attrNum(player, "WantedStars", 0) >= Config.PvP.GlowStars
		or attrStr(player, "KaijuState", "None") == "Active"
	if not glow then return end
	local h = Instance.new("Highlight")
	h.Name = "WantedGlow"
	h.FillColor = GLOW_FILL
	h.FillTransparency = 0.6
	h.OutlineColor = GLOW_OUTLINE
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = character
end

local function buildKaijuFire(player, character)
	local root = getRoot(character)
	if not root then return end
	clearChild(root, "KaijuFire")
	if attrStr(player, "KaijuState", "None") ~= "Active" then return end
	local sc = charScale(character)
	local att = Instance.new("Attachment")
	att.Name = "KaijuFire"
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Fire"
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 200, 70)),
		ColorSequenceKeypoint.new(0.4, V.KaijuFireColor),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 20, 10)),
	})
	pe.Rate = 30
	pe.Lifetime = NumberRange.new(0.5, 1.0)
	pe.Speed = NumberRange.new(3, 6)
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Acceleration = Vector3.new(0, 8, 0)
	pe.LightEmission = 0.9
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.0 * sc), NumberSequenceKeypoint.new(1, 0.3 * sc) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = att
	addLight(att, KAIJU_LIGHT, 18 * sc, 3)
	att.Parent = root
end

------------------------------------------------------------------ dispatch
local BUILDERS = {
	Nametag = buildNametag,
	FactionMark = buildFactionMark,
	WeaponModel = buildWeapon,
	GoldSack = buildGoldSack,
	GrudgeSack = buildGrudgeSack,
	GrudgeGhost = buildGrudgeGhost,
	RebirthAura = buildRebirthAura,
	MarkCape = buildMarkCape,
	MarkHalo = buildMarkHalo,
	GrayAura = buildGrayAura,
	WantedGlow = buildWantedGlow,
	KaijuFire = buildKaijuFire,
}

local function buildPiece(player, character, piece, force)
	local fn = BUILDERS[piece]
	if not fn then return end
	local ok, err = pcall(fn, player, character, force)
	if not ok then
		warnThrottled(piece, piece .. " build failed for " .. player.Name .. ": " .. tostring(err))
	end
end

local function refreshAll(player)
	local character = Util.GetCharacter(player)
	if not character then return end
	for _, piece in PIECE_ORDER do
		buildPiece(player, character, piece, true)
	end
end

local function ensureState(player)
	local st = states[player]
	if not st then
		st = { Conns = {}, CharConns = {}, Dirty = {}, Queued = false, RefreshQueued = false }
		states[player] = st
	end
	return st
end

local function flush(player)
	local st = states[player]
	if not st then return end
	st.Queued = false
	local dirty = st.Dirty
	st.Dirty = {}
	if player.Parent == nil then return end
	local character = Util.GetCharacter(player)
	if not character then return end
	for _, piece in PIECE_ORDER do
		if dirty[piece] then
			buildPiece(player, character, piece, false)
		end
	end
	if dirty.NametagOffset and not dirty.Nametag then
		local ok, err = pcall(updateNametagOffset, player, character)
		if not ok then warnThrottled("NametagOffset", err) end
	end
end

local function markDirty(player, pieces)
	local st = states[player]
	if not st then return end
	for _, piece in pieces do
		st.Dirty[piece] = true
	end
	if not st.Queued then
		st.Queued = true
		task.defer(flush, player)
	end
end

-- debounced full rebuild (body parts swapped by appearance loading etc.)
local function requestRefresh(player)
	local st = states[player]
	if not st or st.RefreshQueued then return end
	st.RefreshQueued = true
	task.delay(REFRESH_DEBOUNCE, function()
		local cur = states[player]
		if not cur then return end
		cur.RefreshQueued = false
		if player.Parent then refreshAll(player) end
	end)
end

local function disconnectAll(list)
	for _, c in list do
		c:Disconnect()
	end
	table.clear(list)
end

local function onPlayerReady(player)
	local st = ensureState(player)
	disconnectAll(st.Conns)
	for attrName, pieces in WATCH do
		table.insert(st.Conns, player:GetAttributeChangedSignal(attrName):Connect(function()
			markDirty(player, pieces)
		end))
	end
	table.insert(st.Conns, player.CharacterAppearanceLoaded:Connect(function()
		requestRefresh(player)
	end))
end

local function onCharacterSpawned(player, character)
	if not player or player.Parent == nil or not character then return end
	local st = ensureState(player)
	disconnectAll(st.CharConns)
	table.insert(st.CharConns, character.ChildAdded:Connect(function(child)
		if child:IsA("BasePart") and BODY_PARTS[child.Name] then
			requestRefresh(player)
		end
	end))
	refreshAll(player)
end

local function onPlayerLeaving(player)
	local st = states[player]
	if not st then return end
	states[player] = nil
	disconnectAll(st.Conns)
	disconnectAll(st.CharConns)
end

------------------------------------------------------------------ public
function CharacterVisuals.Refresh(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then return end
	refreshAll(player)
end

function CharacterVisuals.Init(registry)
	S = registry
	local PS = S.PlayerService
	if PS then
		PS.PlayerReady:Connect(function(player)
			onPlayerReady(player)
		end)
		PS.CharacterSpawned:Connect(function(player, character)
			onCharacterSpawned(player, character)
		end)
		PS.PlayerLeaving:Connect(function(player)
			onPlayerLeaving(player)
		end)
	else
		Util.Warn(TAG, "PlayerService missing; visuals disabled")
	end
	Players.PlayerRemoving:Connect(onPlayerLeaving)
end

function CharacterVisuals.Start()
	print("[CharacterVisuals] started")
end

return CharacterVisuals
]]></ProtectedString>
				<string name="ScriptGuid">{30B15C97-EFEE-4DA9-ABB5-A63F46535CBA}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">CharacterVisuals</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">718623eb9e7784d40ad29b0d000008cd</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXEA2549EA59394762B4A1D03BD20ED1A5">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CostumeService.luau: server-owned 18-way appearance selection and actual animated R15 character rigs.
-- Static imported GLBs are never treated as playable rigs. Missing/invalid rigs keep the owner's Roblox avatar.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local CostumeService = {}
local S = nil
local states = {}
local TAG = "CostumeService"
local ATTR = { Costume = "HHC_CostumeId", Original = "HHC_OriginalRestore" }
local FACTIONS = { Halo = true, Horns = true, Neutral = true }
local CLASSES = { Warrior = true, Mage = true, Archer = true }
local BODY = {
	"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso",
	"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}
local EDGES = {
	{ "HumanoidRootPart", "LowerTorso" }, { "LowerTorso", "UpperTorso" }, { "UpperTorso", "Head" },
	{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local function setStatus(player, status)
	if player.Parent ~= Players then return end
	player:SetAttribute("CostumeStatus", status)
	local character = player.Character
	player:SetAttribute("CostumeApplied", character ~= nil and character:GetAttribute(ATTR.Costume) ~= nil)
end

local function ensureState(player)
	local st = states[player]
	if not st then
		st = { Pending = false, Busy = false, Version = 0, Animations = {}, Conns = {} }
		states[player] = st
	end
	return st
end

local function desiredId(player)
	local d = S.PlayerService.GetData(player)
	if not d or d.CostumeEnabled == false or d.ClassChosen ~= true then return nil end
	if not FACTIONS[d.Faction] or not CLASSES[d.Class] then return nil end
	local gender = d.CharacterGender == "F" and "F" or "M"
	local prefix = (Config.Costumes and Config.Costumes.TemplatePrefix) or "Costume_"
	return prefix .. d.Faction .. d.Class .. gender
end

-- Complete R15 graph, not a torso with a welded decorative statue. Standard Animate needs all 15 body joints.
function CostumeService.ValidateTemplate(template)
	if typeof(template) ~= "Instance" or not template:IsA("Model") then return false, "MissingTemplate" end
	local humanoid = template:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 or humanoid.Health <= 0 then return false, "InvalidRig" end
	local parts = {}
	for _, name in BODY do
		local part = template:FindFirstChild(name)
		if not part or not part:IsA("BasePart") then return false, "InvalidRig" end
		parts[name] = part
	end
	local joints = {}
	for _, child in template:GetDescendants() do
		if child:IsA("Motor6D") then table.insert(joints, child) end
	end
	for _, edge in EDGES do
		local found = false
		for _, joint in joints do
			if joint.Enabled and joint.Part0 == parts[edge[1]] and joint.Part1 == parts[edge[2]] then found = true; break end
		end
		if not found then return false, "InvalidRig" end
	end
	return true
end

local function getTemplate(id)
	local folderName = (Config.Costumes and Config.Costumes.TemplateFolder) or "CostumeRigs"
	local folder = ServerStorage:FindFirstChild(folderName)
	local template = folder and folder:FindFirstChild(id)
	local valid, why = CostumeService.ValidateTemplate(template)
	return valid and template or nil, why
end

local function clone(instance)
	local ok, result = pcall(instance.Clone, instance)
	return ok and result or nil
end

local function prepareCharacter(player, character)
	local st = states[player]
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not st or not humanoid or not root or not root:IsA("BasePart") then return false end
	local source = st.Animations[humanoid.RigType]
	if not source or not source:IsA("LocalScript") then
		-- Populate this server-owned folder only with verified Roblox controllers from a default R15/R6 dummy.
		-- A cached R6 owner's Animate cannot animate an R15 costume; use the known R15 controller instead.
		local controllers = ServerStorage:FindFirstChild("CostumeAnimationControllers")
		source = controllers and controllers:FindFirstChild(humanoid.RigType.Name)
		-- The installer marks a verified, complete default controller. A manually supplied Starter Animate
		-- has no proven rig type and must not silently override the known R15 controller.
		local hash = source and source:GetAttribute("CaptureSourceSHA256")
		if not source or source:GetAttribute("CaptureRigType") ~= humanoid.RigType.Name
			or source:GetAttribute("CaptureOrigin") ~= "RobloxDefaultCharacter"
			or type(hash) ~= "string" or #hash ~= 64 or not string.match(hash, "^[0-9a-fA-F]+$") then
			source = nil
		end
	end
	if not source or not source:IsA("LocalScript") then return false end
	local animate = clone(source)
	if not animate then return false end
	-- Template scripts (even a LocalScript named Animate and everything below it) carry no trust marker.
	-- Remove all of them before installing the known game-owned controller and StarterCharacterScripts.
	for _, child in character:GetDescendants() do
		if child:IsA("LuaSourceContainer") then
			child:Destroy()
		elseif child:IsA("BasePart") then
			child.Anchored = false
		end
	end
	local oldAnimate = character:FindFirstChild("Animate")
	if oldAnimate then oldAnimate:Destroy() end
	animate.Name = "Animate"
	animate.Parent = character
	for _, source in StarterPlayer.StarterCharacterScripts:GetChildren() do
		if not character:FindFirstChild(source.Name) then
			local copied = clone(source)
			if copied then copied.Parent = character end
		end
	end
	if not humanoid:FindFirstChildOfClass("Animator") then
		local animator = Instance.new("Animator")
		animator.Parent = humanoid -- server creation allows animation replication to all players
	end
	-- Custom Motor6D costumes use the verified template's non-colliding root. An engine-created
	-- owner avatar may use an AnimationConstraint/controller collision profile with a colliding
	-- root. Keep that native profile intact; the remaining OFF lifecycle issue is validated separately.
	-- Preserve every native body/accessory collision and joint setting when costume is OFF.
	if character:GetAttribute(ATTR.Costume) then root.CanCollide = false end
	humanoid.PlatformStand = false
	character.PrimaryPart = root
	animate.Disabled = false
	return true
end

local function captureOriginal(player, character)
	if player.Parent ~= Players or player.Character ~= character or character:GetAttribute(ATTR.Costume) then return end
	local st = states[player]
	if not st then return end
	-- CharacterAdded precedes appearance loading; snapshot only the fully dressed owner avatar.
	if not character:GetAttribute(ATTR.Original) then
		local ok, loaded = pcall(player.HasAppearanceLoaded, player)
		if not ok or not loaded then return end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animate = character:FindFirstChild("Animate") or character:WaitForChild("Animate", 5)
	if states[player] ~= st or player.Character ~= character or not humanoid then return end
	if animate and animate:IsA("LocalScript") then
		local copied = clone(animate)
		if copied then
			local previous = st.Animations[humanoid.RigType]
			st.Animations[humanoid.RigType] = copied
			if previous then previous:Destroy() end
		end
	end
	if not character:GetAttribute(ATTR.Original) then
		local ok, description = pcall(humanoid.GetAppliedDescription, humanoid)
		if ok and description then
			if st.OriginalDescription then st.OriginalDescription:Destroy() end
			st.OriginalDescription = description
			st.OriginalRigType = humanoid.RigType
		end
	end
	CostumeService.RequestRefresh(player)
end

function CostumeService.CreateSpawnCharacter(player)
	local id = desiredId(player)
	if not id then return nil end
	local st = states[player]
	-- Capture the owner's actual avatar once first, so OFF always restores their own clothes/accessories/rig type.
	if not st or not st.OriginalDescription then setStatus(player, "WaitingAppearance"); return nil end
	local template, why = getTemplate(id)
	if not template then setStatus(player, why or "MissingTemplate"); return nil end
	local character = clone(template)
	if not character then setStatus(player, "Error"); return nil end
	character:SetAttribute(ATTR.Costume, id)
	if not prepareCharacter(player, character) then
		character:Destroy()
		setStatus(player, "WaitingAnimation")
		return nil
	end
	return character
end

local function blocked(player)
	if S.PlayerService.IsSpawning(player) or not Util.IsAlive(player) then return true end
	if S.CombatService and S.CombatService.IsInCombat(player) then return true end
	if S.KaijuService and S.KaijuService.GetState(player) ~= "None" then return true end
	return false
end

local function refresh(player, st, version)
	if states[player] ~= st or not S.PlayerService.IsReady(player) then return false end
	if blocked(player) then setStatus(player, "Deferred"); return true end
	local old = player.Character
	local currentId = old:GetAttribute(ATTR.Costume)
	local id = desiredId(player)
	if id and currentId == id then setStatus(player, "Active"); return false end
	local character = id and CostumeService.CreateSpawnCharacter(player) or nil
	local status = id and "Active" or "Avatar"
	if id and not character then status = player:GetAttribute("CostumeStatus") or "MissingTemplate" end
	if not character then
		if not currentId then setStatus(player, status); return false end
		local restored = S.PlayerService.RestoreOwnerCharacter(player, st.OriginalDescription, old, function()
			return states[player] == st and st.Version == version and player.Character == old and not blocked(player)
		end)
		if states[player] ~= st then return false end
		setStatus(player, restored and status or "Error")
		return not restored and player.Character == old
	end
	-- Discard stale requests, leaving players, changed/dead characters.
	if states[player] ~= st or st.Version ~= version or player.Character ~= old or blocked(player) then
		character:Destroy()
		return states[player] == st
	end
	local installed = S.PlayerService.ReplaceCharacter(player, character, old)
	if not installed then character:Destroy(); return true end
	setStatus(player, status)
	return false
end

function CostumeService.RequestRefresh(player)
	if not S.PlayerService.IsReady(player) or player.Parent ~= Players then return end
	local st = ensureState(player)
	st.Version += 1
	st.Pending = true
end

local function onSetCostume(player, enabled, gender)
	if not S.PlayerService.IsReady(player) then return end
	if type(enabled) ~= "boolean" or (gender ~= nil and gender ~= "M" and gender ~= "F") then return end
	if not Util.RateLimit(player, "SetCostume", Config.RateLimits.SetCostume or 1) then return end
	S.PlayerService.SetStat(player, "CostumeEnabled", enabled)
	if gender ~= nil then S.PlayerService.SetStat(player, "CharacterGender", gender) end
	S.PlayerService.MarkActive(player)
	CostumeService.RequestRefresh(player)
end

local function onLeaving(player)
	local st = states[player]
	states[player] = nil
	if not st then return end
	for _, conn in st.Conns do conn:Disconnect() end
	for _, animate in st.Animations do animate:Destroy() end
	if st.OriginalDescription then st.OriginalDescription:Destroy() end
end

function CostumeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player)
		local st = ensureState(player)
		table.insert(st.Conns, player.CharacterAppearanceLoaded:Connect(function(character)
			task.defer(captureOriginal, player, character)
		end))
		setStatus(player, "Avatar")
	end)
	S.PlayerService.CharacterSpawned:Connect(function(player, character)
		if character:GetAttribute(ATTR.Costume) then
			setStatus(player, "Active")
		else
			task.defer(captureOriginal, player, character)
		end
		CostumeService.RequestRefresh(player)
	end)
	S.PlayerService.PlayerLeaving:Connect(onLeaving)
	S.ClassService.ClassChanged:Connect(CostumeService.RequestRefresh)
	S.FactionService.FactionChanged:Connect(CostumeService.RequestRefresh)
end

function CostumeService.Start()
	Net.Get("SetCostume").OnServerEvent:Connect(onSetCostume)
	local watchedControllers = {}
	local function refreshPlayers()
		for player in states do CostumeService.RequestRefresh(player) end
	end
	local function watchController(instance)
		local controllers = ServerStorage:FindFirstChild("CostumeAnimationControllers")
		if not controllers or instance.Parent ~= controllers or not instance:IsA("LocalScript")
			or (instance.Name ~= "R15" and instance.Name ~= "R6") or watchedControllers[instance] then return end
		local connections = {}
		watchedControllers[instance] = connections
		for _, attribute in { "CaptureSourceSHA256", "CaptureRigType", "CaptureOrigin" } do
			table.insert(connections, instance:GetAttributeChangedSignal(attribute):Connect(refreshPlayers))
		end
		table.insert(connections, instance.Destroying:Connect(function()
			for _, connection in connections do connection:Disconnect() end
			watchedControllers[instance] = nil
		end))
	end
	local controllers = ServerStorage:FindFirstChild("CostumeAnimationControllers")
	if controllers then
		for _, instance in controllers:GetChildren() do watchController(instance) end
	end
	ServerStorage.DescendantAdded:Connect(function(instance)
		local folderName = (Config.Costumes and Config.Costumes.TemplateFolder) or "CostumeRigs"
		local folder = ServerStorage:FindFirstChild(folderName)
		local animationFolder = ServerStorage:FindFirstChild("CostumeAnimationControllers")
		if animationFolder and (instance == animationFolder or instance:IsDescendantOf(animationFolder)) then
			watchController(instance)
			refreshPlayers()
		elseif folder and (instance == folder or instance:IsDescendantOf(folder)) then
			refreshPlayers()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, st in states do
				if st.Pending and not st.Busy then
					st.Pending, st.Busy = false, true
					local version = st.Version
					task.spawn(function()
						local ok, retry = pcall(refresh, player, st, version)
						if states[player] ~= st then return end
						st.Busy = false
						if ok then
							if retry then st.Pending = true end
						else
							setStatus(player, "Error")
							Util.Warn(TAG, "appearance refresh failed: " .. tostring(retry))
						end
					end)
				end
			end
		end
	end)
	print("[CostumeService] started")
end

return CostumeService
]]></ProtectedString>
				<string name="ScriptGuid">{1767AAD5-37D7-48EB-BFA5-21EDC0D2D536}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">CostumeService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">718623eb9e7784d40ad29b0d000008cf</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4D3035ECABB64D9C856ED9BE113941A2">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- DataService.luau : DataStore load/save with a session lock, retries, autosave, v1 -> v2 migration and an
-- in-memory fallback for Studio sessions without API access. BindToClose is owned by PlayerService.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local TAG = "DataService"

local DataService = {}

local S = nil -- registry (unused at runtime; kept for the service pattern)

local store = nil -- GlobalDataStore, set by the probe in Start
local memoryMode = false
local probeDone = false

local cache = {} -- [Player] = live session table
local releasing = {} -- [Player] = true while Release() runs
local foreignLock = {} -- [Player] = true once another server owns the record (further saves are refused)
-- CR-M1: [userId] = { token, ... } FIFO of DataStore operations for that user; q[1] holds the slot (serializes
-- writes in request order, so a fast rejoin's Load can never jump ahead of the previous session's Release)
local slotQueue = {}
-- [Player] = GUID this session wrote into the stored record at Load (field SessionToken). A save only lands while the
-- stored token is still ours, so a delayed write of an old session can never overwrite a newer session's record.
local sessionTokens = {}

local PROBE_TIMEOUT = 30 -- seconds Load waits for the Start probe before giving up
local SLOT_TIMEOUT = 90 -- seconds a writer waits for the previous writer of the same user
local RELEASE_WAIT = 60 -- seconds a second Release() call waits for the first one

local TUTORIAL_NEW = (Config.Tutorial and Config.Tutorial.Steps and Config.Tutorial.Steps.Kill) or 0
local TUTORIAL_DONE = (Config.Tutorial and Config.Tutorial.Steps and Config.Tutorial.Steps.Done) or 99

------------------------------------------------------------------ helpers
local function keyFor(userId)
	return Config.Data.KeyPrefix .. tostring(userId)
end

-- per-user write slot: an older copy must never land after a newer one (autosave vs forced save vs release).
-- CR-M1: first come, first served. nil = the slot was not reached within SLOT_TIMEOUT (the caller fails; it never
-- writes without the slot)
local function acquireSlot(userId)
	local q = slotQueue[userId]
	if not q then
		q = {}
		slotQueue[userId] = q
	end
	local token = {}
	table.insert(q, token)
	local t0 = os.clock()
	while q[1] ~= token do
		if os.clock() - t0 >= SLOT_TIMEOUT then
			local i = table.find(q, token)
			if i then table.remove(q, i) end
			if #q == 0 and slotQueue[userId] == q then slotQueue[userId] = nil end
			return nil
		end
		task.wait(0.1)
	end
	return token
end

local function releaseSlot(userId, token)
	local q = slotQueue[userId]
	if not q then return end
	local i = table.find(q, token)
	if i then table.remove(q, i) end
	if #q == 0 and slotQueue[userId] == q then slotQueue[userId] = nil end
end

-- CR-M1: true while another Player object of this user (a fast rejoin to this server) still has a cached session
local function hasOtherSession(player)
	local userId = player.UserId
	for p in cache do
		if p ~= player and p.UserId == userId then return true end
	end
	return false
end

local function isLock(lock)
	return type(lock) == "table" and type(lock.JobId) == "string"
end

-- a lock held by ANOTHER server that is still considered alive
local function isLiveForeignLock(lock)
	if not isLock(lock) or lock.JobId == game.JobId then return false end
	local t = tonumber(lock.Time)
	if not t then return false end
	return os.time() - t < Config.Data.LockTimeout
end

-- true if the stored value holds real player data (not just nothing / a bare session lock + token)
local function hasStoredData(old)
	if type(old) ~= "table" then return false end
	for k in old do
		if k ~= "SessionLock" and k ~= "SessionToken" then return true end
	end
	return false
end

-- v1 -> v2 (idempotent)
local function migrate(d, player)
	if (tonumber(d.Version) or 1) < 2 then
		d.WeaponTier = d.WeaponTier or d.SwordTier or 1 -- v1 field SwordTier is renamed
		d.SwordTier = nil
		d.RebirthBonus = (tonumber(d.Rebirths) or 0) * Config.Rebirth.BonusNormal
		d.Class = "Warrior"
		d.ClassChosen = false -- migrated players get one free class pick (keeps their level)
		d.Quests = {} -- QuestService regenerates (DailyDay = 0 -> fresh dailies, no vacation)
		d.Version = 2
		print("[DataService] migrated v1 -> v2 for " .. player.Name)
	end
end

-- add missing keys from the defaults and repair obviously corrupted values
local function fillDefaults(d, playerName)
	for k, v in Config.Data.Defaults do
		local cur = d[k]
		if cur == nil then
			d[k] = Util.DeepCopy(v)
		elseif type(cur) ~= type(v) then
			Util.Warn(TAG, ("%s: field %s had type %s, reset to default"):format(playerName, k, type(cur)))
			d[k] = Util.DeepCopy(v)
		end
	end

	-- table default Tickets: also fill missing sub-keys
	if type(d.Tickets) ~= "table" then d.Tickets = {} end
	for _, kind in { "Class", "Faction" } do
		local n = tonumber(d.Tickets[kind])
		d.Tickets[kind] = (n and n == n and n > 0) and math.floor(n) or 0
	end

	-- receipts: array of strings, at most MaxReceiptsKept (oldest dropped)
	local receipts = {}
	if type(d.ProcessedReceipts) == "table" then
		for _, id in d.ProcessedReceipts do
			if type(id) == "string" or type(id) == "number" then table.insert(receipts, tostring(id)) end
		end
	end
	while #receipts > Config.Tickets.MaxReceiptsKept do
		table.remove(receipts, 1)
	end
	d.ProcessedReceipts = receipts

	-- ids that other services branch on
	if not Config.Factions[d.Faction] then d.Faction = "None" end
	if not Config.Classes[d.Class] then d.Class = "Warrior" end
	-- Appearance preferences are additive save fields; older records do not need a version reset.
	if d.CharacterGender ~= "M" and d.CharacterGender ~= "F" then d.CharacterGender = "M" end
	if type(d.CostumeEnabled) ~= "boolean" then d.CostumeEnabled = true end
	-- Never re-save a cached name before today's filter and global claim check. The separate directory is authoritative.
	d.Nickname = ""
	for _, key in { "HPPotionCount", "MPPotionCount" } do
		d[key] = Config.NormalizePotionCount(d[key])
	end
	d.Level = math.clamp(math.floor(tonumber(d.Level) or 1), 1, Config.Levels.MaxLevel)
	d.WeaponTier = math.clamp(math.floor(tonumber(d.WeaponTier) or 1), 1, Config.MaxWeaponTier)
end

-- One UpdateAsync write of `data` (deep-copied now). The caller holds the user's write slot.
-- `sessionToken` = the token this session wrote at Load; the write is cancelled unless the stored record still carries it.
-- Returns (ok, abortedByForeignLock).
local function writeRecord(userId, data, release, label, sessionToken)
	if not store then return false, false end
	if type(sessionToken) ~= "string" then
		Util.Warn(TAG, ("save of %s refused: no session token"):format(label))
		return false, true
	end
	local copy = Util.DeepCopy(data)
	if release then
		copy.SessionLock = nil
	else
		copy.SessionLock = { JobId = game.JobId, Time = os.time() }
	end
	copy.SessionToken = sessionToken

	local key = keyFor(userId)
	local attempts = 1 + math.max(0, Config.Data.SaveRetries)
	for attempt = 1, attempts do
		local foreign = false
		local ok, err = pcall(store.UpdateAsync, store, key, function(old)
			-- a newer session (this or another server) loaded the record after ours, or it was deleted: never
			-- overwrite it, even when that session already released its lock
			if type(old) ~= "table" or old.SessionToken ~= sessionToken then
				foreign = true
				return nil
			end
			if isLock(old.SessionLock) and old.SessionLock.JobId ~= game.JobId then
				foreign = true
				return nil -- another server owns this record: cancel the write
			end
			foreign = false
			return copy
		end)
		if ok then
			if foreign then
				Util.Warn(TAG, ("save of %s aborted: a newer session owns this data"):format(label))
				return false, true
			end
			return true, false
		end
		Util.Warn(TAG, ("save attempt %d/%d failed for %s: %s"):format(attempt, attempts, label, tostring(err)))
		if attempt < attempts then
			task.wait(2 ^ (attempt - 1)) -- 1, 2, 4 s
		end
	end
	return false, false
end

local function waitForProbe()
	local t0 = os.clock()
	while not probeDone do
		if os.clock() - t0 > PROBE_TIMEOUT then return false end
		task.wait()
	end
	return true
end

------------------------------------------------------------------ public API
function DataService.Init(registry)
	S = registry
end

function DataService.Start()
	-- DataStore probe (memory mode only ever in Studio)
	task.spawn(function()
		local okStore, result = pcall(function()
			return DataStoreService:GetDataStore(Config.Data.StoreName)
		end)
		if okStore and result then
			store = result
		end
		if RunService:IsStudio() then
			local usable = false
			if store then
				usable = pcall(function()
					store:GetAsync("__probe")
				end)
			end
			if not usable then
				memoryMode = true
				warn("[DataService] DataStore unavailable (enable Studio Access to API Services). Using in-memory data; nothing will be saved.")
			end
		elseif not store then
			Util.Warn(TAG, "GetDataStore failed: " .. tostring(result))
		end
		probeDone = true
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			if probeDone and not memoryMode then
				local list = {}
				for player in cache do
					if not releasing[player] and not foreignLock[player] and player.Parent ~= nil then
						table.insert(list, player)
					end
				end
				for _, player in list do
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)

	print("[DataService] started")
end

-- Load body; the caller holds the user's write slot. nil = failed or the player left
local function loadLocked(player)
	local userId = player.UserId
	local key = keyFor(userId)
	-- one token per Load (retries reuse it, so a committed-but-errored attempt is still recognised as ours)
	local sessionToken = HttpService:GenerateGUID(false)

	local loaded, fresh = nil, false
	local retries = math.max(1, Config.Data.LoadRetries)
	local warnedLock = false
	local tooNew, storedVersion = false, nil
	for attempt = 1, retries do
		if player.Parent == nil then
			return nil
		end
		local final = (attempt == retries) -- the final attempt steals the lock (dead-server recovery)
		local locked, captured, capturedFresh = false, nil, false
		local ok, err = pcall(store.UpdateAsync, store, key, function(old)
			tooNew = false
			-- CR-L3: a record saved by a newer data version is never rewritten (or locked) by this older server
			if type(old) == "table" and (tonumber(old.Version) or 1) > Config.Data.Version then
				tooNew, storedVersion = true, old.Version
				locked, captured = false, nil
				return nil
			end
			if not final and type(old) == "table" and isLiveForeignLock(old.SessionLock) then
				locked, captured = true, nil
				return nil -- cancel the write and retry later
			end
			locked = false
			capturedFresh = not hasStoredData(old)
			local d = (type(old) == "table") and old or {}
			d.SessionLock = { JobId = game.JobId, Time = os.time() }
			d.SessionToken = sessionToken
			captured = d
			return d
		end)
		if ok and tooNew then
			break
		end
		if ok and captured and not locked then
			loaded, fresh = captured, capturedFresh
			break
		end
		if not ok then
			Util.Warn(TAG, ("load attempt %d/%d failed for %s: %s"):format(attempt, retries, player.Name, tostring(err)))
		elseif locked and not warnedLock then
			warnedLock = true
			Util.Warn(TAG, ("data of %s is locked by another server; retrying"):format(player.Name))
		end
		if not final then
			task.wait(Config.Data.LoadRetryDelay)
		end
	end

	if tooNew then
		-- CR-L3: kicked with LoadFailed; the player rejoins a server running the newer version
		Util.Warn(TAG, ("data of %s has version %s (> %d): saved by a newer server; refusing to load"):format(
			player.Name, tostring(storedVersion), Config.Data.Version))
		return nil
	end
	if not loaded then
		return nil
	end

	local d = Util.DeepCopy(loaded)
	d.SessionLock = nil
	d.SessionToken = nil -- kept in sessionTokens, never in the session table

	-- A4 / A5-C5: onboarding step BEFORE the generic default fill
	if fresh then
		d.TutorialStep = TUTORIAL_NEW
	elseif type(d.TutorialStep) ~= "number" then
		d.TutorialStep = TUTORIAL_DONE
	end

	if not fresh then
		migrate(d, player) -- a brand-new record gets everything from the defaults below
	end
	fillDefaults(d, player.Name)
	d.Version = Config.Data.Version
	if (tonumber(d.FirstJoinTime) or 0) == 0 then
		d.FirstJoinTime = os.time()
	end

	if player.Parent == nil then
		-- left during the load: write it back unlocked; nothing is cached
		writeRecord(userId, d, true, player.Name, sessionToken)
		return nil
	end

	sessionTokens[player] = sessionToken
	cache[player] = d
	return d
end

-- yields. nil = failed (caller kicks) or the player left during the load
function DataService.Load(player)
	if cache[player] then return cache[player] end
	if not waitForProbe() then
		Util.Warn(TAG, "DataStore probe did not finish; cannot load " .. player.Name)
		return nil
	end
	if player.Parent == nil then return nil end

	if memoryMode then
		local d = Util.DeepCopy(Config.Data.Defaults)
		d.TutorialStep = TUTORIAL_NEW -- always a fresh record in memory mode (A5-C5)
		d.Version = Config.Data.Version
		d.FirstJoinTime = os.time()
		cache[player] = d
		return d
	end
	if not store then
		Util.Warn(TAG, "no DataStore available; cannot load " .. player.Name)
		return nil
	end

	local userId = player.UserId
	-- CR-M1: a previous session of this user on this server (fast rejoin) must finish its Release first; its final
	-- save may not have queued for the slot yet (PlayerLeaving handlers still running)
	local tWait = os.clock()
	while hasOtherSession(player) do
		if player.Parent == nil then return nil end
		if os.clock() - tWait >= SLOT_TIMEOUT then
			Util.Warn(TAG, "the previous session of " .. player.Name .. " is still saving; cannot load")
			return nil
		end
		task.wait(0.1)
	end
	if player.Parent == nil then return nil end

	-- holding the slot also waits for any queued save of this user (autosave retries, release) to finish first
	local token = acquireSlot(userId)
	if not token then
		Util.Warn(TAG, "a previous save of " .. player.Name .. " is still running; cannot load")
		return nil
	end
	-- the slot is always released, even if the body throws (a leaked slot would block every later load / save)
	local okBody, result = pcall(loadLocked, player)
	releaseSlot(userId, token)
	if not okBody then
		Util.Warn(TAG, "load error for " .. player.Name .. ": " .. tostring(result))
		return nil
	end
	return result
end

-- the live session table (mutable)
function DataService.Get(player)
	return cache[player]
end

-- yields; safe to call concurrently (writes of one user are serialized)
function DataService.Save(player, release)
	release = (release == true)
	if not cache[player] then return false end
	if memoryMode then return true end
	if not store or foreignLock[player] then return false end

	local userId = player.UserId
	local token = acquireSlot(userId)
	if not token then
		Util.Warn(TAG, "save of " .. player.Name .. " skipped: the previous save is still running")
		return false
	end
	local data = cache[player]
	-- re-check after waiting: the session may have been released, or a release may be in progress
	if not data or foreignLock[player] or (releasing[player] and not release) then
		releaseSlot(userId, token)
		return false
	end
	-- pcall: the slot must be released even if the write throws (CR-M1)
	local okCall, ok, foreign = pcall(writeRecord, userId, data, release, player.Name, sessionTokens[player])
	releaseSlot(userId, token)
	if not okCall then
		Util.Warn(TAG, "save error for " .. player.Name .. ": " .. tostring(ok))
		return false
	end
	if foreign then
		foreignLock[player] = true
	end
	return ok == true
end

-- yields; sets LastLogoutTime, final unlocked save, drops the cache. Idempotent.
function DataService.Release(player)
	if releasing[player] then
		local t0 = os.clock()
		while releasing[player] and os.clock() - t0 < RELEASE_WAIT do
			task.wait(0.1)
		end
		return
	end
	local data = cache[player]
	if not data then return end

	releasing[player] = true
	data.LastLogoutTime = os.time()
	local ok, result = pcall(DataService.Save, player, true)
	if not ok then
		Util.Warn(TAG, "final save error for " .. player.Name .. ": " .. tostring(result))
	elseif not result and not memoryMode then
		Util.Warn(TAG, "final save failed for " .. player.Name)
	end
	cache[player] = nil
	sessionTokens[player] = nil
	foreignLock[player] = nil
	releasing[player] = nil
end

function DataService.IsMemoryMode()
	return memoryMode
end

function DataService.IsPersistentReady()
	return probeDone and not memoryMode and store ~= nil
end

return DataService
]]></ProtectedString>
				<string name="ScriptGuid">{58B4AC5E-F944-446A-BA49-8A1E1BA4AAB1}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DataService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">718623eb9e7784d40ad29b0d000008d1</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7E1CD5AE06114DB2BE8E0CF4C6033524">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Three approved expressions: neutral at rest, serious while attacking/hurt, a soft smile during conversation.
-- Only server gameplay events choose a face. Original personal avatars are never modified.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local Assets = require(ReplicatedStorage.Shared.ExpressionAssets)
local Util = require(ReplicatedStorage.Shared.Util)

local ExpressionService = {}
local S
local states = {}
local monsters = {}
local DURATION = { Attack = 1.2, Hurt = 0.8, Talk = 3, Tick = 0.1 }
local RUNTIME = { Chat = {}, CharacterRemoving = {}, Active = {}, Folder = nil, FolderConns = {}, Started = false }

local function assetId(value)
	if type(value) ~= "string" then return false end
	local digits = value:match("^rbxassetid://(%d+)$")
	return digits ~= nil and #digits <= 20 and digits:find("[1-9]") ~= nil
end

local function complete(def)
	return type(def) == "table" and assetId(def.Neutral) and assetId(def.Serious) and assetId(def.SoftSmile)
end

local function clearConnections(list)
	for _, connection in list do connection:Disconnect() end
	table.clear(list)
end

local function dispose(st)
	RUNTIME.Active[st] = nil
	clearConnections(st.Conns)
	if st.Player and states[st.Player] == st then states[st.Player] = nil end
	if monsters[st.Model] == st then monsters[st.Model] = nil end
end

local function directWeld(weld, model, head, mesh)
	if not weld or not weld.Parent or not weld:IsDescendantOf(model)
		or not (weld:IsA("Weld") or weld:IsA("WeldConstraint")) then return false end
	local ok, connected = pcall(function()
		local enabledOK, enabled = pcall(function() return weld.Enabled end)
		if enabledOK and enabled == false then return false end
		return (weld.Part0 == head and weld.Part1 == mesh) or (weld.Part0 == mesh and weld.Part1 == head)
	end)
	return ok and connected
end

local function faceMesh(model, head, def)
	-- Expression atlases use a separate, verified UV mesh. Never replace the original Head atlas.
	local name = type(def) == "table" and def.MeshName
	if type(name) ~= "string" or #name == 0 or #name > 64 or name:find("[^%w_%-]") or name == "Head" then return nil end
	local mesh
	for _, child in model:GetDescendants() do
		if child.Name == name then
			if mesh or not child:IsA("MeshPart") then return nil end -- duplicate/ambiguous names fail closed
			mesh = child
		end
	end
	if not mesh or mesh:GetAttribute("HHC_ExpressionMeshValidated") ~= true
		or mesh:FindFirstChildOfClass("SurfaceAppearance") then return nil end
	if not head then return mesh end -- monster-owned target, still marked and scoped to this model
	if mesh:IsDescendantOf(head) then return mesh end
	for _, child in model:GetDescendants() do
		if directWeld(child, model, head, mesh) then return mesh, child end
	end
	return nil
end

local function meshReady(st)
	local mesh = st.Mesh
	if not complete(st.Assets) or not mesh or not mesh.Parent or not mesh:IsDescendantOf(st.Model)
		or mesh:GetAttribute("HHC_ExpressionMeshValidated") ~= true
		or mesh:FindFirstChildOfClass("SurfaceAppearance") then return false end
	return not st.Head or mesh:IsDescendantOf(st.Head) or directWeld(st.Weld, st.Model, st.Head, mesh)
end

local function choose(st, now)
	if now < st.HurtUntil or now < st.AttackUntil then return "Serious" end
	if now < st.TalkUntil then return "SoftSmile" end
	return "Neutral"
end

local function draw(st, now)
	local model = st.Model
	if not model or not model.Parent or (st.Player and (st.Player.Character ~= model
		or model:GetAttribute("HHC_CostumeId") ~= st.CostumeId))
		or (st.Folder and (model.Parent ~= st.Folder or st.Folder.Parent ~= workspace)) then
		dispose(st)
		return
	end
	local expression = choose(st, now)
	if expression == "Neutral" then RUNTIME.Active[st] = nil else RUNTIME.Active[st] = true end
	local ready = meshReady(st)
	if st.Current == expression and st.Ready == ready then return end
	if ready then
		ready = pcall(function()
			if st.Mesh.TextureID ~= st.Assets[expression] then st.Mesh.TextureID = st.Assets[expression] end
		end)
	end
	st.Current, st.Ready = expression, ready
	if model:GetAttribute("Expression") ~= expression then model:SetAttribute("Expression", expression) end
	if model:GetAttribute("ExpressionReady") ~= ready then model:SetAttribute("ExpressionReady", ready) end
end

local function state(model, mesh, def)
	return { Model = model, Mesh = mesh, Assets = def, Ready = nil, Current = nil,
		AttackUntil = 0, HurtUntil = 0, TalkUntil = 0, Conns = {} }
end

local function bindCharacter(player, character, humanoid)
	local previous = states[player]
	if previous then dispose(previous) end
	states[player] = nil
	if player.Character ~= character or not S.PlayerService.IsReady(player) or not humanoid or not humanoid:IsA("Humanoid") then return end
	-- OFF restores the owner's Roblox avatar, including their chosen face.
	local id = character:GetAttribute("HHC_CostumeId")
	if type(id) ~= "string" or id == "" then return end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end
	-- PBR assets require prebuilt SurfaceAppearance variants, never a protected ColorMap write at runtime.
	local def = Assets.Costumes[id]
	local mesh, weld = faceMesh(character, head, def)
	local st = state(character, mesh, def)
	st.Player, st.CostumeId, st.Head, st.Weld = player, id, head, weld
	st.Health = humanoid.Health
	states[player] = st
	table.insert(st.Conns, humanoid.HealthChanged:Connect(function(health)
		if states[player] ~= st then return end
		if health > 0 and health < st.Health then st.HurtUntil = os.clock() + DURATION.Hurt end
		st.Health = health
		draw(st, os.clock())
	end))
	table.insert(st.Conns, character.AncestryChanged:Connect(function()
		if not character:IsDescendantOf(workspace) then dispose(st) end
	end))
	draw(st, os.clock())
end

function ExpressionService.Attack(player)
	local st = states[player]
	if not st or player.Character ~= st.Model or not Util.IsAlive(player) then return end
	st.AttackUntil = os.clock() + DURATION.Attack
	draw(st, os.clock())
end

function ExpressionService.Talk(player)
	local st = states[player]
	if not st or player.Character ~= st.Model or not Util.IsAlive(player) then return end
	st.TalkUntil = os.clock() + DURATION.Talk
	draw(st, os.clock())
end

local function bindPlayer(player)
	if player.Parent ~= Players or RUNTIME.Chat[player] then return end
	local connection = player.Chatted:Connect(function()
		-- No message content is stored or broadcast here; Roblox owns the chat filtering.
		if S.PlayerService.IsReady(player) then ExpressionService.Talk(player) end
	end)
	RUNTIME.Chat[player] = connection
	RUNTIME.CharacterRemoving[player] = player.CharacterRemoving:Connect(function(character)
		local st = states[player]
		if st and st.Model == character then dispose(st) end
	end)
end

local function unbindPlayer(player)
	local st = states[player]
	if st then dispose(st) end
	local connection = RUNTIME.Chat[player]
	RUNTIME.Chat[player] = nil
	if connection then connection:Disconnect() end
	connection = RUNTIME.CharacterRemoving[player]
	RUNTIME.CharacterRemoving[player] = nil
	if connection then connection:Disconnect() end
end

local function bindMonster(model)
	if not model:IsA("Model") or model.Parent ~= RUNTIME.Folder or monsters[model] then return end
	local kind = model:GetAttribute("MonsterKind")
	if type(kind) ~= "string" then return end
	local def = Assets.Monsters[kind]
	local mesh = faceMesh(model, nil, def)
	local st = state(model, mesh, def)
	st.Folder = RUNTIME.Folder
	st.Sequences = { AttackSeq = tonumber(model:GetAttribute("AttackSeq")) or 0,
		HurtSeq = tonumber(model:GetAttribute("HurtSeq")) or 0 }
	monsters[model] = st
	for _, attribute in { "WindupAt", "AttackSeq" } do
		table.insert(st.Conns, model:GetAttributeChangedSignal(attribute):Connect(function()
			local value = model:GetAttribute(attribute)
			if type(value) ~= "number" or value < 0 or value ~= value or value == math.huge then return end
			if attribute == "AttackSeq" then
				local previousSeq = st.Sequences.AttackSeq
				st.Sequences.AttackSeq = value
				if value == 0 or value <= previousSeq then return end
			end
			if value == 0 then return end
			st.AttackUntil = os.clock() + DURATION.Attack
			draw(st, os.clock())
		end))
	end
	table.insert(st.Conns, model:GetAttributeChangedSignal("HurtSeq"):Connect(function()
		local value = model:GetAttribute("HurtSeq")
		if type(value) ~= "number" or value < 0 or value ~= value or value == math.huge then return end
		local previousSeq = st.Sequences.HurtSeq
		st.Sequences.HurtSeq = value
		if value == 0 or value <= previousSeq then return end
		st.HurtUntil = os.clock() + DURATION.Hurt
		draw(st, os.clock())
	end))
	table.insert(st.Conns, model.AncestryChanged:Connect(function()
		if model.Parent ~= st.Folder then dispose(st) end
	end))
	draw(st, os.clock())
end

local function watchMonsterFolder(folder)
	if not folder or not folder:IsA("Folder") or folder.Name ~= "Monsters" or folder.Parent ~= workspace
		or RUNTIME.Folder == folder or (RUNTIME.Folder and RUNTIME.Folder.Parent == workspace) then return end
	clearConnections(RUNTIME.FolderConns)
	RUNTIME.Folder = folder
	table.insert(RUNTIME.FolderConns, folder.ChildAdded:Connect(bindMonster))
	table.insert(RUNTIME.FolderConns, folder.AncestryChanged:Connect(function()
		if folder.Parent == workspace then return end
		if RUNTIME.Folder == folder then
			RUNTIME.Folder = nil
			clearConnections(RUNTIME.FolderConns)
			for _, st in monsters do if st.Folder == folder then dispose(st) end end
			watchMonsterFolder(workspace:FindFirstChild("Monsters"))
		end
	end))
	for _, model in folder:GetChildren() do bindMonster(model) end
end

local function conversationPrompt(prompt, player)
	if not prompt:IsA("ProximityPrompt") or not prompt:IsDescendantOf(workspace) then return end
	local owner = prompt:FindFirstAncestorOfClass("Model")
	-- A shop/altar prompt on a generic NPC is not proof that a conversation started.
	if prompt:GetAttribute("Conversation") ~= true or not owner or not CollectionService:HasTag(owner, "NPC") then return end
	if player.Parent ~= Players or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) or not prompt.Enabled then return end
	local root = Util.GetRoot(player)
	local parent = prompt.Parent
	local point = parent and (parent:IsA("Attachment") and parent.WorldPosition
		or (parent:IsA("BasePart") and parent.Position)
		or (parent:IsA("Model") and parent.PrimaryPart and parent.PrimaryPart.Position))
	if not root or typeof(point) ~= "Vector3" then return end
	local distance, limit = (root.Position - point).Magnitude, prompt.MaxActivationDistance
	if distance ~= distance or distance == math.huge or limit ~= limit or limit < 0 or limit == math.huge
		or distance > limit + 3 then return end
	if not Util.RateLimit(player, "ExpressionConversation", 0.5) then return end
	ExpressionService.Talk(player)
end

function ExpressionService.Init(registry)
	S = registry
end

function ExpressionService.Start()
	if RUNTIME.Started then return end
	RUNTIME.Started = true
	for _, player in Players:GetPlayers() do bindPlayer(player) end
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(unbindPlayer) -- PlayerLeaving is not fired when someone leaves before DataLoaded
	S.PlayerService.CharacterSpawned:Connect(bindCharacter)
	S.PlayerService.PlayerLeaving:Connect(unbindPlayer)
	ProximityPromptService.PromptTriggered:Connect(conversationPrompt)
	-- Init normally creates this folder; also handle a late/rebuilt folder without a world scan.
	watchMonsterFolder(workspace:FindFirstChild("Monsters"))
	workspace.ChildAdded:Connect(watchMonsterFolder)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < DURATION.Tick then return end
		elapsed = 0
		local now = os.clock()
		-- Only timed non-neutral states need a expiry tick; idle avatars/monsters cost no per-frame scans.
		for st in RUNTIME.Active do draw(st, now) end
	end)
	print("[ExpressionService] started")
end

return ExpressionService
]]></ProtectedString>
				<string name="ScriptGuid">{AD6F2E74-4307-4192-9E6B-83CE342B1AB9}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ExpressionService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">718623eb9e7784d40ad29b0d000008d3</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX9BAEAA0501EF46008E082D5CEE72424F">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- MonsterService.luau : monster rigs (procedural or custom visual), spawn/respawn with zone density and spawn spread,
-- AI loop, monster HP, kill rewards (MonsterKilled) and personal (tutorial) monsters.
-- World is Terrain (A10/A11): spawn/wander points are raycast onto walkable ground; monsters stay inside their own zone
-- rect, never chase into water and are recovered home when knocked out / sunk (A10-V3-2); stuck detection (A11-R5).
-- A15 hit feel: attacks are telegraphed (WindupAt -> AttackSeq), damage bumps HurtSeq, player hits shove (Shove).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local MonsterService = {}

-- fired once PER CONTRIBUTOR: (player, info). info.WarPoints = personal war points, info.WarShare = this player's
-- part of the faction pool points (WarPoints / same-faction contributors, CR-M18)
MonsterService.MonsterKilled = Util.Signal.new()

------------------------------------------------------------------ constants
local TAG = "MonsterService"
local MC = Config.Monsters

-- A3-M2 / A5-C1 density (fallbacks keep the service working if a Config key is missing)
local DENSITY = Config.MonsterDensity or {}
local EXTRA_PER_PLAYER = DENSITY.ExtraPerPlayer or 2
local MAX_ZONE_MULT = DENSITY.MaxZoneMult or 2
local REEVAL_INTERVAL = DENSITY.ReevalInterval or 5
local MAX_SPAWNS_PER_KIND_PER_PASS = 8 -- smooths bursts when many players enter a zone at once

-- A7-1 spawn spread
local SPREAD = Config.SpawnSpread or {}
local SPREAD_ENABLED = SPREAD.Enabled ~= false
local SPREAD_THRESHOLD = SPREAD.StarvedThreshold or 2
local SPREAD_MIN = SPREAD.MinDist or 18
local SPREAD_MAX = SPREAD.MaxDist or 28
local SPREAD_TRIES = SPREAD.Tries or 6
local SPREAD_COUNT_RADIUS = 30

-- shared Config keys (G1) with fallbacks
local TUTORIAL = Config.Tutorial or {}
local CUSTOM = Config.CustomModels or {}
local CUSTOM_FOLDER = CUSTOM.FolderName or "CustomModels"
local GOLDEN_FILL_TRANSPARENCY = CUSTOM.GoldenFillTransparency or 0.5
local MIN_TEXT_SIZE = (Config.UI and Config.UI.MinTextSize) or 11
local NO_REAGGRO_SECONDS = MC.ReaggroDelay or 3 -- A3-M4
local PERSONAL_DISTANCE = TUTORIAL.SpawnDistance or 8 -- A4: ~8 studs in front of the player
local PERSONAL_LIFETIME = TUTORIAL.Lifetime or 120 -- A4: despawn after 120 s

-- AI tuning that is not in Config (private)
local RETURN_DONE_DIST = 6
local WANDER_RADIUS = 15
local WANDER_MIN, WANDER_MAX = 4, 8
local WANDER_TRIES = 4
local PERSONAL_FOLLOW_RADIUS = 80 -- A5-C3: a personal monster only tracks its owner when the owner is this close
local ZONE_MOVE_INSET = 6 -- A10-V3-2 (b): every MoveTo destination stays this far inside the monster's zone rect
local OUT_Y = -3 -- A10-V3-2 (c): root below this (water) -> walk home, no re-aggro
local DEEP_Y = -8 -- A10-V3-2 (c): root below this for more than DEEP_SECONDS -> PivotTo(Home)
local DEEP_SECONDS = 2
local MAX_SLOPE_ANGLE = 46 -- A11-R2: Terrain ridges (>= 50 deg) cannot be walked over
local STUCK_WINDOW = 1.5 -- A11-R5: moved < STUCK_MIN_MOVE in this many seconds while moving -> new destination
local STUCK_MIN_MOVE = 1
local ARRIVE_DIST = 3 -- "still trying to move" while the destination is farther than this
local DETOUR_MIN, DETOUR_MAX = 8, 14
local DETOUR_SECONDS = 2
local DETOUR_TRIES = 4
local CHASE_STUCK_GIVEUP = 2 -- stuck this many times on one target -> give up and go home

-- ground probing (A11-R1: Include only Terrain, Map.Ground and the Map.Decor "Bridge_*" models)
local GROUND_RAY_TOP = 150 -- above every ridge top
local GROUND_RAY_LENGTH = 320
local GROUND_MIN_Y, GROUND_MAX_Y = -2, 6 -- walkable valley floor (zone ground top is Y = 0); higher = ridge, lower = shore
local GROUND_PARAMS_REFRESH = 10
local SPAWN_TRIES = 8

-- visuals
local BAR_MAX_DISTANCE = 80
local DEATH_FADE = 0.3
local DEATH_DESTROY = 0.4
local DEATH_PARTICLES = 15
local BOB_PERIOD = 0.55
local BOB_FRACTION = 0.06 -- custom visual bob height as a fraction of the body height
-- every visible part is welded to VisualRoot, which hangs off the root by the Weld VisualJoint (C0 = C1 = identity).
-- Clients tween VisualJoint.C0 locally (Fx.luau attack lunge / hit recoil); the server never writes C0 after spawn.
local VISUAL_ROOT_NAME = "VisualRoot"
local VISUAL_JOINT_NAME = "VisualJoint"
local VISUAL_ROOT_SIZE = 0.2
local ATTACK_SEQ_ATTR = "AttackSeq" -- +1 when a monster attack lands on a player (clients play the attack lunge)
local FACE_TARGET_DOT = 0.85 -- attacking: turn to the target when it is more than ~30 deg off the look direction
-- A15 hit feel (server half): attack telegraph, pain reactions, swing shove. Tunables live in Config.HitReact (shared
-- with the client Fx); the fallbacks keep the service working without it. Model attribute contract for clients:
-- "WindupAt" changed -> wind-up pose (the hit follows REACT.WINDUP s later unless cancelled), "AttackSeq" +1 -> lunge
-- (the damage lands now), "HurtSeq" +1 -> pain reaction ("HurtBig" is written first: true = crit / big hit).
local HIT_REACT = Config.HitReact or {}
local REACT = {
	WINDUP = HIT_REACT.MonsterWindup or 0.28, -- s from "WindupAt" to the hit
	WINDUP_LEEWAY = HIT_REACT.WindupLeeway or 2, -- the hit still lands while the target is within AttackRange + this
	HURT_GAP = HIT_REACT.MonsterHurtGap or 0.15, -- at most one "HurtSeq" bump per monster per this many seconds
	BIG_FRACTION = HIT_REACT.BigHitFraction or 0.5, -- a hit of >= this fraction of MaxHP is "big"
	SHOVE_MAX = HIT_REACT.ShoveMax or 2, -- studs, upper bound of any shove (divided by the monster's body scale)
	SHOVE_TIME = HIT_REACT.ShoveTime or 0.12, -- s the shove slide takes
	SHOVE_GAP = HIT_REACT.ShoveGap or 0.5, -- min seconds between two shoves of one monster (no push-locking)
}
local WINDUP_AT_ATTR = "WindupAt" -- workspace:GetServerTimeNow() when the monster starts winding up an attack
local HURT_SEQ_ATTR = "HurtSeq" -- +1 when the monster takes damage and survives (throttled by REACT.HURT_GAP)
local HURT_BIG_ATTR = "HurtBig" -- written right before HurtSeq: true = crit or >= BIG_FRACTION of its MaxHP
local BAR_HIGH = Color3.fromRGB(80, 220, 120)
local BAR_LOW = Color3.fromRGB(255, 80, 80)
local EYE_COLOR = Color3.fromRGB(20, 20, 20)

local DISABLED_STATES = { -- A3-H2
	Enum.HumanoidStateType.Dead,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.Seated,
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Swimming,
	Enum.HumanoidStateType.PlatformStanding,
}

------------------------------------------------------------------ state
local S = nil
local records = {} -- [Id] = MonsterRecord (alive only)
local nextId = 0
local pending = {} -- [Kind] = respawns scheduled but not yet executed
local personal = {} -- [Player] = { [MonsterRecord] = true }
local monstersFolder = nil
local lastWarn = {} -- [key] = os.clock()
local groundParams, groundParamsAt = nil, -math.huge

local GLOBAL_CAP
do
	if type(DENSITY.GlobalCap) == "number" then
		GLOBAL_CAP = DENSITY.GlobalCap
	else
		local sum = 0
		for _, kind in Config.MonsterTypeOrder do
			local def = Config.MonsterTypes[kind]
			if def then sum += def.Count end
		end
		GLOBAL_CAP = math.floor(sum * 1.7 + 0.5)
	end
end

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarn[key]
	if last and now - last < 10 then return end
	lastWarn[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function getMonstersFolder()
	if monstersFolder and monstersFolder.Parent then return monstersFolder end
	monstersFolder = Util.GetFolder(workspace, "Monsters")
	return monstersFolder
end

local function readyPlayers()
	if not S or not S.PlayerService then return {} end
	local ok, list = pcall(S.PlayerService.GetReadyPlayers)
	if ok and type(list) == "table" then return list end
	return {}
end

local function isPlayerInTown(player, pos)
	if Config.ZoneAt(pos).Town == true then return true end
	if S and S.ZoneService then
		local ok, town = pcall(S.ZoneService.IsTown, player)
		if ok and town == true then return true end
	end
	return false
end

-- CR-M18: faction id the war pool uses (same lookup as WarService: FactionService first, then the attribute)
local function factionOf(player)
	if S and S.FactionService and S.FactionService.GetFaction then
		local ok, f = pcall(S.FactionService.GetFaction, player)
		if ok and type(f) == "string" then return f end
	end
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

-- CR-M5: zone id of the player's root (nil without a character); attackers must stand in the monster's zone
local function zoneIdOf(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then return nil end
	local r = Util.GetRoot(player)
	return r and Config.ZoneAt(r.Position).Id or nil
end

-- CR-M5: personal monsters only for their owner (any zone); zone monsters only for a player standing in their zone
-- (A10-V3-2a both ways: a monster that never chases out of its zone cannot be farmed from just outside it)
local function visibleTo(rec, forPlayer, forZone)
	if forPlayer == nil then return true end
	if rec.Owner ~= nil then return rec.Owner == forPlayer end
	return forZone ~= nil and rec.ZoneId == forZone
end

local function insideZone(zone, p, inset)
	return math.abs(p.X - zone.Center.X) <= zone.Size.X / 2 - inset
		and math.abs(p.Z - zone.Center.Z) <= zone.Size.Z / 2 - inset
end

-- A10-V3-2 (b): clamp a destination into the zone rect inset by ZONE_MOVE_INSET (keeps Y)
local function clampToZone(zone, p)
	if not zone then return p end
	local hx = math.max(0, zone.Size.X / 2 - ZONE_MOVE_INSET)
	local hz = math.max(0, zone.Size.Z / 2 - ZONE_MOVE_INSET)
	return Vector3.new(
		math.clamp(p.X, zone.Center.X - hx, zone.Center.X + hx),
		p.Y,
		math.clamp(p.Z, zone.Center.Z - hz, zone.Center.Z + hz)
	)
end

-- A11-R1: ground raycasts only see Terrain, workspace.Map.Ground and the bridge models (rebuilt every few seconds
-- so a late MapBuilder pass is picked up). Water is NOT ignored, so a hit on the sea/river reports Material Water.
local function getGroundParams()
	local now = os.clock()
	if groundParams and now - groundParamsAt < GROUND_PARAMS_REFRESH then return groundParams end
	local list = { workspace.Terrain }
	local map = workspace:FindFirstChild("Map")
	if map then
		local ground = map:FindFirstChild("Ground")
		if ground then table.insert(list, ground) end
		local decor = map:FindFirstChild("Decor")
		if decor then
			for _, c in decor:GetChildren() do
				if string.sub(c.Name, 1, 7) == "Bridge_" then table.insert(list, c) end
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = list
	params.IgnoreWater = false
	groundParams, groundParamsAt = params, now
	return params
end

-- ground under (x, z): returns (groundY, isWater), or nil when nothing was hit
local function probeGround(x, z)
	local hit = workspace:Raycast(Vector3.new(x, GROUND_RAY_TOP, z), Vector3.new(0, -GROUND_RAY_LENGTH, 0), getGroundParams())
	if not hit then return nil, false end
	return hit.Position.Y, hit.Material == Enum.Material.Water
end

-- CR-L14: solid decoration a monster must not stand in (King Slime hill, goblin tents, broken pillars / arches):
-- Map.Decor children except the "Bridge_*" decks, plus Map.Landmarks. Non-collidable props (canopies, flowers, glows)
-- never count. Rebuilt every GROUND_PARAMS_REFRESH s like the ground params.
local blockCast = { Params = nil, At = -math.huge, Any = false }
local function getBlockParams()
	local now = os.clock()
	if blockCast.Params and now - blockCast.At < GROUND_PARAMS_REFRESH then return blockCast.Params end
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		local decor = map:FindFirstChild("Decor")
		if decor then
			for _, c in decor:GetChildren() do
				if string.sub(c.Name, 1, 7) ~= "Bridge_" then table.insert(list, c) end
			end
		end
		local landmarks = map:FindFirstChild("Landmarks")
		if landmarks then table.insert(list, landmarks) end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)
	blockCast.Params, blockCast.At, blockCast.Any = params, now, #list > 0
	return params
end

-- CR-L14: true when a solid decor / landmark part stands on the ground point (ray from y + 40 down to y + 0.5)
local function occupied(x, y, z)
	local params = getBlockParams()
	if not blockCast.Any then return false end
	local ok, hit = pcall(function()
		return workspace:Raycast(Vector3.new(x, y + 40, z), Vector3.new(0, -39.5, 0), params)
	end)
	return ok and hit ~= nil
end

-- walkable ground point at (x, z) or nil (water, ridge, shore, inside solid decor). Second result: true when the ray
-- hit nothing at all (bare test place without Terrain / Map.Ground), so callers can fall back to the legacy flat Y = 0
-- behaviour.
local function groundPoint(x, z)
	local y, water = probeGround(x, z)
	if y == nil then return nil, true end
	if water or y < GROUND_MIN_Y or y > GROUND_MAX_Y then return nil, false end
	if occupied(x, y, z) then return nil, false end -- CR-L14
	return Vector3.new(x, y, z), false
end

-- unanchored monster part
local function newPart(props)
	local p = Instance.new(props.ClassName or "Part")
	if props.Shape then p.Shape = props.Shape end
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "ClassName" and k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	return p
end

local function getCustomTemplate(id)
	local folder = ServerStorage:FindFirstChild(CUSTOM_FOLDER)
	if not folder then return nil end
	local t = folder:FindFirstChild(id)
	if t and (t:IsA("Model") or t:IsA("BasePart")) then return t end
	return nil
end

------------------------------------------------------------------ counting (non-personal)
local function aliveCountOf(kind)
	local n = 0
	for _, rec in records do
		if rec.Alive and rec.Owner == nil and rec.Kind == kind then n += 1 end
	end
	return n
end

local function totalNonPersonal()
	local n = 0
	for _, rec in records do
		if rec.Alive and rec.Owner == nil then n += 1 end
	end
	for _, c in pending do n += c end
	return n
end

local function playersPerZone()
	local counts = {}
	for _, p in readyPlayers() do
		local root = Util.GetRoot(p)
		if root then
			local id = Config.ZoneAt(root.Position).Id
			counts[id] = (counts[id] or 0) + 1
		end
	end
	return counts
end

local function targetCount(kind, zoneCounts)
	local def = Config.MonsterTypes[kind]
	if not def then return 0 end
	local n = (zoneCounts or playersPerZone())[def.Zone] or 0
	return math.min(def.Count + EXTRA_PER_PLAYER * math.max(0, n - 1), def.Count * MAX_ZONE_MULT)
end

-- CR-L13: { [kind] = target } where the extras above each base Count share the GLOBAL_CAP room (GLOBAL_CAP - base
-- sum) in proportion to what each kind asks for (largest remainder), instead of MonsterTypeOrder filling the cap
-- first (busy meadow -> the ruins stayed at their base density).
local function cappedTargets(zoneCounts)
	zoneCounts = zoneCounts or playersPerZone()
	local targets, extras = {}, {}
	local baseSum, extraSum = 0, 0
	for _, kind in Config.MonsterTypeOrder do
		local def = Config.MonsterTypes[kind]
		if def and targets[kind] == nil then
			local t = targetCount(kind, zoneCounts)
			local base = math.min(def.Count, t)
			targets[kind] = base
			extras[kind] = math.max(0, t - base)
			baseSum += base
			extraSum += extras[kind]
		end
	end
	if extraSum <= 0 then return targets end
	local room = math.max(0, GLOBAL_CAP - baseSum)
	if room >= extraSum then
		for kind, e in extras do
			targets[kind] += e
		end
		return targets
	end
	local used, fracs = 0, {}
	for _, kind in Config.MonsterTypeOrder do
		local e = extras[kind]
		if e and e > 0 then
			extras[kind] = 0 -- a kind listed twice is shared out once
			local share = e * room / extraSum
			local whole = math.floor(share)
			targets[kind] += whole
			used += whole
			table.insert(fracs, { Kind = kind, F = share - whole, I = #fracs + 1 })
		end
	end
	table.sort(fracs, function(a, b)
		if a.F ~= b.F then return a.F > b.F end
		return a.I < b.I
	end)
	for _, fr in fracs do
		if used >= room then break end
		targets[fr.Kind] += 1
		used += 1
	end
	return targets
end

------------------------------------------------------------------ public queries
-- forPlayer (optional): only the monsters that player may hit (own personal ones + zone monsters of the zone the
-- player stands in, CR-M5). nil = every alive monster.
function MonsterService.GetMonstersInRadius(position, radius, forPlayer)
	local out = {}
	if typeof(position) ~= "Vector3" or type(radius) ~= "number" then return out end
	local fz = zoneIdOf(forPlayer) -- CR-M5
	for _, rec in records do
		if rec.Alive and visibleTo(rec, forPlayer, fz) then
			local root = rec.Root
			if root and root.Parent and Util.FlatDistance(root.Position, position) <= radius then
				table.insert(out, rec)
			end
		end
	end
	return out
end

function MonsterService.GetNearest(position, radius, maxCount, forPlayer)
	local out = {}
	if typeof(position) ~= "Vector3" or type(radius) ~= "number" then return out end
	local found = {}
	local fz = zoneIdOf(forPlayer) -- CR-M5
	for _, rec in records do
		if rec.Alive and visibleTo(rec, forPlayer, fz) then
			local root = rec.Root
			if root and root.Parent then
				local d = Util.FlatDistance(root.Position, position)
				if d <= radius then
					table.insert(found, { Rec = rec, D = d })
				end
			end
		end
	end
	table.sort(found, function(a, b) return a.D < b.D end)
	local limit = (type(maxCount) == "number" and maxCount >= 0) and math.floor(maxCount) or #found
	for i = 1, math.min(limit, #found) do
		out[i] = found[i].Rec
	end
	return out
end

function MonsterService.CountInRadius(position, radius, forPlayer)
	if typeof(position) ~= "Vector3" or type(radius) ~= "number" then return 0 end
	local n = 0
	local fz = zoneIdOf(forPlayer) -- CR-M5
	for _, rec in records do
		if rec.Alive and visibleTo(rec, forPlayer, fz) then
			local root = rec.Root
			if root and root.Parent and Util.FlatDistance(root.Position, position) <= radius then
				n += 1
			end
		end
	end
	return n
end

------------------------------------------------------------------ spawn point (A7-1, grounded on Terrain per A10/A11)
-- Returns a point ON the ground (Y = ground height) inside def.Zone, or nil when every try landed on water / a ridge
-- (the density pass retries a few seconds later).
local function pickSpawnPoint(def)
	local zone = Config.Zones[def.Zone]
	if not zone then return nil end
	local inset = MC.SpawnInset
	local anyHit = false
	local function try(pt)
		local g, noHit = groundPoint(pt.X, pt.Z)
		if not noHit then anyHit = true end
		if g and Config.ZoneAt(g).Id == def.Zone then return g end
		return nil
	end
	if SPREAD_ENABLED then
		local bestPos, bestCount = nil, nil
		for _, p in readyPlayers() do
			if Util.IsAlive(p) then
				local root = Util.GetRoot(p)
				if root then
					local pos = root.Position
					local z = Config.ZoneAt(pos)
					if z.Id == def.Zone and not z.Town then
						local c = MonsterService.CountInRadius(pos, SPREAD_COUNT_RADIUS, p)
						if bestCount == nil or c < bestCount then
							bestPos, bestCount = pos, c
						end
					end
				end
			end
		end
		if bestPos and bestCount < SPREAD_THRESHOLD then
			for _ = 1, SPREAD_TRIES do
				local a = Util.Random:NextNumber(0, math.pi * 2)
				local d = Util.Random:NextNumber(SPREAD_MIN, SPREAD_MAX)
				local pt = Vector3.new(bestPos.X + math.cos(a) * d, 0, bestPos.Z + math.sin(a) * d)
				if insideZone(zone, pt, inset) then
					local g = try(pt)
					if g then return g end
				end
			end
		end
	end
	for _ = 1, SPAWN_TRIES do
		local g = try(Util.RandomPointInZone(zone, inset))
		if g then return g end
	end
	if not anyHit then
		-- no Terrain / Map.Ground under the zone at all (bare test place): legacy flat ground at Y = 0
		return Util.RandomPointInZone(zone, inset)
	end
	warnThrottled("spawnpoint_" .. def.Zone, "no walkable ground found in " .. def.Zone .. " this pass (water/ridge); retrying later")
	return nil
end

------------------------------------------------------------------ rig construction
local function makeBar(root, text, golden, offsetY)
	local bb = Instance.new("BillboardGui")
	bb.Name = "MonsterBar"
	bb.Size = UDim2.fromOffset(150, 34)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = BAR_MAX_DISTANCE
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false

	local name = Instance.new("TextLabel")
	name.Name = "NameLabel"
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 20)
	name.Font = Enum.Font.GothamBold
	name.Text = text
	name.TextColor3 = golden and MC.GoldenColor or Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.TextScaled = true
	local tsc = Instance.new("UITextSizeConstraint")
	tsc.MaxTextSize = 16
	tsc.MinTextSize = MIN_TEXT_SIZE
	tsc.Parent = name
	name.Parent = bb

	local back = Instance.new("Frame")
	back.Name = "Bar"
	back.Position = UDim2.new(0.1, 0, 0, 23)
	back.Size = UDim2.new(0.8, 0, 0, 8)
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	back.BackgroundTransparency = 0.2
	back.BorderSizePixel = 0
	local c1 = Instance.new("UICorner")
	c1.CornerRadius = UDim.new(0, 4)
	c1.Parent = back
	back.Parent = bb

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = BAR_HIGH
	fill.BorderSizePixel = 0
	local c2 = Instance.new("UICorner")
	c2.CornerRadius = UDim.new(0, 4)
	c2.Parent = fill
	fill.Parent = back

	bb.Parent = root
	return fill
end

local function updateBar(rec)
	local fill = rec._fill
	if not fill or not fill.Parent then return end
	local r = (rec.MaxHP > 0) and math.clamp(rec.HP / rec.MaxHP, 0, 1) or 0
	fill.Size = UDim2.fromScale(r, 1)
	fill.BackgroundColor3 = BAR_LOW:Lerp(BAR_HIGH, r)
end

-- A1: clone a custom visual, scale it to the procedural body height, sit it on the floor facing the root.
-- Returns (visualModel, parts) or nil when the template is unusable.
local function buildCustomVisual(template, rootCF, bodyHeight, floorY)
	local clone = template:Clone()
	local visual
	if clone:IsA("BasePart") then
		visual = Instance.new("Model")
		clone.Parent = visual
		visual.PrimaryPart = clone
	else
		visual = clone
	end
	visual.Name = "CustomVisual"

	for _, d in visual:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") or d:IsA("Humanoid") then
			d:Destroy()
		end
	end

	local parts = {}
	for _, d in visual:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			table.insert(parts, d)
		end
	end
	if #parts == 0 then
		visual:Destroy()
		return nil
	end

	-- face the root's look direction (the template's pivot orientation is treated as its "front")
	visual:PivotTo(CFrame.new(visual:GetPivot().Position) * rootCF.Rotation)

	-- scale so the bounding-box height matches the procedural body height
	local _, size = visual:GetBoundingBox()
	if size.Y > 0.01 then
		local factor = bodyHeight / size.Y
		local okScale, cur = pcall(visual.GetScale, visual)
		if not okScale or type(cur) ~= "number" or cur <= 0 then cur = 1 end
		pcall(visual.ScaleTo, visual, cur * factor)
	end

	-- bottom on the floor, centered under the root
	local bbCF, bbSize = visual:GetBoundingBox()
	local rootPos = rootCF.Position
	local delta = Vector3.new(
		rootPos.X - bbCF.Position.X,
		(floorY + bbSize.Y / 2) - bbCF.Position.Y,
		rootPos.Z - bbCF.Position.Z
	)
	visual:PivotTo(visual:GetPivot() + delta)
	return visual, parts
end

-- builds the model (not parented yet). Returns a table with Model, Root, VisualRoot, Humanoid, Fill, Parts, VisualParts,
-- BodyHeight, Hip.
local function buildRig(kind, def, golden, groundPos, faceTo)
	local s = def.Scale or 1
	local isSlime = def.Shape == "Slime"
	local rootSize, hip, bodyHeight, topAboveRoot
	if isSlime then
		rootSize = Vector3.new(2 * s, 2 * s, 2 * s)
		hip = 0.5 * s
		bodyHeight = 3 * s -- ball diameter; root center sits 1.5s above the floor
		topAboveRoot = 1.5 * s -- ball top
	else
		rootSize = Vector3.new(2 * s, 2 * s, 1 * s)
		hip = 2 * s
		bodyHeight = 5 * s -- legs bottom at the floor, head top 5s above it
		topAboveRoot = 2 * s -- head top
	end

	local floorY = groundPos.Y
	local rootY = floorY + hip + rootSize.Y / 2
	local rootPos = Vector3.new(groundPos.X, rootY, groundPos.Z)
	local rootCF
	if typeof(faceTo) == "Vector3" and Util.FlatDistance(faceTo, rootPos) > 0.1 then
		rootCF = CFrame.lookAt(rootPos, Vector3.new(faceTo.X, rootY, faceTo.Z))
	else
		rootCF = CFrame.new(rootPos) * CFrame.Angles(0, Util.Random:NextNumber(0, math.pi * 2), 0)
	end

	local model = Instance.new("Model")
	model.Name = kind

	local root = newPart({
		Name = "HumanoidRootPart",
		Size = rootSize,
		CFrame = rootCF,
		Transparency = 1,
		Massless = false,
	})
	root.Parent = model
	model.PrimaryPart = root

	-- invisible anchor for every visible part (see VISUAL_ROOT_NAME); starts exactly on the root
	local visualRoot = newPart({
		Name = VISUAL_ROOT_NAME,
		Size = Vector3.new(VISUAL_ROOT_SIZE, VISUAL_ROOT_SIZE, VISUAL_ROOT_SIZE),
		CFrame = rootCF,
		Transparency = 1,
		CanQuery = false,
		CastShadow = false,
	})
	visualRoot.Parent = model
	local joint = Instance.new("Weld")
	joint.Name = VISUAL_JOINT_NAME
	joint.Part0 = root
	joint.Part1 = visualRoot
	joint.C0 = CFrame.identity
	joint.C1 = CFrame.identity
	joint.Parent = visualRoot

	local bodyColor = golden and MC.GoldenColor or def.Color
	local darkColor = golden and MC.GoldenColor or def.Color:Lerp(Color3.new(0, 0, 0), 0.25)
	local parts = {}
	local function add(props, offset)
		props.CFrame = rootCF * offset
		local p = newPart(props)
		p.Parent = model
		table.insert(parts, p)
		return p
	end

	if isSlime then
		add({ Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(3 * s, 3 * s, 3 * s), Color = bodyColor, Transparency = 0 },
			CFrame.new())
		for side = -1, 1, 2 do
			add({ Name = side < 0 and "EyeL" or "EyeR", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45 * s, 0.45 * s, 0.45 * s), Color = EYE_COLOR },
				CFrame.new(side * 0.5 * s, 0.35 * s, -1.33 * s))
		end
	else
		add({ Name = "Torso", Size = Vector3.new(2 * s, 2 * s, 1 * s), Color = darkColor }, CFrame.new())
		add({ Name = "Head", Size = Vector3.new(2 * s, 1 * s, 1 * s), Color = bodyColor }, CFrame.new(0, 1.5 * s, 0))
		add({ Name = "Left Arm", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = bodyColor }, CFrame.new(-1.5 * s, 0, 0))
		add({ Name = "Right Arm", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = bodyColor }, CFrame.new(1.5 * s, 0, 0))
		add({ Name = "Left Leg", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = darkColor }, CFrame.new(-0.5 * s, -2 * s, 0))
		add({ Name = "Right Leg", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = darkColor }, CFrame.new(0.5 * s, -2 * s, 0))
		for side = -1, 1, 2 do
			add({ Name = side < 0 and "EyeL" or "EyeR", Size = Vector3.new(0.3 * s, 0.3 * s, 0.05 * s), Color = EYE_COLOR },
				CFrame.new(side * 0.45 * s, 1.6 * s, -0.52 * s))
		end
	end

	-- A1 custom visual (procedural parts stay as an invisible hitbox)
	local visualParts = nil
	local template = getCustomTemplate(kind)
	if template then
		local ok, visual, vparts = pcall(buildCustomVisual, template, rootCF, bodyHeight, floorY)
		if ok and visual then
			for _, p in parts do p.Transparency = 1 end
			visual.Parent = model
			visualParts = vparts
			if golden then
				local h = Instance.new("Highlight")
				h.Name = "GoldenTint"
				h.FillColor = MC.GoldenColor
				h.FillTransparency = GOLDEN_FILL_TRANSPARENCY
				h.OutlineColor = MC.GoldenColor
				h.OutlineTransparency = 0.3
				h.DepthMode = Enum.HighlightDepthMode.Occluded
				h.Parent = visual
			end
		elseif not ok then
			warnThrottled("custom_" .. kind, "custom model for " .. kind .. " failed: " .. tostring(visual))
		end
	end

	if golden then
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "GoldenSparkle"
		pe.Color = ColorSequence.new(MC.GoldenColor)
		pe.Rate = 8
		pe.Lifetime = NumberRange.new(0.6, 1.1)
		pe.Speed = NumberRange.new(1, 3)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 0.8
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Parent = root
		local light = Instance.new("PointLight")
		light.Name = "GoldenLight"
		light.Color = MC.GoldenColor
		light.Range = 10 * s
		light.Brightness = 1.5
		light.Parent = root
	end

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = hip
	hum.WalkSpeed = def.Speed
	hum.AutoJumpEnabled = false
	hum.MaxSlopeAngle = MAX_SLOPE_ANGLE -- A11-R2
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.MaxHealth = 100
	hum.Health = 100
	hum.Parent = model

	local label = golden and ("황금 " .. def.Name) or def.Name
	local fill = makeBar(root, label, golden, topAboveRoot + 1.6)

	model:SetAttribute("MonsterKind", kind)
	model:SetAttribute("Golden", golden)
	-- body size for the client attack motion (lunge distance, lean pivot at the floor)
	model:SetAttribute("BodyHeight", bodyHeight)
	model:SetAttribute("RootHeight", rootY - floorY)

	return {
		Model = model,
		Root = root,
		VisualRoot = visualRoot,
		Humanoid = hum,
		Fill = fill,
		Parts = parts,
		VisualParts = visualParts,
		BodyHeight = bodyHeight,
		Hip = hip,
		Scale = s,
		RootOffset = rootY - floorY, -- root center height above the floor (used by PivotTo(Home))
	}
end

------------------------------------------------------------------ spawn / despawn
local function spawnMonster(kind, opts)
	local def = Config.MonsterTypes[kind]
	if not def then return nil end
	opts = opts or {}
	local owner = opts.Owner

	local golden
	if owner ~= nil or opts.Golden ~= nil then
		golden = opts.Golden == true
	else
		golden = Util.Random:NextNumber() < MC.GoldenChance
	end

	-- point is ON the ground (its Y = ground height); never assume a flat Part floor (A10/A11 Terrain world)
	local point = opts.Position
	if typeof(point) ~= "Vector3" then
		point = pickSpawnPoint(def)
		if not point then return nil end
	end
	local rig = buildRig(kind, def, golden, point, opts.FaceTo)

	local maxHP
	if type(opts.HP) == "number" and opts.HP > 0 and opts.HP == opts.HP then
		maxHP = opts.HP
	else
		maxHP = def.HP * (golden and MC.GoldenHPMult or 1)
	end

	if owner then
		rig.Model:SetAttribute("OwnerUserId", owner.UserId)
	end

	-- parent, weld (visible parts to VisualRoot, which is jointed to the root), network owner, humanoid states.
	-- Gameplay (hits, AI, knockback) only uses the root; parts follow it through the joints.
	rig.Model.Parent = getMonstersFolder()
	local anchor = rig.VisualRoot or rig.Root
	for _, p in rig.Parts do
		Util.Weld(anchor, p)
	end
	if rig.VisualParts then
		for _, p in rig.VisualParts do
			Util.Weld(anchor, p)
		end
	end
	pcall(rig.Root.SetNetworkOwner, rig.Root, nil)
	for _, st in DISABLED_STATES do
		pcall(rig.Humanoid.SetStateEnabled, rig.Humanoid, st, false)
	end

	-- A1: simple "alive" bob for custom visuals (moves the whole rig a little via HipHeight)
	local bob = nil
	if rig.VisualParts then
		local ok, tw = pcall(function()
			return TweenService:Create(
				rig.Humanoid,
				TweenInfo.new(BOB_PERIOD, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ HipHeight = rig.Hip + rig.BodyHeight * BOB_FRACTION }
			)
		end)
		if ok and tw then
			bob = tw
			tw:Play()
		end
	end

	nextId += 1
	local rec = {
		Id = nextId,
		Kind = kind,
		Def = def,
		ZoneId = def.Zone,
		Model = rig.Model,
		Root = rig.Root,
		Humanoid = rig.Humanoid,
		HP = maxHP,
		MaxHP = maxHP,
		Golden = golden,
		Home = point,
		Alive = true,
		Owner = owner,
		-- private
		_fill = rig.Fill,
		_bob = bob,
		_scale = rig.Scale,
		_rootOffset = rig.RootOffset,
		_contributors = {},
		_nextAttackAt = 0,
		_nextWanderAt = os.clock() + Util.Random:NextNumber(1, WANDER_MAX),
		_noAggroUntil = 0,
		_returning = false,
		_target = nil,
		_goal = nil, -- last MoveTo destination (stuck detection, A11-R5)
		_stuckAt = nil,
		_stuckPos = nil,
		_chaseStuck = 0,
		_detour = nil,
		_detourUntil = 0,
		_deepSince = nil, -- A10-V3-2 (c): when the root first went below DEEP_Y
		_windup = nil, -- A15: token of the attack being wound up (the hit lands REACT.WINDUP s after it started)
		_hurtAt = -math.huge, -- A15: os.clock() of the last HurtSeq bump
		_shoveReadyAt = 0, -- A15: os.clock() when the next shove is allowed
	}
	records[rec.Id] = rec
	return rec
end

local function emitDeathParticles(pos, color, scale)
	local fx = Instance.new("Part")
	fx.Name = "MonsterPop"
	fx.Anchored = true
	fx.CanCollide = false
	fx.CanQuery = false
	fx.CanTouch = false
	fx.Transparency = 1
	fx.Size = Vector3.new(1, 1, 1)
	fx.CFrame = CFrame.new(pos)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.4, 0.8)
	pe.Speed = NumberRange.new(8, 16)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -25, 0)
	pe.LightEmission = 0.4
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7 * scale), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = fx
	fx.Parent = Util.GetFolder(workspace, "Effects")
	pe:Emit(DEATH_PARTICLES)
	Debris:AddItem(fx, 1.5)
end

-- shrink/fade 0.3 s, particle burst, destroy after 0.4 s
local function deathPop(rec, withParticles)
	local model, root, hum = rec.Model, rec.Root, rec.Humanoid
	if rec._bob then
		pcall(function() rec._bob:Cancel() end)
		rec._bob = nil
	end
	if not model then return end
	if hum and hum.Parent then
		hum.WalkSpeed = 0
	end
	if root and root.Parent then
		root.Anchored = true
		local bar = root:FindFirstChild("MonsterBar")
		if bar then bar.Enabled = false end
		if withParticles then
			emitDeathParticles(root.Position, rec.Golden and MC.GoldenColor or rec.Def.Color, rec._scale or 1)
		end
	end
	local info = TweenInfo.new(DEATH_FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d ~= root and d.Name ~= VISUAL_ROOT_NAME then -- the invisible joint anchor keeps its size
				TweenService:Create(d, info, { Size = d.Size * 0.2, Transparency = 1 }):Play()
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Highlight") then
			d.Enabled = false
		end
	end
	task.delay(DEATH_DESTROY, function()
		if model then model:Destroy() end
	end)
end

local function removePersonalRef(rec)
	local owner = rec.Owner
	if not owner then return end
	local set = personal[owner]
	if set then
		set[rec] = nil
		if next(set) == nil then personal[owner] = nil end
	end
end

local scheduleRespawn -- forward

-- removes a record without rewards (timeout, owner left, model lost)
local function despawn(rec, fade)
	if not rec.Alive then return end
	rec.Alive = false
	records[rec.Id] = nil
	removePersonalRef(rec)
	if fade then
		deathPop(rec, false)
	elseif rec.Model then
		rec.Model:Destroy()
	end
end

scheduleRespawn = function(kind)
	pending[kind] = (pending[kind] or 0) + 1
	task.delay(MC.RespawnDelay, function()
		pending[kind] = math.max(0, (pending[kind] or 0) - 1)
		local ok, err = pcall(function()
			local target = cappedTargets()[kind] or targetCount(kind) -- CR-L13
			if aliveCountOf(kind) < target and totalNonPersonal() < GLOBAL_CAP then
				spawnMonster(kind)
			end
		end)
		if not ok then warnThrottled("respawn", err) end
	end)
end

------------------------------------------------------------------ damage / death
local function killRecord(rec)
	rec.Alive = false
	rec.HP = 0
	records[rec.Id] = nil
	updateBar(rec)

	local def = rec.Def
	local pos = (rec.Root and rec.Root.Parent) and rec.Root.Position or rec.Home
	local isPersonal = rec.Owner ~= nil
	local warPoints = 0
	if not isPersonal then
		warPoints = rec.Golden and Config.War.GoldenPoints or Config.War.MonsterPoints
	end
	local info = {
		Kind = rec.Kind,
		ZoneId = rec.ZoneId,
		Golden = rec.Golden,
		Position = pos,
		XP = def.XP * (rec.Golden and MC.GoldenXPMult or 1),
		Gold = def.Gold * (rec.Golden and MC.GoldenGoldMult or 1),
		WarPoints = warPoints,
		Personal = isPersonal,
	}

	-- CR-M18: every contributor keeps the full personal WarPoints, but one kill adds WarPoints to a faction pool only
	-- once: WarShare = WarPoints / (contributors of that faction) (WarService.AddPoints(player, n, poolN))
	local now = os.clock()
	local eligible, perFaction = {}, {}
	for p, t in rec._contributors do
		if p.Parent and now - t <= MC.ContributorWindow then
			local okF, f = pcall(factionOf, p)
			if not okF or type(f) ~= "string" then f = "None" end
			table.insert(eligible, { Player = p, Faction = f })
			perFaction[f] = (perFaction[f] or 0) + 1
		end
	end
	rec._contributors = {}
	for _, e in eligible do
		local i = table.clone(info)
		i.WarShare = info.WarPoints / math.max(1, perFaction[e.Faction] or 1)
		MonsterService.MonsterKilled:Fire(e.Player, i)
	end

	deathPop(rec, true)
	if isPersonal then
		removePersonalRef(rec)
	else
		scheduleRespawn(rec.Kind)
	end
end

-- A15: pain reaction for clients ("HurtBig" first, then "HurtSeq" +1), at most once per REACT.HURT_GAP s per monster
local function markHurt(rec, amount, crit)
	local now = os.clock()
	if now - rec._hurtAt < REACT.HURT_GAP then return end
	local model = rec.Model
	if not model or not model.Parent then return end
	rec._hurtAt = now
	local big = crit == true or (rec.MaxHP > 0 and amount >= rec.MaxHP * REACT.BIG_FRACTION)
	model:SetAttribute(HURT_BIG_ATTR, big)
	local seq = model:GetAttribute(HURT_SEQ_ATTR)
	model:SetAttribute(HURT_SEQ_ATTR, (type(seq) == "number" and seq or 0) + 1)
end

-- crit (optional): the hit was a critical hit (only used for the "HurtBig" pain reaction)
function MonsterService.DamageMonster(record, amount, player, crit)
	if type(record) ~= "table" or not record.Alive then return false end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then return false end
	if record.Owner and record.Owner ~= player then return false end -- A5-C2
	-- CR-M5: a zone monster takes no damage from a player standing outside its zone (no HP change, no contribution)
	if record.Owner == nil and player and zoneIdOf(player) ~= record.ZoneId then return false end
	if player then
		record._contributors[player] = os.clock()
	end
	record.HP -= amount
	if record.HP > 0 then
		updateBar(record)
		local okHurt, errHurt = pcall(markHurt, record, amount, crit)
		if not okHurt then warnThrottled("hurt", errHurt) end
		return false
	end
	killRecord(record) -- the killing hit plays the death pop instead of a pain reaction
	return true
end

function MonsterService.ApplyKnockback(record, fromPosition, power)
	if type(record) ~= "table" or not record.Alive then return end
	if typeof(fromPosition) ~= "Vector3" or type(power) ~= "number" then return end
	local root = record.Root
	if not root or not root.Parent or root.Anchored then return end
	local d = root.Position - fromPosition
	local flat = Vector3.new(d.X, 0, d.Z)
	local dir = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
	root.AssemblyLinearVelocity = dir * power + Vector3.new(0, 25, 0)
end

-- A15: shove sweep params (Terrain + every collidable part under workspace.Map; water ignored), rebuilt like the
-- ground params so a late MapBuilder pass is picked up
local shoveSweep = { Params = nil, At = -math.huge }
local function getShoveParams()
	local now = os.clock()
	if shoveSweep.Params and now - shoveSweep.At < GROUND_PARAMS_REFRESH then return shoveSweep.Params end
	local list = { workspace.Terrain }
	local map = workspace:FindFirstChild("Map")
	if map then table.insert(list, map) end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true -- invisible zone / pad volumes never block a shove
	end)
	shoveSweep.Params, shoveSweep.At = params, now
	return params
end

-- A15: subtle shove of a monster a player's hit landed on: the root slides `studs` (capped by REACT.SHOVE_MAX, divided
-- by the body scale so big monsters barely move) away from `fromPosition` over REACT.SHOVE_TIME. Skipped for anchored
-- (dying) roots, other players' personal monsters, a monster shoved less than REACT.SHOVE_GAP s ago, and whenever the
-- end point is not walkable ground (water / ridge / shore) in the zone the monster stands in (zone monsters: inside
-- their own zone rect inset by ZONE_MOVE_INSET, like every MoveTo). Returns true when a shove started.
function MonsterService.Shove(record, fromPosition, studs, player)
	if type(record) ~= "table" or not record.Alive then return false end
	if typeof(fromPosition) ~= "Vector3" then return false end
	if type(studs) ~= "number" or studs ~= studs or studs <= 0 then return false end
	if record.Owner and record.Owner ~= player then return false end -- A5-C2
	local now = os.clock()
	if now < record._shoveReadyAt then return false end
	local root = record.Root
	if not root or not root.Parent or root.Anchored then return false end

	local pos = root.Position
	local flat = Vector3.new(pos.X - fromPosition.X, 0, pos.Z - fromPosition.Z)
	if flat.Magnitude < 0.05 then
		local lv = root.CFrame.LookVector
		flat = Vector3.new(-lv.X, 0, -lv.Z) -- hit from right on top of it: push it backwards
		if flat.Magnitude < 0.05 then return false end
	end
	local dist = math.min(studs, REACT.SHOVE_MAX) / math.max(1, record._scale or 1)
	local delta = flat.Unit * dist
	local dest = pos + delta

	local here = Config.ZoneAt(pos).Id
	if Config.ZoneAt(dest).Id ~= here then return false end
	if record.Owner == nil then
		local zone = Config.Zones[record.ZoneId]
		if here ~= record.ZoneId or (zone and not insideZone(zone, dest, ZONE_MOVE_INSET)) then return false end
	end
	local g, noHit = groundPoint(dest.X, dest.Z)
	if not g and not noHit then return false end -- water / ridge / shore (noHit = bare test place: flat ground)
	-- never into a wall / gate / tree / rock / hillside at body height
	if workspace:Raycast(pos, delta + flat.Unit * 0.5, getShoveParams()) then return false end

	record._shoveReadyAt = now + REACT.SHOVE_GAP
	task.spawn(function()
		local ok, err = pcall(function()
			local done = 0
			while true do
				task.wait()
				if not record.Alive or not root.Parent or root.Anchored then break end
				local t = math.clamp((os.clock() - now) / math.max(REACT.SHOVE_TIME, 0.01), 0, 1)
				local f = 1 - (1 - t) * (1 - t) -- ease out
				root.CFrame = root.CFrame + delta * (f - done)
				done = f
				if t >= 1 then break end
			end
		end)
		if not ok then warnThrottled("shove", err) end
	end)
	return true
end

------------------------------------------------------------------ personal monsters (A4 / A5-C2..C4)
function MonsterService.SpawnPersonal(player, monsterId, opts)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then return nil end
	if type(monsterId) ~= "string" or Config.MonsterTypes[monsterId] == nil then return nil end
	if type(opts) ~= "table" then opts = {} end

	-- one living personal monster of a kind per player: reuse it
	local set = personal[player]
	if set then
		for rec in set do
			if rec.Alive and rec.Kind == monsterId and rec.Model and rec.Model.Parent then
				return rec.Model
			end
		end
	end

	-- ~8 studs in front of the player on walkable ground (then the sides / behind); fallback: the home-zone spawn
	local pos, faceTo
	local root = Util.GetRoot(player)
	if root then
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
		local base = root.Position
		for _, ang in { 0, math.pi / 2, -math.pi / 2, math.pi } do
			local c, s = math.cos(ang), math.sin(ang)
			local dir = Vector3.new(flat.X * c - flat.Z * s, 0, flat.X * s + flat.Z * c)
			local p = base + dir * PERSONAL_DISTANCE
			local g, noHit = groundPoint(p.X, p.Z)
			if g then
				pos = g
			elseif noHit then
				pos = Vector3.new(p.X, 0, p.Z) -- bare test place: legacy flat ground
			end
			if pos then break end
		end
		faceTo = base
	end
	if not pos then
		local faction = player:GetAttribute("Faction")
		local zone = Config.Zones[Config.HomeZoneId(type(faction) == "string" and faction or "None")] or Config.Zones.Crossroads
		local p = zone.Spawn + Vector3.new(0, 0, -PERSONAL_DISTANCE)
		local y, water = probeGround(p.X, p.Z)
		pos = Vector3.new(p.X, (y and not water) and y or 0, p.Z)
		faceTo = faceTo or zone.Spawn
	end

	local ok, rec = pcall(spawnMonster, monsterId, {
		Owner = player,
		Golden = opts.Golden == true,
		HP = tonumber(opts.HP),
		Position = pos,
		FaceTo = faceTo,
	})
	if not ok then
		warnThrottled("personal", rec)
		return nil
	end
	if not rec then return nil end

	personal[player] = personal[player] or {}
	personal[player][rec] = true

	task.delay(PERSONAL_LIFETIME, function()
		if rec.Alive then despawn(rec, true) end
	end)
	return rec.Model
end

local function onOwnerLeaving(player)
	local set = personal[player]
	if not set then return end
	personal[player] = nil
	for rec in set do
		if rec.Alive then
			rec.Alive = false
			records[rec.Id] = nil
			if rec.Model then rec.Model:Destroy() end
		end
	end
end

------------------------------------------------------------------ AI
local function findInfo(plist, player)
	for _, info in plist do
		if info.Player == player then return info end
	end
	return nil
end

-- A10-V3-2 (a) + A3-M4: a player this (non-personal) monster may chase: in the monster's own zone, not in a town,
-- not in the water
local function targetable(rec, info)
	return not info.Town and info.Zone == rec.ZoneId and info.Pos.Y >= OUT_Y
end

-- turns the root (whole assembly) toward the target on the floor plane when it is far off the look direction
local function faceTarget(rec, targetPos)
	local root = rec.Root
	if root.Anchored then return end
	local pos = root.Position
	local flat = Vector3.new(targetPos.X - pos.X, 0, targetPos.Z - pos.Z)
	if flat.Magnitude < 0.1 then return end
	local dir = flat.Unit
	if root.CFrame.LookVector:Dot(dir) >= FACE_TARGET_DOT then return end
	root.CFrame = CFrame.lookAt(pos, pos + dir)
end

-- A15: the wound-up hit lands only if this wind-up is still the current one, the monster is alive and in the world
-- and the target is alive, still a valid target (owner / zone / town / water rules) and within AttackRange + leeway.
-- Bumps AttackSeq at the impact (clients play the lunge), then deals the damage.
local function landAttack(rec, token, target)
	if rec._windup ~= token then return end
	rec._windup = nil
	if not rec.Alive or records[rec.Id] ~= rec then return end
	local model, root = rec.Model, rec.Root
	if not model or not model.Parent or not root or not root.Parent or root.Anchored then return end
	if typeof(target) ~= "Instance" or not target:IsA("Player") or target.Parent == nil or not Util.IsAlive(target) then
		return
	end
	local troot = Util.GetRoot(target)
	if not troot then return end
	local tpos = troot.Position
	if Util.FlatDistance(root.Position, tpos) > MC.AttackRange + REACT.WINDUP_LEEWAY then return end
	if rec.Owner then
		if target ~= rec.Owner or tpos.Y < OUT_Y or isPlayerInTown(target, tpos) then return end
	else
		if rec._returning then return end
		local info = { Pos = tpos, Town = isPlayerInTown(target, tpos), Zone = Config.ZoneAt(tpos).Id }
		if not targetable(rec, info) then return end
	end

	-- the client lunge goes along the look direction: face where the target is now
	local okFace, errFace = pcall(faceTarget, rec, tpos)
	if not okFace then warnThrottled("face", errFace) end
	local seq = model:GetAttribute(ATTACK_SEQ_ATTR)
	model:SetAttribute(ATTACK_SEQ_ATTR, (type(seq) == "number" and seq or 0) + 1)
	if S and S.CombatService then
		S.CombatService.DamagePlayer(target, rec.Def.Damage, nil)
	end
end

-- in reach: stand still and start a wind-up when the cooldown allows (the cooldown counts from the wind-up start; one
-- wind-up at a time, so a monster never hits twice for one attack)
local function attack(rec, info, now)
	rec._goal = nil
	rec.Humanoid:MoveTo(rec.Root.Position)
	if rec._windup ~= nil or now < rec._nextAttackAt then return end
	rec._nextAttackAt = now + MC.AttackCooldown
	-- the wind-up pose leans along the look direction, so face the target first
	local okFace, errFace = pcall(faceTarget, rec, info.Pos)
	if not okFace then warnThrottled("face", errFace) end
	local model = rec.Model
	if model then
		model:SetAttribute(WINDUP_AT_ATTR, workspace:GetServerTimeNow())
	end
	local token = {}
	rec._windup = token
	local target = info.Player
	task.delay(REACT.WINDUP, function()
		local ok, err = pcall(landAttack, rec, token, target)
		if rec._windup == token then rec._windup = nil end -- landAttack threw before clearing it
		if not ok then warnThrottled("attack", err) end
	end)
end

-- A10-V3-2 (c): put the monster back on its home point (sunk in water / cannot walk back)
local function pivotHome(rec)
	local root = rec.Root
	local p = rec.Home + Vector3.new(0, rec._rootOffset or 3, 0)
	local lv = root.CFrame.LookVector
	local flat = Vector3.new(lv.X, 0, lv.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
	rec.Model:PivotTo(CFrame.lookAt(p, p + flat.Unit))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	rec.Humanoid:MoveTo(p)
	rec._goal = nil
	rec._stuckAt = nil
	rec._detour = nil
	rec._deepSince = nil
end

-- A10-V3-2 (c): below DEEP_Y for more than DEEP_SECONDS -> PivotTo(Home). Returns true when it teleported.
local function deepRecovery(rec, pos, now)
	if pos.Y >= DEEP_Y then
		rec._deepSince = nil
		return false
	end
	if rec._deepSince == nil then
		rec._deepSince = now
		return false
	end
	if now - rec._deepSince > DEEP_SECONDS then
		pivotHome(rec)
		return true
	end
	return false
end

-- A11-R5: true when the monster moved < STUCK_MIN_MOVE during the last STUCK_WINDOW s while trying to move
local function isStuck(rec, pos, now, trying)
	if not trying then
		rec._stuckAt = nil
		return false
	end
	if rec._stuckAt == nil then
		rec._stuckAt, rec._stuckPos = now, pos
		return false
	end
	if now - rec._stuckAt < STUCK_WINDOW then return false end
	local moved = Util.FlatDistance(pos, rec._stuckPos)
	rec._stuckAt, rec._stuckPos = now, pos
	return moved < STUCK_MIN_MOVE
end

-- A11-R5: a short sideways detour (8-14 studs, 60-150 deg off the blocked direction) on walkable ground in the zone
local function startDetour(rec, zone, pos, goal, now)
	local to = goal and Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z) or Vector3.zero
	local baseAng = to.Magnitude > 0.01 and math.atan2(to.Z, to.X) or Util.Random:NextNumber(0, math.pi * 2)
	for _ = 1, DETOUR_TRIES do
		local side = Util.Random:NextNumber() < 0.5 and -1 or 1
		local a = baseAng + side * Util.Random:NextNumber(math.rad(60), math.rad(150))
		local r = Util.Random:NextNumber(DETOUR_MIN, DETOUR_MAX)
		local p = clampToZone(zone, Vector3.new(pos.X + math.cos(a) * r, pos.Y, pos.Z + math.sin(a) * r))
		local g, noHit = groundPoint(p.X, p.Z)
		if noHit then g = p end
		if g and Util.FlatDistance(g, pos) > ARRIVE_DIST then
			rec._detour = g
			rec._detourUntil = now + DETOUR_SECONDS
			return
		end
	end
	rec._detour = nil
end

-- every non-personal MoveTo goes through here; `dest` is already clamped into the zone (A10-V3-2 b)
local function steer(rec, dest, pos, now)
	local d = rec._detour
	if d then
		if now < rec._detourUntil and Util.FlatDistance(pos, d) > ARRIVE_DIST then
			dest = d
		else
			rec._detour = nil
		end
	end
	rec._goal = dest
	rec.Humanoid:MoveTo(dest)
end

-- wander point within WANDER_RADIUS of Home, clamped into the zone and on walkable ground (never water / ridge)
local function pickWanderPoint(rec, zone)
	for _ = 1, WANDER_TRIES do
		local a = Util.Random:NextNumber(0, math.pi * 2)
		local r = Util.Random:NextNumber(0, WANDER_RADIUS)
		local p = clampToZone(zone, rec.Home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		local g, noHit = groundPoint(p.X, p.Z)
		if g then return g end
		if noHit then return p end -- bare test place without Terrain / Map.Ground: legacy flat behaviour
	end
	return nil
end

local function personalStep(rec, plist, now, pos)
	local owner = rec.Owner
	if owner.Parent == nil then
		despawn(rec, false)
		return
	end
	local info = findInfo(plist, owner)
	if not info or info.Town or info.Pos.Y < OUT_Y then
		rec.Humanoid:MoveTo(pos) -- sandbag: stand still (also never follow the owner into the water)
		return
	end
	local d = Util.FlatDistance(pos, info.Pos)
	if d > PERSONAL_FOLLOW_RADIUS then
		rec.Humanoid:MoveTo(pos)
	elseif d <= MC.AttackRange then
		attack(rec, info, now)
	else
		rec.Humanoid:MoveTo(info.Pos)
	end
end

local function aiStep(rec, plist, now)
	local root, hum = rec.Root, rec.Humanoid
	if not root or not root.Parent or not hum or not hum.Parent or not rec.Model or not rec.Model.Parent then
		-- model lost (destroyed externally / fell out of the world)
		local kind, wasPersonal = rec.Kind, rec.Owner ~= nil
		despawn(rec, false)
		if not wasPersonal then scheduleRespawn(kind) end
		return
	end
	local pos = root.Position

	-- A10-V3-2 (c): sunk deep (water, knocked off a cliff) for > 2 s -> back home. Also for personal monsters.
	if deepRecovery(rec, pos, now) then return end

	if rec.Owner then
		personalStep(rec, plist, now, pos)
		return
	end

	local zone = Config.Zones[rec.ZoneId]
	local homeDist = Util.FlatDistance(pos, rec.Home)

	-- A10-V3-2 (c): out of its own zone (knockback, slid off) or in the water -> walk home, no re-aggro for 3 s.
	-- If it makes no progress (river bank, cliff) it is put back home.
	if Config.ZoneAt(pos).Id ~= rec.ZoneId or pos.Y < OUT_Y then
		rec._target = nil
		rec._returning = true
		rec._detour = nil
		rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
		if isStuck(rec, pos, now, homeDist > ARRIVE_DIST) then
			pivotHome(rec)
			return
		end
		local homeDest = clampToZone(zone, rec.Home)
		rec._goal = homeDest
		hum:MoveTo(homeDest)
		return
	end

	-- leash: go home and do not re-aggro for a moment (anti-jitter). (A monster standing in a town is out of its zone
	-- and already handled above.)
	if homeDist > MC.LeashRadius then
		rec._returning = true
		rec._target = nil
		rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
	end

	-- A3-M4 / A10-V3-2 (a): the current target stepped into a town, left this zone or went into the water
	-- -> return home, no re-aggro for 3 s
	if rec._target then
		local tinfo = findInfo(plist, rec._target)
		if not tinfo then
			rec._target = nil
		elseif not targetable(rec, tinfo) then
			rec._target = nil
			rec._returning = true
			rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
		end
	end

	-- A11-R5: stuck on terrain while moving -> pick a different destination
	local trying = rec._goal ~= nil and Util.FlatDistance(pos, rec._goal) > ARRIVE_DIST
	if isStuck(rec, pos, now, trying) then
		if rec._returning then
			startDetour(rec, zone, pos, rec.Home, now)
		elseif rec._target then
			rec._chaseStuck += 1
			if rec._chaseStuck >= CHASE_STUCK_GIVEUP then
				-- the target is unreachable (ridge slope etc.): give up, go home, no re-aggro for a moment
				rec._chaseStuck = 0
				rec._target = nil
				rec._returning = true
				rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
			else
				startDetour(rec, zone, pos, rec._goal, now)
			end
		else
			rec._goal = nil
			rec._detour = nil
			rec._nextWanderAt = now -- wander somewhere else right away
		end
	end

	if rec._returning then
		if homeDist <= RETURN_DONE_DIST or (now >= rec._noAggroUntil and homeDist <= MC.LeashRadius * 0.75) then
			rec._returning = false
		else
			steer(rec, clampToZone(zone, rec.Home), pos, now)
			return
		end
	end

	-- target = nearest alive player within AggroRadius standing in THIS zone, outside towns and water (A10-V3-2 a)
	local best, bestD = nil, nil
	if now >= rec._noAggroUntil then
		for _, info in plist do
			if targetable(rec, info) then
				local d = Util.FlatDistance(pos, info.Pos)
				if d <= MC.AggroRadius and (bestD == nil or d < bestD) then
					best, bestD = info, d
				end
			end
		end
	end

	if best then
		if rec._target ~= best.Player then rec._chaseStuck = 0 end
		rec._target = best.Player
		if bestD <= MC.AttackRange then
			rec._chaseStuck = 0
			attack(rec, best, now)
		else
			steer(rec, clampToZone(zone, best.Pos), pos, now) -- A10-V3-2 (b)
		end
		return
	end

	rec._target = nil
	if now >= rec._nextWanderAt then
		rec._nextWanderAt = now + Util.Random:NextNumber(WANDER_MIN, WANDER_MAX)
		local dest = pickWanderPoint(rec, zone)
		if dest then
			rec._detour = nil
			steer(rec, dest, pos, now)
		end
	end
end

local function aiTick()
	local now = os.clock()
	local plist = {}
	for _, p in readyPlayers() do
		if p.Parent and Util.IsAlive(p) then
			local root = Util.GetRoot(p)
			if root then
				local pos = root.Position
				table.insert(plist, { Player = p, Pos = pos, Town = isPlayerInTown(p, pos), Zone = Config.ZoneAt(pos).Id })
			end
		end
	end
	local list = {}
	for _, rec in records do
		table.insert(list, rec)
	end
	for _, rec in list do
		if rec.Alive then
			local ok, err = pcall(aiStep, rec, plist, now)
			if not ok then warnThrottled("ai", err) end
		end
	end
end

------------------------------------------------------------------ density (A3-M2 / A5-C1)
local function reevaluate()
	local zoneCounts = playersPerZone()
	local targets = cappedTargets(zoneCounts) -- CR-L13
	local total = totalNonPersonal()
	for _, kind in Config.MonsterTypeOrder do
		if total >= GLOBAL_CAP then break end
		local target = targets[kind] or targetCount(kind, zoneCounts)
		local have = aliveCountOf(kind) + (pending[kind] or 0)
		local spawned = 0
		while have < target and total < GLOBAL_CAP and spawned < MAX_SPAWNS_PER_KIND_PER_PASS do
			local rec = spawnMonster(kind)
			if not rec then break end
			have += 1
			total += 1
			spawned += 1
		end
	end
end

------------------------------------------------------------------ lifecycle
function MonsterService.Init(registry)
	S = registry
	getMonstersFolder()
	Util.GetFolder(workspace, "Effects")
	Util.GetFolder(ServerStorage, CUSTOM_FOLDER) -- A1: may stay empty
	if S.PlayerService and S.PlayerService.PlayerLeaving then
		S.PlayerService.PlayerLeaving:Connect(function(player)
			onOwnerLeaving(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		onOwnerLeaving(player)
	end)
end

function MonsterService.Start()
	for _, id in Config.MonsterTypeOrder do
		print(("[MonsterService] custom model for %s: %s"):format(id, getCustomTemplate(id) and "yes" or "no"))
	end

	local total = 0
	for _, kind in Config.MonsterTypeOrder do
		local def = Config.MonsterTypes[kind]
		if def then
			for _ = 1, def.Count do
				if total >= GLOBAL_CAP then break end
				local ok, rec = pcall(spawnMonster, kind)
				if ok and rec then
					total += 1
				elseif not ok then
					warnThrottled("spawn_" .. kind, rec)
				end
			end
		end
	end

	task.spawn(function()
		while true do
			task.wait(MC.AIInterval)
			local ok, err = pcall(aiTick)
			if not ok then warnThrottled("aiLoop", err) end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(REEVAL_INTERVAL)
			local ok, err = pcall(reevaluate)
			if not ok then warnThrottled("density", err) end
		end
	end)

	print("[MonsterService] started")
end

return MonsterService
