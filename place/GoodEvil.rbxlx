				<ProtectedString name="Source"><![CDATA[-- Globally unique, broadcast-filtered game nicknames. Roblox account names are never modified.
-- A user directory + durable operation token recover uncertain writes without blind retries.
-- Old claims remain owned by that user: no delayed rollback can free somebody else's name.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local NicknameService = {}
local S = nil
local store = nil
local states = {}
local MESSAGES = {
	Active = "닉네임을 저장했어요.", Available = "닉네임을 정할 수 있어요.",
	Invalid = "닉네임은 2~20글자로 입력해 주세요. 숨은 문자·줄바꿈·#·<·>·&는 사용할 수 없어요.",
	Filtered = "이 닉네임은 사용할 수 없어요. 다른 이름을 입력해 주세요.",
	Taken = "이미 사용 중인 닉네임이에요.", Busy = "닉네임을 확인하고 있어요.",
	Unknown = "저장 결과를 확인하지 못했어요. 기존 닉네임을 유지했어요. 다시 누르면 먼저 확인해요.",
	Unavailable = "닉네임 저장소에 연결할 수 없어요. 기존 닉네임을 유지했어요.",
	FilterUnavailable = "닉네임 필터에 연결할 수 없어요. 잠시 뒤 다시 시도해 주세요.",
	Recovered = "이전 저장 결과를 확인했어요. 변경하려면 다시 눌러 주세요.",
	Cooldown = "잠시 뒤 닉네임을 다시 변경해 주세요.", Loading = "닉네임을 불러오고 있어요.",
}

-- A bounded supplemental policy, not a language model or a replacement for Roblox filtering.
-- Match complete risky phrases or an explicit target + abusive action. Never ban syllables such
-- as 성/신/교, ordinary affection, fantasy class names, or a religion's name alone.
-- Sources: https://create.roblox.com/docs/ui/text-filtering
--          https://about.roblox.com/community-standards
local POLICY = {
	Korean = {
		"성관계", "성행위", "성매매", "음란물", "야동", "포르노", "섹스", "강간",
		"알몸사진", "벗은사진", "누드사진", "나체사진", "야한사진보내", "미성년자성착취",
		"예수믿어", "예수를믿", "예수믿으", "예수믿자", "예수천국", "불신지옥",
		"하나님믿", "하느님믿", "알라믿", "부처믿", "교회오세요", "교회나와",
		"종교가입해", "종교가입하", "개종해라", "개종하세요", "개종하라",
		"무료로벅스", "공짜로벅스", "로벅스무료", "로벅스공짜", "로벅스복사",
		"비밀번호입력", "비번입력", "비밀번호알려", "비번알려", "인증번호줘", "토큰보내",
		"전화번호줘", "폰번호줘", "카톡아이디", "디코아이디", "인스타아이디",
		"디스코드와", "디코로와", "카톡으로와", "우리집주소", "집주소는", "계좌번호",
		"공식운영자", "진짜운영자", "공식관리자", "공식개발자", "공식GM",
		"로블록스운영", "로블록스관리", "로블록스직원", "로블록스본사",
		"깜둥이", "짱깨", "씨발", "자살해라", "자살하세요", "자해해라",
	},
	KoreanTargets = {
		"기독교", "불교", "천주교", "이슬람", "힌두교", "유대인", "무슬림",
		"흑인", "백인", "아시아인", "여자", "남자", "장애인", "동성애자",
	},
	KoreanAbuse = { "죽어", "죽여", "죽이자", "박멸", "추방", "꺼져", "쓰레기", "열등", "멸종" },
	EnglishWords = { "sex", "porn", "porno", "nudes", "rape", "rapist", "nigger", "faggot" },
	EnglishPhrases = {
		"sex master", "sex slave", "sex king", "sex queen", "porn star", "porn hub", "child porn",
		"send nudes", "nudes please", "want nudes", "nude photos", "naked photos", "jesus saves", "believe in jesus", "accept jesus",
		"convert to islam", "convert to christ", "join my church", "join our church", "join my religion",
		"free robux", "robux generator", "send password", "give password", "password please",
		"send otp", "send token", "add me discord", "discord me", "kill yourself", "hurt yourself",
		"official admin", "official developer", "official moderator", "real admin", "roblox staff",
		"roblox admin", "roblox moderator", "roblox employee", "game admin", "game moderator",
	},
	EnglishTargets = { "christians", "muslims", "jews", "hindus", "buddhists", "black people", "white people", "asians", "women", "men", "gay people", "disabled people" },
	EnglishAbuse = { "kill", "exterminate", "death to" },
	EnglishDegrade = { "die", "are trash", "are inferior" },
	Reserved = { "운영자", "관리자", "개발자", "게임운영자", "공식운영자", "gm", "admin", "moderator", "developer", "gamemaster" },
	Domains = { "com", "net", "org", "gg", "io", "kr", "me" },
}

local function policyForms(text)
	-- Only the comparison copy folds full-width ASCII/camel case/separators. Display and the
	-- global canonical stay unchanged; no Unicode normalization changes ownership semantics.
	local chars = {}
	for _, cp in utf8.codes(text) do
		if cp >= 0xFF01 and cp <= 0xFF5E then cp -= 0xFEE0 end
		chars[#chars + 1] = utf8.char(cp)
	end
	local folded = table.concat(chars)
	local words = string.gsub(folded, "(%l)(%u)", "%1 %2")
	words = string.lower(words)
	words = string.gsub(words, "[ _%.%-]+", " ")
	local compact = string.lower(string.gsub(folded, "[ _%.%-]+", ""))
	return string.lower(folded), words, compact
end

local function englishPhrase(text, phrase)
	-- ASCII letter boundaries avoid the classic substring false positives (Essex/Scunthorpe).
	-- Numeric decorations do not make an explicit phrase safe.
	local from = 1
	while true do
		local first, last = string.find(text, phrase, from, true)
		if not first then return false end
		local before, after = string.sub(text, first - 1, first - 1), string.sub(text, last + 1, last + 1)
		if not string.find(before, "[a-z]") and not string.find(after, "[a-z]") then return true end
		from = last + 1
	end
end

local function englishRisk(words, compact, phrase)
	return englishPhrase(words, phrase) or englishPhrase(compact, string.gsub(phrase, " ", ""))
end

local function policyAllowed(text)
	local folded, words, compact = policyForms(text)
	if not Util.ValidateNickname(folded) then return false end
	for _, phrase in POLICY.Korean do
		if string.find(compact, string.lower(phrase), 1, true) then return false end
	end
	for _, target in POLICY.KoreanTargets do
		for _, abuse in POLICY.KoreanAbuse do
			if string.find(compact, target .. abuse, 1, true)
				or string.find(compact, target .. "는" .. abuse, 1, true)
				or string.find(compact, target .. "은" .. abuse, 1, true)
				or string.find(compact, target .. "을" .. abuse, 1, true)
				or string.find(compact, target .. "를" .. abuse, 1, true) then return false end
		end
	end
	for _, phrase in POLICY.EnglishWords do if englishRisk(words, compact, phrase) then return false end end
	for _, phrase in POLICY.EnglishPhrases do if englishRisk(words, compact, phrase) then return false end end
	for _, target in POLICY.EnglishTargets do
		for _, abuse in POLICY.EnglishAbuse do
			if englishRisk(words, compact, abuse .. " " .. target) then return false end
		end
		for _, abuse in POLICY.EnglishDegrade do
			if englishRisk(words, compact, target .. " " .. abuse) then return false end
		end
	end
	for _, role in POLICY.Reserved do
		if compact == role or string.match(compact, "^" .. role .. "%d+$") then return false end
	end
	-- Match contact/credential shapes, not all long numeric nicknames or all mentions of a phone.
	if string.find(folded, "%S+@%S+%.%w+") or string.find(folded, "https?://")
		or string.find(folded, "www%.") then return false end
	for phone in string.gmatch(folded, "%+%d[%d %.%-]+%d") do
		local digits = string.gsub(phone, "%D", "")
		if #digits >= 8 and #digits <= 15 then return false end
	end
	for _, domain in POLICY.Domains do
		if string.find(folded, "[%w%-]+%." .. domain .. "%f[^a-z]") then return false end
	end
	for number in string.gmatch(compact, "%d+") do
		if #number == 11 and string.match(number, "^01[016789]") then return false end
	end
	if string.find(folded, "%d%d%d[%s%.%-]%d%d%d%d?[%s%.%-]%d%d%d%d")
		or string.find(folded, "%d%d%d%d%d%d%-[1-4]%d%d%d%d%d%d")
		or string.find(folded, "%d%d%d%d[%s%-]%d%d%d%d[%s%-]%d%d%d%d[%s%-]%d%d%d%d") then return false end
	return true
end

local function live(player, st)
	return states[player] == st and player.Parent == Players and S.PlayerService.IsReady(player)
end

local function status(player, code)
	if player.Parent == Players then player:SetAttribute("NicknameStatus", code) end
end

local function reply(player, code)
	if player.Parent ~= Players then return end
	status(player, code)
	Net.Get("NicknameResult"):FireClient(player, {
		Status = code, Message = MESSAGES[code] or MESSAGES.Unavailable,
		Nickname = player:GetAttribute("NicknameVerified") == true and player:GetAttribute("Nickname") or "",
	})
end

local function tokenValid(token)
	return type(token) == "string" and #token >= 16 and #token <= 80 and not string.find(token, "[^%w%-]")
end

local function identityValid(identity, active)
	if type(identity) ~= "table" or not Util.ValidateNickname(identity.Text)
		or identity.Canonical ~= Util.NicknameCanonical(identity.Text) or not tokenValid(identity.Token) then return false end
	return not active or tokenValid(identity.ClaimToken)
end

local function directoryValid(directory, userId)
	return type(directory) == "table" and directory.Version == 1 and directory.UserId == userId
		and type(directory.Revision) == "number" and directory.Revision >= 0
		and directory.Revision == math.floor(directory.Revision) and directory.Revision < 1e12
		and (directory.Active == nil or identityValid(directory.Active, true))
		and (directory.Pending == nil or identityValid(directory.Pending, false))
end

local function newDirectory(userId)
	return { Version = 1, UserId = userId, Revision = 0 }
end

local function userKey(userId)
	return "U_" .. tostring(userId)
end

local function claimKey(canonical)
	-- Bounded ASCII key (<50 bytes). Hash collisions fail closed via the full canonical value below.
	-- Both products stay below 2^53, preserving exact integer arithmetic in Luau numbers.
	local a, b = 5381, 0
	for i = 1, #canonical do
		local byte = string.byte(canonical, i)
		a = (a * 33 + byte) % 4294967296
		b = (b * 131 + byte) % 4294967296
	end
	return string.format("N_%08x%08x_%d", a, b, #canonical)
end

local function readFresh(key)
	-- No cached read may decide whether an uncertain write happened.
	return pcall(function()
		local options = Instance.new("DataStoreGetOptions")
		options.UseCache = false
		return store:GetAsync(key, options)
	end)
end

local function update(key, transform)
	-- Exactly one call. An exception is Unknown, never proof that the write failed.
	return pcall(store.UpdateAsync, store, key, transform)
end

local function filtered(player, raw)
	if not Util.ValidateNickname(raw) then return nil, "Invalid" end
	if not policyAllowed(raw) then return nil, "Filtered" end
	local ok, text = pcall(function()
		local result = TextService:FilterStringAsync(raw, player.UserId, Enum.TextFilterContext.PublicChat)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then return nil, "FilterUnavailable" end
	-- Use the broadcast result for both the visible text and the global canonical claim.
	if not Util.ValidateNickname(text) or not policyAllowed(text) then return nil, "Filtered" end
	return text
end

local function claimMatches(claim, userId, canonical, token)
	return type(claim) == "table" and claim.Version == 1 and claim.UserId == userId
		and claim.Canonical == canonical and tokenValid(claim.Token) and (token == nil or claim.Token == token)
end

local function applyName(player, st, text)
	if not live(player, st) then return end
	S.PlayerService.SetStat(player, "Nickname", text or "") -- filtered cache only, not the uniqueness authority
	player:SetAttribute("Nickname", text or "")
	player:SetAttribute("NicknameVerified", text ~= nil)
	local humanoid = Util.GetHumanoid(player)
	if humanoid then pcall(function() humanoid.DisplayName = Util.PlayerDisplayName(player) end) end
end

local function showActive(player, st, active)
	if not active then applyName(player, st, nil); return "Available" end
	local ok, claim = readFresh(claimKey(active.Canonical))
	if not ok then return "Unavailable" end
	if not claimMatches(claim, player.UserId, active.Canonical, active.ClaimToken) then return "Unavailable" end
	local text, why = filtered(player, active.Text)
	if not text then return why end
	-- If today's filter transforms an old name, do not display it under somebody else's canonical claim.
	if text ~= active.Text then return "Filtered" end
	applyName(player, st, text)
	return "Active"
end

local function clearPending(player, pending)
	local ok, directory = update(userKey(player.UserId), function(old)
		if not directoryValid(old, player.UserId) then return nil end
		if not old.Pending or old.Pending.Token ~= pending.Token then return old end
		local nextDirectory = Util.DeepCopy(old)
		nextDirectory.Pending = nil
		nextDirectory.Revision += 1
		return nextDirectory
	end)
	return ok and directoryValid(directory, player.UserId) and directory.Pending == nil
end

local function finishPending(player, st, pending)
	-- Recovery re-filters persisted text. Only a still-identical broadcast result may complete this intent.
	local text, why = filtered(player, pending.Text)
	if not text then
		if why == "Filtered" or why == "Invalid" then
			return clearPending(player, pending) and "Filtered" or "Unknown"
		end
		return why
	end
	if text ~= pending.Text then
		return clearPending(player, pending) and "Filtered" or "Unknown"
	end
	local key = claimKey(pending.Canonical)
	local okRead, claim = readFresh(key)
	if not okRead then return "Unknown" end
	if claim == nil then
		local okClaim
		okClaim, claim = update(key, function(old)
			if old ~= nil then return old end
			return { Version = 1, UserId = player.UserId, Canonical = pending.Canonical, Token = pending.Token }
		end)
		if not okClaim then return "Unknown" end
	end
	if not claimMatches(claim, player.UserId, pending.Canonical) then
		-- Cancel only this user's exact intent. Claims themselves are never removed or overwritten.
		return clearPending(player, pending) and "Taken" or "Unknown"
	end
	local okCommit, directory = update(userKey(player.UserId), function(old)
		if not directoryValid(old, player.UserId) then return nil end
		if not old.Pending or old.Pending.Token ~= pending.Token then return old end
		if old.Pending.Canonical ~= pending.Canonical or old.Pending.Text ~= pending.Text then return nil end
		local nextDirectory = Util.DeepCopy(old)
		nextDirectory.Active = {
			Text = text, Canonical = pending.Canonical, Token = pending.Token, ClaimToken = claim.Token,
		}
		nextDirectory.Pending = nil
		nextDirectory.Revision += 1
		return nextDirectory
	end)
	if not okCommit or not directoryValid(directory, player.UserId) or directory.Pending ~= nil
		or not directory.Active or directory.Active.Token ~= pending.Token
		or directory.Active.ClaimToken ~= claim.Token or directory.Active.Canonical ~= pending.Canonical then
		return "Unknown"
	end
	applyName(player, st, text)
	return "Active"
end

local function resolve(player, st)
	local ok, directory = readFresh(userKey(player.UserId))
	if not ok then return "Unknown" end
	if directory == nil then directory = newDirectory(player.UserId) end
	if not directoryValid(directory, player.UserId) then return "Unknown" end
	local activeStatus = showActive(player, st, directory.Active)
	if directory.Pending then return finishPending(player, st, directory.Pending) end
	return activeStatus
end

local function available()
	return store ~= nil and S.DataService.IsPersistentReady()
end

function NicknameService.SetNickname(player, raw)
	if not S.PlayerService.IsReady(player) or player.Parent ~= Players then return end
	local st = states[player]
	if not st or not st.Loaded then reply(player, "Loading"); return end
	if not Util.ValidateNickname(raw) then reply(player, "Invalid"); return end
	if st.Busy then reply(player, "Busy"); return end
	if not Util.RateLimit(player, "SetNickname", Config.Nickname.ChangeInterval) then reply(player, "Cooldown"); return end
	if not available() then reply(player, "Unavailable"); return end
	st.Busy = true
	status(player, "Busy")
	local ok, code = pcall(function()
		if st.Unknown then
			-- Resolve the previous token first. This call never starts the newly supplied request.
			local result = resolve(player, st)
			st.Unknown = result == "Unknown" or result == "FilterUnavailable"
			return (result == "Active" or result == "Available") and "Recovered" or result
		end
		local text, why = filtered(player, raw)
		if not text then return why end
		local okRead, directory = readFresh(userKey(player.UserId))
		if not okRead then return "Unavailable" end
		if directory == nil then directory = newDirectory(player.UserId) end
		if not directoryValid(directory, player.UserId) then st.Unknown = true; return "Unknown" end
		if directory.Pending then
			st.Unknown = true
			return "Unknown" -- an existing intent is resolved on the next explicit request
		end
		local pending = { Text = text, Canonical = Util.NicknameCanonical(text), Token = HttpService:GenerateGUID(false) }
		local revision = directory.Revision
		local okBegin, result = update(userKey(player.UserId), function(old)
			if old == nil then old = newDirectory(player.UserId) end
			if not directoryValid(old, player.UserId) then return nil end
			if old.Pending or old.Revision ~= revision then return old end
			local nextDirectory = Util.DeepCopy(old)
			nextDirectory.Pending = pending -- contains only the filtered broadcast text
			nextDirectory.Revision += 1
			return nextDirectory
		end)
		if not okBegin or not directoryValid(result, player.UserId) or not result.Pending
			or result.Pending.Token ~= pending.Token then st.Unknown = true; return "Unknown" end
		local final = finishPending(player, st, result.Pending)
		st.Unknown = final == "Unknown" or final == "FilterUnavailable"
		return final
	end)
	if not ok then st.Unknown = true; code = "Unknown" end
	st.Busy = false
	if live(player, st) then reply(player, code) end
end

local function load(player)
	local st = { Busy = true, Loaded = false, Unknown = false }
	states[player] = st
	local code = "Unavailable"
	if available() then
		local ok, result = pcall(resolve, player, st)
		code = ok and result or "Unknown"
		st.Unknown = code == "Unknown" or code == "FilterUnavailable"
	end
	st.Busy = false
	st.Loaded = true
	if live(player, st) then status(player, code) end
end

function NicknameService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player) task.spawn(load, player) end)
	S.PlayerService.PlayerLeaving:Connect(function(player) states[player] = nil end)
	S.PlayerService.CharacterSpawned:Connect(function(player, _, humanoid)
		pcall(function() humanoid.DisplayName = Util.PlayerDisplayName(player) end)
	end)
end

function NicknameService.Start()
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, Config.Nickname.StoreName)
	if ok then store = result end
	Net.Get("SetNickname").OnServerEvent:Connect(NicknameService.SetNickname)
	print("[NicknameService] started")
end

return NicknameService
]]></ProtectedString>
				<string name="ScriptGuid">{152795C1-4BF0-497E-8E8D-40E3CD65A14B}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">NicknameService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">718623eb9e7784d40ad29b0d000008d7</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5D7D4585F1DE4E2E847F1A82AA6266E9">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- GrudgeService.luau : the grudge sack ("원한 돈자루"). Gold plundered by a Horns thief rides in ONE sack on the
-- thief's back; its 45 s countdown ticks only inside PvP zones. Survive -> Paid to the thief. A Halo KO in time ->
-- Avenged (victims get 120% to the bank, the avenger a bonus). Any other death / leaving -> Returned (100%).
-- Server only. See TECH_SPEC §4.14.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "GrudgeService"

local LOOP_WARN_INTERVAL = 10
local MAX_TICK_STEP = 1 -- clamp for the elapsed time of one tick after a server hitch

local GrudgeService = {}

GrudgeService.SackResolved = Util.Signal.new() -- (thief, outcome: "Paid" | "Avenged" | "Returned", total)

local S = nil

-- [thief: Player] = { Entries = { [victimUserId] = { Amount, Name, Rebirths } }, Total, Remaining, Infamy,
-- LastVictimName }. Entry.Rebirths = the victim's Rebirths when stolen (CR-M6: no refund across a rebirth).
local sacks = {}
-- CR-M4 / CR-L6: anti-collusion cooldowns live in the saved PairCD (follows the player across servers):
-- victim data "steal:<thiefUserId>" (RestealWindow), "refund:0" (extra 20%, per victim);
-- avenger data "avenge:0" (avenger bonus, per avenger)

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind)
	if isPlaying(p) then
		Net.Notify(p, text, kind)
	end
end

-- CR-M4: pair cooldown kept in the holder's saved PairCD ("<kind>:<otherUserId>" = os.time()). PlayerService.PairReady
-- owns it; the inline copy follows the same contract. commit = false only checks. No data -> false.
local function pairReady(holder, otherUserId, kind, cooldown, commit)
	if not holder then
		return false
	end
	local PS = S.PlayerService
	if PS.PairReady then
		local ok, res = pcall(PS.PairReady, holder, otherUserId, kind, cooldown, commit)
		return ok and res == true
	end
	local d = PS.GetData(holder)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = kind .. ":" .. tostring(otherUserId)
	local t = os.time()
	if t - (tonumber(d.PairCD[k]) or 0) < cooldown then
		return false
	end
	if commit ~= false then
		d.PairCD[k] = t
	end
	return true
end

-- CR-M6: a share is refunded only to the same "life" it was stolen from (a rebirth resets the bank on purpose)
local function sameLife(victim, entry)
	return (tonumber(victim:GetAttribute("Rebirths")) or 0) == (tonumber(entry.Rebirths) or 0)
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function publish(thief, sack)
	if not isPlaying(thief) then
		return
	end
	if sack then
		setAttr(thief, "SackGold", sack.Total)
		setAttr(thief, "SackSeconds", math.max(0, math.ceil(sack.Remaining)))
		setAttr(thief, "SackVictimName", sack.LastVictimName)
	else
		setAttr(thief, "SackGold", 0)
		setAttr(thief, "SackSeconds", 0)
		setAttr(thief, "SackVictimName", "")
	end
end

-- victim still in this server (a rejoin counts: entries are keyed by UserId) and ready
local function presentVictim(userId)
	local victim = Players:GetPlayerByUserId(userId)
	if victim and S.PlayerService.IsReady(victim) then
		return victim
	end
	return nil
end

-- removes the sack, resets the thief's attributes, tells the thief (unless leaving) and fires SackResolved
local function closeSack(thief, sack, outcome, tellThief)
	sacks[thief] = nil
	publish(thief, nil)
	if tellThief and outcome ~= "Paid" then
		notify(thief, fmt("SackLost"), "bad")
	end
	GrudgeService.SackResolved:Fire(thief, outcome, sack.Total)
end

------------------------------------------------------------------ outcomes
-- Paid: the thief survived 45 s of PvP-zone time
local function pay(thief, sack)
	S.ProgressionService.AddCarriedGold(thief, sack.Total, "Plunder")
	if sack.Infamy > 0 then
		S.PlayerService.AddStat(thief, "Infamy", sack.Infamy)
	end
	notify(thief, fmt("SackPaid", Util.FormatNumber(sack.Total)), "reward")
	closeSack(thief, sack, "Paid", true)
end

-- Returned: every present victim gets 100% back to the bank; shares of victims who left (or rebirthed since,
-- CR-M6) are destroyed
local function returnShares(sack)
	for userId, entry in sack.Entries do
		local victim = presentVictim(userId)
		if victim and sameLife(victim, entry) then
			local amount = math.floor(entry.Amount * Config.Grudge.ReturnRate)
			if amount > 0 then
				S.ProgressionService.AddBankGold(victim, amount, "Refund")
				notify(victim, fmt("GrudgeReturned", Util.FormatNumber(amount)), "good")
			end
		end
	end
end

-- Avenged: a Halo player KO'd the thief in time
local function avenge(thief, sack, killer)
	local G = Config.Grudge
	local thiefPos = rootPos(thief)

	for userId, entry in sack.Entries do
		local victim = presentVictim(userId)
		if victim and sameLife(victim, entry) then -- CR-M6
			-- CR-L6: the extra 20% is once per VICTIM per RefundBonusCooldown whatever the thief (victim's save, CR-M4)
			local bonusOk = pairReady(victim, 0, "refund", G.RefundBonusCooldown)
			local refund = math.floor(entry.Amount * (bonusOk and G.AvengeRefundRate or G.ReturnRate))
			if refund > 0 then
				S.ProgressionService.AddBankGold(victim, refund, "Refund")
				notify(victim, fmt("GrudgeRefund", Util.PlayerDisplayName(killer), Util.FormatNumber(refund)), "good")
				local victimPos = rootPos(victim)
				if thiefPos and victimPos then
					Net.Fx(victim, "Plunder", { From = thiefPos, To = victimPos, Amount = refund })
				end
			end
		end
	end

	-- "복수 대행" bonus, once per AVENGER per PairRewardCooldown whatever the thief (CR-L6; avenger's save, CR-M4)
	if pairReady(killer, 0, "avenge", Config.PvP.PairRewardCooldown) then
		S.ProgressionService.AddBankGold(killer, G.AvengerBonus, "Bounty")
		notify(killer, fmt("AvengerBonus", Util.FormatNumber(G.AvengerBonus)), "reward")
	end

	Net.NotifyAll(fmt("GrudgeAvengedAll", Util.PlayerDisplayName(killer), Util.PlayerDisplayName(thief)), "info")
end

local function returnSack(thief, tellThief)
	local sack = sacks[thief]
	if not sack then
		return
	end
	returnShares(sack)
	closeSack(thief, sack, "Returned", tellThief)
end

------------------------------------------------------------------ public API
function GrudgeService.HasSack(player)
	return player ~= nil and sacks[player] ~= nil
end

function GrudgeService.GetSackTotal(player)
	local sack = player and sacks[player]
	return sack and sack.Total or 0
end

-- false if this thief stole from this victim less than RestealWindow ago (CR-M4: checked in the victim's save;
-- AddToSack records it)
function GrudgeService.CanSteal(thief, victim)
	if not thief or not victim then
		return false
	end
	return pairReady(victim, thief.UserId, "steal", Config.Grudge.RestealWindow, false)
end

-- amount was already taken from the victim's carried gold (PvPService.HandleKO)
function GrudgeService.AddToSack(thief, victim, amount, infamy)
	if not thief or not victim then
		return
	end
	amount = math.floor(tonumber(amount) or 0)
	infamy = math.max(0, math.floor(tonumber(infamy) or 0))
	if amount <= 0 then
		return
	end

	local sack = sacks[thief]
	if not sack then
		sack = { Entries = {}, Total = 0, Remaining = 0, Infamy = 0, LastVictimName = "" }
		sacks[thief] = sack
	end
	-- CR-M6: remember the victim's rebirth count; a share stolen before a rebirth is never refunded after it
	local rebirths = tonumber(victim:GetAttribute("Rebirths")) or 0
	local entry = sack.Entries[victim.UserId]
	if entry then
		if not sameLife(victim, entry) then
			entry.Amount = 0 -- the older share stays in the sack (thief's Paid total) but is no longer refundable
		end
		entry.Amount += amount
		entry.Name = Util.PlayerDisplayName(victim)
		entry.Rebirths = rebirths
	else
		sack.Entries[victim.UserId] = { Amount = amount, Name = Util.PlayerDisplayName(victim), Rebirths = rebirths }
	end
	sack.Total += amount
	sack.Remaining = Config.Grudge.SackSeconds -- every new steal resets the countdown
	sack.Infamy += infamy
	sack.LastVictimName = Util.PlayerDisplayName(victim)
	pairReady(victim, thief.UserId, "steal", 0) -- CR-M4: record the steal in the victim's save (RestealWindow)
	publish(thief, sack)
end

-- death pipeline step 1 (CombatService); no-op without a sack
function GrudgeService.OnCarrierDown(player, killer)
	local sack = player and sacks[player]
	if not sack then
		return
	end
	if killer ~= nil and killer ~= player and isPlaying(killer) and S.FactionService.GetFaction(killer) == "Halo" then
		avenge(player, sack, killer)
		closeSack(player, sack, "Avenged", true)
	else
		returnShares(sack)
		closeSack(player, sack, "Returned", true)
	end
end

------------------------------------------------------------------ loop
local function tickSack(thief, dt)
	local sack = sacks[thief]
	if not sack then
		return
	end
	if not isPlaying(thief) then
		-- defensive: left without PlayerLeaving resolving it; leaving never pays the thief
		returnSack(thief, false)
		return
	end
	-- a dead carrier is resolved by the death pipeline; never pay or tick in that window
	if not Util.IsAlive(thief) then
		return
	end
	if not S.ZoneService.IsPvPZone(thief) then
		return
	end
	sack.Remaining -= dt
	if sack.Remaining <= 0 then
		pay(thief, sack)
		return
	end
	setAttr(thief, "SackSeconds", math.max(0, math.ceil(sack.Remaining)))
end

local function tickAll(dt)
	local thieves = {}
	for thief in sacks do
		table.insert(thieves, thief)
	end
	for _, thief in thieves do
		local ok, err = pcall(tickSack, thief, dt)
		if not ok then
			warnLoop(err)
		end
	end
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player)
	player:SetAttribute("SackGold", 0)
	player:SetAttribute("SackSeconds", 0)
	player:SetAttribute("SackVictimName", "")
end

local function onPlayerLeaving(player)
	-- leaving with a sack -> Returned (the thief is never paid)
	if sacks[player] then
		returnSack(player, false)
	end
end

local function onFactionChanged(player)
	-- defensive: faction changes are blocked while carrying a sack (Altar / rebirth); never keep one across a switch
	if sacks[player] then
		returnSack(player, true)
	end
end

------------------------------------------------------------------ lifecycle
function GrudgeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
end

function GrudgeService.Start()
	-- (the anti-collusion cooldowns are in the saves now, CR-M4; PlayerService prunes them at PlayerReady)
	task.spawn(function()
		while true do
			local elapsed = task.wait(Config.Grudge.Tick)
			local dt = math.clamp(tonumber(elapsed) or Config.Grudge.Tick, 0, MAX_TICK_STEP)
			tickAll(dt)
		end
	end)

	print("[GrudgeService] started")
end

return GrudgeService
]]></ProtectedString>
				<string name="ScriptGuid">{00DD84AE-9681-4B19-BFEB-C8C4C90032E8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GrudgeService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">5788d013bf1591860ad23e240000de89</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX18133E116BD14B838F02984DD3B8BBFD">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CharacterVisuals.luau : server-built character decorations. Nametag, faction mark (halo / horns / neutral gear), class weapon,
-- gold sack, grudge sack + ghost, rebirth aura, turncoat marks (cape / cracked halo / gray aura), wanted glow and
-- kaiju fire. Every piece is rebuilt on CharacterSpawned and when its watched attributes change.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local CharacterVisuals = {}

------------------------------------------------------------------ constants
local TAG = "CharacterVisuals"
local V = Config.Visuals

local NEUTRAL_ID = "Neutral"
-- CR-L44: "⚙" renders as a tofu box; a missing / empty / unsafe emblem falls back to "장"
local NEUTRAL_EMBLEM = (Config.Factions.Neutral and Config.Factions.Neutral.Emblem) or "장"
if type(NEUTRAL_EMBLEM) ~= "string" or NEUTRAL_EMBLEM == ""
	or (type(Util.GlyphSafe) == "function" and not Util.GlyphSafe(NEUTRAL_EMBLEM)) then
	NEUTRAL_EMBLEM = "장"
end
local MIN_TEXT_SIZE = (Config.UI and Config.UI.MinTextSize) or 11

local WOOD_COLOR = Color3.fromRGB(120, 85, 50)
local DARK_METAL = Color3.fromRGB(60, 60, 70)
local SACK_COLOR = Color3.fromRGB(150, 105, 55)
local SACK_KNOT_COLOR = Color3.fromRGB(110, 75, 40)
local GOLD_SPARK = Color3.fromRGB(255, 210, 60)
local GLOW_FILL = Color3.fromRGB(255, 40, 40)
local GLOW_OUTLINE = Color3.fromRGB(255, 0, 0)
local KAIJU_LIGHT = Color3.fromRGB(255, 60, 30)
local LINE2_COLOR = Color3.fromRGB(235, 235, 240)
local LINE3_COLOR = Color3.fromRGB(255, 70, 70)
local GHOST_TEXT = Color3.fromRGB(220, 170, 255)

local REFRESH_DEBOUNCE = 0.25

-- build order for a full refresh
local PIECE_ORDER = {
	"Nametag", "FactionMark", "WeaponModel", "GoldSack", "GrudgeSack", "GrudgeGhost",
	"RebirthAura", "MarkCape", "MarkHalo", "GrayAura", "WantedGlow", "KaijuFire",
}

-- attribute -> pieces to rebuild ("NametagOffset" = only move the nametag)
local WATCH = {
	Level = { "Nametag", "GoldSack", "GrudgeSack" },
	Class = { "Nametag", "WeaponModel" },
	Faction = { "Nametag", "FactionMark", "WeaponModel", "RebirthAura" },
	Honor = { "Nametag", "FactionMark" },
	Infamy = { "Nametag", "FactionMark" },
	Rebirths = { "Nametag", "RebirthAura" },
	WantedStars = { "Nametag", "WantedGlow" },
	Bounty = { "Nametag" },
	Rookie = { "Nametag" },
	BullyStacks = { "Nametag" },
	SessionTitle = { "Nametag" },
	Nickname = { "Nametag" },
	NicknameVerified = { "Nametag" },
	FallMarks = { "Nametag", "MarkCape", "GrayAura" },
	RedeemMarks = { "Nametag", "MarkHalo", "GrayAura" },
	VisualScale = { "NametagOffset" },
	WeaponTier = { "WeaponModel" },
	CarriedGold = { "GoldSack" },
	SackGold = { "GrudgeSack", "GrudgeGhost" },
	SackVictimName = { "GrudgeGhost" },
	KaijuState = { "WantedGlow", "KaijuFire" },
}

-- body parts whose replacement (e.g. R15 appearance loading) requires a rebuild
local BODY_PARTS = {
	Head = true, RightHand = true, ["Right Arm"] = true, LeftHand = true, ["Left Arm"] = true,
	UpperTorso = true, Torso = true, HumanoidRootPart = true,
}

------------------------------------------------------------------ state
local S = nil
local states = {} -- [Player] = { Conns, CharConns, Dirty, Queued, RefreshQueued }
local builtTier = setmetatable({}, { __mode = "k" }) -- [sack Model] = tier it was built for
local lastWarn = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarn[key]
	if last and now - last < 10 then return end
	lastWarn[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function attrNum(player, name, default)
	local v = player:GetAttribute(name)
	if type(v) == "number" and v == v then return v end
	return default or 0
end

local function attrStr(player, name, default)
	local v = player:GetAttribute(name)
	if type(v) == "string" then return v end
	return default
end

local function getFaction(player)
	return attrStr(player, "Faction", "None")
end

local function getClass(player)
	local c = attrStr(player, "Class", "Warrior")
	if Config.Classes[c] then return c end
	return "Warrior"
end

-- A9-1: every faction colour (Neutral teal included) comes from Config, never a local constant
local function factionColor(f)
	local def = Config.Factions[f] or Config.Factions.None
	return (def and def.Color) or Color3.new(1, 1, 1)
end

local function charScale(character)
	local ok, sc = pcall(character.GetScale, character)
	if ok and type(sc) == "number" and sc > 0 then return sc end
	return 1
end

local function getRoot(character)
	local r = character:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then return r end
	return nil
end

local function clearChild(parent, name)
	if not parent then return end
	local old = parent:FindFirstChild(name)
	while old do
		old:Destroy()
		old = parent:FindFirstChild(name)
	end
end

local function esc(s)
	s = tostring(s)
	s = string.gsub(s, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	s = string.gsub(s, "\"", "&quot;")
	s = string.gsub(s, "'", "&apos;")
	return s
end

-- accessory part: unanchored, massless, no collision / query / touch
local function accPart(props)
	local p = Instance.new(props.ClassName or "Part")
	if props.Shape then p.Shape = props.Shape end
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "ClassName" and k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	return p
end

-- parents the piece model to the character, then welds every part to `base` at its current offset
local function mount(model, parts, character, base)
	for _, p in parts do
		p.Parent = model
	end
	model.Parent = character
	for _, p in parts do
		Util.Weld(base, p)
	end
end

local function newPiece(name)
	local m = Instance.new("Model")
	m.Name = name
	return m
end

local function addLight(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

local function sparkle(parent, color, rate, size)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(0.6, 1.0)
	pe.Speed = NumberRange.new(0.5, 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.LightEmission = 0.8
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = parent
	return pe
end

------------------------------------------------------------------ Nametag
local function makeLine(name, order, height, maxSize, color)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.LayoutOrder = order
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 0, height)
	l.Font = Enum.Font.GothamBold
	l.RichText = true
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.35
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.Text = ""
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize
	c.MinTextSize = MIN_TEXT_SIZE
	c.Parent = l
	return l
end

local function nametagOffset(player)
	return Vector3.new(0, 2.6 * attrNum(player, "VisualScale", 1), 0)
end

local function createNametag(player)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Nametag"
	bb.Size = UDim2.fromOffset(240, 80)
	bb.StudsOffset = nametagOffset(player)
	bb.MaxDistance = V.NametagMaxDistance
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	-- user OK 2026-10-06: my own tag covered the middle of small screens; the HUD card shows level / class / status
	bb.PlayerToHideFrom = player

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = bb

	makeLine("Line1", 1, 30, 22, Color3.new(1, 1, 1)).Parent = bb
	makeLine("Line2", 2, 24, 17, LINE2_COLOR).Parent = bb
	makeLine("Line3", 3, 24, 17, LINE3_COLOR).Parent = bb
	return bb
end

local function updateNametag(player, bb)
	local f = getFaction(player)
	local classId = getClass(player)
	local level = math.floor(attrNum(player, "Level", 1))
	local rebirths = math.floor(attrNum(player, "Rebirths", 0))

	local title = Config.DisplayTitle(
		f,
		attrNum(player, "Honor", 0),
		attrNum(player, "Infamy", 0),
		attrNum(player, "FallMarks", 0),
		attrNum(player, "RedeemMarks", 0),
		attrStr(player, "SessionTitle", "")
	)
	local line1 = "[" .. tostring(title) .. "] " .. Util.PlayerDisplayName(player)
	if f == NEUTRAL_ID then
		line1 = NEUTRAL_EMBLEM .. " " .. line1
	end

	local line2 = "Lv " .. level .. " · " .. Config.ClassName(classId, f)
	if rebirths > 0 then
		line2 ..= "  환생 " .. rebirths
	end
	if player:GetAttribute("Rookie") == true and f ~= NEUTRAL_ID then
		line2 ..= "  새싹 보호"
	end

	local bits = {}
	local bully = math.floor(attrNum(player, "BullyStacks", 0))
	if bully > 0 then
		table.insert(bits, bully > 1 and ("깡패 ×" .. bully) or "깡패")
	end
	local bounty = attrNum(player, "Bounty", 0)
	if bounty > 0 then
		local stars = math.clamp(math.floor(attrNum(player, "WantedStars", 0)), 0, Config.PvP.MaxStars)
		local starText = string.rep("★", stars)
		local b = "현상금 " .. Util.FormatNumber(bounty)
		table.insert(bits, starText ~= "" and (starText .. " " .. b) or b)
	end
	local line3 = table.concat(bits, "  ")

	local l1 = bb:FindFirstChild("Line1")
	local l2 = bb:FindFirstChild("Line2")
	local l3 = bb:FindFirstChild("Line3")
	if l1 then
		l1.Text = esc(line1)
		l1.TextColor3 = factionColor(f)
	end
	if l2 then
		l2.Text = esc(line2)
	end
	if l3 then
		l3.Text = esc(line3)
		l3.Visible = line3 ~= ""
	end
	bb.StudsOffset = nametagOffset(player)
end

local function buildNametag(player, character, force)
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local bb = head:FindFirstChild("Nametag")
	if force or not (bb and bb:IsA("BillboardGui")) then
		clearChild(head, "Nametag")
		bb = createNametag(player)
		bb.Parent = head
	end
	updateNametag(player, bb)
end

local function updateNametagOffset(player, character)
	local head = Util.FindPart(character, "Head")
	local bb = head and head:FindFirstChild("Nametag")
	if bb and bb:IsA("BillboardGui") then
		bb.StudsOffset = nametagOffset(player)
	end
end

------------------------------------------------------------------ FactionMark (halo disc / horns / neutral gear)
-- A9-1 Neutral: a teal Neon gear 1.6 studs above the head = one thin Cylinder + two crossed Blocks (3 parts), fixed
-- size (does not grow with rank). It stands upright (faces front/back), so at a distance it reads differently from
-- the flat Halo disc, the Horns wedges and the bare None head.
local function buildNeutralGear(head, sc)
	local color = factionColor(NEUTRAL_ID)
	local base = head.CFrame * CFrame.new(0, 1.6 * sc, 0)
	local parts = {
		accPart({
			Name = "GearDisc",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.18, 1.1, 1.1) * sc,
			Material = Enum.Material.Neon,
			Color = color,
			CFrame = base * CFrame.Angles(0, math.pi / 2, 0), -- cylinder axis along the head's look direction
		}),
	}
	for k = 0, 1 do
		table.insert(parts, accPart({
			Name = "GearTeeth" .. (k + 1),
			Size = Vector3.new(1.5, 0.34, 0.14) * sc, -- sticks 0.2 out of the disc rim on both ends = 4 teeth
			Material = Enum.Material.Neon,
			Color = color,
			CFrame = base * CFrame.Angles(0, 0, math.rad(45 + 90 * k)),
		}))
	end
	return parts
end

local function buildFactionMark(player, character)
	clearChild(character, "FactionMark")
	local f = getFaction(player)
	if f ~= "Halo" and f ~= "Horns" and f ~= NEUTRAL_ID then return end -- None: nothing
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local sc = charScale(character)
	if f == NEUTRAL_ID then
		mount(newPiece("FactionMark"), buildNeutralGear(head, sc), character, head)
		return
	end
	local _, rank = Config.GetTitle(f, attrNum(player, "Honor", 0), attrNum(player, "Infamy", 0))
	local scale = 1 + V.MarkScalePerRank * (math.max(1, rank or 1) - 1)

	local model = newPiece("FactionMark")
	local parts = {}
	if f == "Halo" then
		local disc = accPart({
			Name = "HaloDisc",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 2.2 * scale, 2.2 * scale) * sc,
			Material = Enum.Material.Neon,
			Color = Config.Factions.Halo.Color,
			CFrame = head.CFrame * CFrame.new(0, 1.6 * sc, 0) * CFrame.Angles(0, 0, math.pi / 2), -- lying flat
		})
		addLight(disc, Config.Factions.Halo.Color, 8 * sc, 1.2)
		table.insert(parts, disc)
	else
		local h = 1.0 * scale * sc
		for side = -1, 1, 2 do
			local horn = accPart({
				ClassName = "WedgePart",
				Name = side < 0 and "HornL" or "HornR",
				Size = Vector3.new(0.4, 1.0 * scale, 0.6 * scale) * sc,
				Material = Enum.Material.Neon,
				Color = Config.Factions.Horns.Color,
				CFrame = head.CFrame
					* CFrame.new(side * head.Size.X * 0.32, head.Size.Y / 2 + h * 0.4, 0)
					* CFrame.Angles(0, 0, -side * math.rad(25)), -- tilted outward
			})
			table.insert(parts, horn)
		end
	end
	mount(model, parts, character, head)
end

------------------------------------------------------------------ WeaponModel
local function gripCFrame(hand, left)
	local att = hand:FindFirstChild(left and "LeftGripAttachment" or "RightGripAttachment")
	local pos
	if att and att:IsA("Attachment") then
		pos = att.WorldPosition
	else
		pos = (hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, 0)).Position
	end
	local rotation = hand.CFrame.Rotation
	-- Imported costume geometry can carry a verified axis bake (pilot Y180). Its wrist attachment
	-- restores the original bone frame; using the mesh's raw rotation turns the held weapon around.
	-- Personal avatar grips retain their existing frame.
	if hand:GetAttribute("HHC_SourcePart") == hand.Name then
		local wrist = hand:FindFirstChild(left and "LeftWristRigAttachment" or "RightWristRigAttachment")
		if wrist and wrist:IsA("Attachment") then rotation *= wrist.CFrame.Rotation end
	end
	return CFrame.new(pos) * rotation
end

local function buildSword(grip, sc, w, color)
	local L = grip * CFrame.Angles(-math.pi / 2, 0, 0) -- +Y of L points forward
	local handleLen = 1.2
	local handle = accPart({
		Name = "Handle", Size = Vector3.new(0.3, handleLen, 0.3) * sc,
		Material = Enum.Material.Wood, Color = WOOD_COLOR, CFrame = L,
	})
	local guard = accPart({
		Name = "Guard", Size = Vector3.new(1.2, 0.25, 0.4) * sc,
		Material = Enum.Material.Metal, Color = DARK_METAL,
		CFrame = L * CFrame.new(0, (handleLen / 2 + 0.125) * sc, 0),
	})
	local blade = accPart({
		Name = "Blade", Size = Vector3.new(0.25, w.Length, 0.6) * sc,
		Material = w.Material, Color = color,
		CFrame = L * CFrame.new(0, (handleLen / 2 + 0.25 + w.Length / 2) * sc, 0),
	})
	return { handle, guard, blade }, blade
end

local function buildStaff(grip, sc, w, color, tier)
	local shaftLen = w.Length + 1.5
	local base = grip -- the shaft centreline must pass through the actual hand grip
	local shaft = accPart({
		Name = "Shaft", Size = Vector3.new(0.3, shaftLen, 0.3) * sc,
		Material = Enum.Material.Wood, Color = WOOD_COLOR,
		CFrame = base * CFrame.new(0, (shaftLen / 2 - 1.0) * sc, 0),
	})
	local collar = accPart({
		Name = "Collar", Size = Vector3.new(0.45, 0.3, 0.45) * sc,
		Material = w.Material, Color = color,
		CFrame = base * CFrame.new(0, (shaftLen - 1.05) * sc, 0),
	})
	local d = 0.7 + 0.1 * tier
	local tip = accPart({
		Name = "Tip", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d) * sc,
		Material = Enum.Material.Neon, Color = color,
		CFrame = base * CFrame.new(0, (shaftLen - 1.0 + d * 0.35) * sc, 0),
	})
	addLight(tip, color, 8 * sc, 1.5)
	return { shaft, collar, tip }, tip
end

local function buildBow(grip, sc, w, color)
	local H = w.Length
	local half = math.rad(50)
	local R = H / (2 * math.sin(half))
	local sag = R * (1 - math.cos(half))
	-- The centre/grip stays in the hand at every tier; lifting a long bow moved its arrow rest
	-- above the grip, so no arm pose could align the string hand, face and launch axis together.
	local base = grip * CFrame.new(0, 0, -0.1 * sc)
	local segLen = math.max(0.9, 2 * R * math.sin(math.rad(10)) * 1.08)
	local parts = {}
	local main
	for k = 1, 5 do
		local phi = -half + (k - 0.5) * (2 * half / 5)
		local local3 = Vector3.new(0, R * math.sin(phi), -(R * math.cos(phi) - R * math.cos(half)) + sag)
		local seg = accPart({
			Name = "Arc" .. k, Size = Vector3.new(0.2, segLen, 0.2) * sc,
			Material = w.Material, Color = color,
			CFrame = base * CFrame.new(local3 * sc) * CFrame.Angles(phi, 0, 0),
		})
		table.insert(parts, seg)
		if k == 3 then main = seg end
	end
	local string_ = accPart({
		Name = "String", Size = Vector3.new(0.05, H, 0.05) * sc,
		Color = Color3.new(1, 1, 1),
		Transparency = 1, -- two strings share a movable nock for the right-hand draw
		CFrame = base * CFrame.new(0, 0, sag * sc),
	})
	table.insert(parts, string_)
	for _, spec in { { "BowTop", H / 2 }, { "BowBottom", -H / 2 }, { "BowNock", 0 } } do
		local att = Instance.new("Attachment")
		att.Name = spec[1]
		att.Position = Vector3.new(0, spec[2] * sc, 0)
		att.Parent = string_
	end
	for _, name in { "BowTop", "BowBottom" } do
		local beam = Instance.new("Beam")
		beam.Name = name .. "String"
		beam.Attachment0 = string_:FindFirstChild(name)
		beam.Attachment1 = string_:FindFirstChild("BowNock")
		beam.Width0 = 0.05 * sc
		beam.Width1 = 0.05 * sc
		beam.Color = ColorSequence.new(string_.Color)
		beam.FaceCamera = true
		beam.Parent = string_
	end
	return parts, main
end

local function buildWeapon(player, character)
	clearChild(character, "WeaponModel")
	local classId = getClass(player)
	local classDef = Config.Classes[classId] or Config.Classes.Warrior
	local left = classDef.Weapon == "Bow"
	local hand = left and Util.FindPart(character, "LeftHand", "Left Arm")
		or (not left and Util.FindPart(character, "RightHand", "Right Arm"))
	if not hand then return end
	local sc = charScale(character)
	local tier = math.clamp(math.floor(attrNum(player, "WeaponTier", 1)), 1, Config.MaxWeaponTier)
	local w = Config.Weapons[tier]
	local f = getFaction(player)
	local color = Config.WeaponColor(tier, f)
	local grip = gripCFrame(hand, left)

	local parts, main
	if classDef.Weapon == "Staff" then
		parts, main = buildStaff(grip, sc, w, color, tier)
	elseif classDef.Weapon == "Bow" then
		parts, main = buildBow(grip, sc, w, color)
	else
		parts, main = buildSword(grip, sc, w, color)
	end

	if tier >= 6 and main then
		local existing = main:FindFirstChildOfClass("PointLight")
		if existing then
			existing.Brightness = 2.5
			existing.Range = 12 * sc
		else
			addLight(main, color, 10 * sc, 2)
		end
	end
	if tier >= 7 and main then
		sparkle(main, color, 12, 0.35 * sc)
	end

	local model = newPiece("WeaponModel")
	model:SetAttribute("Class", classId)
	model:SetAttribute("GripHand", hand.Name)
	if main then
		local muzzle = Instance.new("Attachment")
		muzzle.Name = "AttackMuzzle"
		if classDef.Weapon == "Bow" then
			muzzle.Position = Vector3.new(0, 0, -0.18 * sc)
		elseif classDef.Weapon == "Staff" then
			muzzle.Position = Vector3.new(0, main.Size.Y * 0.5, 0)
		else
			muzzle.Position = Vector3.new(0, main.Size.Y * 0.5, 0)
		end
		muzzle.Parent = main
		-- Server-built attachment offsets survive both joint types and avoid reading a one-frame-old
		-- hand/weapon pair while their Transform batch is still waiting for the physics step.
		model:SetAttribute("HandMuzzle", hand.CFrame:ToObjectSpace(main.CFrame * muzzle.CFrame))
		if classDef.Weapon == "Bow" then
			for _, part in parts do
				local nock = part:FindFirstChild("BowNock")
				if nock then model:SetAttribute("HandBowRest", hand.CFrame:ToObjectSpace(part.CFrame * nock.CFrame)) end
			end
		end
	end
	mount(model, parts, character, hand)
end

------------------------------------------------------------------ sacks & ghost
local function sackSize(tier)
	local sizes = V.SackSizes
	return sizes[math.clamp(tier, 1, #sizes)]
end

local function buildGoldSack(player, character, force)
	local tier = Config.SackTier(attrNum(player, "CarriedGold", 0), attrNum(player, "Level", 1))
	local existing = character:FindFirstChild("GoldSack")
	if not force then
		if existing and builtTier[existing] == tier then return end
		if not existing and tier <= 0 then return end
	end
	clearChild(character, "GoldSack")
	if tier <= 0 then return end
	local torso = Util.FindPart(character, "UpperTorso", "Torso")
	if not torso then return end
	local sc = charScale(character)
	local d = sackSize(tier) * sc
	local ball = accPart({
		Name = "Sack", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d),
		Material = Enum.Material.Fabric, Color = SACK_COLOR,
		CFrame = torso.CFrame * CFrame.new(0, 0.15 * sc, torso.Size.Z / 2 + d * 0.42),
	})
	local k = d * 0.35
	local knot = accPart({
		Name = "Knot", Shape = Enum.PartType.Ball, Size = Vector3.new(k, k, k),
		Material = Enum.Material.Fabric, Color = SACK_KNOT_COLOR,
		CFrame = ball.CFrame * CFrame.new(0, d * 0.48, 0),
	})
	if tier >= 4 then
		sparkle(ball, GOLD_SPARK, 6, 0.3 * sc)
	end
	local model = newPiece("GoldSack")
	mount(model, { ball, knot }, character, torso)
	builtTier[model] = tier
end

local function buildGrudgeSack(player, character, force)
	local sackGold = attrNum(player, "SackGold", 0)
	local tier = 0
	if sackGold > 0 then
		tier = math.max(1, Config.SackTier(sackGold, attrNum(player, "Level", 1)))
	end
	local existing = character:FindFirstChild("GrudgeSack")
	if not force then
		if existing and builtTier[existing] == tier then return end
		if not existing and tier <= 0 then return end
	end
	clearChild(character, "GrudgeSack")
	if tier <= 0 then return end
	local torso = Util.FindPart(character, "UpperTorso", "Torso")
	if not torso then return end
	local sc = charScale(character)
	local d = sackSize(tier) * sc
	local ball = accPart({
		Name = "Sack", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d),
		Material = Enum.Material.Fabric, Color = V.GrudgeSackColor,
		CFrame = torso.CFrame * CFrame.new(0, -(0.6 * sc + d * 0.3), torso.Size.Z / 2 + d * 0.42),
	})
	sparkle(ball, V.GrudgeSackColor:Lerp(Color3.new(1, 1, 1), 0.25), 8, 0.35 * sc)
	local model = newPiece("GrudgeSack")
	mount(model, { ball }, character, torso)
	builtTier[model] = tier
end

local function buildGrudgeGhost(player, character)
	clearChild(character, "GrudgeGhost")
	if attrNum(player, "SackGold", 0) <= 0 then return end
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local sc = charScale(character)
	local base = head.CFrame * CFrame.new(0, V.GhostHeight * sc, 0)
	local body = accPart({
		Name = "GhostBody", Size = Vector3.new(1.6, 2, 0.8) * sc,
		Material = Enum.Material.Neon, Color = V.GhostColor, Transparency = V.GhostTransparency,
		CFrame = base,
	})
	local ghostHead = accPart({
		Name = "GhostHead", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2) * sc,
		Material = Enum.Material.Neon, Color = V.GhostColor, Transparency = V.GhostTransparency,
		CFrame = base * CFrame.new(0, 1.6 * sc, 0),
	})

	local victim = attrStr(player, "SackVictimName", "")
	if victim == "" then victim = "누군가" end
	local bb = Instance.new("BillboardGui")
	bb.Name = "GhostLabel"
	bb.Size = UDim2.fromOffset(200, 28)
	bb.StudsOffset = Vector3.new(0, 1.3 * sc, 0)
	bb.MaxDistance = V.NametagMaxDistance
	bb.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = GHOST_TEXT
	label.TextStrokeTransparency = 0.3
	label.Text = victim .. "의 원한"
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = 18
	c.MinTextSize = MIN_TEXT_SIZE
	c.Parent = label
	label.Parent = bb
	bb.Parent = ghostHead

	mount(newPiece("GrudgeGhost"), { body, ghostHead }, character, head)
end

------------------------------------------------------------------ auras & marks
local function auraEmitter(name, color, rate, lifetime, sc)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = name
	pe.Color = ColorSequence.new(color)
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(lifetime)
	pe.LightEmission = 0.6
	pe.Speed = NumberRange.new(0.5, 1.5)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, 2, 0)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 * sc), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	return pe
end

local function buildRebirthAura(player, character)
	local root = getRoot(character)
	if not root then return end
	clearChild(root, "RebirthAura")
	local rebirths = attrNum(player, "Rebirths", 0)
	if rebirths < 1 then return end
	local color, bestMin, found = nil, -math.huge, false
	for _, a in Config.Rebirth.Auras do
		if rebirths >= a.Min and a.Min >= bestMin then
			bestMin = a.Min
			color = a.Color
			found = true
		end
	end
	if not found then return end
	if color == nil then color = factionColor(getFaction(player)) end
	auraEmitter("RebirthAura", color, 6, 1.2, charScale(character)).Parent = root
end

local function buildMarkCape(player, character)
	clearChild(character, "MarkCape")
	if attrNum(player, "FallMarks", 0) < 1 then return end
	local torso = Util.FindPart(character, "UpperTorso", "Torso")
	if not torso then return end
	local sc = charScale(character)
	local top = torso.CFrame * CFrame.new(0, torso.Size.Y / 2 - 0.1 * sc, torso.Size.Z / 2 + 0.08 * sc)
	local lengths = { 2.4, 1.8, 2.7 }
	local xs = { -0.6, 0, 0.6 }
	local parts = {}
	for i = 1, 3 do
		local len = lengths[i] * sc
		local cf = top
			* CFrame.new(xs[i] * sc, 0, 0)
			* CFrame.Angles(-math.rad(6 + i * 2), 0, math.rad((i - 2) * 4))
			* CFrame.new(0, -len / 2, 0)
		table.insert(parts, accPart({
			Name = "CapeStrip" .. i, Size = Vector3.new(0.62 * sc, len, 0.08 * sc),
			Material = Enum.Material.Fabric, Color = V.CapeColor, CFrame = cf,
		}))
	end
	mount(newPiece("MarkCape"), parts, character, torso)
end

local function buildMarkHalo(player, character)
	clearChild(character, "MarkHalo")
	if attrNum(player, "RedeemMarks", 0) < 1 then return end
	local head = Util.FindPart(character, "Head")
	if not head then return end
	local sc = charScale(character)
	local base = head.CFrame * CFrame.new(0, 2.4 * sc, 0)
	local R = 1.0 * sc
	local chord = 2 * R * math.sin(math.rad(35)) -- each segment spans ~70 deg, 20 deg gaps
	local parts = {}
	for k = 0, 3 do
		local theta = math.rad(k * 90 + 45)
		local tilt = (k % 2 == 0) and math.rad(7) or -math.rad(5) -- cracked look
		local cf = base * CFrame.Angles(0, -theta, 0) * CFrame.new(R, 0, 0) * CFrame.Angles(tilt, 0, 0)
		table.insert(parts, accPart({
			Name = "HaloShard" .. (k + 1), Size = Vector3.new(0.22 * sc, 0.14 * sc, chord),
			Material = Enum.Material.Neon, Color = V.CrackedHaloColor, CFrame = cf,
		}))
	end
	mount(newPiece("MarkHalo"), parts, character, head)
end

local function buildGrayAura(player, character)
	local root = getRoot(character)
	if not root then return end
	clearChild(root, "GrayAura")
	local minMarks = Config.Rebirth.GrayLegendMin
	if attrNum(player, "FallMarks", 0) >= minMarks and attrNum(player, "RedeemMarks", 0) >= minMarks then
		auraEmitter("GrayAura", V.GrayAuraColor, 8, 1.5, charScale(character)).Parent = root
	end
end

------------------------------------------------------------------ wanted glow & kaiju fire
local function buildWantedGlow(player, character)
	clearChild(character, "WantedGlow")
	local glow = attrNum(player, "WantedStars", 0) >= Config.PvP.GlowStars
		or attrStr(player, "KaijuState", "None") == "Active"
	if not glow then return end
	local h = Instance.new("Highlight")
	h.Name = "WantedGlow"
	h.FillColor = GLOW_FILL
	h.FillTransparency = 0.6
	h.OutlineColor = GLOW_OUTLINE
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = character
end

local function buildKaijuFire(player, character)
	local root = getRoot(character)
	if not root then return end
	clearChild(root, "KaijuFire")
	if attrStr(player, "KaijuState", "None") ~= "Active" then return end
	local sc = charScale(character)
	local att = Instance.new("Attachment")
	att.Name = "KaijuFire"
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Fire"
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 200, 70)),
		ColorSequenceKeypoint.new(0.4, V.KaijuFireColor),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 20, 10)),
	})
	pe.Rate = 30
	pe.Lifetime = NumberRange.new(0.5, 1.0)
	pe.Speed = NumberRange.new(3, 6)
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Acceleration = Vector3.new(0, 8, 0)
	pe.LightEmission = 0.9
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.0 * sc), NumberSequenceKeypoint.new(1, 0.3 * sc) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = att
	addLight(att, KAIJU_LIGHT, 18 * sc, 3)
	att.Parent = root
end

------------------------------------------------------------------ dispatch
local BUILDERS = {
	Nametag = buildNametag,
	FactionMark = buildFactionMark,
	WeaponModel = buildWeapon,
	GoldSack = buildGoldSack,
	GrudgeSack = buildGrudgeSack,
	GrudgeGhost = buildGrudgeGhost,
	RebirthAura = buildRebirthAura,
	MarkCape = buildMarkCape,
	MarkHalo = buildMarkHalo,
	GrayAura = buildGrayAura,
	WantedGlow = buildWantedGlow,
	KaijuFire = buildKaijuFire,
}

local function buildPiece(player, character, piece, force)
	local fn = BUILDERS[piece]
	if not fn then return end
	local ok, err = pcall(fn, player, character, force)
	if not ok then
		warnThrottled(piece, piece .. " build failed for " .. player.Name .. ": " .. tostring(err))
	end
end

local function refreshAll(player)
	local character = Util.GetCharacter(player)
	if not character then return end
	for _, piece in PIECE_ORDER do
		buildPiece(player, character, piece, true)
	end
end

local function ensureState(player)
	local st = states[player]
	if not st then
		st = { Conns = {}, CharConns = {}, Dirty = {}, Queued = false, RefreshQueued = false }
		states[player] = st
	end
	return st
end

local function flush(player)
	local st = states[player]
	if not st then return end
	st.Queued = false
	local dirty = st.Dirty
	st.Dirty = {}
	if player.Parent == nil then return end
	local character = Util.GetCharacter(player)
	if not character then return end
	for _, piece in PIECE_ORDER do
		if dirty[piece] then
			buildPiece(player, character, piece, false)
		end
	end
	if dirty.NametagOffset and not dirty.Nametag then
		local ok, err = pcall(updateNametagOffset, player, character)
		if not ok then warnThrottled("NametagOffset", err) end
	end
end

local function markDirty(player, pieces)
	local st = states[player]
	if not st then return end
	for _, piece in pieces do
		st.Dirty[piece] = true
	end
	if not st.Queued then
		st.Queued = true
		task.defer(flush, player)
	end
end

-- debounced full rebuild (body parts swapped by appearance loading etc.)
local function requestRefresh(player)
	local st = states[player]
	if not st or st.RefreshQueued then return end
	st.RefreshQueued = true
	task.delay(REFRESH_DEBOUNCE, function()
		local cur = states[player]
		if not cur then return end
		cur.RefreshQueued = false
		if player.Parent then refreshAll(player) end
	end)
end

local function disconnectAll(list)
	for _, c in list do
		c:Disconnect()
	end
	table.clear(list)
end

local function onPlayerReady(player)
	local st = ensureState(player)
	disconnectAll(st.Conns)
	for attrName, pieces in WATCH do
		table.insert(st.Conns, player:GetAttributeChangedSignal(attrName):Connect(function()
			markDirty(player, pieces)
		end))
	end
	table.insert(st.Conns, player.CharacterAppearanceLoaded:Connect(function()
		requestRefresh(player)
	end))
end

local function onCharacterSpawned(player, character)
	if not player or player.Parent == nil or not character then return end
	local st = ensureState(player)
	disconnectAll(st.CharConns)
	table.insert(st.CharConns, character.ChildAdded:Connect(function(child)
		if child:IsA("BasePart") and BODY_PARTS[child.Name] then
			requestRefresh(player)
		end
	end))
	refreshAll(player)
end

local function onPlayerLeaving(player)
	local st = states[player]
	if not st then return end
	states[player] = nil
	disconnectAll(st.Conns)
	disconnectAll(st.CharConns)
end

------------------------------------------------------------------ public
function CharacterVisuals.Refresh(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then return end
	refreshAll(player)
end

function CharacterVisuals.Init(registry)
	S = registry
	local PS = S.PlayerService
	if PS then
		PS.PlayerReady:Connect(function(player)
			onPlayerReady(player)
		end)
		PS.CharacterSpawned:Connect(function(player, character)
			onCharacterSpawned(player, character)
		end)
		PS.PlayerLeaving:Connect(function(player)
			onPlayerLeaving(player)
		end)
	else
		Util.Warn(TAG, "PlayerService missing; visuals disabled")
	end
	Players.PlayerRemoving:Connect(onPlayerLeaving)
end

function CharacterVisuals.Start()
	print("[CharacterVisuals] started")
end

return CharacterVisuals
]]></ProtectedString>
				<string name="ScriptGuid">{094B3B09-28A7-4BEB-8A67-06AC457FB502}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">CharacterVisuals</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f68800000901</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXCE77C4964CA94F299ED99E08700FF6EF">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ClassService.luau : first class pick (free, keeps level) and class change. A23-14: below
-- Config.ClassChange.FreeKeepLevelBelow (Lv 5) a free change keeps level and XP (no ticket is ever spent there);
-- from that level on: free = back to Lv 1 / XP 0, change ticket = level kept.
-- Class ids: "Warrior", "Mage", "Archer". Display names depend on the faction (incl. "Neutral", addendum A6)
-- and always go through Config.ClassName.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "ClassService"

local ClassService = {}

ClassService.ClassChanged = Util.Signal.new() -- (player, newClass, oldClass)

local S = nil

------------------------------------------------------------------ helpers
local function isClassId(id)
	if type(id) ~= "string" then return false end
	local def = Config.Classes[id]
	return type(def) == "table" and def.Id == id
end

local function notify(player, key, kind, ...)
	local fmt = Config.Text[key]
	if type(fmt) ~= "string" then return end
	Net.Notify(player, string.format(fmt, ...), kind)
end

local function factionOf(player)
	return S.FactionService.GetFaction(player)
end

local function kaijuState(player)
	local k = S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function isClassChosen(player)
	local data = S.PlayerService.GetData(player)
	if data and type(data.ClassChosen) == "boolean" then return data.ClassChosen end
	return player:GetAttribute("ClassChosen") == true
end

-- saved level (data first, attribute as fallback); always an integer >= 1
local function currentLevel(player)
	local data = S.PlayerService.GetData(player)
	local lv = data and tonumber(data.Level)
	if lv == nil then lv = tonumber(player:GetAttribute("Level")) end
	if lv == nil or lv ~= lv or lv == math.huge or lv == -math.huge then return 1 end
	return math.max(1, math.floor(lv))
end

-- A23-14: true when a free class change at the player's level keeps the level (Lv < FreeKeepLevelBelow)
local function freeKeepsLevel(player)
	return Config.ClassChangeKeepsLevel(currentLevel(player)) == true
end

------------------------------------------------------------------ public API
function ClassService.GetClass(player)
	if not player then return "Warrior" end
	local c = player:GetAttribute("Class")
	if isClassId(c) then return c end
	return "Warrior"
end

function ClassService.GetClassDef(player)
	return Config.Classes[ClassService.GetClass(player)] or Config.Classes.Warrior
end

------------------------------------------------------------------ remotes
-- first pick: free and keeps the level (also the one-time pick for data migrated from v1)
local function onChooseClass(player, classId, gender)
	if not S.PlayerService.IsReady(player) then return end
	if not isClassId(classId) then return end
	if gender ~= nil and gender ~= "M" and gender ~= "F" then return end
	if not Util.RateLimit(player, "ChooseClass", Config.RateLimits.ChooseClass) then return end
	if isClassChosen(player) then return end -- silent
	local faction = factionOf(player)
	if faction == "None" then
		notify(player, "NeedFaction", "bad")
		return
	end

	local old = ClassService.GetClass(player)
	if gender ~= nil then S.PlayerService.SetStat(player, "CharacterGender", gender) end
	S.PlayerService.SetStat(player, "Class", classId)
	S.PlayerService.SetStat(player, "ClassChosen", true)
	S.PlayerService.RefreshCharacter(player, true)
	ClassService.ClassChanged:Fire(player, classId, old) -- also when equal, so visuals / charge refresh
	notify(player, "ClassChosen", "good", Config.ClassName(classId, faction))
end

local function onChangeClass(player, classId, useTicket, gender)
	if not S.PlayerService.IsReady(player) then return end
	if not isClassId(classId) or type(useTicket) ~= "boolean" then return end
	if gender ~= nil and gender ~= "M" and gender ~= "F" then return end
	if not Util.RateLimit(player, "ChangeClass", Config.RateLimits.ChangeClass) then return end
	if not isClassChosen(player) then return end -- silent
	if classId == ClassService.GetClass(player) then
		notify(player, "ClassSame", "bad")
		return
	end
	if not Util.IsAlive(player) then return end -- silent
	if S.ZoneService.IsPvPZone(player) then
		notify(player, "ClassNeedSafe", "bad")
		return
	end
	if S.GrudgeService.HasSack(player) then
		notify(player, "BlockedSack", "bad")
		return
	end
	if kaijuState(player) ~= "None" then
		notify(player, "BlockedKaiju", "bad")
		return
	end
	-- Config.PvP.CombatTagTime "blocks travel/switch/class change" (+ addendum A7-4 not-in-combat for both paths):
	-- prevents a mid-fight full heal through RefreshCharacter(full).
	if S.CombatService.IsInCombat(player) then
		notify(player, "TravelBlockedCombat", "bad")
		return
	end
	-- A23-14: below Lv FreeKeepLevelBelow the free change already keeps everything, so a ticket request is served
	-- as a free change and the ticket is NOT spent (a paid ticket must never buy nothing).
	local keepLevel = freeKeepsLevel(player)
	if keepLevel then useTicket = false end
	if useTicket then
		local okTicket, why = S.MonetizationService.UseTicket(player, "Class")
		if not okTicket then
			-- CR-L25: a purchase still being saved is not "no ticket"
			notify(player, why == "Pending" and "TicketSaving" or "NoTicket", "bad")
			return
		end
	end

	if not useTicket and not keepLevel then
		-- free from Lv FreeKeepLevelBelow on: Level 1, XP 0 (gold, bank, weapons, enhancement, items, rebirth bonus,
		-- marks, tickets, quests are kept)
		S.ProgressionService.ResetLevel(player)
	end

	local old = ClassService.GetClass(player)
	if gender ~= nil then S.PlayerService.SetStat(player, "CharacterGender", gender) end
	S.PlayerService.SetStat(player, "Class", classId)
	-- review (A23-14): a keep-level change below Lv5 costs nothing, so it must not be a free full heal either
	-- (Warrior -> Mage -> Warrior mid-hunt). It keeps the HP fraction; the paid / level-losing paths still heal fully.
	S.PlayerService.RefreshCharacter(player, not keepLevel)
	ClassService.ClassChanged:Fire(player, classId, old)
	local name = Config.ClassName(classId, factionOf(player))
	if keepLevel then
		local below = math.floor(tonumber(Config.ClassChange.FreeKeepLevelBelow) or 0)
		notify(player, "ClassChangedFreeKeep", "good", name, below)
	else
		notify(player, useTicket and "ClassChangedTicket" or "ClassChangedFree", "good", name)
	end
end

------------------------------------------------------------------ lifecycle
local function onPlayerReady(player, data)
	-- repair a corrupted stored class silently (GetClass already falls back to Warrior)
	local c = data and data.Class
	if not isClassId(c) then
		Util.Warn(TAG, "invalid stored class " .. tostring(c) .. " for " .. player.Name .. "; reset to Warrior")
		S.PlayerService.SetStat(player, "Class", "Warrior")
	end
end

function ClassService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
end

function ClassService.Start()
	Net.Get("ChooseClass").OnServerEvent:Connect(onChooseClass)
	Net.Get("ChangeClass").OnServerEvent:Connect(onChangeClass)
	print("[ClassService] started")
end

return ClassService
]]></ProtectedString>
				<string name="ScriptGuid">{E0E3A477-2281-407A-B364-B0C0987E2AC8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ClassService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f68800000903</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX804D5E876F3447229776E8BC8517953A">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CombatService.luau : manual class swings, MP skills, damage formulas,
-- player damage / heal, regen and the death pipeline (the ONLY KO entry point).
-- Server-authoritative: clients only send Swing / Release / SetAutoAttack intents.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "CombatService"

local CombatService = {}

------------------------------------------------------------------ public signals (top level)
-- info = { Stacks, Auto, Perfect, Center, Radius, Total, MonstersHit, PlayersHit, Healed = { Player } }
-- (Total = HP really removed, CR-M10; the Release Fx shows the dealt numbers)
CombatService.Released = Util.Signal.new()
-- (victim, amount, attacker) : fired by DamagePlayer only when attacker ~= nil, after the damage.
-- amount = HP actually removed (CR-M10: no overkill; 0 under a ForceField, still fired for the bait log)
CombatService.PlayerDamaged = Util.Signal.new()

local S = nil

------------------------------------------------------------------ private constants
local MANUAL_GRACE = 0.2 -- a press this close to swing-ready is queued once for network jitter
local MANUAL_QUEUE_RETRIES = 3 -- timer-precision retries for a queued manual swing
local WHIFF_REACH = 12 -- studs in front of the player used as the visual target of a whiffed ranged swing
local LOOP_WARN_INTERVAL = 10 -- seconds between two warnings of the same loop

-- factions that take part in PvP / goose tug (addendum A6: "Neutral" and "None" never do)
local PVP_FACTIONS = { Halo = true, Horns = true }

-- A15 hit feel: every damaged player gets a "Pain" Fx to ALL clients (pain sticker over that player), at most one per
-- victim per PAIN_GAP s; Big = crit or >= BIG_FRACTION of the victim's MaxHealth. Monsters a swing / release lands on
-- are shoved SHOVE_* studs (MonsterService.Shove applies the zone / water / owner rules) SHOVE_DELAY[attack][class] s
-- after the damage, so the slide starts when clients show the hit (contact frame / projectile flight).
-- Config.HitReact, fallbacks.
local HIT_REACT = Config.HitReact or {}
local REACT = {
	PAIN_GAP = HIT_REACT.PainGap or 0.4,
	BIG_FRACTION = HIT_REACT.BigHitFraction or 0.5,
	SHOVE_SWING = HIT_REACT.ShoveSwing or 1.2,
	SHOVE_CRIT = HIT_REACT.ShoveCrit or 1.6,
	SHOVE_RELEASE = HIT_REACT.ShoveRelease or 2,
	SHOVE_DELAY = type(HIT_REACT.ShoveDelay) == "table" and HIT_REACT.ShoveDelay or {},
}

-- review R1 tuning
local TUNE = {
	-- CR-L49: Swing / Release Fx go to the attacker + players whose root is within FxCullDistance + FX_SEND_PAD + the
	-- attack extent of the center (pad >= camera max zoom: 40, kaiju 60; clients cull from the camera)
	FX_CULL = (Config.Visuals and Config.Visuals.FxCullDistance) or 150,
	FX_SEND_PAD = 60,
	-- Approved clips: cosmetic contact/flight only; damage and cooldown still resolve immediately.
	MOTION = {
		Swing = {
			Warrior = { Contact = 0.23 },
			Mage = { Launch = 0.24, Flight = 0.2, Contact = 0.44 },
			Archer = { Launch = 0.22, Flight = 0.15, Contact = 0.37 },
		},
		Release = {
			Warrior = { Contact = 0.24 },
			Mage = { Launch = 0.35, Contact = 0.35 },
			Archer = { Launch = 0.18, Contact = 0.4 },
		},
	},
}

------------------------------------------------------------------ per-player state (session only)
local nextSwingAt = {} -- [Player] = os.clock() when the next manual swing is allowed
local lastManualAt = {} -- [Player] = os.clock() of the last manual attack / skill request (auto combat yields)
local pendingManual = {} -- [Player] = true while one queued manual swing waits for the cooldown
local lastDamagedAt = {} -- [Player] = os.clock() of the last damage of any kind
local lastPvPAttacker = {} -- [Player] = { Player = Player, T = os.clock() }
local lastPvPTime = {} -- [Player] = os.clock() of the last PvP damage dealt or received
local painAt = {} -- [Player] = os.clock() of the last "Pain" Fx (A15)
local lastLoopWarn = {} -- [loopName] = os.clock()
local guard = {
	releaseAt = {}, -- accepted skill time; protects direct server calls as well as the remote
	acLogAt = {}, -- CR-H2: [Player] = os.clock() of the last implausible-position log
}

------------------------------------------------------------------ small helpers
local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function numAttr(player, key, default)
	local v = player:GetAttribute(key)
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return v
end

local function byDist(a, b)
	return a.Dist < b.Dist
end

local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= LOOP_WARN_INTERVAL then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

-- faction(p) = S.FactionService.GetFaction(p)
local function faction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then
		return "None"
	end
	return f
end

-- perks = S.FactionService.GetPerks(p) (falls back to the Config table / None)
local function perksOf(player)
	local p = S.FactionService.GetPerks(player)
	if type(p) ~= "table" then
		p = Config.Factions[faction(player)] or Config.Factions.None
	end
	return p
end

-- cls(p) = S.ClassService.GetClassDef(p)
local function cls(player)
	local c = S.ClassService.GetClassDef(player)
	if type(c) ~= "table" then
		c = Config.Classes.Warrior
	end
	return c
end

-- stars(p) = S.PvPService.GetStars(p)
local function stars(player)
	local n = S.PvPService.GetStars(player)
	if type(n) ~= "number" then
		return 0
	end
	return n
end

-- kstate(p) = S.KaijuService.GetState(p)
local function kstate(player)
	local st = S.KaijuService.GetState(player)
	if type(st) ~= "string" then
		return "None"
	end
	return st
end

-- goose body center if this player's swings can count on it (Halo / Horns only), else nil
local function goosePositionFor(player)
	if not PVP_FACTIONS[faction(player)] then
		return nil
	end
	local pos = S.GooseService.GetPosition()
	if typeof(pos) ~= "Vector3" then
		return nil
	end
	return pos
end

local function weaponPosition(character, classId, fallback)
	local weapon = character:FindFirstChild("WeaponModel")
	local muzzle = weapon and weapon:GetAttribute("Class") == classId
		and weapon:FindFirstChild("AttackMuzzle", true)
	if muzzle and muzzle:IsA("Attachment") and muzzle.Parent and muzzle.Parent:IsA("BasePart") then
		return muzzle.WorldPosition
	end
	local hand = classId == "Archer" and Util.FindPart(character, "LeftHand", "Left Arm")
		or (classId ~= "Archer" and Util.FindPart(character, "RightHand", "Right Arm"))
	if hand then
		return hand.Position
	end
	return fallback
end

-- a point `reach` studs in front of the root on the ground plane (visual target of a whiffed ranged swing)
local function forwardPoint(root, reach)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end
	return root.Position + flat * reach
end

-- CR-H2: true when this Swing / Release must be ignored. The zone level gate (the attacker stands in a zone whose
-- MinLevel is above their Level: a teleport hop into a gated zone) is always enforced. ZoneService.IsPlausible logs
-- an implausible position itself ("suspicious move (check, ...)", shared LogCooldown with its zone loop) and returns
-- false ONLY while Config.AntiCheat.Enforce is true, so in log-only mode nothing is blocked or logged here. The
-- Swing / Release line below (at most once per AntiCheat.LogCooldown s) appears only when enforcing; `enforce` is
-- re-checked so blocking stays gated on Config even if ZoneService ever returns false without it.
local function attackBlocked(player, root, what)
	local pos = root.Position
	local zone = Config.ZoneAt(pos)
	if (zone.MinLevel or 1) > numAttr(player, "Level", 1) then
		return true
	end
	local zs = S.ZoneService
	if not (zs and type(zs.IsPlausible) == "function") then
		return false
	end
	local ok, plausible = pcall(zs.IsPlausible, player, pos)
	if not ok then
		loopWarn("IsPlausible", plausible)
		return false
	end
	if plausible ~= false then
		return false
	end
	local ac = Config.AntiCheat or {}
	local enforce = ac.Enforce == true
	local now = os.clock()
	if now - (guard.acLogAt[player] or -math.huge) >= (ac.LogCooldown or 10) then
		guard.acLogAt[player] = now
		Util.Warn(
			TAG,
			string.format(
				"CR-H2%s implausible %s position: %s (%d) at %s",
				enforce and "" or " (log only)",
				tostring(what),
				player.Name,
				player.UserId,
				tostring(pos)
			)
		)
	end
	return enforce
end

-- CR-L49: a Swing / Release Fx for the attacker and the players near `center` only (`extent` = the attack's reach
-- around the center); everyone else would cull it on the client anyway
local function fxNear(attacker, kind, center, extent, data)
	local reach = TUNE.FX_CULL + TUNE.FX_SEND_PAD + math.max(0, tonumber(extent) or 0)
	for _, rp in Players:GetPlayers() do
		local send = rp == attacker
		if not send then
			local r = Util.GetRoot(rp)
			send = r ~= nil and (r.Position - center).Magnitude <= reach
		end
		if send then
			Net.Fx(rp, kind, data)
		end
	end
end

------------------------------------------------------------------ removed gauge: legacy attributes stay zero
local function resetLegacyCharge(player)
	if player.Parent == nil then
		return
	end
	player:SetAttribute("Charge", 0)
	player:SetAttribute("ChargeCap", 0)
	player:SetAttribute("PerfectUntil", 0)
end

------------------------------------------------------------------ target selection
-- alive monsters this player may hit within `radius` (flat) of `point`, nearest first: { { Rec, Pos, Dist } }
-- (addendum C2: always passes the attacking player; personal monsters of other players are filtered here too)
-- CR-H2: zone monsters of a zone whose MinLevel is above the attacker's Level are never targets (personal: always)
local function monstersNear(player, point, radius)
	local out = {}
	if radius <= 0 then
		return out
	end
	local list = S.MonsterService.GetMonstersInRadius(point, radius, player)
	if type(list) ~= "table" then
		return out
	end
	local level = numAttr(player, "Level", 1)
	for _, rec in list do
		local zone = type(rec) == "table" and rec.Owner == nil and Config.Zones[rec.ZoneId] or nil
		local gated = zone ~= nil and (zone.MinLevel or 1) > level
		if type(rec) == "table" and rec.Alive and (rec.Owner == nil or rec.Owner == player) and not gated then
			local root = rec.Root
			if root and root.Parent then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius then
					table.insert(out, { Rec = rec, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- ranged classes aim forward: keep only entries within `cone` degrees of the root's flat facing (nil = no limit).
-- The client turns the character toward its target when the button is pressed, so this rarely drops a target.
local function inAim(root, pos, cone)
	if type(cone) ~= "number" or cone >= 180 then return true end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	local dir = (pos - root.Position) * Vector3.new(1, 0, 1)
	if dir.Magnitude < 1 or look.Magnitude < 0.01 then return true end -- on top of me: always fine
	return look.Unit:Dot(dir.Unit) >= math.cos(math.rad(cone))
end

local function aimed(list, root, cone)
	if type(cone) ~= "number" then return list end
	local out = {}
	for _, e in list do
		if inAim(root, e.Pos, cone) then table.insert(out, e) end
	end
	return out
end

-- other players `attacker` may damage (S.PvPService.CanAttack) within `radius` (flat) of `point`, nearest first:
-- { { Player, Pos, Dist } }. Neutral / None never attack and are never attacked (addendum A6).
local function playersNear(attacker, point, radius)
	local out = {}
	if radius <= 0 or not PVP_FACTIONS[faction(attacker)] then
		return out
	end
	for _, v in S.PlayerService.GetReadyPlayers() do
		if v ~= attacker and v.Parent and PVP_FACTIONS[faction(v)] and Util.IsAlive(v) then
			local root = Util.GetRoot(v)
			if root then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius and S.PvPService.CanAttack(attacker, v) == true then
					table.insert(out, { Player = v, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- other alive Halo players within the party-aura radius of the attacker
local function countAuraAllies(attacker, radius)
	if type(radius) ~= "number" or radius <= 0 then
		return 0
	end
	local root = Util.GetRoot(attacker)
	if not root then
		return 0
	end
	local n = 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if p ~= attacker and p.Parent and faction(p) == "Halo" and Util.IsAlive(p) then
			local r = Util.GetRoot(p)
			if r and Util.FlatDistance(r.Position, root.Position) <= radius then
				n += 1
			end
		end
	end
	return n
end

------------------------------------------------------------------ damage formulas (public)
-- additive bonus sum
function CombatService.GetDamageBonus(attacker, victim)
	local perks = perksOf(attacker)
	local bonus = perks.DamageBonus or 0
	bonus += stars(attacker) * Config.PvP.StarDamageBonus
	if faction(attacker) == "Halo" and (perks.PartyAuraPerAlly or 0) > 0 then
		local allies = math.min(perks.PartyAuraMaxAllies or 0, countAuraAllies(attacker, perks.PartyAuraRadius))
		bonus += perks.PartyAuraPerAlly * allies
	end
	if victim ~= nil and S.PvPService.HasRevenge(attacker, victim) == true then
		bonus += Config.Revenge.Bonus
	end
	return bonus
end

-- multiplicative factor: Size Justice S x bully factor (JusticeService) x ranged-vs-player factor
function CombatService.GetDamageMult(attacker, victim)
	local c = cls(attacker)
	local mult = S.JusticeService.GetDamageMult(attacker)
	if type(mult) ~= "number" or mult ~= mult then
		mult = 1
	end
	if victim ~= nil and c.Ranged then
		mult *= (c.PvPMult or 1)
	end
	return mult
end

-- NORMAL per-target monster hit (unrounded), before the 50% immediate rule
function CombatService.ComputeMonsterHit(attacker, allowCrit)
	local c = cls(attacker)
	local level = numAttr(attacker, "Level", 1)
	local tier = numAttr(attacker, "WeaponTier", 1)
	local dmg = Config.WeaponDamage(tier, level, numAttr(attacker, "WeaponEnhance", 0))
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, nil))
		* CombatService.GetDamageMult(attacker, nil)
	local crit = allowCrit == true and Util.Random:NextNumber() < Config.Combat.CritChance
	if crit then
		dmg *= Config.Combat.CritMult
	end
	return dmg, crit
end

-- NORMAL per-target PvP hit (unrounded): based on the victim's BASE MaxHealth (no Size Justice, no kaiju)
function CombatService.ComputePvPHit(attacker, victim)
	local c = cls(attacker)
	local aLevel = numAttr(attacker, "Level", 1)
	local aTier = numAttr(attacker, "WeaponTier", 1)
	local vLevel = numAttr(victim, "Level", 1)
	local vTier = numAttr(victim, "WeaponTier", 1)
	local vClass = S.ClassService.GetClass(victim)
	local base = Config.MaxHealth(vLevel, faction(victim), vClass) * Config.PvP.HitPctOfMaxHP
	-- A23-12: enhancement and the legendary tier only move this ratio; the PvP clamp below still caps it
	local vWeapon = Config.WeaponDamage(vTier, vLevel, numAttr(victim, "WeaponEnhance", 0))
	local ratio = Config.PvP.PowerRatioMax
	if vWeapon > 0 then
		ratio = Config.WeaponDamage(aTier, aLevel, numAttr(attacker, "WeaponEnhance", 0)) / vWeapon
	end
	ratio = math.clamp(ratio, Config.PvP.PowerRatioMin, Config.PvP.PowerRatioMax)
	return base
		* ratio
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, victim))
		* CombatService.GetDamageMult(attacker, victim)
end

------------------------------------------------------------------ heal / damage (public)
function CombatService.HealPlayer(player, amount)
	if not isPlayer(player) then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return 0 -- never revive
	end
	local missing = hum.MaxHealth - hum.Health
	if missing <= 0 then
		return 0
	end
	local heal = math.min(Util.RoundDamage(amount), missing)
	hum.Health = hum.Health + heal
	return heal
end

local function tagCombat(player)
	lastPvPTime[player] = os.clock()
	if player.Parent then
		player:SetAttribute("InCombatUntil", Util.Now() + Config.PvP.CombatTagTime)
	end
end

-- A15: "Pain" Fx to every client (pain sticker / flinch over the victim), throttled per victim. A lethal hit is left to
-- the KO effects.
local function sendPain(victim, hum, rootPos, applied, crit)
	if applied <= 0 or hum.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - (painAt[victim] or -math.huge) < REACT.PAIN_GAP then
		return
	end
	painAt[victim] = now
	local big = crit == true or (hum.MaxHealth > 0 and applied >= hum.MaxHealth * REACT.BIG_FRACTION)
	Net.Fx(nil, "Pain", { UserId = victim.UserId, Pos = rootPos, Big = big })
end

-- attacker nil = monster (or any non-player source); crit (optional) = the hit was a critical hit (Pain "Big").
-- Returns the HP actually removed (CR-M10: no overkill, 0 when nothing was applied).
function CombatService.DamagePlayer(victim, amount, attacker, crit)
	if not isPlayer(victim) or victim.Parent == nil then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	if attacker ~= nil and (not isPlayer(attacker) or attacker == victim) then
		attacker = nil
	end
	-- addendum A6: Neutral (and unassigned) players never deal or receive player damage
	if attacker and (not PVP_FACTIONS[faction(attacker)] or not PVP_FACTIONS[faction(victim)]) then
		return 0
	end
	if not Util.IsAlive(victim) then
		return 0
	end
	local hum = Util.GetHumanoid(victim)
	local root = Util.GetRoot(victim)
	if not hum or not root then
		return 0
	end

	amount = Util.RoundDamage(amount)
	local now = os.clock()
	lastDamagedAt[victim] = now
	if attacker then
		-- bookkeeping BEFORE the damage so a lethal hit is always credited by the death pipeline
		lastPvPAttacker[victim] = { Player = attacker, T = now }
		tagCombat(victim)
		tagCombat(attacker)
	end

	local rootPos = root.Position
	local before = hum.Health
	hum:TakeDamage(amount) -- respects ForceField
	local applied = math.max(0, before - hum.Health)
	-- P1 (2026-10-05): only a PLAYER hit is the victim's activity; an AFK player hit by a slime stays idle
	-- (regular luck, size scale and faction headcount use IdleSeconds)
	if attacker then S.PlayerService.MarkActive(victim) end
	local okPain, errPain = pcall(sendPain, victim, hum, rootPos, applied, crit)
	if not okPain then
		loopWarn("Pain", errPain)
	end

	-- CR-M23: the victim always sees the hit number + red edge, whoever the attacker is (PvP swings, kaiju stomps)
	if applied > 0 then
		Net.Fx(victim, "Hurt", { Pos = rootPos, Amount = applied })
	end

	if attacker then
		CombatService.PlayerDamaged:Fire(victim, applied, attacker) -- CR-M10: real damage (fired even when 0)
	end
	return applied
end

------------------------------------------------------------------ queries (public)
function CombatService.IsInCombat(player)
	local t = lastPvPTime[player]
	return t ~= nil and os.clock() - t <= Config.PvP.CombatTagTime
end

function CombatService.GetLastDamagedAt(player)
	return lastDamagedAt[player] or 0
end

function CombatService.GetLastPvPAttacker(player)
	local e = lastPvPAttacker[player]
	if not e then
		return nil
	end
	if os.clock() - e.T > Config.PvP.CombatTagTime then
		return nil
	end
	local p = e.Player
	if not p or p.Parent == nil then
		return nil
	end
	return p
end

function CombatService.GetCharge(_player)
	return 0 -- compatibility query; the gauge no longer exists
end

-- Retired Studio QA setter: may clear compatibility attributes, but cannot restore a gauge.
function CombatService.DebugSetCharge(player, amount)
	if not game:GetService("RunService"):IsStudio() or not isPlayer(player)
		or type(amount) ~= "number" or amount ~= amount or amount == math.huge or amount == -math.huge then
		return false
	end
	resetLegacyCharge(player)
	return amount == 0 -- legacy QA cannot restore removed gameplay
end

------------------------------------------------------------------ lifesteal
local function applyLifesteal(player, perks, total)
	local rate = perks.Lifesteal or 0
	if rate <= 0 or total <= 0 then
		return
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return
	end
	-- CR-M8: an Active kaiju's cap uses its health WITHOUT the kaiju multiplier (x20 MaxHealth outhealed the raid)
	local capBase = hum.MaxHealth
	if kstate(player) == "Active" and S.KaijuService and type(S.KaijuService.GetHealthMult) == "function" then
		local okK, km = pcall(S.KaijuService.GetHealthMult, player)
		if okK and type(km) == "number" and km > 1 then
			capBase = capBase / km
		end
	end
	CombatService.HealPlayer(player, math.min(total * rate, capBase * (perks.LifestealCapPct or 0)))
end

-- CR-M10: damage a monster and return the HP it actually lost (no overkill; 0 when the hit was refused).
-- killed = DamageMonster's own result
local function damageMonster(rec, dealt, player, crit)
	local hpBefore = math.max(0, tonumber(rec.HP) or 0)
	local killed = S.MonsterService.DamageMonster(rec, dealt, player, crit)
	local applied = math.max(0, hpBefore - math.max(0, tonumber(rec.HP) or 0))
	return killed, applied
end

------------------------------------------------------------------ A15 monster shove
-- a small slide of a monster my hit landed on, away from `fromPos` (cosmetic: a failure never breaks the hit loop)
local function shoveMonster(rec, fromPos, studs, player)
	if not rec.Alive or type(S.MonsterService.Shove) ~= "function" then
		return
	end
	local ok, err = pcall(S.MonsterService.Shove, rec, fromPos, studs, player)
	if not ok then
		loopWarn("Shove", err)
	end
end

-- Cosmetic shove follows the same contact frame that the Fx packet announces.
local function shoveLater(attack, classId, rec, fromPos, studs, player)
	local byClass = REACT.SHOVE_DELAY[attack]
	local motion = TUNE.MOTION[attack] and TUNE.MOTION[attack][classId]
	local d = motion and motion.Contact or (type(byClass) == "table" and tonumber(byClass[classId]) or 0)
	if d > 0 then
		local character = Util.GetCharacter(player)
		task.delay(math.min(d, 1), function()
			if player.Parent and Util.IsAlive(player) and Util.GetCharacter(player) == character
				and cls(player).Id == classId then shoveMonster(rec, fromPos, studs, player) end
		end)
	else
		shoveMonster(rec, fromPos, studs, player)
	end
end

------------------------------------------------------------------ auto combat (A23-1)
-- Unlocked by the optional quest "내 싸움을 배우는 왕관 조각", starts OFF, toggled and saved by the player.
-- The server loop calls the same Swing / Release paths with the auto flag: same interval, MP, cooldown, range and
-- "one cast = one hit" rules; the auto branches never select players (monsters / goose only, no PvP).
local function autoReady(player)
	return isPlayer(player) and player.Parent ~= nil
		and player:GetAttribute("AutoCombatUnlocked") == true and player:GetAttribute("AutoCombatEnabled") == true
		and player:GetAttribute("ClassChosen") == true and kstate(player) == "None"
		and S.PlayerService.IsReady(player) and Util.IsAlive(player)
end

------------------------------------------------------------------ swing (public)
function CombatService.Swing(player, isManual)
	if isManual ~= true and not autoReady(player) then return end -- auto only while auto combat is ON
	isManual = isManual == true
	if not isPlayer(player) or player.Parent == nil or not S.PlayerService.IsReady(player)
		or player:GetAttribute("ClassChosen") ~= true or not Util.IsAlive(player) then
		return
	end
	local character = Util.GetCharacter(player)
	local root = Util.GetRoot(player)
	if not character or not root then
		return
	end
	-- CR-H2: zone level gate + movement plausibility (before the cooldown: a refused swing costs nothing)
	if attackBlocked(player, root, "Swing") then
		return
	end

	-- 1. server-owned manual swing cooldown
	local now = os.clock()
	if now < (nextSwingAt[player] or 0) then
		return
	end
	local c = cls(player)
	if c.Id == "Mage" and not S.VitalsService.TrySpendMana(player, Config.Vitals.MageSwingCost, not isManual) then
		return
	end
	nextSwingAt[player] = now + (c.SwingInterval or 1)

	local pos = root.Position
	local fac = faction(player)
	local perks = perksOf(player)
	local goosePos = goosePositionFor(player)
	local gooseReach = Config.Goose.HitRadius
	local range = c.Range or 10

	-- 2. select targets by class pattern
	local monsters = {} -- { { Rec, Pos, Dist } }
	local victims = {} -- { { Player, Pos, Dist } }
	local hitGoose = false
	local center = pos
	local radius = range
	local targets = {}

	if c.Pattern == "Splash" then
		radius = c.Splash or 0
		local pickPos, pickDist, pickIsGoose = nil, math.huge, false
		local nearMon = aimed(monstersNear(player, pos, range), root, c.AimCone)
		if nearMon[1] then
			pickPos, pickDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if isManual then
			local nearPl = aimed(playersNear(player, pos, range), root, c.AimCone)
			if nearPl[1] and nearPl[1].Dist < pickDist then
				pickPos, pickDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if goosePos and inAim(root, goosePos, c.AimCone) then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach and d < pickDist then
				pickPos, pickDist, pickIsGoose = goosePos, d, true
			end
		end
		if pickPos then
			center = pickPos
			monsters = monstersNear(player, center, radius)
			if isManual then
				victims = playersNear(player, center, radius)
			end
			hitGoose = goosePos ~= nil
				and (pickIsGoose or Util.FlatDistance(goosePos, center) <= radius + gooseReach)
		else
			center = forwardPoint(root, math.min(range, WHIFF_REACH)) -- whiff: the orb flies forward
		end
		targets = { center }
	elseif c.Pattern == "Multi" then
		radius = 0
		local maxTargets = c.Targets or 0
		local candidates = {}
		for _, m in aimed(monstersNear(player, pos, range), root, c.AimCone) do
			table.insert(candidates, { Kind = "M", Entry = m, Pos = m.Pos, Dist = m.Dist })
		end
		if isManual then
			for _, v in aimed(playersNear(player, pos, range), root, c.AimCone) do
				table.insert(candidates, { Kind = "P", Entry = v, Pos = v.Pos, Dist = v.Dist })
			end
		end
		if goosePos and inAim(root, goosePos, c.AimCone) then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach then
				table.insert(candidates, { Kind = "G", Pos = goosePos, Dist = d })
			end
		end
		table.sort(candidates, byDist)
		for i, cand in candidates do
			if maxTargets > 0 and i > maxTargets then
				break
			end
			table.insert(targets, cand.Pos)
			if cand.Kind == "M" then
				table.insert(monsters, cand.Entry)
			elseif cand.Kind == "P" then
				table.insert(victims, cand.Entry)
			else
				hitGoose = true
			end
		end
		if #targets == 0 then
			targets = { forwardPoint(root, math.min(range, WHIFF_REACH)) } -- whiff: the arrow flies forward
		end
	else -- "Around" (default): everything within Range of self, in front of me (AimCone)
		monsters = aimed(monstersNear(player, pos, range), root, c.AimCone)
		if isManual then
			victims = aimed(playersNear(player, pos, range), root, c.AimCone)
		end
		hitGoose = goosePos ~= nil and Util.FlatDistance(goosePos, pos) <= range + gooseReach
			and inAim(root, goosePos, c.AimCone)
	end

	local hits = {}
	local totalDealt, monstersHit, playersHit = 0, 0, 0

	-- 3. monsters: 50% of the normal hit right away (crit rolled per target)
	if #monsters > 0 then
		local base = CombatService.ComputeMonsterHit(player, false)
		for _, m in monsters do
			local rec = m.Rec
			if rec.Alive then
				local crit = Util.Random:NextNumber() < Config.Combat.CritChance
				local d = base * (crit and Config.Combat.CritMult or 1)
				local dealt = Util.RoundDamage(d * ((Config.BasicSkill and Config.BasicSkill.SwingImmediate) or 0.5))
				local killed, applied = damageMonster(rec, dealt, player, crit)
				if killed or applied > 0 then -- 0 = refused by MonsterService (owner / zone rules): not a hit
					if not killed then
						shoveLater("Swing", c.Id, rec, pos, crit and REACT.SHOVE_CRIT or REACT.SHOVE_SWING, player) -- A15
					end
					table.insert(hits, { P = m.Pos, A = dealt, C = crit, K = "M" }) -- the number shows the hit as dealt
					totalDealt += applied -- CR-M10: lifesteal counts real damage only
					monstersHit += 1
				end
			end
		end
	end

	-- 4. players (manual swings only; already validated with CanAttack)
	for _, v in victims do
		local vp = v.Player
		if vp.Parent and Util.IsAlive(vp) then
			local dealt = Util.RoundDamage(CombatService.ComputePvPHit(player, vp)
				* ((Config.BasicSkill and Config.BasicSkill.SwingImmediate) or 0.5))
			totalDealt += CombatService.DamagePlayer(vp, dealt, player) or 0 -- CR-M10
			table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P", V = vp.UserId }) -- CR-M23: V = victim
			playersHit += 1
		end
	end
	if playersHit > 0 then
		S.PvPService.BreakProtection(player)
	end

	-- 5. golden goose: no damage, no charge. CR-L21: the number is what RegisterHit really counted (0 = none)
	if hitGoose and goosePos then
		local okG, counted = pcall(S.GooseService.RegisterHit, player, isManual)
		if not okG then
			loopWarn("GooseHit", counted)
			counted = 0
		elseif counted == nil then
			counted = isManual and Config.Goose.ManualCount or Config.Goose.AutoCount -- GooseService without a return
		end
		if type(counted) == "number" and counted == counted and counted > 0 then
			table.insert(hits, {
				P = goosePos,
				A = math.floor(counted * 10 + 0.5) / 10,
				C = false,
				K = "G",
			})
		end
	end

	-- 7. lifesteal (Horns)
	applyLifesteal(player, perks, totalDealt)

	-- 8. activity
	local anyHit = monstersHit + playersHit > 0 or hitGoose
	if isManual or anyHit then
		if isManual then S.PlayerService.MarkActive(player) end -- auto hits never count as the player being active

		-- 9. visuals for the attacker + everyone near (manual whiffs too, with empty Hits). CR-L49: the extent covers
		-- the hand (Splash center up to Range away) and Multi targets (radius 0, up to Range away)
		fxNear(player, "Swing", center, math.max(radius, range), {
			UserId = player.UserId,
			Character = character,
			Class = c.Id,
			Faction = fac,
			From = weaponPosition(character, c.Id, pos),
			ContactDelay = TUNE.MOTION.Swing[c.Id] and TUNE.MOTION.Swing[c.Id].Contact,
			LaunchDelay = TUNE.MOTION.Swing[c.Id] and TUNE.MOTION.Swing[c.Id].Launch,
			FlightTime = TUNE.MOTION.Swing[c.Id] and TUNE.MOTION.Swing[c.Id].Flight,
			Pos = center,
			Radius = radius,
			Targets = targets,
			Hits = hits,
			Manual = isManual, -- A15: clients kick the camera on manual hits only
		})
	end
end

------------------------------------------------------------------ release (public)
function CombatService.Release(player, isAuto)
	if isAuto == true and not autoReady(player) then return end -- auto skills only while auto combat is ON
	isAuto = isAuto == true
	if not isPlayer(player) or player.Parent == nil or not S.PlayerService.IsReady(player)
		or player:GetAttribute("ClassChosen") ~= true or not Util.IsAlive(player) then
		return
	end
	local root = Util.GetRoot(player)
	if not root then
		return
	end
	-- CR-H2: zone level gate + movement plausibility (MP is kept)
	if attackBlocked(player, root, "Release") then
		return
	end

	-- 1. MP and a server cooldown are the only skill resources; there is no gauge or PERFECT window.
	local skill = Config.BasicSkill or {}
	local now = os.clock()
	local cooldown = skill.Cooldown or 3
	if now - (guard.releaseAt[player] or -math.huge) < cooldown then return end
	if not S.VitalsService.TrySpendMana(player, skill.ManaCost or Config.Vitals.ReleaseCost, isAuto) then return end -- auto: silent
	guard.releaseAt[player] = now -- failed eligibility/MP checks do not consume the successful-use cooldown
	player:SetAttribute("SkillReadyAt", Util.Now() + cooldown)
	local c = cls(player)
	local fac = faction(player)
	local perks = perksOf(player)

	-- 3. center + radius
	local pos = root.Position
	local center = pos
	if c.ReleaseCenter == "Target" then
		local range = c.Range or 10
		local bestPos, bestDist = nil, math.huge
		local nearMon = aimed(monstersNear(player, pos, range), root, c.AimCone)
		if nearMon[1] then
			bestPos, bestDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if not isAuto then
			local nearPl = aimed(playersNear(player, pos, range), root, c.AimCone)
			if nearPl[1] and nearPl[1].Dist < bestDist then
				bestPos, bestDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if bestPos then
			center = bestPos
		end
	end
	local radius = skill.Radius or 9
	local releaseMult = (skill.DamageMultiplier or 6) * (c.ReleaseMult or 1)

	local hits = {}
	-- total = HP really removed (CR-M10: heal / lifesteal / Released.Total); shownTotal = the dealt numbers (Fx)
	local total, shownTotal, monstersHit, playersHit = 0, 0, 0, 0

	-- 4. monsters (never crit)
	local monsters = monstersNear(player, center, radius)
	if #monsters > 0 then
		local D = CombatService.ComputeMonsterHit(player, false)
		local dealt = Util.RoundDamage(D * releaseMult)
		for _, m in monsters do
			if m.Rec.Alive then
				-- marked before the damage: a kill made by this skill counts as a skill kill (S0 trial: basic-attack-only)
				m.Rec._skillBy = m.Rec._skillBy or {}
				m.Rec._skillBy[player] = true
				local killed, applied = damageMonster(m.Rec, dealt, player, nil)
				if killed or applied > 0 then -- 0 = refused by MonsterService (owner / zone rules): not a hit
					if not killed then
						-- A15: a blast pushes outward from its center; the monster at the center goes away from me
						local from = Util.FlatDistance(m.Pos, center) > 0.5 and center or pos
						shoveLater("Release", c.Id, m.Rec, from, REACT.SHOVE_RELEASE, player)
					end
					table.insert(hits, { P = m.Pos, A = dealt, C = false, K = "M" })
					total += applied
					shownTotal += dealt
					monstersHit += 1
				end
			end
		end
	end

	-- 5. players (manual releases only), capped at PvPCapPct of the target's current MaxHealth
	-- (CR-M7: an Active kaiju at Kaiju.ReleaseCapPct, so its x20 HP is not 3 shots of saved-up stacks)
	if not isAuto then
		for _, v in playersNear(player, center, radius) do
			local vp = v.Player
			local vHum = Util.GetHumanoid(vp)
			if vp.Parent and vHum and vHum.Health > 0 then
				local D = CombatService.ComputePvPHit(player, vp)
				local capPct = skill.PvPCapPct or 0.35
				if kstate(vp) == "Active" then
					capPct = Config.Kaiju.ReleaseCapPct or 0.08
				end
				local raw = math.min(D * releaseMult, capPct * vHum.MaxHealth)
				local dealt = Util.RoundDamage(raw)
				total += CombatService.DamagePlayer(vp, dealt, player) or 0 -- CR-M10
				table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P", V = vp.UserId }) -- CR-M23: V = victim
				shownTotal += dealt
				playersHit += 1
			end
		end
		if playersHit > 0 then
			S.PvPService.BreakProtection(player)
		end
	end

	-- 6. Halo skill support heals nearby allies (self included); no charge-sharing remains.
	-- Healing still uses actual HP removed, so a whiff heals nothing.
	local healed = {}
	local healPct = skill.HaloHealPct or 0.10
	local healCapPct = skill.HaloHealCapPct or 0.30
	if perks.ReleaseSupport == true and fac == "Halo" then
		for _, a in S.PlayerService.GetReadyPlayers() do
			if a.Parent and faction(a) == "Halo" and Util.IsAlive(a) then
				local aRoot = Util.GetRoot(a)
				local aHum = Util.GetHumanoid(a)
				if aRoot and aHum and Util.FlatDistance(aRoot.Position, center) <= radius then
					local amount = CombatService.HealPlayer(
						a,
						math.min(healPct * total, healCapPct * aHum.MaxHealth)
					)
					if a ~= player then
						if amount > 0 then
							table.insert(healed, a)
						end
					end
				end
			end
		end
	end

	-- 7. lifesteal (Horns) on the total
	applyLifesteal(player, perks, total)

	-- 8. activity
	if not isAuto then
		S.PlayerService.MarkActive(player)
	end

	-- 9. visuals (CR-L49: the attacker + players near the blast) + signal
	fxNear(player, "Release", center, radius, {
		UserId = player.UserId,
		Character = Util.GetCharacter(player),
		Class = c.Id,
		Faction = fac,
		ContactDelay = TUNE.MOTION.Release[c.Id] and TUNE.MOTION.Release[c.Id].Contact,
		LaunchDelay = TUNE.MOTION.Release[c.Id] and TUNE.MOTION.Release[c.Id].Launch,
		Pos = center,
		Radius = radius,
		Stacks = 0, -- legacy Fx compatibility only
		Perfect = false,
		Auto = isAuto,
		Total = shownTotal, -- the big number = the sum of the hit numbers shown
		Hits = hits,
	})
	CombatService.Released:Fire(player, {
		Stacks = 0, -- legacy event compatibility; never fabricate quest charge
		Auto = isAuto,
		Perfect = false,
		Center = center,
		Radius = radius,
		Total = total,
		MonstersHit = monstersHit,
		PlayersHit = playersHit,
		Healed = healed,
	})
end

------------------------------------------------------------------ death pipeline (the only KO entry point)
local function pipelineCall(label, fn, ...)
	if type(fn) ~= "function" then
		Util.Warn(TAG, "death pipeline: missing " .. label)
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		Util.Warn(TAG, "death pipeline: " .. label .. " failed: " .. tostring(err))
	end
end

local function runDeathPipeline(victim)
	if victim.Parent == nil then
		-- the victim already left: leave flows (GrudgeService / ProgressionService) handle it
		lastPvPAttacker[victim] = nil
		return
	end

	local killer = CombatService.GetLastPvPAttacker(victim)
	if killer then
		local fk, fv = faction(killer), faction(victim)
		-- "None" and "Neutral" never take part in PvP KOs (addendum A6)
		if killer == victim or killer.Parent == nil or fk == fv or not PVP_FACTIONS[fk] or not PVP_FACTIONS[fv] then
			killer = nil
		end
	end

	-- 1. resolve a grudge sack first (no-op without one)
	pipelineCall("GrudgeService.OnCarrierDown", S.GrudgeService.OnCarrierDown, victim, killer)

	-- 2. kaiju / PvP KO / non-PvP death
	local okState, state = pcall(kstate, victim)
	if okState and state == "Active" then
		pipelineCall("KaijuService.HandleKaijuDeath", S.KaijuService.HandleKaijuDeath, victim, killer)
	elseif killer then
		pipelineCall("PvPService.HandleKO", S.PvPService.HandleKO, victim, killer)
	else
		pipelineCall("PvPService.HandleNonPvPDeath", S.PvPService.HandleNonPvPDeath, victim)
	end

	-- 3. clear legacy attributes and forget the attacker
	resetLegacyCharge(victim)
	lastPvPAttacker[victim] = nil
end

local function onCharacterDied(player, _character)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	-- deferred so the lethal hit's PlayerDamaged handlers (kaiju damage share, bait log) always run first,
	-- whatever the Workspace.SignalBehavior is
	task.defer(function()
		local ok, err = pcall(runDeathPipeline, player)
		if not ok then
			Util.Warn(TAG, "death pipeline error: " .. tostring(err))
		end
	end)
end

------------------------------------------------------------------ player lifecycle handlers
local function onPlayerReady(player, _data)
	if not isPlayer(player) or player.Parent == nil then
		return
	end
	nextSwingAt[player] = 0
	guard.releaseAt[player] = nil
	player:SetAttribute("SkillReadyAt", 0)
	player:SetAttribute("AutoAttack", false)
	player:SetAttribute("InCombatUntil", 0)
	resetLegacyCharge(player)
end

local function onCharacterSpawned(player, _character, _humanoid, cosmetic)
	if not isPlayer(player) or player.Parent == nil then return end
	resetLegacyCharge(player)
	player:SetAttribute("AutoAttack", false)
	if not cosmetic then
		-- Match VitalsService's real-respawn MP reset; changing appearance cannot bypass a skill cooldown.
		guard.releaseAt[player] = nil
		player:SetAttribute("SkillReadyAt", 0)
	end
end

local function onPlayerLeaving(player, _data)
	-- deferred: other PlayerLeaving handlers (ProgressionService combat-log penalty) still read IsInCombat
	task.defer(function()
		nextSwingAt[player] = nil
		lastManualAt[player] = nil
		pendingManual[player] = nil
		lastDamagedAt[player] = nil
		lastPvPAttacker[player] = nil
		lastPvPTime[player] = nil
		painAt[player] = nil
		guard.releaseAt[player] = nil
		guard.acLogAt[player] = nil -- CR-H2
	end)
end

local function onFactionChanged(player, _newFaction, _oldFaction, _reason)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	resetLegacyCharge(player)
end

local function onClassChanged(player, _newClass, _oldClass)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	resetLegacyCharge(player)
end

------------------------------------------------------------------ remotes
-- one queued manual swing that fires as soon as the shared cooldown is ready (addendum H3)
local function queueManualSwing(player)
	local request = { Character = Util.GetCharacter(player), Class = cls(player).Id, Faction = faction(player) }
	pendingManual[player] = request
	local tries = 0
	local function attempt()
		if pendingManual[player] ~= request then
			return
		end
		if player.Parent == nil or not S.PlayerService.IsReady(player) or player:GetAttribute("ClassChosen") ~= true
			or not Util.IsAlive(player)
			or Util.GetCharacter(player) ~= request.Character or cls(player).Id ~= request.Class
			or faction(player) ~= request.Faction then
			pendingManual[player] = nil
			return
		end
		local remaining = (nextSwingAt[player] or 0) - os.clock()
		if remaining > 0 and tries < MANUAL_QUEUE_RETRIES then
			tries += 1
			task.delay(remaining, attempt)
			return
		end
		pendingManual[player] = nil
		CombatService.Swing(player, true)
	end
	task.delay(math.max(0, (nextSwingAt[player] or 0) - os.clock()), attempt)
end

local function onSwingRemote(player)
	if not S.PlayerService.IsReady(player) or player:GetAttribute("ClassChosen") ~= true then
		return
	end
	if not Util.RateLimit(player, "Swing", Config.RateLimits.Swing) then
		return
	end
	S.PlayerService.MarkActive(player)
	lastManualAt[player] = os.clock()
	if pendingManual[player] then
		return -- a manual swing is already queued
	end
	local remaining = (nextSwingAt[player] or 0) - os.clock()
	if remaining <= 0 then
		CombatService.Swing(player, true)
	elseif remaining <= MANUAL_GRACE then
		-- queue a single jitter-early press; holding a button never starts a server attack loop
		queueManualSwing(player)
	end
	-- otherwise an early repeat of a manual swing: silently ignored
end

local function onReleaseRemote(player)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if not Util.RateLimit(player, "Release", Config.RateLimits.Release) then
		return
	end
	lastManualAt[player] = os.clock()
	CombatService.Release(player, false) -- MarkActive inside
end

-- A23-1: ON/OFF only after the unlock; the choice is saved (AutoCombatEnabled)
local function onSetAutoAttackRemote(player, enabled, ...)
	if select("#", ...) ~= 0 or not S.PlayerService.IsReady(player) then
		return
	end
	if type(enabled) ~= "boolean" then
		return
	end
	if not Util.RateLimit(player, "SetAutoAttack", Config.RateLimits.SetAutoAttack) then
		return
	end
	if player:GetAttribute("AutoCombatUnlocked") ~= true or player:GetAttribute("ClassChosen") ~= true
		or not Util.IsAlive(player) then
		return
	end
	S.PlayerService.SetStat(player, "AutoCombatEnabled", enabled)
end

-- the crown-shard quest calls this once; it never turns auto combat ON by itself
function CombatService.UnlockAutoCombat(player)
	if not isPlayer(player) or not S.PlayerService.IsReady(player) then return false end
	S.PlayerService.SetStat(player, "AutoCombatUnlocked", true)
	return true
end

-- one auto step: a swing when its interval is up and a monster is in reach; the skill when MP / cooldown allow
-- and the blast would hit at least one monster (no whiffs, no MP wasted)
local function autoTick(p)
	if not autoReady(p) then return end
	local root = Util.GetRoot(p)
	if not root then return end
	local c = cls(p)
	-- my own presses win: auto waits one class swing interval + ManualYieldPad after a manual attack / skill
	local lm = lastManualAt[p]
	if lm and os.clock() - lm < (c.SwingInterval or 1) + (Config.Combat.ManualYieldPad or 0.3) then return end
	local pos = root.Position
	local range = c.Range or 10
	if os.clock() >= (nextSwingAt[p] or 0) and #aimed(monstersNear(p, pos, range), root, c.AimCone) > 0 then
		CombatService.Swing(p, false)
	end
	local skill = Config.BasicSkill or {}
	if os.clock() - (guard.releaseAt[p] or -math.huge) < (skill.Cooldown or 3) then return end
	if numAttr(p, "Mana", 0) < (skill.ManaCost or Config.Vitals.ReleaseCost) then return end
	local reach = (c.ReleaseCenter == "Target") and range or (skill.Radius or 9)
	local inReach = monstersNear(p, pos, reach)
	if c.ReleaseCenter == "Target" then inReach = aimed(inReach, root, c.AimCone) end
	if #inReach > 0 then
		CombatService.Release(p, true)
	end
end

------------------------------------------------------------------ loops
local function regenTick(p)
	local hum = Util.GetHumanoid(p)
	if not hum or hum.Health <= 0 or hum.Health >= hum.MaxHealth then
		return
	end
	local pct
	-- an Active kaiju never gets the town regen (it would make the event unwinnable in Crossroads)
	if S.ZoneService.IsTown(p) and kstate(p) ~= "Active" then
		pct = Config.Combat.TownRegenPerSec
	else
		pct = perksOf(p).RegenPerSec or 0
	end
	if type(pct) == "number" and pct > 0 then
		CombatService.HealPlayer(p, hum.MaxHealth * pct * Config.Combat.RegenTick)
	end
end

local function startPlayerLoop(loopName, interval, body)
	task.spawn(function()
		while true do
			task.wait(interval)
			local ok, players = pcall(S.PlayerService.GetReadyPlayers)
			if ok and type(players) == "table" then
				for _, p in players do
					if p.Parent then
						local okBody, err = pcall(body, p)
						if not okBody then
							loopWarn(loopName, err)
						end
					end
				end
			elseif not ok then
				loopWarn(loopName, players)
			end
		end
	end)
end

------------------------------------------------------------------ lifecycle
local function connectSignal(serviceName, signalName, fn)
	local service = S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function CombatService.Init(registry)
	S = registry
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
	connectSignal("PlayerService", "CharacterDied", onCharacterDied)
	connectSignal("PlayerService", "CharacterSpawned", onCharacterSpawned)
	connectSignal("FactionService", "FactionChanged", onFactionChanged)
	connectSignal("ClassService", "ClassChanged", onClassChanged)
end

function CombatService.Start()
	Net.Get("Swing").OnServerEvent:Connect(onSwingRemote)
	Net.Get("Release").OnServerEvent:Connect(onReleaseRemote)
	Net.Get("SetAutoAttack").OnServerEvent:Connect(onSetAutoAttackRemote)

	startPlayerLoop("RegenLoop", Config.Combat.RegenTick, regenTick)
	startPlayerLoop("AutoCombatLoop", Config.Combat.AutoTick or 0.2, autoTick)

	print("[CombatService] started")
end

return CombatService
