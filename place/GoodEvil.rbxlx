			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- GooseService.luau : golden goose tug-of-war ("황금 거위 줄다리기"), Regular's Luck rare rewards, cheer stars.
-- Owner: G9. Public surface (TECH_SPEC §4.16): GooseFinished, Init, Start, IsActive, GetPosition, RegisterHit, DebugStart.
-- SPEC_ADDENDUM A1: ServerStorage.CustomModels.GoldenGoose (Model or BasePart) replaces the procedural body visually.
-- SPEC_ADDENDUM A6: only Halo/Horns players add tug counts and receive tug rewards (Neutral/None count 0).
-- Review fixes: a reward needs >= MIN_MANUAL_HITS manual counts (auto-only AFK players still pull, never get paid), and a
-- faction switch mid-event forfeits that player's entry (no pulling for one side and collecting the other's win).
-- CR-L21: GetPosition follows the tug pivot; RegisterHit returns the count actually added (0 = rejected).
-- A23-14 "함께 구조" (co-op, replaces CR-L8's forced tie): if only one of Halo/Horns has ready players when the goose
-- lands, the event is co-op for that side (fixed for the whole event; "Pending" while nobody is eligible, fixed by the
-- first eligible player). Gauge target = Config.Goose.CoopPerPerson x that side's ready players at that moment (min 1).
-- Success pays Config.Goose.CoopWinShare of the winner reward, 0 war points; a gauge not filled takes the tie path.
-- A tug whose rival side left before the end is judged the same way (no 100% win, no war points without a rival).
-- GameState for the HUD: GooseMode ("Versus" | "Coop"), GooseCoopSide ("Halo" | "Horns" | "None"), GooseCoopTarget,
-- GooseCoopPeople. GooseFinished keeps (result, counts) and adds an optional 3rd arg { Mode, Side, Success, Target }.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "GooseService"
local GOOSE_LABEL = "황금 거위" -- billboard text required verbatim by TECH_SPEC §4.16
local CUSTOM_FOLDER = (Config.CustomModels and Config.CustomModels.FolderName) or "CustomModels" -- A1
local CUSTOM_ID = (Config.CustomModels and Config.CustomModels.GooseId) or "GoldenGoose" -- A1
-- review fix (anti-AFK): rewards (and GooseFinished participation) need this many ACCEPTED manual counts this event;
-- auto-attack counts still move the tug but alone never pay.
local MIN_MANUAL_HITS = math.max(1, math.floor(tonumber(Config.Goose.MinManualHits) or 3))
local TXT = Config.Goose.Text or {} -- Korean goose texts (NeedManual + A23-14 co-op)
local MAX_SIDE_OFFSET = 6 -- studs; tug pivot clamp (§4.16)
local VISUAL_BOTTOM = -2.0 -- procedural body bottom relative to the goose center
local VISUAL_HEIGHT = 6.9 -- procedural body height (body bottom -> crown-shard tip)
local BOB_AMPLITUDE = 0.35
local BOB_SPEED = 2.4
local SWAY_ANGLE = math.rad(12)
local SWAY_SPEED = 0.8
local SIDE_LERP = 2.5 -- per second
local WARN_INTERVAL = 10

local COLOR_GOLD = Color3.fromRGB(255, 200, 40)
local COLOR_GOLD_DARK = Color3.fromRGB(225, 160, 25)
local COLOR_BEAK = Color3.fromRGB(255, 135, 30)
local COLOR_EYE = Color3.fromRGB(20, 20, 20)
local COLOR_SHARD = Color3.fromRGB(255, 245, 170)
local COLOR_LIGHT = Color3.fromRGB(255, 215, 110)
local COLOR_LABEL_STROKE = Color3.fromRGB(90, 55, 0)

-- procedural body, offsets relative to the goose center (local -Z = forward / the goose's LookVector)
local PROCEDURAL_PARTS = {
	{ Name = "Body", Class = "Part", Size = Vector3.new(4, 4, 4), At = CFrame.new(0, 0, 0.2), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Chest", Class = "Part", Size = Vector3.new(3, 3, 3), At = CFrame.new(0, 0.5, -1.1), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Tail", Class = "WedgePart", Size = Vector3.new(1.6, 1.2, 1.6), At = CFrame.new(0, 0.9, 2.3) * CFrame.Angles(0, math.pi, 0), Color = COLOR_GOLD_DARK },
	{ Name = "Neck", Class = "Part", Size = Vector3.new(0.9, 2.4, 0.9), At = CFrame.new(0, 2.0, -1.8), Color = COLOR_GOLD, Shiny = true },
	{ Name = "Head", Class = "Part", Size = Vector3.new(1.6, 1.6, 1.6), At = CFrame.new(0, 3.4, -1.9), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Beak", Class = "WedgePart", Size = Vector3.new(0.55, 0.45, 1.0), At = CFrame.new(0, 3.25, -3.0), Color = COLOR_BEAK },
	{ Name = "EyeL", Class = "Part", Size = Vector3.new(0.32, 0.32, 0.32), At = CFrame.new(-0.6, 3.6, -2.45), Color = COLOR_EYE, Ball = true },
	{ Name = "EyeR", Class = "Part", Size = Vector3.new(0.32, 0.32, 0.32), At = CFrame.new(0.6, 3.6, -2.45), Color = COLOR_EYE, Ball = true },
	{ Name = "WingL", Class = "Part", Size = Vector3.new(0.35, 1.6, 2.8), At = CFrame.new(-2.0, 0.35, 0.3) * CFrame.Angles(0, 0, math.rad(25)), Color = COLOR_GOLD_DARK },
	{ Name = "WingR", Class = "Part", Size = Vector3.new(0.35, 1.6, 2.8), At = CFrame.new(2.0, 0.35, 0.3) * CFrame.Angles(0, 0, math.rad(-25)), Color = COLOR_GOLD_DARK },
	{ Name = "CrownShard", Class = "WedgePart", Size = Vector3.new(0.35, 0.9, 0.7), At = CFrame.new(0, 4.45, -1.9) * CFrame.Angles(0, math.rad(90), math.rad(12)), Color = COLOR_SHARD, Neon = true },
}

local GooseService = {}
GooseService.GooseFinished = Util.Signal.new() -- (result: "Halo" | "Horns" | "Tie", counts: { [Player]: number })

local S = nil
local gameState = nil

-- event state
local active = false
local endsAt = 0
local nextAt = 0
local rescue = 0
local poach = 0
local counts = {} -- [Player] = number (faction-scaled tug counts this event)
local manualHits = {} -- [Player] = accepted MANUAL counts this event (reward eligibility)
local sideOf = {} -- [Player] = faction the player's counts were made for ("Halo" | "Horns")
local hitTimes = {} -- [Player] = { os.clock() } accepted counts within the rolling 1 s window
local publishedRescue = -1
local publishedPoach = -1
-- A23-14 event mode: "Idle" between events, "Pending" (active, nobody eligible yet), "Versus" or "Coop"
local mode = "Idle"
local coop = { Side = "None", People = 0, Target = 0, Full = false, Told = {} } -- Told[Player] = RivalWait sent

-- model state
local gooseModel = nil
local gooseRoot = nil
local motionConn = nil
local sideOffset = 0
local sideTarget = 0

local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	if now - (lastWarnAt[key] or -math.huge) >= WARN_INTERVAL then
		lastWarnAt[key] = now
		Util.Warn(TAG, tostring(msg))
	end
end

-- pcall-protected call into another service; returns its FIRST result, or nil (and warns, throttled) on failure
local function call(serviceName, fnName, ...)
	local svc = S and S[serviceName]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		warnThrottled(serviceName .. "." .. fnName, "missing " .. serviceName .. "." .. fnName)
		return nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warnThrottled(serviceName .. "." .. fnName, serviceName .. "." .. fnName .. " failed: " .. tostring(result))
		return nil
	end
	return result
end

local function getGameState()
	if gameState and gameState.Parent then return gameState end
	local ok, gs = pcall(Net.GameState)
	if ok and gs then gameState = gs end
	return gameState
end

local function setGame(key, value)
	local gs = getGameState()
	if gs then gs:SetAttribute(key, value) end
end

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player")
end

local function isReady(p)
	return isPlayer(p) and p.Parent ~= nil and call("PlayerService", "IsReady", p) == true
end

local function factionOf(p)
	local f = call("FactionService", "GetFaction", p)
	if type(f) ~= "string" then return "None" end
	return f
end

local function isTugFaction(f)
	return f == "Halo" or f == "Horns"
end

-- persisted numeric stat: live data table first, mirrored attribute as fallback
local function getNum(p, key)
	local data = call("PlayerService", "GetData", p)
	local v = (type(data) == "table") and data[key] or nil
	if type(v) ~= "number" then v = p:GetAttribute(key) end
	return tonumber(v) or 0
end

local function round1(x)
	return math.floor(x * 10 + 0.5) / 10
end

-- string.format(fmt, ...) of a Config.Goose.Text entry (fmt may be a { Halo, Horns } table keyed by side); nil if
-- the text is missing or the format fails, so a text typo never breaks the event
local function txt(key, side, ...)
	local fmt = TXT[key]
	if type(fmt) == "table" then fmt = fmt[side] end
	if type(fmt) ~= "string" then
		warnThrottled("txt." .. tostring(key), "missing Config.Goose.Text." .. tostring(key))
		return nil
	end
	local ok, s = pcall(string.format, fmt, ...)
	if not ok then
		warnThrottled("txtfmt." .. tostring(key), "bad Config.Goose.Text." .. tostring(key) .. ": " .. tostring(s))
		return nil
	end
	return s
end

-- ready Halo / Horns players (FactionService.GetCounts: ready, still in Players, not leaving; Neutral/None never count)
local function factionCounts()
	local fs = S and S.FactionService
	if fs and type(fs.GetCounts) == "function" then
		local ok, halo, horns = pcall(fs.GetCounts) -- called directly: the call helper only returns the first result
		if ok then
			return math.max(0, math.floor(tonumber(halo) or 0)), math.max(0, math.floor(tonumber(horns) or 0))
		end
		warnThrottled("counts", "FactionService.GetCounts failed: " .. tostring(halo))
	end
	local halo, horns = 0, 0
	local players = call("PlayerService", "GetReadyPlayers")
	if type(players) == "table" then
		for _, p in players do
			if isPlayer(p) and p.Parent then
				local f = factionOf(p)
				if f == "Halo" then
					halo += 1
				elseif f == "Horns" then
					horns += 1
				end
			end
		end
	end
	return halo, horns
end

-- this event's pull total of one side (the co-op gauge)
local function sideTotal(side)
	if side == "Halo" then return rescue end
	if side == "Horns" then return poach end
	return 0
end

local function coopTargetFor(people)
	local per = tonumber(Config.Goose.CoopPerPerson) or 20
	if per ~= per or per <= 0 then per = 20 end
	return math.max(1, math.floor(per * math.max(1, people) + 0.5))
end

local function gooseCenter()
	return Config.Goose.Position + Vector3.new(0, Config.Goose.HoverHeight, 0)
end

-- the goose faces the Crossroads fountain
local function baseRotation()
	local c = gooseCenter()
	local f = Config.Map.FountainPosition
	local look = Vector3.new(f.X, c.Y, f.Z)
	if (look - c).Magnitude < 0.1 then return CFrame.new() end
	local cf = CFrame.lookAt(c, look)
	return cf - cf.Position
end

-- next goose start: aligned to WarService's round end minus OffsetFromWarEnd, advanced by Interval past `now`
local function computeNextAt(now, fallback)
	local base = fallback
	local roundEnd = call("WarService", "GetRoundEndsAt")
	if type(roundEnd) == "number" and roundEnd == roundEnd and roundEnd > now - 86400 then
		base = roundEnd - Config.Goose.OffsetFromWarEnd
	end
	if type(base) ~= "number" or base ~= base or base < now - 86400 then
		base = now + Config.Goose.OffsetFromWarEnd
	end
	local interval = math.max(1, Config.Goose.Interval)
	if base <= now then
		base += (math.floor((now - base) / interval) + 1) * interval
	end
	return base
end

------------------------------------------------------------------ goose model
local function prepVisualPart(p)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
end

local function getCustomTemplate()
	local folder = ServerStorage:FindFirstChild(CUSTOM_FOLDER)
	if not folder then return nil end
	local t = folder:FindFirstChild(CUSTOM_ID)
	if t and (t:IsA("Model") or t:IsA("BasePart")) then return t end
	return nil
end

-- world-space vertical extent of a set of parts (exact for box-shaped parts)
local function worldYRange(parts)
	local minY, maxY = math.huge, -math.huge
	for _, p in parts do
		local cf, s = p.CFrame, p.Size
		local half = math.abs(cf.RightVector.Y) * s.X / 2 + math.abs(cf.UpVector.Y) * s.Y / 2 + math.abs(cf.LookVector.Y) * s.Z / 2
		minY = math.min(minY, cf.Position.Y - half)
		maxY = math.max(maxY, cf.Position.Y + half)
	end
	return minY, maxY
end

local function buildProcedural(model, root, rootCF)
	for _, def in PROCEDURAL_PARTS do
		local p = Util.MakePart({
			ClassName = def.Class,
			Name = def.Name,
			Size = def.Size,
			CFrame = rootCF * def.At,
			Color = def.Color,
			Material = def.Neon and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			Reflectance = def.Shiny and 0.15 or 0,
		})
		if def.Ball and p:IsA("Part") then p.Shape = Enum.PartType.Ball end
		prepVisualPart(p)
		p.Parent = model
		Util.Weld(root, p)
	end
end

-- A1: clone the custom visual, scale it to the procedural height, put its bottom where the procedural body's is,
-- face the root's LookVector and weld every part to the root. Returns true on success.
local function buildCustom(model, root, rootCF, template)
	local clone = template:Clone()
	local rot = rootCF - rootCF.Position
	local targetBottom = rootCF.Position.Y + VISUAL_BOTTOM
	local parts = {}
	if clone:IsA("BasePart") then
		prepVisualPart(clone)
		local h = clone.Size.Y
		if h > 0.01 then clone.Size = clone.Size * (VISUAL_HEIGHT / h) end
		clone.CFrame = CFrame.new(rootCF.Position.X, targetBottom + clone.Size.Y / 2, rootCF.Position.Z) * rot
		table.insert(parts, clone)
	else
		for _, d in clone:GetDescendants() do
			if d:IsA("BasePart") then
				prepVisualPart(d)
				table.insert(parts, d)
			elseif d:IsA("BaseScript") then
				d:Destroy() -- a purely cosmetic visual never runs code
			end
		end
		if #parts == 0 then
			clone:Destroy()
			return false
		end
		clone:PivotTo(CFrame.new(rootCF.Position) * rot)
		local minY, maxY = worldYRange(parts)
		local height = maxY - minY
		if height > 0.01 then
			local okScale = pcall(function()
				clone:ScaleTo(clone:GetScale() * (VISUAL_HEIGHT / height))
			end)
			if not okScale then warnThrottled("customScale", "custom GoldenGoose could not be scaled; using its own size") end
		end
		minY = worldYRange(parts)
		clone:PivotTo(clone:GetPivot() + Vector3.new(0, targetBottom - minY, 0))
	end
	clone.Name = "Visual"
	clone.Parent = model
	for _, p in parts do
		Util.Weld(root, p)
	end
	return true
end

local function destroyModel()
	if motionConn then
		motionConn:Disconnect()
		motionConn = nil
	end
	if gooseModel then
		gooseModel:Destroy()
	end
	gooseModel = nil
	gooseRoot = nil
end

local function startMotion(rot)
	if motionConn then motionConn:Disconnect() end
	local t0 = os.clock()
	motionConn = RunService.Heartbeat:Connect(function(dt)
		local root = gooseRoot
		if not root or not root.Parent then return end
		sideOffset += (sideTarget - sideOffset) * math.min(1, dt * SIDE_LERP)
		local t = os.clock() - t0
		local bob = math.sin(t * BOB_SPEED) * BOB_AMPLITUDE
		local sway = math.sin(t * SWAY_SPEED) * SWAY_ANGLE
		root.CFrame = CFrame.new(gooseCenter() + Vector3.new(sideOffset, bob, 0)) * rot * CFrame.Angles(0, sway, 0)
	end)
end

local function spawnModel()
	destroyModel()
	local effects = Util.GetFolder(workspace, "Effects")
	local old = effects:FindFirstChild("GoldenGoose")
	if old then old:Destroy() end

	local rot = baseRotation()
	local rootCF = CFrame.new(gooseCenter()) * rot

	local model = Instance.new("Model")
	model.Name = "GoldenGoose"

	-- invisible anchored root: one CFrame write moves the whole goose (bob + tug pivot)
	local root = Util.MakePart({
		Name = "Root",
		Size = Vector3.new(3, 3, 3),
		CFrame = rootCF,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	root.Parent = model
	model.PrimaryPart = root

	local template = getCustomTemplate()
	local built = false
	if template then
		local ok, res = pcall(buildCustom, model, root, rootCF, template)
		built = ok and res == true
		if not built then
			warnThrottled("custom", "custom GoldenGoose failed, using the procedural goose: " .. tostring(res))
			local partial = model:FindFirstChild("Visual")
			if partial then partial:Destroy() end
		end
	end
	if not built then
		buildProcedural(model, root, rootCF)
	end

	local light = Instance.new("PointLight")
	light.Color = COLOR_LIGHT
	light.Brightness = 2
	light.Range = 16
	light.Shadows = false
	light.Parent = root

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkles"
	sparkles.Color = ColorSequence.new(COLOR_SHARD)
	sparkles.LightEmission = 1
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(1.5, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	sparkles.Parent = root

	local gui = Instance.new("BillboardGui")
	gui.Name = "GooseLabel"
	gui.Size = UDim2.fromOffset(220, 44)
	gui.StudsOffset = Vector3.new(0, 6.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	gui.Adornee = root
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = COLOR_GOLD
	label.TextStrokeColor3 = COLOR_LABEL_STROKE
	label.TextStrokeTransparency = 0.2
	label.Text = GOOSE_LABEL
	local sizeLimit = Instance.new("UITextSizeConstraint")
	sizeLimit.MinTextSize = 11
	sizeLimit.MaxTextSize = 36
	sizeLimit.Parent = label
	label.Parent = gui
	gui.Parent = root

	model.Parent = effects
	gooseModel = model
	gooseRoot = root
	sideOffset, sideTarget = 0, 0
	startMotion(rot)
end

------------------------------------------------------------------ event flow
local function publishTotals(force)
	local r, p = round1(rescue), round1(poach)
	if force or r ~= publishedRescue then
		publishedRescue = r
		setGame("GooseRescue", r)
	end
	if force or p ~= publishedPoach then
		publishedPoach = p
		setGame("GoosePoach", p)
	end
end

-- GameState mirror of the event mode for EventHUD (anything but a fixed co-op shows as the normal tug)
local function publishMode()
	local isCoop = (mode == "Coop")
	setGame("GooseMode", isCoop and "Coop" or "Versus")
	setGame("GooseCoopSide", isCoop and coop.Side or "None")
	setGame("GooseCoopTarget", isCoop and coop.Target or 0)
	setGame("GooseCoopPeople", isCoop and coop.People or 0)
end

-- A23-14: fix a "Pending" event's mode from who is on the server right now: both tug factions -> Versus, exactly one
-- -> Coop for it (target from its ready headcount now), nobody -> stays Pending. Once fixed it never changes for this
-- event (no mid-event flips). announce = NotifyAll the co-op start line when this call made it co-op.
local function fixMode(announce)
	if mode ~= "Pending" then return end
	local halo, horns = factionCounts()
	if halo > 0 and horns > 0 then
		mode = "Versus"
	elseif halo > 0 or horns > 0 then
		mode = "Coop"
		coop.Side = (halo > 0) and "Halo" or "Horns"
		coop.People = (halo > 0) and halo or horns
		coop.Target = coopTargetFor(coop.People)
		coop.Full = false
	else
		return
	end
	publishMode()
	if mode == "Coop" and announce then
		local msg = txt("CoopStart", coop.Side)
		if msg then pcall(Net.NotifyAll, msg) end
	end
end

local function start()
	if active then return end
	active = true
	endsAt = Util.Now() + Config.Goose.Duration
	rescue, poach = 0, 0
	counts = {}
	manualHits = {}
	sideOf = {}
	hitTimes = {}
	-- A23-14: mode first, so the HUD never shows an active goose with the previous event's mode
	mode = "Pending"
	coop = { Side = "None", People = 0, Target = 0, Full = false, Told = {} }
	fixMode(false)
	publishMode()
	publishTotals(true)
	setGame("GooseEndsAt", endsAt)
	setGame("GooseActive", true)

	local players = call("PlayerService", "GetReadyPlayers")
	if type(players) == "table" then
		for _, p in players do
			if p.Parent then p:SetAttribute("GooseCount", 0) end
		end
	end

	local ok, err = pcall(spawnModel)
	if not ok then
		warnThrottled("spawn", "goose model failed: " .. tostring(err))
	end
	local startMsg = (mode == "Coop") and txt("CoopStart", coop.Side) or nil
	Net.NotifyAll(startMsg or string.format(Config.Story.GooseStart))
end

-- forget a player's entry for this event; what they already pulled stays in the side totals (like a leaver)
local function dropEntry(p)
	counts[p] = nil
	manualHits[p] = nil
	sideOf[p] = nil
	hitTimes[p] = nil
	if isPlayer(p) and p.Parent then
		p:SetAttribute("GooseCount", 0)
	end
end

-- f = the side the player's counts were made for, re-verified against the current faction by finish()
-- share = A23-14 co-op success multiplier (Config.Goose.CoopWinShare) or nil for the normal won/lost split
local function rewardPlayer(p, result, f, share)
	if not isTugFaction(f) then return end -- A6: Neutral (and None) get no tug rewards
	local won = (result == f)

	local rare
	if getNum(p, "CheerStars") >= Config.Goose.CheerStarsForRare then
		rare = true
		call("PlayerService", "AddStat", p, "CheerStars", -Config.Goose.CheerStarsForRare)
	else
		local minutes = tonumber(call("PlayerService", "GetRegularMinutes", p)) or 0
		rare = Util.Random:NextNumber() < Config.RareChance(minutes)
	end

	local level = math.max(1, math.floor(getNum(p, "Level")))
	local gold, xp = Config.GooseReward(level, f, won, rare, share)
	if gold > 0 then call("ProgressionService", "AddBankGold", p, gold, "Event") end
	if xp > 0 then call("ProgressionService", "AddXP", p, xp) end
	local msg = (share ~= nil) and txt("CoopReward", f, Util.FormatNumber(gold), Util.FormatNumber(xp)) or nil
	Net.Notify(p, msg or string.format(Config.Text.GooseReward, Util.FormatNumber(gold), Util.FormatNumber(xp)), "reward")

	if rare then
		Net.Fx(p, "Rare", { Gold = gold, XP = xp })
		Net.NotifyAll(string.format(Config.Text.RareAnnounce, Util.PlayerDisplayName(p)), "info")
	end

	if not won then -- loss or tie: +1 cheer star
		local cheer = getNum(p, "CheerStars")
		if cheer < Config.Goose.CheerStarsForRare then
			local newCount = call("PlayerService", "AddStat", p, "CheerStars", 1)
			cheer = tonumber(newCount) or (cheer + 1)
		end
		Net.Notify(p, string.format(Config.Text.GooseCheer, math.floor(cheer)), "info")
	end
end

local function finish()
	if not active then return end
	active = false
	-- schedule the next goose FIRST so a failure below can never re-trigger an event every tick
	endsAt = 0
	nextAt = computeNextAt(Util.Now(), nextAt)
	setGame("GooseNextAt", nextAt)

	-- A23-14 judgment. judged = "Versus" | "Coop" | "Pending" (nobody eligible ever pulled -> plain tie)
	local judged, side, target, rivalLeft = mode, coop.Side, coop.Target, false
	local result = "Tie"
	if judged == "Versus" then
		result = (rescue > poach) and "Halo" or ((poach > rescue) and "Horns" or "Tie")
		-- CR-L8 kept in spirit: a tug side with nobody left at the end gives no 100% win and no war points. The side
		-- still here is judged like co-op against its current headcount instead of a forced tie.
		local halo, horns = factionCounts()
		if halo <= 0 or horns <= 0 then
			rivalLeft = true
			judged = "Coop"
			side = (halo > 0) and "Halo" or ((horns > 0) and "Horns" or "None")
			target = coopTargetFor((side == "Halo") and halo or horns)
		end
	end
	local success = false
	if judged == "Coop" then
		success = isTugFaction(side) and sideTotal(side) >= target
		result = success and side or "Tie"
	end
	local share = (judged == "Coop" and success) and (tonumber(Config.Goose.CoopWinShare) or 0.7) or nil
	local fxPos = (gooseRoot and gooseRoot.Parent) and gooseRoot.Position or gooseCenter()
	local finalCounts, finalManual, finalSide = counts, manualHits, sideOf
	counts = {}
	manualHits = {}
	sideOf = {}
	hitTimes = {}
	mode = "Idle"
	coop = { Side = "None", People = 0, Target = 0, Full = false, Told = {} }

	-- paid participants: counts > 0, still on the side they pulled for, and enough MANUAL hits (auto-only = AFK)
	local rewarded = {}
	for p, n in finalCounts do
		if type(n) == "number" and n > 0 and isReady(p) then
			local f = factionOf(p)
			-- co-op pays only the co-op side (a rival never pulls in co-op; this also covers odd leftovers)
			if isTugFaction(f) and finalSide[p] == f and (judged ~= "Coop" or f == side) then
				if (finalManual[p] or 0) >= MIN_MANUAL_HITS then
					rewarded[p] = n
					local ok, err = pcall(rewardPlayer, p, result, f, share)
					if not ok then warnThrottled("reward", "goose reward failed for " .. p.Name .. ": " .. tostring(err)) end
				else
					local msg = txt("NeedManual", nil, MIN_MANUAL_HITS)
					if msg then pcall(Net.Notify, p, msg, "info") end
				end
			end
		end
	end

	if judged == "Versus" and result ~= "Tie" then -- A23-14: co-op never gives war points
		call("WarService", "AddFactionPoints", result, Config.Goose.WinWarPoints)
	end
	local okSend, sendErr = pcall(function()
		local msg = nil
		if judged == "Coop" and isTugFaction(side) then
			msg = success and txt("CoopResult", side) or txt("CoopFail")
			if msg and rivalLeft then msg = txt("RivalLeft", nil, msg) or msg end
		end
		Net.NotifyAll(msg or string.format(Config.Story.GooseResult[result]))
		Net.Fx(nil, "GooseEnd", { Pos = fxPos, Winner = result, Coop = (judged == "Coop") })
	end)
	if not okSend then warnThrottled("send", "goose result broadcast failed: " .. tostring(sendErr)) end

	destroyModel()
	for p in finalCounts do
		if isPlayer(p) and p.Parent then p:SetAttribute("GooseCount", 0) end
	end
	publishTotals(true)
	setGame("GooseActive", false)
	setGame("GooseEndsAt", 0)
	publishMode() -- back to Versus / None / 0 between events

	-- same shape as the spec's counts ({ [Player]: number }), limited to the players who were actually paid,
	-- so quest progress never goes to AFK auto-swingers or side-switchers. Co-op participants are in it on success
	-- and on failure (like tug losers), so a co-op goose counts for StoryQuestService/QuestService. The optional 3rd
	-- arg tells listeners how the event was judged (Mode "Versus" | "Coop" | "Pending" = nobody eligible).
	local info = { Mode = judged }
	if judged == "Coop" then
		info.Side = side
		info.Success = success
		info.Target = target
		info.RivalLeft = rivalLeft
	end
	GooseService.GooseFinished:Fire(result, rewarded, info)
end

local function tick()
	local now = Util.Now()
	if not active then
		if now >= nextAt then start() end
		return
	end
	if now >= endsAt then
		finish()
		return
	end
	if mode == "Pending" then fixMode(true) end -- e.g. the only player just picked a faction
	if mode == "Coop" then
		-- co-op: the goose slides toward the co-op side as the gauge fills (Halo = -X like a rescue lead)
		local fill = math.clamp(sideTotal(coop.Side) / math.max(1, coop.Target), 0, 1)
		sideTarget = ((coop.Side == "Halo") and -1 or 1) * fill * MAX_SIDE_OFFSET
		if not coop.Full and fill >= 1 then
			coop.Full = true -- totals never go down, so a full gauge stays a success until the timer ends
			local msg = txt("CoopFull", coop.Side, MIN_MANUAL_HITS)
			if msg then pcall(Net.NotifyAll, msg, "good") end
		end
	else
		local total = rescue + poach
		sideTarget = math.clamp((poach - rescue) / math.max(1, total) * MAX_SIDE_OFFSET, -MAX_SIDE_OFFSET, MAX_SIDE_OFFSET)
	end
	publishTotals(false)
end

------------------------------------------------------------------ public API
function GooseService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player)
		if isPlayer(player) and player.Parent then
			player:SetAttribute("GooseCount", 0)
		end
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		-- the leaver's contribution stays in the side totals (and in a co-op gauge)
		counts[player] = nil
		manualHits[player] = nil
		sideOf[player] = nil
		hitTimes[player] = nil
		coop.Told[player] = nil
	end)
	-- review fix: switching sides mid-event (altar is next to the perch) forfeits this event's entry, so nobody can pull
	-- for one side and then collect the winner share of the other. Pulling again after the switch starts a new entry.
	local fs = S.FactionService
	if fs and fs.FactionChanged then
		fs.FactionChanged:Connect(function(player)
			if counts[player] ~= nil or hitTimes[player] ~= nil then
				dropEntry(player)
			end
		end)
	else
		warnThrottled("factionChanged", "FactionService.FactionChanged missing; side switches are caught at finish only")
	end
end

function GooseService.Start()
	getGameState()
	nextAt = computeNextAt(Util.Now(), nil)
	setGame("GooseNextAt", nextAt)
	setGame("GooseActive", false)
	setGame("GooseEndsAt", 0)
	publishMode()
	publishTotals(true)

	task.spawn(function()
		while true do
			task.wait(Config.Goose.Tick)
			local ok, err = pcall(tick)
			if not ok then warnThrottled("loop", "tick error: " .. tostring(err)) end
		end
	end)

	print("[GooseService] custom model for " .. CUSTOM_ID .. ": " .. (getCustomTemplate() and "yes" or "no"))
	print("[GooseService] started")
end

function GooseService.IsActive()
	return active
end

-- CR-L21: includes the tug pivot (sideOffset, +-MAX_SIDE_OFFSET) so swing range checks match the goose players see
function GooseService.GetPosition()
	if not active then return nil end
	return gooseCenter() + Vector3.new(sideOffset, 0, 0)
end

-- returns the tug count actually added (0 = rejected), so CombatService can show the real "+N" (CR-L21)
function GooseService.RegisterHit(player, isManual)
	if not active then return 0 end
	if not isReady(player) then return 0 end
	local f = factionOf(player)
	if not isTugFaction(f) then return 0 end -- A6: Neutral swings on the goose count 0
	if mode == "Pending" then fixMode(true) end -- first eligible hit before the next tick fixed the mode
	if mode == "Coop" and f ~= coop.Side then
		-- A23-14: the rival side arrived after this goose became co-op -> no pull this time, told once per event
		if not coop.Told[player] then
			coop.Told[player] = true
			local msg = txt("RivalWait", coop.Side)
			if msg then pcall(Net.Notify, player, msg, "info") end
		end
		return 0
	end
	if sideOf[player] ~= nil and sideOf[player] ~= f then
		dropEntry(player) -- defensive: faction changed without a FactionChanged signal -> fresh entry for the new side
	end

	-- rolling 1 s window: at most MaxCountsPerSecond accepted counts per player
	local now = os.clock()
	local list = hitTimes[player]
	if not list then
		list = {}
		hitTimes[player] = list
	end
	while list[1] and now - list[1] >= 1 do
		table.remove(list, 1)
	end
	if #list >= Config.Goose.MaxCountsPerSecond then return 0 end
	table.insert(list, now)

	local scale = tonumber(call("JusticeService", "GetFactionScale", f)) or 1
	if scale ~= scale or scale <= 0 then scale = 1 end
	local amount = ((isManual == true) and Config.Goose.ManualCount or Config.Goose.AutoCount) * scale
	counts[player] = (counts[player] or 0) + amount
	sideOf[player] = f
	if isManual == true then
		manualHits[player] = (manualHits[player] or 0) + 1
	end
	if f == "Halo" then
		rescue += amount
	else
		poach += amount
	end
	player:SetAttribute("GooseCount", math.floor(counts[player]))
	return amount
end

function GooseService.DebugStart()
	if active then return end
	local ok, err = pcall(start)
	if not ok then warnThrottled("debug", "DebugStart failed: " .. tostring(err)) end
end

return GooseService
]]></ProtectedString>
				<string name="ScriptGuid">{3568B5C0-8F7C-4086-B7C2-6AEE35A641C2}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GooseService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f68800000909</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX10F0D581A21F496DAC08CB46F076611D">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- JusticeService.luau : Size Justice ("덩치 저울"): faction power sums, per-faction S, bully stacks + decay,
-- and the smooth character scale lerp. The ONLY service that scales characters (always via Util.SafeScaleTo).
-- Addendum A6: "Neutral" players are excluded from power sums / ratios and their S is always 1.0.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "JusticeService"
local DECAY_TICK = 1 -- bully decay loop interval (spec §4.12)
local SCALE_EPSILON = 0.005 -- lerp stops when this close to the target
local S_EPSILON = 0.001 -- a faction S change smaller than this does not refresh characters
local MIN_SCALE = 0.1 -- safety floor for Model:ScaleTo
local SCALE_RETRY_SECONDS = 2 -- after a failed ScaleTo, wait this long before trying that character again
local LEAVE_FORGET_SECONDS = 60
local WARN_THROTTLE = 10
local PIVOT_HEIGHT_AT_SCALE_1 = 3 -- approx. root-center height above the feet for R6 and R15 at scale 1
-- CR-M20: who adds power to the faction sums (everyone still gets their side's S)
local COUNT_RULE = {
	IdleSeconds = 120, -- no input / combat for this long (PlayerService.GetLastActive) = not counted
	TownSeconds = 60, -- standing in a town for this long = not counted
}

local JusticeService = {}

local S = nil
local scaleOf = { Halo = 1, Horns = 1 } -- current S per combat faction
local weakerFaction = "None"
local leaving = {} -- [Player] = true while leaving (excluded from sums)
local lastAppliedS = {} -- [Player] = S last pushed to SizeMult / RefreshCharacter
local lastFaction = {} -- [Player] = faction at the last recompute pass
local targets = {} -- [Player] = last computed visual scale target
local bully = {} -- [Player] = { Stacks: number, Last: number (os.clock) }
local townSince = {} -- [Player] = os.clock() when the player entered a town (nil outside towns), CR-M20
local hipBase = setmetatable({}, { __mode = "k" }) -- [Character] = R15 HipHeight at scale 1
local scaleFailUntil = setmetatable({}, { __mode = "k" }) -- [Character] = os.clock()
local recomputePending = false
local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function round2(x)
	return math.floor(x * 100 + 0.5) / 100
end

local function factionOf(player)
	if S and S.FactionService and S.FactionService.GetFaction then
		return S.FactionService.GetFaction(player)
	end
	local f = player and player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function kaijuState(player)
	local k = S and S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

-- only Halo / Horns can be bullies (A6: Neutral never gets bully stacks; "None" has not picked a side)
local function isFighterFaction(factionId)
	return factionId == "Halo" or factionId == "Horns"
end

local function computeTarget(player)
	local s = JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
	if kaijuState(player) == "Active" then
		s *= Config.Kaiju.VisualScale
	end
	return math.max(MIN_SCALE, math.min(Config.Justice.MaxVisualScale, s))
end

local function writeVisualScale(player, scale)
	local v = round2(scale)
	if player:GetAttribute("VisualScale") ~= v then
		player:SetAttribute("VisualScale", v)
	end
end

-- R15 hover height does not follow the body when scaled at runtime; keep it proportional (no-op if ScaleTo did it).
local function fixHipHeight(character, scale)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local base = hipBase[character]
	if not base or base <= 0 then return end
	local want = base * scale
	if math.abs(hum.HipHeight - want) > 0.01 then
		hum.HipHeight = want
	end
end

local function rememberHipBase(character)
	if hipBase[character] then return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local cur = character:GetScale()
	if cur > 0 then
		hipBase[character] = hum.HipHeight / cur
	end
end

-- applies `scale` to the character; returns true on success
local function applyScale(character, scale)
	local blockedUntil = scaleFailUntil[character]
	if blockedUntil and os.clock() < blockedUntil then return false end
	if Util.SafeScaleTo(character, scale) then
		fixHipHeight(character, scale)
		return true
	end
	scaleFailUntil[character] = os.clock() + SCALE_RETRY_SECONDS
	return false
end

local function requestRecompute()
	if recomputePending then return end
	recomputePending = true
	task.defer(function()
		recomputePending = false
		local ok, err = pcall(JusticeService.Recompute)
		if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
	end)
end

local function clearPlayer(player)
	lastAppliedS[player] = nil
	lastFaction[player] = nil
	targets[player] = nil
	bully[player] = nil
	townSince[player] = nil
end

-- CR-M20: keep townSince in step with the zone (also covers spawning in Crossroads, which fires no ZoneChanged)
local function syncTown(player, now)
	local zs = S and S.ZoneService
	if not zs or not zs.IsTown then return end
	local ok, inTown = pcall(zs.IsTown, player)
	if not ok then return end
	if inTown == true then
		townSince[player] = townSince[player] or now
	else
		townSince[player] = nil
	end
end

-- CR-M20: rookies, 120 s idlers and 60 s town loiterers add no power to the faction sums
local function countsForSums(player, now)
	syncTown(player, now)
	local pvp = S.PvPService
	if pvp and pvp.IsRookie then
		local ok, rookie = pcall(pvp.IsRookie, player)
		if ok and rookie == true then return false end
	end
	local ps = S.PlayerService
	if ps.GetLastActive then
		local ok, t = pcall(ps.GetLastActive, player)
		if ok and type(t) == "number" and now - t > COUNT_RULE.IdleSeconds then return false end
	end
	local since = townSince[player]
	return not (since and now - since >= COUNT_RULE.TownSeconds)
end

-- level, equipped weapon tier and its scroll +N (review B5: the server-written WeaponEnhance attribute;
-- Config.EnhanceMult clamps it to 0..Config.Loot.MaxEnhance and treats a missing value as +0)
local function levelAndTier(player)
	local level = math.max(1, tonumber(player:GetAttribute("Level")) or 1)
	local tier = math.clamp(math.floor(tonumber(player:GetAttribute("WeaponTier")) or 1), 1, Config.MaxWeaponTier)
	local enhance = tonumber(player:GetAttribute("WeaponEnhance")) or 0
	return level, tier, enhance
end

------------------------------------------------------------------ public API
-- faction-sum power (includes the rebirth bonus)
function JusticeService.GetPower(player)
	if not player then return 0 end
	local level, tier, enhance = levelAndTier(player)
	local rebirthBonus = tonumber(player:GetAttribute("RebirthBonus")) or 0
	return Config.PowerOf(level, tier, 1 + rebirthBonus, enhance)
end

-- CR-L5: combat power for the weak-victim (bully) rule; the rebirth bonus is gold / XP only, so it is left out
function JusticeService.GetCombatPower(player)
	if not player then return 0 end
	local level, tier, enhance = levelAndTier(player)
	return Config.PowerOf(level, tier, 1, enhance)
end

-- 1 for "None" and "Neutral" (A6)
function JusticeService.GetFactionScale(factionId)
	if factionId == "Halo" or factionId == "Horns" then
		return scaleOf[factionId] or 1
	end
	return 1
end

function JusticeService.GetWeakerFaction()
	return weakerFaction
end

function JusticeService.GetDamageMult(player)
	return JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
end

function JusticeService.GetHealthMult(player)
	local mult = JusticeService.GetFactionScale(factionOf(player))
	local k = S and S.KaijuService
	if k and k.GetHealthMult then
		local ok, km = pcall(k.GetHealthMult, player)
		if ok and type(km) == "number" and km > 0 then
			mult *= km
		end
	end
	return mult
end

function JusticeService.GetBullyStacks(player)
	local b = player and bully[player]
	return b and b.Stacks or 0
end

function JusticeService.AddBullyStack(player)
	if not player then return 0 end
	if not isFighterFaction(factionOf(player)) then return 0 end -- A6: Neutral / None never become bullies
	local b = bully[player]
	if not b then
		b = { Stacks = 0, Last = os.clock() }
		bully[player] = b
	end
	b.Stacks = math.min(Config.Bully.MaxStacks, b.Stacks + 1)
	b.Last = os.clock()
	player:SetAttribute("BullyStacks", b.Stacks)
	JusticeService.RefreshScale(player)
	return b.Stacks
end

-- recompute this player's visual scale target now (the scale loop moves the character toward it)
function JusticeService.RefreshScale(player)
	if not player then return end
	targets[player] = computeTarget(player)
end

function JusticeService.Recompute()
	if not S then return end
	local now = os.clock()
	local haloSum, hornsSum, haloCount, hornsCount = 0, 0, 0, 0
	local entries = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = factionOf(p)
			-- CR-M20: excluded players still get an entry below (and so their side's S)
			if (f == "Halo" or f == "Horns") and countsForSums(p, now) then
				local ok, power = pcall(JusticeService.GetPower, p)
				power = (ok and type(power) == "number") and power or 0
				if f == "Halo" then
					haloSum += power
					haloCount += 1
				else
					hornsSum += power
					hornsCount += 1
				end
			end
			table.insert(entries, { Player = p, Faction = f })
		end
	end

	local sHalo, sHorns = 1, 1
	if haloCount >= 1 and hornsCount >= 1 then
		sHalo = Config.SizeJustice(haloSum, hornsSum)
		sHorns = Config.SizeJustice(hornsSum, haloSum)
	end
	scaleOf.Halo, scaleOf.Horns = sHalo, sHorns

	-- an empty faction counts as 0; "None" if both sums are 0 or equal
	if (haloSum == 0 and hornsSum == 0) or haloSum == hornsSum then
		weakerFaction = "None"
	elseif haloSum < hornsSum then
		weakerFaction = "Halo"
	else
		weakerFaction = "Horns"
	end

	local gs = Net.GameState()
	gs:SetAttribute("HaloPower", math.floor(haloSum + 0.5))
	gs:SetAttribute("HornsPower", math.floor(hornsSum + 0.5))
	gs:SetAttribute("HaloSize", round2(sHalo))
	gs:SetAttribute("HornsSize", round2(sHorns))
	gs:SetAttribute("WeakerFaction", weakerFaction)

	for _, e in entries do
		local p, f = e.Player, e.Faction
		local s = JusticeService.GetFactionScale(f)
		local prev = lastAppliedS[p]
		if lastFaction[p] ~= f or prev == nil or math.abs(prev - s) > S_EPSILON then
			lastAppliedS[p] = s
			lastFaction[p] = f
			local ok, err = pcall(function()
				p:SetAttribute("SizeMult", round2(s))
				S.PlayerService.RefreshCharacter(p, false) -- HP % preserved
				JusticeService.RefreshScale(p)
			end)
			if not ok then warnThrottled("apply", "apply S failed: " .. tostring(err)) end
		end
	end
end

------------------------------------------------------------------ subscriptions
-- CR-M12: bring back the stacks saved at the last leave, minus the decay that would have happened meanwhile
local function restoreBully(player, data)
	if type(data) ~= "table" then return end
	local saved = math.floor(tonumber(data.SavedBully) or 0)
	local at = tonumber(data.SavedBullyAt) or 0
	-- one-shot: a crash before the next leave must not bring them back a second time
	data.SavedBully, data.SavedBullyAt = 0, 0
	if saved <= 0 or at <= 0 then return end
	if not isFighterFaction(data.Faction) then return end -- A6: only Halo / Horns carry stacks
	local period = math.max(1, tonumber(Config.Bully.DecaySeconds) or 300)
	local elapsed = math.max(0, os.time() - at)
	local decayed = math.floor(elapsed / period)
	local stacks = math.min(Config.Bully.MaxStacks, saved - decayed)
	if stacks <= 0 then return end
	-- keep the running decay period: the next stack drops `period` after the last drop, not after the join
	bully[player] = { Stacks = stacks, Last = os.clock() - (elapsed - decayed * period) }
	player:SetAttribute("BullyStacks", stacks)
	JusticeService.RefreshScale(player)
end

local function onPlayerReady(player, data)
	leaving[player] = nil
	clearPlayer(player)
	player:SetAttribute("SizeMult", 1)
	player:SetAttribute("BullyStacks", 0)
	player:SetAttribute("VisualScale", 1)
	local ok, err = pcall(restoreBully, player, data)
	if not ok then warnThrottled("bullyrestore", "bully restore failed: " .. tostring(err)) end
	requestRecompute()
end

local function onPlayerLeaving(player, data)
	leaving[player] = true
	-- CR-M12: save the stacks; SavedBullyAt = os.time() of the start of the running decay period
	if type(data) == "table" then
		local b = bully[player]
		local stacks = JusticeService.GetBullyStacks(player)
		local into = (stacks > 0 and b) and math.floor(math.max(0, os.clock() - b.Last)) or 0
		data.SavedBully = stacks
		data.SavedBullyAt = os.time() - into
	end
	requestRecompute()
	-- CR-L1: later PlayerLeaving handlers (PvP bounty CR-M11) still read the stacks; clear after them
	task.defer(clearPlayer, player)
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

-- CR-M20: town entry time (the 60 s town rule); leaving a town or crossing the 60 s mark re-weighs the sums
local function onZoneChanged(player, newZoneId)
	if not player or leaving[player] then return end
	local zone = Config.Zones[newZoneId]
	if zone and zone.Town == true then
		if townSince[player] then return end -- town to town keeps the clock
		local t = os.clock()
		townSince[player] = t
		task.delay(COUNT_RULE.TownSeconds + 0.5, function()
			if townSince[player] == t then requestRecompute() end
		end)
	else
		local was = townSince[player]
		townSince[player] = nil
		if was and os.clock() - was >= COUNT_RULE.TownSeconds then requestRecompute() end
	end
end

-- fresh characters start at scale 1: snap straight to the target (no lerp)
local function onCharacterSpawned(player, character)
	if not player or not character or not character.Parent then return end
	if player.Character ~= character then return end
	rememberHipBase(character)
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	if math.abs(target - cur) > SCALE_EPSILON and applyScale(character, target) then
		if target > cur then
			-- CR-H2: a server-side move; the spawn grace (not the shorter default) so ZoneService's own one is not cut
			local zs = S and S.ZoneService
			if zs and zs.MarkTeleported then
				local ac = Config.AntiCheat
				pcall(zs.MarkTeleported, player, (ac and tonumber(ac.SpawnGrace)) or 2)
			end
			-- ScaleTo keeps the pivot (root) in place, so the longer legs would start inside the floor: lift by the growth
			pcall(function()
				character:PivotTo(character:GetPivot() + Vector3.new(0, (target - cur) * PIVOT_HEIGHT_AT_SCALE_1, 0))
			end)
		end
		cur = target
	end
	writeVisualScale(player, cur)
end

------------------------------------------------------------------ loops
local function scaleStep(player, step)
	if not Util.IsAlive(player) then return end
	local character = Util.GetCharacter(player)
	if not character then return end
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	local diff = target - cur
	if math.abs(diff) <= SCALE_EPSILON then
		writeVisualScale(player, cur)
		return
	end
	rememberHipBase(character)
	local new = cur + math.clamp(diff, -step, step)
	if applyScale(character, new) then
		writeVisualScale(player, new)
	end
end

local function decayStep(player, b)
	if b.Stacks <= 0 then return end
	if os.clock() - b.Last < Config.Bully.DecaySeconds then return end
	b.Stacks -= 1
	b.Last = os.clock()
	if player.Parent ~= Players then return end
	player:SetAttribute("BullyStacks", b.Stacks)
	Net.Notify(player, string.format(Config.Text.BullyDecay, b.Stacks), "info")
	JusticeService.RefreshScale(player)
end

function JusticeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player, newFaction)
			-- A6: a bully who switches to Neutral (altar / rebirth) sheds the stacks at once
			-- (no shrink, no -15% damage, no "깡패" tag); Halo <-> Horns keeps them.
			-- CR-L9: the altar and rebirth refuse Neutral while stacks remain, so this is only a safety net
			if player and not isFighterFaction(newFaction) then
				local had = bully[player] ~= nil or (tonumber(player:GetAttribute("BullyStacks")) or 0) > 0
				bully[player] = nil
				if had then
					local ok, err = pcall(function()
						player:SetAttribute("BullyStacks", 0)
						JusticeService.RefreshScale(player)
					end)
					if not ok then warnThrottled("bullyclear", "bully clear failed: " .. tostring(err)) end
				end
			end
			requestRecompute()
		end)
	end
	if S.ClassService and S.ClassService.ClassChanged then
		S.ClassService.ClassChanged:Connect(function()
			requestRecompute()
		end)
	end
	if S.ProgressionService and S.ProgressionService.Rebirthed then
		S.ProgressionService.Rebirthed:Connect(function()
			requestRecompute()
		end)
	end
	if S.ZoneService and S.ZoneService.ZoneChanged then
		S.ZoneService.ZoneChanged:Connect(onZoneChanged) -- CR-M20
	end
	-- players removed before they were ever ready never fire PlayerLeaving
	-- CR-L1: a ready player is cleared by onPlayerLeaving (deferred, after the other leave handlers)
	Players.PlayerRemoving:Connect(function(player)
		if not S.PlayerService.IsReady(player) then
			clearPlayer(player)
		end
	end)
end

function JusticeService.Start()
	-- periodic recompute
	task.spawn(function()
		while true do
			task.wait(Config.Justice.RecalcInterval)
			local ok, err = pcall(JusticeService.Recompute)
			if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
		end
	end)

	-- smooth scale lerp
	task.spawn(function()
		local interval = Config.Justice.ScaleTick
		local step = Config.Justice.ScaleRatePerSec * interval -- max scale change per tick
		while true do
			task.wait(interval)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(scaleStep, p, step)
				if not ok then warnThrottled("scale", "scale step failed: " .. tostring(err)) end
			end
		end
	end)

	-- bully stack decay
	task.spawn(function()
		while true do
			task.wait(DECAY_TICK)
			for p, b in bully do
				local ok, err = pcall(decayStep, p, b)
				if not ok then warnThrottled("decay", "bully decay failed: " .. tostring(err)) end
			end
		end
	end)

	requestRecompute()
	print("[JusticeService] started")
end

return JusticeService
]]></ProtectedString>
				<string name="ScriptGuid">{7F76B957-562C-4958-9F12-797FDC5CB527}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">JusticeService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f6880000090b</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX87E2B819D1FA4080B0857622D9026BDF">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- KaijuService.luau : wanted kaiju ("수배범 괴수화") — FIFO queue, server siren, kaiju HP/scale, stomp,
-- participants, reward pool, survive reward.
-- Owner: G9. Public surface (TECH_SPEC §4.15): KaijuStarted, KaijuEnded, Init, Start, GetState, GetActive,
-- GetHealthMult, HandleKaijuDeath.
-- SPEC_ADDENDUM A6: only Horns players can become a kaiju; only Halo players are stomped, count as participants
-- or get rewards (Neutral / None never take part).
-- Review fixes (anti-collusion, minted gold only; carried gold is a transfer and always moves as specced):
--  * Survived: the +50% bonus needs real opposition (a Halo participant, a stomped Halo player or a Halo player within
--    NearbyRadius at an HP recalc) and is capped at SURVIVE_BONUS_MINUTES of hunting value at the kaiju's level.
--  * Defeated without a Halo player's lethal hit (reset / fall / monster): the minted 3x bounty is scaled by the share of
--    the kaiju's MaxHealth that Halo players actually took off. A real kill pays the full pool.
--  * Each participant gets the minted part of a pool share at most once per Config.Kaiju.PairRewardCooldown per kaiju
--    player, stored in the participant's saved data (PlayerService.PairReady kind "kaiju", CR-M3/CR-M4). The kaiju's
--    carried gold moved into the pool is capped at Config.PvP.PlunderCapPerLevel x its level (the rest is destroyed).
--  * CR-M11: an Active kaiju that leaves after Halo players hurt it is settled as Defeated (minted part scaled by the
--    Halo damage share); otherwise it is Cancelled. Its pouch is escrowed by a PlayerLeaving handler that runs first
--    (ahead of ProgressionService's leave banking), so the carried gold reaches the pool like a KO; public
--    WillSettleOnLeave tells other services such a leave is coming. CR-M13: stomps outside PvP zones carry no attacker.
-- A11-R1: the stomp's ground raycast includes only Terrain, workspace.Map.Ground and Map.Decor "Bridge_*" models.
-- A12: a transformed kaiju may zoom out to KAIJU_CAMERA_ZOOM; the previous limit is restored when the event ends.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "KaijuService"
local WARN_INTERVAL = 10
local GROUND_RAY_LENGTH = 120
local KAIJU_CAMERA_ZOOM = 60 -- A12: "kaiju may use 60 while transformed, then restore"
-- candidates for Config.Kaiju (G1): survive bonus cap in minutes of Config.HuntValue at the kaiju's level
local SURVIVE_BONUS_MINUTES = 20
local TXT_SURVIVE_CAPPED = "살아남았다! 주머니 골드 + 보너스(최대치) = %s골드가 금고로!"
local TXT_SURVIVE_UNCONTESTED = "살아남았다! 아무도 막지 않아 보너스 없이 %s골드만 금고로."

local KaijuService = {}
KaijuService.KaijuStarted = Util.Signal.new() -- (player)
KaijuService.KaijuEnded = Util.Signal.new() -- (player, outcome: "Defeated" | "Survived" | "Cancelled", participants: { Player })

local S = nil
local gameState = nil

local states = {} -- [Player] = "Queued" | "Siren" | "Active" (absent = "None")
local queue = {} -- FIFO of Players in state "Queued"
local current = nil -- the Siren/Active player
local phase = "None" -- "None" | "Siren" | "Active"
local phaseEndsAt = 0 -- server time: end of the siren (Siren) or of the kaiju (Active)
local kaijuName = ""
local healthMult = 1 -- cached Active health multiplier
local dmg = {} -- [Player] = damage dealt to the Active kaiju (Halo attackers)
local healers = {} -- [Player] = true: Halo players whose release healed a damager
local lastRecalc = 0 -- os.clock()
local lastStomp = 0 -- os.clock()
local contested = false -- a Halo player was near / stomped by / fighting the Active kaiju
local lethalHit = false -- a Halo player's hit dropped the Active kaiju to 0 HP (false = reset, fall, monster, ...)
local lastMaxHealth = 0 -- the Active kaiju's MaxHealth, sampled every tick
local poolPaidAt = {} -- fallback only (PairReady missing): ["participantUserId:kaijuUserId"] = os.clock() of the last minted share
local zoomRestore = {} -- [Player] = CameraMaxZoomDistance before the kaiju zoom was raised
local leaveEscrow = {} -- CR-M11: [Player] = { Gold, CombatLog } pouch of a leaving kaiju whose leave settles as Defeated

local lastWarnAt = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include -- A11-R1

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	if now - (lastWarnAt[key] or -math.huge) >= WARN_INTERVAL then
		lastWarnAt[key] = now
		Util.Warn(TAG, tostring(msg))
	end
end

-- pcall-protected call into another service; returns its FIRST result, or nil (and warns, throttled) on failure
local function call(serviceName, fnName, ...)
	local svc = S and S[serviceName]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		warnThrottled(serviceName .. "." .. fnName, "missing " .. serviceName .. "." .. fnName)
		return nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warnThrottled(serviceName .. "." .. fnName, serviceName .. "." .. fnName .. " failed: " .. tostring(result))
		return nil
	end
	return result
end

-- CR-M11: Util.Signal fires handlers in connection order and KaijuService is late in INIT_ORDER, so this moves the new
-- handler to the front; if the Signal layout ever changes it stays a normal (late) connection and warns
local function connectFirst(signal, fn)
	local conn = signal:Connect(fn)
	local handlers = (type(signal) == "table") and rawget(signal, "_handlers") or nil
	local last = (type(handlers) == "table") and handlers[#handlers] or nil
	if type(handlers) == "table" and type(last) == "table" and last.fn == fn then
		table.remove(handlers, #handlers)
		table.insert(handlers, 1, last)
	else
		warnThrottled("connectFirst", "Signal layout changed; the kaiju leave escrow runs after earlier handlers")
	end
	return conn
end

local function getGameState()
	if gameState and gameState.Parent then return gameState end
	local ok, gs = pcall(Net.GameState)
	if ok and gs then gameState = gs end
	return gameState
end

local function publish(phaseName, userId, name, endsAt)
	local gs = getGameState()
	if not gs then return end
	gs:SetAttribute("KaijuUserId", userId)
	gs:SetAttribute("KaijuName", name)
	gs:SetAttribute("KaijuEndsAt", endsAt)
	gs:SetAttribute("KaijuPhase", phaseName) -- last, so clients see a consistent set when the phase flips
end

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player")
end

local function isReady(p)
	return isPlayer(p) and p.Parent ~= nil and call("PlayerService", "IsReady", p) == true
end

local function factionOf(p)
	local f = call("FactionService", "GetFaction", p)
	if type(f) ~= "string" then return "None" end
	return f
end

local function starsOf(p)
	return tonumber(call("PvPService", "GetStars", p)) or 0
end

-- persisted numeric stat: live data table first, mirrored attribute as fallback
local function getNum(p, key)
	local data = call("PlayerService", "GetData", p)
	local v = (type(data) == "table") and data[key] or nil
	if type(v) ~= "number" then v = p:GetAttribute(key) end
	return tonumber(v) or 0
end

local function readyPlayers()
	local list = call("PlayerService", "GetReadyPlayers")
	if type(list) ~= "table" then return {} end
	return list
end

-- CR-M4: the minted-pool pair cooldown lives in the participant's saved data (PlayerService.PairReady, key
-- "kaiju:<kaijuUserId>"), so a server hop never resets it. Commits on success. Falls back to this server's memory
-- while PairReady is missing; a PairReady error fails closed (no minted gold).
local function pairReady(p, kaijuUserId, cooldown)
	local ps = S and S.PlayerService
	if ps and type(ps.PairReady) == "function" then
		local ok, res = pcall(ps.PairReady, p, kaijuUserId, "kaiju", cooldown)
		if ok then return res == true end
		warnThrottled("pairReady", "PlayerService.PairReady failed: " .. tostring(res))
		return false
	end
	warnThrottled("pairReadyMissing", "PlayerService.PairReady missing; kaiju pair cooldown kept in memory only")
	local now = os.clock()
	for key, t in poolPaidAt do
		if now - t >= cooldown then poolPaidAt[key] = nil end
	end
	local key = tostring(p.UserId) .. ":" .. tostring(kaijuUserId)
	if poolPaidAt[key] ~= nil then return false end
	poolPaidAt[key] = now
	return true
end

local function setState(p, st)
	if st == "None" then
		states[p] = nil
	else
		states[p] = st
	end
	if isPlayer(p) and p.Parent then
		p:SetAttribute("KaijuState", st)
	end
end

local function removeFromQueue(p)
	local idx = table.find(queue, p)
	while idx do
		table.remove(queue, idx)
		idx = table.find(queue, p)
	end
end

-- eligible to queue / transform: in game, ready, Horns, enough Wanted stars
local function isEligible(p)
	return isReady(p) and factionOf(p) == "Horns" and starsOf(p) >= Config.Kaiju.StarsNeeded
end

local function countNearbyHalo(p)
	local root = Util.GetRoot(p)
	if not root then return 0 end
	local pos = root.Position
	local n = 0
	for _, v in readyPlayers() do
		if v ~= p and factionOf(v) == "Halo" and Util.IsAlive(v) then
			local r = Util.GetRoot(v)
			if r and Util.FlatDistance(r.Position, pos) <= Config.Kaiju.NearbyRadius then
				n += 1
			end
		end
	end
	return n
end

local function computeHealthMult(p)
	local nearby = countNearbyHalo(p)
	if nearby > 0 and phase == "Active" then
		contested = true
	end
	return Config.Kaiju.HPMult * (1 + Config.Kaiju.HPPerNearbyHalo * nearby)
end

-- A11-R1: ground = Terrain + workspace.Map.Ground + bridge models (workspace.Map.Decor children named "Bridge_*")
local function groundTargets()
	local list = { workspace.Terrain }
	local map = workspace:FindFirstChild("Map")
	if map then
		local ground = map:FindFirstChild("Ground")
		if ground then table.insert(list, ground) end
		local decor = map:FindFirstChild("Decor")
		if decor then
			for _, child in decor:GetChildren() do
				if string.sub(child.Name, 1, 7) == "Bridge_" then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

-- ground point below a position (for the stomp ring); falls back to the map ground plane (Y = 0)
local function groundBelow(pos)
	rayParams.FilterDescendantsInstances = groundTargets()
	local hit = workspace:Raycast(pos, Vector3.new(0, -GROUND_RAY_LENGTH, 0), rayParams)
	if hit then return hit.Position end
	return Vector3.new(pos.X, 0, pos.Z)
end

local function sampleMaxHealth(p)
	local hum = Util.GetHumanoid(p)
	if hum and hum.MaxHealth > 0 then
		lastMaxHealth = hum.MaxHealth
	end
end

-- A12: let the 3x kaiju see around itself; remembers the previous limit for restoreZoom
local function raiseZoom(p)
	local ok, err = pcall(function()
		local prev = p.CameraMaxZoomDistance
		if prev < KAIJU_CAMERA_ZOOM then
			zoomRestore[p] = prev
			p.CameraMaxZoomDistance = KAIJU_CAMERA_ZOOM
		end
	end)
	if not ok then warnThrottled("zoom", "kaiju zoom failed: " .. tostring(err)) end
end

local function restoreZoom(p)
	local prev = zoomRestore[p]
	zoomRestore[p] = nil
	if prev == nil or not isPlayer(p) or p.Parent == nil then return end
	pcall(function()
		if p.CameraMaxZoomDistance == KAIJU_CAMERA_ZOOM then -- untouched since raiseZoom
			p.CameraMaxZoomDistance = prev
		end
	end)
end

-- Halo players still in game who damaged the Active kaiju, plus Halo players who healed (via release) such a damager
local function participantList()
	local list, seen = {}, {}
	local function consider(p)
		if seen[p] then return end
		seen[p] = true
		if isReady(p) and factionOf(p) == "Halo" then
			table.insert(list, p)
		end
	end
	for p, amount in dmg do
		if type(amount) == "number" and amount > 0 then consider(p) end
	end
	for p in healers do
		consider(p)
	end
	return list
end

-- total damage Halo players dealt to the Active kaiju
local function haloDamageTotal()
	local total = 0
	for _, amount in dmg do
		if type(amount) == "number" and amount > 0 then total += amount end
	end
	return total
end

-- CR-M11: `p` is the Active kaiju and Halo players already hurt it, so its leave settles as Defeated (settleLeaver)
local function willSettleOnLeave(p)
	return p ~= nil and p == current and phase == "Active" and isPlayer(p) and haloDamageTotal() > 0
end

------------------------------------------------------------------ lifecycle
-- ends the current event for `p`; `leaving` = the player is being removed (skip per-player calls)
local function finish(p, outcome, participants, leaving)
	participants = participants or participantList()
	local inGame = isPlayer(p) and p.Parent ~= nil and not leaving

	-- clear the server-wide event FIRST so a failure below can never repeat the outcome on the next tick
	local wasCurrent = (p == current)
	if wasCurrent then
		current = nil
		phase = "None"
		phaseEndsAt = 0
		kaijuName = ""
		healthMult = 1
		contested = false
		lethalHit = false
		lastMaxHealth = 0
	end
	states[p] = nil

	if inGame then
		call("PvPService", "ResetStars", p)
		p:SetAttribute("KaijuState", "None")
		restoreZoom(p)
	else
		zoomRestore[p] = nil
		if outcome == "Defeated" and isPlayer(p) then
			-- CR-M11: a leaver settled as defeated loses its stars like a KO'd kaiju (also the saved copy, CR-M12)
			call("PvPService", "ResetStars", p)
			local data = call("PlayerService", "GetData", p)
			if type(data) == "table" then
				data.SavedStars = 0
			end
		end
	end
	if wasCurrent then
		local ok, err = pcall(publish, "None", 0, "", 0)
		if not ok then warnThrottled("publish", "GameState reset failed: " .. tostring(err)) end
	end

	if inGame then
		call("JusticeService", "RefreshScale", p)
		if Util.IsAlive(p) then
			call("PlayerService", "RefreshCharacter", p, false)
			call("PvPService", "Protect", p, Config.Kaiju.ShieldSeconds)
		end
	end

	KaijuService.KaijuEnded:Fire(p, outcome, participants)
	dmg = {}
	healers = {}
end

local function beginSiren()
	while current == nil and #queue > 0 do
		local p = table.remove(queue, 1)
		if states[p] == "Queued" and isEligible(p) then
			current = p
			phase = "Siren"
			kaijuName = Util.PlayerDisplayName(p)
			phaseEndsAt = Util.Now() + Config.Kaiju.SirenSeconds
			dmg = {}
			healers = {}
			contested = false
			lethalHit = false
			lastMaxHealth = 0
			setState(p, "Siren")
			publish("Siren", p.UserId, kaijuName, phaseEndsAt) -- CR-L23: EventHUD's siren banner is the only announcement
		elseif states[p] == "Queued" then
			setState(p, "None")
		end
	end
end

local function activate(p)
	phase = "Active"
	phaseEndsAt = Util.Now() + Config.Kaiju.Duration
	dmg = {}
	healers = {}
	contested = false
	lethalHit = false
	lastMaxHealth = 0
	healthMult = computeHealthMult(p) -- phase is "Active": a Halo player already nearby marks the event contested
	lastRecalc = os.clock()
	lastStomp = os.clock()
	setState(p, "Active") -- before Justice/Player refresh: they read GetState / GetHealthMult
	publish("Active", p.UserId, kaijuName, phaseEndsAt)
	call("JusticeService", "RefreshScale", p) -- x3 visual (capped by Config.Justice.MaxVisualScale)
	call("PlayerService", "RefreshCharacter", p, true) -- full heal at the transformation
	sampleMaxHealth(p)
	raiseZoom(p)
	Net.NotifyAll(string.format(Config.Story.KaijuStart, kaijuName))
	KaijuService.KaijuStarted:Fire(p)
end

local function survive(p)
	local name = kaijuName
	local participants = participantList()
	local opposed = contested or #participants > 0
	local ok, err = pcall(function()
		-- bonus cap first (pure math), so nothing below can fail after the carried gold was taken
		local level = math.max(1, math.floor(getNum(p, "Level")))
		local okCap, capGold = pcall(Config.HuntValue, level, SURVIVE_BONUS_MINUTES)
		capGold = (okCap and tonumber(capGold)) or 0
		local carried = math.max(0, math.floor(getNum(p, "CarriedGold")))
		local taken = math.max(0, math.floor(tonumber(call("ProgressionService", "TakeCarriedGold", p, carried)) or 0))
		local fullBonus = math.max(0, math.floor(taken * Config.Kaiju.SurviveBankMult) - taken) -- minted part
		local bonus = opposed and math.min(fullBonus, math.max(0, math.floor(capGold))) or 0
		local amount = taken + bonus
		if amount > 0 then
			call("ProgressionService", "AddBankGold", p, amount, "Kaiju")
		end
		p:SetAttribute("SessionTitle", Config.Story.SurviveTitle) -- session only
		call("WarService", "AddFactionPoints", "Horns", Config.Kaiju.HornsWarPoints)
		local text = Config.Text.KaijuSurviveReward
		if not opposed then
			text = TXT_SURVIVE_UNCONTESTED
		elseif bonus < fullBonus then
			text = TXT_SURVIVE_CAPPED
		end
		Net.Notify(p, string.format(text, Util.FormatNumber(amount)), "reward")
		Net.NotifyAll(string.format(Config.Story.KaijuSurvived, name))
	end)
	if not ok then warnThrottled("survive", "survive reward failed: " .. tostring(err)) end
	finish(p, "Survived", participants)
end

local function stomp(p)
	if not Util.IsAlive(p) then return end
	local root = Util.GetRoot(p)
	if not root then return end
	local pos = root.Position
	for _, v in readyPlayers() do
		if v ~= p and factionOf(v) == "Halo" and Util.IsAlive(v) then
			local r = Util.GetRoot(v)
			if r and Util.FlatDistance(r.Position, pos) <= Config.Kaiju.StompRadius
				and call("PvPService", "IsRookie", v) ~= true
				and v:GetAttribute("Protected") ~= true
				and call("ZoneService", "IsTown", v) ~= true then
				local hum = Util.GetHumanoid(v)
				if hum and hum.Health > 0 then
					contested = true -- a Halo player stood in stomp range: the kaiju faced real opposition
					-- CR-M13: outside PvP zones the stomp is environmental damage (no combat tag, no PvP KO credit)
					local atk = (call("ZoneService", "IsPvPZone", v) == true) and p or nil
					call("CombatService", "DamagePlayer", v, Util.RoundDamage(hum.MaxHealth * Config.Kaiju.StompPct), atk)
				end
			end
		end
	end
	Net.Fx(nil, "Stomp", { UserId = p.UserId, Pos = groundBelow(pos), Radius = Config.Kaiju.StompRadius })
end

-- CR-M11: the current kaiju is leaving (PlayerLeaving, or found already removed by the tick). An Active kaiju that Halo
-- players already hurt is settled as Defeated (leaving = true: no character access; unless the last hit was lethal the
-- minted pool is scaled by the Halo damage share). Otherwise, or if that fails, the event is Cancelled (no rewards).
local function settleLeaver(p)
	if p ~= current then return end
	if willSettleOnLeave(p) then
		local ok, err = pcall(KaijuService.HandleKaijuDeath, p, nil, true)
		if not ok then warnThrottled("leaveDefeat", "leaving kaiju settle failed: " .. tostring(err)) end
	end
	if p == current then
		finish(p, "Cancelled", nil, true)
	end
end

-- CR-M11: first PlayerLeaving handler (connectFirst). ProgressionService (earlier in INIT_ORDER) would otherwise bank
-- the pouch of a kaiju that is about to be settled as Defeated into its own vault (75% when combat-tagged) and the
-- raid pool would get no carried gold. Pull the pouch into escrow; HandleKaijuDeath(leaving) pours it into the pool.
local function escrowLeaverGold(player)
	if not willSettleOnLeave(player) then return end
	local entry = {
		Gold = 0,
		-- decided now, before any other leave handler can drop the combat tag (used only by bankLeftover)
		CombatLog = call("CombatService", "IsInCombat", player) == true and call("PlayerService", "IsShuttingDown") ~= true,
	}
	leaveEscrow[player] = entry
	local carried = math.max(0, math.floor(getNum(player, "CarriedGold")))
	if carried > 0 then
		entry.Gold = math.max(0, math.floor(tonumber(call("ProgressionService", "TakeCarriedGold", player, carried)) or 0))
	end
end

-- CR-M11 fallback, after settleLeaver: escrow the Defeated settle did not take (it failed) plus any pouch left (a
-- ProgressionService that skips WillSettleOnLeave leavers) is banked like ProgressionService.onPlayerLeaving would
local function bankLeftover(p, data)
	local entry = leaveEscrow[p]
	leaveEscrow[p] = nil
	if type(entry) ~= "table" then return end
	if type(data) ~= "table" then data = call("PlayerService", "GetData", p) end
	if type(data) ~= "table" then return end
	local escrowed = math.max(0, math.floor(tonumber(entry.Gold) or 0))
	local amount = escrowed + math.max(0, math.floor(tonumber(data.CarriedGold) or 0))
	if amount <= 0 then return end
	if entry.CombatLog == true then
		amount = math.floor(amount * (1 - (tonumber(Config.PvP.CombatLogPenalty) or 0)))
	end
	data.CarriedGold = 0
	data.BankGold = math.max(0, tonumber(data.BankGold) or 0) + math.max(0, amount)
	warnThrottled("leaveLeftover", "leaving kaiju pouch banked instead of pooled (settle did not take it)")
end

------------------------------------------------------------------ loop
local function updateQueue()
	-- drop queued players who left, are no longer Horns or have fewer stars
	for i = #queue, 1, -1 do
		local p = queue[i]
		local ok, valid = pcall(function()
			return states[p] == "Queued" and isEligible(p)
		end)
		if not (ok and valid) then
			table.remove(queue, i)
			if states[p] == "Queued" then setState(p, "None") end
		end
	end
	-- append newly eligible Horns players
	for _, p in readyPlayers() do
		local ok, err = pcall(function()
			if states[p] == nil and isEligible(p) then
				table.insert(queue, p)
				setState(p, "Queued")
				if current ~= nil then
					Net.Notify(p, string.format(Config.Text.KaijuQueued), "info")
				end
			end
		end)
		if not ok then warnThrottled("queue", "queue error: " .. tostring(err)) end
	end
end

local function tick()
	updateQueue()

	local p = current
	if p ~= nil then
		if not isPlayer(p) or p.Parent == nil then
			settleLeaver(p) -- CR-M11
		elseif phase == "Siren" then
			if Util.Now() >= phaseEndsAt then
				if isEligible(p) and Util.IsAlive(p) then
					activate(p)
				else
					finish(p, "Cancelled")
				end
			end
		elseif phase == "Active" then
			if Util.Now() >= phaseEndsAt then
				survive(p)
			else
				sampleMaxHealth(p)
				local now = os.clock()
				if now - lastRecalc >= Config.Kaiju.HPRecalc then
					lastRecalc = now
					local mult = computeHealthMult(p)
					if math.abs(mult - healthMult) > 1e-6 then
						healthMult = mult
						call("PlayerService", "RefreshCharacter", p, false) -- HP % preserved
					end
				end
				if now - lastStomp >= Config.Kaiju.StompInterval then
					lastStomp = now
					stomp(p)
				end
			end
		end
	end

	if current == nil then
		beginSiren()
	end
end

------------------------------------------------------------------ public API
function KaijuService.Init(registry)
	S = registry

	S.PlayerService.PlayerReady:Connect(function(player)
		if not isPlayer(player) or player.Parent == nil then return end
		states[player] = nil
		player:SetAttribute("KaijuState", "None")
		player:SetAttribute("SessionTitle", "")
	end)

	-- CR-M11: must run before ProgressionService's PlayerLeaving handler, which banks the leaver's pouch
	connectFirst(S.PlayerService.PlayerLeaving, escrowLeaverGold)

	S.PlayerService.PlayerLeaving:Connect(function(player, data)
		if player == current then
			-- CR-M11: Defeated if Halo players hurt the Active kaiju, else Cancelled
			local ok, err = pcall(settleLeaver, player)
			if not ok then warnThrottled("settleLeaver", "leaving kaiju settle failed: " .. tostring(err)) end
		end
		local okLeft, errLeft = pcall(bankLeftover, player, data) -- CR-M11: no-op once the pool took the escrow
		if not okLeft then warnThrottled("leaveLeftover", "leaving kaiju leftover failed: " .. tostring(errLeft)) end
		removeFromQueue(player)
		states[player] = nil
		dmg[player] = nil
		healers[player] = nil
		zoomRestore[player] = nil
	end)

	S.FactionService.FactionChanged:Connect(function(player, newFaction)
		if player == current then
			finish(player, "Cancelled") -- defensive; switching is normally blocked for kaiju
		elseif states[player] == "Queued" and newFaction ~= "Horns" then
			removeFromQueue(player)
			setState(player, "None")
		end
	end)

	S.CombatService.PlayerDamaged:Connect(function(victim, amount, attacker)
		if phase ~= "Active" or victim ~= current or current == nil then return end
		if not isPlayer(attacker) or attacker == victim then return end
		if type(amount) ~= "number" or amount <= 0 then return end
		if factionOf(attacker) ~= "Halo" then return end
		dmg[attacker] = (dmg[attacker] or 0) + amount
		contested = true
		-- PlayerDamaged fires synchronously right after TakeDamage: Health <= 0 here means THIS Halo hit was lethal
		local hum = Util.GetHumanoid(victim)
		if hum then
			if hum.MaxHealth > 0 then lastMaxHealth = hum.MaxHealth end
			if hum.Health <= 0 then lethalHit = true end
		end
	end)

	S.CombatService.Released:Connect(function(player, info)
		if phase ~= "Active" or current == nil then return end
		if not isPlayer(player) or type(info) ~= "table" or type(info.Healed) ~= "table" then return end
		if info.Auto == true then return end -- A23-1: kaiju rewards come from direct input only
		if factionOf(player) ~= "Halo" then return end
		for _, h in info.Healed do
			if (dmg[h] or 0) > 0 then
				healers[player] = true
				break
			end
		end
	end)
end

function KaijuService.Start()
	getGameState()
	publish("None", 0, "", 0)

	task.spawn(function()
		while true do
			task.wait(Config.Kaiju.Tick)
			local ok, err = pcall(tick)
			if not ok then warnThrottled("loop", "tick error: " .. tostring(err)) end
		end
	end)

	print("[KaijuService] started")
end

function KaijuService.GetState(player)
	return states[player] or "None"
end

function KaijuService.GetActive()
	return current
end

-- CR-M11: true when `player` is the Active kaiju and Halo players already hurt it: its leave settles as Defeated and
-- its pouch belongs to the raid pool (escrowed by KaijuService's first PlayerLeaving handler), so a leave handler must
-- not bank its CarriedGold
function KaijuService.WillSettleOnLeave(player)
	return willSettleOnLeave(player)
end

function KaijuService.GetHealthMult(player)
	if player ~= nil and player == current and phase == "Active" then
		return healthMult
	end
	return 1
end

-- called by CombatService's death pipeline (Defeated; no last-hit bonus) and by settleLeaver (leaving = true, CR-M11:
-- the kaiju is being removed, so its character is never touched)
function KaijuService.HandleKaijuDeath(victim, killer, leaving)
	if victim == nil or victim ~= current or phase ~= "Active" then
		warnThrottled("death", "HandleKaijuDeath for a player that is not the active kaiju")
		return
	end
	leaving = leaving == true
	local name = kaijuName
	local participants = participantList()
	local paid = 0 -- CR-L19: gold actually paid out (the announcement shows this, not the theoretical pool)

	local ok, err = pcall(function()
		local level = math.max(1, math.floor(getNum(victim, "Level")))
		local bully = tonumber(call("JusticeService", "GetBullyStacks", victim)) or 0
		local bounty = Config.Bounty(level, starsOf(victim), bully)
		local mint = math.max(0, Config.Kaiju.BountyPoolMult * bounty)

		-- review fix: no Halo player landed the lethal hit (reset, fall, monster, logout, ...) -> mint only the share of
		-- the kaiju's HP that Halo players really took off (a 1-damage tag + reset mints ~0; a near-dead reset still pays)
		if not lethalHit then
			local maxHp = lastMaxHealth
			local hum = (not leaving) and Util.GetHumanoid(victim) or nil
			if hum and hum.MaxHealth > 0 then maxHp = math.max(maxHp, hum.MaxHealth) end
			local frac = (maxHp > 0) and math.clamp(haloDamageTotal() / maxHp, 0, 1) or 0
			mint *= frac
		end
		mint = math.floor(mint)

		local carried = math.max(0, math.floor(getNum(victim, "CarriedGold")))
		local taken = math.max(0, math.floor(tonumber(call("ProgressionService", "TakeCarriedGold", victim, carried)) or 0))
		-- CR-M11: a leaving kaiju's pouch was escrowed before ProgressionService could bank it; it joins the pool here
		local escrow = leaveEscrow[victim]
		if type(escrow) == "table" then
			taken += math.max(0, math.floor(tonumber(escrow.Gold) or 0))
			escrow.Gold = 0 -- entry kept: bankLeftover still reads CombatLog
		end
		-- CR-M3: the carried gold moved into the pool is capped like a PvP plunder; the excess is destroyed
		local capPerLevel = tonumber(Config.PvP.PlunderCapPerLevel) or 100
		taken = math.min(taken, math.max(0, math.floor(capPerLevel * level)))
		local pool = mint + taken

		local n = #participants
		if n > 0 and pool > 0 then
			local totalDmg = 0
			for _, p in participants do
				totalDmg += (dmg[p] or 0)
			end
			local cooldown = tonumber(Config.Kaiju.PairRewardCooldown) or 1800 -- CR-M3
			for _, p in participants do
				-- spec split: DamageShare by damage + the rest equally (everything equally if only healers are left)
				local frac = 1 / n
				if totalDmg > 0 then
					frac = Config.Kaiju.DamageShare * (dmg[p] or 0) / totalDmg + (1 - Config.Kaiju.DamageShare) / n
				end
				local share = math.floor(taken * frac) -- carried gold: a transfer, always paid
				-- minted part: once per participant/kaiju pair per Kaiju.PairRewardCooldown, saved in PairCD (CR-M4)
				local mintShare = math.floor(mint * frac)
				if mintShare > 0 and pairReady(p, victim.UserId, cooldown) then
					share += mintShare
				end
				if share > 0 then
					call("ProgressionService", "AddBankGold", p, share, "Kaiju")
					paid += share
					Net.Notify(p, string.format(Config.Text.KaijuReward, Util.FormatNumber(share)), "reward")
				end
			end
		end

		call("WarService", "AddFactionPoints", "Halo", Config.Kaiju.HaloWarPoints)
	end)
	if not ok then warnThrottled("defeat", "defeat reward failed: " .. tostring(err)) end

	local okSend, sendErr = pcall(function()
		if paid > 0 then
			Net.NotifyAll(string.format(Config.Story.KaijuDefeated, name, Util.FormatNumber(paid)))
		else
			-- CR-L19: nobody was paid -> no "보상 N골드" line
			Net.NotifyAll(string.format(Config.Story.KaijuDefeatedNoReward or "괴수 %s이(가) 쓰러졌어요.", name))
		end
	end)
	if not okSend then warnThrottled("send", "defeat broadcast failed: " .. tostring(sendErr)) end
	finish(victim, "Defeated", participants, leaving)
end

return KaijuService
]]></ProtectedString>
				<string name="ScriptGuid">{3BDC1F3D-6FE0-4B44-9CC4-71A2BE4B2B53}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">KaijuService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f6880000090d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8FE3483D5F9B403699743F0E9EA91E5C">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- LootService.luau : A23-11 / A23-12 monster drops, items, scroll enhancement and weapon equip from the item list.
-- Server-authoritative. Every kill contributor gets one own roll per kill (MonsterService fires MonsterKilled once
-- per contributor). Items go straight into the save: no ground pickup, never lost on death / looting / grudge sacks.
--   data.Items = { [itemId] = count }          (1..ItemCap; ids missing from Config.Loot.Items stay in the save but are
--                                               never shown or usable — review B10, so a renamed id is recoverable)
--   data.WeaponEnhance = { [tier] = 0..MaxEnhance }  (array by weapon tier; kept through rebirth)
--   data.LootFlags = { FirstScroll = true }
-- Client mirror (display only, review B11): the owner-only "Inventory" remote { Items, Enhance } and the numeric
-- WeaponEnhance attribute (+N of the EQUIPPED tier; CombatService / JusticeService / PvPService read it).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local LootService = {}
local S = nil
local TAG = "LootService"
local LOOT = Config.Loot
local TXT = LOOT.Text
local rng = Random.new()

-- per-player server state (cleared on PlayerLeaving)
local STATE = {
	Pending = {}, -- [Player] = true while one deferred Inventory push is queued (a burst of changes sends once)
	FullAt = {}, -- [Player] = { [itemId | "Potion:HP" | "Potion:MP"] = os.clock() of the last "가득 찼어요" notice }
	SavedIdMaxLen = 64, -- B10: unknown saved item ids are kept only when they are sane strings
}

LootService.ItemsGranted = Util.Signal.new() -- (player, { { Id = itemId, N = n } ... })
LootService.Enhanced = Util.Signal.new() -- (player, tier, before, after, success)

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return default or 0
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

local function notify(player, text, kind)
	if type(text) == "string" and text ~= "" then pcall(Net.Notify, player, text, kind or "info") end
end

-- review B7: a full-stack notice at most once per key per player per Config.Loot.FullNoticeSeconds, always "info"
local function fullNotice(player, key, text)
	local seen = STATE.FullAt[player]
	if not seen then
		seen = {}
		STATE.FullAt[player] = seen
	end
	local now, last = os.clock(), seen[key]
	if last and now - last < num(LOOT.FullNoticeSeconds, 300) then return end
	seen[key] = now
	notify(player, text, "info")
end

local function className(player)
	local ok, c = pcall(S.ClassService.GetClass, player)
	return ok and c or "Warrior"
end

local function factionName(player)
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function weaponName(player, tier)
	return Config.WeaponName(tier, className(player), factionName(player))
end

local function validTier(tier)
	return type(tier) == "number" and tier == tier and tier == math.floor(tier) and tier >= 1 and tier <= Config.MaxWeaponTier
end

local function owns(data, tier)
	local mask = data.WeaponOwnedMask
	return validTier(tier) and type(mask) == "number" and mask == math.floor(mask) and mask >= 1
		and bit32.btest(mask, bit32.lshift(1, tier - 1))
end

------------------------------------------------------------------ data
local function sanitize(data)
	local items = {}
	if type(data.Items) == "table" then
		for id, n in data.Items do
			-- B10: unknown ids (an item renamed or removed by a later update) are preserved, not deleted; every reader
			-- below looks the id up in Config.Loot.Items first, so they are never shown, used or sold
			if type(id) == "string" and #id >= 1 and #id <= STATE.SavedIdMaxLen then
				local c = math.floor(num(n)) -- NaN / inf / non-numbers count as 0 and are dropped (never free items)
				if c > 0 then items[id] = math.min(c, LOOT.ItemCap) end
			end
		end
	end
	data.Items = items
	local enh = {}
	local old = type(data.WeaponEnhance) == "table" and data.WeaponEnhance or {}
	for tier = 1, Config.MaxWeaponTier do
		enh[tier] = math.clamp(math.floor(num(old[tier])), 0, LOOT.MaxEnhance)
	end
	data.WeaponEnhance = enh
	if type(data.LootFlags) ~= "table" then data.LootFlags = {} end
	for k, v in data.LootFlags do
		if type(k) ~= "string" or v ~= true then data.LootFlags[k] = nil end
	end
end

local function ensureTables(data)
	if type(data.Items) ~= "table" or type(data.WeaponEnhance) ~= "table" or type(data.LootFlags) ~= "table" then
		sanitize(data)
	end
end

local function enhanceOf(data, tier)
	local enh = data.WeaponEnhance
	return type(enh) == "table" and math.clamp(math.floor(num(enh[tier])), 0, LOOT.MaxEnhance) or 0
end

-- the SHARED CONTRACT payload: known item ids with count >= 1, and +N for every weapon tier (array 1..MaxWeaponTier)
local function inventoryPayload(data)
	local items = {}
	if type(data.Items) == "table" then
		for id, n in data.Items do
			if type(id) == "string" and LOOT.Items[id] then
				local c = math.floor(num(n))
				if c >= 1 then items[id] = math.clamp(c, 1, LOOT.ItemCap) end
			end
		end
	end
	local enh = {}
	for tier = 1, Config.MaxWeaponTier do
		enh[tier] = enhanceOf(data, tier)
	end
	return { Items = items, Enhance = enh }
end

local function pushInventory(player)
	STATE.Pending[player] = nil
	if typeof(player) ~= "Instance" or player.Parent ~= Players then return end -- left: never fire to a removed player
	local data = getData(player)
	if not data then return end
	Net.Get("Inventory"):FireClient(player, inventoryPayload(data))
end

-- mirror for the client (display only); the server always decides from data. The equipped +N attribute updates at
-- once; the owner-only Inventory push is deferred and coalesced (at most one per frame per player).
local function publish(player, data)
	data = data or getData(player)
	if not data then return end
	player:SetAttribute("WeaponEnhance", enhanceOf(data, math.floor(num(data.WeaponTier, 1))))
	if STATE.Pending[player] then return end
	STATE.Pending[player] = true
	task.defer(function()
		local ok, err = pcall(pushInventory, player)
		if not ok then
			STATE.Pending[player] = nil
			Util.Warn(TAG, "Inventory push: " .. tostring(err))
		end
	end)
end

local function addItem(player, data, id, n)
	local def = LOOT.Items[id]
	if not def or n <= 0 then return 0 end
	local have = math.floor(num(data.Items[id]))
	local room = math.max(0, LOOT.ItemCap - have)
	local given = math.clamp(n, 0, room)
	if given < n then
		-- full (or only part of a multi-count drop fits): say so instead of dropping the rest silently (throttled, B7);
		-- only materials can be sold at the anvil, scrolls are used from the item list
		local fmt = def.Kind == "Material" and TXT.ItemFull or TXT.ItemFullUse
		fullNotice(player, id, string.format(fmt, def.Name, LOOT.ItemCap))
	end
	if given <= 0 then return 0 end
	data.Items[id] = have + given
	return given
end

local function takeItem(data, id)
	local have = math.floor(num(data.Items[id]))
	if have < 1 then return false end
	data.Items[id] = have > 1 and have - 1 or nil
	return true
end

------------------------------------------------------------------ drops
-- one kill's drop rows (and the slime jackpot) with the server RNG; onHit(row, isJackpot) for every success.
-- info = { Kind = monster kind, Golden = true? } (RollKill passes the MonsterKilled info, DebugSimulate a stand-in).
-- Draw order is fixed: one draw per row in table order, then one for the jackpot when this kind has one.
local function rollRows(info, onHit)
	local mult = info.Golden == true and LOOT.GoldenMult or 1
	for _, row in LOOT.Tables[info.Kind] or {} do
		if rng:NextNumber() < math.min(1, num(row.P) * mult) then onHit(row, false) end
	end
	local jackpot = LOOT.Jackpot
	if jackpot and jackpot.Monsters[info.Kind] and rng:NextNumber() < math.min(1, num(jackpot.Chance) * mult) then
		onHit({ Weapon = jackpot.Tier }, true)
	end
end

local function grantWeapon(player, data, tier, gained, isJackpot)
	if not validTier(tier) then return end
	if owns(data, tier) then
		local gold = LOOT.DuplicateWeaponGold[tier] or 0
		if gold > 0 then
			S.ProgressionService.AddCarriedGold(player, gold, "Loot")
			notify(player, string.format(TXT.DuplicateWeapon, weaponName(player, tier), Util.FormatNumber and Util.FormatNumber(gold) or tostring(gold)), "reward")
		end
		return
	end
	-- ownership is saved before any announcement, so a repeated signal cannot give it twice
	S.PlayerService.SetStat(player, "WeaponOwnedMask", bit32.bor(math.floor(num(data.WeaponOwnedMask, 1)), bit32.lshift(1, tier - 1)))
	local name = weaponName(player, tier)
	table.insert(gained, { Weapon = tier, Name = name })
	if isJackpot then
		notify(player, string.format(TXT.JackpotSelf, name), "reward")
		pcall(Net.NotifyAll, string.format(TXT.JackpotAll, Util.PlayerDisplayName(player), name), "announce", 8)
	else
		notify(player, string.format(TXT.RareWeapon, name), "reward")
	end
end

local function grantPotion(player, data, kind, gained)
	local key = Config.PotionStockKey(kind)
	if not key then return end
	local cap = Config.Vitals.PotionInventoryCap
	local have = math.floor(num(data[key]))
	if have >= cap then
		fullNotice(player, "Potion:" .. tostring(kind), string.format(TXT.PotionFull, TXT.Potion[kind] or kind))
		return
	end
	S.PlayerService.SetStat(player, key, have + 1)
	table.insert(gained, { Potion = kind, Name = TXT.Potion[kind] or kind, N = 1 })
end

-- one roll for one contributor of one kill
function LootService.RollKill(player, info)
	local data = getData(player)
	if not data or type(info) ~= "table" or type(info.Kind) ~= "string" then return nil end
	ensureTables(data)
	local gained = {}
	local itemCounts = {}
	local function giveItem(id, n)
		local given = addItem(player, data, id, n)
		if given > 0 then itemCounts[id] = (itemCounts[id] or 0) + given end
		return given
	end

	local first = LOOT.FirstScroll
	local firstNow = false
	if first and info.Kind == first.Monster and data.LootFlags.FirstScroll ~= true then
		-- B8: the flag is set only when the scroll really fits, so a full stack keeps the guarantee for a later kill.
		-- Grant and flag happen together with no yield in between: it is still paid at most once.
		if giveItem(first.Item, 1) > 0 then
			data.LootFlags.FirstScroll = true
			firstNow = true
			-- the one-time guide (A23-12). The Loot Fx below carries First = true so the client skips its own
			-- "where to use it" toast for this scroll (one toast, not two)
			pcall(Net.Notify, player, TXT.FirstScroll, "reward", num(first.NoticeSeconds, 6))
		end
	end

	rollRows(info, function(row, isJackpot)
		if row.Item then
			giveItem(row.Item, math.max(1, math.floor(num(row.N, 1))))
		elseif row.Potion then
			grantPotion(player, data, row.Potion, gained)
		elseif row.Weapon then
			grantWeapon(player, data, row.Weapon, gained, isJackpot)
		end
	end)

	for _, id in LOOT.Order do
		local n = itemCounts[id]
		if n then table.insert(gained, { Item = id, Name = LOOT.Items[id].Name, N = n }) end
	end
	if #gained > 0 then
		publish(player, data)
		local pos = typeof(info.Position) == "Vector3" and info.Position or nil
		pcall(Net.Fx, player, "Loot", { Pos = pos, Items = gained, First = firstNow or nil })
		LootService.ItemsGranted:Fire(player, gained)
	end
	return gained
end

------------------------------------------------------------------ remotes
local function ready(player, key)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
		and S.PlayerService.IsReady(player) and Util.RateLimit(player, key, Config.RateLimits[key] or 0.5)
end

local function useEnhance(player, data, id, def, tier)
	if not owns(data, tier) then notify(player, TXT.NotOwned, "bad"); return end
	local before = enhanceOf(data, tier)
	if before >= LOOT.MaxEnhance then notify(player, string.format(TXT.EnhanceMax, LOOT.MaxEnhance), "bad"); return end
	if not takeItem(data, id) then notify(player, TXT.NoItem, "bad"); return end
	local name = weaponName(player, tier)
	local success = rng:NextNumber() < def.Chance
	local after = before
	if success then
		after = math.min(LOOT.MaxEnhance, before + def.Plus)
	elseif before > 0 and rng:NextNumber() < LOOT.FailDropChance then
		after = before - 1
	end
	data.WeaponEnhance[tier] = after
	publish(player, data)
	if success then
		notify(player, string.format(TXT.EnhanceOk, name, before, after,
			math.floor(Config.EnhanceMult(before) * 100 + 0.5), math.floor(Config.EnhanceMult(after) * 100 + 0.5)), "reward")
	elseif after < before then
		notify(player, string.format(TXT.EnhanceFailDown, name, before, after), "bad")
	else
		notify(player, string.format(TXT.EnhanceFailKeep, name, before), "info")
	end
	pcall(Net.Fx, player, "Enhance", { Item = id, Tier = tier, Before = before, After = after, Success = success })
	LootService.Enhanced:Fire(player, tier, before, after, success)
end

local function useTransfer(player, data, id, def, fromTier, toTier)
	if not owns(data, fromTier) or not owns(data, toTier) then notify(player, TXT.NotOwned, "bad"); return end
	if fromTier == toTier then notify(player, TXT.MoveSame, "bad"); return end
	local amount = enhanceOf(data, fromTier)
	if amount <= 0 then notify(player, TXT.MoveNothing, "bad"); return end
	local target = enhanceOf(data, toTier)
	if target >= LOOT.MaxEnhance then notify(player, string.format(TXT.EnhanceMax, LOOT.MaxEnhance), "bad"); return end
	if not takeItem(data, id) then notify(player, TXT.NoItem, "bad"); return end
	local success = rng:NextNumber() < def.Chance
	local fromName, toName = weaponName(player, fromTier), weaponName(player, toTier)
	local after = target
	if success then
		-- "전부 옮김" (user 2026-10-05) without any loss: the source's +N is ADDED to the target's +M up to MaxEnhance;
		-- only what does not fit stays on the source (no enhancement ever disappears)
		after = math.min(LOOT.MaxEnhance, target + amount)
		data.WeaponEnhance[toTier] = after
		data.WeaponEnhance[fromTier] = amount - (after - target)
		notify(player, string.format(TXT.MoveOk, fromName, data.WeaponEnhance[fromTier], toName, after), "reward")
	else
		notify(player, string.format(TXT.MoveFail, fromName, amount), "info")
	end
	publish(player, data)
	pcall(Net.Fx, player, "Enhance", { Item = id, Tier = toTier, From = fromTier, Before = target, After = after, Success = success, Move = true })
end

-- (itemId, tier) for an enhance scroll, (itemId, fromTier, toTier) for a transfer scroll; nothing else is accepted
local function onUseItem(player, id, a, b, ...)
	if select("#", ...) ~= 0 or type(id) ~= "string" or not ready(player, "UseItem") then return end
	local def = LOOT.Items[id] -- unknown (B10) and material ids are never usable
	if not def then return end
	if def.Kind == "Enhance" then
		if not validTier(a) or b ~= nil then return end
	elseif def.Kind == "Transfer" then
		if not validTier(a) or not validTier(b) then return end
	else
		return
	end
	-- B6: no scroll during PvP combat (it would change the WeaponEnhance the PvP ratio reads mid-fight)
	if S.CombatService.IsInCombat(player) then notify(player, TXT.UseCombat, "bad"); return end
	local data = getData(player)
	if not data then return end
	ensureTables(data)
	if def.Kind == "Enhance" then
		useEnhance(player, data, id, def, a)
	else
		useTransfer(player, data, id, def, a, b)
	end
	S.PlayerService.MarkActive(player)
end

local function onEquipWeapon(player, tier, ...)
	if select("#", ...) ~= 0 or not validTier(tier) or not ready(player, "EquipWeapon") then return end
	local data = getData(player)
	if not data or data.ClassChosen ~= true then return end
	if not owns(data, tier) then notify(player, TXT.NotOwned, "bad"); return end
	if math.floor(num(data.WeaponTier, 1)) == tier then return end
	local def = Config.Weapons[tier]
	-- review (A23-4 / A23-14): MinLevel gates the PURCHASE only. An owned weapon is always re-equippable, so a reborn
	-- or free-class-changed Lv1 player who swaps away from a kept T5 can always swap back (ShopService matches).
	if def.RequiresFaction and factionName(player) == "None" then
		notify(player, Config.Text.NeedFaction, "bad")
		return
	end
	-- B6: the same state rules as the blacksmith equip path (alive, not in PvP combat)
	if not Util.IsAlive(player) then notify(player, TXT.EquipDead, "bad"); return end
	if S.CombatService.IsInCombat(player) then notify(player, TXT.EquipCombat, "bad"); return end
	S.PlayerService.SetStat(player, "WeaponTier", tier) -- CharacterVisuals rebuilds the model; WeaponEnhance follows
	S.PlayerService.MarkActive(player)
	notify(player, string.format(TXT.Equip, weaponName(player, tier)), "info")
	pcall(Net.Fx, player, "Upgrade", { Tier = tier })
end

local function onSellMaterials(player, ...)
	if select("#", ...) ~= 0 or not ready(player, "SellMaterials") then return end
	if not S.ShopService.CanBuyWeapon(player) then notify(player, TXT.SellFar, "bad"); return end
	local data = getData(player)
	if not data then return end
	ensureTables(data)
	local count, gold = 0, 0
	for id, n in data.Items do
		local def = LOOT.Items[id]
		if def and def.Kind == "Material" then
			local c = math.floor(num(n))
			count += c
			gold += c * def.Sell
			data.Items[id] = nil -- removed before paying: a repeated request cannot pay twice
		end
	end
	if count <= 0 then notify(player, TXT.SellNothing, "info"); return end
	publish(player, data)
	S.ProgressionService.AddCarriedGold(player, gold, "Sale")
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	S.PlayerService.MarkActive(player)
	notify(player, string.format(TXT.SellDone, count, tostring(gold)), "good")
end

------------------------------------------------------------------ lifecycle
function LootService.Init(registry)
	S = registry
end

function LootService.Start()
	Net.Get("UseItem").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onUseItem, player, ...)
		if not ok then Util.Warn(TAG, "UseItem: " .. tostring(err)) end
	end)
	Net.Get("EquipWeapon").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onEquipWeapon, player, ...)
		if not ok then Util.Warn(TAG, "EquipWeapon: " .. tostring(err)) end
	end)
	Net.Get("SellMaterials").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onSellMaterials, player, ...)
		if not ok then Util.Warn(TAG, "SellMaterials: " .. tostring(err)) end
	end)
	S.MonsterService.MonsterKilled:Connect(function(player, info)
		local ok, err = pcall(LootService.RollKill, player, info)
		if not ok then Util.Warn(TAG, "RollKill: " .. tostring(err)) end
	end)
	S.PlayerService.PlayerReady:Connect(function(player, data)
		data = type(data) == "table" and data or getData(player)
		if not data then return end
		sanitize(data)
		publish(player, data)
		player:GetAttributeChangedSignal("WeaponTier"):Connect(function()
			local d = getData(player)
			if d then player:SetAttribute("WeaponEnhance", enhanceOf(d, math.floor(num(d.WeaponTier, 1)))) end
		end)
	end)
	-- safety net (same as the quest list): resend the inventory once per real spawn; the client keeps the last payload
	if S.PlayerService.CharacterSpawned then
		S.PlayerService.CharacterSpawned:Connect(function(player, _, _, cosmetic)
			if cosmetic == true or not S.PlayerService.IsReady(player) then return end
			local ok, err = pcall(publish, player)
			if not ok then Util.Warn(TAG, "Inventory resend: " .. tostring(err)) end
		end)
	end
	S.PlayerService.PlayerLeaving:Connect(function(player)
		STATE.Pending[player] = nil
		STATE.FullAt[player] = nil
	end)
	print("[LootService] started")
end

-- re-mirror the owner's items / per-tier +N (Inventory remote) and the equipped WeaponEnhance attribute; for other
-- services after they change WeaponTier / ownership in a way the client should see at once (no data is changed)
function LootService.Refresh(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then return end
	publish(player)
end

-- Studio test aid (DebugCommand "Item"): add n of an item id
function LootService.DebugGive(player, id, n)
	local data = getData(player)
	if not data or not LOOT.Items[id] then return 0 end
	ensureTables(data)
	local given = addItem(player, data, id, math.floor(num(n, 1)))
	publish(player, data)
	return given
end

-- Studio test aid (DebugCommand "LootRoll", review B12): COUNT-ONLY. Rolls n kills of this monster kind with the real
-- drop tables and RNG but grants nothing, saves nothing and sends no Fx / notice (no first-scroll guarantee, caps or
-- duplicate-weapon gold either). Returns { Kills = n, [itemId | "HP" | "MP" | "Weapon<tier>"] = count } or nil.
function LootService.DebugSimulate(kind, n, golden)
	if type(kind) ~= "string" or type(LOOT.Tables[kind]) ~= "table" then return nil end
	local kills = math.clamp(math.floor(num(n, 1)), 1, 100000)
	local tally = { Kills = kills }
	local info = { Kind = kind, Golden = golden == true }
	for _ = 1, kills do
		rollRows(info, function(row)
			local key = row.Item or row.Potion or ("Weapon" .. tostring(row.Weapon))
			local count = row.Item and math.max(1, math.floor(num(row.N, 1))) or 1
			tally[key] = (tally[key] or 0) + count
		end)
	end
	return tally
end

-- Studio test aid (DebugCommand "LootReset"): undo test drops on the test account (items, +N, flags, weapons)
function LootService.DebugReset(player, mask)
	local data = getData(player)
	if not data then return "no data" end
	data.Items, data.WeaponEnhance, data.LootFlags = {}, {}, {}
	sanitize(data)
	mask = math.floor(num(mask, 1))
	if mask < 1 or mask >= bit32.lshift(1, Config.MaxWeaponTier) then mask = 1 end
	mask = bit32.bor(mask, 1)
	S.PlayerService.SetStat(player, "WeaponOwnedMask", mask)
	if not owns(data, math.floor(num(data.WeaponTier, 1))) then S.PlayerService.SetStat(player, "WeaponTier", 1) end
	publish(player, data)
	return "ok"
end

return LootService
]]></ProtectedString>
				<string name="ScriptGuid">{263E1A6B-978F-4E4E-B9B7-8E7CD3A575FB}</string>
