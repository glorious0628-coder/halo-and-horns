					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Config</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1d3de94e0e66caa70ad7c7b40000088d</UniqueId>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX3829D661179841B7942E78CD51A63910">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">540d3fc5db7bff020ad0f369000003ba</UniqueId>
		</Properties>
		<Item class="ModuleScript" referent="RBXE07EA4FC3EB54687887B6F6FA3B952F9">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PetService.luau : pets (A23-39 now; PET-2 later adds levels / XP / EquipPet / the pet list remote).
-- Server-authoritative. Save (Config.Data.Defaults.Pets): List[uid] = { Sp, Lv, XP, Name, Lean, Bound },
-- Equipped = { uid } (one pet in the beta), Next = the next uid number. Every client sees only the attributes
-- EquippedPet (species id, "" = none), PetLv and PetForm ("" = the base look); the pet follows its owner on the clients
-- (PET-3, 게임성 개발 1). A pet is never a server object, so it is never a target of anything.
--
-- A23-39 pet tamer (Config.Tamer, Config.IsTamer = the artisan guild's Archer): the moment a player is a tamer (class
-- pick / class change / faction change, or a join as one) they get the baby slime once, equipped, Bound. A save that was
-- the artisan hunter before A23-39 gets one notice + one free class change ticket (TamerNotice, saved first).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local PetService = {}
local S = nil
local TAG = "PetService"
local TAMER = Config.Tamer
local TXT = TAMER.Text
-- species the beta knows (PET-2 moves this to Config.Pets); unknown saved species are kept but never equipped
local KNOWN = { [TAMER.Pet] = true }
local LIMIT = { MaxLv = 10, NameLen = 20, UidLen = 32, Pets = 64 }

PetService.PetGranted = Util.Signal.new() -- (player, uid, species): PET-6 announcements later

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return default or 0
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

local function notify(player, text, kind)
	if type(text) == "string" and text ~= "" then pcall(Net.Notify, player, text, kind or "info") end
end

------------------------------------------------------------------ data
-- repairs data.Pets in place (a corrupted entry is dropped; an unknown species is kept but never equipped)
function PetService.Sanitize(data)
	local pets = type(data.Pets) == "table" and data.Pets or {}
	local list, count = {}, 0
	if type(pets.List) == "table" then
		for uid, p in pets.List do
			if count < LIMIT.Pets and type(uid) == "string" and #uid >= 1 and #uid <= LIMIT.UidLen and type(p) == "table"
				and type(p.Sp) == "string" and #p.Sp >= 1 and #p.Sp <= LIMIT.UidLen then
				count += 1
				list[uid] = {
					Sp = p.Sp,
					Lv = math.clamp(math.floor(num(p.Lv, 1)), 1, LIMIT.MaxLv),
					XP = math.max(0, math.floor(num(p.XP, 0))),
					Name = type(p.Name) == "string" and string.sub(p.Name, 1, LIMIT.NameLen) or "",
					Lean = type(p.Lean) == "string" and string.sub(p.Lean, 1, LIMIT.NameLen) or "",
					Bound = p.Bound == true,
				}
			end
		end
	end
	local equipped = {}
	if type(pets.Equipped) == "table" then
		for _, uid in pets.Equipped do
			if #equipped < 1 and type(uid) == "string" and list[uid] and KNOWN[list[uid].Sp] then table.insert(equipped, uid) end
		end
	end
	data.Pets = { List = list, Equipped = equipped, Next = math.max(1, math.floor(num(pets.Next, 1))) }
	return data.Pets
end

-- PET-1: the walk speed follows the equipped pet (PlayerService.RefreshSpeed reads the attributes below)
local function refreshSpeed(player)
	local ps = S and S.PlayerService
	if type(ps) == "table" and type(ps.RefreshSpeed) == "function" then
		local ok, err = pcall(ps.RefreshSpeed, player)
		if not ok then Util.Warn(TAG, "RefreshSpeed: " .. tostring(err)) end
	end
end

-- the attributes every client reads (EquippedPet / PetLv / PetForm), then the walk speed
local function publish(player, data)
	local pets = data.Pets
	local uid = type(pets) == "table" and type(pets.Equipped) == "table" and pets.Equipped[1] or nil
	local p = uid and pets.List[uid] or nil
	player:SetAttribute("EquippedPet", p and p.Sp or "")
	player:SetAttribute("PetLv", p and p.Lv or 0)
	player:SetAttribute("PetForm", "")
	refreshSpeed(player)
end

local function findSpecies(pets, species)
	for uid, p in pets.List do
		if p.Sp == species then return uid end
	end
	return nil
end

------------------------------------------------------------------ A23-39 pet tamer
-- the tamer's baby slime: added once (an owned baby slime is never duplicated), equipped when nothing is. quiet = no
-- notice. Returns the new uid, or nil when the player already had one.
function PetService.GiveTamerPet(player, quiet)
	local data = getData(player)
	if not data then return nil end
	local pets = PetService.Sanitize(data)
	local have = findSpecies(pets, TAMER.Pet)
	if have then
		if #pets.Equipped == 0 then
			pets.Equipped = { have }
			publish(player, data)
		end
		return nil
	end
	local uid
	repeat -- never reuse a uid a kept (e.g. unknown-species) entry holds
		uid = "P" .. tostring(pets.Next)
		pets.Next += 1
	until pets.List[uid] == nil
	pets.List[uid] = { Sp = TAMER.Pet, Lv = 1, XP = 0, Name = "", Lean = "", Bound = true }
	if #pets.Equipped == 0 then pets.Equipped = { uid } end
	publish(player, data)
	if not quiet then notify(player, TXT.PetGot, "reward") end
	PetService.PetGranted:Fire(player, uid, TAMER.Pet)
	return uid
end

local function isTamer(player, data)
	return data.ClassChosen == true and Config.IsTamer(data.Class, data.Faction)
end

-- a join: a save that was the artisan hunter before A23-39 (a tamer without TamerNotice) gets the notice and one free
-- class change ticket, once (the flag is saved first); every tamer then gets the pet
local function onPlayerReady(player, data)
	data = type(data) == "table" and data or getData(player)
	if not data then return end
	PetService.Sanitize(data)
	publish(player, data)
	if not isTamer(player, data) then return end
	if data.TamerNotice ~= true then
		data.TamerNotice = true
		local m = S.MonetizationService
		if type(m) == "table" and type(m.AddTickets) == "function" then
			local ok, err = pcall(m.AddTickets, player, "Class", 1)
			if not ok then Util.Warn(TAG, "free class change ticket: " .. tostring(err)) end
		end
		-- below Lv FreeKeepLevelBelow the class window has no ticket button (a free change keeps the level anyway)
		notify(player, Config.ClassChangeKeepsLevel(data.Level) and TXT.BecameFree or TXT.Became, "reward")
	end
	PetService.GiveTamerPet(player)
end

-- becoming a tamer during a session (class pick / class change / faction change): chosen now, so no notice ticket
local function onBecame(player)
	if not S.PlayerService.IsReady(player) then return end
	local data = getData(player)
	if not data or not isTamer(player, data) then return end
	data.TamerNotice = true
	PetService.GiveTamerPet(player)
end

------------------------------------------------------------------ the models the clients draw (PET-3)
-- ServerStorage.CustomModels.Pet<species> -> ReplicatedStorage.PetModels.<species>, once at Start (a missing model is
-- skipped; every script inside the copy is removed). The PET-3 follower (게임성 개발 1) clones from PetModels.
local SCRIPT_CLASSES = { Script = true, LocalScript = true, ModuleScript = true }
function PetService.PublishModels()
	local custom = ServerStorage:FindFirstChild("CustomModels")
	if not custom then return 0 end
	local folder = ReplicatedStorage:FindFirstChild("PetModels")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "PetModels"
		folder.Parent = ReplicatedStorage
	end
	local made = 0
	for species in KNOWN do
		local src = custom:FindFirstChild("Pet" .. species)
		if src and not folder:FindFirstChild(species) then
			local ok, copy = pcall(function() return src:Clone() end)
			if ok and copy then
				for _, d in copy:GetDescendants() do
					if SCRIPT_CLASSES[d.ClassName] then d:Destroy() end
				end
				copy.Name = species
				copy.Parent = folder
				made += 1
			end
		end
	end
	return made
end

------------------------------------------------------------------ lifecycle
function PetService.Init(registry)
	S = registry
end

local function connect(serviceName, signalName, fn)
	local svc = S[serviceName]
	local sig = svc and svc[signalName]
	if type(sig) == "table" and type(sig.Connect) == "function" then
		sig:Connect(function(...)
			local ok, err = pcall(fn, ...)
			if not ok then Util.Warn(TAG, signalName .. ": " .. tostring(err)) end
		end)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function PetService.Start()
	local ok, err = pcall(PetService.PublishModels)
	if not ok then Util.Warn(TAG, "PublishModels: " .. tostring(err)) end
	connect("PlayerService", "PlayerReady", onPlayerReady)
	connect("ClassService", "ClassChanged", function(player) onBecame(player) end)
	connect("FactionService", "FactionChanged", function(player) onBecame(player) end)
	print("[PetService] started")
end

return PetService
]]></ProtectedString>
				<string name="ScriptGuid">{637F6802-F59D-4A92-A3A1-551C294EEA02}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PetService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e53000008bd</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXC72DC5D961EC4AA7914AB201E2813AFC">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- AnnounceService.luau : A23-15 "좋은 것 전체 채팅 알림" (design skills_weapons_pets §0-3, P5 name hiding).
-- The server only sends { Key, Args, Grade, Self? } to every client (remote "Announce"); each client formats the line
-- from Config.Announce.Text in its own language and shows it as a TextChatService system message in RBXGeneral.
-- Names are the game nickname (Util.PlayerDisplayName, filtered); a player can hide it (data.HideAnnounceName ->
-- "빛의 기사단 한 명이…"). RareWeapon lines within WindowSeconds of one player are grouped (same or lower grade than
-- the opening line) into one "…좋은 것을 N개 더" line; jackpots, the first +10 and higher grades always show by name.
-- Broadcast(key) sends a server event line with no finder (Config.Announce.Events, e.g. the Pumpkin King) to everyone.
-- PublicName(player, honorific) (BB37) is the name every other server-wide line uses (NotifyAll, board, rankings).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local AnnounceService = {}
local S = nil
local TAG = "AnnounceService"
local A = Config.Announce
local window = {} -- [player] = { SentAt, OpenRank, Pending, Best, Grade, Token }

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

-- P5 / BB37: the saved choice first, the mirrored attribute while the data is not loaded
local function isHidden(player)
	local data = getData(player)
	if data ~= nil then return data.HideAnnounceName == true end
	return player:GetAttribute("HideAnnounceName") == true
end

-- BB37: the ONE name for every line that reaches the whole server (NotifyAll lines, the town board, ranking rows).
-- Shown: the game nickname (Util.PlayerDisplayName), + Text.Honorific ("님") when honorific is true. Hidden
-- (data.HideAnnounceName): "<faction> 한 명" (Text.HiddenName) with or without honorific, so "%s이" reads right both
-- ways ("OO님이" / "빛의 기사단 한 명이"). Same-server nametags and the Tab list are not covered (players see each other).
function AnnounceService.PublicName(player, honorific)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then return "" end
	local T = A.Text
	if isHidden(player) then
		local id = player:GetAttribute("Faction")
		local f = id ~= "None" and Config.Factions[id] or nil -- no faction yet: "누군가"
		return f and string.format(T.HiddenName, f.Name) or T.Someone
	end
	return Util.PlayerDisplayName(player) .. (honorific == true and T.Honorific or "")
end

-- BB37: true when this player's server-wide lines use "<faction> 한 명" (the bounty line picks its hidden variant)
function AnnounceService.IsHidden(player)
	return typeof(player) == "Instance" and player:IsA("Player") and isHidden(player)
end

local function who(player)
	local hidden = isHidden(player)
	local faction = player:GetAttribute("Faction")
	return {
		Who = hidden and "" or Util.PlayerDisplayName(player),
		Hidden = hidden,
		Faction = type(faction) == "string" and faction or "None",
		Class = (function()
			local ok, c = pcall(S.ClassService.GetClass, player)
			return ok and c or "Warrior"
		end)(),
	}
end

-- everyone gets the line; the finder's copy says Self = true (chat line only, no second toast for them). No UserId
-- is ever sent, so a hidden name cannot be recovered by another client (review of 0db0764).
local function send(player, key, args, grade)
	local payload = who(player)
	for k, v in args or {} do payload[k] = v end
	local msg = { Key = key, Args = payload, Grade = grade }
	local mine = { Key = key, Args = payload, Grade = grade, Self = true }
	pcall(function()
		local remote = Net.Get("Announce")
		for _, p in Players:GetPlayers() do
			remote:FireClient(p, p == player and mine or msg)
		end
	end)
end

local function gradeRank(grade)
	local g = Config.WeaponGrades and Config.WeaponGrades[grade]
	return g and g.Rank or 0
end

-- one table per player: SentAt / OpenRank of the line that opened the window, Pending grouped RareWeapon lines
local function state(player)
	local w = window[player]
	if not w then
		w = { SentAt = -math.huge, OpenRank = 0, Pending = 0, Best = 0, Grade = nil, Token = 0 }
		window[player] = w
	end
	return w
end

local function flush(player, w)
	if w.Pending <= 0 or player.Parent ~= Players then
		w.Pending, w.Best = 0, 0
		return
	end
	local n, grade = w.Pending, w.Grade
	w.Pending, w.Best = 0, 0
	send(player, "More", { Count = n }, grade)
end

-- key: Config.Announce.Text key; args: plain values only (numbers / strings / booleans); grade: Config.WeaponGrades id.
-- Only RareWeapon lines of the same or a lower grade than the line that opened the 10 s window are grouped into one
-- "…좋은 것을 N개 더" line; Jackpot, FirstMax and higher grades always go out at once with their own text.
function AnnounceService.Announce(player, key, args, grade)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then return end
	if type(A) ~= "table" or type(A.Text) ~= "table" or A.Text[key] == nil then return end
	local now = os.clock()
	local w = state(player)
	local rank = gradeRank(grade)
	if key == "RareWeapon" and now - w.SentAt < A.WindowSeconds and rank <= w.OpenRank then
		w.Pending += 1
		if rank > w.Best then w.Best, w.Grade = rank, grade end
		local token = w.Token
		task.delay(math.max(0, A.WindowSeconds - (now - w.SentAt)), function()
			if window[player] == w and w.Token == token then flush(player, w) end
		end)
		return
	end
	flush(player, w) -- anything grouped so far goes out first (never lost when a new window opens)
	w.Token += 1
	w.SentAt, w.OpenRank = now, rank
	send(player, key, args, grade)
end

-- server-wide event line with no finder (Config.Announce.Events[key], e.g. the Pumpkin King): every client gets
-- { Key, Args, Event = true } and shows it at once in its own language. Never grouped and never carries a name.
-- args: optional plain values (numbers / strings / booleans).
function AnnounceService.Broadcast(key, args)
	if type(A) ~= "table" or type(A.Text) ~= "table" or type(A.Text[key]) ~= "string" then return end
	if type(A.Events) ~= "table" or A.Events[key] == nil then return end
	local payload = {}
	if type(args) == "table" then
		for k, v in args do
			local t = type(v)
			if type(k) == "string" and (t == "string" or t == "number" or t == "boolean") then payload[k] = v end
		end
	end
	pcall(function()
		Net.Get("Announce"):FireAllClients({ Key = key, Args = payload, Event = true })
	end)
end

local function onSetName(player, hide, ...)
	if select("#", ...) ~= 0 or type(hide) ~= "boolean" then return end
	if not S.PlayerService.IsReady(player) or not Util.RateLimit(player, "SetAnnounceName", Config.RateLimits.SetAnnounceName or 0.5) then return end
	S.PlayerService.SetStat(player, "HideAnnounceName", hide)
	pcall(Net.Notify, player, hide and A.Text.NameHidden or A.Text.NameShown, "info")
	-- BB10: ranking rows follow the choice at once (every board row is rewritten with the hidden flag)
	local ranking = S.RankingService
	if type(ranking) == "table" and type(ranking.MarkHideChanged) == "function" then
		pcall(ranking.MarkHideChanged, player)
	end
end

function AnnounceService.Init(registry)
	S = registry
end

function AnnounceService.Start()
	Net.Get("SetAnnounceName").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onSetName, player, ...)
		if not ok then Util.Warn(TAG, "SetAnnounceName: " .. tostring(err)) end
	end)
	Players.PlayerRemoving:Connect(function(player) window[player] = nil end)
	print("[AnnounceService] started")
end

return AnnounceService
]]></ProtectedString>
				<string name="ScriptGuid">{6B9AB08D-53D7-4A10-9B73-BB60C7413F09}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">AnnounceService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c0500000893</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX014EAD673A06462C8C3FEB877E15CE53">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- JusticeService.luau : Size Justice ("덩치 저울"): faction power sums, per-faction S, bully stacks + decay,
-- and the smooth character scale lerp. The ONLY service that scales characters (always via Util.SafeScaleTo).
-- Addendum A6: "Neutral" players are excluded from power sums / ratios and their S is always 1.0.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "JusticeService"
local DECAY_TICK = 1 -- bully decay loop interval (spec §4.12)
local SCALE_EPSILON = 0.005 -- lerp stops when this close to the target
local S_EPSILON = 0.001 -- a faction S change smaller than this does not refresh characters
local MIN_SCALE = 0.1 -- safety floor for Model:ScaleTo
local SCALE_RETRY_SECONDS = 2 -- after a failed ScaleTo, wait this long before trying that character again
local LEAVE_FORGET_SECONDS = 60
local WARN_THROTTLE = 10
local PIVOT_HEIGHT_AT_SCALE_1 = 3 -- approx. root-center height above the feet for R6 and R15 at scale 1
-- CR-M20: who adds power to the faction sums (everyone still gets their side's S)
local COUNT_RULE = {
	IdleSeconds = 120, -- no input / combat for this long (PlayerService.GetLastActive) = not counted
	TownSeconds = 60, -- standing in a town for this long = not counted
}

local JusticeService = {}

local S = nil
local scaleOf = { Halo = 1, Horns = 1 } -- current S per combat faction
local weakerFaction = "None"
local leaving = {} -- [Player] = true while leaving (excluded from sums)
local lastAppliedS = {} -- [Player] = S last pushed to SizeMult / RefreshCharacter
local lastFaction = {} -- [Player] = faction at the last recompute pass
local targets = {} -- [Player] = last computed visual scale target
local bully = {} -- [Player] = { Stacks: number, Last: number (os.clock) }
local townSince = {} -- [Player] = os.clock() when the player entered a town (nil outside towns), CR-M20
local hipBase = setmetatable({}, { __mode = "k" }) -- [Character] = R15 HipHeight at scale 1
local scaleFailUntil = setmetatable({}, { __mode = "k" }) -- [Character] = os.clock()
local recomputePending = false
local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function round2(x)
	return math.floor(x * 100 + 0.5) / 100
end

local function factionOf(player)
	if S and S.FactionService and S.FactionService.GetFaction then
		return S.FactionService.GetFaction(player)
	end
	local f = player and player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function kaijuState(player)
	local k = S and S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

-- only Halo / Horns can be bullies (A6: Neutral never gets bully stacks; "None" has not picked a side)
local function isFighterFaction(factionId)
	return factionId == "Halo" or factionId == "Horns"
end

local function computeTarget(player)
	local s = JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
	if kaijuState(player) == "Active" then
		s *= Config.Kaiju.VisualScale
	end
	return math.max(MIN_SCALE, math.min(Config.Justice.MaxVisualScale, s))
end

local function writeVisualScale(player, scale)
	local v = round2(scale)
	if player:GetAttribute("VisualScale") ~= v then
		player:SetAttribute("VisualScale", v)
	end
end

-- R15 hover height does not follow the body when scaled at runtime; keep it proportional (no-op if ScaleTo did it).
local function fixHipHeight(character, scale)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local base = hipBase[character]
	if not base or base <= 0 then return end
	local want = base * scale
	if math.abs(hum.HipHeight - want) > 0.01 then
		hum.HipHeight = want
	end
end

local function rememberHipBase(character)
	if hipBase[character] then return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local cur = character:GetScale()
	if cur > 0 then
		hipBase[character] = hum.HipHeight / cur
	end
end

-- applies `scale` to the character; returns true on success
local function applyScale(character, scale)
	local blockedUntil = scaleFailUntil[character]
	if blockedUntil and os.clock() < blockedUntil then return false end
	if Util.SafeScaleTo(character, scale) then
		fixHipHeight(character, scale)
		return true
	end
	scaleFailUntil[character] = os.clock() + SCALE_RETRY_SECONDS
	return false
end

local function requestRecompute()
	if recomputePending then return end
	recomputePending = true
	task.defer(function()
		recomputePending = false
		local ok, err = pcall(JusticeService.Recompute)
		if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
	end)
end

local function clearPlayer(player)
	lastAppliedS[player] = nil
	lastFaction[player] = nil
	targets[player] = nil
	bully[player] = nil
	townSince[player] = nil
end

-- CR-M20: keep townSince in step with the zone (also covers spawning in Crossroads, which fires no ZoneChanged)
local function syncTown(player, now)
	local zs = S and S.ZoneService
	if not zs or not zs.IsTown then return end
	local ok, inTown = pcall(zs.IsTown, player)
	if not ok then return end
	if inTown == true then
		townSince[player] = townSince[player] or now
	else
		townSince[player] = nil
	end
end

-- CR-M20: rookies, 120 s idlers and 60 s town loiterers add no power to the faction sums
local function countsForSums(player, now)
	syncTown(player, now)
	local pvp = S.PvPService
	if pvp and pvp.IsRookie then
		local ok, rookie = pcall(pvp.IsRookie, player)
		if ok and rookie == true then return false end
	end
	local ps = S.PlayerService
	if ps.GetLastActive then
		local ok, t = pcall(ps.GetLastActive, player)
		if ok and type(t) == "number" and now - t > COUNT_RULE.IdleSeconds then return false end
	end
	local since = townSince[player]
	return not (since and now - since >= COUNT_RULE.TownSeconds)
end

-- level, equipped weapon tier and its scroll +N (review B5: the server-written WeaponEnhance attribute;
-- Config.EnhanceMult clamps it to 0..Config.Loot.MaxEnhance and treats a missing value as +0)
local function levelAndTier(player)
	local level = math.max(1, tonumber(player:GetAttribute("Level")) or 1)
	local tier = math.clamp(math.floor(tonumber(player:GetAttribute("WeaponTier")) or 0), 0, Config.MaxWeaponTier) -- A23-34: 0 = bare hands
	local enhance = tonumber(player:GetAttribute("WeaponEnhance")) or 0
	return level, tier, enhance
end

------------------------------------------------------------------ public API
-- faction-sum power (includes the rebirth bonus)
function JusticeService.GetPower(player)
	if not player then return 0 end
	local level, tier, enhance = levelAndTier(player)
	local rebirthBonus = tonumber(player:GetAttribute("RebirthBonus")) or 0
	return Config.PowerOf(level, tier, 1 + rebirthBonus, enhance)
end

-- BB4 "전투력" (integer, Config.CombatPower): the weak-victim (bully) rule and the boldness ratios compare it.
-- CR-L5: the rebirth bonus is gold / XP only, so it is left out
function JusticeService.GetCombatPower(player)
	if not player then return 0 end
	local level, tier, enhance = levelAndTier(player)
	return Config.CombatPower(level, tier, enhance)
end

-- BB4: the CombatPower attribute follows Level / WeaponTier / WeaponEnhance. One deferred refresh per frame, because
-- LootService writes WeaponEnhance right after WeaponTier (an equip changes the attribute exactly once).
local POWER = { Conns = {}, Pending = {} }

function POWER.Refresh(player)
	POWER.Pending[player] = nil
	if player.Parent == nil or not POWER.Conns[player] then return end
	local n = JusticeService.GetCombatPower(player)
	if player:GetAttribute("CombatPower") ~= n then player:SetAttribute("CombatPower", n) end
end

function POWER.Schedule(player)
	if POWER.Pending[player] then return end
	POWER.Pending[player] = true
	task.defer(POWER.Refresh, player)
end

function POWER.Drop(player)
	for _, c in POWER.Conns[player] or {} do c:Disconnect() end
	POWER.Conns[player], POWER.Pending[player] = nil, nil
end

function POWER.Watch(player)
	POWER.Drop(player)
	local list = {}
	for _, attr in { "Level", "WeaponTier", "WeaponEnhance" } do
		table.insert(list, player:GetAttributeChangedSignal(attr):Connect(function() POWER.Schedule(player) end))
	end
	POWER.Conns[player] = list
	POWER.Refresh(player)
end

-- 1 for "None" and "Neutral" (A6)
function JusticeService.GetFactionScale(factionId)
	if factionId == "Halo" or factionId == "Horns" then
		return scaleOf[factionId] or 1
	end
	return 1
end

function JusticeService.GetWeakerFaction()
	return weakerFaction
end

function JusticeService.GetDamageMult(player)
	return JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
end

function JusticeService.GetHealthMult(player)
	local mult = JusticeService.GetFactionScale(factionOf(player))
	local k = S and S.KaijuService
	if k and k.GetHealthMult then
		local ok, km = pcall(k.GetHealthMult, player)
		if ok and type(km) == "number" and km > 0 then
			mult *= km
		end
	end
	return mult
end

function JusticeService.GetBullyStacks(player)
	local b = player and bully[player]
	return b and b.Stacks or 0
end

-- A23-22: os.time() when the last stack decays (0 = no penalty); the HUD shows "(N분)" from it.
-- The BullyStacks attribute and this one are written together through publishBully.
local function publishBully(player, b)
	local stacks = b and b.Stacks or 0
	local endsAt = 0
	if stacks > 0 then
		local period = math.max(1, tonumber(Config.Bully.DecaySeconds) or 300)
		local left = (stacks - 1) * period + math.max(0, period - (os.clock() - b.Last))
		endsAt = os.time() + math.ceil(left)
	end
	player:SetAttribute("BullyStacks", stacks)
	player:SetAttribute("BullyEndsAt", endsAt)
end

function JusticeService.AddBullyStack(player)
	if not player then return 0 end
	if not isFighterFaction(factionOf(player)) then return 0 end -- A6: Neutral / None never become bullies
	local b = bully[player]
	if not b then
		b = { Stacks = 0, Last = os.clock() }
		bully[player] = b
	end
	b.Stacks = math.min(Config.Bully.MaxStacks, b.Stacks + 1)
	b.Last = os.clock()
	publishBully(player, b)
	JusticeService.RefreshScale(player)
	return b.Stacks
end

-- recompute this player's visual scale target now (the scale loop moves the character toward it)
function JusticeService.RefreshScale(player)
	if not player then return end
	targets[player] = computeTarget(player)
end

function JusticeService.Recompute()
	if not S then return end
	local now = os.clock()
	local haloSum, hornsSum, haloCount, hornsCount = 0, 0, 0, 0
	local entries = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = factionOf(p)
			-- CR-M20: excluded players still get an entry below (and so their side's S)
			if (f == "Halo" or f == "Horns") and countsForSums(p, now) then
				local ok, power = pcall(JusticeService.GetPower, p)
				power = (ok and type(power) == "number") and power or 0
				if f == "Halo" then
					haloSum += power
					haloCount += 1
				else
					hornsSum += power
					hornsCount += 1
				end
			end
			table.insert(entries, { Player = p, Faction = f })
		end
	end

	local sHalo, sHorns = 1, 1
	if haloCount >= 1 and hornsCount >= 1 then
		sHalo = Config.SizeJustice(haloSum, hornsSum)
		sHorns = Config.SizeJustice(hornsSum, haloSum)
	end
	scaleOf.Halo, scaleOf.Horns = sHalo, sHorns

	-- an empty faction counts as 0; "None" if both sums are 0 or equal
	if (haloSum == 0 and hornsSum == 0) or haloSum == hornsSum then
		weakerFaction = "None"
	elseif haloSum < hornsSum then
		weakerFaction = "Halo"
	else
		weakerFaction = "Horns"
	end

	local gs = Net.GameState()
	gs:SetAttribute("HaloPower", math.floor(haloSum + 0.5))
	gs:SetAttribute("HornsPower", math.floor(hornsSum + 0.5))
	gs:SetAttribute("HaloSize", round2(sHalo))
	gs:SetAttribute("HornsSize", round2(sHorns))
	gs:SetAttribute("WeakerFaction", weakerFaction)

	for _, e in entries do
		local p, f = e.Player, e.Faction
		local s = JusticeService.GetFactionScale(f)
		local prev = lastAppliedS[p]
		if lastFaction[p] ~= f or prev == nil or math.abs(prev - s) > S_EPSILON then
			lastAppliedS[p] = s
			lastFaction[p] = f
			local ok, err = pcall(function()
				p:SetAttribute("SizeMult", round2(s))
				S.PlayerService.RefreshCharacter(p, false) -- HP % preserved
				JusticeService.RefreshScale(p)
			end)
			if not ok then warnThrottled("apply", "apply S failed: " .. tostring(err)) end
		end
	end
end

------------------------------------------------------------------ subscriptions
-- CR-M12: bring back the stacks saved at the last leave, minus the decay that would have happened meanwhile
local function restoreBully(player, data)
	if type(data) ~= "table" then return end
	local saved = math.floor(tonumber(data.SavedBully) or 0)
	local at = tonumber(data.SavedBullyAt) or 0
	-- one-shot: a crash before the next leave must not bring them back a second time
	data.SavedBully, data.SavedBullyAt = 0, 0
	if saved <= 0 or at <= 0 then return end
	if not isFighterFaction(data.Faction) then return end -- A6: only Halo / Horns carry stacks
	local period = math.max(1, tonumber(Config.Bully.DecaySeconds) or 300)
	local elapsed = math.max(0, os.time() - at)
	local decayed = math.floor(elapsed / period)
	local stacks = math.min(Config.Bully.MaxStacks, saved - decayed)
	if stacks <= 0 then return end
	-- keep the running decay period: the next stack drops `period` after the last drop, not after the join
	bully[player] = { Stacks = stacks, Last = os.clock() - (elapsed - decayed * period) }
	publishBully(player, bully[player])
	JusticeService.RefreshScale(player)
end

local function onPlayerReady(player, data)
	leaving[player] = nil
	clearPlayer(player)
	player:SetAttribute("SizeMult", 1)
	player:SetAttribute("BullyStacks", 0)
	player:SetAttribute("BullyEndsAt", 0)
	player:SetAttribute("VisualScale", 1)
	local ok, err = pcall(restoreBully, player, data)
	if not ok then warnThrottled("bullyrestore", "bully restore failed: " .. tostring(err)) end
	POWER.Watch(player)
	requestRecompute()
end

local function onPlayerLeaving(player, data)
	leaving[player] = true
	POWER.Drop(player)
	-- CR-M12: save the stacks; SavedBullyAt = os.time() of the start of the running decay period
	if type(data) == "table" then
		local b = bully[player]
		local stacks = JusticeService.GetBullyStacks(player)
		local into = (stacks > 0 and b) and math.floor(math.max(0, os.clock() - b.Last)) or 0
		data.SavedBully = stacks
		data.SavedBullyAt = os.time() - into
	end
	requestRecompute()
	-- CR-L1: later PlayerLeaving handlers (PvP bounty CR-M11) still read the stacks; clear after them
	task.defer(clearPlayer, player)
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

-- CR-M20: town entry time (the 60 s town rule); leaving a town or crossing the 60 s mark re-weighs the sums
local function onZoneChanged(player, newZoneId)
	if not player or leaving[player] then return end
	local zone = Config.Zones[newZoneId]
	if zone and zone.Town == true then
		if townSince[player] then return end -- town to town keeps the clock
		local t = os.clock()
		townSince[player] = t
		task.delay(COUNT_RULE.TownSeconds + 0.5, function()
			if townSince[player] == t then requestRecompute() end
		end)
	else
		local was = townSince[player]
		townSince[player] = nil
		if was and os.clock() - was >= COUNT_RULE.TownSeconds then requestRecompute() end
	end
end

-- fresh characters start at scale 1: snap straight to the target (no lerp)
local function onCharacterSpawned(player, character)
	if not player or not character or not character.Parent then return end
	if player.Character ~= character then return end
	rememberHipBase(character)
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	if math.abs(target - cur) > SCALE_EPSILON and applyScale(character, target) then
		if target > cur then
			-- CR-H2: a server-side move; the spawn grace (not the shorter default) so ZoneService's own one is not cut
			local zs = S and S.ZoneService
			if zs and zs.MarkTeleported then
				local ac = Config.AntiCheat
				pcall(zs.MarkTeleported, player, (ac and tonumber(ac.SpawnGrace)) or 2)
			end
			-- ScaleTo keeps the pivot (root) in place, so the longer legs would start inside the floor: lift by the growth
			pcall(function()
				character:PivotTo(character:GetPivot() + Vector3.new(0, (target - cur) * PIVOT_HEIGHT_AT_SCALE_1, 0))
			end)
		end
		cur = target
	end
	writeVisualScale(player, cur)
end

------------------------------------------------------------------ loops
local function scaleStep(player, step)
	if not Util.IsAlive(player) then return end
	local character = Util.GetCharacter(player)
	if not character then return end
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	local diff = target - cur
	if math.abs(diff) <= SCALE_EPSILON then
		writeVisualScale(player, cur)
		return
	end
	rememberHipBase(character)
	local new = cur + math.clamp(diff, -step, step)
	if applyScale(character, new) then
		writeVisualScale(player, new)
	end
end

local function decayStep(player, b)
	if b.Stacks <= 0 then return end
	if os.clock() - b.Last < Config.Bully.DecaySeconds then return end
	b.Stacks -= 1
	b.Last = os.clock()
	if player.Parent ~= Players then return end
	publishBully(player, b)
	Net.Notify(player, string.format(Config.Text.BullyDecay, b.Stacks), "info")
	JusticeService.RefreshScale(player)
end

function JusticeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player, newFaction)
			-- A6: a bully who switches to Neutral (altar / rebirth) sheds the stacks at once
			-- (no shrink, no -15% damage, no "깡패" tag); Halo <-> Horns keeps them.
			-- CR-L9: the altar and rebirth refuse Neutral while stacks remain, so this is only a safety net
			if player and not isFighterFaction(newFaction) then
				local had = bully[player] ~= nil or (tonumber(player:GetAttribute("BullyStacks")) or 0) > 0
				bully[player] = nil
				if had then
					local ok, err = pcall(function()
						publishBully(player, nil)
						JusticeService.RefreshScale(player)
					end)
					if not ok then warnThrottled("bullyclear", "bully clear failed: " .. tostring(err)) end
				end
			end
			requestRecompute()
		end)
	end
	if S.ClassService and S.ClassService.ClassChanged then
		S.ClassService.ClassChanged:Connect(function()
			requestRecompute()
		end)
	end
	if S.ProgressionService and S.ProgressionService.Rebirthed then
		S.ProgressionService.Rebirthed:Connect(function()
			requestRecompute()
		end)
	end
	if S.ZoneService and S.ZoneService.ZoneChanged then
		S.ZoneService.ZoneChanged:Connect(onZoneChanged) -- CR-M20
	end
	-- players removed before they were ever ready never fire PlayerLeaving
	-- CR-L1: a ready player is cleared by onPlayerLeaving (deferred, after the other leave handlers)
	Players.PlayerRemoving:Connect(function(player)
		if not S.PlayerService.IsReady(player) then
			clearPlayer(player)
		end
	end)
end

function JusticeService.Start()
	-- periodic recompute
	task.spawn(function()
		while true do
			task.wait(Config.Justice.RecalcInterval)
			local ok, err = pcall(JusticeService.Recompute)
			if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
		end
	end)

	-- smooth scale lerp
	task.spawn(function()
		local interval = Config.Justice.ScaleTick
		local step = Config.Justice.ScaleRatePerSec * interval -- max scale change per tick
		while true do
			task.wait(interval)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(scaleStep, p, step)
				if not ok then warnThrottled("scale", "scale step failed: " .. tostring(err)) end
			end
		end
	end)

	-- bully stack decay
	task.spawn(function()
		while true do
			task.wait(DECAY_TICK)
			for p, b in bully do
				local ok, err = pcall(decayStep, p, b)
				if not ok then warnThrottled("decay", "bully decay failed: " .. tostring(err)) end
			end
		end
	end)

	requestRecompute()
	print("[JusticeService] started")
end

return JusticeService
]]></ProtectedString>
				<string name="ScriptGuid">{76E7E424-6724-4F69-B2A1-F3A5FB5E0DF8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">JusticeService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050001b0ee</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXA0513CD4DF214030997EAC6AE0E797AE">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ClassService.luau : first class pick (free, keeps level) and class change. A23-14: below
-- Config.ClassChange.FreeKeepLevelBelow (Lv 5) a free change keeps level and XP (no ticket is ever spent there);
-- from that level on: free = back to Lv 1 / XP 0, change ticket = level kept.
-- Class ids: "Warrior", "Mage", "Archer". Display names depend on the faction (incl. "Neutral", addendum A6)
-- and always go through Config.ClassName.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "ClassService"

local ClassService = {}

ClassService.ClassChanged = Util.Signal.new() -- (player, newClass, oldClass)

local S = nil

------------------------------------------------------------------ helpers
local function isClassId(id)
	if type(id) ~= "string" then return false end
	local def = Config.Classes[id]
	return type(def) == "table" and def.Id == id
end

local function notify(player, key, kind, ...)
	local fmt = Config.Text[key]
	if type(fmt) ~= "string" then return end
	Net.Notify(player, string.format(fmt, ...), kind)
end

local function factionOf(player)
	return S.FactionService.GetFaction(player)
end

local function kaijuState(player)
	local k = S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function isClassChosen(player)
	local data = S.PlayerService.GetData(player)
	if data and type(data.ClassChosen) == "boolean" then return data.ClassChosen end
	return player:GetAttribute("ClassChosen") == true
end

-- saved level (data first, attribute as fallback); always an integer >= 1
local function currentLevel(player)
	local data = S.PlayerService.GetData(player)
	local lv = data and tonumber(data.Level)
	if lv == nil then lv = tonumber(player:GetAttribute("Level")) end
	if lv == nil or lv ~= lv or lv == math.huge or lv == -math.huge then return 1 end
	return math.max(1, math.floor(lv))
end

-- A23-14: true when a free class change at the player's level keeps the level (Lv < FreeKeepLevelBelow)
local function freeKeepsLevel(player)
	return Config.ClassChangeKeepsLevel(currentLevel(player)) == true
end

------------------------------------------------------------------ public API
function ClassService.GetClass(player)
	if not player then return "Warrior" end
	local c = player:GetAttribute("Class")
	if isClassId(c) then return c end
	return "Warrior"
end

function ClassService.GetClassDef(player)
	return Config.Classes[ClassService.GetClass(player)] or Config.Classes.Warrior
end

------------------------------------------------------------------ remotes
-- first pick: free and keeps the level (also the one-time pick for data migrated from v1)
local function onChooseClass(player, classId, gender)
	if not S.PlayerService.IsReady(player) then return end
	if not isClassId(classId) then return end
	if gender ~= nil and gender ~= "M" and gender ~= "F" then return end
	if not Util.RateLimit(player, "ChooseClass", Config.RateLimits.ChooseClass) then return end
	if isClassChosen(player) then return end -- silent
	local faction = factionOf(player)
	if faction == "None" then
		notify(player, "NeedFaction", "bad")
		return
	end

	local old = ClassService.GetClass(player)
	if gender ~= nil then S.PlayerService.SetStat(player, "CharacterGender", gender) end
	S.PlayerService.SetStat(player, "Class", classId)
	S.PlayerService.SetStat(player, "ClassChosen", true)
	S.PlayerService.RefreshCharacter(player, true)
	ClassService.ClassChanged:Fire(player, classId, old) -- also when equal, so visuals / charge refresh
	notify(player, "ClassChosen", "good", Config.ClassName(classId, faction))
end

local function onChangeClass(player, classId, useTicket, gender)
	if not S.PlayerService.IsReady(player) then return end
	if not isClassId(classId) or type(useTicket) ~= "boolean" then return end
	if gender ~= nil and gender ~= "M" and gender ~= "F" then return end
	if not Util.RateLimit(player, "ChangeClass", Config.RateLimits.ChangeClass) then return end
	if not isClassChosen(player) then return end -- silent
	if classId == ClassService.GetClass(player) then
		notify(player, "ClassSame", "bad")
		return
	end
	if not Util.IsAlive(player) then return end -- silent
	if S.ZoneService.IsPvPZone(player) then
		notify(player, "ClassNeedSafe", "bad")
		return
	end
	if S.GrudgeService.HasSack(player) then
		notify(player, "BlockedSack", "bad")
		return
	end
	if kaijuState(player) ~= "None" then
		notify(player, "BlockedKaiju", "bad")
		return
	end
	-- Config.PvP.CombatTagTime "blocks travel/switch/class change" (+ addendum A7-4 not-in-combat for both paths):
	-- prevents a mid-fight full heal through RefreshCharacter(full).
	if S.CombatService.IsInCombat(player) then
		notify(player, "TravelBlockedCombat", "bad")
		return
	end
	-- A23-14: below Lv FreeKeepLevelBelow the free change already keeps everything, so a ticket request is served
	-- as a free change and the ticket is NOT spent (a paid ticket must never buy nothing).
	local keepLevel = freeKeepsLevel(player)
	if keepLevel then useTicket = false end
	if useTicket then
		local okTicket, why = S.MonetizationService.UseTicket(player, "Class")
		if not okTicket then
			-- CR-L25: a purchase still being saved is not "no ticket"
			notify(player, why == "Pending" and "TicketSaving" or "NoTicket", "bad")
			return
		end
	end

	local old = ClassService.GetClass(player)
	if gender ~= nil then S.PlayerService.SetStat(player, "CharacterGender", gender) end
	S.PlayerService.SetStat(player, "Class", classId)
	if not useTicket and not keepLevel then
		-- free from Lv FreeKeepLevelBelow on: Level 1, XP 0 (gold, bank, weapons, enhancement, items, rebirth bonus,
		-- marks, tickets, quests are kept). After the new class is set, so LevelReset listeners see it (A23-28: the
		-- weapon fit notice names the new class's weapon)
		S.ProgressionService.ResetLevel(player)
	end
	-- review (A23-14): a keep-level change below Lv5 costs nothing, so it must not be a free full heal either
	-- (Warrior -> Mage -> Warrior mid-hunt). It keeps the HP fraction; the paid / level-losing paths still heal fully.
	S.PlayerService.RefreshCharacter(player, not keepLevel)
	ClassService.ClassChanged:Fire(player, classId, old)
	local name = Config.ClassName(classId, factionOf(player))
	if keepLevel then
		local below = math.floor(tonumber(Config.ClassChange.FreeKeepLevelBelow) or 0)
		notify(player, "ClassChangedFreeKeep", "good", name, below)
	else
		notify(player, useTicket and "ClassChangedTicket" or "ClassChangedFree", "good", name)
	end
end

------------------------------------------------------------------ lifecycle
local function onPlayerReady(player, data)
	-- repair a corrupted stored class silently (GetClass already falls back to Warrior)
	local c = data and data.Class
	if not isClassId(c) then
		Util.Warn(TAG, "invalid stored class " .. tostring(c) .. " for " .. player.Name .. "; reset to Warrior")
		S.PlayerService.SetStat(player, "Class", "Warrior")
	end
end

function ClassService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
end

function ClassService.Start()
	Net.Get("ChooseClass").OnServerEvent:Connect(onChooseClass)
	Net.Get("ChangeClass").OnServerEvent:Connect(onChangeClass)
	print("[ClassService] started")
end

return ClassService
]]></ProtectedString>
				<string name="ScriptGuid">{3028A566-21D8-44FD-9C0C-8DC542418E8B}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
