	["Spine01"] = { r = { -0.0535,-0.0111,0.0141,0.9984,-0.0537,-0.0127,0.0124,0.9984,-0.0528,-0.0173,0.0095,0.9984,-0.0515,-0.0214,0.0095,0.9984,-0.0507,-0.0246,0.01,0.9984,-0.0465,-0.0266,0.0093,0.9985,-0.0445,-0.0246,0.0079,0.9987,-0.0452,-0.0191,0.0078,0.9988,-0.0471,-0.0122,0.0083,0.9988,-0.0496,-0.0046,0.0091,0.9987,-0.0517,0.0029,0.0098,0.9986,-0.0516,0.0085,0.0103,0.9986,-0.0505,0.013,0.0108,0.9986,-0.0489,0.0164,0.0117,0.9986,-0.0473,0.0181,0.0139,0.9986,-0.0462,0.0166,0.0174,0.9986,-0.0461,0.0124,0.0197,0.9987,-0.049,0.0032,0.0177,0.9986,-0.0548,-0.0081,0.0147,0.9984,-0.0574,-0.0141,0.0112,0.9982,-0.0553,-0.0184,0.0093,0.9983,-0.0524,-0.0224,0.011,0.9983,-0.0501,-0.024,0.0122,0.9984,-0.0487,-0.0235,0.008,0.9985,-0.0499,-0.0188,-0.0008,0.9986,-0.0551,-0.0141,-0.0066,0.9984,-0.059,-0.0035,-0.0028,0.9982,-0.0601,0.0119,0.0009,0.9981,-0.0601,0.0201,0.0037,0.998,-0.0584,0.0213,0.0035,0.9981,-0.0531,0.0218,0.0026,0.9983,-0.0498,0.0232,0.0048,0.9985,-0.0466,0.0241,0.0116,0.9986,-0.0459,0.0181,0.0191,0.9986,-0.0464,0.0077,0.0178,0.9987,-0.0509,-0.0051,0.0147,0.9986 } },
	["Spine02"] = { r = { -0.0535,-0.0111,0.0141,0.9984,-0.0537,-0.0126,0.0125,0.9984,-0.0528,-0.017,0.0096,0.9984,-0.0515,-0.0213,0.0097,0.9984,-0.0507,-0.0246,0.0102,0.9984,-0.0465,-0.0267,0.0095,0.9985,-0.0445,-0.0248,0.0082,0.9987,-0.0453,-0.0196,0.0077,0.9988,-0.0472,-0.0132,0.0076,0.9988,-0.0497,-0.0061,0.0078,0.9987,-0.0517,0.0011,0.0082,0.9986,-0.0517,0.0068,0.0089,0.9986,-0.0505,0.0117,0.0098,0.9986,-0.0489,0.0156,0.0112,0.9986,-0.0473,0.0176,0.0137,0.9986,-0.0462,0.0163,0.0174,0.9986,-0.0461,0.0123,0.0197,0.9987,-0.049,0.0033,0.0177,0.9986,-0.0549,-0.008,0.0148,0.9984,-0.0574,-0.014,0.0112,0.9982,-0.0553,-0.0183,0.0093,0.9983,-0.0524,-0.0224,0.011,0.9983,-0.0501,-0.024,0.0122,0.9984,-0.0487,-0.0234,0.008,0.9985,-0.0499,-0.0187,-0.0009,0.9986,-0.0551,-0.014,-0.0067,0.9984,-0.059,-0.0036,-0.0028,0.9982,-0.0602,0.0118,0.0008,0.9981,-0.0601,0.02,0.0037,0.998,-0.0584,0.0213,0.0035,0.9981,-0.0531,0.0218,0.0026,0.9983,-0.0498,0.0232,0.0048,0.9985,-0.0466,0.0241,0.0115,0.9986,-0.0459,0.018,0.0192,0.9986,-0.0464,0.0078,0.0178,0.9987,-0.0509,-0.0051,0.0148,0.9986 } },
	["Waist"] = { r = { -0.0269,-0.0113,-0.0078,0.9995,-0.027,-0.0113,-0.0082,0.9995,-0.0265,-0.0116,-0.0071,0.9996,-0.0258,-0.0116,0.0003,0.9996,-0.0253,-0.0123,0.008,0.9996,-0.0232,-0.0124,0.0093,0.9996,-0.0222,-0.0098,0.0094,0.9997,-0.0226,-0.0052,0.0093,0.9997,-0.0236,-0.0015,0.0105,0.9997,-0.0248,0.0013,0.0119,0.9996,-0.0259,0.0035,0.0126,0.9996,-0.0259,0.0048,0.0104,0.9996,-0.0253,0.0066,0.007,0.9996,-0.0244,0.0083,0.0041,0.9997,-0.0236,0.0084,0.0037,0.9997,-0.0231,0.0045,0.0011,0.9997,-0.0231,-0.0001,-0.0013,0.9997,-0.0246,-0.005,-0.0041,0.9997,-0.0275,-0.0096,-0.0061,0.9996,-0.0288,-0.0102,-0.0058,0.9995,-0.0277,-0.0103,-0.0024,0.9996,-0.0262,-0.0118,0.0042,0.9996,-0.025,-0.0118,0.0117,0.9995,-0.0242,-0.0091,0.0134,0.9996,-0.0248,-0.0034,0.0132,0.9996,-0.0274,0.0011,0.0133,0.9995,-0.0294,0.0062,0.0161,0.9994,-0.0302,0.0115,0.0151,0.9994,-0.0302,0.0125,0.011,0.9994,-0.0292,0.011,0.003,0.9995,-0.0265,0.0107,-0.0027,0.9996,-0.0248,0.0109,-0.0034,0.9996,-0.0232,0.009,-0.0021,0.9997,-0.0229,0.0031,-0.0017,0.9997,-0.0232,-0.0031,-0.0054,0.9997,-0.0255,-0.0088,-0.0071,0.9996 } },
