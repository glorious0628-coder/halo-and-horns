				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- GrudgeGhost.luau : A23-18 "원한 유령 붙잡기". While a thief carries a grudge sack with MY plundered gold
-- (server attribute GrudgeThiefId), a button (and the Keybinds "GhostHold" key on keyboards, default T; BB1 moved it off
-- G, which opens the bag) lets me hold the sack: each press adds 2 s to the time the thief must survive (server: rate
-- limit 2.7 s, max +10 s per sack). Display only; the server decides.
-- Its own module so HUD.luau (near the 200-locals limit) stays untouched. Uses the approved BtnSquare part through
-- UIKit.ArtButton (code fallback otherwise), sits left of the HUD's bottom-right button cluster (HUD.Layout) above
-- the HUD layer, and is at least 44 real px on every screen (review of 735419e).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local GrudgeGhost = {}
local C = nil
local G = { Button = nil, Label = nil, ReadyAt = 0, Size = 76, Z = 8 }
local me = Players.LocalPlayer

local function alive()
	local hum = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function active()
	return (tonumber(me:GetAttribute("GrudgeThiefId")) or 0) > 0 and alive()
end

local function keyboard() -- review of 27246d1: the same key-display rule as Keybinds / HUD
	local kb = C and C.Keybinds
	if type(kb) == "table" and type(kb.ShowsKeys) == "function" then return kb.ShowsKeys() end
	return UserInputService.KeyboardEnabled
end

function G.Press()
	if not active() or os.clock() < G.ReadyAt then return end
	G.ReadyAt = os.clock() + (Config.Grudge.HoldCooldown or 3)
	pcall(function() Net.Get("GhostHold"):FireServer() end)
	G.Refresh()
end

-- logical size so the real size is >= 44 px under the MainGui UIScale
function G.LogicalSize(gui)
	local sc = gui and gui:FindFirstChildOfClass("UIScale")
	local s = (sc and sc.Scale > 0) and sc.Scale or 1
	return math.max(G.Size, math.ceil(44 / s))
end

function G.Ensure()
	if G.Button and G.Button.Parent then return G.Button end
	local ui = C and C.UIKit
	local gui = ui and ui.Gui
	if not gui then return nil end
	local size = G.LogicalSize(gui)
	local b
	if type(ui.ArtButton) == "function" then
		local ok, made = pcall(ui.ArtButton, "BtnSquare", {
			Name = "GrudgeGhostHold", AnchorPoint = Vector2.new(1, 1),
			Size = UDim2.fromOffset(size, size), ZIndex = G.Z, Parent = gui,
		}, G.Press, { CornerRadius = UDim.new(0, 12) })
		if ok and typeof(made) == "Instance" then b = made end
	end
	if not b then
		b = Instance.new("TextButton")
		b.Name = "GrudgeGhostHold"
		b.AnchorPoint = Vector2.new(1, 1)
		b.Size = UDim2.fromOffset(size, size)
		b.ZIndex = G.Z
		b.Text = ""
		local theme = ui and ui.Theme
		b.BackgroundColor3 = (type(theme) == "table" and typeof(theme.Panel) == "Color3") and theme.Panel
			or Color3.fromRGB(35, 35, 48) -- ART_DIRECTION 2.3 Panel
		b.Activated:Connect(G.Press)
		b.Parent = gui
	end
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -8, 1, -8)
	label.Position = UDim2.fromOffset(4, 4)
	label.ZIndex = G.Z + 1
	label.TextScaled = true
	label.TextWrapped = true
	label.Font = Enum.Font.GothamBold
	-- light text with a dark rim: the square art is the navy Firefly BtnSquare (bundle 4) since 2026-10-06
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.fromRGB(27, 33, 64)
	label.TextStrokeTransparency = 0.2
	label.Parent = b
	b.Visible = false
	G.Button, G.Label = b, label
	return b
end

-- A23-26 v2: on the HudLayout ghost rect (left of Q, above the MP potion); before v2: left of the bottom-right cluster
-- (dock / square buttons), level with its top edge; follows every HUD re-layout
function G.Place(b)
	local hud = C and C.HUD
	local layout = type(hud) == "table" and hud.Layout or nil
	local r = type(layout) == "table" and type(layout.Rects) == "table" and layout.Rects.ghost or nil
	if r then
		b.Size = UDim2.fromOffset(r.W, r.H)
		b.Position = UDim2.fromOffset(r.X + r.W, r.Y + r.H) -- AnchorPoint (1, 1)
	elseif type(layout) == "table" and tonumber(layout.ClusterLeft) and tonumber(layout.ClusterTop) then
		b.Position = UDim2.fromOffset(layout.ClusterLeft - 10, layout.ClusterTop + b.Size.Y.Offset)
	else
		b.Position = UDim2.new(1, -16, 1, -250)
	end
end

function G.Refresh()
	local b = G.Ensure()
	if not b then return end
	local on = active()
	b.Visible = on
	if not on then return end
	G.Place(b)
	local wait = math.ceil(G.ReadyAt - os.clock())
	G.Label.Text = wait > 0 and string.format(Config.Text.GhostWait, wait) or G.ButtonText()
end

-- "유령으로 붙잡기 ({GhostHold})": the current key only where there is a keyboard and the action has a key (BB1)
function G.ButtonText()
	local text = Config.Text.GhostButton
	local kb = C and C.Keybinds
	if type(kb) ~= "table" or type(kb.Fill) ~= "function" then
		return (string.gsub(text, "%s?%([^()]-{%w+}[^()]-%)", ""))
	end
	if not keyboard() then return kb.StripKeys(text) end
	return kb.Fill(text, true)
end

function GrudgeGhost.Init(registry)
	C = registry
end

function GrudgeGhost.Start()
	me:GetAttributeChangedSignal("GrudgeThiefId"):Connect(G.Refresh)
	-- BB1: the hold key comes from Keybinds (Keybinds forwards every key press, plus its Dispatch test inputs)
	local keys = C and C.Keybinds
	if type(keys) == "table" and type(keys.Began) == "table" then
		keys.Began:Connect(function(input, processed)
			if processed or keys.IsCapturing() or UserInputService:GetFocusedTextBox() then return end
			if keys.ActionFor(input) == "GhostHold" then G.Press() end
		end)
		keys.Changed:Connect(function() pcall(G.Refresh) end)
	end
	task.spawn(function()
		while true do
			task.wait(0.5)
			pcall(G.Refresh)
		end
	end)
	print("[GrudgeGhost] started")
end

return GrudgeGhost
]]></ProtectedString>
					<string name="ScriptGuid">{A26FA226-C809-426C-8B57-5784454779D1}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">GrudgeGhost</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c0500006878</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0FA2D746665B404D911170B4E4F405F6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- ZoneLook.luau : A23-30 one mood per hunting ground, on the client. The war sky (WarService applies Config.Sky
-- Neutral / Dawn / Eclipse from GameState "WarBlessing") is the base light; the zone I stand in (player attribute "ZoneId")
-- tints it: meadow = bright midday, goblin woods = green shade, skeleton ruins = blue moonlight, pumpkin field =
-- orange-purple dusk, faction towns = faction colour. Monsters always keep sky light on them (the server's
-- EnvironmentDiffuseScale is never touched), so even the dark places show them clearly.
-- Base light (3rd review 2026-10-06): nothing is hard-coded here. The base is what the server writes to Lighting
-- (= Config.Sky[sky], WarService's exposure fallback included); before Start it is Config.Sky[sky] itself. Lighting =
-- base x the zone's factors, written LIVE: every server write (also each frame of its 3 s sky tween at a round end)
-- becomes the new base and is multiplied at once, so a round change never shows the raw sky for seconds. A zone change
-- eases the FACTORS (T.Tween s on Heartbeat), never a TweenService tween on Lighting, so the two can never fight.
-- Local only: the client writes its own Lighting values (they never replicate) plus one client-made ColorCorrection
-- "ZoneTint" (WarService keeps its global "WarTint"). Bloom, sun rays and the sky box stay the server's. ClockTime, the
-- classic fog and the terrain clouds stay the server's too (the war sky's meaning) EXCEPT in a zone with a Dusk entry
-- (the haunted hollow, review 2026-10-06 "유령 숲이 낮처럼 밝아요"): there they are blended toward its dusk (ClockTime
-- on the shorter way round the clock, a daytime base only; a purple-navy fog that greys out the far hills; dark
-- clouds) by the same eased weight, and leaving blends them back. Never an Atmosphere (A9-3 / A23-30 keep banning it:
-- it hides the FogColor war sky).
-- API: ZoneLook.Init(C), ZoneLook.Start(), ZoneLook.Preview(zoneId | nil) (tests: force a zone look, nil = follow me),
--      ZoneLook.Current() -> zone id, sky name, ZoneLook.TargetFor(zoneId, base[, sky]) -> Lighting goal, ZoneTint goal,
--      ZoneLook.Blend(fromZone, toZone, t, base[, sky]) -> the same mid-way through a zone change.
--      In Studio the LocalPlayer attribute "ZoneLookPreview" (set locally by tools/zone_look_view.py) drives Preview,
--      since a test runner's require() gets its own module copy.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local ZoneLook = {}
local LocalPlayer = Players.LocalPlayer

-- NightBright: under the Eclipse sky a zone may not dim the light below this factor (dark zones at night hid the
-- dark-armoured skeleton knights in the 2026-10-06 UiSandbox shots)
local T = { Tween = 1.5, NightBright = 0.95 }

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

-- per zone: Ambient / OutdoorAmbient channel factors, sun Brightness factor, exposure added, ZoneTint colour /
-- saturation / contrast / brightness, optional specular (wet moonlit stone). Unknown zones use Default.
local ZONE = {
	SlimeMeadow = { Amb = { 1, 1, 1 }, Bright = 1, Exp = 0, Tint = rgb(255, 255, 255), Sat = 0.1, Con = 0.05, CC = 0 },
	Crossroads = { Amb = { 1.03, 1, 0.97 }, Bright = 1, Exp = 0, Tint = rgb(255, 252, 246), Sat = 0.08, Con = 0.05, CC = 0 },
	GoblinWoods = { Amb = { 0.9, 1.08, 0.88 }, Bright = 0.78, Exp = 0.1, Tint = rgb(228, 246, 220), Sat = 0.12, Con = 0.08,
		CC = 0.02 },
	SkeletonRuins = { Amb = { 0.8, 0.95, 1.3 }, Bright = 0.65, Exp = 0.15, Tint = rgb(198, 212, 255), Sat = -0.12, Con = 0.1,
		CC = 0.02, Specular = 0.8 },
	-- orange low sun through the tint, purple shadows through the ambient
	PumpkinPatch = { Amb = { 1.15, 0.85, 1.25 }, Bright = 0.85, Exp = 0.08, Tint = rgb(255, 205, 170), Sat = 0.2,
		Con = 0.08, CC = 0 },
	-- A23-45 유령 숲 (이미지 생성 1 959a9af + review 2026-10-06 devlog 15 "still daylight"): dusk over the hollow only:
	-- a low sun (ClockTime 18.9), the sun at ~0.45 (2.0 -> 0.9), blue ambient so ghosts and paths stay readable,
	-- a purple-navy classic fog from 60 to 340 studs (the green hills beyond fade; the 104 x 90 hollow stays clear)
	HauntedHollow = { Amb = { 0.95, 1, 1.45 }, Bright = 0.45, Exp = 0.2, Tint = rgb(214, 206, 255), Sat = 0.05,
		Con = 0.08, CC = 0.02,
		Dusk = { Clock = 18.9, Fog = rgb(66, 58, 108), FogStart = 60, FogEnd = 340, Clouds = rgb(118, 100, 168) } },
	-- pale limestone town: dimmer sun so the white tiles do not burn out
	HaloTown = { Amb = { 1.06, 1.04, 0.95 }, Bright = 0.88, Exp = -0.12, Tint = rgb(255, 246, 228), Sat = 0.06, Con = 0.05,
		CC = 0 },
	HornsTown = { Amb = { 1.12, 0.86, 0.9 }, Bright = 0.88, Exp = 0.08, Tint = rgb(255, 218, 214), Sat = 0.1, Con = 0.08,
		CC = 0 },
}
ZONE.Default = ZONE.SlimeMeadow
ZoneLook.Zone = ZONE -- read by tests / the design table

-- the Lighting properties ZoneLook multiplies (the server writes all of them: Config.Sky per war sky, LIGHTING_FIXED)
-- and those a Dusk zone blends (ClockTime: WarService's forward tween; the fog: Config.Sky)
local MANAGED = { "Brightness", "Ambient", "OutdoorAmbient", "ExposureCompensation", "EnvironmentSpecularScale",
	"ClockTime", "FogColor", "FogStart", "FogEnd" }

local S = {
	Started = false, Zone = nil, Sky = "Neutral", Preview = nil,
	Base = {}, -- [property] = the server's latest value (never one of ZoneLook's own writes)
	F = nil, From = nil, Goal = nil, T0 = 0, Dur = 1.5, Easing = false, -- current / start / goal factors, the ease clock
	Writing = false, Tint = nil, Conn = nil,
	Clouds = nil, CloudBase = nil, -- workspace.Terrain's Clouds (WarService colours them per sky) and its server colour
}

----------------------------------------------------------------- helpers
local function skyName()
	local gs = ReplicatedStorage:FindFirstChild("GameState")
	local winner = gs and gs:GetAttribute("WarBlessing")
	if winner == "Halo" then return "Dawn" end
	if winner == "Horns" then return "Eclipse" end
	return "Neutral"
end

local function scale(c, f)
	return Color3.new(math.clamp(c.R * f[1], 0, 1), math.clamp(c.G * f[2], 0, 1), math.clamp(c.B * f[3], 0, 1))
end

local function lerp(a, b, t) return a + (b - a) * t end

local function tint()
	if S.Tint and S.Tint.Parent == Lighting then return S.Tint end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "ZoneTint"
	cc.Parent = Lighting
	S.Tint = cc
	return cc
end

-- the base before a server value is read: Config.Sky[sky] (WarService's source); the live Lighting value for what the
-- preset does not carry (exposure on Dawn / Eclipse: WarService's fallback, specular: its LIGHTING_FIXED)
local function configBase(sky)
	local p = type(Config.Sky) == "table" and Config.Sky[sky] or nil
	local base = {}
	for _, name in MANAGED do base[name] = Lighting[name] end
	if type(p) == "table" then
		if type(p.Brightness) == "number" then base.Brightness = p.Brightness end
		if typeof(p.Ambient) == "Color3" then base.Ambient = p.Ambient end
		if typeof(p.OutdoorAmbient) == "Color3" then base.OutdoorAmbient = p.OutdoorAmbient end
		if type(p.ExposureCompensation) == "number" then base.ExposureCompensation = p.ExposureCompensation end
		if type(p.ClockTime) == "number" then base.ClockTime = p.ClockTime end
		if typeof(p.FogColor) == "Color3" then base.FogColor = p.FogColor end
		if type(p.FogStart) == "number" then base.FogStart = p.FogStart end
		if type(p.FogEnd) == "number" then base.FogEnd = p.FogEnd end
	end
	return base
end

-- the zone's factors for the sky (the Eclipse night floor keeps the light up); Spec nil = the server's specular
local function factorsFor(zoneId, sky)
	local z = ZONE[zoneId] or ZONE.Default
	return {
		Amb = { z.Amb[1], z.Amb[2], z.Amb[3] },
		Bright = sky == "Eclipse" and math.max(z.Bright, T.NightBright) or z.Bright,
		Exp = z.Exp,
		Spec = z.Specular,
		Tint = z.Tint, Sat = z.Sat, Con = z.Con, CC = z.CC,
		W = z.Dusk and 1 or 0, Dusk = z.Dusk, -- dusk weight (eased like the factors) and its targets
	}
end

-- hours from a to b the shorter way round the clock (-12 .. 12)
local function clockDelta(a, b)
	return ((b - a + 12) % 24) - 12
end

-- the dusk part of a goal over a base: ClockTime / fog toward the zone's dusk by weight w (a night base keeps its clock)
local function duskOver(base, w, d)
	if not d or w <= 0 then
		return { ClockTime = base.ClockTime, FogColor = base.FogColor, FogStart = base.FogStart, FogEnd = base.FogEnd }
	end
	local clock = base.ClockTime
	if type(clock) == "number" and clock >= 6 and clock < d.Clock then
		clock = (clock + clockDelta(clock, d.Clock) * w) % 24
	end
	return {
		ClockTime = clock,
		FogColor = typeof(base.FogColor) == "Color3" and base.FogColor:Lerp(d.Fog, w) or base.FogColor,
		FogStart = type(base.FogStart) == "number" and lerp(base.FogStart, math.min(base.FogStart, d.FogStart), w)
			or base.FogStart,
		FogEnd = type(base.FogEnd) == "number" and lerp(base.FogEnd, math.min(base.FogEnd, d.FogEnd), w) or base.FogEnd,
	}
end

-- Lighting goal + ZoneTint goal for factors over a base ({ property = server value })
local function compose(f, base)
	local dusk = duskOver(base, f.W or 0, f.Dusk)
	return {
		Brightness = base.Brightness * f.Bright,
		Ambient = scale(base.Ambient, f.Amb),
		OutdoorAmbient = scale(base.OutdoorAmbient, f.Amb),
		ExposureCompensation = base.ExposureCompensation + f.Exp,
		EnvironmentSpecularScale = f.Spec or base.EnvironmentSpecularScale,
		ClockTime = dusk.ClockTime, FogColor = dusk.FogColor, FogStart = dusk.FogStart, FogEnd = dusk.FogEnd,
	}, { TintColor = f.Tint, Saturation = f.Sat, Contrast = f.Con, Brightness = f.CC }
end

-- { Lighting goal, ZoneTint goal } for a zone over a base; sky only picks the night floor
function ZoneLook.TargetFor(zoneId, base, sky)
	return compose(factorsFor(zoneId, sky), base)
end

-- factors part of the way from a to b (Spec: the server's value stands for a missing one)
local function mix(a, b, t)
	local specA = a.Spec or S.Base.EnvironmentSpecularScale or 0.6
	local specB = b.Spec or S.Base.EnvironmentSpecularScale or 0.6
	return {
		Amb = { lerp(a.Amb[1], b.Amb[1], t), lerp(a.Amb[2], b.Amb[2], t), lerp(a.Amb[3], b.Amb[3], t) },
		Bright = lerp(a.Bright, b.Bright, t),
		Exp = lerp(a.Exp, b.Exp, t),
		Spec = (a.Spec == nil and b.Spec == nil) and nil or lerp(specA, specB, t),
		Tint = a.Tint:Lerp(b.Tint, t), Sat = lerp(a.Sat, b.Sat, t), Con = lerp(a.Con, b.Con, t), CC = lerp(a.CC, b.CC, t),
		W = lerp(a.W or 0, b.W or 0, t), Dusk = b.Dusk or a.Dusk, -- whichever side has dusk targets (only W changes)
	}
end

-- the goal part of the way (t 0..1) from one zone's look to another's over a base: what a zone change shows mid-ease
-- (tests / previews; the live ease runs the same mix on Heartbeat)
function ZoneLook.Blend(fromZone, toZone, t, base, sky)
	return compose(mix(factorsFor(fromZone, sky), factorsFor(toZone, sky), math.clamp(t, 0, 1)), base)
end

-- writes base x current factors: every managed property (name = nil) or one; ZoneTint with the full write
local function write(name)
	if not S.F then return end
	local light, cc = compose(S.F, S.Base)
	S.Writing = true
	if name then
		local v = light[name]
		if v ~= nil then pcall(function() Lighting[name] = v end) end
	else
		for k, v in light do pcall(function() Lighting[k] = v end) end
	end
	S.Writing = false
	if not name then
		local fx = tint()
		for k, v in cc do pcall(function() fx[k] = v end) end
	end
	local clouds = S.Clouds
	if clouds and clouds.Parent and typeof(S.CloudBase) == "Color3" and (name == nil or name == "Clouds") then
		local d, w = S.F.Dusk, S.F.W or 0
		local goal = (d and d.Clouds and w > 0) and S.CloudBase:Lerp(d.Clouds, w) or S.CloudBase
		S.Writing = true
		pcall(function() clouds.Color = goal end)
		S.Writing = false
	end
end

-- start easing the factors to the current zone / sky (seconds <= 0: jump)
local function retarget(seconds)
	S.Sky = skyName()
	local goal = factorsFor(S.Preview or S.Zone, S.Sky)
	if not S.F or seconds <= 0 then
		S.F, S.Easing = goal, false
		write(nil)
		return
	end
	S.From, S.Goal, S.T0, S.Dur, S.Easing = S.F, goal, os.clock(), math.max(0.05, seconds), true
end

local function onHeartbeat()
	if not S.Easing then return end
	local t = math.clamp((os.clock() - S.T0) / S.Dur, 0, 1)
	local eased = 0.5 - math.cos(t * math.pi) / 2 -- sine in-out
	S.F = mix(S.From, S.Goal, eased)
	if t >= 1 then
		S.F, S.Easing = S.Goal, false
	end
	write(nil)
end

-- a write ZoneLook did not make (the server: a sky change, its 3 s tween, LIGHTING_FIXED) is the new base, multiplied
-- at once (never a frame of the raw sky)
local function onWrite(name)
	if S.Writing then return end
	S.Base[name] = Lighting[name]
	write(name)
end

local function onZone()
	local z = LocalPlayer:GetAttribute("ZoneId")
	z = type(z) == "string" and z or nil
	if z == S.Zone then return end
	S.Zone = z
	if not S.Preview then retarget(T.Tween) end
end

----------------------------------------------------------------- public
function ZoneLook.Preview(zoneId)
	S.Preview = (type(zoneId) == "string" and zoneId ~= "") and zoneId or nil
	local ok, err = pcall(retarget, T.Tween)
	if not ok then Util.Warn("ZoneLook", tostring(err)) end
end

function ZoneLook.Current()
	return S.Preview or S.Zone, S.Sky
end

function ZoneLook.Init() end

function ZoneLook.Start()
	if S.Started then return end
	S.Started = true
	S.Zone = LocalPlayer:GetAttribute("ZoneId")
	-- the server's values are already here (Lighting replicates before client scripts run); Config.Sky fills the gaps
	S.Base = configBase(skyName())
	for _, name in MANAGED do
		local v = Lighting[name]
		if v ~= nil then S.Base[name] = v end
	end
	-- the terrain clouds (when the place has them): WarService tweens their colour per sky -> the base, like Lighting
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		S.Clouds, S.CloudBase = clouds, clouds.Color
		clouds:GetPropertyChangedSignal("Color"):Connect(function()
			if S.Writing then return end
			S.CloudBase = clouds.Color
			local ok, err = pcall(write, "Clouds")
			if not ok then Util.Warn("ZoneLook", tostring(err)) end
		end)
	end
	pcall(retarget, 0)
	LocalPlayer:GetAttributeChangedSignal("ZoneId"):Connect(onZone)
	for _, name in MANAGED do
		Lighting:GetPropertyChangedSignal(name):Connect(function()
			local ok, err = pcall(onWrite, name)
			if not ok then Util.Warn("ZoneLook", tostring(err)) end
		end)
	end
	S.Conn = RunService.Heartbeat:Connect(function()
		local ok, err = pcall(onHeartbeat)
		if not ok then
			S.Easing = false
			Util.Warn("ZoneLook", tostring(err))
		end
	end)
	if RunService:IsStudio() then
		LocalPlayer:GetAttributeChangedSignal("ZoneLookPreview"):Connect(function()
			ZoneLook.Preview(LocalPlayer:GetAttribute("ZoneLookPreview"))
		end)
	end
	-- the war sky changes at a round end: the night floor (Eclipse) may change the factors; the base follows the
	-- server's own writes (onWrite)
	task.spawn(function()
		local gs = ReplicatedStorage:WaitForChild("GameState", 30)
		if not gs then return end
		gs:GetAttributeChangedSignal("WarBlessing"):Connect(function()
			local ok, err = pcall(retarget, tonumber(Config.Sky and Config.Sky.TweenTime) or T.Tween)
			if not ok then Util.Warn("ZoneLook", tostring(err)) end
		end)
	end)
	print("[ZoneLook] started")
end

return ZoneLook
]]></ProtectedString>
					<string name="ScriptGuid">{A7000FD6-2C72-4019-87FB-B287ABC7A8EF}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ZoneLook</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c0500019016</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXD7D1CDC826E7435EABAB15847C2063C3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Keybinds.luau : BB1 (docs/design/beta_basics_2026-10-05.md) the one place that knows which key does what.
-- A23-21: PC keyboard keys can be changed (saved through BB2 Settings.Keys), the gamepad layout is fixed (Config
-- .Keybinds Pad; PadWired = the pad buttons that work today, BB21 wires the rest) and touch-only devices show button
-- names instead of keys. The map is Config.KeyMap(saved sparse keys, live set): an action is live when its Flag is on
-- and, for the Window group, its Panels window is registered (call Keybinds.Refresh() after registering a window).
-- Every UserInputService press / release is forwarded through Keybinds.Began / Keybinds.Ended (HUD, VitalsUI and
-- GrudgeGhost listen there), so Keybinds.Dispatch(fakeInput) reaches the same handlers as a real key.
-- API: Get(action) -> Enum.KeyCode? | KeyName(action) -> name or "" | ActionFor(input) -> action id? | Label(action)
--   (key label, or the button name on touch-only devices) | PadFor(action) -> Enum.KeyCode? | WindowFor(action) -> Panels
--   id? | Fill(text, keyOnly?) / StripKeys(text) ('{Auto}' tokens) | Changed (Util.Signal: (map copy)) | Apply(sparse)
--   | SetLocal(action, key) -> ok, reason?, other? (swaps with the live holder, which gets my old key or ""; a non-live
--   action's saved entry on that key is dropped back to its default) | Clear(action)
--   | Reset() | IsCapturing() | Capture(action, cb) / EndCapture(reason) (BB3: next key press, 5 s) | Collisions()
--   | IsLive(action) | Refresh() | Dispatch(fakeInput) (test hook; in Studio also script.Dispatch:Invoke(fakeInput)).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local Keybinds = {}
local C = nil
local TAG = "Keybinds"
local KB = Config.Keybinds
local K = {
	Sparse = {}, -- saved explicit keys (Settings.Keys)
	Map = {}, -- [action id] = key name or ""
	ByKey = {}, -- [key name] = action id (live actions only)
	ByPad = {}, -- [pad button name] = action id (live + PadWired only)
	Live = {}, -- [action id] = true
	Collisions = {}, -- live default-only actions left without a key (BB2 collision rule)
	Toasted = {}, -- [action id] = true: the collision toast was shown this session
	Capture = nil, -- { Action, Cb } while a key is being captured (BB3)
	Prompts = setmetatable({}, { __mode = "k" }), -- ProximityPrompts whose keyboard key follows "Interact"
	Started = false,
	CaptureAction = "HH_KeyCapture",
	CapturePriority = 4000, -- above WorldMap (High + 10) and Intro (3000)
	CaptureSeconds = 5,
}

Keybinds.Changed = Util.Signal.new() -- (map copy) after the effective keys changed
Keybinds.Began = Util.Signal.new() -- (input, gameProcessed) every UserInputService.InputBegan + Dispatch
Keybinds.Ended = Util.Signal.new() -- (input, gameProcessed) every UserInputService.InputEnded + Dispatch

-- the one rule for key badges / key hints (HUD, VitalsUI, GrudgeGhost, WorldMap, Intro, quest texts): a keyboard is
-- there (touch laptops too). Review B5: no other device test decides whether a key is shown.
function Keybinds.ShowsKeys()
	return UserInputService.KeyboardEnabled == true
end

-- no keyboard: key labels become button names, "(… {Action} …)" groups go
local function touchOnly()
	return not Keybinds.ShowsKeys()
end

-- A23-43: UIKit.Lang decides (saved setting, else the Roblox language; English by default)
local function english()
	local kit = C and C.UIKit
	if type(kit) == "table" and type(kit.Lang) == "function" then
		local ok, lang = pcall(kit.Lang)
		if ok then return lang == "en" end
	end
	local st = C and C.Settings
	if type(st) ~= "table" or type(st.Get) ~= "function" then return false end
	local ok, lang = pcall(st.Get, "Lang")
	return ok and lang == "en"
end

local function text(key, ...)
	local t = Config.Settings.Text
	local s = (english() and t[key .. "En"]) or t[key] or ""
	if select("#", ...) > 0 then
		local ok, out = pcall(string.format, s, ...)
		return ok and out or s
	end
	return s
end

local function toast(msg, kind, seconds)
	local kit = C and C.UIKit
	if type(kit) == "table" and type(kit.Toast) == "function" and msg ~= "" then pcall(kit.Toast, msg, kind or "info", seconds or 4) end
end

local function actionName(def)
	return english() and def.LabelEn or def.Label
end

local function keyCode(name)
	if type(name) ~= "string" or name == "" then return nil end
	local ok, code = pcall(function() return Enum.KeyCode[name] end)
	return ok and code or nil
end

local function sameMap(a, b)
	for k, v in a do
		if b[k] ~= v then return false end
	end
	for k in b do
		if a[k] == nil then return false end
	end
	return true
end

local function liveSet()
	local panels = C and C.Panels
	local set = {}
	for _, def in KB.Actions do
		if Config.KeyFlagOn(def) then
			if def.Group ~= "Window" then
				set[def.Id] = true
			elseif type(panels) == "table" and type(panels.Has) == "function" then
				local ok, has = pcall(panels.Has, def.Window)
				if ok and has then set[def.Id] = true end
			end
		end
	end
	return set
end

-- once per action per session, keyboards only: a new action's default key was already one of my keys
local function toastCollisions()
	if not K.Started or touchOnly() then return end
	for _, id in K.Collisions do
		local def = KB.ById[id]
		if def and not K.Toasted[id] then
			K.Toasted[id] = true
			toast(text("KeyCollision", actionName(def), Config.KeyLabel(def.Key, english())), "info", 7)
		end
	end
end

local function applyPrompt(prompt)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") then return end
	K.Prompts[prompt] = true
	-- Interact can never be empty (NoClear) and only holds keys the prompt UI draws; E is the safety fallback
	local code = Keybinds.Get("Interact") or Enum.KeyCode.E
	if prompt.KeyboardKeyCode ~= code then prompt.KeyboardKeyCode = code end
end

local function recompute(silent)
	local live = liveSet()
	local map, collisions = Config.KeyMap(K.Sparse, live)
	local changed = not sameMap(map, K.Map)
	K.Live, K.Map, K.Collisions = live, map, collisions
	K.ByKey, K.ByPad = {}, {}
	for id, key in map do
		if key ~= "" then K.ByKey[key] = id end
	end
	for _, def in KB.Actions do
		if live[def.Id] and KB.PadWired[def.Id] and def.Pad ~= "" then K.ByPad[def.Pad] = def.Id end
	end
	toastCollisions()
	if changed and not silent then
		for prompt in K.Prompts do
			if prompt.Parent then pcall(applyPrompt, prompt) end
		end
		Keybinds.Changed:Fire(table.clone(map))
	end
end

local function cleanKeys(sparse)
	return Config.SanitizeSettings({ Keys = type(sparse) == "table" and sparse or {} }).Keys
end

-- new explicit keys: applied here at once, saved through BB2 Settings
local function commit(sparse)
	K.Sparse = cleanKeys(sparse)
	recompute(false)
	local st = C and C.Settings
	if type(st) == "table" and type(st.SetKeys) == "function" then
		local ok, err = pcall(st.SetKeys, K.Sparse)
		if not ok then Util.Warn(TAG, "save failed: " .. tostring(err)) end
	end
end

------------------------------------------------------------------ lookups
function Keybinds.Get(action)
	return keyCode(K.Map[action])
end

function Keybinds.KeyName(action)
	local key = K.Map[action]
	return type(key) == "string" and key or ""
end

function Keybinds.IsLive(action)
	return K.Live[action] == true
end

-- the action of a key press (keyboard: the player's keys; Gamepad1: the fixed pad buttons that are wired), or nil
function Keybinds.ActionFor(input)
	if input == nil then return nil end
	local ok, kind, code = pcall(function() return input.UserInputType, input.KeyCode end)
	if not ok or typeof(code) ~= "EnumItem" then return nil end
	if kind == Enum.UserInputType.Keyboard then return K.ByKey[code.Name] end
	if kind == Enum.UserInputType.Gamepad1 then return K.ByPad[code.Name] end
	return nil
end

-- key label ("F", "1", "Ctrl", "Num1", "없음"); on touch-only devices the button name instead (A23-21)
function Keybinds.Label(action)
	local def = KB.ById[action]
	if not def then return "" end
	local en = english()
	if touchOnly() then return en and def.ButtonEn or def.Button end
	return Config.KeyLabel(K.Map[action] or "", en)
end

-- the fixed gamepad button of an action (A23-21: not remappable in the beta), or nil
function Keybinds.PadFor(action)
	local def = KB.ById[action]
	return def and keyCode(def.Pad) or nil
end

-- the Panels id a window key opens (Group "Window"), or nil
function Keybinds.WindowFor(action)
	local def = KB.ById[action]
	return def and def.Group == "Window" and def.Window or nil
end

function Keybinds.Collisions()
	return table.clone(K.Collisions)
end

-- "(… {Action} …)" groups removed (touch-only device or a text that shows keys only on keyboards)
function Keybinds.StripKeys(s)
	if type(s) ~= "string" then return s end
	return (string.gsub(s, "%s?%([^()]-{%w+}[^()]-%)", function(group)
		for id in string.gmatch(group, "{(%w+)}") do
			if KB.ById[id] then return "" end
		end
		return nil
	end))
end

-- '{Auto}' -> Label("Auto"). keyOnly: a "(… {Action} …)" group stays only on keyboards and only when that action has a
-- key (e.g. "유령으로 붙잡기 ({GhostHold})" -> "유령으로 붙잡기 (T)" / "유령으로 붙잡기")
function Keybinds.Fill(s, keyOnly)
	if type(s) ~= "string" or not string.find(s, "{", 1, true) then return s end
	if keyOnly then
		if touchOnly() then
			s = Keybinds.StripKeys(s)
		else
			s = string.gsub(s, "%s?%([^()]-{%w+}[^()]-%)", function(group)
				for id in string.gmatch(group, "{(%w+)}") do
					if KB.ById[id] and Keybinds.KeyName(id) == "" then return "" end
				end
				return nil
			end)
		end
	end
	return (string.gsub(s, "{(%w+)}", function(id)
		if not KB.ById[id] then return nil end
		return Keybinds.Label(id)
	end))
end

------------------------------------------------------------------ changes
-- the saved sparse keys (BB2 server value); recomputes and fires Changed only when the effective keys changed
function Keybinds.Apply(sparse)
	K.Sparse = cleanKeys(sparse)
	recompute(false)
end

-- live set again (a Panels window registered later, BB13 Panels.Register calls this)
function Keybinds.Refresh()
	recompute(false)
end

-- key = KeyCode name or Enum.KeyCode. A key another live action holds is swapped: that action gets my old key (or "").
-- Returns ok, reason ("NotLive" | "Reserved" | "NotAllowed" | "Swap" | nil), the other action (on "Swap").
function Keybinds.SetLocal(action, key)
	if not KB.ById[action] or not K.Live[action] then return false, "NotLive" end
	if typeof(key) == "EnumItem" then key = key.Name end
	if type(key) ~= "string" then return false, "NotAllowed" end
	if Config.KeyReserved(key) then return false, "Reserved" end
	if not Config.KeyAllowedFor(action, key) then return false, "NotAllowed" end
	local old = Keybinds.KeyName(action)
	if old == key then return true end
	local holder = K.ByKey[key]
	-- a swap may not hand the other action a key it cannot hold (Interact: prompt keys only, never empty)
	if holder and holder ~= action and not Config.KeyAllowedFor(holder, old) then return false, "NotAllowed" end
	local sparse = table.clone(K.Sparse)
	sparse[action] = key
	if holder and holder ~= action then sparse[holder] = old end
	-- a non-live action holds no key: its saved key (a window not built / registered yet, a save from another build)
	-- must not take this key from a live action (SanitizeSettings keeps one key per action in Actions order), so that
	-- stale entry goes back to its default (the BB2 collision rule handles it once the action is live)
	for id, v in K.Sparse do
		if not K.Live[id] and v ~= "" and (v == key or (holder and holder ~= action and v == old)) then sparse[id] = nil end
	end
	commit(sparse)
	if holder and holder ~= action then return true, "Swap", holder end
	return true
end

-- the action keeps no key ("없음"); its old key does nothing
function Keybinds.Clear(action)
	if not KB.ById[action] or not K.Live[action] then return false end
	if not Config.KeyAllowedFor(action, "") then return false, "NoClear" end -- Interact always keeps a key
	local sparse = table.clone(K.Sparse)
	sparse[action] = ""
	commit(sparse)
	return true
end

-- every key back to the defaults
function Keybinds.Reset()
	commit({})
end

------------------------------------------------------------------ capture (BB3 settings window)
function Keybinds.IsCapturing()
	return K.Capture ~= nil
end

-- ends the running capture; cb(result, keyName?, otherAction?) with result "Set" | "Swap" | "Reserved" | "NotAllowed" |
-- "Timeout" | "Cancel"
function Keybinds.EndCapture(result, key, other)
	local cap = K.Capture
	if not cap then return end
	K.Capture = nil
	pcall(function()
		ContextActionService:UnbindAction(K.CaptureAction)
	end)
	if cap.Prompts ~= nil then
		pcall(function() ProximityPromptService.Enabled = cap.Prompts end) -- the interact prompts work again
	end
	if type(cap.Cb) == "function" then
		local ok, err = pcall(cap.Cb, result or "Cancel", key, other)
		if not ok then Util.Warn(TAG, "capture callback: " .. tostring(err)) end
	end
end

local function onCapture(cap, input)
	if K.Capture ~= cap then return end
	local code = input.KeyCode
	if code == Enum.KeyCode.Unknown then return end
	local name = code.Name
	if code == Enum.KeyCode.Escape then
		Keybinds.EndCapture("Cancel")
	elseif Config.KeyReserved(name) then
		toast(text("Reserved"), "bad", 3)
		Keybinds.EndCapture("Reserved", name)
	elseif not Config.KeyAllowedFor(cap.Action, name) then
		toast(text("NotAllowed"), "bad", 3)
		Keybinds.EndCapture("NotAllowed", name)
	else
		local old = Keybinds.KeyName(cap.Action)
		local ok, reason, other = Keybinds.SetLocal(cap.Action, name)
		if ok and reason == "Swap" then
			toast(text("Swapped", Config.KeyLabel(name, english()), Config.KeyLabel(old, english())), "info", 3)
			Keybinds.EndCapture("Swap", name, other)
		elseif ok then
			Keybinds.EndCapture("Set", name)
		else
			Keybinds.EndCapture(reason == "NotLive" and "Cancel" or (reason or "NotAllowed"), name)
		end
	end
end

-- the next keyboard key becomes the action's key (5 s; Esc / the Roblox menu / EndCapture cancel). The capture sinks
-- every keyboard key at priority 4000, so M / B / the game keys do nothing meanwhile (IsCapturing is a second guard).
function Keybinds.Capture(action, cb)
	Keybinds.EndCapture("Cancel")
	if not KB.ById[action] or not K.Live[action] then return false end
	local cap = { Action = action, Cb = cb, Prompts = nil }
	K.Capture = cap
	pcall(function() -- the pressed key must not also open a shop / altar prompt
		cap.Prompts = ProximityPromptService.Enabled
		ProximityPromptService.Enabled = false
	end)
	local ok, err = pcall(function()
		ContextActionService:BindActionAtPriority(K.CaptureAction, function(_, state, input)
			if K.Capture ~= cap then return Enum.ContextActionResult.Pass end
			if state == Enum.UserInputState.Begin then
				local okKey, errKey = pcall(onCapture, cap, input)
				if not okKey then
					Util.Warn(TAG, "capture: " .. tostring(errKey))
					Keybinds.EndCapture("Cancel")
				end
			end
			return Enum.ContextActionResult.Sink
		end, false, K.CapturePriority, Enum.UserInputType.Keyboard)
	end)
	if not ok then
		K.Capture = nil
		if cap.Prompts ~= nil then pcall(function() ProximityPromptService.Enabled = cap.Prompts end) end
		Util.Warn(TAG, "capture bind failed: " .. tostring(err))
		return false
	end
	task.delay(K.CaptureSeconds, function()
		if K.Capture == cap then Keybinds.EndCapture("Timeout") end
	end)
	return true
end

------------------------------------------------------------------ test hook
-- runs the game's key handlers for a fake input: { KeyCode = Enum.KeyCode.G, UserInputType = Enum.UserInputType.Keyboard
-- (default) | Gamepad1, State = "Begin" | "End" | nil (= press and release), GameProcessed = bool }. Returns the action.
function Keybinds.Dispatch(fake)
	if type(fake) ~= "table" or typeof(fake.KeyCode) ~= "EnumItem" then return nil end
	local input = {
		KeyCode = fake.KeyCode,
		UserInputType = fake.UserInputType or Enum.UserInputType.Keyboard,
		UserInputState = Enum.UserInputState.Begin,
		Position = Vector3.zero,
		Delta = Vector3.zero,
		Fake = true,
	}
	local action = Keybinds.ActionFor(input)
	if fake.State ~= "End" then Keybinds.Began:Fire(input, fake.GameProcessed == true) end
	if fake.State ~= "Begin" then
		local ended = table.clone(input)
		ended.UserInputState = Enum.UserInputState.End
		Keybinds.Ended:Fire(ended, fake.GameProcessed == true)
	end
	return action
end

------------------------------------------------------------------ lifecycle
function Keybinds.Init(registry)
	C = registry
	local st = C and C.Settings
	if type(st) == "table" and type(st.Get) == "function" then
		local ok, keys = pcall(st.Get, "Keys")
		if ok then K.Sparse = cleanKeys(keys) end
	end
	recompute(true) -- HUD / VitalsUI build their key badges from this in their Init
	if RunService:IsStudio() then
		-- execute_luau / command bar (client): PlayerScripts.Keybinds.Dispatch:Invoke({ KeyCode = Enum.KeyCode.G })
		local bf = Instance.new("BindableFunction")
		bf.Name = "Dispatch"
		bf.OnInvoke = function(fake) return Keybinds.Dispatch(fake) end
		bf.Parent = script
	end
end

function Keybinds.Start()
	if K.Started then return end
	K.Started = true
	recompute(false) -- every window registered in an Init is live now
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		Keybinds.Began:Fire(input, gameProcessed)
	end)
	UserInputService.InputEnded:Connect(function(input, gameProcessed)
		Keybinds.Ended:Fire(input, gameProcessed)
	end)
	local st = C and C.Settings
	if type(st) == "table" and type(st.Changed) == "table" then
		st.Changed:Connect(function(settings)
			if type(settings) == "table" then Keybinds.Apply(settings.Keys) end
		end)
	end
	-- Interact: every ProximityPrompt (blacksmith / altar / potion merchant) uses the player's Interact key
	ProximityPromptService.PromptShown:Connect(function(prompt) pcall(applyPrompt, prompt) end)
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then pcall(applyPrompt, d) end
	end)
	task.spawn(function()
		for _, d in workspace:GetDescendants() do
			if d:IsA("ProximityPrompt") then pcall(applyPrompt, d) end
		end
	end)
	pcall(function()
		GuiService.MenuOpened:Connect(function() Keybinds.EndCapture("Cancel") end) -- Esc belongs to Roblox
	end)
	toastCollisions()
	print("[Keybinds] started")
end

return Keybinds
]]></ProtectedString>
