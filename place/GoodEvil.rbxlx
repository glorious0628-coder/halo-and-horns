			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PvPService.luau : PvP rules (CanAttack, rookie / spawn protection), bully detection, KO outcomes
-- (plunder -> grudge sack, honor, bounty), Wanted stars + bounty, revenge marks and the Most Wanted board.
-- Server only. See TECH_SPEC §4.13 and SPEC_ADDENDUM A6 / A10-V3-3.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "PvPService"

-- (the A3-M3 "under attack while auto-attack is ON" hint is sent by CombatService.DamagePlayer only)
local LOOP_INTERVAL = 1
local PRUNE_INTERVAL = 60 -- seconds between prunes of the bait damage log
local LOOP_WARN_INTERVAL = 10

-- review-fix tuning knobs (grouped to keep the chunk's local count low)
local GUARD = {
	DmgLogMax = 64, -- CR-M15: hits kept per attacker/victim pair (oldest dropped first)
	RecentHitSeconds = 3, -- CR-L4: a non-PvP death without damage this recent (reset / fall) keeps the stars
	KoLogKeep = math.max(1, Config.Bully.RepeatKOs - 1), -- CR-M4: KO times kept per killer/victim pair ({ t1, t2 })
}

-- Most Wanted board lines (TECH_SPEC §4.13 board text)
local BOARD_WANTED_TITLE = "현상수배 TOP 3"
local BOARD_HONOR_TITLE = Config.Factions.Halo.Name .. " 명예 TOP 3"
local BOARD_EMPTY = "(아직 없음)"
local BOARD_BULLY = "깡패"
local BOARD_HONOR_WORD = "명예"
local BOARD_ROWS = 3

local PvPService = {}

PvPService.PlayerKO = Util.Signal.new() -- (killer, victim, info)

local S = nil

-- per-player state (Player keys; cleaned on PlayerLeaving)
local stars = {} -- [Player] = number
local lastStarChange = {} -- [Player] = os.clock()
local protectedUntil = {} -- [Player] = os.clock() (0 = not protected)
local spawnedAt = {} -- [Player] = os.clock() of the last CharacterSpawned
-- CR-M15: [attacker][victim] = { { T = os.clock(), A = damage }, ... } within Config.Bully.BaitWindow (bait check)
local dmgLog = {}
local revenge = {} -- [Player] = { Target = Player, Until = os.clock() }

-- CR-M4: pair state (minted KO reward, repeat-KO log, claimed bully bounty) lives in the saved PairCD of the player
-- it belongs to, so a server hop or rejoin cannot reset it (pairReady / logKO below; pruned by PlayerService)

-- anti-farm: the minted bully part of a bounty is paid at most once per victim (any killer) per this window,
-- the time a max-stack bully needs to decay back to clean. Stored in the victim's PairCD as "bully:0".
local BULLY_BOUNTY_COOLDOWN = Config.Bully.DecaySeconds * Config.Bully.MaxStacks

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind)
	if isPlaying(p) then
		Net.Notify(p, text, kind)
	end
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function faction(p)
	return S.FactionService.GetFaction(p)
end

-- only Halo and Horns ever take part in PvP ("Neutral" and "None" never do; addendum A6)
local function isFighter(f)
	return f == "Halo" or f == "Horns"
end

local function kstate(p)
	local kaiju = S.KaijuService
	if kaiju and kaiju.GetState then
		return kaiju.GetState(p) or "None"
	end
	return "None"
end

-- persisted stat: live data table first, mirrored attribute as fallback
local function num(p, key, default)
	local data = S.PlayerService.GetData(p)
	local v = data and data[key]
	if v == nil then
		v = p:GetAttribute(key)
	end
	return tonumber(v) or default
end

local function bullyStacksOf(p)
	return tonumber(S.JusticeService.GetBullyStacks(p)) or 0
end

local function classOf(p)
	local C = S.ClassService
	return (C and C.GetClass and C.GetClass(p)) or "Warrior"
end

-- CR-M4: pair cooldown kept in the holder's saved PairCD ("<kind>:<otherUserId>" = os.time()). PlayerService.PairReady
-- owns it; the inline copy follows the same contract. commit = false only checks. No data -> false (no reward).
local function pairReady(holder, otherUserId, kind, cooldown, commit)
	if not holder then
		return false
	end
	local PS = S.PlayerService
	if PS.PairReady then
		local ok, res = pcall(PS.PairReady, holder, otherUserId, kind, cooldown, commit)
		return ok and res == true
	end
	local d = PS.GetData(holder)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = kind .. ":" .. tostring(otherUserId)
	local t = os.time()
	if t - (tonumber(d.PairCD[k]) or 0) < cooldown then
		return false
	end
	if commit ~= false then
		d.PairCD[k] = t
	end
	return true
end

-- CR-M4: the killer's recent KO times on this victim live in the killer's PairCD as "kolog:<victimUserId>" =
-- { t1, t2 } (os.time, oldest first). Records this KO; true when it is the RepeatKOs-th within RepeatWindow.
local function logKO(killer, victim)
	local B = Config.Bully
	local d = S.PlayerService.GetData(killer)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = "kolog:" .. tostring(victim.UserId)
	local t = os.time()
	local times = {}
	local old = d.PairCD[k]
	if type(old) == "table" then
		for _, v in old do
			local x = tonumber(v)
			if x and t - x <= B.RepeatWindow then
				table.insert(times, x)
			end
		end
		table.sort(times)
	end
	table.insert(times, t)
	local repeated = #times >= B.RepeatKOs
	while #times > GUARD.KoLogKeep do
		table.remove(times, 1)
	end
	d.PairCD[k] = times
	return repeated
end

-- bully stacks that still carry a bounty: 0 while this bully's bounty was already claimed (BULLY_BOUNTY_COOLDOWN,
-- the victim's PairCD "bully:0"). The stacks themselves (size / damage penalty, "깡패" tag) stay with JusticeService.
local function bountyBullyStacks(p)
	local n = bullyStacksOf(p)
	if n <= 0 or not pairReady(p, 0, "bully", BULLY_BOUNTY_COOLDOWN, false) then
		return 0
	end
	return n
end

-- marks this bully's bounty as claimed (by any killer) for BULLY_BOUNTY_COOLDOWN
local function claimBullyBounty(p)
	pairReady(p, 0, "bully", 0)
end

-- CR-L5: weak-victim check power WITHOUT the rebirth bonus (that bonus is gold / XP only)
local function combatPower(p)
	local J = S.JusticeService
	if J and J.GetCombatPower then
		local ok, v = pcall(J.GetCombatPower, p)
		if ok and type(v) == "number" then
			return v
		end
	end
	local level = math.max(1, num(p, "Level", 1))
	local tier = math.clamp(math.floor(num(p, "WeaponTier", 1)), 1, Config.MaxWeaponTier)
	return Config.PowerOf(level, tier, 1)
end

-- addendum A10-V3-3: inside a PvP zone, or combat-tagged (Config.PvP.CombatTagTime) anywhere outside a town
-- (Outskirts, bridges, safe hunting land), so a fight or a sack chase does not end at a zone edge
local function inPvP(p)
	return S.ZoneService.IsPvPZone(p) or (not S.ZoneService.IsTown(p) and S.CombatService.IsInCombat(p))
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

-- CR-M15: remove every hit with T < cutoff from an ascending dmgLog list
local function pruneHits(hits, cutoff)
	while hits[1] ~= nil and hits[1].T < cutoff do
		table.remove(hits, 1)
	end
end

-- CR-M15: total damage `attacker` dealt to `victim` within Config.Bully.BaitWindow
local function recentDamage(attacker, victim, now)
	local byVictim = dmgLog[attacker]
	local hits = byVictim and byVictim[victim]
	if not hits then
		return 0
	end
	local sum = 0
	for _, h in hits do
		if now - h.T <= Config.Bully.BaitWindow then
			sum += h.A
		end
	end
	return sum
end

local function computeBounty(p)
	if not isFighter(faction(p)) then
		return 0
	end
	return Config.Bounty(num(p, "Level", 1), stars[p] or 0, bountyBullyStacks(p))
end

local function refreshStarAttrs(p)
	if not isPlaying(p) then
		return
	end
	setAttr(p, "WantedStars", stars[p] or 0)
	setAttr(p, "Bounty", computeBounty(p))
end

-- the newbie PvP shield is meaningless for Neutral (never in PvP at all; addendum A6)
local function rookieAttr(p)
	return faction(p) ~= "Neutral" and PvPService.IsRookie(p)
end

local function announceIfMostWanted(p, before, after)
	if before < Config.PvP.AnnounceStars and after >= Config.PvP.AnnounceStars then
		Net.NotifyAll(fmt("MostWanted", Util.PlayerDisplayName(p), Util.FormatNumber(computeBounty(p))))
	end
end

local function addStar(killer)
	local before = stars[killer] or 0
	local after = math.min(Config.PvP.MaxStars, before + 1)
	stars[killer] = after
	lastStarChange[killer] = os.clock()
	refreshStarAttrs(killer)
	announceIfMostWanted(killer, before, after)
end

local function destroyForceFields(p)
	local character = p.Character
	if not character then
		return
	end
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
end

local function clearRevenge(p)
	revenge[p] = nil
	if isPlaying(p) then
		setAttr(p, "RevengeTargetId", 0)
		setAttr(p, "RevengeUntil", 0)
	end
end

-- clears p's own revenge mark and every other player's mark that targets p
local function clearRevengeInvolving(p)
	local holders = {}
	for holder, r in revenge do
		if holder == p or r.Target == p then
			table.insert(holders, holder)
		end
	end
	for _, holder in holders do
		clearRevenge(holder)
	end
end

------------------------------------------------------------------ public API
function PvPService.GetStars(player)
	return (player and stars[player]) or 0
end

function PvPService.ResetStars(player)
	if not player then
		return
	end
	stars[player] = 0
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
end

function PvPService.DebugSetStars(player, n)
	if not isPlaying(player) then
		return
	end
	local before = stars[player] or 0
	local after = math.clamp(math.floor(tonumber(n) or 0), 0, Config.PvP.MaxStars)
	stars[player] = after
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
	announceIfMostWanted(player, before, after)
end

-- Rebirths == 0 and (Level < RookieLevel or PlaytimeSeconds < RookiePlaytime)
function PvPService.IsRookie(player)
	if not player then
		return false
	end
	if num(player, "Rebirths", 0) ~= 0 then
		return false
	end
	return num(player, "Level", 1) < Config.PvP.RookieLevel
		or num(player, "PlaytimeSeconds", 0) < Config.PvP.RookiePlaytime
end

function PvPService.HasRevenge(attacker, victim)
	local r = attacker and revenge[attacker]
	return r ~= nil and victim ~= nil and r.Target == victim and os.clock() < r.Until
end

function PvPService.Protect(player, seconds)
	if not isPlaying(player) then
		return
	end
	seconds = tonumber(seconds) or 0
	if seconds <= 0 then
		return
	end
	local character = player.Character
	if character and character.Parent and not character:FindFirstChildOfClass("ForceField") then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = character
	end
	protectedUntil[player] = math.max(protectedUntil[player] or 0, os.clock() + seconds)
	setAttr(player, "Protected", true)
end

function PvPService.BreakProtection(player)
	if not player then
		return
	end
	-- cheap early-out: CombatService calls this after every PvP hit
	if (protectedUntil[player] or 0) == 0 and player:GetAttribute("Protected") ~= true then
		return
	end
	protectedUntil[player] = 0
	destroyForceFields(player)
	if isPlaying(player) then
		setAttr(player, "Protected", false)
	end
end

-- (allowed: boolean, reasonKey: string?)
function PvPService.CanAttack(attacker, victim)
	if attacker == nil or victim == nil or attacker == victim then
		return false, "Self"
	end
	local PS = S.PlayerService
	if not PS.IsReady(attacker) or not PS.IsReady(victim) then
		return false, "NotReady"
	end
	if not Util.IsAlive(attacker) or not Util.IsAlive(victim) then
		return false, "Dead"
	end
	local fa, fv = faction(attacker), faction(victim)
	if fa == "Neutral" or fv == "Neutral" then
		return false, "Neutral" -- addendum A6: Neutral never hits / is hit by players, anywhere
	end
	if not isFighter(fa) or not isFighter(fv) or fa == fv then
		return false, "SameFaction"
	end
	-- kaiju exception: Halo may hit the Active kaiju in any zone (rookies allowed, protection ignored)
	if fa == "Halo" and kstate(victim) == "Active" then
		return true, nil
	end
	if not inPvP(attacker) or not inPvP(victim) then
		return false, "SafeZone"
	end
	if PvPService.IsRookie(attacker) or PvPService.IsRookie(victim) then
		return false, "Rookie"
	end
	if victim:GetAttribute("Protected") == true then
		return false, "Protected"
	end
	return true, nil
end

-- called ONLY by CombatService's death pipeline (no kill credit: monster, fall, reset)
function PvPService.HandleNonPvPDeath(victim)
	if not victim then
		return
	end
	if (stars[victim] or 0) >= 1 then
		-- CR-L4: a death in town or without damage in the last few seconds (reset, fall) keeps the stars and bounty:
		-- carried gold is 0 in town, so a reset there would otherwise wipe them for free
		local lastHit = tonumber(S.CombatService.GetLastDamagedAt(victim)) or 0
		if S.ZoneService.IsTown(victim) == true or os.clock() - lastHit > GUARD.RecentHitSeconds then
			return
		end
		local carried = num(victim, "CarriedGold", 0)
		local loss = math.floor(carried * Config.PvP.VillainLossOnWantedPvEDeath)
		if loss > 0 then
			S.ProgressionService.TakeCarriedGold(victim, loss)
		end
	end
	PvPService.ResetStars(victim)
end

-- called ONLY by CombatService's death pipeline (after GrudgeService.OnCarrierDown)
function PvPService.HandleKO(victim, killer)
	if not victim then
		return
	end
	if killer == nil or killer == victim or not isPlaying(killer) then
		PvPService.HandleNonPvPDeath(victim)
		return
	end
	local fk, fv = faction(killer), faction(victim)
	if not isFighter(fk) or not isFighter(fv) or fk == fv then
		-- defensive: Neutral / None / same-faction deaths are never PvP KOs (addendum A6)
		PvPService.HandleNonPvPDeath(victim)
		return
	end

	local P = Config.PvP
	local B = Config.Bully
	local Justice = S.JusticeService
	local Progression = S.ProgressionService
	local now = os.clock()

	-- 1. snapshot + KO log (CR-M4: the log is kept in the killer's save)
	local starsBefore = stars[victim] or 0
	local bullyBefore = bullyStacksOf(victim)
	-- the victim's bully stacks that still pay a bounty (0 once claimed; anti-farm, see BULLY_BOUNTY_COOLDOWN)
	local bountyBully = bountyBullyStacks(victim)
	local repeated = logKO(killer, victim)

	-- 2. bully check (any faction pairing)
	local weak = combatPower(victim) < B.WeakPowerRatio * combatPower(killer) -- CR-L5
	-- CR-M15: bait = the victim dealt >= BaitMinPct of the killer's base MaxHealth to the killer within BaitWindow
	local baitNeed = (B.BaitMinPct or 0.2) * Config.MaxHealth(num(killer, "Level", 1), fk, classOf(killer))
	local baitDealt = recentDamage(victim, killer, now)
	local baited = baitDealt > 0 and baitDealt >= baitNeed
	if weak and baited then
		weak = false -- anti-bait: the victim attacked the killer first
	end
	if weak and B.WantedIgnoresWeakRule and (starsBefore > 0 or bullyBefore > 0) then
		weak = false
	end
	local fresh = spawnedAt[victim] ~= nil and now - spawnedAt[victim] < B.FreshSpawnSeconds
	local bully = weak or fresh or repeated
	-- CR-M14: a fresh / repeat KO of a victim who baited the killer is self-defense (no bully stack, no rewards),
	-- and a kaiju never becomes a bully (that would double its kaiju pool)
	local defense = baited and (fresh or repeated)
	if defense or kstate(killer) ~= "None" then
		bully = false
	end

	-- 3. revenge (always)
	revenge[victim] = { Target = killer, Until = now + Config.Revenge.Duration }
	setAttr(victim, "RevengeTargetId", killer.UserId)
	setAttr(victim, "RevengeUntil", Util.Now() + Config.Revenge.Duration)
	notify(victim, fmt("Revenge", Util.PlayerDisplayName(killer)), "info")
	local killerRevenge = revenge[killer]
	if killerRevenge and killerRevenge.Target == victim then
		local wasActive = now < killerRevenge.Until
		clearRevenge(killer)
		if wasActive then
			notify(killer, fmt("RevengeDone"), "good")
		end
	end

	local info
	if defense then
		-- CR-M14: self-defense KO: no bully stack, stars, plunder, honor/infamy, bounty or war points
		info = { Kind = "Defense", Bully = false, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	elseif bully then
		-- 4. bully KO: no plunder, stars, honor/infamy, bounty or war points
		local n = math.floor(tonumber(Justice.AddBullyStack(killer)) or 0)
		notify(killer, fmt("BullyKO", n), "bad")
		notify(victim, fmt("BullyVictim"), "info")
		refreshStarAttrs(killer) -- bounty doubles while a bully
		info = { Kind = "Bully", Bully = true, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	else
		-- 5. pair cooldown for minted rewards (CR-M4: kept in the killer's save as "ko:<victimUserId>")
		local pairOk = pairReady(killer, victim.UserId, "ko", P.PairRewardCooldown)
		local vLevel = num(victim, "Level", 1)

		if fk == "Horns" then
			-- 6a. Horns KO Halo: plunder into the grudge sack
			if pairOk then
				addStar(killer) -- CR-M3: a farmed pair (inside the cooldown) adds no star
			end
			local stolen = 0
			if not S.GrudgeService.CanSteal(killer, victim) then
				notify(killer, fmt("PlunderTooSoon"), "info")
			else
				local carried = num(victim, "CarriedGold", 0)
				local safeFloor = P.SafeFloorPerLevel * vLevel
				stolen = math.min(math.floor(math.max(0, carried - safeFloor) * P.PlunderRate), P.PlunderCapPerLevel * vLevel)
				if stolen > 0 then
					stolen = math.floor(tonumber(Progression.TakeCarriedGold(victim, stolen)) or 0)
				end
				if stolen > 0 then
					S.GrudgeService.AddToSack(killer, victim, stolen, pairOk and 1 or 0)
					local from, to = rootPos(victim), rootPos(killer)
					if from and to then
						Net.Fx(nil, "Plunder", { From = from, To = to, Amount = stolen })
					end
					notify(victim, fmt("Plundered", Util.PlayerDisplayName(killer), Util.FormatNumber(stolen)), "bad")
					notify(killer, fmt("PlunderGain", Util.FormatNumber(stolen), stars[killer] or 0), "reward")
				end
			end
			if stolen == 0 and pairOk then
				S.PlayerService.AddStat(killer, "Infamy", 1) -- no sack to carry it
			end
			local bullyBounty = 0
			if bountyBully > 0 and pairOk then
				bullyBounty = Config.Bounty(vLevel, 0, bountyBully)
				if bullyBounty > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
					Progression.AddBankGold(killer, bullyBounty, "Bounty")
					notify(killer, fmt("BullyBountyGain", Util.FormatNumber(bullyBounty)), "reward")
				end
			end
			info = {
				Kind = "Plunder", Bully = false, VictimStars = starsBefore,
				Stolen = stolen, Bounty = bullyBounty, Rewarded = pairOk,
			}
		elseif starsBefore == 0 and bountyBully == 0 then
			-- 6b. Halo KO a clean Horns (or a bully whose bounty was already claimed): honor
			if pairOk then
				S.PlayerService.AddStat(killer, "Honor", P.HonorPerKOMin)
				notify(killer, fmt("HonorGain", P.HonorPerKOMin), "reward")
			end
			info = { Kind = "Honor", Bully = false, VictimStars = 0, Stolen = 0, Bounty = 0, Rewarded = pairOk }
		else
			-- 6c. Halo KO a Wanted (or bully) Horns: bounty
			local bounty = pairOk and Config.Bounty(vLevel, starsBefore, bountyBully) or 0
			if bounty > 0 then
				if bountyBully > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
				end
				Progression.AddBankGold(killer, bounty, "Bounty")
			end
			local honor = pairOk and math.max(1, starsBefore) or 0
			if honor > 0 then
				S.PlayerService.AddStat(killer, "Honor", honor)
			end
			if starsBefore > 0 then
				local carried = num(victim, "CarriedGold", 0)
				local loss = math.floor(carried * P.VillainLossOnBountyKO)
				if loss > 0 then
					Progression.TakeCarriedGold(victim, loss)
				end
			end
			if bounty > 0 or honor > 0 then
				notify(killer, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
			end
			if starsBefore >= P.GlowStars and bounty > 0 then
				Net.NotifyAll(fmt("BountyAnnounce", Util.PlayerDisplayName(killer), Util.FormatNumber(bounty)))
			end
			info = {
				Kind = "Bounty", Bully = false, VictimStars = starsBefore,
				Stolen = 0, Bounty = bounty, Rewarded = pairOk,
			}
		end
	end

	-- 7. victim's stars are gone; tell everyone
	PvPService.ResetStars(victim)
	PvPService.PlayerKO:Fire(killer, victim, info)
end

------------------------------------------------------------------ board
local function updateBoard()
	local ok, label = pcall(function()
		return S.MapBuilder.GetBoardLabel()
	end)
	if not ok or not label then
		return
	end

	local wanted, heroes = {}, {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		local bounty = tonumber(p:GetAttribute("Bounty")) or 0
		if bounty > 0 then
			table.insert(wanted, { Name = Util.PlayerDisplayName(p), Bounty = bounty, Stars = stars[p] or 0, Bully = bullyStacksOf(p) })
		end
		if faction(p) == "Halo" then
			local honor = num(p, "Honor", 0)
			if honor > 0 then
				table.insert(heroes, { Name = Util.PlayerDisplayName(p), Honor = honor })
			end
		end
	end
	table.sort(wanted, function(a, b)
		if a.Bounty ~= b.Bounty then
			return a.Bounty > b.Bounty
		end
		return a.Name < b.Name
	end)
	table.sort(heroes, function(a, b)
		if a.Honor ~= b.Honor then
			return a.Honor > b.Honor
		end
		return a.Name < b.Name
	end)

	local lines = { BOARD_WANTED_TITLE }
	if #wanted == 0 then
		table.insert(lines, BOARD_EMPTY)
	else
		for i = 1, math.min(BOARD_ROWS, #wanted) do
			local w = wanted[i]
			local line = string.format("%d. %s", i, w.Name)
			if w.Stars > 0 then
				line ..= " " .. string.rep("★", w.Stars)
			end
			line ..= " " .. Util.FormatNumber(w.Bounty) .. "G"
			if w.Bully > 0 then
				line ..= " " .. BOARD_BULLY
			end
			table.insert(lines, line)
		end
	end
	table.insert(lines, "")
	table.insert(lines, BOARD_HONOR_TITLE)
	if #heroes == 0 then
		table.insert(lines, BOARD_EMPTY)
	else
		for i = 1, math.min(BOARD_ROWS, #heroes) do
			local h = heroes[i]
			table.insert(lines, string.format("%d. %s %s %s", i, h.Name, BOARD_HONOR_WORD, Util.FormatNumber(h.Honor)))
		end
	end

	local text = table.concat(lines, "\n")
	if label.Text ~= text then
		label.Text = text
	end
end

------------------------------------------------------------------ loops
local function tickPlayer(p, now)
	-- protection expiry
	local pu = protectedUntil[p]
	if pu and pu > 0 and now >= pu then
		protectedUntil[p] = 0
		destroyForceFields(p)
		setAttr(p, "Protected", false)
	end

	-- star decay: one star per StarDecaySeconds, paused while queued / siren / active kaiju
	local s = stars[p] or 0
	if s > 0 then
		if kstate(p) ~= "None" then
			lastStarChange[p] = now
		elseif now - (lastStarChange[p] or now) >= Config.PvP.StarDecaySeconds then
			stars[p] = s - 1
			lastStarChange[p] = now
		end
	end
	refreshStarAttrs(p)
	setAttr(p, "Rookie", rookieAttr(p))

	-- revenge expiry
	local r = revenge[p]
	if r and (now >= r.Until or not isPlaying(r.Target)) then
		clearRevenge(p)
	end
end

-- CR-M15: drop bait-log hits older than BaitWindow (pair state itself is in the saves, CR-M4)
local function pruneDmgLog(now)
	local cutoff = now - Config.Bully.BaitWindow
	for attacker, byVictim in dmgLog do
		for victim, hits in byVictim do
			pruneHits(hits, cutoff)
			if #hits == 0 then
				byVictim[victim] = nil
			end
		end
		if next(byVictim) == nil then
			dmgLog[attacker] = nil
		end
	end
end

-- CR-M12: stars saved at leave come back on the next join minus the decay for the time away, capped below the kaiju
-- threshold. Clears the saved fields. Returns (stars, seconds already spent toward the next decay step).
local function takeSavedStars(player, data)
	if type(data) ~= "table" then
		return 0, 0
	end
	local saved = math.floor(tonumber(data.SavedStars) or 0)
	local at = tonumber(data.SavedStarsAt) or 0
	data.SavedStars = 0
	data.SavedStarsAt = 0
	if saved <= 0 or at <= 0 or not isFighter(faction(player)) then
		return 0, 0
	end
	local step = math.max(1, Config.PvP.StarDecaySeconds)
	local away = math.max(0, os.time() - at)
	local decayed = math.floor(away / step)
	local needed = (Config.Kaiju and Config.Kaiju.StarsNeeded) or Config.PvP.MaxStars
	local cap = math.max(0, math.min(Config.PvP.MaxStars, needed - 1))
	local n = math.clamp(saved - decayed, 0, cap)
	return n, away - decayed * step
end

-- CR-M11: a Wanted Horns logging out while combat-tagged pays the bounty (+ honor, like a bounty KO) to the last Halo
-- attacker, once per pair per PairRewardCooldown. Returns true when paid (the stars count as claimed).
local function payLeaveBounty(player)
	-- CR-M11 / CR-M2: a server shutdown is not the player's choice; keep the stars (saved by CR-M12) instead
	local PS = S.PlayerService
	if PS and type(PS.IsShuttingDown) == "function" then
		local okS, closing = pcall(PS.IsShuttingDown)
		if okS and closing == true then
			return false
		end
	end
	local s = stars[player] or 0
	if s < 1 or faction(player) ~= "Horns" or kstate(player) == "Active" then
		return false -- an Active kaiju's logout is resolved by KaijuService
	end
	local C = S.CombatService
	if not C.IsInCombat(player) then
		return false
	end
	local a = C.GetLastPvPAttacker(player)
	if a == nil or a == player or not isPlaying(a) or not S.PlayerService.IsReady(a) or faction(a) ~= "Halo" then
		return false
	end
	if not pairReady(a, player.UserId, "ko", Config.PvP.PairRewardCooldown) then
		return false
	end
	local bully = bountyBullyStacks(player) -- 0 when this bully's bounty was already claimed
	local bounty = Config.Bounty(num(player, "Level", 1), s, bully)
	local honor = math.max(1, s)
	if bounty > 0 then
		if bully > 0 then
			claimBullyBounty(player)
		end
		S.ProgressionService.AddBankGold(a, bounty, "Bounty")
	end
	S.PlayerService.AddStat(a, "Honor", honor)
	notify(a, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
	if s >= Config.PvP.GlowStars and bounty > 0 then
		Net.NotifyAll(fmt("BountyAnnounce", Util.PlayerDisplayName(a), Util.FormatNumber(bounty)))
	end
	return true
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player, data)
	-- CR-M12: bring back the stars saved at the last leave (decayed); failures just start clean
	local okSaved, restored, partial = pcall(takeSavedStars, player, data or S.PlayerService.GetData(player))
	if not okSaved then
		Util.Warn(TAG, "saved stars restore failed: " .. tostring(restored))
		restored, partial = 0, 0
	end
	stars[player] = restored
	lastStarChange[player] = os.clock() - (restored > 0 and partial or 0)
	protectedUntil[player] = 0
	player:SetAttribute("WantedStars", 0)
	player:SetAttribute("Bounty", 0)
	player:SetAttribute("Rookie", rookieAttr(player))
	player:SetAttribute("Protected", false)
	player:SetAttribute("RevengeTargetId", 0)
	player:SetAttribute("RevengeUntil", 0)
	if restored > 0 then
		refreshStarAttrs(player)
	end
end

local function cleanupPlayer(player)
	clearRevengeInvolving(player)
	stars[player] = nil
	lastStarChange[player] = nil
	protectedUntil[player] = nil
	spawnedAt[player] = nil
	revenge[player] = nil
	dmgLog[player] = nil
	for _, byVictim in dmgLog do
		byVictim[player] = nil
	end
end

local function onPlayerLeaving(player, data)
	-- CR-M11: runs before KaijuService's handler (init order) and while JusticeService still reports the bully
	-- stacks (CR-L1 defers their cleanup)
	local okPay, paid = pcall(payLeaveBounty, player)
	if not okPay then
		Util.Warn(TAG, "leave bounty failed: " .. tostring(paid))
		paid = false
	end
	-- CR-M12: save the unclaimed stars so a rejoin cannot wipe them; a paid leave bounty or an Active kaiju
	-- (KaijuService resolves it) leaves none
	local d = data or S.PlayerService.GetData(player)
	if type(d) == "table" then
		local keep = (paid == true or kstate(player) == "Active") and 0 or (stars[player] or 0)
		-- CR-M12: like SavedBullyAt, back-date by the time already spent toward the next decay step this session
		-- (a queued / siren kaiju refreshes lastStarChange every tick, so into ~ 0 there)
		local step = math.max(1, Config.PvP.StarDecaySeconds)
		local now = os.clock()
		local into = math.clamp(math.floor(now - (lastStarChange[player] or now)), 0, step - 1)
		d.SavedStars = keep
		d.SavedStarsAt = keep > 0 and (os.time() - into) or 0
	end
	-- other services' PlayerLeaving handlers (e.g. KaijuService) may still call ResetStars; clean up after them
	clearRevengeInvolving(player)
	task.defer(cleanupPlayer, player)
end

local function onCharacterSpawned(player, _character, _humanoid, cosmetic)
	if cosmetic then return end -- replacing an appearance never renews spawn protection / the spawn clock
	spawnedAt[player] = os.clock()
	PvPService.Protect(player, Config.PvP.SpawnProtection)
end

-- CR-M15: log each PvP hit with its damage (the applied amount once CR-M10 lands) for the bait check
local function onPlayerDamaged(victim, amount, attacker)
	if victim == nil or attacker == nil then
		return
	end
	amount = tonumber(amount) or 0
	if amount ~= amount or amount <= 0 then
		return
	end
	local now = os.clock()
	local byVictim = dmgLog[attacker]
	if not byVictim then
		byVictim = {}
		dmgLog[attacker] = byVictim
	end
	local hits = byVictim[victim]
	if not hits then
		hits = {}
		byVictim[victim] = hits
	end
	pruneHits(hits, now - Config.Bully.BaitWindow)
	table.insert(hits, { T = now, A = amount })
	while #hits > GUARD.DmgLogMax do
		table.remove(hits, 1)
	end
end

local function onFactionChanged(player)
	PvPService.ResetStars(player)
	-- revenge marks never cross a faction change (and Neutral never gives/gets revenge; A6)
	clearRevengeInvolving(player)
	if isPlaying(player) then
		setAttr(player, "Rookie", rookieAttr(player))
	end
end

------------------------------------------------------------------ lifecycle
function PvPService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	S.CombatService.PlayerDamaged:Connect(onPlayerDamaged)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
end

function PvPService.Start()
	local okBoard, errBoard = pcall(updateBoard)
	if not okBoard then
		Util.Warn(TAG, "board update failed: " .. tostring(errBoard))
	end

	task.spawn(function()
		local boardAcc = 0
		local pruneAcc = 0
		while true do
			task.wait(LOOP_INTERVAL)
			local now = os.clock()
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tickPlayer, p, now)
				if not ok then
					warnLoop(err)
				end
			end

			boardAcc += LOOP_INTERVAL
			if boardAcc >= Config.PvP.BoardRefresh then
				boardAcc = 0
				local ok, err = pcall(updateBoard)
				if not ok then
					warnLoop(err)
				end
			end

			pruneAcc += LOOP_INTERVAL
			if pruneAcc >= PRUNE_INTERVAL then
				pruneAcc = 0
				local ok, err = pcall(pruneDmgLog, now)
				if not ok then
					warnLoop(err)
				end
			end
		end
	end)

	print("[PvPService] started")
end

return PvPService
]]></ProtectedString>
				<string name="ScriptGuid">{A462D111-0918-47D5-BE74-C719CC27B13E}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PvPService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">5788d013bf1591860ad23e240000de95</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX6E846C5C2CA44363A08DC130BD01EA6A">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CombatService.luau : class swing patterns, charge & release ("자동은 장전, 손은 발사"), damage formulas,
-- player damage / heal, regen, auto-attack and the death pipeline (the ONLY KO entry point).
-- Server-authoritative: clients only send Swing / Release / SetAutoAttack intents.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "CombatService"

local CombatService = {}

------------------------------------------------------------------ public signals (top level)
-- info = { Stacks, Auto, Perfect, Center, Radius, Total, MonstersHit, PlayersHit, Healed = { Player } }
-- (Total = HP really removed, CR-M10; the Release Fx shows the dealt numbers)
CombatService.Released = Util.Signal.new()
-- (victim, amount, attacker) : fired by DamagePlayer only when attacker ~= nil, after the damage.
-- amount = HP actually removed (CR-M10: no overkill; 0 under a ForceField, still fired for the bait log)
CombatService.PlayerDamaged = Util.Signal.new()

local S = nil

------------------------------------------------------------------ private constants
-- addendum H3 auto-loop yield = class SwingInterval + Config.Combat.ManualYieldPad (CR-M17); addendum M3 hint =
-- Config.Text.AutoUnderAttack at most once per Config.Combat.AutoPvPHintCooldown (CombatService.DamagePlayer is the
-- single sender)
local MANUAL_GRACE = 0.2 -- a manual request this close to the swing-ready time is queued (network jitter on "hold")
local MANUAL_QUEUE_RETRIES = 3 -- timer-precision retries for a queued manual swing
local WHIFF_REACH = 12 -- studs in front of the player used as the visual target of a whiffed ranged swing
local LOOP_WARN_INTERVAL = 10 -- seconds between two warnings of the same loop

-- factions that take part in PvP / goose tug (addendum A6: "Neutral" and "None" never do)
local PVP_FACTIONS = { Halo = true, Horns = true }

-- A15 hit feel: every damaged player gets a "Pain" Fx to ALL clients (pain sticker over that player), at most one per
-- victim per PAIN_GAP s; Big = crit or >= BIG_FRACTION of the victim's MaxHealth. Monsters a swing / release lands on
-- are shoved SHOVE_* studs (MonsterService.Shove applies the zone / water / owner rules) SHOVE_DELAY[attack][class] s
-- after the damage, so the slide starts when clients show the hit (contact frame / projectile flight).
-- Config.HitReact, fallbacks.
local HIT_REACT = Config.HitReact or {}
local REACT = {
	PAIN_GAP = HIT_REACT.PainGap or 0.4,
	BIG_FRACTION = HIT_REACT.BigHitFraction or 0.5,
	SHOVE_SWING = HIT_REACT.ShoveSwing or 1.2,
	SHOVE_CRIT = HIT_REACT.ShoveCrit or 1.6,
	SHOVE_RELEASE = HIT_REACT.ShoveRelease or 2,
	SHOVE_DELAY = type(HIT_REACT.ShoveDelay) == "table" and HIT_REACT.ShoveDelay or {},
}

-- review R1 tuning
local TUNE = {
	-- CR-L49: Swing / Release Fx go to the attacker + players whose root is within FxCullDistance + FX_SEND_PAD + the
	-- attack extent of the center (pad >= camera max zoom: 40, kaiju 60; clients cull from the camera)
	FX_CULL = (Config.Visuals and Config.Visuals.FxCullDistance) or 150,
	FX_SEND_PAD = 60,
	AUTO_TOAST_GAP = 1, -- CR-L22: no manual "need stacks" toast this soon after an automatic release
	-- Approved clips: cosmetic contact/flight only; damage, charge and cooldown still resolve immediately.
	MOTION = {
		Swing = {
			Warrior = { Contact = 0.23 },
			Mage = { Launch = 0.24, Flight = 0.2, Contact = 0.44 },
			Archer = { Launch = 0.22, Flight = 0.15, Contact = 0.37 },
		},
		Release = {
			Warrior = { Contact = 0.24 },
			Mage = { Launch = 0.35, Contact = 0.35 },
			Archer = { Launch = 0.18, Contact = 0.4 },
		},
	},
}

------------------------------------------------------------------ per-player state (session only)
local charge = {} -- [Player] = stacks (may be fractional)
local perfectUntil = {} -- [Player] = server time (Util.Now) of the PERFECT window end, 0 = none
local nextSwingAt = {} -- [Player] = os.clock() when the next swing is allowed (shared by manual + auto)
local lastSwingAuto = {} -- [Player] = true if the last executed swing was an auto swing
local lastManualAt = {} -- [Player] = os.clock() of the last accepted manual swing request
local pendingManual = {} -- [Player] = true while one queued manual swing waits for the cooldown
local lastDamagedAt = {} -- [Player] = os.clock() of the last damage of any kind
local lastPvPAttacker = {} -- [Player] = { Player = Player, T = os.clock() }
local lastPvPTime = {} -- [Player] = os.clock() of the last PvP damage dealt or received
local autoHintAt = {} -- [Player] = os.clock() of the last M3 hint
local painAt = {} -- [Player] = os.clock() of the last "Pain" Fx (A15)
local lastLoopWarn = {} -- [loopName] = os.clock()
local guard = {
	allyStackAt = {}, -- CR-H1: [Player] = os.clock() this player last RECEIVED the Halo ally +stacks
	autoReleasedAt = {}, -- CR-L22: [Player] = os.clock() of the last automatic release
	acLogAt = {}, -- CR-H2: [Player] = os.clock() of the last implausible-position log
}

------------------------------------------------------------------ small helpers
local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function numAttr(player, key, default)
	local v = player:GetAttribute(key)
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return v
end

local function byDist(a, b)
	return a.Dist < b.Dist
end

local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= LOOP_WARN_INTERVAL then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

-- faction(p) = S.FactionService.GetFaction(p)
local function faction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then
		return "None"
	end
	return f
end

-- perks = S.FactionService.GetPerks(p) (falls back to the Config table / None)
local function perksOf(player)
	local p = S.FactionService.GetPerks(player)
	if type(p) ~= "table" then
		p = Config.Factions[faction(player)] or Config.Factions.None
	end
	return p
end

-- cls(p) = S.ClassService.GetClassDef(p)
local function cls(player)
	local c = S.ClassService.GetClassDef(player)
	if type(c) ~= "table" then
		c = Config.Classes.Warrior
	end
	return c
end

-- stars(p) = S.PvPService.GetStars(p)
local function stars(player)
	local n = S.PvPService.GetStars(player)
	if type(n) ~= "number" then
		return 0
	end
	return n
end

-- kstate(p) = S.KaijuService.GetState(p)
local function kstate(player)
	local st = S.KaijuService.GetState(player)
	if type(st) ~= "string" then
		return "None"
	end
	return st
end

local function chargeCapOf(player)
	local cap = perksOf(player).ChargeCap
	if type(cap) ~= "number" or cap <= 0 then
		cap = Config.Factions.None.ChargeCap
	end
	return cap
end

-- goose body center if this player's swings can count on it (Halo / Horns only), else nil
local function goosePositionFor(player)
	if not PVP_FACTIONS[faction(player)] then
		return nil
	end
	local pos = S.GooseService.GetPosition()
	if typeof(pos) ~= "Vector3" then
		return nil
	end
	return pos
end

local function weaponPosition(character, classId, fallback)
	local weapon = character:FindFirstChild("WeaponModel")
	local muzzle = weapon and weapon:GetAttribute("Class") == classId
		and weapon:FindFirstChild("AttackMuzzle", true)
	if muzzle and muzzle:IsA("Attachment") and muzzle.Parent and muzzle.Parent:IsA("BasePart") then
		return muzzle.WorldPosition
	end
	local hand = classId == "Archer" and Util.FindPart(character, "LeftHand", "Left Arm")
		or (classId ~= "Archer" and Util.FindPart(character, "RightHand", "Right Arm"))
	if hand then
		return hand.Position
	end
	return fallback
end

-- a point `reach` studs in front of the root on the ground plane (visual target of a whiffed ranged swing)
local function forwardPoint(root, reach)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end
	return root.Position + flat * reach
end

-- CR-H2: true when this Swing / Release must be ignored. The zone level gate (the attacker stands in a zone whose
-- MinLevel is above their Level: a teleport hop into a gated zone) is always enforced. ZoneService.IsPlausible logs
-- an implausible position itself ("suspicious move (check, ...)", shared LogCooldown with its zone loop) and returns
-- false ONLY while Config.AntiCheat.Enforce is true, so in log-only mode nothing is blocked or logged here. The
-- Swing / Release line below (at most once per AntiCheat.LogCooldown s) appears only when enforcing; `enforce` is
-- re-checked so blocking stays gated on Config even if ZoneService ever returns false without it.
local function attackBlocked(player, root, what)
	local pos = root.Position
	local zone = Config.ZoneAt(pos)
	if (zone.MinLevel or 1) > numAttr(player, "Level", 1) then
		return true
	end
	local zs = S.ZoneService
	if not (zs and type(zs.IsPlausible) == "function") then
		return false
	end
	local ok, plausible = pcall(zs.IsPlausible, player, pos)
	if not ok then
		loopWarn("IsPlausible", plausible)
		return false
	end
	if plausible ~= false then
		return false
	end
	local ac = Config.AntiCheat or {}
	local enforce = ac.Enforce == true
	local now = os.clock()
	if now - (guard.acLogAt[player] or -math.huge) >= (ac.LogCooldown or 10) then
		guard.acLogAt[player] = now
		Util.Warn(
			TAG,
			string.format(
				"CR-H2%s implausible %s position: %s (%d) at %s",
				enforce and "" or " (log only)",
				tostring(what),
				player.Name,
				player.UserId,
				tostring(pos)
			)
		)
	end
	return enforce
end

-- CR-L49: a Swing / Release Fx for the attacker and the players near `center` only (`extent` = the attack's reach
-- around the center); everyone else would cull it on the client anyway
local function fxNear(attacker, kind, center, extent, data)
	local reach = TUNE.FX_CULL + TUNE.FX_SEND_PAD + math.max(0, tonumber(extent) or 0)
	for _, rp in Players:GetPlayers() do
		local send = rp == attacker
		if not send then
			local r = Util.GetRoot(rp)
			send = r ~= nil and (r.Position - center).Magnitude <= reach
		end
		if send then
			Net.Fx(rp, kind, data)
		end
	end
end

------------------------------------------------------------------ charge
local function publishCharge(player)
	if player.Parent == nil then
		return
	end
	player:SetAttribute("Charge", charge[player] or 0)
	player:SetAttribute("ChargeCap", chargeCapOf(player))
	player:SetAttribute("PerfectUntil", perfectUntil[player] or 0)
end

local function resetCharge(player)
	charge[player] = 0
	perfectUntil[player] = 0
	publishCharge(player)
end

local function addCharge(player, amount)
	if type(amount) ~= "number" or amount <= 0 then
		return
	end
	if player.Parent == nil then
		return
	end
	local cap = chargeCapOf(player)
	local value = math.min(cap, (charge[player] or 0) + amount)
	charge[player] = value
	if value >= cap and (perfectUntil[player] or 0) == 0 then
		perfectUntil[player] = Util.Now() + Config.Charge.PerfectWindow
	end
	publishCharge(player)
end

------------------------------------------------------------------ target selection
-- alive monsters this player may hit within `radius` (flat) of `point`, nearest first: { { Rec, Pos, Dist } }
-- (addendum C2: always passes the attacking player; personal monsters of other players are filtered here too)
-- CR-H2: zone monsters of a zone whose MinLevel is above the attacker's Level are never targets (personal: always)
local function monstersNear(player, point, radius)
	local out = {}
	if radius <= 0 then
		return out
	end
	local list = S.MonsterService.GetMonstersInRadius(point, radius, player)
	if type(list) ~= "table" then
		return out
	end
	local level = numAttr(player, "Level", 1)
	for _, rec in list do
		local zone = type(rec) == "table" and rec.Owner == nil and Config.Zones[rec.ZoneId] or nil
		local gated = zone ~= nil and (zone.MinLevel or 1) > level
		if type(rec) == "table" and rec.Alive and (rec.Owner == nil or rec.Owner == player) and not gated then
			local root = rec.Root
			if root and root.Parent then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius then
					table.insert(out, { Rec = rec, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- other players `attacker` may damage (S.PvPService.CanAttack) within `radius` (flat) of `point`, nearest first:
-- { { Player, Pos, Dist } }. Neutral / None never attack and are never attacked (addendum A6).
local function playersNear(attacker, point, radius)
	local out = {}
	if radius <= 0 or not PVP_FACTIONS[faction(attacker)] then
		return out
	end
	for _, v in S.PlayerService.GetReadyPlayers() do
		if v ~= attacker and v.Parent and PVP_FACTIONS[faction(v)] and Util.IsAlive(v) then
			local root = Util.GetRoot(v)
			if root then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius and S.PvPService.CanAttack(attacker, v) == true then
					table.insert(out, { Player = v, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- other alive Halo players within the party-aura radius of the attacker
local function countAuraAllies(attacker, radius)
	if type(radius) ~= "number" or radius <= 0 then
		return 0
	end
	local root = Util.GetRoot(attacker)
	if not root then
		return 0
	end
	local n = 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if p ~= attacker and p.Parent and faction(p) == "Halo" and Util.IsAlive(p) then
			local r = Util.GetRoot(p)
			if r and Util.FlatDistance(r.Position, root.Position) <= radius then
				n += 1
			end
		end
	end
	return n
end

------------------------------------------------------------------ damage formulas (public)
-- additive bonus sum
function CombatService.GetDamageBonus(attacker, victim)
	local perks = perksOf(attacker)
	local bonus = perks.DamageBonus or 0
	bonus += stars(attacker) * Config.PvP.StarDamageBonus
	if faction(attacker) == "Halo" and (perks.PartyAuraPerAlly or 0) > 0 then
		local allies = math.min(perks.PartyAuraMaxAllies or 0, countAuraAllies(attacker, perks.PartyAuraRadius))
		bonus += perks.PartyAuraPerAlly * allies
	end
	if victim ~= nil and S.PvPService.HasRevenge(attacker, victim) == true then
		bonus += Config.Revenge.Bonus
	end
	return bonus
end

-- multiplicative factor: Size Justice S x bully factor (JusticeService) x ranged-vs-player factor
function CombatService.GetDamageMult(attacker, victim)
	local c = cls(attacker)
	local mult = S.JusticeService.GetDamageMult(attacker)
	if type(mult) ~= "number" or mult ~= mult then
		mult = 1
	end
	if victim ~= nil and c.Ranged then
		mult *= (c.PvPMult or 1)
	end
	return mult
end

-- NORMAL per-target monster hit (unrounded), before the 50% immediate rule
function CombatService.ComputeMonsterHit(attacker, allowCrit)
	local c = cls(attacker)
	local level = numAttr(attacker, "Level", 1)
	local tier = numAttr(attacker, "WeaponTier", 1)
	local dmg = Config.WeaponDamage(tier, level)
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, nil))
		* CombatService.GetDamageMult(attacker, nil)
	local crit = allowCrit == true and Util.Random:NextNumber() < Config.Combat.CritChance
	if crit then
		dmg *= Config.Combat.CritMult
	end
	return dmg, crit
end

-- NORMAL per-target PvP hit (unrounded): based on the victim's BASE MaxHealth (no Size Justice, no kaiju)
function CombatService.ComputePvPHit(attacker, victim)
	local c = cls(attacker)
	local aLevel = numAttr(attacker, "Level", 1)
	local aTier = numAttr(attacker, "WeaponTier", 1)
	local vLevel = numAttr(victim, "Level", 1)
	local vTier = numAttr(victim, "WeaponTier", 1)
	local vClass = S.ClassService.GetClass(victim)
	local base = Config.MaxHealth(vLevel, faction(victim), vClass) * Config.PvP.HitPctOfMaxHP
	local vWeapon = Config.WeaponDamage(vTier, vLevel)
	local ratio = Config.PvP.PowerRatioMax
	if vWeapon > 0 then
		ratio = Config.WeaponDamage(aTier, aLevel) / vWeapon
	end
	ratio = math.clamp(ratio, Config.PvP.PowerRatioMin, Config.PvP.PowerRatioMax)
	return base
		* ratio
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, victim))
		* CombatService.GetDamageMult(attacker, victim)
end

------------------------------------------------------------------ heal / damage (public)
function CombatService.HealPlayer(player, amount)
	if not isPlayer(player) then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return 0 -- never revive
	end
	local missing = hum.MaxHealth - hum.Health
	if missing <= 0 then
		return 0
	end
	local heal = math.min(Util.RoundDamage(amount), missing)
	hum.Health = hum.Health + heal
	return heal
end

local function tagCombat(player)
	lastPvPTime[player] = os.clock()
	if player.Parent then
		player:SetAttribute("InCombatUntil", Util.Now() + Config.PvP.CombatTagTime)
	end
end

-- A15: "Pain" Fx to every client (pain sticker / flinch over the victim), throttled per victim. A lethal hit is left to
-- the KO effects.
local function sendPain(victim, hum, rootPos, applied, crit)
	if applied <= 0 or hum.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - (painAt[victim] or -math.huge) < REACT.PAIN_GAP then
		return
	end
	painAt[victim] = now
	local big = crit == true or (hum.MaxHealth > 0 and applied >= hum.MaxHealth * REACT.BIG_FRACTION)
	Net.Fx(nil, "Pain", { UserId = victim.UserId, Pos = rootPos, Big = big })
end

-- attacker nil = monster (or any non-player source); crit (optional) = the hit was a critical hit (Pain "Big").
-- Returns the HP actually removed (CR-M10: no overkill, 0 when nothing was applied).
function CombatService.DamagePlayer(victim, amount, attacker, crit)
	if not isPlayer(victim) or victim.Parent == nil then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	if attacker ~= nil and (not isPlayer(attacker) or attacker == victim) then
		attacker = nil
	end
	-- addendum A6: Neutral (and unassigned) players never deal or receive player damage
	if attacker and (not PVP_FACTIONS[faction(attacker)] or not PVP_FACTIONS[faction(victim)]) then
		return 0
	end
	if not Util.IsAlive(victim) then
		return 0
	end
	local hum = Util.GetHumanoid(victim)
	local root = Util.GetRoot(victim)
	if not hum or not root then
		return 0
	end

	amount = Util.RoundDamage(amount)
	local now = os.clock()
	lastDamagedAt[victim] = now
	if attacker then
		-- bookkeeping BEFORE the damage so a lethal hit is always credited by the death pipeline
		lastPvPAttacker[victim] = { Player = attacker, T = now }
		tagCombat(victim)
		tagCombat(attacker)
	end

	local rootPos = root.Position
	local before = hum.Health
	hum:TakeDamage(amount) -- respects ForceField
	local applied = math.max(0, before - hum.Health)
	S.PlayerService.MarkActive(victim)
	local okPain, errPain = pcall(sendPain, victim, hum, rootPos, applied, crit)
	if not okPain then
		loopWarn("Pain", errPain)
	end

	-- CR-M23: the victim always sees the hit number + red edge, whoever the attacker is (PvP swings, kaiju stomps)
	if applied > 0 then
		Net.Fx(victim, "Hurt", { Pos = rootPos, Amount = applied })
	end

	if attacker then
		-- addendum M3: AFK-in-PvP hint for players relying on auto attack
		if
			victim:GetAttribute("AutoAttack") == true
			and now - (autoHintAt[victim] or -math.huge) >= Config.Combat.AutoPvPHintCooldown
		then
			autoHintAt[victim] = now
			Net.Notify(victim, Config.Text.AutoUnderAttack, "bad")
		end
		CombatService.PlayerDamaged:Fire(victim, applied, attacker) -- CR-M10: real damage (fired even when 0)
	end
	return applied
end

------------------------------------------------------------------ queries (public)
function CombatService.IsInCombat(player)
	local t = lastPvPTime[player]
	return t ~= nil and os.clock() - t <= Config.PvP.CombatTagTime
end

function CombatService.GetLastDamagedAt(player)
	return lastDamagedAt[player] or 0
end

function CombatService.GetLastPvPAttacker(player)
	local e = lastPvPAttacker[player]
	if not e then
		return nil
	end
	if os.clock() - e.T > Config.PvP.CombatTagTime then
		return nil
	end
	local p = e.Player
	if not p or p.Parent == nil then
		return nil
	end
	return p
end

function CombatService.GetCharge(player)
	return charge[player] or 0
end

-- Studio manual QA sets up Q/insufficient-MP cases through Main's real service registry.
function CombatService.DebugSetCharge(player, amount)
	if not game:GetService("RunService"):IsStudio() or not isPlayer(player)
		or type(amount) ~= "number" or amount ~= amount or amount == math.huge or amount == -math.huge then
		return false
	end
	charge[player] = math.clamp(amount, 0, chargeCapOf(player))
	perfectUntil[player] = 0
	publishCharge(player)
	return true
end

------------------------------------------------------------------ lifesteal
local function applyLifesteal(player, perks, total)
	local rate = perks.Lifesteal or 0
	if rate <= 0 or total <= 0 then
		return
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return
	end
	-- CR-M8: an Active kaiju's cap uses its health WITHOUT the kaiju multiplier (x20 MaxHealth outhealed the raid)
	local capBase = hum.MaxHealth
	if kstate(player) == "Active" and S.KaijuService and type(S.KaijuService.GetHealthMult) == "function" then
		local okK, km = pcall(S.KaijuService.GetHealthMult, player)
		if okK and type(km) == "number" and km > 1 then
			capBase = capBase / km
		end
	end
	CombatService.HealPlayer(player, math.min(total * rate, capBase * (perks.LifestealCapPct or 0)))
end

-- CR-M10: damage a monster and return the HP it actually lost (no overkill; 0 when the hit was refused).
-- killed = DamageMonster's own result
local function damageMonster(rec, dealt, player, crit)
	local hpBefore = math.max(0, tonumber(rec.HP) or 0)
	local killed = S.MonsterService.DamageMonster(rec, dealt, player, crit)
	local applied = math.max(0, hpBefore - math.max(0, tonumber(rec.HP) or 0))
	return killed, applied
end

------------------------------------------------------------------ A15 monster shove
-- a small slide of a monster my hit landed on, away from `fromPos` (cosmetic: a failure never breaks the hit loop)
local function shoveMonster(rec, fromPos, studs, player)
	if not rec.Alive or type(S.MonsterService.Shove) ~= "function" then
		return
	end
	local ok, err = pcall(S.MonsterService.Shove, rec, fromPos, studs, player)
	if not ok then
		loopWarn("Shove", err)
	end
end

-- Cosmetic shove follows the same contact frame that the Fx packet announces.
local function shoveLater(attack, classId, rec, fromPos, studs, player)
	local byClass = REACT.SHOVE_DELAY[attack]
	local motion = TUNE.MOTION[attack] and TUNE.MOTION[attack][classId]
	local d = motion and motion.Contact or (type(byClass) == "table" and tonumber(byClass[classId]) or 0)
	if d > 0 then
		local character = Util.GetCharacter(player)
		task.delay(math.min(d, 1), function()
			if player.Parent and Util.IsAlive(player) and Util.GetCharacter(player) == character
				and cls(player).Id == classId then shoveMonster(rec, fromPos, studs, player) end
		end)
	else
		shoveMonster(rec, fromPos, studs, player)
	end
end

------------------------------------------------------------------ swing (public)
function CombatService.Swing(player, isManual)
	isManual = isManual == true
	if not isPlayer(player) or player.Parent == nil or not Util.IsAlive(player) then
		return
	end
	local character = Util.GetCharacter(player)
	local root = Util.GetRoot(player)
	if not character or not root then
		return
	end
	-- CR-H2: zone level gate + movement plausibility (before the cooldown: a refused swing costs nothing)
	if attackBlocked(player, root, "Swing") then
		return
	end

	-- 1. shared swing cooldown (manual + auto)
	local now = os.clock()
	if now < (nextSwingAt[player] or 0) then
		return
	end
	local c = cls(player)
	if c.Id == "Mage" and not S.VitalsService.TrySpendMana(player, Config.Vitals.MageSwingCost, not isManual) then
		return
	end
	nextSwingAt[player] = now + (c.SwingInterval or 1)
	lastSwingAuto[player] = not isManual
	if S.ExpressionService then S.ExpressionService.Attack(player) end

	local pos = root.Position
	local fac = faction(player)
	local perks = perksOf(player)
	local goosePos = goosePositionFor(player)
	local gooseReach = Config.Goose.HitRadius
	local range = c.Range or 10

	-- 2. select targets by class pattern
	local monsters = {} -- { { Rec, Pos, Dist } }
	local victims = {} -- { { Player, Pos, Dist } }
	local hitGoose = false
	local center = pos
	local radius = range
	local targets = {}

	if c.Pattern == "Splash" then
		radius = c.Splash or 0
		local pickPos, pickDist, pickIsGoose = nil, math.huge, false
		local nearMon = monstersNear(player, pos, range)
		if nearMon[1] then
			pickPos, pickDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if isManual then
			local nearPl = playersNear(player, pos, range)
			if nearPl[1] and nearPl[1].Dist < pickDist then
				pickPos, pickDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if goosePos then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach and d < pickDist then
				pickPos, pickDist, pickIsGoose = goosePos, d, true
			end
		end
		if pickPos then
			center = pickPos
			monsters = monstersNear(player, center, radius)
			if isManual then
				victims = playersNear(player, center, radius)
			end
			hitGoose = goosePos ~= nil
				and (pickIsGoose or Util.FlatDistance(goosePos, center) <= radius + gooseReach)
		else
			center = forwardPoint(root, math.min(range, WHIFF_REACH)) -- whiff: the orb flies forward
		end
		targets = { center }
	elseif c.Pattern == "Multi" then
		radius = 0
		local maxTargets = c.Targets or 0
		local candidates = {}
		for _, m in monstersNear(player, pos, range) do
			table.insert(candidates, { Kind = "M", Entry = m, Pos = m.Pos, Dist = m.Dist })
		end
		if isManual then
			for _, v in playersNear(player, pos, range) do
				table.insert(candidates, { Kind = "P", Entry = v, Pos = v.Pos, Dist = v.Dist })
			end
		end
		if goosePos then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach then
				table.insert(candidates, { Kind = "G", Pos = goosePos, Dist = d })
			end
		end
		table.sort(candidates, byDist)
		for i, cand in candidates do
			if maxTargets > 0 and i > maxTargets then
				break
			end
			table.insert(targets, cand.Pos)
			if cand.Kind == "M" then
				table.insert(monsters, cand.Entry)
			elseif cand.Kind == "P" then
				table.insert(victims, cand.Entry)
			else
				hitGoose = true
			end
		end
		if #targets == 0 then
			targets = { forwardPoint(root, math.min(range, WHIFF_REACH)) } -- whiff: the arrow flies forward
		end
	else -- "Around" (default): everything within Range of self
		monsters = monstersNear(player, pos, range)
		if isManual then
			victims = playersNear(player, pos, range)
		end
		hitGoose = goosePos ~= nil and Util.FlatDistance(goosePos, pos) <= range + gooseReach
	end

	local hits = {}
	local totalDealt, monstersHit, playersHit = 0, 0, 0

	-- 3. monsters: 50% of the normal hit right away (crit rolled per target)
	if #monsters > 0 then
		local base = CombatService.ComputeMonsterHit(player, false)
		for _, m in monsters do
			local rec = m.Rec
			if rec.Alive then
				local crit = Util.Random:NextNumber() < Config.Combat.CritChance
				local d = base * (crit and Config.Combat.CritMult or 1)
				local dealt = Util.RoundDamage(d * Config.Charge.SwingImmediate)
				local killed, applied = damageMonster(rec, dealt, player, crit)
				if killed or applied > 0 then -- 0 = refused by MonsterService (owner / zone rules): not a hit
					if not killed then
						shoveLater("Swing", c.Id, rec, pos, crit and REACT.SHOVE_CRIT or REACT.SHOVE_SWING, player) -- A15
					end
					table.insert(hits, { P = m.Pos, A = dealt, C = crit, K = "M" }) -- the number shows the hit as dealt
					totalDealt += applied -- CR-M10: lifesteal counts real damage only
					monstersHit += 1
				end
			end
		end
	end

	-- 4. players (manual swings only; already validated with CanAttack)
	for _, v in victims do
		local vp = v.Player
		if vp.Parent and Util.IsAlive(vp) then
			local dealt = Util.RoundDamage(CombatService.ComputePvPHit(player, vp) * Config.Charge.SwingImmediate)
			totalDealt += CombatService.DamagePlayer(vp, dealt, player) or 0 -- CR-M10
			table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P", V = vp.UserId }) -- CR-M23: V = victim
			playersHit += 1
		end
	end
	if playersHit > 0 then
		S.PvPService.BreakProtection(player)
	end

	-- 5. golden goose: no damage, no charge. CR-L21: the number is what RegisterHit really counted (0 = none)
	if hitGoose and goosePos then
		local okG, counted = pcall(S.GooseService.RegisterHit, player, isManual)
		if not okG then
			loopWarn("GooseHit", counted)
			counted = 0
		elseif counted == nil then
			counted = isManual and Config.Goose.ManualCount or Config.Goose.AutoCount -- GooseService without a return
		end
		if type(counted) == "number" and counted == counted and counted > 0 then
			table.insert(hits, {
				P = goosePos,
				A = math.floor(counted * 10 + 0.5) / 10,
				C = false,
				K = "G",
			})
		end
	end

	-- 6. charge
	if monstersHit + playersHit > 0 then
		addCharge(player, isManual and (c.ChargeManual or 0) or (c.ChargeAuto or 0))
	end

	-- 7. lifesteal (Horns)
	applyLifesteal(player, perks, totalDealt)

	-- 8. activity
	local anyHit = monstersHit + playersHit > 0 or hitGoose
	if isManual or anyHit then
		S.PlayerService.MarkActive(player)

		-- 9. visuals for the attacker + everyone near (manual whiffs too, with empty Hits). CR-L49: the extent covers
		-- the hand (Splash center up to Range away) and Multi targets (radius 0, up to Range away)
		fxNear(player, "Swing", center, math.max(radius, range), {
			UserId = player.UserId,
			Character = character,
			Class = c.Id,
			Faction = fac,
			From = weaponPosition(character, c.Id, pos),
			ContactDelay = TUNE.MOTION.Swing[c.Id] and TUNE.MOTION.Swing[c.Id].Contact,
			LaunchDelay = TUNE.MOTION.Swing[c.Id] and TUNE.MOTION.Swing[c.Id].Launch,
			FlightTime = TUNE.MOTION.Swing[c.Id] and TUNE.MOTION.Swing[c.Id].Flight,
			Pos = center,
			Radius = radius,
			Targets = targets,
			Hits = hits,
			Manual = isManual, -- A15: clients kick the camera on manual hits only
		})
	end
end

------------------------------------------------------------------ release (public)
function CombatService.Release(player, isAuto)
	isAuto = isAuto == true
	if not isPlayer(player) or player.Parent == nil or not Util.IsAlive(player) then
		return
	end
	local root = Util.GetRoot(player)
	if not root then
		return
	end
	-- CR-H2: zone level gate + movement plausibility (the charge is kept)
	if attackBlocked(player, root, "Release") then
		return
	end

	-- 1. enough stacks?
	local n = math.floor(charge[player] or 0)
	if n < Config.Charge.MinRelease then
		if isAuto then
			-- defensive: never keep re-triggering an automatic release that cannot happen
			if (perfectUntil[player] or 0) ~= 0 then
				perfectUntil[player] = 0
				publishCharge(player)
			end
		elseif os.clock() - (guard.autoReleasedAt[player] or -math.huge) >= TUNE.AUTO_TOAST_GAP then
			-- CR-L22: a late manual press right after the automatic release already spent the charge: no red toast
			Net.Notify(player, string.format(Config.Text.ReleaseNeed, Config.Charge.MinRelease), "bad")
		end
		return
	end

	-- 2. PERFECT window (manual only). CR-L22: + PerfectGrace so a press at the very end still counts (latency)
	local pu = perfectUntil[player] or 0
	local perfect = (not isAuto) and pu > 0 and pu + (Config.Charge.PerfectGrace or 0) > Util.Now()

	if not S.VitalsService.TrySpendMana(player, Config.Vitals.ReleaseCost, isAuto) then return end
	if S.ExpressionService then S.ExpressionService.Attack(player) end
	local c = cls(player)
	local fac = faction(player)
	local perks = perksOf(player)

	-- 8 (early). consume the charge first so a failure below can never allow a double release
	charge[player] = 0
	perfectUntil[player] = 0
	publishCharge(player)
	if isAuto then
		guard.autoReleasedAt[player] = os.clock() -- CR-L22
	end

	-- 3. center + radius
	local pos = root.Position
	local center = pos
	if c.ReleaseCenter == "Target" then
		local range = c.Range or 10
		local bestPos, bestDist = nil, math.huge
		local nearMon = monstersNear(player, pos, range)
		if nearMon[1] then
			bestPos, bestDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if not isAuto then
			local nearPl = playersNear(player, pos, range)
			if nearPl[1] and nearPl[1].Dist < bestDist then
				bestPos, bestDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if bestPos then
			center = bestPos
		end
	end
	local radius = Config.ReleaseRadius(n)
	local releaseMult = c.ReleaseMult or 1

	local hits = {}
	-- total = HP really removed (CR-M10: heal / lifesteal / Released.Total); shownTotal = the dealt numbers (Fx)
	local total, shownTotal, monstersHit, playersHit = 0, 0, 0, 0

	-- 4. monsters (never crit)
	local monsters = monstersNear(player, center, radius)
	if #monsters > 0 then
		local D = CombatService.ComputeMonsterHit(player, false)
		local dealt = Util.RoundDamage(Config.ReleaseDamage(D, n, isAuto) * releaseMult)
		for _, m in monsters do
			if m.Rec.Alive then
				local killed, applied = damageMonster(m.Rec, dealt, player, nil)
				if killed or applied > 0 then -- 0 = refused by MonsterService (owner / zone rules): not a hit
					if not killed then
						-- A15: a blast pushes outward from its center; the monster at the center goes away from me
						local from = Util.FlatDistance(m.Pos, center) > 0.5 and center or pos
						shoveLater("Release", c.Id, m.Rec, from, REACT.SHOVE_RELEASE, player)
					end
					table.insert(hits, { P = m.Pos, A = dealt, C = false, K = "M" })
					total += applied
					shownTotal += dealt
					monstersHit += 1
				end
			end
		end
	end

	-- 5. players (manual releases only), capped at PvPCapPct of the target's current MaxHealth
	-- (CR-M7: an Active kaiju at Kaiju.ReleaseCapPct, so its x20 HP is not 3 shots of saved-up stacks)
	if not isAuto then
		for _, v in playersNear(player, center, radius) do
			local vp = v.Player
			local vHum = Util.GetHumanoid(vp)
			if vp.Parent and vHum and vHum.Health > 0 then
				local D = CombatService.ComputePvPHit(player, vp)
				local capPct = Config.Charge.PvPCapPct
				if kstate(vp) == "Active" then
					capPct = Config.Kaiju.ReleaseCapPct or 0.08
				end
				local raw = math.min(Config.ReleaseDamage(D, n, false) * releaseMult, capPct * vHum.MaxHealth)
				local dealt = Util.RoundDamage(raw)
				total += CombatService.DamagePlayer(vp, dealt, player) or 0 -- CR-M10
				table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P", V = vp.UserId }) -- CR-M23: V = victim
				shownTotal += dealt
				playersHit += 1
			end
		end
		if playersHit > 0 then
			S.PvPService.BreakProtection(player)
		end
	end

	-- 6. Halo release support: heal Halo allies in the radius (self included), +stacks to OTHER allies.
	-- The stack share needs a release that hit something: otherwise Halo groups could pass charge around
	-- forever in a safe town (MinRelease 10 = HaloAllyStacks 10) and farm Release quests / PERFECT charge.
	-- CR-H1: and each receiving ally gets it at most once per Charge.HaloAllyStackCooldown s, or 2+ knights next to
	-- one slime could release in turn forever (3+ even gained stacks per round).
	-- (The heal is HaloHealPct x total, so a whiff heals nothing anyway.)
	local healed = {}
	local shareStacks = monstersHit + playersHit > 0
	local stackCooldown = Config.Charge.HaloAllyStackCooldown or 5
	if perks.ReleaseSupport == true and fac == "Halo" then
		for _, a in S.PlayerService.GetReadyPlayers() do
			if a.Parent and faction(a) == "Halo" and Util.IsAlive(a) then
				local aRoot = Util.GetRoot(a)
				local aHum = Util.GetHumanoid(a)
				if aRoot and aHum and Util.FlatDistance(aRoot.Position, center) <= radius then
					local amount = CombatService.HealPlayer(
						a,
						math.min(Config.Charge.HaloHealPct * total, Config.Charge.HaloHealCapPct * aHum.MaxHealth)
					)
					if a ~= player then
						local t = os.clock()
						if shareStacks and t - (guard.allyStackAt[a] or -math.huge) >= stackCooldown then
							guard.allyStackAt[a] = t -- CR-H1
							addCharge(a, Config.Charge.HaloAllyStacks)
						end
						if amount > 0 then
							table.insert(healed, a)
						end
					end
				end
			end
		end
	end

	-- 7. lifesteal (Horns) on the total
	applyLifesteal(player, perks, total)

	-- 8. activity (charge already reset above)
	if not isAuto then
		S.PlayerService.MarkActive(player)
	end

	-- 9. visuals (CR-L49: the attacker + players near the blast) + signal
	fxNear(player, "Release", center, radius, {
		UserId = player.UserId,
		Character = Util.GetCharacter(player),
		Class = c.Id,
		Faction = fac,
		ContactDelay = TUNE.MOTION.Release[c.Id] and TUNE.MOTION.Release[c.Id].Contact,
		LaunchDelay = TUNE.MOTION.Release[c.Id] and TUNE.MOTION.Release[c.Id].Launch,
		Pos = center,
		Radius = radius,
		Stacks = n,
		Perfect = perfect,
		Auto = isAuto,
		Total = shownTotal, -- the big number = the sum of the hit numbers shown
		Hits = hits,
	})
	CombatService.Released:Fire(player, {
		Stacks = n,
		Auto = isAuto,
		Perfect = perfect,
		Center = center,
		Radius = radius,
		Total = total,
		MonstersHit = monstersHit,
		PlayersHit = playersHit,
		Healed = healed,
	})
end

------------------------------------------------------------------ death pipeline (the only KO entry point)
local function pipelineCall(label, fn, ...)
	if type(fn) ~= "function" then
		Util.Warn(TAG, "death pipeline: missing " .. label)
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		Util.Warn(TAG, "death pipeline: " .. label .. " failed: " .. tostring(err))
	end
end

local function runDeathPipeline(victim)
	if victim.Parent == nil then
		-- the victim already left: leave flows (GrudgeService / ProgressionService) handle it
		lastPvPAttacker[victim] = nil
		return
	end

	local killer = CombatService.GetLastPvPAttacker(victim)
	if killer then
		local fk, fv = faction(killer), faction(victim)
		-- "None" and "Neutral" never take part in PvP KOs (addendum A6)
		if killer == victim or killer.Parent == nil or fk == fv or not PVP_FACTIONS[fk] or not PVP_FACTIONS[fv] then
			killer = nil
		end
	end

	-- 1. resolve a grudge sack first (no-op without one)
	pipelineCall("GrudgeService.OnCarrierDown", S.GrudgeService.OnCarrierDown, victim, killer)

	-- 2. kaiju / PvP KO / non-PvP death
	local okState, state = pcall(kstate, victim)
	if okState and state == "Active" then
		pipelineCall("KaijuService.HandleKaijuDeath", S.KaijuService.HandleKaijuDeath, victim, killer)
	elseif killer then
		pipelineCall("PvPService.HandleKO", S.PvPService.HandleKO, victim, killer)
	else
		pipelineCall("PvPService.HandleNonPvPDeath", S.PvPService.HandleNonPvPDeath, victim)
	end

	-- 3. reset charge, forget the attacker
	resetCharge(victim)
	lastPvPAttacker[victim] = nil
end

local function onCharacterDied(player, _character)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	-- deferred so the lethal hit's PlayerDamaged handlers (kaiju damage share, bait log) always run first,
	-- whatever the Workspace.SignalBehavior is
	task.defer(function()
		local ok, err = pcall(runDeathPipeline, player)
		if not ok then
			Util.Warn(TAG, "death pipeline error: " .. tostring(err))
		end
	end)
end

------------------------------------------------------------------ player lifecycle handlers
local function onPlayerReady(player, _data)
	if not isPlayer(player) or player.Parent == nil then
		return
	end
	charge[player] = 0
	perfectUntil[player] = 0
	nextSwingAt[player] = 0
	lastSwingAuto[player] = false
	player:SetAttribute("AutoAttack", false)
	player:SetAttribute("InCombatUntil", 0)
	publishCharge(player) -- Charge = 0, ChargeCap = perks.ChargeCap, PerfectUntil = 0
end

local function onPlayerLeaving(player, _data)
	-- deferred: other PlayerLeaving handlers (ProgressionService combat-log penalty) still read IsInCombat
	task.defer(function()
		charge[player] = nil
		perfectUntil[player] = nil
		nextSwingAt[player] = nil
		lastSwingAuto[player] = nil
		lastManualAt[player] = nil
		pendingManual[player] = nil
		lastDamagedAt[player] = nil
		lastPvPAttacker[player] = nil
		lastPvPTime[player] = nil
		autoHintAt[player] = nil
		painAt[player] = nil
		guard.allyStackAt[player] = nil -- CR-H1
		guard.autoReleasedAt[player] = nil -- CR-L22
		guard.acLogAt[player] = nil -- CR-H2
	end)
end

local function onFactionChanged(player, _newFaction, _oldFaction, _reason)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	resetCharge(player) -- also refreshes ChargeCap for the new faction
end

local function onClassChanged(player, _newClass, _oldClass)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	resetCharge(player)
end

------------------------------------------------------------------ remotes
-- one queued manual swing that fires as soon as the shared cooldown is ready (addendum H3)
local function queueManualSwing(player)
	local request = { Character = Util.GetCharacter(player), Class = cls(player).Id, Faction = faction(player) }
	pendingManual[player] = request
	local tries = 0
	local function attempt()
		if pendingManual[player] ~= request then
			return
		end
		if player.Parent == nil or not S.PlayerService.IsReady(player) or not Util.IsAlive(player)
			or Util.GetCharacter(player) ~= request.Character or cls(player).Id ~= request.Class
			or faction(player) ~= request.Faction then
			pendingManual[player] = nil
			return
		end
		local remaining = (nextSwingAt[player] or 0) - os.clock()
		if remaining > 0 and tries < MANUAL_QUEUE_RETRIES then
			tries += 1
			task.delay(remaining, attempt)
			return
		end
		pendingManual[player] = nil
		CombatService.Swing(player, true)
	end
	task.delay(math.max(0, (nextSwingAt[player] or 0) - os.clock()), attempt)
end

local function onSwingRemote(player)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if not Util.RateLimit(player, "Swing", Config.RateLimits.Swing) then
		return
	end
	S.PlayerService.MarkActive(player)
	lastManualAt[player] = os.clock()
	if pendingManual[player] then
		return -- a manual swing is already queued
	end
	local remaining = (nextSwingAt[player] or 0) - os.clock()
	if remaining <= 0 then
		CombatService.Swing(player, true)
	elseif lastSwingAuto[player] or remaining <= MANUAL_GRACE then
		-- the cooldown was consumed by an auto swing (or the request is only jitter-early): never drop it
		queueManualSwing(player)
	end
	-- otherwise an early repeat of a manual swing: silently ignored
end

local function onReleaseRemote(player)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if not Util.RateLimit(player, "Release", Config.RateLimits.Release) then
		return
	end
	CombatService.Release(player, false) -- MarkActive inside
end

local function onSetAutoAttackRemote(player, enabled)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if type(enabled) ~= "boolean" then
		return
	end
	if not Util.RateLimit(player, "SetAutoAttack", Config.RateLimits.SetAutoAttack) then
		return
	end
	if enabled and numAttr(player, "Level", 1) < Config.Combat.AutoUnlockLevel then
		Net.Notify(player, string.format(Config.Text.AutoLocked, Config.Combat.AutoUnlockLevel), "bad")
		enabled = false
	end
	player:SetAttribute("AutoAttack", enabled)
end

------------------------------------------------------------------ loops
local function autoTick(p)
	if p:GetAttribute("AutoAttack") ~= true then
		return
	end
	if numAttr(p, "Level", 1) < Config.Combat.AutoUnlockLevel then
		p:SetAttribute("AutoAttack", false)
		return
	end
	if not Util.IsAlive(p) then
		return
	end
	-- addendum H3: manual beats auto
	if pendingManual[p] then
		return
	end
	-- CR-M17: yield for one full swing interval + pad after a manual request, so a held button never alternates
	-- with auto swings (the old fixed 1.0 s was <= the Warrior / Mage interval)
	local c = cls(p)
	local lm = lastManualAt[p]
	if lm and os.clock() - lm < (c.SwingInterval or 1) + (Config.Combat.ManualYieldPad or 0.3) then
		return
	end
	if os.clock() < (nextSwingAt[p] or 0) then
		return
	end
	local root = Util.GetRoot(p)
	if not root then
		return
	end
	local range = c.Range or 10
	local pos = root.Position
	local count = S.MonsterService.CountInRadius(pos, range, p)
	local hasTarget = type(count) == "number" and count > 0
	if not hasTarget then
		local goosePos = goosePositionFor(p)
		hasTarget = goosePos ~= nil and Util.FlatDistance(goosePos, pos) <= range + Config.Goose.HitRadius
	end
	if hasTarget then
		CombatService.Swing(p, false)
	end
end

local function chargeTick(p)
	local pu = perfectUntil[p]
	-- CR-L22: + PerfectGrace, so a manual release sent at the very end of the window is not stolen
	if pu and pu > 0 and Util.Now() >= pu + (Config.Charge.PerfectGrace or 0) then
		CombatService.Release(p, true) -- PERFECT window missed: automatic release (x1.5, monsters only)
	end
end

local function regenTick(p)
	local hum = Util.GetHumanoid(p)
	if not hum or hum.Health <= 0 or hum.Health >= hum.MaxHealth then
		return
	end
	local pct
	-- an Active kaiju never gets the town regen (it would make the event unwinnable in Crossroads)
	if S.ZoneService.IsTown(p) and kstate(p) ~= "Active" then
		pct = Config.Combat.TownRegenPerSec
	else
		pct = perksOf(p).RegenPerSec or 0
	end
	if type(pct) == "number" and pct > 0 then
		CombatService.HealPlayer(p, hum.MaxHealth * pct * Config.Combat.RegenTick)
	end
end

local function startPlayerLoop(loopName, interval, body)
	task.spawn(function()
		while true do
			task.wait(interval)
			local ok, players = pcall(S.PlayerService.GetReadyPlayers)
			if ok and type(players) == "table" then
				for _, p in players do
					if p.Parent then
						local okBody, err = pcall(body, p)
						if not okBody then
							loopWarn(loopName, err)
						end
					end
				end
			elseif not ok then
				loopWarn(loopName, players)
			end
		end
	end)
end

------------------------------------------------------------------ lifecycle
local function connectSignal(serviceName, signalName, fn)
	local service = S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function CombatService.Init(registry)
	S = registry
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
	connectSignal("PlayerService", "CharacterDied", onCharacterDied)
	connectSignal("FactionService", "FactionChanged", onFactionChanged)
	connectSignal("ClassService", "ClassChanged", onClassChanged)
end

function CombatService.Start()
	Net.Get("Swing").OnServerEvent:Connect(onSwingRemote)
	Net.Get("Release").OnServerEvent:Connect(onReleaseRemote)
	Net.Get("SetAutoAttack").OnServerEvent:Connect(onSetAutoAttackRemote)

	startPlayerLoop("AutoLoop", Config.Combat.AutoLoopInterval, autoTick)
	startPlayerLoop("ChargeWatcher", Config.Combat.ChargeTick, chargeTick)
	startPlayerLoop("RegenLoop", Config.Combat.RegenTick, regenTick)

	print("[CombatService] started")
end

return CombatService
]]></ProtectedString>
				<string name="ScriptGuid">{6676FB27-60A5-4C43-B483-9080A2955D35}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">CombatService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">5788d013bf1591860ad23e240000de81</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2E258D342AA546CDB295D513EB451CC2">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- GooseService.luau : golden goose tug-of-war ("황금 거위 줄다리기"), Regular's Luck rare rewards, cheer stars.
-- Owner: G9. Public surface (TECH_SPEC §4.16): GooseFinished, Init, Start, IsActive, GetPosition, RegisterHit, DebugStart.
-- SPEC_ADDENDUM A1: ServerStorage.CustomModels.GoldenGoose (Model or BasePart) replaces the procedural body visually.
-- SPEC_ADDENDUM A6: only Halo/Horns players add tug counts and receive tug rewards (Neutral/None count 0).
-- Review fixes: a reward needs >= MIN_MANUAL_HITS manual counts (auto-only AFK players still pull, never get paid), and a
-- faction switch mid-event forfeits that player's entry (no pulling for one side and collecting the other's win).
-- CR-L8: a win with no rival faction online becomes a Tie. CR-L21: GetPosition follows the tug pivot; RegisterHit
-- returns the count actually added (0 = rejected).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "GooseService"
local GOOSE_LABEL = "황금 거위" -- billboard text required verbatim by TECH_SPEC §4.16
local CUSTOM_FOLDER = (Config.CustomModels and Config.CustomModels.FolderName) or "CustomModels" -- A1
local CUSTOM_ID = (Config.CustomModels and Config.CustomModels.GooseId) or "GoldenGoose" -- A1
-- review fix (anti-AFK): rewards (and GooseFinished participation) need this many ACCEPTED manual counts this event;
-- auto-attack counts still move the tug but alone never pay. Candidate for Config.Goose.MinManualHits (G1).
local MIN_MANUAL_HITS = 3
local TXT_NEED_MANUAL = "황금 거위 보상은 직접 %d번 이상 때린 사람만 받아요! (자동 공격만으로는 보상 없음)"
local MAX_SIDE_OFFSET = 6 -- studs; tug pivot clamp (§4.16)
local VISUAL_BOTTOM = -2.0 -- procedural body bottom relative to the goose center
local VISUAL_HEIGHT = 6.9 -- procedural body height (body bottom -> crown-shard tip)
local BOB_AMPLITUDE = 0.35
local BOB_SPEED = 2.4
local SWAY_ANGLE = math.rad(12)
local SWAY_SPEED = 0.8
local SIDE_LERP = 2.5 -- per second
local WARN_INTERVAL = 10

local COLOR_GOLD = Color3.fromRGB(255, 200, 40)
local COLOR_GOLD_DARK = Color3.fromRGB(225, 160, 25)
local COLOR_BEAK = Color3.fromRGB(255, 135, 30)
local COLOR_EYE = Color3.fromRGB(20, 20, 20)
local COLOR_SHARD = Color3.fromRGB(255, 245, 170)
local COLOR_LIGHT = Color3.fromRGB(255, 215, 110)
local COLOR_LABEL_STROKE = Color3.fromRGB(90, 55, 0)

-- procedural body, offsets relative to the goose center (local -Z = forward / the goose's LookVector)
local PROCEDURAL_PARTS = {
	{ Name = "Body", Class = "Part", Size = Vector3.new(4, 4, 4), At = CFrame.new(0, 0, 0.2), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Chest", Class = "Part", Size = Vector3.new(3, 3, 3), At = CFrame.new(0, 0.5, -1.1), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Tail", Class = "WedgePart", Size = Vector3.new(1.6, 1.2, 1.6), At = CFrame.new(0, 0.9, 2.3) * CFrame.Angles(0, math.pi, 0), Color = COLOR_GOLD_DARK },
	{ Name = "Neck", Class = "Part", Size = Vector3.new(0.9, 2.4, 0.9), At = CFrame.new(0, 2.0, -1.8), Color = COLOR_GOLD, Shiny = true },
	{ Name = "Head", Class = "Part", Size = Vector3.new(1.6, 1.6, 1.6), At = CFrame.new(0, 3.4, -1.9), Color = COLOR_GOLD, Ball = true, Shiny = true },
	{ Name = "Beak", Class = "WedgePart", Size = Vector3.new(0.55, 0.45, 1.0), At = CFrame.new(0, 3.25, -3.0), Color = COLOR_BEAK },
	{ Name = "EyeL", Class = "Part", Size = Vector3.new(0.32, 0.32, 0.32), At = CFrame.new(-0.6, 3.6, -2.45), Color = COLOR_EYE, Ball = true },
	{ Name = "EyeR", Class = "Part", Size = Vector3.new(0.32, 0.32, 0.32), At = CFrame.new(0.6, 3.6, -2.45), Color = COLOR_EYE, Ball = true },
	{ Name = "WingL", Class = "Part", Size = Vector3.new(0.35, 1.6, 2.8), At = CFrame.new(-2.0, 0.35, 0.3) * CFrame.Angles(0, 0, math.rad(25)), Color = COLOR_GOLD_DARK },
	{ Name = "WingR", Class = "Part", Size = Vector3.new(0.35, 1.6, 2.8), At = CFrame.new(2.0, 0.35, 0.3) * CFrame.Angles(0, 0, math.rad(-25)), Color = COLOR_GOLD_DARK },
	{ Name = "CrownShard", Class = "WedgePart", Size = Vector3.new(0.35, 0.9, 0.7), At = CFrame.new(0, 4.45, -1.9) * CFrame.Angles(0, math.rad(90), math.rad(12)), Color = COLOR_SHARD, Neon = true },
}

local GooseService = {}
GooseService.GooseFinished = Util.Signal.new() -- (result: "Halo" | "Horns" | "Tie", counts: { [Player]: number })

local S = nil
local gameState = nil

-- event state
local active = false
local endsAt = 0
local nextAt = 0
local rescue = 0
local poach = 0
local counts = {} -- [Player] = number (faction-scaled tug counts this event)
local manualHits = {} -- [Player] = accepted MANUAL counts this event (reward eligibility)
local sideOf = {} -- [Player] = faction the player's counts were made for ("Halo" | "Horns")
local hitTimes = {} -- [Player] = { os.clock() } accepted counts within the rolling 1 s window
local publishedRescue = -1
local publishedPoach = -1

-- model state
local gooseModel = nil
local gooseRoot = nil
local motionConn = nil
local sideOffset = 0
local sideTarget = 0

local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	if now - (lastWarnAt[key] or -math.huge) >= WARN_INTERVAL then
		lastWarnAt[key] = now
		Util.Warn(TAG, tostring(msg))
	end
end

-- pcall-protected call into another service; returns its FIRST result, or nil (and warns, throttled) on failure
local function call(serviceName, fnName, ...)
	local svc = S and S[serviceName]
	local fn = svc and svc[fnName]
	if type(fn) ~= "function" then
		warnThrottled(serviceName .. "." .. fnName, "missing " .. serviceName .. "." .. fnName)
		return nil
	end
	local ok, result = pcall(fn, ...)
	if not ok then
		warnThrottled(serviceName .. "." .. fnName, serviceName .. "." .. fnName .. " failed: " .. tostring(result))
		return nil
	end
	return result
end

local function getGameState()
	if gameState and gameState.Parent then return gameState end
	local ok, gs = pcall(Net.GameState)
	if ok and gs then gameState = gs end
	return gameState
end

local function setGame(key, value)
	local gs = getGameState()
	if gs then gs:SetAttribute(key, value) end
end

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player")
end

local function isReady(p)
	return isPlayer(p) and p.Parent ~= nil and call("PlayerService", "IsReady", p) == true
end

local function factionOf(p)
	local f = call("FactionService", "GetFaction", p)
	if type(f) ~= "string" then return "None" end
	return f
end

local function isTugFaction(f)
	return f == "Halo" or f == "Horns"
end

-- persisted numeric stat: live data table first, mirrored attribute as fallback
local function getNum(p, key)
	local data = call("PlayerService", "GetData", p)
	local v = (type(data) == "table") and data[key] or nil
	if type(v) ~= "number" then v = p:GetAttribute(key) end
	return tonumber(v) or 0
end

local function round1(x)
	return math.floor(x * 10 + 0.5) / 10
end

local function gooseCenter()
	return Config.Goose.Position + Vector3.new(0, Config.Goose.HoverHeight, 0)
end

-- the goose faces the Crossroads fountain
local function baseRotation()
	local c = gooseCenter()
	local f = Config.Map.FountainPosition
	local look = Vector3.new(f.X, c.Y, f.Z)
	if (look - c).Magnitude < 0.1 then return CFrame.new() end
	local cf = CFrame.lookAt(c, look)
	return cf - cf.Position
end

-- next goose start: aligned to WarService's round end minus OffsetFromWarEnd, advanced by Interval past `now`
local function computeNextAt(now, fallback)
	local base = fallback
	local roundEnd = call("WarService", "GetRoundEndsAt")
	if type(roundEnd) == "number" and roundEnd == roundEnd and roundEnd > now - 86400 then
		base = roundEnd - Config.Goose.OffsetFromWarEnd
	end
	if type(base) ~= "number" or base ~= base or base < now - 86400 then
		base = now + Config.Goose.OffsetFromWarEnd
	end
	local interval = math.max(1, Config.Goose.Interval)
	if base <= now then
		base += (math.floor((now - base) / interval) + 1) * interval
	end
	return base
end

------------------------------------------------------------------ goose model
local function prepVisualPart(p)
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
end

local function getCustomTemplate()
	local folder = ServerStorage:FindFirstChild(CUSTOM_FOLDER)
	if not folder then return nil end
	local t = folder:FindFirstChild(CUSTOM_ID)
	if t and (t:IsA("Model") or t:IsA("BasePart")) then return t end
	return nil
end

-- world-space vertical extent of a set of parts (exact for box-shaped parts)
local function worldYRange(parts)
	local minY, maxY = math.huge, -math.huge
	for _, p in parts do
		local cf, s = p.CFrame, p.Size
		local half = math.abs(cf.RightVector.Y) * s.X / 2 + math.abs(cf.UpVector.Y) * s.Y / 2 + math.abs(cf.LookVector.Y) * s.Z / 2
		minY = math.min(minY, cf.Position.Y - half)
		maxY = math.max(maxY, cf.Position.Y + half)
	end
	return minY, maxY
end

local function buildProcedural(model, root, rootCF)
	for _, def in PROCEDURAL_PARTS do
		local p = Util.MakePart({
			ClassName = def.Class,
			Name = def.Name,
			Size = def.Size,
			CFrame = rootCF * def.At,
			Color = def.Color,
			Material = def.Neon and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			Reflectance = def.Shiny and 0.15 or 0,
		})
		if def.Ball and p:IsA("Part") then p.Shape = Enum.PartType.Ball end
		prepVisualPart(p)
		p.Parent = model
		Util.Weld(root, p)
	end
end

-- A1: clone the custom visual, scale it to the procedural height, put its bottom where the procedural body's is,
-- face the root's LookVector and weld every part to the root. Returns true on success.
local function buildCustom(model, root, rootCF, template)
	local clone = template:Clone()
	local rot = rootCF - rootCF.Position
	local targetBottom = rootCF.Position.Y + VISUAL_BOTTOM
	local parts = {}
	if clone:IsA("BasePart") then
		prepVisualPart(clone)
		local h = clone.Size.Y
		if h > 0.01 then clone.Size = clone.Size * (VISUAL_HEIGHT / h) end
		clone.CFrame = CFrame.new(rootCF.Position.X, targetBottom + clone.Size.Y / 2, rootCF.Position.Z) * rot
		table.insert(parts, clone)
	else
		for _, d in clone:GetDescendants() do
			if d:IsA("BasePart") then
				prepVisualPart(d)
				table.insert(parts, d)
			elseif d:IsA("BaseScript") then
				d:Destroy() -- a purely cosmetic visual never runs code
			end
		end
		if #parts == 0 then
			clone:Destroy()
			return false
		end
		clone:PivotTo(CFrame.new(rootCF.Position) * rot)
		local minY, maxY = worldYRange(parts)
		local height = maxY - minY
		if height > 0.01 then
			local okScale = pcall(function()
				clone:ScaleTo(clone:GetScale() * (VISUAL_HEIGHT / height))
			end)
			if not okScale then warnThrottled("customScale", "custom GoldenGoose could not be scaled; using its own size") end
		end
		minY = worldYRange(parts)
		clone:PivotTo(clone:GetPivot() + Vector3.new(0, targetBottom - minY, 0))
	end
	clone.Name = "Visual"
	clone.Parent = model
	for _, p in parts do
		Util.Weld(root, p)
	end
	return true
end

local function destroyModel()
	if motionConn then
		motionConn:Disconnect()
		motionConn = nil
	end
	if gooseModel then
		gooseModel:Destroy()
	end
	gooseModel = nil
	gooseRoot = nil
end

local function startMotion(rot)
	if motionConn then motionConn:Disconnect() end
	local t0 = os.clock()
	motionConn = RunService.Heartbeat:Connect(function(dt)
		local root = gooseRoot
		if not root or not root.Parent then return end
		sideOffset += (sideTarget - sideOffset) * math.min(1, dt * SIDE_LERP)
		local t = os.clock() - t0
		local bob = math.sin(t * BOB_SPEED) * BOB_AMPLITUDE
		local sway = math.sin(t * SWAY_SPEED) * SWAY_ANGLE
		root.CFrame = CFrame.new(gooseCenter() + Vector3.new(sideOffset, bob, 0)) * rot * CFrame.Angles(0, sway, 0)
	end)
end

local function spawnModel()
	destroyModel()
	local effects = Util.GetFolder(workspace, "Effects")
	local old = effects:FindFirstChild("GoldenGoose")
	if old then old:Destroy() end

	local rot = baseRotation()
	local rootCF = CFrame.new(gooseCenter()) * rot

	local model = Instance.new("Model")
	model.Name = "GoldenGoose"

	-- invisible anchored root: one CFrame write moves the whole goose (bob + tug pivot)
	local root = Util.MakePart({
		Name = "Root",
		Size = Vector3.new(3, 3, 3),
		CFrame = rootCF,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	root.Parent = model
	model.PrimaryPart = root

	local template = getCustomTemplate()
	local built = false
	if template then
		local ok, res = pcall(buildCustom, model, root, rootCF, template)
		built = ok and res == true
		if not built then
			warnThrottled("custom", "custom GoldenGoose failed, using the procedural goose: " .. tostring(res))
			local partial = model:FindFirstChild("Visual")
			if partial then partial:Destroy() end
		end
	end
	if not built then
		buildProcedural(model, root, rootCF)
	end

	local light = Instance.new("PointLight")
	light.Color = COLOR_LIGHT
	light.Brightness = 2
	light.Range = 16
	light.Shadows = false
	light.Parent = root

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkles"
	sparkles.Color = ColorSequence.new(COLOR_SHARD)
	sparkles.LightEmission = 1
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(1.5, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	sparkles.Parent = root

	local gui = Instance.new("BillboardGui")
	gui.Name = "GooseLabel"
	gui.Size = UDim2.fromOffset(220, 44)
	gui.StudsOffset = Vector3.new(0, 6.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	gui.Adornee = root
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = COLOR_GOLD
	label.TextStrokeColor3 = COLOR_LABEL_STROKE
	label.TextStrokeTransparency = 0.2
	label.Text = GOOSE_LABEL
	local sizeLimit = Instance.new("UITextSizeConstraint")
	sizeLimit.MinTextSize = 11
	sizeLimit.MaxTextSize = 36
	sizeLimit.Parent = label
	label.Parent = gui
	gui.Parent = root

	model.Parent = effects
	gooseModel = model
	gooseRoot = root
	sideOffset, sideTarget = 0, 0
	startMotion(rot)
end

------------------------------------------------------------------ event flow
local function publishTotals(force)
	local r, p = round1(rescue), round1(poach)
	if force or r ~= publishedRescue then
		publishedRescue = r
		setGame("GooseRescue", r)
	end
	if force or p ~= publishedPoach then
		publishedPoach = p
		setGame("GoosePoach", p)
	end
end

local function start()
	if active then return end
	active = true
	endsAt = Util.Now() + Config.Goose.Duration
	rescue, poach = 0, 0
	counts = {}
	manualHits = {}
	sideOf = {}
	hitTimes = {}
	publishTotals(true)
	setGame("GooseEndsAt", endsAt)
	setGame("GooseActive", true)

	local players = call("PlayerService", "GetReadyPlayers")
	if type(players) == "table" then
		for _, p in players do
			if p.Parent then p:SetAttribute("GooseCount", 0) end
		end
	end

	local ok, err = pcall(spawnModel)
	if not ok then
		warnThrottled("spawn", "goose model failed: " .. tostring(err))
	end
	Net.NotifyAll(string.format(Config.Story.GooseStart))
end

-- forget a player's entry for this event; what they already pulled stays in the side totals (like a leaver)
local function dropEntry(p)
	counts[p] = nil
	manualHits[p] = nil
	sideOf[p] = nil
	hitTimes[p] = nil
	if isPlayer(p) and p.Parent then
		p:SetAttribute("GooseCount", 0)
	end
end

-- f = the side the player's counts were made for, re-verified against the current faction by finish()
local function rewardPlayer(p, result, f)
	if not isTugFaction(f) then return end -- A6: Neutral (and None) get no tug rewards
	local won = (result == f)

	local rare
	if getNum(p, "CheerStars") >= Config.Goose.CheerStarsForRare then
		rare = true
		call("PlayerService", "AddStat", p, "CheerStars", -Config.Goose.CheerStarsForRare)
	else
		local minutes = tonumber(call("PlayerService", "GetRegularMinutes", p)) or 0
		rare = Util.Random:NextNumber() < Config.RareChance(minutes)
	end

	local level = math.max(1, math.floor(getNum(p, "Level")))
	local gold, xp = Config.GooseReward(level, f, won, rare)
	if gold > 0 then call("ProgressionService", "AddBankGold", p, gold, "Event") end
	if xp > 0 then call("ProgressionService", "AddXP", p, xp) end
	Net.Notify(p, string.format(Config.Text.GooseReward, Util.FormatNumber(gold), Util.FormatNumber(xp)), "reward")

	if rare then
		Net.Fx(p, "Rare", { Gold = gold, XP = xp })
		Net.NotifyAll(string.format(Config.Text.RareAnnounce, Util.PlayerDisplayName(p)), "info")
	end

	if not won then -- loss or tie: +1 cheer star
		local cheer = getNum(p, "CheerStars")
		if cheer < Config.Goose.CheerStarsForRare then
			local newCount = call("PlayerService", "AddStat", p, "CheerStars", 1)
			cheer = tonumber(newCount) or (cheer + 1)
		end
		Net.Notify(p, string.format(Config.Text.GooseCheer, math.floor(cheer)), "info")
	end
end

local function finish()
	if not active then return end
	active = false
	-- schedule the next goose FIRST so a failure below can never re-trigger an event every tick
	endsAt = 0
	nextAt = computeNextAt(Util.Now(), nextAt)
	setGame("GooseNextAt", nextAt)

	local result = (rescue > poach) and "Halo" or ((poach > rescue) and "Horns" or "Tie")
	-- CR-L8: no rival faction online -> no winner (no 100% winner reward, no war points). Called directly: the call
	-- helper only returns the first result.
	local noRival = false
	local fs = S and S.FactionService
	if result ~= "Tie" and fs and type(fs.GetCounts) == "function" then
		local okC, halo, horns = pcall(fs.GetCounts)
		if okC and ((tonumber(halo) or 0) <= 0 or (tonumber(horns) or 0) <= 0) then
			result = "Tie"
			noRival = true
		end
	end
	local fxPos = (gooseRoot and gooseRoot.Parent) and gooseRoot.Position or gooseCenter()
	local finalCounts, finalManual, finalSide = counts, manualHits, sideOf
	counts = {}
	manualHits = {}
	sideOf = {}
	hitTimes = {}

	-- paid participants: counts > 0, still on the side they pulled for, and enough MANUAL hits (auto-only = AFK)
	local rewarded = {}
	for p, n in finalCounts do
		if type(n) == "number" and n > 0 and isReady(p) then
			local f = factionOf(p)
			if isTugFaction(f) and finalSide[p] == f then
				if (finalManual[p] or 0) >= MIN_MANUAL_HITS then
					rewarded[p] = n
					local ok, err = pcall(rewardPlayer, p, result, f)
					if not ok then warnThrottled("reward", "goose reward failed for " .. p.Name .. ": " .. tostring(err)) end
				else
					pcall(Net.Notify, p, string.format(TXT_NEED_MANUAL, MIN_MANUAL_HITS), "info")
				end
			end
		end
	end

	if result ~= "Tie" then
		call("WarService", "AddFactionPoints", result, Config.Goose.WinWarPoints)
	end
	local okSend, sendErr = pcall(function()
		if noRival and Config.Story.GooseNoRival then
			Net.NotifyAll(string.format(Config.Story.GooseNoRival)) -- CR-L8: replaces the plain tie banner
		else
			Net.NotifyAll(string.format(Config.Story.GooseResult[result]))
		end
		Net.Fx(nil, "GooseEnd", { Pos = fxPos, Winner = result })
	end)
	if not okSend then warnThrottled("send", "goose result broadcast failed: " .. tostring(sendErr)) end

	destroyModel()
	for p in finalCounts do
		if isPlayer(p) and p.Parent then p:SetAttribute("GooseCount", 0) end
	end
	publishTotals(true)
	setGame("GooseActive", false)
	setGame("GooseEndsAt", 0)

	-- same shape as the spec's counts ({ [Player]: number }), limited to the players who were actually paid,
	-- so quest progress never goes to AFK auto-swingers or side-switchers
	GooseService.GooseFinished:Fire(result, rewarded)
end

local function tick()
	local now = Util.Now()
	if not active then
		if now >= nextAt then start() end
		return
	end
	if now >= endsAt then
		finish()
		return
	end
	local total = rescue + poach
	sideTarget = math.clamp((poach - rescue) / math.max(1, total) * MAX_SIDE_OFFSET, -MAX_SIDE_OFFSET, MAX_SIDE_OFFSET)
	publishTotals(false)
end

------------------------------------------------------------------ public API
function GooseService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player)
		if isPlayer(player) and player.Parent then
			player:SetAttribute("GooseCount", 0)
		end
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		-- the leaver's contribution stays in the side totals
		counts[player] = nil
		manualHits[player] = nil
		sideOf[player] = nil
		hitTimes[player] = nil
	end)
	-- review fix: switching sides mid-event (altar is next to the perch) forfeits this event's entry, so nobody can pull
	-- for one side and then collect the winner share of the other. Pulling again after the switch starts a new entry.
	local fs = S.FactionService
	if fs and fs.FactionChanged then
		fs.FactionChanged:Connect(function(player)
			if counts[player] ~= nil or hitTimes[player] ~= nil then
				dropEntry(player)
			end
		end)
	else
		warnThrottled("factionChanged", "FactionService.FactionChanged missing; side switches are caught at finish only")
	end
end

function GooseService.Start()
	getGameState()
	nextAt = computeNextAt(Util.Now(), nil)
	setGame("GooseNextAt", nextAt)
	setGame("GooseActive", false)
	setGame("GooseEndsAt", 0)
	publishTotals(true)

	task.spawn(function()
		while true do
			task.wait(Config.Goose.Tick)
			local ok, err = pcall(tick)
			if not ok then warnThrottled("loop", "tick error: " .. tostring(err)) end
		end
	end)

	print("[GooseService] custom model for " .. CUSTOM_ID .. ": " .. (getCustomTemplate() and "yes" or "no"))
	print("[GooseService] started")
end

function GooseService.IsActive()
	return active
end

-- CR-L21: includes the tug pivot (sideOffset, +-MAX_SIDE_OFFSET) so swing range checks match the goose players see
function GooseService.GetPosition()
	if not active then return nil end
	return gooseCenter() + Vector3.new(sideOffset, 0, 0)
end

-- returns the tug count actually added (0 = rejected), so CombatService can show the real "+N" (CR-L21)
function GooseService.RegisterHit(player, isManual)
	if not active then return 0 end
	if not isReady(player) then return 0 end
	local f = factionOf(player)
	if not isTugFaction(f) then return 0 end -- A6: Neutral swings on the goose count 0
	if sideOf[player] ~= nil and sideOf[player] ~= f then
		dropEntry(player) -- defensive: faction changed without a FactionChanged signal -> fresh entry for the new side
	end

	-- rolling 1 s window: at most MaxCountsPerSecond accepted counts per player
	local now = os.clock()
	local list = hitTimes[player]
	if not list then
		list = {}
		hitTimes[player] = list
	end
	while list[1] and now - list[1] >= 1 do
		table.remove(list, 1)
	end
	if #list >= Config.Goose.MaxCountsPerSecond then return 0 end
	table.insert(list, now)

	local scale = tonumber(call("JusticeService", "GetFactionScale", f)) or 1
	if scale ~= scale or scale <= 0 then scale = 1 end
	local amount = ((isManual == true) and Config.Goose.ManualCount or Config.Goose.AutoCount) * scale
	counts[player] = (counts[player] or 0) + amount
	sideOf[player] = f
	if isManual == true then
		manualHits[player] = (manualHits[player] or 0) + 1
	end
	if f == "Halo" then
		rescue += amount
	else
		poach += amount
	end
	player:SetAttribute("GooseCount", math.floor(counts[player]))
	return amount
end

function GooseService.DebugStart()
	if active then return end
	local ok, err = pcall(start)
	if not ok then warnThrottled("debug", "DebugStart failed: " .. tostring(err)) end
end

return GooseService
