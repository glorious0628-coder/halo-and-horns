					<string name="Name">FactionPicker</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300021541</UniqueId>
