----------------------------------------------------------------- state
local ui = {}
local jumpButton = nil
local jumpConns = {}
local layoutPending = false

local holdSources = {} -- [source] = true; source = "mouse" | "key:<KeyCode>" | "pad:<KeyCode>" | InputObject (button press)
local holdToken = 0
local lastAction = {}

local prevLevel = nil
local levelBaselineReady = false


local questRows = {}
local questExpanded = false -- collapsed list shows the header + one row
-- CR-M24: 교체 is ignored for ClaimLock s after a claim and a row for RowLock s after its quest changed;
-- CR-M25: touch opens the rows' overlay from the header (OverlayOpen);
-- CR-L50: Data = the last quest list from the "Quests" remote, Started = HUD.Start ran (rows may refresh)
-- B15: StoryKey = "id|St" of the story page Panels holds back (fight / other window), CallEntry = its quest entry,
-- Pulse = the gentle gold pulse on that row (touch: on the header line)
local questState = { ClaimAt = -math.huge, ClaimLock = 1.5, RowLock = 0.8, OverlayOpen = false, Data = nil,
	Started = false, StoryKey = "", CallEntry = nil, Pulse = { Target = nil, Stroke = nil, Tween = nil } }
local guide = nil -- { Tag, Part, Att0, Att1, Beam, Billboard, Tween }
local guideAnchors = {}

local tickCount = 0
local lastWarnAt = -math.huge

----------------------------------------------------------------- small helpers
local function warnThrottled(msg)
	local now = os.clock()
	if now - lastWarnAt < 10 then return end
	lastWarnAt = now
	Util.Warn("HUD", msg)
end

local function attr(name, default)
	local v = LocalPlayer:GetAttribute(name)
	if v == nil then return default end
	return v
end

local function num(name, default)
	local v = tonumber(attr(name, default))
	if v == nil or v ~= v or v == math.huge or v == -math.huge then return default end
	return v
end

local function getFaction()
	local f = attr("Faction", "None")
	if type(f) ~= "string" or f == "" then return "None" end
	return f
end

local function getClass()
	local c = attr("Class", "Warrior")
	if type(c) ~= "string" or not Config.Classes[c] then return "Warrior" end
	return c
end

local function factionDef(f)
	return Config.Factions[f] or Config.Factions.None
end

local function factionColor(f)
	local d = Config.Factions[f]
	if type(d) == "table" and typeof(d.Color) == "Color3" then return d.Color end
	if f == "Neutral" and typeof(Theme.Neutral) == "Color3" then return Theme.Neutral end -- A9-1: Config teal via UIKit.Theme
	return Theme.SubText
end

local function fmtNum(n)
	return Util.FormatNumber(n)
end

-- Config.Text[key] through string.format, with a private fallback template
local function textOr(key, fallback, ...)
	local template = Config.Text[key]
	if type(template) ~= "string" then template = fallback end
	local ok, out = pcall(string.format, template, ...)
	if ok then return out end
	return template
end

-- true = called again within `interval` (skip); false = allowed (and recorded)
local function throttled(key, interval)
	local now = os.clock()
	local last = lastAction[key]
	if last and now - last < interval then return true end
	lastAction[key] = now
	return false
end

local function remote(name)
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild(name)
	if r and r:IsA("RemoteEvent") then return r end
	return nil
end

-- never yields (input handlers must not block)
local function fire(name, ...)
	local r = remote(name)
	if r then
		r:FireServer(...)
	else
		warnThrottled("remote missing: " .. tostring(name))
	end
end

local function playSound(name)
	local fx = C and C.Fx
	if fx and type(fx.PlaySound) == "function" then
		pcall(fx.PlaySound, name)
	end
end

local function pickersOpen()
	for _, name in { "Intro", "FactionPicker", "ClassPicker" } do
		local m = C and C[name]
		if type(m) == "table" and type(m.IsOpen) == "function" then
			local ok, open = pcall(m.IsOpen)
			if ok and open then return true end
		end
	end
	return false
end

local function currentScale()
	local gui = UIKit and UIKit.Gui
	local s = gui and gui:FindFirstChildOfClass("UIScale")
	local v = s and s.Scale or 1
	if v <= 0 then v = 1 end
	return v
end

-- top bar inset in real pixels; fallback keeps blocks at >= TopInsetFallback px (addendum H4)
local function insetY()
	local ok, topLeft = pcall(function()
		return GuiService:GetGuiInset()
	end)
	local y = (ok and typeof(topLeft) == "Vector2") and topLeft.Y or 0
	if y <= 0 then y = TOP_FALLBACK - TOP_PAD end
	return y
end

-- desktop: legacy chat sits top-left over the stats block; move its window to the bottom-left instead.
-- SetCore throws until the chat CoreScript has registered it, so retry for a while. TextChatService places
-- its own window through ChatWindowConfiguration (VerticalAlignment = Bottom in the place file).
local LEGACY_CHAT_POS = UDim2.new(0, 0, 0.6, 0)
-- TextChatService: close the chat window once at start (SetCore throws until the chat CoreScript registered it)
function L.CloseChatOnce()
	local okVersion, isTcs = pcall(function()
		return TextChatService.ChatVersion == Enum.ChatVersion.TextChatService
	end)
	if not okVersion or not isTcs then return end
	for _ = 1, 20 do
		if pcall(StarterGui.SetCore, StarterGui, "ChatActive", false) then return end
		task.wait(0.5)
	end
end

local function placeLegacyChat()
	if IS_TOUCH then return end
	local okVersion, isLegacy = pcall(function()
		return TextChatService.ChatVersion == Enum.ChatVersion.LegacyChatService
	end)
	if not okVersion or not isLegacy then return end
	for _ = 1, 20 do
		if pcall(StarterGui.SetCore, StarterGui, "ChatWindowPosition", LEGACY_CHAT_POS) then return end
		task.wait(0.5)
	end
end

-- false when the text has a symbol Gotham / the Korean fallback font lacks (⚙ ⚔ ↻ render as tofu boxes);
-- CR-L44: the shared Util.GlyphSafe (missing = unsafe, so the emblem is just left out)
local function glyphSafe(text)
	return type(Util.GlyphSafe) == "function" and Util.GlyphSafe(text) == true
end

-- Config.UIArt.Colors[key] / Fonts[key] with a fallback (the art table may be missing)
local function ac(key, fallback)
	local c = type(ART.Colors) == "table" and ART.Colors[key] or nil
	if typeof(c) == "Color3" then return c end
	return fallback
end

local function af(key, fallback)
	local f = type(ART.Fonts) == "table" and ART.Fonts[key] or nil
	if typeof(f) == "EnumItem" then return f end
	return fallback
end

local function corner(radius)
	return UIKit.Create("UICorner", { CornerRadius = radius or UDim.new(0, 12) })
end

-- U5: on touch every HUD text stays >= 11 real px = L.TouchText units at the 0.75 touch UIScale
local function touchFloor(label)
	if not IS_TOUCH or not label then return label end
	local tc = label:FindFirstChildOfClass("UITextSizeConstraint")
	if tc then
		tc.MaxTextSize = math.max(tc.MaxTextSize, L.TouchText) -- raise the cap first: min must stay <= max
		tc.MinTextSize = L.TouchText
	end
	if label.TextSize < L.TouchText then label.TextSize = L.TouchText end
	return label
end

-- Keep approved HUD art and the active UIKit font family. Caps are physical pixels, so a large GUI scale
-- cannot turn small HUD captions into oversized letters. Table members avoid adding chunk locals (200 limit).
-- minPixels: the smallest real px the fit may pick (default 11)
function L.FitText(label, pixels, bold, minPixels)
	if not label then return label end
	ui.textFits = ui.textFits or setmetatable({}, { __mode = "k" })
	local fit = ui.textFits[label]
	if not fit then
		fit = { Truncate = label.TextTruncate, Connections = {} }
		ui.textFits[label] = fit
		fit.Apply = function()
			if not label.Parent then return end
			local s = currentScale()
			local mp = fit.MinPixels or 11
			local minSize = math.max(1, math.min(mp, math.floor(mp / s)))
			local maxSize = math.max(minSize, math.floor(fit.Pixels / s))
			if fit.Min == minSize and fit.Max == maxSize then return end
			fit.Min, fit.Max = minSize, maxSize
			local tc = label:FindFirstChildOfClass("UITextSizeConstraint")
			if tc then tc.MaxTextSize = 100; tc.MinTextSize = minSize; tc.MaxTextSize = maxSize end
			if label.AutomaticSize == Enum.AutomaticSize.X or label.AutomaticSize == Enum.AutomaticSize.XY then
				-- Auto-width pills follow their text; fitting against their previous width would shrink every update.
				label.TextScaled = false
				label.TextSize = maxSize
			else
				UIKit.FitText(label, minSize, maxSize)
			end
			label.TextTruncate = fit.Truncate
		end
		table.insert(fit.Connections, label:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit.Apply))
		table.insert(fit.Connections, label.Destroying:Connect(function()
			for _, connection in fit.Connections do connection:Disconnect() end
			ui.textFits[label] = nil
		end))
	end
	fit.Pixels = pixels or 12
	fit.MinPixels = minPixels
	UIKit.ApplyFont(label, bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular)
	label.TextWrapped = false
	label.TextStrokeTransparency = 1
	label:SetAttribute("PickerMeasureWhole", label.RichText ~= true)
	local outline = label:FindFirstChild("Outline")
	if outline and outline:IsA("UIStroke") then outline.Thickness = 0.4; outline.Transparency = 0.65 end
	label:SetAttribute("PickerOutlineThickness", 0.4)
	fit.Apply()
	return label
end
HUD.FitText = L.FitText

-- UIKit.InkText (brown ink on parchment) or UIKit.LightText (white / gold on navy, bars, round buttons) + touch floor
local function artLabel(ink, props)
	if IS_TOUCH then
		if type(props.TextSize) == "number" then props.TextSize = math.max(props.TextSize, L.TouchText) end
		if type(props.MaxTextSize) == "number" then props.MaxTextSize = math.max(props.MaxTextSize, L.TouchText) end
	end
	local label = nil
	if ink then
		label = UIKit.InkText(props)
	else
		label = UIKit.LightText(props)
	end
	UIKit.ApplyFont(label, props.Title and Enum.FontWeight.Bold or Enum.FontWeight.Regular)
	local outline = label:FindFirstChild("Outline")
	if outline and outline:IsA("UIStroke") then outline.Thickness = 0.4; outline.Transparency = 0.65 end
	return L.FitText(touchFloor(label), props.Title and 13 or 12, props.Title)
end

local function isImage(obj)
	return typeof(obj) == "Instance" and (obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
end

-- art parts tint through ImageColor3 (multiply); their code-drawn fallbacks (IMG-R4) take `fill` as background
local function paint(obj, tint, fill)
	if isImage(obj) then
		obj.ImageColor3 = tint
	elseif typeof(obj) == "Instance" and fill then
		obj.BackgroundColor3 = fill
	end
end

-- disabled / waiting look: faded art, or a more transparent fallback (normalT = its usual transparency)
local function setDim(obj, dim, normalT)
	if isImage(obj) then
		obj.ImageTransparency = dim and 0.4 or 0
	elseif typeof(obj) == "Instance" then
		obj.BackgroundTransparency = dim and 0.5 or (normalT or 0)
	end
end

-- gold ring just outside a button (affordable pulse / menu hint), hidden until used; returns its UIStroke
local function makeGlow(parent, radius)
	local frame = UIKit.Create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 4, 1, 4),
		BackgroundTransparency = 1,
		ZIndex = 9,
		Parent = parent,
	}, {
		corner(radius),
		UIKit.Create("UIStroke", {
			Name = "GlowStroke",
			Color = ac("Gold", Theme.Gold),
			Thickness = 3,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	})
	return frame:FindFirstChild("GlowStroke")
end

-- the shared press feel (UIKit.ButtonFeel / FeelPress, 검수 2026-10-06): keys and holds press the same way as a finger
local function pressScale(btn, down)
	if btn and type(UIKit.FeelPress) == "function" then UIKit.FeelPress(btn, down) end
end

local function isPressInput(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

----------------------------------------------------------------- layout (forward-declared users)
local applyLayout -- assigned below
local refreshChips -- assigned with the chips (refreshStats calls it for the wanted chip)
local refreshQuests -- assigned with the quest rows (the header toggle calls it)
local toggleQuests -- assigned with the quest rows (header / overlay close button)

local function requestLayout()
	if layoutPending then return end
	layoutPending = true
	task.defer(function()
		layoutPending = false
		local ok, err = pcall(applyLayout)
		if not ok then warnThrottled("layout error: " .. tostring(err)) end
	end)
end

----------------------------------------------------------------- building: player card (top-left)
------------------------------------------------------------------ BB5 "전투력" (Config.CombatPower, server attribute)
-- Desktop: right half of the class row; touch: right half of the bank row. A rise floats a gold "+N" and counts the
-- number up (not when the level changed in the same moment: the level-up banner already celebrates). Drops are silent.
-- Changes within 0.4 s merge; while the opening / a picker is open one pending popup waits. Tap -> "Character" window.
L.Pow = { Shown = nil, Base = nil, Seq = 0, LevelAt = -10, MergeAt = 0, Pending = false, Merge = 0.4, Count = 0.6 }

function L.PowerValue()
	local v = tonumber(attr("CombatPower", nil))
	if v then return math.floor(v) end
	local lv = math.floor(num("Level", 1))
	local tier = math.clamp(math.floor(num("WeaponTier", 0)), 0, Config.MaxWeaponTier) -- A23-34: 0 = bare hands
	return Config.CombatPower(lv, tier, num("WeaponEnhance", 0)) -- before the server's first set
end

function L.PowerText(n)
	return string.format(TXT.PowerLine, math.floor(num("Level", 1)), TXT.PowerWord, Util.FormatInt(n))
end

function L.PowerOpen()
	local P = C and C.Panels
	if type(P) == "table" and type(P.Has) == "function" and P.Has("Character") then pcall(P.Open, "Character") end
end

-- a transparent tap area (>= 44 real px tall where possible) over a label / portrait
function L.PowerHit(target)
	local hit = UIKit.Create("TextButton", {
		Name = "OpenCharacter",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = (target.ZIndex or 1) + 2,
		Parent = target,
	})
	hit.Activated:Connect(L.PowerOpen)
	return hit
end

-- 'Lv 10 · 전투력 424 · 주머니 1.2K' (A23-26, 검수 2026-10-06 (a)): one row on Rects.power_line; both labels follow their
-- text. Layout B has no line for the pouch under the XP bar (the tile row is there): when the pair does not fit the row
-- the pouch hides (L.CheckPouch); 내 캐릭터 still shows it
function L.PowerBuild(parent)
	ui.powerRow = UIKit.Create("Frame", {
		Name = "PowerLine",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(260, 20),
		ZIndex = 2,
		Parent = parent,
	}, {
		UIKit.Create("UIListLayout", {
			Name = "List",
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
	})
	local function line(name, order, color, bold, par)
		return L.FitText(artLabel(false, {
			Name = name,
			LayoutOrder = order,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			TextSize = 14,
			Number = true,
			Color = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = par,
		}), 13, bold)
	end
	ui.power = line("Power", 1, ac("GoldText", Theme.Gold), true, ui.powerRow)
	ui.power.Text = L.PowerText(L.PowerValue())
	ui.pouch = line("Pouch", 2, ac("LightSub", Theme.SubText), false, ui.powerRow)
	-- A23-35 / A23-40: no plate under the line (PC: over the ground) -> the dark text style's navy rim; gold stays gold
	-- (the white -> cream gradient multiplies the colour)
	if type(UIKit.StyleText) == "function" then
		UIKit.StyleText(ui.power, "Number")
		UIKit.StyleText(ui.pouch, "Number")
		ui.power.TextColor3 = ac("GoldText", Theme.Gold)
	end
	L.PowerHit(ui.powerRow)
	ui.power:GetPropertyChangedSignal("AbsoluteSize"):Connect(L.CheckPouch)
	ui.pouch:GetPropertyChangedSignal("AbsoluteSize"):Connect(L.CheckPouch)
end

-- the pouch rides the power line while both fit its rect (2du spare against flicker), else it hides
function L.CheckPouch()
	local R = L.Rects
	if not R or not ui.power or not ui.pouch or not ui.powerRow then return end
	local s = currentScale()
	local gap = ui.powerRow.List.Padding.Offset
	local need = (ui.power.AbsoluteSize.X + ui.pouch.AbsoluteSize.X) / s + gap
	local fits = need <= R.power_line.W - (ui.pouch.Visible and 0 or 2)
	if ui.pouch.Visible ~= fits then ui.pouch.Visible = fits end
end

function L.PowerSet(n)
	L.Pow.Shown = n
	if ui.power then ui.power.Text = L.PowerText(n) end
end

-- gold "+N" floating up from the end of the power number, and the number counting up to the new value. The popup sits on
-- the plate group just above the power label's right edge (never over the pouch: 검수 2026-10-06, BB5). delta = the real
-- rise (from is only where the count-up starts; it may be mid-way through an earlier count-up).
function L.PowerPopup(from, to, delta)
	local label = ui.power
	if not label or not label.Parent or not ui.stats then L.PowerSet(to) return end
	L.Pow.Seq += 1
	local seq = L.Pow.Seq
	local s = currentScale()
	local origin = ui.stats.AbsolutePosition
	local x = (label.AbsolutePosition.X + label.AbsoluteSize.X - origin.X) / s
	local y = (label.AbsolutePosition.Y - origin.Y) / s
	local pop = artLabel(false, {
		Name = "PowerUp",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(90, IS_TOUCH and 22 or 18),
		TextScaled = true,
		MaxTextSize = IS_TOUCH and 18 or 15,
		Number = true,
		Color = ac("GoldText", Theme.Gold),
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "+" .. Util.FormatInt(delta or (to - from)), -- next to the number, so the bare "+N"
		ZIndex = 8,
		Parent = ui.stats,
	})
	TweenService:Create(pop, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(x, y - 22), TextTransparency = 1,
	}):Play()
	task.delay(1.2, function() pop:Destroy() end)
	task.spawn(function()
		local t0 = os.clock()
		while seq == L.Pow.Seq do
			local k = math.clamp((os.clock() - t0) / L.Pow.Count, 0, 1)
			L.PowerSet(math.floor(from + (to - from) * k + 0.5))
			if k >= 1 then break end
			task.wait(1 / 30)
		end
	end)
end

-- 0.4 s after the first change: compare with the value shown before it
function L.PowerSettle()
	local P = L.Pow
	if pickersOpen() then
		P.Pending = true -- one popup waits for the opening / picker to close (checked again by the next change / loop)
		task.delay(1, L.PowerSettle)
		return
	end
	P.Pending = false
	P.MergeAt = 0
	local n, base = L.PowerValue(), P.Base or L.PowerValue()
	P.Base = n
	if n > base and os.clock() - P.LevelAt > P.Merge + 0.3 then
		L.PowerPopup(P.Shown or base, n, n - base)
	else
		P.Seq += 1 -- stop a running count-up
		L.PowerSet(n)
	end
end

function L.PowerChanged()
	local P = L.Pow
	-- the baseline starts only after the save loaded and the class was picked (no popup for the first number)
	if attr("DataLoaded", false) ~= true or attr("ClassChosen", false) ~= true or P.Base == nil then
		if attr("DataLoaded", false) == true and attr("ClassChosen", false) == true then P.Base = L.PowerValue() end
		P.Seq += 1
		L.PowerSet(L.PowerValue())
		return
	end
	if P.MergeAt > 0 or P.Pending then return end -- already waiting: the settle reads the latest value
	P.MergeAt = os.clock()
	task.delay(P.Merge, L.PowerSettle)
end

-- A23-26 v2 top-left plate, no card: the round portrait (my live 3D head in the PortraitRing hole, the account headshot
-- while it loads) with the faction level badge on its lower-left, HP / MP bars beside it (VitalsUI), the power line under
-- them and a thin XP bar under the whole block. ui.stats is a transparent full-screen group; every piece is placed from
-- the HudLayout rects by L.LayoutPlate. Tapping the portrait or the power line opens 내 캐릭터 (L.PowerHit shows the
-- hit area only once Panels has the window: no silent no-op).
local function buildStats(root)
	local f = UIKit.Create("Frame", {
		Name = "Stats",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = root,
	})
	ui.stats = f
	local holder = UIKit.Create("Frame", {
		Name = "Portrait",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(80, 80),
		ZIndex = 2,
		Parent = f,
	})
	local holePos, holeSize = UIKit.ArtInner("PortraitRing")
	local head = UIKit.Create("ImageLabel", {
		Name = "Headshot",
		Image = UIKit.HeadshotImage(),
		ScaleType = Enum.ScaleType.Crop,
		BackgroundColor3 = ac("NavyDeep", Theme.Bg),
		Position = holePos or UDim2.fromScale(0.17, 0.16),
		Size = holeSize or UDim2.fromScale(0.67, 0.67),
		ZIndex = 1,
		Parent = holder,
	}, { corner(UDim.new(0.5, 0)) })
	ui.portraitHolder = holder
	ui.portraitHeadshot = head
	local ring = UIKit.ArtImage("PortraitRing", {
		Name = "Ring",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = holder,
	})
	if not ring then
		-- IMG-R4: gold ring drawn in code
		UIKit.Create("UIStroke", {
			Color = ac("Gold", Theme.Gold),
			Thickness = 3,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = head,
		})
	end
	ui.portraitHit = L.PowerHit(holder)
	-- faction-shaped level badge over the ring's lower-left (L.RefreshBadge builds the art + the number)
	ui.badgeHolder = UIKit.Create("Frame", {
		Name = "LevelBadge",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(-0.1, 1.1),
		Size = UDim2.fromScale(0.48, 0.48),
		ZIndex = 4,
		Parent = holder,
	})
	L.RefreshBadge()
	C.VitalsUI.BuildStats(f, IS_TOUCH)
	L.PowerBuild(f)
	-- thin XP bar (8 px PC / 6 px phone: no text inside)
	local xpFrame, setXP, xpText = UIKit.ArtBar({
		Name = "XPBar",
		Size = UDim2.fromOffset(300, IS_TOUCH and 8 or 10),
		Color = ac("XPBlue", Theme.XP),
		Parent = f,
	})
	ui.setXP = setXP
	ui.xpFrame = xpFrame
	ui.xpText = xpText
	xpText.Visible = false
	ui.potions = C.VitalsUI.BuildPotions(root, IS_TOUCH)
end

-- faction-shaped level badge (bundle 6): Halo ivory centre with a dark number, Horns / Artisan / none navy with light
function L.RefreshBadge()
	local key = L.Badge[getFaction()] or "LevelBadge"
	if ui.badgeKey == key and ui.level and ui.level.Parent then return end
	ui.badgeKey = key
	ui.badgeHolder:ClearAllChildren()
	UIKit.ArtFrame(key, {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = ui.badgeHolder,
	}, { StrokeThickness = 2 })
	local facePos, faceSize = UIKit.ArtInner(key)
	local face = UIKit.Create("Frame", {
		Name = "Face",
		BackgroundTransparency = 1,
		Position = facePos or UDim2.fromScale(0.17, 0.18),
		Size = faceSize or UDim2.fromScale(0.65, 0.62),
		ZIndex = 5,
		Parent = ui.badgeHolder,
	})
	local ink = key == "LevelBadgeHalo"
	ui.level = L.FitText(artLabel(ink, {
		Name = "Level",
		Size = UDim2.fromScale(1, 1),
		TextScaled = true,
		MaxTextSize = 26,
		Number = true,
		Color = ink and ac("Ink", COL.Dark) or ac("Light", COL.White),
		Text = tostring(math.floor(num("Level", 1))),
		ZIndex = 6,
		Parent = face,
	}), 14, true)
end

-- places the plate from the HudLayout rects
function L.LayoutPlate(R)
	local p = R.portrait
	ui.portraitHolder.Position = UDim2.fromOffset(p.X, p.Y)
	ui.portraitHolder.Size = UDim2.fromOffset(p.W, p.H)
	C.VitalsUI.PlaceBars(R.hp_bar, R.mp_bar)
	local pl = R.power_line
	ui.powerRow.Position = UDim2.fromOffset(pl.X, pl.Y)
	ui.powerRow.Size = UDim2.fromOffset(pl.W, pl.H)
	local xp = R.xp_bar
	ui.xpFrame.Position = UDim2.fromOffset(xp.X, xp.Y)
	ui.xpFrame.Size = UDim2.fromOffset(xp.W, xp.H)
	L.CheckPouch()
end

----------------------------------------------------------------- building: war meter (top center)

-- a soft dark band behind plate-less text over the world (review 2026-10-06: the quest lines / the war line got lost over
-- bright ground and sky): BandInk at L.BandAlpha where darkest, fading out. side = "Right" (text starts at the left,
-- the band fades to the right like the reference game's quest text) or "Center" (fades both ways). ZIndex under the text
function L.SoftBand(parent, side)
	local a = L.BandAlpha
	local seq = side == "Center"
			and NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, a),
				NumberSequenceKeypoint.new(0.8, a), NumberSequenceKeypoint.new(1, 1) })
		or NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(0.55, a + 0.05),
			NumberSequenceKeypoint.new(1, 1) })
	return UIKit.Create("Frame", {
		Name = "Band",
		BackgroundColor3 = COL.BandInk,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(side == "Center" and -24 or -8, -2),
		Size = UDim2.new(1, side == "Center" and 48 or 64, 1, 4),
		ZIndex = 1,
		Parent = parent,
	}, {
		corner(UDim.new(0, 8)),
		UIKit.Create("UIGradient", { Transparency = seq }),
	})
end

-- gold 빛 fill from the left and crimson 뿔 fill from the right inside the BarTrack capsule, the faction badges (bundle 6)
-- over both ends, the crown riding the split, info pills under it. applyLayout sizes it from Rects.war_meter (L.LayoutWar).
local function buildWar(root)
	local W = 360
	local w = UIKit.Create("Frame", {
		Name = "WarMeter",
		Position = UDim2.new(0.5, -W / 2, 0, 8 + TOP_FALLBACK),
		Size = UDim2.fromOffset(W, 56),
		BackgroundTransparency = 1,
		Parent = root,
	})
	ui.war = w
	local shieldW, barY, barH = 30, 8, 22
	-- Bar / Info follow the meter's width; L.LayoutWar fits them to its height
	local bar, barArt = UIKit.ArtFrame("BarTrack", {
		Name = "Bar",
		Position = UDim2.fromOffset(shieldW - 10, barY),
		Size = UDim2.new(1, -2 * (shieldW - 10), 0, barH),
		Parent = w,
	}, {
		Color = COL.WarFill,
		BackgroundTransparency = 0.15,
		CornerRadius = UDim.new(0.5, 0),
		StrokeColor = COL.Black,
		StrokeTransparency = 0.4,
	})
	-- fills live in the capsule's navy interior (BarTrack Inner rect; its edges follow the height)
	local top, bottom, side = 0, 0, 0
	local def = barArt and UIKit.ArtPart("BarTrack") or nil
	if def and typeof(def.Inner) == "Rect" and typeof(def.Size) == "Vector2" and def.Size.Y > 0 then
		top = def.Inner.Min.Y / def.Size.Y
		bottom = (def.Size.Y - def.Inner.Max.Y) / def.Size.Y
		side = math.floor(def.Inner.Min.X / def.Size.Y * barH + 0.5)
	end
	local inner = UIKit.Create("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, side, top, 0),
		Size = UDim2.new(1, -2 * side, 1 - top - bottom, 0),
		Parent = bar,
	})
	local function fill(name, color, fromRight)
		return UIKit.Create("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(fromRight and 1 or 0, 0),
			Position = UDim2.fromScale(fromRight and 1 or 0, 0),
			Size = UDim2.fromScale(0.5, 1),
			BackgroundColor3 = color,
			Parent = inner,
		}, {
			corner(UDim.new(0.5, 0)),
			UIKit.Create("UIGradient", {
				Rotation = 90,
				Color = ColorSequence.new(COL.White, Color3.fromRGB(205, 205, 205)),
			}),
		})
	end
	ui.haloFill = fill("HaloFill", ac("WarHalo", Theme.Halo), false)
	ui.hornsFill = fill("HornsFill", ac("WarHorns", Theme.Horns), true)
	ui.warDivider = UIKit.Create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 3, 1, 4),
		BackgroundColor3 = Color3.fromRGB(255, 248, 225),
		ZIndex = 2,
		Parent = inner,
	}, { corner(UDim.new(0, 2)) })
	-- crown on the split, its base at the bar's middle
	ui.warCrown = UIKit.ArtImage("Crown", {
		Name = "Crown",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(27, 18),
		ZIndex = 3,
		Parent = inner,
	})
	ui.haloNum = artLabel(false, {
		Name = "HaloScore",
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(0.5, -20, 1, 0),
		TextSize = 15,
		Number = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
		Parent = bar,
	})
	ui.hornsNum = artLabel(false, {
		Name = "HornsScore",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 0),
		Size = UDim2.new(0.5, -20, 1, 0),
		TextSize = 15,
		Number = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 2,
		Parent = bar,
	})
	-- faction shields over both ends of the bar
	for _, s in { { "LevelBadgeHalo", 0, "ShieldHalo" }, { "LevelBadgeHorns", 1, "ShieldHorns" } } do
		UIKit.ArtImage(s[1], {
			Name = s[3],
			AnchorPoint = Vector2.new(s[2], 0.5),
			Position = UDim2.new(s[2], 0, 0, barY + barH / 2),
			Size = UDim2.fromOffset(shieldW + 4, shieldW + 4),
			ZIndex = 3,
			Parent = w,
		})
	end
	ui.warBar = bar

	-- review 2026-10-06 (devlog 12: the three pills' ~10 px text could not be read on phones): ONE outlined line under the
	-- bar over a soft dark band, "왕관 결정까지 9:40 · 내 점수 0" (siege: "포위전 1인당 150점 · 9:40 · 내 점수 0";
	-- Neutral / None earn no points: no 내 점수). L.WarLine writes it
	local row = UIKit.Create("Frame", {
		Name = "Info",
		Position = UDim2.fromOffset(0, barY + barH + 3),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Parent = w,
	})
	ui.warBand = L.SoftBand(row, "Center")
	ui.warLine = UIKit.StyledLabel({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		TextScaled = true,
		RichText = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
		Parent = row,
	}, "NameTag")
	ui.warInfo = row
	L.WatchWarLine()
end

-- the bar keeps 22du, the info line takes the rest of the meter's height (Rects.war_meter: 52.5du PC, 50.7du phone):
-- 19.5du = 15.6 px on the PC, 17.7du = 13.3 px on the reference phone (NameTag floor 12 px)
function L.LayoutWar(h)
	L.WarH = h
	local info = math.clamp(h - 8 - 22 - 3, 14, 22)
	ui.warInfo.Position = UDim2.fromOffset(0, 8 + 22 + 3)
	ui.warInfo.Size = UDim2.new(1, 0, 0, info)
	-- the band hugs the text: as wide as the line plus a margin that fades out
	local tb = ui.warLine.TextBounds.X
	if ui.warBand and tb > 0 then
		local bw = math.min(ui.warInfo.AbsoluteSize.X > 0 and (tb / math.max(0.01, ui.warLine.AbsoluteSize.X)) or 1, 1)
		ui.warBand.Size = UDim2.new(bw, 48, 1, 4)
		ui.warBand.Position = UDim2.new((1 - bw) / 2, -24, 0, -2)
	end
end

-- the war meter's info line from its parts (time always, siege while WarMode = Siege, my points for Halo / Horns).
-- A23-40 보강: in the top bar the meter is narrower on small phones; when the whole line does not fit at the text
-- floor, 'My pts' is left out (L.WarShort, set by the line's TextFits; a wider meter tries the whole line again)
function L.WarLine(parts)
	if not ui.warLine then return end
	local list = {}
	if parts.Siege then
		-- orange (Theme.Revenge), not ink red: the line sits over the world (UiSandbox 2026-10-06: red on the dark gate
		-- could not be read)
		table.insert(list, string.format('<font color="#%s">%s</font>', Theme.Revenge:ToHex(), parts.Siege))
		table.insert(list, parts.Clock)
	else
		table.insert(list, parts.Time)
	end
	local short = table.concat(list, TXT.WarSep)
	L.WarTexts = { parts.Points and (short .. TXT.WarSep .. parts.Points) or short, short }
	L.ApplyWarLine()
end

function L.ApplyWarLine()
	local texts = L.WarTexts
	if not texts or not ui.warLine then return end
	local text = L.WarShort and texts[2] or texts[1]
	if ui.warLine.Text ~= text then
		ui.warLine.Text = text
		task.defer(function()
			if L.WarH then L.LayoutWar(L.WarH) end -- the band follows the new text width
		end)
	end
end

-- the line overflows its box at the style's text floor (TextBounds wider than the label, or TextFits false): drop
-- 'My pts' until the meter grows again (UiSandbox 2026-10-06: the 180 px phone meter cut the line after "My")
function L.CheckWarLine()
	local line = ui.warLine
	if not line or L.WarShort then return end
	local over = (not line.TextFits) or line.TextBounds.X > line.AbsoluteSize.X + 0.5
	local texts = L.WarTexts
	if over and texts and texts[2] ~= texts[1] then
		L.WarShort = true
		L.WarShortAt = ui.warInfo.AbsoluteSize.X
		L.ApplyWarLine()
	end
end

function L.WatchWarLine()
	for _, prop in { "TextFits", "TextBounds", "AbsoluteSize" } do
		ui.warLine:GetPropertyChangedSignal(prop):Connect(L.CheckWarLine)
	end
	ui.warInfo:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if L.WarShort and ui.warInfo.AbsoluteSize.X > (L.WarShortAt or 0) + 1 then
			L.WarShort = false
			L.ApplyWarLine()
		end
	end)
end

----------------------------------------------------------------- building: status chips
-- candy pill (fill + inked rim + dark text) with an optional art icon (안전 지대 IconSafe, 새싹 IconSprout, 축복 Crown)
local function makeChip(name, order, icon)
	local frame = UIKit.Create("Frame", {
		Name = name,
		LayoutOrder = order,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, L.ChipH),
		BackgroundColor3 = Theme.Bg,
		Visible = false,
		Parent = ui.chips,
	}, {
		corner(UDim.new(0.5, 0)),
		UIKit.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
		UIKit.Create("UIStroke", {
			Name = "Stroke",
			Thickness = 2,
			Color = Theme.SubText,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		UIKit.Create("UIGradient", { -- glossy candy shading
			Rotation = 90,
			Color = ColorSequence.new(COL.White, Color3.fromRGB(222, 222, 222)),
		}),
	})
	local chip = { Frame = frame, Stroke = frame:FindFirstChild("Stroke") }
	if icon then
		chip.Icon = UIKit.ArtImage(icon, {
			Name = "Icon",
			LayoutOrder = 1,
			Size = UDim2.fromOffset(L.ChipH - 2, L.ChipH - 2),
			Visible = false,
			Parent = frame,
		})
	end
	chip.Pad = UIKit.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		Parent = frame,
	})
	chip.Label = artLabel(true, {
		Name = "Text",
		LayoutOrder = 2,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		TextSize = 13,
		Outline = false,
		Parent = frame,
	})
	return chip
end

-- palette = { fill, rim, text } (the art's chip colours) or nil = derived from `color` (bright = solid fill)
local function setChip(chip, visible, text, color, bright, palette, withIcon)
	if not chip then return end
	chip.Frame.Visible = visible == true
	if not visible then return end
	color = color or Theme.SubText
	local fill, rim, ink
	if palette then
		fill, rim, ink = palette[1], palette[2], palette[3]
	elseif bright then
		fill, rim, ink = color, color:Lerp(COL.Black, 0.45), COL.Dark
	else
		fill, rim, ink = color:Lerp(COL.White, 0.7), color:Lerp(COL.Black, 0.3), color:Lerp(COL.Black, 0.62)
	end
	chip.Frame.BackgroundColor3 = fill
	if chip.Stroke then chip.Stroke.Color = rim end
	chip.Label.TextColor3 = ink
	chip.Label.Text = text or ""
	local iconOn = withIcon == true and chip.Icon ~= nil
	if chip.Icon then chip.Icon.Visible = iconOn end
	chip.Pad.PaddingLeft = UDim.new(0, iconOn and 4 or 10)
end

local function buildChips(root)
	-- applyLayout sets the width (CR-L36: the war meter column). A23-40: one row only (no wrapping); chips that do not
	-- fit fold into the '+N' chip (L.CheckChipFit)
	ui.chips = UIKit.Create("Frame", {
		Name = "StatusChips",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 106 + TOP_FALLBACK),
		Size = UDim2.fromOffset(900, L.ChipH + 6),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local chipList = UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = ui.chips,
	})
	ui.chipList = chipList
	chipList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() L.CheckChipFit() end)
	ui.chips:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() L.CheckChipFit() end)
	ui.chipPal = {
		Safe = { ac("ChipSafe", Theme.Good), ac("ChipSafeRim", Theme.Good), ac("ChipSafeText", COL.Dark) },
		Rookie = { ac("ChipRookie", Theme.XP), ac("ChipRookieRim", Theme.XP), ac("ChipRookieText", COL.Dark) },
	}
	-- A23-26 order: zone -> luck -> danger (bully, wanted, combat) -> rookie / protected -> blessing, size, kaiju queue.
	-- A23-40: the first L.MaxChips that show stay, the rest fold into one '+N' chip (refreshChips)
	local icons = { Blessing = "Crown", Zone = "IconSafe", Rookie = "IconSprout", Luck = "IconClover", Wanted = "IconStar" }
	ui.chip = {}
	L.ChipOrder = { "Zone", "Luck", "Bully", "Wanted", "Combat", "Rookie", "Protected", "Blessing", "Size", "Kaiju" }
	L.MaxChips = IS_TOUCH and 2 or 3 -- the phone row is 240 px wide
	for i, key in L.ChipOrder do
		ui.chip[key] = makeChip(key, i, icons[key])
	end
	ui.chipMore = makeChip("More", #L.ChipOrder + 1, nil)
	L.ChipFit, L.ChipWantKey = L.MaxChips, ""
end

-- A23-40: the row is too wide for its rect -> one chip fewer (the '+N' chip takes it); refreshChips starts again from
-- L.MaxChips whenever the set of chips that want to show changes
function L.CheckChipFit()
	if not ui.chips or not ui.chipList then return end
	local content, room = ui.chipList.AbsoluteContentSize.X, ui.chips.AbsoluteSize.X
	if room > 0 and content > room + 1 and L.ChipFit > 1 then
		L.ChipFit -= 1
		task.defer(function()
			local ok, err = pcall(refreshChips)
			if not ok then warnThrottled("chip fit failed: " .. tostring(err)) end
		end)
	end
end

----------------------------------------------------------------- building: quests
-- navy header plate (RibbonHeader = Firefly PanelHeader: star in its left disc, "오늘의 퀘스트 (1/3) · 받기 N", chevron)
-- over parchment rows, on Rects.quest (A23-26: top-right under the rail). Desktop: the header toggles the list
-- (collapsed = header + the 'now do' row + one more, 검수 2026-10-06 (b): the next-goal row always shows). Touch (U5 /
-- CR-M25): two lines in the header (line 1 = the 'now do' row, line 2 = story call / 받기 N / today's count); the rows
-- with 받기 / 교체 live in an overlay opened from the header.
local function buildQuests(root)
	ui.quests = UIKit.Create("Frame", {
		Name = "Quests",
		Position = UDim2.fromOffset(12, 200 + TOP_FALLBACK),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = root,
	}, {
		UIKit.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, L.QuestGap),
		}),
	})
	local hh = L.QuestHeaderH
	ui.questHeader = UIKit.ArtButton("RibbonHeader", {
		Name = "Header",
		LayoutOrder = 0,
		Size = UDim2.fromOffset(300, hh),
		Parent = ui.quests,
	}, function()
		-- B15: on touch the header line reads "…말을 걸어요 — 눌러서 보기" while a story waits: one tap opens it
		if IS_TOUCH and questState.CallEntry and L.PinnedTap then
			L.PinnedTap(questState.CallEntry)
			return
		end
		-- review 2026-10-06: the line reads "5/5 ... [받기]를 눌러요": one tap claims (no list first)
		local se = questState.ShownEntry
		if IS_TOUCH and se and L.PinnedTap and L.ClaimableMission(se) then
			L.PinnedTap(se)
			return
		end
		toggleQuests()
	end, { CornerRadius = UDim.new(0, 10) })
	-- the star sits in the plate's left disc; L.LayoutQuestHeader follows the header height
	ui.questHeaderIcon = UIKit.ArtImage("IconStar", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, hh * 0.47, 0.5, 0),
		Size = UDim2.fromOffset(hh * 0.6, hh * 0.6),
		ZIndex = 2,
		Parent = ui.questHeader,
	})
	ui.questHeaderText = artLabel(false, {
		Name = "Text",
		Position = UDim2.fromOffset(hh + 4, 4),
		Size = UDim2.new(1, -hh - 30, 1, -8),
		TextScaled = true,
		MaxTextSize = 14,
		Title = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
		Parent = ui.questHeader,
	})
	ui.questChevron = artLabel(false, {
		Name = "Chevron",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(16, hh - 8),
		TextScaled = true,
		MaxTextSize = 14,
		Text = TXT.QuestExpand,
		ZIndex = 2,
		Parent = ui.questHeader,
	})
	L.FitText(ui.questHeaderText, 13, true)
	L.FitText(ui.questChevron, 11)
	if IS_TOUCH then
		-- line 2 (A23-26 phone quest line): story call / 받기 N / today's count
		ui.questHeaderSub = L.FitText(artLabel(false, {
			Name = "Sub",
			Size = UDim2.new(1, -hh - 30, 0.5, -2),
			TextScaled = true,
			MaxTextSize = 14,
			Color = ac("LightSub", Theme.SubText),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 2,
			Parent = ui.questHeader,
		}), 12)
	end

	local listParent = ui.quests
	ui.questRowW = 300 -- applyLayout: Rects.quest width (desktop)
	if IS_TOUCH then
		local pad = 10
		ui.questRowW = L.OverlayW - 2 * pad
		ui.questOverlay = UIKit.ArtFrame("PanelParchment", {
			Name = "QuestOverlay",
			Size = UDim2.fromOffset(L.OverlayW, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = false,
			ZIndex = 20,
			Parent = root,
		}, nil, {
			UIKit.Create("UIPadding", {
				PaddingLeft = UDim.new(0, pad),
				PaddingRight = UDim.new(0, pad),
				PaddingTop = UDim.new(0, pad),
				PaddingBottom = UDim.new(0, pad + 2),
			}),
			UIKit.Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6),
			}),
		})
		local top = UIKit.Create("Frame", {
			Name = "Top",
			LayoutOrder = 0,
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			Parent = ui.questOverlay,
		})
		ui.questOverlayTitle = artLabel(true, {
			Name = "Title",
			Size = UDim2.new(1, -80, 1, 0),
			TextScaled = true,
			MaxTextSize = 17,
			Title = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = top,
		})
		local _, closeLabel = UIKit.ArtButton("Pill", {
			Name = "Close",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(72, 30),
			Text = TXT.QuestClose,
			TextSize = 16,
			Parent = top,
		}, function()
			toggleQuests(false)
		end, { CornerRadius = UDim.new(0.5, 0) })
		L.FitText(ui.questOverlayTitle, 13, true)
		L.FitText(closeLabel, 12)
		listParent = ui.questOverlay
	end
	ui.questList = UIKit.Create("Frame", {
		Name = "Rows",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(ui.questRowW, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = listParent,
	}, {
		UIKit.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, L.QuestGap),
		}),
	})
end

----------------------------------------------------------------- building: quest lines (A23-40: no plate)
-- Two outlined text lines on Rects.quest (PC: under the minimap; phones: beside it, outside the thumbstick zone):
-- [icon] what to do ... 3/5 | [받기]. Line 1 = the 'now do' row (pinned guide / next goal / waiting story / first
-- claimable / first daily), line 2 = the next one (else today's count). PC: each line is its own button (a claimable line
-- claims, the pinned / story line runs its action, any other line folds the full list out under the lines, ▼/▲).
-- Phones: the block is one thumb-size button (line 1 claimable -> claim, a waiting story -> open it, else the list
-- overlay). Text: UIKit.StyleText dark mode (white -> cream, navy rim) so it reads over the world.
function L.BuildQuestLines(root)
	local block = UIKit.Create("TextButton", {
		Name = "QuestLines",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 60),
		Active = IS_TOUCH, -- PC: the lines are the buttons
		Visible = false,
		ZIndex = 3,
		Parent = root,
	})
	block.Activated:Connect(function()
		if IS_TOUCH then L.QuestBlockTap() end
	end)
	ui.questLines = block
	ui.qline = {}
	-- phones: the 12 px name-tag floor (the block is 150 px wide); PC: body text
	local style = IS_TOUCH and "NameTag" or "Body"
	for i = 1, 2 do
		-- one row = [icon][text][3/5 | 받기][▼ on line 1, PC]: a horizontal list; the text keeps its own width (shrinks and
		-- cuts with … only when the row is full), so the numbers / 받기 / ▼ sit right after it, never at the far edge
		-- (review 2026-10-06 devlog 15: '101/800' floated apart at the block's right end)
		local row = UIKit.Create(IS_TOUCH and "Frame" or "TextButton", {
			Name = "Line" .. i,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0.5, 0),
			Position = UDim2.fromScale(0, (i - 1) * 0.5),
			ZIndex = 3,
			Parent = block,
		}, {
			UIKit.Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
			}),
		})
		if not IS_TOUCH then
			row.Text = ""
			row.AutoButtonColor = false
			row.Activated:Connect(function() L.QuestLineTap(i) end)
		end
		local icon = UIKit.ArtImage("IconScroll", {
			Name = "Icon",
			LayoutOrder = 1,
			Size = UDim2.fromOffset(24, 24),
			ZIndex = 4,
			Parent = row,
		})
		local text = UIKit.StyledLabel({
			Name = "Text",
			LayoutOrder = 2,
			Size = UDim2.new(0, 0, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			ZIndex = 4,
			Parent = row,
		}, style)
		text.AutomaticSize = Enum.AutomaticSize.X
		UIKit.Create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Shrink, Parent = text })
		local nums = UIKit.StyledLabel({
			Name = "Nums",
			LayoutOrder = 3,
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 4,
			Parent = row,
		}, "Number")
		-- 받기: the green candy pill (same art as the list rows' 받기), text on it
		local claim = UIKit.ArtFrame("Pill", {
			Name = "Claim",
			LayoutOrder = 4,
			ImageColor3 = COL.HotTint,
			Visible = false,
			ZIndex = 4,
			Parent = row,
		}, { Color = Theme.Good, CornerRadius = UDim.new(0.5, 0) })
		local claimText = UIKit.StyledLabel({
			Name = "Text",
			Size = UDim2.fromScale(1, 1),
			Text = TXT.Claim,
			ZIndex = 5,
			Parent = claim,
		}, "Number")
		-- the soft band sits beside the row in the block (a band inside the row would be a list item), under its text
		local band = L.SoftBand(block, "Right")
		band.Name = "Band" .. i
		band.Size = UDim2.new(1, 64, 0.5, 2)
		band.Position = UDim2.new(0, -8, (i - 1) * 0.5, -1)
		band.Visible = false
		ui.qline[i] = { Row = row, Icon = icon, Text = text, Nums = nums, Claim = claim, ClaimText = claimText, Entry = nil,
			Band = band }
	end
	-- PC: a small ▼ / ▲ button right after line 1 folds the full list (the parchment rows) out under the lines
	if not IS_TOUCH then
		local fold = UIKit.Create("TextButton", {
			Name = "Fold",
			LayoutOrder = 5,
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = TXT.QuestOpenList,
			ZIndex = 5,
			Parent = ui.qline[1].Row,
		}, { UIKit.Create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }) })
		if type(UIKit.StyleText) == "function" then UIKit.StyleText(fold, "Number") end
		fold.Activated:Connect(function()
			if toggleQuests then toggleQuests() end
		end)
		ui.questFold = fold
	end
end

-- line metrics follow the rect (logical units): icon about the line height, text size from it (the style floors keep
-- it readable), the 받기 pill a little shorter than the line
function L.LayoutQuestLines(q)
	local block = ui.questLines
	if not block then return end
	block.Position = UDim2.fromOffset(q.X, q.Y)
	block.Size = UDim2.fromOffset(q.W, q.H)
	local lh = q.H / 2
	local iconS = math.floor(lh * 0.9)
	local textSize = math.max(12, math.floor(lh * 0.6))
	for _, l in ui.qline do
		if l.Icon then l.Icon.Size = UDim2.fromOffset(iconS, iconS) end
		l.Text.TextSize = textSize
		l.Nums.TextSize = textSize
		l.Claim.Size = UDim2.fromOffset(math.floor(lh * 2.3), math.floor(lh * 0.86))
		l.ClaimText.TextSize = math.max(12, math.floor(lh * 0.5))
	end
	if ui.questFold then ui.questFold.TextSize = math.max(12, math.floor(lh * 0.55)) end
end

-- one line: icon (monster head / row type), text, progress or 받기 (CR-M27 / CR-L31 numbers)
function L.SetQuestLine(l, e, label, nums)
	l.Entry = e
	l.Row.Visible = label ~= nil
	if l.Band then l.Band.Visible = label ~= nil end
	if not label then return end
	l.Text.Text = label
	local claimable = e ~= nil and e.Progress >= e.Target and e.CanClaim
		and (e.Pinned or e.Kind == "Daily" or e.Kind == "Sub") -- the list rows' 받기 rule (refreshQuests)
	l.Claim.Visible = claimable
	l.Nums.Visible = not claimable and nums ~= nil
	l.Nums.Text = nums or ""
	if l.Icon then
		local head = e and e.Unit and UIKit.ArtId("IconMon" .. e.Unit)
		local key = e and (QUEST_ICON[e.Id] or "IconScroll") or "IconStar"
		l.Icon.Image = head or UIKit.ArtId(key) or UIKit.ArtId("IconScroll") or l.Icon.Image
	end
end

-- PC line press: claim / pinned or story action / fold the list
function L.QuestLineTap(i)
	local l = ui.qline and ui.qline[i]
	local e = l and l.Entry
	if not e then
		toggleQuests()
		return
	end
	local row = nil
	for _, r in questRows do
		if r.Entry == e then row = r break end
	end
	if e.Progress >= e.Target and e.CanClaim and row and row.Claim.Visible then
		L.OnClaim(row) -- assigned with onClaim below
	elseif (e.Pinned or e.Story) and L.PinnedTap then
		L.PinnedTap(e, row)
	else
		toggleQuests()
	end
end

-- phone block press: line 1 claimable -> claim; a waiting story or the pinned row -> its action; else the list overlay
function L.QuestBlockTap()
	if questState.CallEntry and L.PinnedTap then
		L.PinnedTap(questState.CallEntry)
		return
	end
	local l = ui.qline and ui.qline[1]
	local e = l and l.Entry
	if e and e.Progress >= e.Target and e.CanClaim then
		for _, r in questRows do
			if r.Entry == e and r.Claim.Visible then
				L.OnClaim(r)
				return
			end
		end
	end
	toggleQuests()
end

-- header plate pieces follow its height (the disc is about as wide as the plate is tall)
function L.LayoutQuestHeader(w, h)
	ui.questHeader.Size = UDim2.fromOffset(w, h)
	local disc = math.min(h, 40)
	if ui.questHeaderIcon then
		ui.questHeaderIcon.Position = UDim2.new(0, disc * 0.5, 0.5, 0)
		ui.questHeaderIcon.Size = UDim2.fromOffset(disc * 0.62, disc * 0.62)
	end
	local tx = disc + 4
	if ui.questHeaderSub then
		ui.questHeaderText.Position = UDim2.fromOffset(tx, 3)
		ui.questHeaderText.Size = UDim2.new(1, -tx - 26, 0.5, -3)
		ui.questHeaderSub.Position = UDim2.new(0, tx, 0.5, 0)
		ui.questHeaderSub.Size = UDim2.new(1, -tx - 26, 0.5, -3)
	else
		ui.questHeaderText.Position = UDim2.fromOffset(tx, 4)
		ui.questHeaderText.Size = UDim2.new(1, -tx - 26, 1, -8)
	end
	ui.questChevron.Size = UDim2.fromOffset(16, math.max(12, h - 8))
end

----------------------------------------------------------------- building: travel bar
local function buildTravel(root)
	ui.travel = UIKit.ArtFrame("PanelParchment", {
		Name = "Travel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, IS_TOUCH and 0.42 or 0.6), -- U3: touch stays above the thumbstick zone
		Size = UDim2.fromOffset(340, 64),
		Visible = false,
		ZIndex = 3,
		Parent = root,
	})
	ui.travelLabel = artLabel(true, {
		Name = "Label",
		Position = UDim2.fromOffset(0, 9),
		Size = UDim2.new(1, 0, 0, 22),
		TextSize = 18,
		Title = true,
		Parent = ui.travel,
	})
	local _, setTravel = UIKit.ArtBar({
		Name = "Progress",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 35),
		Size = UDim2.fromOffset(300, 18),
		Color = ac("XPBlue", Theme.XP),
		Parent = ui.travel,
	})
	ui.setTravel = setTravel
end

----------------------------------------------------------------- building: buttons
-- round hit target (transparent TextButton + PressScale) holding the art disc "Art" (IMG-R4: code-drawn circle)
local function roundButton(name, size, part, fallbackColor)
	local btn = UIKit.Create("TextButton", {
		Name = name,
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = ui.buttons,
	}, { UIKit.Create("UIScale", { Name = "PressScale" }) })
	-- combat buttons: the shared feel, quick (<= 0.08 s, no spring that delays the next press)
	if type(UIKit.ButtonFeel) == "function" then UIKit.ButtonFeel(btn, { Fast = true }) end
	local art = UIKit.ArtFrame(part, {
		Name = "Art",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = btn,
	}, {
		Color = fallbackColor,
		BackgroundTransparency = 0.08,
		CornerRadius = UDim.new(0.5, 0),
		StrokeColor = COL.White,
		StrokeThickness = 4,
		StrokeTransparency = 0.35,
	})
	return btn, art
end

-- BB1: the action's current key label (Keybinds; "" before Keybinds exists)
function L.KeyText(action)
	local kb = C and C.Keybinds
	if type(kb) ~= "table" or type(kb.Label) ~= "function" then return "" end
	local ok, text = pcall(kb.Label, action)
	return ok and type(text) == "string" and text or ""
end

-- BB1: true when the action has a key right now (an unbound action shows no badge)
function L.KeyBound(action)
	local kb = C and C.Keybinds
	if type(kb) ~= "table" or type(kb.KeyName) ~= "function" then return false end
	local ok, key = pcall(kb.KeyName, action)
	return ok and type(key) == "string" and key ~= ""
end

-- BB1: badges follow Keybinds.Changed and Settings.KeyBadges (BB3 [기타] 키 표시)
function L.RefreshKeys()
	local st = C and C.Settings
	local badges = true
	if type(st) == "table" and type(st.Get) == "function" then
		local ok, v = pcall(st.Get, "KeyBadges")
		badges = not ok or v ~= false
	end
	L.ShowKeys = L.KeyDevice and badges
	for _, h in ui.keyHints or {} do
		if h.Label.Parent then
			h.Label.Text = L.KeyText(h.Action)
			h.Label.Visible = L.ShowKeys and L.KeyBound(h.Action)
		end
	end
end

-- small key badge (U1: keyboards only, never on touch). BB1: `action` = Config.Keybinds action id; the badge shows its
-- current key (it widens for "Ctrl" / "Num1") and L.RefreshKeys redraws it.
local function keyHint(parent, action, position, anchor)
	if not L.KeyDevice then return end
	local label = L.FitText(UIKit.Create("TextLabel", {
		Name = "KeyHint",
		AnchorPoint = anchor,
		Position = position,
		Size = UDim2.fromOffset(18, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = ac("KeyHintBg", COL.Black),
		TextColor3 = ac("KeyHintText", COL.White),
		Font = af("Number", Theme.Font),
		TextSize = 13,
		Text = L.KeyText(action),
		ZIndex = 8,
		Parent = parent,
	}, {
		corner(UDim.new(0, 5)),
		UIKit.Create("UIStroke", {
			Color = COL.White,
			Thickness = 1.5,
			Transparency = 0.15,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		UIKit.Create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3) }),
	}), 11)
	if not label then return end
	ui.keyHints = ui.keyHints or {}
	table.insert(ui.keyHints, { Label = label, Action = action })
	label.Visible = L.ShowKeys and L.KeyBound(action)
end

local doUpgrade, openMenu, openMap, inputAllowed -- forward (defined with the input code)

-- A23-38 / A23-40 icon tile (MenuTile = Firefly 471686b: navy tile, thin gold trim, a little see-through over the world):
-- the icon on top, its short name under it inside the tile, the key badge in the top-right corner (keyboards only).
-- applyLayout sizes it (square, Rects.tiles.Size).
local function tileButton(def, onClick)
	local btn = UIKit.ArtButton("MenuTile", {
		Name = "Tile" .. def.Id,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(64, 64),
		ImageTransparency = L.TileTint,
		Visible = false,
		Parent = ui.buttons,
	}, onClick, { CornerRadius = UDim.new(0, 10), BackgroundTransparency = 0.25 })
	local iconProps = {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.07),
		Size = UDim2.fromScale(L.TileIcon, L.TileIcon),
		ZIndex = 3,
		Parent = btn,
	}
	-- 내 캐릭터 follows CharacterGender (IconCharacterF) through UIKit.CharacterIcon
	local img = (def.Id == "Character" and type(UIKit.CharacterIcon) == "function") and UIKit.CharacterIcon(iconProps)
		or UIKit.ArtImage(def.Icon, iconProps)
	-- A23-48: English names ('Settings', 'Ranking') may reach a little past the tile's rim and shrink to 10 px (검수)
	local label = artLabel(false, {
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -2),
		Size = UDim2.new(1.16, 0, 0.3, 0),
		TextScaled = true,
		MaxTextSize = 14,
		Title = true,
		Text = def.Text or "",
		ZIndex = 4,
		Parent = btn,
	})
	label:SetAttribute("StyleMinPx", 10)
	L.FitText(label, 12, true, 10)
	if type(UIKit.StyleText) == "function" then UIKit.StyleText(label, "NameTag") end -- A23-38: white name, navy rim
	if def.Key then keyHint(btn, def.Key, UDim2.new(1, -2, 0, 2), Vector2.new(1, 0)) end
	return btn, label, img
end

-- A23-40 정정 + 보강: [메뉴] (its own square in the Roblox top bar's right end, HudLayout TB) and its fold-out: a clipping
-- frame left of [메뉴] with one square per fold entry (the L.Fold squares + a copy of every row tile for the phone row's
-- overflow). L.LayoutMenu places them from Rects.menu / Rects.fold, L.SetFold slides them out / back in
function L.BuildMenu(names)
	local btn, label = tileButton({ Id = "Menu", Icon = "GlyphMenu", Key = "Menu", Text = names.Menu }, function()
		L.WindowKey("Menu")
	end)
	btn.Visible = true
	btn.ZIndex = 3
	ui.menu, ui.menuLabel = btn, label
	ui.menuGlow = makeGlow(btn, UDim.new(0, 10))
	ui.fold = UIKit.Create("Frame", {
		Name = "MenuFold",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 2,
		Parent = ui.buttons,
	})
	ui.foldTiles = {}
	local function add(def, row)
		local copy = table.clone(def)
		copy.Text = names[def.Id]
		local b = tileButton(copy, function()
			L.FoldTap(copy)
		end)
		b.Name = "Fold" .. def.Id
		b.Parent = ui.fold
		local entry = { Def = copy, Button = b, Row = row }
		if def.Id == "Settings" then ui.settingsGlow = makeGlow(b, UDim.new(0, 10)) end
		table.insert(ui.foldTiles, entry)
	end
	for _, def in L.Tiles do add(def, true) end
	for _, def in L.Fold do add(def, false) end
	-- the squares' art loads now, so the first fold-out slides in with its icons (not blank squares)
	task.spawn(function()
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync({ ui.fold, btn })
		end)
	end)
end

-- the fold squares to show, nearest [메뉴] first: 설정, 도움말, 이동, 새 소식 (the registered ones), then on phones the
-- row tiles that did not fit the row, so the fold reads 캐릭터 … 펫 새 소식 이동 도움말 설정 [메뉴] from the left
function L.FoldEntries()
	local inRow = {}
	for _, t in ui.shownTiles or {} do inRow[t.Def.Id] = true end
	local list = {}
	for i = #(ui.foldTiles or {}), 1, -1 do
		local f = ui.foldTiles[i]
		local def = f.Def
		if (def.Map or L.TileWindow(def) ~= nil) and not (f.Row and inRow[def.Id]) then table.insert(list, f) end
	end
	return list
end

-- [메뉴] on its rect; the fold frame spans every fold line (left of [메뉴], FoldPad above and below)
function L.LayoutMenu(R)
	local m, f = R.menu, R.fold
	if not ui.menu or not m or not f or type(f.Lines) ~= "table" then return end
	L.Place(ui.menu, m)
	local pad = L.FoldPad
	local g = { X = f.X, Y = f.Y - pad, W = m.X - f.X, H = f.H + pad * 2, Size = f.Size, Gap = f.Gap, Lines = f.Lines,
		Right = m.X - f.Gap }
	ui.foldGeom = g
	ui.fold.Position = UDim2.fromOffset(g.X, g.Y)
	ui.fold.Size = UDim2.fromOffset(g.W, g.H)
	if ui.foldOpen then L.PlaceFold(false) end
end

-- slot i of the shown squares (1 = next to [메뉴]; line by line, Rects.fold.Lines): its frame-relative centre and the
-- start of its slide (just right of the frame = under [메뉴]'s left edge), or nil when the fold has no room for it
function L.FoldSlot(i)
	local g = ui.foldGeom
	if not g then return nil end
	local n = i
	for _, ln in g.Lines do
		if n <= ln.Cols then
			local cy = ln.Y + g.Size / 2 - g.Y
			return UDim2.fromOffset(g.Right - (n - 1) * (g.Size + g.Gap) - g.Size / 2 - g.X, cy),
				UDim2.fromOffset(g.W + g.Size / 2, cy)
		end
		n -= ln.Cols
	end
	return nil
end

-- the shown squares on their slots: animate = slide out of [메뉴] one after another (A23-38 좌르륵), else jump there
-- (a re-layout while open)
function L.PlaceFold(animate)
	local list = L.FoldEntries()
	local shown = {}
	for i, f in list do
		local target, start = L.FoldSlot(i)
		local b = f.Button
		if f.Tween then
			f.Tween:Cancel()
			f.Tween = nil
		end
		if target then
			shown[f] = true
			b.Size = UDim2.fromOffset(ui.foldGeom.Size, ui.foldGeom.Size)
			if animate then
				b.Position = start
				f.Tween = TweenService:Create(b, TweenInfo.new(L.FoldTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out,
					0, false, (i - 1) * L.FoldStep), { Position = target })
				f.Tween:Play()
			else
				b.Position = target
			end
		end
		b.Visible = target ~= nil
	end
	for _, f in ui.foldTiles do
		if not shown[f] then f.Button.Visible = false end
	end
	ui.foldShown = list
end

-- opens / folds back the [메뉴] squares. Phones: the fold lies on the tile row, which hides while it is open
function L.SetFold(open)
	open = open == true and ui.fold ~= nil and ui.foldGeom ~= nil
	if open == (ui.foldOpen == true) then return end
	ui.foldOpen = open
	ui.foldToken = (ui.foldToken or 0) + 1
	local token = ui.foldToken
	-- 'Screen shake' off / Roblox reduced motion: the squares appear and go at once (no slide)
	local reduced = type(UIKit.ReducedMotion) == "function" and UIKit.ReducedMotion()
	if open then
		ui.fold.Visible = true
		L.PlaceFold(not reduced)
	elseif reduced then
		ui.fold.Visible = false
		for _, f in ui.foldTiles do
			if f.Tween then f.Tween:Cancel() end
			f.Button.Visible = false
		end
	else
		for i, f in ui.foldShown or {} do
			if f.Tween then f.Tween:Cancel() end
			local _, start = L.FoldSlot(i)
			if start and f.Button.Visible then
				f.Tween = TweenService:Create(f.Button, TweenInfo.new(L.FoldBack, Enum.EasingStyle.Quad,
					Enum.EasingDirection.In), { Position = start })
				f.Tween:Play()
			end
		end
		task.delay(L.FoldBack + 0.02, function()
			if ui.foldToken ~= token then return end
			ui.fold.Visible = false
			for _, f in ui.foldTiles do f.Button.Visible = false end
		end)
	end
	if IS_TOUCH then
		ui.tileKey = nil -- L.PickTiles re-applies the row's visibility (hidden under an open fold)
		L.PickTiles()
	end
end

-- a fold square: fold back, then open its window like a row tile
function L.FoldTap(def)
	L.SetFold(false)
	L.TileTap(def)
end

-- A23-38: a press outside [메뉴] and its squares folds them back (the press still does its own thing); Esc opens
-- Roblox's menu (GuiService.MenuOpened, HUD.Start). The pad's B joins with the pad wiring (BB21: every key goes through
-- Keybinds). InputObject.Position and AbsolutePosition share the gui-inset-relative screen space
function L.FoldInput(input)
	if not ui.foldOpen then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	local px, py = input.Position.X, input.Position.Y
	local function inside(gui)
		local a, z = gui.AbsolutePosition, gui.AbsoluteSize
		return gui.Visible and px >= a.X and px <= a.X + z.X and py >= a.Y and py <= a.Y + z.Y
	end
	if inside(ui.menu) then return end
	for _, f in ui.foldShown or {} do
		if inside(f.Button) then return end
	end
	L.SetFold(false)
end

-- the fold folds back when a window opens (any way) or the HUD hides (a picker, the loading screen)
function L.FoldWatch()
	local panels = C and C.Panels
	local open = type(panels) == "table" and type(panels.IsOpen) == "function" and panels.IsOpen()
	if open or not (ui.root and ui.root.Visible) then L.SetFold(false) end
end

local function buildButtons(root)
	ui.buttons = UIKit.Create("Frame", {
		Name = "Buttons",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = root,
	})

	-- 공격 (one press = one swing): Firefly orange disc + my class glyph (L.RefreshAttackGlyph) + "공격"
	ui.attack = roundButton("Attack", L.Attack, "BtnAttack", COL.AttackFill)
	L.RefreshAttackGlyph()
	artLabel(false, {
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.76),
		Size = UDim2.fromScale(0.62, 0.2),
		TextScaled = true,
		MaxTextSize = math.floor(L.Attack * 0.2),
		Title = true,
		Text = TXT.Attack,
		ZIndex = 4,
		Parent = ui.attack,
	})
	L.FitText(ui.attack:FindFirstChild("Label"), 16, true)
	keyHint(ui.attack, "Attack", UDim2.fromScale(0.86, 0.86), Vector2.new(0.5, 0.5))

	-- 스킬 Q: Firefly blue disc (BtnSpecial); only MP and cooldown decide readiness
	local rel, relArt = roundButton("Release", L.Release, "BtnSpecial", COL.ReleaseFill)
	ui.release, ui.releaseArt = rel, relArt
	L.RefreshSkillIcon() -- my class's Q skill icon (bundle 14), IconSpecial until a class is chosen
	ui.skillLabel = artLabel(false, {
		Name = "Sub",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromScale(0.76, 0.22),
		TextScaled = true,
		MaxTextSize = math.max(14, math.floor(L.Release * 0.18)),
		Title = true,
		Text = TXT.Release,
		ZIndex = 4,
		Parent = rel,
	})
	L.FitText(ui.skillLabel, 14, true)
	ui.skillTimer = artLabel(false, {
		Name = "Timer",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.6, 0.3),
		TextScaled = true,
		MaxTextSize = 26,
		Number = true,
		Color = Theme.Gold,
		Visible = false,
		ZIndex = 4,
		Parent = rel,
	})
	L.FitText(ui.skillTimer, 16)
	keyHint(rel, "SkillQ", UDim2.fromScale(0.86, 0.86), Vector2.new(0.5, 0.5))

	-- A23-40 icon tile row (U1: the menu key is B by default; Esc belongs to Roblox and M opens the map). A window tile
	-- shows once Panels has its window (no silent no-op: L.RefreshWindows); the pet tile waits for the pet window
	local names = { Character = TXT.TileCharacter, Bag = TXT.Bag, Skills = TXT.TileSkills, Map = TXT.Map,
		Ranking = TXT.TileRanking, Pet = TXT.Pet, Settings = TXT.TileSettings, Menu = TXT.Menu, News = TXT.TileNews,
		Travel = TXT.TileTravel, Help = TXT.TileHelp }
	ui.tiles = {}
	for i, def in L.Tiles do
		def.Text = names[def.Id]
		local btn, label = tileButton(def, function()
			L.TileTap(def)
		end)
		ui.tiles[i] = { Def = def, Button = btn, Label = label }
		if def.Id == "Bag" then ui.bagGlow = makeGlow(btn, UDim.new(0, 10)) end -- B14 scroll hint
	end
	L.BuildMenu(names)
	-- A23-1 auto combat ON/OFF (round, Firefly BtnRound): hidden until the crown-shard quest unlocks it (no "unlocks at
	-- ..." teaser); ON = gold ring, OFF = dimmed disc
	ui.auto, ui.autoArt = roundButton("Auto", L.Square, "BtnRound", COL.ReleaseFill)
	UIKit.ArtImage("Crown", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromScale(0.5, 0.34),
		ZIndex = 3,
		Parent = ui.auto,
	})
	ui.autoLabel = L.FitText(artLabel(false, {
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.74),
		Size = UDim2.fromScale(0.8, 0.26),
		TextScaled = true,
		MaxTextSize = 14,
		Title = true,
		Text = TXT.Auto,
		ZIndex = 4,
		Parent = ui.auto,
	}), 12, true)
	ui.autoGlow = makeGlow(ui.auto, UDim.new(0.5, 0))
	keyHint(ui.auto, "Auto", UDim2.fromScale(0.85, 0.85), Vector2.new(0.5, 0.5))
	ui.auto.Activated:Connect(function()
		if inputAllowed() then L.ToggleAuto() end
	end)
	ui.auto.Visible = false
end

-- the attack button's glyph follows my class (bundle 6: sword / staff; bow arrives with bundle 7, IconAttack until then)
function L.RefreshAttackGlyph()
	if not ui.attack then return end
	local key = L.Glyph[getClass()]
	if not (key and UIKit.ArtId(key)) then key = "IconAttack" end
	if ui.attackGlyphKey == key then return end
	ui.attackGlyphKey = key
	local old = ui.attack:FindFirstChild("Icon")
	if old then old:Destroy() end
	UIKit.ArtImage(key, {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.5, 0.5),
		ZIndex = 3,
		Parent = ui.attack,
	})
end

-- the Q button's icon: my class's skill art (bundle 14 Skill_<Class>_Q, a square icon) or the winged IconSpecial before a
-- class is chosen / for a class without its own art (the Artisan pet tamer's 펫 돌진 waits for its icon, A23-39)
function L.RefreshSkillIcon()
	local rel = ui.release
	if not rel then return end
	local class = attr("ClassChosen", false) == true and getClass() or nil
	local key = (class and not (class == "Archer" and getFaction() == "Neutral")) and ("Skill_" .. class .. "_Q") or nil
	if not (key and UIKit.ArtId(key)) then key = "IconSpecial" end
	if ui.releaseIconKey == key and ui.releaseIcon and ui.releaseIcon.Parent then return end
	ui.releaseIconKey = key
	local visible = not ui.releaseIcon or ui.releaseIcon.Visible
	if ui.releaseIcon then ui.releaseIcon:Destroy() end
	local square = key ~= "IconSpecial"
	ui.releaseIcon = UIKit.ArtImage(key, {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, square and 0.4 or 0.42),
		Size = square and UDim2.fromScale(0.5, 0.5) or UDim2.fromScale(0.56, 0.34),
		Visible = visible,
		ZIndex = 3,
		Parent = rel,
	})
end

----------------------------------------------------------------- refresh: stats
function L.PortraitDisconnect(connections)
	for _, connection in connections do connection:Disconnect() end
	table.clear(connections)
end

function L.PortraitClear()
	local state = ui.portrait
	if not state then return end
	L.PortraitDisconnect(state.AppearanceConnections)
	if state.Clone then state.Clone:Destroy(); state.Clone = nil end
	state.View.ImageTransparency = 1
	state.View.BackgroundTransparency = 1
	ui.portraitHeadshot.Visible = true
end

-- Match duplicate-named children by class/name/occurrence without changing the source character.
function L.PortraitPairs(source, copy, pairs)
	pairs[source] = copy
	local children, used = {}, {}
	for _, child in copy:GetChildren() do
		local key = child.ClassName .. "/" .. child.Name
		children[key] = children[key] or {}
		table.insert(children[key], child)
	end
	for _, child in source:GetChildren() do
		local key = child.ClassName .. "/" .. child.Name
		used[key] = (used[key] or 0) + 1
		local target = children[key] and children[key][used[key]]
		if target then L.PortraitPairs(child, target, pairs) end
	end
end

function L.PortraitAppearance(object)
	return object:IsA("BasePart") or object:IsA("DataModelMesh") or object:IsA("Decal")
		or object:IsA("SurfaceAppearance") or object:IsA("BodyColors") or object:IsA("Clothing")
		or object:IsA("ShirtGraphic") or object:IsA("Accessory") or object:IsA("CharacterMesh")
		or object:IsA("Bone") or object:IsA("JointInstance") or object:IsA("WeldConstraint")
end

function L.PortraitLoad(state, copy, revision)
	state.LoadRevision = (state.LoadRevision or 0) + 1
	local loadRevision = state.LoadRevision
	state.View.ImageTransparency = 1
	state.View.BackgroundTransparency = 1
	ui.portraitHeadshot.Visible = true
	local head = copy:FindFirstChild("Head")
	local required, seen = {}, {}
	local function include(object)
		if object and object:IsDescendantOf(copy) and not seen[object] then
			seen[object] = true
			table.insert(required, object)
		end
	end
	include(head)
	for _, object in copy:GetDescendants() do
		if object:IsA("BasePart") and (object.Name == "HeadBase" or object.Name == "FaceExpression") then
			include(object)
		elseif object:IsA("Weld") or object:IsA("WeldConstraint") then
			-- Hair, hats and face accessories can be separate parts welded to the real head.
			if object.Part0 == head then include(object.Part1)
			elseif object.Part1 == head then include(object.Part0) end
		end
	end
	local hasAsset = false
	for _, object in required do
		local objects = object:GetDescendants()
		table.insert(objects, object)
		for _, child in objects do
			if child:IsA("MeshPart") and (child.MeshId ~= "" or child.TextureID ~= "")
				or child:IsA("SpecialMesh") and (child.MeshId ~= "" or child.TextureId ~= "")
				or child:IsA("Decal") and child.Texture ~= ""
				or child:IsA("SurfaceAppearance") and (child.ColorMap ~= "" or child.MetalnessMap ~= ""
					or child.NormalMap ~= "" or child.RoughnessMap ~= "") then hasAsset = true end
		end
	end
	state.View:SetAttribute("PreloadComplete", false)
	state.View:SetAttribute("PreloadRequiredObjects", #required)
	task.spawn(function()
		local successes, failures = 0, 0
		local ok = pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(required, function(_, status)
				if status == Enum.AssetFetchStatus.Success then successes += 1 else failures += 1 end
			end)
		end)
		if state.Clone ~= copy or state.Revision ~= revision or state.LoadRevision ~= loadRevision
			or state.Character ~= LocalPlayer.Character then return end
		local loaded = ok and failures == 0 and (not hasAsset or successes > 0)
		state.View:SetAttribute("PreloadSuccess", successes)
		state.View:SetAttribute("PreloadFailures", failures)
		state.View:SetAttribute("PreloadComplete", loaded)
		if loaded then
			state.View.ImageTransparency = 0
			state.View.BackgroundTransparency = 0
			ui.portraitHeadshot.Visible = false
		end
	end)
end

function L.PortraitRebuild(state, revision)
	if ui.portrait ~= state or state.Revision ~= revision then return end
	L.PortraitClear()
	local character = state.Character
	local head = character and character:FindFirstChild("Head")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if character ~= LocalPlayer.Character or not character or not character.Parent
		or not head or not head:IsA("BasePart") or not root or not root:IsA("BasePart") then return end
	local archivable = character.Archivable
	character.Archivable = true
	local ok, copy = pcall(function() return character:Clone() end)
	character.Archivable = archivable
	if not ok or not copy then return end
	copy.Name = "PortraitCharacter"
	local pairs = {}
	L.PortraitPairs(character, copy, pairs)
	if not pairs[head] or not pairs[root] then copy:Destroy(); return end
	-- The clone remains unparented until all executable/UI/physics effects have been removed.
	for source, target in pairs do
		if target:IsA("LuaSourceContainer") or target:IsA("LayerCollector") or target:IsA("GuiObject")
			or target:IsA("Tool") or (target:IsA("Model") and target.Name == "WeaponModel")
			or target:IsA("ParticleEmitter") or target:IsA("Trail") or target:IsA("Beam")
			or target:IsA("Fire") or target:IsA("Smoke") or target:IsA("Sparkles")
			or target:IsA("Sound") or target:IsA("Light") or target:IsA("Highlight")
			or target:IsA("BodyMover") or target:IsA("Animator") or target:IsA("AnimationController")
			or (target:IsA("Constraint") and not target:IsA("WeldConstraint")) then
			target:Destroy()
		elseif target:IsA("BasePart") then
			target.Anchored = true
			target.CanCollide = false
			target.CanTouch = false
			target.CanQuery = false
			target.AssemblyLinearVelocity = Vector3.zero
			target.AssemblyAngularVelocity = Vector3.zero
			target.LocalTransparencyModifier = 0
			target.CFrame = source.CFrame
		elseif target:IsA("Bone") or target:IsA("Motor6D") then
			target.Transform = source.Transform -- snapshot the real skin pose; keep its internal bone/weld graph
		elseif target:IsA("Humanoid") then
			target.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			target.AutoRotate = false
		end
	end
	-- Only external references are cleared; shared-bone ObjectValues and internal welds must survive.
	for _, object in copy:GetDescendants() do
		if object:IsA("ObjectValue") and object.Value and not object.Value:IsDescendantOf(copy) then object.Value = nil end
	end
	state.Clone = copy
	copy.Parent = state.World
	state.View:SetAttribute("CharacterName", character.Name)
	local up = root.CFrame.UpVector
	local focus = head.Position - up * head.Size.Y * 0.04
	local span = math.max(head.Size.X, head.Size.Y) * 0.85
	local distance = span / (2 * math.tan(math.rad(state.Camera.FieldOfView / 2))) + head.Size.Z * 0.5
	state.Camera.CFrame = CFrame.lookAt(focus + root.CFrame.LookVector * distance, focus, up)
	state.Camera.Focus = CFrame.new(focus)
	state.View:SetAttribute("CameraSpan", span)
	for source, target in pairs do
		if target:IsDescendantOf(copy) then
			local properties = nil
			if source:IsA("MeshPart") then properties = { "TextureID" }
			elseif source:IsA("Decal") then properties = { "Texture" }
			elseif source:IsA("SurfaceAppearance") then properties = { "ColorMap", "MetalnessMap", "NormalMap", "RoughnessMap" }
			end
			if properties then
				for _, property in properties do
					table.insert(state.AppearanceConnections, source:GetPropertyChangedSignal(property):Connect(function()
						if state.Clone ~= copy or not target.Parent then return end
						pcall(function() target[property] = source[property] end)
						L.PortraitLoad(state, copy, revision)
					end))
				end
			end
			if source:IsA("BasePart") then
				for _, property in { "Size", "Color", "Transparency" } do
					table.insert(state.AppearanceConnections, source:GetPropertyChangedSignal(property):Connect(L.RefreshPortrait))
				end
			elseif source:IsA("BodyColors") or source:IsA("Clothing") or source:IsA("ShirtGraphic")
				or source:IsA("CharacterMesh") or source:IsA("DataModelMesh") then
				table.insert(state.AppearanceConnections, source.Changed:Connect(L.RefreshPortrait))
			end
		end
	end
	L.PortraitLoad(state, copy, revision)
end

function L.RefreshPortrait()
	local headshot = ui.portraitHeadshot
	if not headshot then return end -- the compact touch layout has no portrait
	if not ui.portrait then
		local view = UIKit.Create("ViewportFrame", {
			Name = "AvatarPortrait3D", Position = headshot.Position, Size = headshot.Size,
			BackgroundColor3 = headshot.BackgroundColor3, BackgroundTransparency = 1,
			ImageTransparency = 1, ZIndex = headshot.ZIndex, Parent = ui.portraitHolder,
		})
		corner(UDim.new(0.5, 0)).Parent = view
		local stroke = headshot:FindFirstChildOfClass("UIStroke")
		if stroke then stroke:Clone().Parent = view end
		local camera = UIKit.Create("Camera", { Name = "PortraitCamera", FieldOfView = 32, Parent = view })
		view.CurrentCamera = camera
		ui.portrait = { View = view, Camera = camera, World = UIKit.Create("WorldModel", { Parent = view }),
			CharacterConnections = {}, AppearanceConnections = {}, Revision = 0 }
	end
	local state = ui.portrait
	local character = LocalPlayer.Character
	if state.Character ~= character then
		L.PortraitDisconnect(state.CharacterConnections)
		L.PortraitClear()
		state.Character = character
		if character then
			for _, signal in { character.DescendantAdded, character.DescendantRemoving } do
				table.insert(state.CharacterConnections, signal:Connect(function(object)
					if L.PortraitAppearance(object) then L.RefreshPortrait() end
				end))
			end
		end
	end
	state.Revision += 1
	local revision = state.Revision
	task.delay(0.2, function()
		if state.Revision ~= revision then return end
		local ok, err = pcall(L.PortraitRebuild, state, revision)
		if not ok then L.PortraitClear(); warnThrottled("portrait error: " .. tostring(err)) end
	end)
end

function L.PortraitRemoving(character)
	local state = ui.portrait
	if not state or state.Character ~= character then return end
	state.Revision += 1
	L.PortraitDisconnect(state.CharacterConnections)
	L.PortraitClear()
	state.Character = nil
end

local function refreshStats()
	local level = math.floor(num("Level", 1))
	L.RefreshBadge()
	if ui.level then ui.level.Text = tostring(level) end

	local xp = math.max(0, num("XP", 0))
	if level >= Config.Levels.MaxLevel then
		ui.setXP(1)
		ui.xpText.Text = "MAX"
	else
		local need = math.max(1, Config.XPToNext(level))
		ui.setXP(xp / need)
		ui.xpText.Text = fmtNum(xp) .. " / " .. fmtNum(need)
	end

	-- the power line carries the level; the pouch (carried gold, it can be stolen) turns sack-orange while > 0
	L.PowerSet(L.Pow.Shown or L.PowerValue())
	local carried = math.max(0, num("CarriedGold", 0))
	ui.pouch.Text = string.format(TXT.Pouch, TXT.CarriedTag, fmtNum(carried))
	ui.pouch.TextColor3 = carried > 0 and (Theme.Sack or ac("GoldText", Theme.Gold)) or ac("LightSub", Theme.SubText)
	L.CheckPouch()
	if ui.chip then refreshChips() end -- the wanted chip follows stars / bounty
end

----------------------------------------------------------------- refresh: status chips
-- EventHUD's luck line (A23-26 luck chip); phones get the short one ('희귀 10.75%')
function L.LuckText()
	local ev = C and C.EventHUD
	if type(ev) ~= "table" then return nil end
	local fn = ev.LuckShort -- A23-40: the short form everywhere ('희귀 10.75%' next to the clover)
	if type(fn) ~= "function" then fn = ev.LuckSummary end
	if type(fn) ~= "function" then return nil end
	local ok, line = pcall(fn)
	if not ok or type(line) ~= "string" or line == "" then return nil end
	if IS_TOUCH and fn == ev.LuckSummary then line = string.gsub(line, "^.-·%s*", "") end
	return line
end

refreshChips = function()
	local f = getFaction()
	local now = Util.Now()
	local pal = ui.chipPal

	local luck = L.LuckText()
	setChip(ui.chip.Luck, luck ~= nil, luck, Theme.Good, false, nil, true)
	-- Horns wanted stars + bounty: a danger chip (the old card row)
	local stars = f == "Horns" and math.floor(num("WantedStars", 0)) or 0
	local bounty = f == "Horns" and math.max(0, num("Bounty", 0)) or 0
	local wanted = string.format(TXT.Wanted, string.rep("★", math.clamp(stars, 0, 5)))
	if bounty > 0 then wanted ..= string.format(TXT.WantedBounty, fmtNum(bounty)) end
	setChip(ui.chip.Wanted, stars > 0 or bounty > 0, wanted, Theme.Bad, false, nil, stars > 0)

	local blessing = UIKit.GameAttr("WarBlessing", "None")
	local bdef = (blessing == "Halo" or blessing == "Horns") and Config.Factions[blessing] or nil
	if bdef then
		local pct = math.floor((Config.War.BlessingGold or 0.25) * 100 + 0.5)
		setChip(ui.chip.Blessing, true, string.format(TXT.Blessing, bdef.Name, pct), factionColor(blessing),
			blessing == f, nil, true)
	else
		setChip(ui.chip.Blessing, false)
	end

	if attr("ZoneTown", false) == true then
		setChip(ui.chip.Zone, true, TXT.Safe, Theme.Good, false, pal.Safe, true)
	elseif attr("ZonePvP", false) == true then
		if f == "Neutral" then
			setChip(ui.chip.Zone, true, TXT.PvPNeutral, factionColor("Neutral")) -- A6: Neutral is PvP-immune (A9-1 teal)
		else
			setChip(ui.chip.Zone, true, TXT.PvP, Theme.Bad)
		end
	else
		setChip(ui.chip.Zone, false)
	end

	local graceLeft = math.ceil(num("GraduateGraceUntil", 0) - now) -- A23-18: the shield's 60 s afterglow
	local rookieOn = attr("Rookie", false) == true and f ~= "Neutral"
	if f == "Neutral" then graceLeft = 0 end -- Neutral never fights players (A6): no grace chip either
	setChip(ui.chip.Rookie, rookieOn or graceLeft > 0, (not rookieOn and graceLeft > 0)
		and string.format(TXT.RookieGrace, graceLeft) or TXT.Rookie, Theme.XP, false, pal.Rookie, true)
	setChip(ui.chip.Protected, attr("Protected", false) == true, TXT.Protected, Theme.XP)
	setChip(ui.chip.Combat, num("InCombatUntil", 0) > now, TXT.InCombat, Theme.Revenge)
	local size = num("SizeMult", 1)
	setChip(ui.chip.Size, size > 1.001, string.format(TXT.Size, size), Theme.Gold)
	local bully = math.floor(num("BullyStacks", 0))
	local bullyLeft = math.max(1, math.ceil((num("BullyEndsAt", 0) - now) / 60)) -- A23-22 penalty minutes
	setChip(ui.chip.Bully, bully > 0, string.format(TXT.BullyPenalty, bullyLeft), Theme.Bad)
	setChip(ui.chip.Kaiju, attr("KaijuState", "None") == "Queued", TXT.KaijuQueued, Theme.Bad)

	-- A23-40: at most L.MaxChips chips in their order (fewer when they do not fit the row, L.CheckChipFit); the rest fold
	-- into one '+N' chip (no stacked rows)
	local wantKey = ""
	for _, key in L.ChipOrder do
		local chip = ui.chip[key]
		if chip and chip.Frame.Visible then wantKey ..= key .. "," end
	end
	if wantKey ~= L.ChipWantKey then
		L.ChipWantKey = wantKey
		L.ChipFit = L.MaxChips
	end
	local shownChips, folded = 0, 0
	for _, key in L.ChipOrder do
		local chip = ui.chip[key]
		if chip and chip.Frame.Visible then
			shownChips += 1
			if shownChips > L.ChipFit then
				chip.Frame.Visible = false
				folded += 1
			end
		end
	end
	setChip(ui.chipMore, folded > 0, string.format(TXT.MoreChips, folded), Theme.SubText)
end

----------------------------------------------------------------- refresh: war meter
local function fmtScore(v)
	if v >= 1000 then return fmtNum(v) end
	return string.format("%g", math.floor(v * 10 + 0.5) / 10)
end

L.WarParts = { Time = "", Clock = "", Siege = nil, Points = nil }
local function refreshWarTime()
	local endsAt = tonumber(UIKit.GameAttr("WarRoundEndsAt", 0)) or 0
	local clock = endsAt <= 0 and "-:--" or Util.FormatTime(endsAt - Util.Now())
	L.WarParts.Clock = clock
	L.WarParts.Time = string.format(TXT.WarTime, clock)
	L.WarLine(L.WarParts)
end

local function refreshWar()
	local h = math.max(0, tonumber(UIKit.GameAttr("WarHaloScore", 0)) or 0)
	local r = math.max(0, tonumber(UIKit.GameAttr("WarHornsScore", 0)) or 0)
	local frac = (h + r > 0) and (h / (h + r)) or 0.5
	ui.haloFill.Size = UDim2.fromScale(frac, 1)
	ui.hornsFill.Size = UDim2.fromScale(1 - frac, 1)
	ui.haloFill.Visible = frac > 0.001
	ui.hornsFill.Visible = frac < 0.999
	ui.warDivider.Position = UDim2.fromScale(frac, 0.5)
	if ui.warCrown then ui.warCrown.Position = UDim2.fromScale(frac, 0.5) end
	ui.haloNum.Text = string.format(TXT.WarHalo, fmtScore(h))
	ui.hornsNum.Text = string.format(TXT.WarHorns, fmtScore(r))

	local mode = UIKit.GameAttr("WarMode", "Idle")
	L.WarParts.Siege = mode == "Siege" and string.format(TXT.Siege, Config.War.SiegeTarget or 150) or nil

	local f = getFaction()
	local fighting = f == "Halo" or f == "Horns" -- A6: Neutral / None earn no war points
	L.WarParts.Points = fighting and string.format(TXT.MyWar, fmtNum(num("WarPoints", 0))) or nil
	refreshWarTime()
	refreshChips()
end

----------------------------------------------------------------- refresh: MP skill
local function refreshSkill()
	local remaining = math.max(0, num("SkillReadyAt", 0) - Util.Now())
	local ready = remaining <= 0 and num("Mana", 0) >= Config.BasicSkill.ManaCost
	-- A23-60 (user 2026-10-06): no MP number on the button (the skill description says it); the button only dims
	ui.skillLabel.Text = TXT.Release
	ui.skillTimer.Visible = remaining > 0
	ui.skillTimer.Text = string.format("%.1f", remaining)
	if ui.releaseIcon then ui.releaseIcon.Visible = remaining <= 0 end
	if isImage(ui.releaseArt) then
		ui.releaseArt.ImageColor3 = ready and COL.White or COL.DimTint
	elseif ui.releaseArt then
		ui.releaseArt.BackgroundTransparency = ready and 0.05 or 0.35
	end
end

-- B14: Panels.ItemsHint = I hold a scroll and have not opened 메뉴 → 아이템 this session
function L.ItemsHint()
	local panels = C and C.Panels
	if type(panels) ~= "table" or type(panels.ItemsHint) ~= "function" then return false end
	local ok, hint = pcall(panels.ItemsHint)
	return ok and hint == true
end

-- a pulsing gold rim (makeGlow stroke) on / off; key = which one (L.Glows keeps its state and tween)
L.Glows = {}
function L.SetGlow(key, stroke, on)
	local g = L.Glows[key]
	if not g then
		g = {}
		L.Glows[key] = g
	end
	if g.On == on then return end
	g.On = on
	if g.Tween then
		g.Tween:Cancel()
		g.Tween = nil
	end
	if not stroke then return end
	if on then
		stroke.Transparency = 0
		stroke.Thickness = 3
		g.Tween = TweenService:Create(stroke,
			TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 6 })
		g.Tween:Play()
	else
		stroke.Transparency = 1
		stroke.Thickness = 3
	end
end

-- 환생 ready / 휴가 days are 설정 rows now (A23-40 정정): [메뉴] and its 설정 square glow; the scroll hint (B14) glows 가방
local function refreshMenuGlow()
	local settings = num("Level", 1) >= Config.RebirthLevel(num("Rebirths", 0)) or num("VacationDays", 0) > 0
	L.SetGlow("menu", ui.menuGlow, settings)
	L.SetGlow("settings", ui.settingsGlow, settings)
	L.SetGlow("bag", ui.bagGlow, L.ItemsHint())
end

----------------------------------------------------------------- refresh: travel
local function refreshTravel()
	local untilT = num("TravelingUntil", 0)
	local remaining = untilT - Util.Now()
	if untilT <= 0 or remaining <= 0 then
		ui.travel.Visible = false
		return
	end
	ui.travel.Visible = true
	local total = math.max(0.1, Config.Travel.ChannelSeconds or 3)
	ui.setTravel(1 - remaining / total)
	ui.travelLabel.Text = string.format(TXT.TravelLeft, textOr("Traveling", TXT.Traveling), remaining)
end

----------------------------------------------------------------- quests
-- BB1 / A23-21: quest rows carry raw key tokens ('자동 전투 켜기 ({Auto})'; the server cannot know the device). Keyboards
-- show the current key (the "(…)" group goes while that action has no key), touch-only devices the button name
-- ('자동 버튼'). Rows are drawn again on Keybinds.Changed.
function L.QuestText(text)
	if type(text) ~= "string" or not string.find(text, "{", 1, true) then return text end
	local kb = C and C.Keybinds
	if type(kb) == "table" and type(kb.Fill) == "function" then
		-- keyOnly where keys are shown (Keybinds.ShowsKeys, review B5); without a keyboard Keybinds.Label gives the button
		local ok, out = pcall(kb.Fill, text, type(kb.ShowsKeys) == "function" and kb.ShowsKeys() == true)
		if ok and type(out) == "string" then return out end
	end
	return Config.FillKeys(text, (Config.KeyMap(nil, nil)))
end

local function parseQuests()
	local data = questState.Data -- CR-L50: last "Quests" remote payload (array of entries)
	if type(data) ~= "table" then return {} end
	-- remote tables can carry NaN / inf (JSON could not): treat them as missing
	local function finite(v, default)
		v = tonumber(v)
		if v == nil or v ~= v or v == math.huge or v == -math.huge then return default end
		return v
	end
	local pinned, normal = {}, {}
	for _, e in ipairs(data) do
		if type(e) == "table" then
			local isPinned = e.Pinned == true or (e.Slot == nil and e.Id == TUT_QUEST_ID)
			local slot = finite(e.Slot, nil)
			local entry = {
				Id = tostring(e.Id or ""),
				Kind = tostring(e.Kind or "Extra"),
				Text = L.QuestText(tostring(e.Text or "")),
				Progress = math.max(0, finite(e.Progress, 0)),
				Target = math.max(1, finite(e.Target, 1)),
				RewardGold = math.max(0, finite(e.RewardGold, 0)),
				Pinned = isPinned,
				CanClaim = e.CanClaim ~= false,
				ShowProgress = e.ShowProgress ~= false,
				TutorialStep = finite(e.TutorialStep, -1),
				NextGoal = e.NextGoal == true,
				Story = type(e.Story) == "table" and e.Story or nil, -- story rows: { Id, St, Panel, Guide }
				Unit = type(e.Unit) == "string" and e.Unit or nil, -- Kill/Golden quests: the monster kind (icon)
				Slot = (not isPinned) and slot or nil, -- N1: the client only ever sends Slot or "tutorial"
			}
			table.insert(isPinned and pinned or normal, entry)
		end
	end
	-- A23-3: before the first mission is accepted (step 0) dailies keep progressing on the server but stay folded
	local folded = pinned[1] ~= nil and pinned[1].TutorialStep == 0
	if questState.Folded == true and not folded and pinned[1] ~= nil and pinned[1].TutorialStep > 0 and #normal > 0 then
		UIKit.Toast((type(TUT.Text) == "table" and TUT.Text.DailiesOpened) or TXT.DailiesOpened, "good", 4)
	end
	questState.Folded = folded
	if folded then
		for _, e in normal do
			if e.Kind == "Sub" then table.insert(pinned, e) end -- S0 shows even before the first mission (A23-2)
		end
		return pinned
	end
	for _, e in normal do
		table.insert(pinned, e)
	end
	return pinned
end

-- CR-L50: the owner's quest list arrives on the "Quests" remote (fired only when it changes) instead of the
-- QuestsJson attribute that replicated to every player. Takes the array itself or its JSON string.
local function onQuests(payload)
	local data = payload
	if type(payload) == "string" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(payload)
		end)
		data = ok and decoded or nil
	elseif type(payload) == "table" and type(payload.Quests) == "table" then
		data = payload.Quests
	end
	if type(data) ~= "table" then return end
	questState.Data = data
	if questState.Started then refreshQuests() end
end

-- CR-M27 / CR-L31: "progress/target" strings. Kill / Golden progress can be fractional (unit-XP share, floored to
-- 0.1 by the server) and shows one decimal instead of looking stuck; targets under 10,000 show the plain integer
-- (FormatNumber made 3,199 of 3,200 read "3.2K/3.2K" while unfinished).
local function questNums(e)
	local function count(v)
		v = math.clamp(v, 0, e.Target)
		if e.Target < 10000 then
			local tenths = math.floor(v * 10 + 1e-6) / 10 -- floor: 0.96 of 1 reads "0.9", never "1.0"
			if tenths == math.floor(tenths) then return tostring(math.floor(tenths)) end
			return string.format("%.1f", tenths)
		end
		return fmtNum(v)
	end
	local p, t = count(e.Progress), count(e.Target)
	if e.Progress < e.Target and p == t then
		p, t = tostring(math.floor(e.Progress)), tostring(math.floor(e.Target)) -- never "12.5K/12.5K" unfinished
	end
	return p, t
end

local function onClaim(r)
	local e = r.Entry
	if not e or not e.CanClaim or e.Progress < e.Target or throttled("claim", 0.35) then return end
	if os.clock() < (r.LockUntil or 0) then return end -- CR-M24: the row just changed under the finger
	local arg = nil
	if e.Story then
		arg = e.Id -- "story:<id>"
	elseif e.Pinned then
		arg = TUT_QUEST_ID
	else
		arg = e.Slot
	end
	if arg == nil then return end
	fire("ClaimQuest", arg)
	questState.ClaimAt = os.clock() -- CR-M24: 교체 ignores taps for ClaimLock seconds after a claim
	r.Claim:SetAttribute("Disabled", true)
	setDim(r.Claim, true)
	task.delay(1.5, function()
		if r.Claim.Parent then
			r.Claim:SetAttribute("Disabled", false)
			setDim(r.Claim, false)
		end
	end)
end

L.OnClaim = onClaim -- the quest lines (built above) claim through the list rows

local function onReroll(r)
	local e = r.Entry
	if not e or e.Pinned or e.Slot == nil then return end
	local now = os.clock()
	if now - questState.ClaimAt < questState.ClaimLock then return end -- CR-M24
	if now < (r.LockUntil or 0) then return end
	if Util.Now() < num("RerollReadyAt", 0) then return end
	if throttled("reroll", 0.6) then return end
	local slot, key = e.Slot, r.Key
	-- CR-M25: rerolling throws the progress away, so it always asks first (every device)
	UIKit.Confirm(TXT.RerollTitle, TXT.RerollBody, TXT.RerollYes, function()
		if r.Key ~= key then return end -- the row changed while the dialog was open
		fire("RerollQuest", slot)
	end)
end

-- parchment row: quest icon (slime / scroll), kind badge + text, progress bar + coin reward.
-- 교체 sits top-right and 받기 bottom-right, so the two never share a spot (CR-M24).
function L.QuestMetrics(s)
	local r = table.clone(L.Row)
	r.Badge = math.max(r.Badge, math.ceil(26 / s))
	r.BadgeH = math.max(r.BadgeH, math.ceil(12 / s))
	r.Reroll = math.max(r.Reroll, math.ceil(30 / s))
	r.BtnH = math.max(r.BtnH, math.ceil(16 / s))
	r.Reward = math.max(r.Reward, math.ceil(50 / s))
	r.BarH = math.max(r.BarH, math.ceil(12 / s))
	r.Height = math.max(L.QuestRowH, math.ceil(40 / s), r.BtnH + r.BarH + 14)
	return r
end

function L.LayoutQuestRow(r, s)
	local W, R = ui.questRowW, L.QuestMetrics(s)
	local H, iconS = R.Height, L.QuestRowH - 20
	r.Frame.Size = UDim2.fromOffset(W, H)
	local x0 = r.Icon and (iconS + 14) or 8
	r.Badge.Position = UDim2.fromOffset(x0, 7)
	r.Badge.Size = UDim2.fromOffset(R.Badge, R.BadgeH)
	local textX = x0 + R.Badge + 5
	r.TextLong = W - textX - 10
	r.TextShort = W - textX - R.Reroll - 14
	r.Text.Position = UDim2.fromOffset(textX, 5)
	r.Text.Size = UDim2.fromOffset(r.Reroll.Visible and r.TextShort or r.TextLong, R.BtnH + 1)
	if r.Entry and not r.Entry.ShowProgress then
		r.Text.Size = UDim2.fromOffset(r.TextLong, H - 10)
	end
	local barY, rx = H - R.BarH - 9, W - R.Reward - 8
	r.Bar.Position = UDim2.fromOffset(x0, barY)
	r.Bar.Size = UDim2.fromOffset(W - x0 - R.Reward - 14, R.BarH)
	local cs = R.BarH + 3
	if r.Coin then
		r.Coin.Position = UDim2.fromOffset(rx, barY + math.floor((R.BarH - cs) / 2))
		r.Coin.Size = UDim2.fromOffset(cs, cs)
	end
	local tx = r.Coin and (rx + cs + 3) or rx
	r.Reward.Position = UDim2.fromOffset(tx, barY - 2)
	r.Reward.Size = UDim2.fromOffset(W - 8 - tx, R.BarH + 4)
	local claimH = R.BtnH + 4
	r.Claim.Position = UDim2.fromOffset(rx - 6, H - claimH - 4)
	r.Claim.Size = UDim2.fromOffset(R.Reward + 10, claimH)
	r.Reroll.Position = UDim2.fromOffset(W - R.Reroll - 8, 4)
	r.Reroll.Size = UDim2.fromOffset(R.Reroll, R.BtnH)
end

local function makeQuestRow(index)
	local W, R = ui.questRowW, L.QuestMetrics(currentScale())
	local H = R.Height
	local row, isArt = UIKit.ArtFrame("PanelParchment", {
		Name = "Quest" .. index,
		LayoutOrder = index,
		Size = UDim2.fromOffset(W, H),
		Parent = ui.questList,
	})
	local r = { Frame = row, IsArt = isArt, Entry = nil, Key = nil, LockUntil = 0 }
	-- tapping the pinned guide row opens its action (claim / reroll sit above it at ZIndex 3)
	r.Tap = UIKit.Create("TextButton", {
		Name = "Tap",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 2,
		Visible = false,
		Parent = row,
	})
	r.Tap.Activated:Connect(function()
		if r.Entry and (r.Entry.Pinned or r.Entry.Story) and L.PinnedTap then L.PinnedTap(r.Entry, r) end
	end)
	local iconS = L.QuestRowH - 20
	r.Icon = UIKit.ArtImage("IconScroll", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(iconS, iconS),
		Parent = row,
	})
	local x0 = r.Icon and (iconS + 14) or 8
	r.Badge = touchFloor(UIKit.Create("TextLabel", {
		Name = "Badge",
		Position = UDim2.fromOffset(x0, 7),
		Size = UDim2.fromOffset(R.Badge, R.BadgeH),
		BackgroundColor3 = Theme.Gold,
		TextColor3 = COL.Dark,
		TextSize = R.Text - 2,
		Text = "",
		Parent = row,
	}, {
		corner(UDim.new(0, 5)),
		UIKit.Create("UIStroke", {
			Color = ac("Rim", COL.Dark),
			Thickness = 1,
			Transparency = 0.3,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	}))
	local textX = x0 + R.Badge + 5
	r.TextLong = W - textX - 10
	r.TextShort = W - textX - R.Reroll - 14
	r.Text = artLabel(true, {
		Name = "Text",
		Position = UDim2.fromOffset(textX, 5),
		Size = UDim2.fromOffset(r.TextShort, R.BtnH + 1),
		TextScaled = true,
		MaxTextSize = R.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})
	local barY = H - R.BarH - 9
	local bar, setBar, barText = UIKit.ArtBar({
		Name = "Progress",
		Position = UDim2.fromOffset(x0, barY),
		Size = UDim2.fromOffset(W - x0 - R.Reward - 14, R.BarH),
		Color = ac("QuestBlue", Theme.Good),
		TextSize = IS_TOUCH and L.TouchText or 11,
		Parent = row,
	})
	r.SetBar = setBar
	r.Bar = bar
	r.BarText = barText
	-- reward: coin + "+120"
	local rx = W - R.Reward - 8
	local cs = R.BarH + 3
	r.Coin = UIKit.ArtImage("IconCoin", {
		Name = "Coin",
		Position = UDim2.fromOffset(rx, barY + math.floor((R.BarH - cs) / 2)),
		Size = UDim2.fromOffset(cs, cs),
		Parent = row,
	})
	local tx = r.Coin and (rx + cs + 3) or rx
	r.Reward = artLabel(true, {
		Name = "Reward",
		Position = UDim2.fromOffset(tx, barY - 2),
		Size = UDim2.fromOffset(W - 8 - tx, R.BarH + 4),
		TextScaled = true,
		MaxTextSize = R.Text,
		Number = true,
		Color = ac("GoldInk", Theme.Gold),
		Outline = ac("TextOutline", COL.Dark),
		OutlineTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	-- 받기: green candy pill over the reward (bottom-right)
	local claimH = R.BtnH + 4
	local claim, claimLabel = UIKit.ArtButton("Pill", {
		Name = "Claim",
		Position = UDim2.fromOffset(rx - 6, H - claimH - 4),
		Size = UDim2.fromOffset(R.Reward + 10, claimH),
		ImageColor3 = COL.HotTint,
		Text = TXT.Claim,
		TextSize = R.Text + 1,
		TextStyle = "light",
		Visible = false,
		ZIndex = 3,
		Parent = row,
	}, function()
		onClaim(r)
	end, { Color = Theme.Good, CornerRadius = UDim.new(0.5, 0) })
	r.Claim = claim
	L.FitText(claimLabel, 12)
	-- 교체: small parchment pill (top-right)
	local reroll, rerollLabel = UIKit.ArtButton("Pill", {
		Name = "Reroll",
		Position = UDim2.fromOffset(W - R.Reroll - 8, 4),
		Size = UDim2.fromOffset(R.Reroll, R.BtnH),
		Text = TXT.Reroll,
		TextSize = R.Text,
		TextStyle = "ink",
		Visible = false,
		ZIndex = 3,
		Parent = row,
	}, function()
		onReroll(r)
	end, { CornerRadius = UDim.new(0.5, 0) })
	r.Reroll = reroll
	r.RerollLabel = L.FitText(rerollLabel, 11)
	L.FitText(r.Badge, 11)
	L.FitText(r.Text, 12)
	L.FitText(r.BarText, 11)
	L.FitText(r.Reward, 11)
	return r
end

local function refreshRerollTimers()
	local remaining = num("RerollReadyAt", 0) - Util.Now()
	for _, r in questRows do
		if r.Frame.Visible and r.Reroll.Visible then
			local waiting = remaining > 0
			if r.RerollLabel then
				r.RerollLabel.Text = waiting and tostring(math.ceil(remaining)) or TXT.Reroll
			end
			setDim(r.Reroll, waiting)
			r.Reroll:SetAttribute("Disabled", waiting)
		end
	end
end

-- B15: the story page Panels holds back ({ Id, St, Label }) or nil
function L.StoryPending()
	local panels = C and C.Panels
	if type(panels) ~= "table" or type(panels.StoryPending) ~= "function" then return nil end
	local ok, p = pcall(panels.StoryPending)
	if ok and type(p) == "table" and type(p.Id) == "string" and type(p.Label) == "string" then return p end
	return nil
end

-- B15: one gentle gold pulse (a glow stroke) on `target` (a quest row, or the touch header line); nil stops it
function L.SetStoryPulse(target)
	local p = questState.Pulse
	if p.Target == target then return end
	if p.Tween then
		p.Tween:Cancel()
		p.Tween = nil
	end
	if p.Stroke and p.Stroke.Parent then
		p.Stroke.Transparency, p.Stroke.Thickness = 1, 3
	end
	p.Target, p.Stroke = target, nil
	if typeof(target) ~= "Instance" or not target.Parent then return end
	local holder = target:FindFirstChild("StoryGlow")
	local stroke = holder and holder:FindFirstChild("GlowStroke")
	if not stroke then
		stroke = makeGlow(target, UDim.new(0, 10))
		if stroke and stroke.Parent then stroke.Parent.Name = "StoryGlow" end
	end
	if not stroke then return end
	p.Stroke = stroke
	stroke.Transparency, stroke.Thickness = 0.6, 2
	p.Tween = TweenService:Create(stroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Transparency = 0, Thickness = 4 })
	p.Tween:Play()
end

refreshQuests = function()
	if not ui.quests then return end -- Init stopped before buildQuests (CR-L50 binds the remote earlier)
	local entries = parseQuests()
	-- B15: a story page waiting for a calm moment turns its row into "…말을 걸어요 — 눌러서 보기" (pulsing)
	local call = L.StoryPending()
	questState.StoryKey = call and (call.Id .. "|" .. tostring(call.St)) or ""
	local callIndex = nil
	if call then
		for i, e in entries do
			if e.Story and e.Story.Panel and e.Story.Id == call.Id then
				callIndex = i
				break
			end
		end
	end
	questState.CallEntry = callIndex and entries[callIndex] or nil
	local blockWasVisible = ui.quests.Visible
	-- A23-40: the two quest lines always show; the parchment list (header + rows) folds out under them on PC only
	-- (phones open the overlay from the lines)
	ui.quests.Visible = #entries > 0 and not IS_TOUCH and questExpanded
	if ui.questLines then ui.questLines.Visible = #entries > 0 end
	if #entries == 0 and ui.questOverlay then
		questState.OverlayOpen = false
		ui.questOverlay.Visible = false
	end
	local slots = Config.Quests.Slots
	local claims = math.floor(num("DailyClaims", 0))

	-- collapsed: the tutorial row if present, else the first claimable, else the first unfinished daily
	local claimable, firstClaim, firstDaily = 0, nil, nil
	for i, e in entries do
		local done = e.Progress >= e.Target
		if done and e.CanClaim and (e.Pinned or e.Kind == "Daily" or e.Kind == "Sub") then
			claimable += 1
			if not firstClaim then firstClaim = i end
		elseif not done and e.Kind == "Daily" and not firstDaily then
			firstDaily = i
		end
	end
	-- 'now do' row: the pinned guide / next-goal row when there is one (검수 2026-10-06 (b): it always shows, phones too),
	-- else the waiting story, the first claimable, the first unfinished daily. Desktop shows one more row under it.
	local shown, second = nil, nil
	if entries[1] and entries[1].Pinned then
		shown = 1
		second = callIndex or firstClaim or firstDaily
		if second == 1 then second = nil end
	elseif callIndex then
		shown = callIndex -- B15: the collapsed list shows the story that is waiting
	else
		shown = firstClaim or firstDaily or 1
	end

	-- header: progress, claimable count (turns green so claiming stays 1-2 clicks), expand chevron
	local head = (claims >= slots) and TXT.QuestAllDone or string.format(TXT.QuestHeader, claims, slots)
	if claimable > 0 then head ..= string.format(TXT.QuestClaimable, claimable) end
	local hot = claimable > 0
	if IS_TOUCH then
		-- U5 + A23-26: line 1 = what to do now (the pinned / next-goal row first), line 2 = the waiting story (one tap
		-- opens it: the header handler), else 받기 N, else today's count; tapping opens the overlay with the rows
		local se = entries[shown]
		questState.ShownEntry = se
		local line = head
		if se then
			local p, t = questNums(se) -- CR-M27 / CR-L31
			line = se.ShowProgress and string.format(TXT.QuestTouchLine, p, t, se.Text) or se.Text
		end
		local sub = head
		if callIndex and entries[shown] ~= entries[callIndex] then
			sub = call.Label
		elseif callIndex then
			line = call.Label
		elseif hot and not (se and se.Pinned and se.CanClaim and se.Progress >= se.Target) then
			sub = string.format(TXT.QuestTouchClaim, claimable)
		end
		ui.questHeaderText.Text = line
		if ui.questHeaderSub then
			ui.questHeaderSub.Text = sub
			ui.questHeaderSub.TextColor3 = (sub ~= head) and ac("GoldText", Theme.Gold) or ac("LightSub", Theme.SubText)
		end
		ui.questChevron.Text = questState.OverlayOpen and TXT.QuestCollapse or TXT.QuestExpand
		if ui.questOverlayTitle then ui.questOverlayTitle.Text = head end
	else
		ui.questHeaderText.Text = head
		ui.questChevron.Visible = #entries > 1
		ui.questChevron.Text = questExpanded and TXT.QuestCollapse or TXT.QuestExpand
	end
	paint(ui.questHeader, hot and COL.HotTint or COL.White, hot and Theme.Good or ac("Navy", Theme.Bg))

	-- A23-40 quest lines: line 1 = the 'now do' row, line 2 = the next one (the waiting story, a claimable, a daily),
	-- else today's count with 받기 N
	if ui.qline then
		if not second and entries[shown] then
			local alt = callIndex or firstClaim or firstDaily
			if alt and alt ~= shown then second = alt end
		end
		local function lineFor(i)
			local e = i and entries[i]
			if not e then return nil, nil, nil end
			local label = (i == callIndex and call) and call.Label or e.Text
			local nums = nil
			if e.ShowProgress then
				local p, t = questNums(e) -- CR-M27 / CR-L31
				nums = string.format(TXT.QuestLineNums, p, t)
			end
			return e, label, nums
		end
		local e1, l1, n1 = lineFor(shown)
		L.SetQuestLine(ui.qline[1], e1, l1 or head, n1)
		local e2, l2, n2 = lineFor(second)
		L.SetQuestLine(ui.qline[2], e2, l2 or head, n2)
		if ui.questFold then ui.questFold.Text = questExpanded and TXT.QuestCloseList or TXT.QuestOpenList end
		questState.ShownEntry = e1
	end

	local visibleBefore = 0
	for _, r in questRows do
		if r.Frame.Visible then visibleBefore += 1 end
	end

	local visibleNow = 0
	for i, e in entries do
		local r = questRows[i]
		if not r then
			r = makeQuestRow(i)
			questRows[i] = r
		end
		-- CR-M24: a row whose quest just changed ignores taps for RowLock seconds
		local key = e.Id .. "|" .. tostring(e.Slot) .. "|" .. e.Kind .. "|" .. tostring(e.TutorialStep) .. "|" .. e.Text
		if r.Key ~= key then
			r.Key = key
			r.LockUntil = os.clock() + questState.RowLock
		end
		r.Entry = e
		r.Tap.Visible = e.Pinned or e.Story ~= nil
		r.Frame.Visible = IS_TOUCH or questExpanded -- touch: every row, in the overlay; PC: the folded-out list
		if r.Frame.Visible then visibleNow += 1 end
		if e.Story then
			r.Badge.Text = e.Kind == "Main" and TXT.BadgeMain or TXT.BadgeSub
			r.Badge.BackgroundColor3 = e.Kind == "Main" and Theme.XP or COL.Grey
		elseif e.Pinned then
			r.Badge.Text = TXT.BadgePinned
			r.Badge.BackgroundColor3 = Theme.XP
		elseif e.Kind == "Daily" then
			r.Badge.Text = TXT.BadgeDaily
			r.Badge.BackgroundColor3 = Theme.Gold
		else
			r.Badge.Text = TXT.BadgeExtra
			r.Badge.BackgroundColor3 = COL.Grey
		end
		if r.Icon then
			-- a kill quest shows its monster's head (IconMon<Kind>) when that art exists, else the row type's icon
			local head = e.Unit and UIKit.ArtId("IconMon" .. e.Unit)
			r.Icon.Image = head or UIKit.ArtId(QUEST_ICON[e.Id] or "IconScroll") or UIKit.ArtId("IconSlime") or r.Icon.Image
		end
		r.Text.Text = (i == callIndex) and call.Label or e.Text
		r.Text.TextWrapped = not e.ShowProgress
		r.Text.TextTruncate = e.ShowProgress and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None
		r.Bar.Visible = e.ShowProgress
		local done = e.Progress >= e.Target
		r.SetBar(e.Progress / e.Target, done and ac("UpgradeGold", Theme.Gold) or ac("QuestBlue", Theme.Good))
		local p, t = questNums(e) -- CR-M27 / CR-L31
		r.BarText.Text = p .. "/" .. t
		local canClaim = done and e.CanClaim and (e.Pinned or e.Kind == "Daily" or e.Kind == "Sub")
		local canReroll = (not done) and (not e.Pinned) and e.Slot ~= nil
		r.Reward.Text = e.RewardGold > 0 and ("+" .. fmtNum(e.RewardGold)) or ""
		r.Reward.Visible = not canClaim -- 받기 covers the reward slot
		if r.Coin then r.Coin.Visible = e.RewardGold > 0 and not canClaim end
		r.Claim.Visible = canClaim
		r.Reroll.Visible = canReroll
		r.Text.Size = UDim2.fromOffset(canReroll and r.TextShort or r.TextLong, r.Text.Size.Y.Offset)
		L.LayoutQuestRow(r, currentScale())
		-- claimable rows turn green (art tint, or the fallback's rim)
		if r.IsArt then
			r.Frame.ImageColor3 = canClaim and COL.RowHotTint or COL.White
		else
			local stroke = r.Frame:FindFirstChild("Stroke")
			if stroke then
				stroke.Color = canClaim and Theme.Good or ac("Rim", COL.Dark)
				stroke.Thickness = canClaim and 3 or 2
			end
		end
	end
	for i = #entries + 1, #questRows do
		local r = questRows[i]
		r.Entry = nil
		r.Frame.Visible = false
	end
	local callRow = callIndex and questRows[callIndex]
	-- A23-40: the pulse sits on the quest line that shows the waiting story (phones: the whole block), else on its list row
	local callTarget = nil
	if callIndex then
		callTarget = IS_TOUCH and ui.questLines or nil
		for _, l in ui.qline or {} do
			if not IS_TOUCH and l.Entry == entries[callIndex] and l.Row.Visible then callTarget = l.Row end
		end
		if not callTarget then callTarget = callRow and callRow.Frame or nil end
	end
	L.SetStoryPulse(callTarget)
	questState.Rows = entries -- HUD.QuestTarget (QuestMarker) reads the 'now do' row
	questState.Shown = shown
	refreshRerollTimers()
	-- CR-L36: the block's visibility also moves the war meter column's left edge
	if visibleBefore ~= visibleNow or blockWasVisible ~= ui.quests.Visible then
		requestLayout()
	end
end

-- desktop: expand / collapse the list; touch: open / close the overlay (open = nil toggles)
toggleQuests = function(open)
	if IS_TOUCH then
		if open == nil then open = not questState.OverlayOpen end
		questState.OverlayOpen = open == true
		if ui.questOverlay then ui.questOverlay.Visible = questState.OverlayOpen end
		requestLayout()
	else
		questExpanded = not questExpanded
	end
	refreshQuests()
end

----------------------------------------------------------------- guide beam (A4 step 1, A7-3 reuse)
local function resolvePart(target)
	if typeof(target) ~= "Instance" then return nil end
	if target:IsA("BasePart") then return target end
	if target:IsA("Model") then
		return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
	end
	if target:IsA("Attachment") and target.Parent and target.Parent:IsA("BasePart") then
		return target.Parent
	end
	return target:FindFirstChildWhichIsA("BasePart", true)
end

-- local-only invisible anchor (used when the map has neither the pad nor the gate)
local function localAnchor(zoneId, position)
	local a = guideAnchors[zoneId]
	if a and a.Parent then return a end
	a = Instance.new("Part")
	a.Name = "HUDGuideAnchor_" .. zoneId
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.CastShadow = false
	a.Transparency = 1
	a.Size = Vector3.new(1, 1, 1)
	a.Position = position
	a.Parent = workspace
	guideAnchors[zoneId] = a
	return a
end

-- Crossroads travel pad of the zone, else its gate, else a local anchor at the zone spawn
local function findTravelTarget(zoneId)
	local map = workspace:FindFirstChild("Map")
	local pads = map and map:FindFirstChild("Pads")
	local part = resolvePart(pads and pads:FindFirstChild("Pad_" .. zoneId))
	if part then return part end
	local gates = map and map:FindFirstChild("Gates")
	part = resolvePart(gates and gates:FindFirstChild("Gate_" .. zoneId))
	if part then return part end
	local z = Config.Zones[zoneId]
	if not z then return nil end
	return localAnchor(zoneId, z.Spawn + Vector3.new(0, 3, 0))
end

local function destroyGuide(g)
	if g.Tween then g.Tween:Cancel() end
	for _, inst in { g.Beam, g.Att0, g.Att1, g.Billboard } do
		if inst then inst:Destroy() end
	end
end

function HUD.ClearGuide()
	local g = guide
	guide = nil
	if g then destroyGuide(g) end
end

local function attachGuideToCharacter()
	local g = guide
	if not g or not g.Beam then return end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then return end
	if g.Att0 and g.Att0.Parent == root then return end
	if g.Att0 then g.Att0:Destroy() end
	local a0 = Instance.new("Attachment")
	a0.Name = "HUDGuideFrom"
	a0.Parent = root
	g.Att0 = a0
	g.Beam.Attachment0 = a0
end

local function showGuide(target, text, tag, seconds)
	local part = resolvePart(target)
	if not part then return false end
	HUD.ClearGuide()

	local g = { Tag = tag, Part = part }
	local a1 = Instance.new("Attachment")
	a1.Name = "HUDGuideTo"
	a1.Position = Vector3.new(0, part.Size.Y / 2 + 1, 0)
	a1.Parent = part
	g.Att1 = a1

	local beam = Instance.new("Beam") -- no texture asset: the default renders a solid band
	beam.Name = "HUDGuideBeam"
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(Theme.Gold)
	beam.Transparency = NumberSequence.new(0.2)
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.LightEmission = 0.8
	beam.LightInfluence = 0
	beam.Parent = part
	g.Beam = beam

	local bb = Instance.new("BillboardGui")
	bb.Name = "HUDGuideLabel"
	bb.Adornee = part
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 100000
	bb.Size = UDim2.fromOffset(220, 64)
	bb.StudsOffset = Vector3.new(0, part.Size.Y / 2 + 5, 0)
	UIKit.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextScaled = true,
		Text = tostring(text or TUT_GUIDE_TEXT),
		TextColor3 = Theme.Gold,
		TextStrokeTransparency = 0,
		Parent = bb,
	})
	bb.Parent = part
	g.Billboard = bb
	g.Tween = TweenService:Create(bb, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		StudsOffset = bb.StudsOffset + Vector3.new(0, 1.5, 0),
	})
	g.Tween:Play()

	guide = g
	attachGuideToCharacter()
	if seconds and seconds > 0 then
		task.delay(seconds, function()
			if guide == g then HUD.ClearGuide() end
		end)
	end
	return true
end

-- public (addendum A7-3): beam from the character to `part` + a floating label; replaces any current guide
function HUD.ShowGuide(part, text)
	local label = (type(text) == "string" and text ~= "") and text or TUT_GUIDE_TEXT
	showGuide(part, label, "custom", nil)
end

local function isZoneGuide(tag)
	return type(tag) == "string" and string.sub(tag, 1, 5) == "zone:"
end

function L.BlacksmithTarget()
	local map = workspace:FindFirstChild("Map")
	local landmarks = map and map:FindFirstChild("Landmarks")
	local guild = landmarks and landmarks:FindFirstChild("ArtisanGuild")
	local anvil = guild and guild:FindFirstChild("Anvil")
	return anvil and anvil:IsA("BasePart") and anvil or nil
end

-- the meadow beam from a faction town first points at that island's bridge (a straight line crossed the water);
-- from the Crossroads it points at the meadow pad
local HOME_BRIDGE = { HaloTown = "Bridge_Halo", HornsTown = "Bridge_Horns" }
function L.MeadowTarget(zone)
	local bridge = HOME_BRIDGE[zone]
	local map = workspace:FindFirstChild("Map")
	local decor = map and map:FindFirstChild("Decor")
	local part = bridge and decor and resolvePart(decor:FindFirstChild(bridge))
	return part or findTravelTarget(TUT_GUIDE_ZONE)
end

-- step 1, or step 2 with kills left (e.g. died mid-mission and respawned in town): guide back to the meadow
function L.NeedsMeadowGuide(step)
	if step == TUT_GUIDE_STEP then return true end
	local quest = (type(TUT.Steps) == "table" and TUT.Steps.Quest) or 2
	return step == quest and num("TutorialKills", 0) < (tonumber(TUT.QuestKills) or 5)
end

-- tutorial step 1: guide to the SlimeMeadow pad; cleared when the step changes or the player enters the zone.
-- Zone guides (Lv 10 / Lv 25) are cleared when the player enters that zone.
local function refreshGuides()
	if attr("DataLoaded", false) ~= true then return end
	local step = num("TutorialStep", 99)
	local zone = attr("ZoneId", "")
	if guide then
		if guide.Tag == "tutorial" and (not L.NeedsMeadowGuide(step) or zone == TUT_GUIDE_ZONE or guide.From ~= zone) then
			HUD.ClearGuide()
		elseif isZoneGuide(guide.Tag) and zone == string.sub(guide.Tag, 6) then
			HUD.ClearGuide()
		elseif guide.Tag == "blacksmith" and (attr("BlacksmithVisited", false) == true or zone ~= "Crossroads") then
			HUD.ClearGuide()
		elseif guide.Tag == "smith:manual" and zone ~= "Crossroads" then
			HUD.ClearGuide()
		end
	end
	if L.NeedsMeadowGuide(step) and zone ~= TUT_GUIDE_ZONE and not (guide and guide.Tag == "tutorial") then
		if showGuide(L.MeadowTarget(zone), TUT_GUIDE_TEXT, "tutorial", nil) and guide then guide.From = zone end
	elseif step == 99 and attr("BlacksmithVisited", false) ~= true and zone == "Crossroads"
		and not (guide and guide.Tag == "blacksmith") then
		showGuide(L.BlacksmithTarget(), TXT.SmithGuide, "blacksmith", nil)
	end
end

-- A7-3 reuse: reaching a GuideZones zone's MinLevel during this session -> guide there for GuideSeconds
local function onLevelChanged()
	local level = math.floor(num("Level", 1))
	local prev = prevLevel
	prevLevel = level
	if not levelBaselineReady or prev == nil or level <= prev then return end
	if guide and guide.Tag == "tutorial" then return end
	local zone = attr("ZoneId", "")
	local targetZone = nil
	for _, zoneId in GUIDE_ZONES do
		local z = Config.Zones[zoneId]
		if z and type(z.MinLevel) == "number" and z.MinLevel > prev and z.MinLevel <= level and zone ~= zoneId then
			targetZone = zoneId
		end
	end
	if targetZone then
		local name = tostring(Config.Zones[targetZone].Name)
		showGuide(findTravelTarget(targetZone), string.format(TXT.ZoneGuide, name), "zone:" .. targetZone, GUIDE_SECONDS)
	end
end

----------------------------------------------------------------- input
inputAllowed = function()
	if not ui.root or not ui.root.Visible then return false end
	if C and C.Panels and C.Panels.IsOpen() then return false end
	if C and C.WorldMap and C.WorldMap.IsOpen() then return false end
	return true
end

local function swingInterval()
	local def = Config.Classes[getClass()] or Config.Classes.Warrior
	return math.max(0.1, tonumber(def.SwingInterval) or 1)
end

local function clearHolds()
	if next(holdSources) == nil then return end
	table.clear(holdSources)
	holdToken += 1
	pressScale(ui.attack, false)
end

-- One deliberate press sends one Swing; holding no longer attacks repeatedly.
local function startHold(source)
	if source == nil then return end
	local wasHeld = next(holdSources) ~= nil
	holdSources[source] = true
	if wasHeld then return end
	holdToken += 1
	local token = holdToken
	pressScale(ui.attack, true)
	-- ranged classes (and bare hands) turn to the nearest monster first; the server only hits what I face (AimCone)
	if L.FaceTarget("Swing") then
		task.delay(0.08, function() fire("Swing") end) -- let the new facing replicate before the swing
	else
		fire("Swing")
	end

end

local function stopHold(source)
	if source == nil or holdSources[source] == nil then return end
	holdSources[source] = nil
	if next(holdSources) == nil then
		holdToken += 1
		pressScale(ui.attack, false)
	end
end

local function doRelease()
	if throttled("release", 0.2) then return end
	if num("SkillReadyAt", 0) > Util.Now() then return end
	if num("Mana", 0) < Config.BasicSkill.ManaCost then
		if not throttled("skillMana", 1.5) then UIKit.Toast(TXT.NoMana, "bad", 1.5) end
		return
	end
	if L.FaceTarget("Release") then
		task.delay(0.08, function() fire("Release") end)
	else
		fire("Release")
	end
end

-- A23-34 (검수 2026-10-06): the forge window opens only through the server's anvil prompt, which records the visit
-- (M1_1) and hands the first weapon over before the shop shows. Near the anvil the prompt is pressed for me; farther
-- away the guide beam shows the way (no shop).
L.Smith = { Prompt = "HHC_BlacksmithPrompt", Reach = 12,
	Travel = "Go to the Crossroads and find the Forge anvil.", Guide = "Forge · use the anvil",
	Walk = "Walk to the Forge anvil and press its button." }

function L.PressAnvil()
	local anvil = L.BlacksmithTarget()
	local guild = anvil and anvil.Parent
	local prompt = guild and guild:FindFirstChild(L.Smith.Prompt, true)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
	local holder = prompt.Parent
	local pos = holder and ((holder:IsA("BasePart") and holder.Position) or (holder:IsA("Attachment") and holder.WorldPosition))
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not pos or not root then return false end
	if (root.Position - pos).Magnitude > math.min(L.Smith.Reach, prompt.MaxActivationDistance) then return false end
	local ok = pcall(function() prompt:InputHoldBegin() end)
	task.delay(0.05, function() pcall(function() prompt:InputHoldEnd() end) end)
	return ok
end

doUpgrade = function()
	if throttled("upgrade", 0.35) then return end
	local panels = C and C.Panels
	if type(panels) ~= "table" or type(panels.Open) ~= "function" then return end
	if attr("ZoneId", "") ~= "Crossroads" then
		panels.Open("Travel")
		UIKit.Toast(L.Smith.Travel, "info", 4)
		return
	end
	if L.PressAnvil() then return end
	showGuide(L.BlacksmithTarget(), L.Smith.Guide, "smith:manual", 30)
	UIKit.Toast(L.Smith.Walk, "info", 4)
end

-- ranged classes (AimCone): face the nearest living monster in range unless one is already in front of me.
-- Returns true when the character was turned. Shift lock keeps its own facing (the camera turns the body).
-- A23-34: the basic attack ("Swing") uses Config.AttackProfile (bare hands = a 7-stud punch with a 75-degree cone for
-- every class); skill Q ("Release") keeps the class row
function L.FaceTarget(which)
	local def = which == "Swing" and Config.AttackProfile(getClass(), math.floor(num("WeaponTier", 0)), getFaction())
		or Config.Classes[getClass()]
	if type(def) ~= "table" or type(def.AimCone) ~= "number" then return false end
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then return false end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local folder = workspace:FindFirstChild("Monsters")
	if not root or not hum or hum.Health <= 0 or not folder then return false end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	local cosCone = math.cos(math.rad(def.AimCone))
	local best, bestDist = nil, (def.Range or 30)
	for _, m in folder:GetChildren() do
		local r = m:FindFirstChild("HumanoidRootPart")
		local mh = m:FindFirstChildOfClass("Humanoid")
		if r and r:IsA("BasePart") and not r.Anchored and (not mh or mh.Health > 0) then
			local dir = (r.Position - root.Position) * Vector3.new(1, 0, 1)
			local d = dir.Magnitude
			if d <= (def.Range or 30) then
				if d > 1 and look.Magnitude > 0.01 and look.Unit:Dot(dir.Unit) >= cosCone then return false end
				if d < bestDist then best, bestDist = r, d end
			end
		end
	end
	if not best or bestDist < 1 then return false end
	root.CFrame = CFrame.lookAt(root.Position, Vector3.new(best.Position.X, root.Position.Y, best.Position.Z))
	return true
end

-- story rows: a talk / choice step reopens its dialogue; otherwise travel + the guide beam to where it happens
local STORY_SPOT = { SlimePond = Vector3.new(280, 3, -45) }
function L.StoryTap(st, zone, panels)
	if st.Panel then
		-- B15: my own tap: the server's reply opens the page even mid-fight (auto opens wait for a calm moment)
		if panels and type(panels.ExpectStory) == "function" then pcall(panels.ExpectStory, st.Id) end
		fire("StoryAction", st.Id, "Open")
		return
	end
	local g = st.Guide
	if g == nil then return end
	if g == "Blacksmith" then
		doUpgrade()
		return
	end
	local target = g
	if g == "OwnTown" then target = Config.HomeZoneId(getFaction()) end
	if g == "SlimePond" then target = "SlimeMeadow" end
	if g == "Fountain" or g == "Goose" then target = "Crossroads" end
	if Config.Zones[target] and zone ~= target then
		if panels and panels.Open then panels.Open("Travel") end
		if target == TUT_GUIDE_ZONE then
			if showGuide(L.MeadowTarget(zone), TUT_GUIDE_TEXT, "zone:" .. target, 30) and guide then guide.From = zone end
		else
			showGuide(findTravelTarget(target), tostring(Config.Zones[target].Name), "zone:" .. target, 30)
		end
		return
	end
	if g == "SlimePond" then
		local a = Instance.new("Part")
		a.Name, a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch, a.Transparency = "HUDStoryAnchor", true, false, false, false, 1
		a.Size, a.Position, a.Parent = Vector3.new(1, 1, 1), STORY_SPOT.SlimePond, workspace
		game:GetService("Debris"):AddItem(a, 35)
		showGuide(a, TXT.Pond, "story", 30)
	elseif g == "Fountain" then
		-- the shard in the fountain; MapBuilder only builds Landmarks.Fountain, so fall back to that model and then to a
		-- temporary anchor at Config.StoryQuests.Landmarks.Fountain (the beam must always point somewhere)
		local map = workspace:FindFirstChild("Map")
		local lm = map and map:FindFirstChild("Landmarks")
		local shard = lm and lm:FindFirstChild("CrownShard")
		local part = shard and (shard:IsA("BasePart") and shard or shard:FindFirstChildWhichIsA("BasePart", true))
		local fountain = not part and lm and lm:FindFirstChild("Fountain")
		if fountain then
			part = (fountain:IsA("BasePart") and fountain)
				or (fountain:IsA("Model") and fountain.PrimaryPart) or fountain:FindFirstChildWhichIsA("BasePart", true)
		end
		if not part then
			local spot = Config.StoryQuests and Config.StoryQuests.Landmarks and Config.StoryQuests.Landmarks.Fountain
			if typeof(spot) == "Vector3" then
				part = Instance.new("Part")
				part.Name, part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch, part.Transparency =
					"HUDStoryAnchor", true, false, false, false, 1
				part.Size, part.Position, part.Parent = Vector3.new(1, 1, 1), spot + Vector3.new(0, 4, 0), workspace
				game:GetService("Debris"):AddItem(part, 35)
			end
		end
		local name = Config.StoryQuests and Config.StoryQuests.Speakers and Config.StoryQuests.Speakers.Fountain
		if part then showGuide(part, type(name) == "string" and name or TXT.Fountain, "story", 30) end
	end
end

-- A23-1: the saved ON/OFF lives on the server; the button only asks to flip it
function L.ToggleAuto()
	if attr("AutoCombatUnlocked", false) ~= true or throttled("autoToggle", 0.4) then return end
	fire("SetAutoAttack", attr("AutoCombatEnabled", false) ~= true)
end

function L.RefreshAuto()
	if not ui.auto then return end
	local unlocked = attr("AutoCombatUnlocked", false) == true and attr("ClassChosen", false) == true
	local on = unlocked and attr("AutoCombatEnabled", false) == true
	ui.auto.Visible = unlocked
	if ui.autoLabel then ui.autoLabel.Text = on and TXT.AutoOn or TXT.AutoOff end
	if ui.autoGlow then ui.autoGlow.Transparency = on and 0 or 1 end
	paint(ui.autoArt, on and COL.White or COL.DimTint, on and COL.ReleaseFill or COL.Grey)
end

-- the first mission is done (5/5) and waits for [받기]
function L.ClaimableMission(e)
	local questStep = (type(TUT.Steps) == "table" and TUT.Steps.Quest) or 2
	return type(e) == "table" and not e.Story and e.Pinned == true and e.TutorialStep == questStep and e.CanClaim == true
		and e.Progress >= e.Target
end

-- tapping the pinned guide row: step 0 guide dialogue, step 1/2 travel to the meadow, blacksmith step and the
-- iron-weapon goal -> the existing doUpgrade path, level goals -> the existing beam to the hunting ground.
-- r = the quest row that was tapped (nil from the touch header)
function L.PinnedTap(e, r)
	if throttled("pinnedTap", 0.5) then return end
	-- F10-4 (review 2026-10-06): a finished first mission (5/5) claims on a tap of its line, the same path as [받기]
	-- (ClaimQuest, ClaimAt, 1.5 s lock); the travel window and the meadow beam are only for a mission with kills left
	if L.ClaimableMission(e) then
		local row = r
		if not row then
			for _, qr in questRows do
				if qr.Entry == e then row = qr break end
			end
		end
		if row then onClaim(row) end
		return
	end
	if IS_TOUCH and questState.OverlayOpen and toggleQuests then toggleQuests(false) end
	local step, zone = e.TutorialStep, attr("ZoneId", "")
	local panels = C and C.Panels
	if e.Story then
		L.StoryTap(e.Story, zone, panels)
		return
	end
	if step == 0 then
		fire("RequestTutorial")
	elseif step == 1 or step == 2 then
		if zone ~= TUT_GUIDE_ZONE then
			if panels and panels.Open then panels.Open("Travel") end
			if showGuide(L.MeadowTarget(zone), TUT_GUIDE_TEXT, "tutorial", nil) and guide then guide.From = zone end
		end
	elseif step == 99 then
		local level = math.floor(num("Level", 1))
		local iron = Config.Weapons[3]
		if not e.NextGoal or (iron and level >= iron.MinLevel and (string.find(e.Text, "골드", 1, true) or string.find(string.lower(e.Text), "gold", 1, true))) then
			doUpgrade()
		elseif zone ~= TUT_GUIDE_ZONE then
			showGuide(findTravelTarget(TUT_GUIDE_ZONE), TUT_GUIDE_TEXT, "zone:" .. TUT_GUIDE_ZONE, 30)
		else
			UIKit.Toast(TXT.HuntSlimes, "info", 3)
		end
	end
end

-- U1 menu key / the [메뉴] square (A23-40 정정): an open window closes first, else the [메뉴] squares fold out to the
-- left (or back in)
openMenu = function()
	if throttled("menu", 0.2) then return end
	local panels = C and C.Panels
	if type(panels) == "table" and type(panels.IsOpen) == "function" and type(panels.Close) == "function" then
		local ok, open = pcall(panels.IsOpen)
		if ok and open then
			L.SetFold(false)
			pcall(panels.Close, true)
			return
		end
	end
	L.SetFold(not ui.foldOpen)
end

-- 지도 square (same toggle as WorldMap's M key)
openMap = function()
	if throttled("map", 0.25) then return end
	local wm = C and C.WorldMap
	if type(wm) == "table" and type(wm.Toggle) == "function" then
		local ok, err = pcall(wm.Toggle)
		if not ok then warnThrottled("WorldMap.Toggle failed: " .. tostring(err)) end
	end
end

-- A23-40 tiles: the window a tile opens right now (its own once registered, else its Alt), or nil (the tile hides)
function L.TileWindow(def)
	local panels = C and C.Panels
	local has = type(panels) == "table" and type(panels.Has) == "function" and panels.Has or nil
	if not has then return nil end
	if def.Window and has(def.Window) == true then return def.Window end
	if def.Alt and has(def.Alt) == true then return def.Alt end
	return nil
end

-- a tile press: 지도 = the world map toggle, window tiles open their window (the same tile closes it; another window
-- switches)
function L.TileTap(def)
	if def.Map then
		local wm = C and C.WorldMap
		local mapOpen = type(wm) == "table" and type(wm.IsOpen) == "function" and wm.IsOpen()
		if mapOpen or inputAllowed() then openMap() end
		return
	end
	local panels = C and C.Panels
	local target = L.TileWindow(def)
	if not target or type(panels) ~= "table" then return end
	local open = type(panels.IsOpen) == "function" and panels.IsOpen()
	if not (open or inputAllowed()) or throttled("tile", 0.25) then return end
	local ok, err
	if type(panels.CurrentId) == "function" and panels.CurrentId() == target then
		ok, err = pcall(panels.Close, true)
	else
		ok, err = pcall(panels.Open, target)
	end
	if not ok then warnThrottled("tile window failed: " .. tostring(err)) end
end

-- BB1: hold source of a key / pad button press ("key:F", "pad:ButtonR2"); the release of that same key ends the hold
-- even when the binding changed in between
function L.HoldSource(input)
	return (input.UserInputType == Enum.UserInputType.Keyboard and "key:" or "pad:") .. input.KeyCode.Name
end

-- BB1: the window keys (Keybinds group "Window") and the menu key run before inputAllowed() (a window covers the
-- screen). The same key closes its window, another window's key switches to it, a window that does not exist yet
-- (not registered in Panels) does nothing. The menu key keeps U1: it closes any open window, else opens the menu.
-- Returns true when the action was one of these keys.
function L.WindowKey(action)
	local kb, panels = C and C.Keybinds, C and C.Panels
	local target = kb and kb.WindowFor(action)
	if action ~= "Menu" and not target then return false end
	if action ~= "Menu" then L.SetFold(false) end
	if type(panels) ~= "table" then return true end
	local open = type(panels.IsOpen) == "function" and panels.IsOpen()
	if action == "Menu" then
		if open or inputAllowed() then openMenu() end
		return true
	end
	if type(panels.Has) ~= "function" or not panels.Has(target) then return true end
	if not (open or inputAllowed()) or throttled("windowKey", 0.25) then return true end
	local ok, err
	if type(panels.CurrentId) == "function" and panels.CurrentId() == target then
		ok, err = pcall(panels.Close, true)
	else
		ok, err = pcall(panels.Open, target)
	end
	if not ok then warnThrottled("window key failed: " .. tostring(err)) end
	return true
end

-- every key goes through Keybinds (BB1); nothing reacts while a key is being captured or a TextBox has focus
local function onInputBegan(input, gameProcessed)
	local kb = C and C.Keybinds
	if gameProcessed or type(kb) ~= "table" or kb.IsCapturing() or UserInputService:GetFocusedTextBox() then return end
	local action = kb.ActionFor(input)
	if not action or L.WindowKey(action) or not inputAllowed() then return end
	if action == "Attack" then
		startHold(L.HoldSource(input))
	elseif action == "SkillQ" or action == "SkillZ" or action == "SkillX" then
		-- E stays the Roblox interact key (blacksmith / altar / merchant prompts). A23-49: SkillBar owns Q · Z · X
		local bar = C and C.SkillBar
		local slot = string.sub(action, -1)
		if type(bar) == "table" and type(bar.Owns) == "function" and bar.Owns(slot) then
			bar.Use(slot)
		elseif action == "SkillQ" then
			doRelease()
		end
	elseif action == "Upgrade" then
		doUpgrade()
	elseif action == "Auto" then
		L.ToggleAuto()
	end -- Map: WorldMap's binding (A12); potions: VitalsUI; GhostHold: GrudgeGhost; Interact: the prompts (Keybinds)
end

-- releases are handled even when gameProcessed (e.g. the mouse is let go over a button)
local function onInputEnded(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 then
		stopHold("mouse")
		for src in holdSources do
			if typeof(src) == "Instance" and src:IsA("InputObject") and src.UserInputType == Enum.UserInputType.MouseButton1 then
				stopHold(src)
			end
		end
	elseif t == Enum.UserInputType.Touch then
		stopHold(input)
	elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Gamepad1 then
		stopHold(L.HoldSource(input))
	end
end

local function bindButtonInput()
	ui.attack.InputBegan:Connect(function(input)
		if not isPressInput(input) or input.UserInputState ~= Enum.UserInputState.Begin then return end
		if not inputAllowed() then return end
		startHold(input)
		local conn
		conn = input.Changed:Connect(function(prop)
			if prop ~= "UserInputState" then return end
			local s = input.UserInputState
			if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then
				conn:Disconnect()
				stopHold(input)
			end
		end)
	end)
	ui.release.InputBegan:Connect(function(input)
		if not isPressInput(input) or input.UserInputState ~= Enum.UserInputState.Begin then return end
		if not inputAllowed() then return end
		pressScale(ui.release, true)
		doRelease()
	end)
	ui.release.InputEnded:Connect(function(input)
		if isPressInput(input) then pressScale(ui.release, false) end
	end)
	ui.release.MouseLeave:Connect(function()
		pressScale(ui.release, false)
	end)
end

----------------------------------------------------------------- layout (H4 top inset, H5 jump button, M1 scale)
local function findJumpButton()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local tg = pg and pg:FindFirstChild("TouchGui")
	if not tg then return nil end
	if tg:IsA("ScreenGui") and not tg.Enabled then return nil end
	local frame = tg:FindFirstChild("TouchControlFrame")
	local jb = frame and frame:FindFirstChild("JumpButton")
	if jb and jb:IsA("GuiObject") then return jb end
	return nil
end

local function hookJumpButton(jb)
	if jumpButton == jb then return end
	for _, c in jumpConns do
		c:Disconnect()
	end
	table.clear(jumpConns)
	jumpButton = jb
	if jb then
		table.insert(jumpConns, jb:GetPropertyChangedSignal("AbsolutePosition"):Connect(requestLayout))
		table.insert(jumpConns, jb:GetPropertyChangedSignal("AbsoluteSize"):Connect(requestLayout))
	end
	requestLayout()
end

-- A23-40 보강: the free part of the Roblox top bar (GuiService.TopbarInset: screen px from the top-left, right of
-- Roblox's own buttons) in MainGui logical units, for HudLayout's top bar row ([메뉴] + the war meter); nil when Roblox
-- reports none (HudLayout then assumes Roblox's usual buttons)
function L.TopbarRect(gui, s)
	local ok, tb = pcall(function()
		return GuiService.TopbarInset
	end)
	if not ok or typeof(tb) ~= "Rect" or tb.Width <= 0 or tb.Height <= 0 then return nil end
	-- AbsolutePosition is measured below the top bar (GetGuiInset); TopbarInset from the screen's very top
	local origin = gui.AbsolutePosition
	local ox, oy = origin.X, origin.Y + insetY()
	return { X0 = (tb.Min.X - ox) / s, Y0 = (tb.Min.Y - oy) / s, X1 = (tb.Max.X - ox) / s, Y1 = (tb.Max.Y - oy) / s }
end

-- places a centred (AnchorPoint 0.5) button on its rect
function L.Place(btn, r)
	if not btn or not r then return end
	btn.Size = UDim2.fromOffset(r.W, r.H)
	btn.Position = UDim2.fromOffset(r.X + r.W / 2, r.Y + r.H / 2)
end

-- A23-40 icon tiles: which tiles show (a window tile once its window exists; 지도 always), trimmed to the row's Count by
-- Keep (phones: the rest fold out of [메뉴], L.FoldEntries). Returns true when the shown set changed.
function L.PickTiles()
	if not ui.tiles then return false end
	local want = {}
	for _, t in ui.tiles do
		local def = t.Def
		if def.Map or L.TileWindow(def) then table.insert(want, t) end
	end
	local count = (L.Rects and L.Rects.tiles and L.Rects.tiles.Count) or #want
	if #want > count then
		local sorted = table.clone(want)
		table.sort(sorted, function(a, b) return a.Def.Keep < b.Def.Keep end)
		local keep = {}
		for i = 1, count do keep[sorted[i]] = true end
		local kept = {}
		for _, t in want do
			if keep[t] then table.insert(kept, t) end
		end
		want = kept
	end
	local key = ""
	for _, t in want do key ..= t.Def.Id .. "," end
	if key == ui.tileKey then return false end
	ui.tileKey = key
	ui.shownTiles = want
	local shown = {}
	for _, t in want do shown[t] = true end
	local underFold = IS_TOUCH and ui.foldOpen == true
	for _, t in ui.tiles do t.Button.Visible = shown[t] == true and not underFold end
	return true
end

-- the shown tiles on Rects.tiles: squares of Size, Gap apart; PC centred on the row (the screen centre), phones flush
-- right (under the plate)
function L.LayoutTiles(tr)
	local shown = ui.shownTiles or {}
	local n = #shown
	if n == 0 then return end
	local size, gap = tr.Size or tr.H, tr.Gap or 4
	local total = n * size + (n - 1) * gap
	local x0 = IS_TOUCH and (tr.X + tr.W - total) or (tr.X + (tr.W - total) / 2)
	for i, t in shown do
		t.Button.Size = UDim2.fromOffset(size, size)
		t.Button.Position = UDim2.fromOffset(x0 + (i - 1) * (size + gap) + size / 2, tr.Y + size / 2)
	end
end

-- A23-40: every block from HudLayout.Compute (H4 top inset, H5 live jump button, M1 UIScale, phone safe area)
applyLayout = function()
	local gui = UIKit and UIKit.Gui
	if not gui or not ui.root or not L.HL then return end
	local s = currentScale()
	local abs = gui.AbsoluteSize
	if abs.X < 10 or abs.Y < 10 then return end
	local W, H = abs.X / s, abs.Y / s
	local jump = nil
	local jb = jumpButton
	if jb and jb.Parent and jb.Visible and jb.AbsoluteSize.X > 0 then
		local rel = jb.AbsolutePosition - gui.AbsolutePosition
		jump = { X = rel.X / s, Y = rel.Y / s, W = jb.AbsoluteSize.X / s, H = jb.AbsoluteSize.Y / s }
	end
	local R = L.HL.Compute({ W = W, H = H, Scale = s, Inset = insetY(), Touch = IS_TOUCH, Jump = jump,
		Topbar = L.TopbarRect(gui, s), Hidden = { auto = not (ui.auto and ui.auto.Visible) } })
	L.Rects = R
	L.LayoutPlate(R)
	for label in ui.textFits or {} do
		if label.Name == "KeyHint" then
			local keyH = math.max(18, math.ceil(12 / s))
			label.Size = UDim2.fromOffset(keyH, keyH)
		end
	end

	-- icon tile row (PC bottom-centre under the bars, phones top-right under the plate) and [메뉴] (PC top-right corner,
	-- phones the row's right end) with its fold-out room
	L.PickTiles()
	L.LayoutTiles(R.tiles)
	L.LayoutMenu(R)

	-- quest lines (no plate) + the fold-out list under them (PC) / the overlay beside them (phones)
	local q = R.quest
	L.LayoutQuestLines(q)
	ui.quests.Position = UDim2.fromOffset(q.X, q.Y + q.H + 4)
	ui.quests.Size = UDim2.fromOffset(q.W, 0)
	if IS_TOUCH then
		L.LayoutQuestHeader(q.W, q.H)
		-- the rows' overlay opens under the quest lines, kept on screen (CR-M25)
		if ui.questOverlay then
			ui.questOverlay.Position = UDim2.fromOffset(math.clamp(q.X, 8, math.max(8, W - L.OverlayW - 8)), q.Y + q.H + 4)
		end
	else
		ui.questRowW = q.W
		ui.questList.Size = UDim2.fromOffset(q.W, 0)
		L.LayoutQuestHeader(q.W, math.max(L.QuestHeaderH, math.ceil(20 / s)))
	end
	for _, row in questRows do L.LayoutQuestRow(row, s) end

	-- top-centre column: war meter -> chips (zone / luck / status) -> notify (EventHUD's stack, then UIKit toasts)
	local wm = R.war_meter
	ui.war.Position = UDim2.fromOffset(wm.X, wm.Y)
	ui.war.Size = UDim2.fromOffset(wm.W, wm.H)
	L.LayoutWar(wm.H)
	HUD.TopCenterX, HUD.TopCenterW = math.floor(wm.X + wm.W / 2 + 0.5), wm.W
	local ch = R.chips
	ui.chips.Position = UDim2.fromOffset(ch.X + ch.W / 2, ch.Y)
	ui.chips.Size = UDim2.fromOffset(ch.W, ch.H)
	for _, chip in ui.chip do
		chip.Frame.Size = UDim2.fromOffset(0, ch.H)
		if chip.Icon then chip.Icon.Size = UDim2.fromOffset(ch.H - 2, ch.H - 2) end
	end
	if ui.chipMore then ui.chipMore.Frame.Size = UDim2.fromOffset(0, ch.H) end
	local chipsBottom = ch.Y + math.max(ch.H, ui.chips.AbsoluteSize.Y / s)
	local nt = R.notify
	-- travel (3 s channel) rides the top of the notify column
	ui.travel.AnchorPoint = Vector2.new(0.5, 0)
	ui.travel.Position = UDim2.fromOffset(nt.X + nt.W / 2, math.max(nt.Y, chipsBottom + 4))
	ui.travel.Size = UDim2.fromOffset(math.min(340, nt.W), 58)

	-- bottom-right combat cluster (공격 · Q · 자동 · 물약; the ghost hold is GrudgeGhost on Rects.ghost)
	L.Place(ui.attack, R.attack)
	L.Place(ui.release, R.q)
	L.Place(ui.auto, R.auto)
	C.VitalsUI.PlacePotions(R.potions)
	-- combo line + milestone (Fx builds them in MainGui; it never moves them after build)
	local combo = gui:FindFirstChild("FxCombo")
	if combo and combo:IsA("GuiObject") then
		combo.Position = UDim2.fromOffset(R.combo.X + R.combo.W / 2, R.combo.Y + R.combo.H / 2)
		combo.Size = UDim2.fromOffset(R.combo.W, R.combo.H)
	end
	local milestone = gui:FindFirstChild("FxComboMilestone")
	if milestone and milestone:IsA("GuiObject") then
		milestone.Position = UDim2.fromOffset(R.combo.X + R.combo.W / 2, R.combo.Y - 9 - 32)
		milestone.Size = UDim2.fromOffset(math.min(nt.W, 420), 64)
	end

	-- CR-L37: top / left edge of the cluster (EventHUD's legacy personal line keeps above ClusterTop)
	local clusterTop, clusterLeft = math.huge, math.huge
	for _, id in { "attack", "q", "potions", "auto" } do
		local r = R[id]
		if r and (id ~= "auto" or ui.auto.Visible) then
			clusterTop = math.min(clusterTop, r.Y)
			clusterLeft = math.min(clusterLeft, r.X)
		end
	end
	HUD.Layout = {
		W = W,
		H = H,
		Scale = s,
		Rects = R,
		ChipsBottom = chipsBottom,
		ClusterTop = math.floor(clusterTop),
		ClusterLeft = math.floor(clusterLeft),
		TopCenterX = HUD.TopCenterX,
		TopCenterW = HUD.TopCenterW,
		LeftX = ch.X,
		RightX = ch.X + ch.W,
	}
	for _, name in { "EventHUD", "MiniMap", "SkillBar" } do
		local m = C and C[name]
		if type(m) == "table" and type(m.Relayout) == "function" then pcall(m.Relayout) end
	end
	if type(UIKit.PlaceNotify) == "function" then
		local ev = C and C.EventHUD
		local top = (type(ev) == "table" and type(ev.StripBottom) == "function") and ev.StripBottom() or nil
		pcall(UIKit.PlaceNotify, nt, type(top) == "number" and math.max(top + 4, chipsBottom + 4) or chipsBottom + 4)
	end
end

-- 가방 shows once Panels has 'Bag' (BB7) and the portrait / power taps once it has 'Character' (BB8): no silent no-op
function L.RefreshWindows()
	local panels = C and C.Panels
	local has = type(panels) == "table" and type(panels.Has) == "function" and panels.Has or nil
	local character = has and has("Character") == true or false
	for _, hit in { ui.portraitHit, ui.powerRow and ui.powerRow:FindFirstChild("OpenCharacter") } do
		if hit then hit.Visible = character end
	end
	-- A23-40: a window registered later (BB7 bag, BB8 character, BB13 …) brings its tile in
	if L.PickTiles() then requestLayout() end
end

----------------------------------------------------------------- visibility + timer loop
local function refreshVisibility()
	local visible = attr("DataLoaded", false) == true and not pickersOpen()
	if ui.root.Visible ~= visible then
		ui.root.Visible = visible
		if not visible then clearHolds() end
	end
	return visible
end

local function onCharacterAdded(character)
	clearHolds()
	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and guide then attachGuideToCharacter() end
	end)
end

local function tick()
	tickCount += 1
	local visible = refreshVisibility()
	if ui.foldOpen then L.FoldWatch() end
	if not visible then return end
	refreshWarTime()
	refreshChips()
	refreshSkill()
	refreshTravel()
	refreshRerollTimers()
	-- B15: Panels holding back / releasing a story page re-draws the quest rows (label + pulse)
	local call = L.StoryPending()
	if (call and (call.Id .. "|" .. tostring(call.St)) or "") ~= questState.StoryKey then refreshQuests() end
	if tickCount % 5 == 0 then
		refreshMenuGlow() -- B14: the item hint (a scroll, item list not opened yet) has no attribute of its own
		L.RefreshWindows()
		if UserInputService.TouchEnabled then
			local jb = findJumpButton()
			if jb ~= jumpButton then hookJumpButton(jb) end
		end
		applyLayout()
		refreshGuides()
	end
end

-- the HUD root shows (data loaded, no picker open): MiniMap / QuestMarker follow it
function HUD.IsVisible()
	return ui.root ~= nil and ui.root.Visible == true
end

-- the guide beam's current target (position, tag) or nil (MiniMap's quest star)
function HUD.GuideTarget()
	local g = guide
	local p = g and g.Part
	if p and p.Parent then return p.Position, g.Tag end
	return nil
end

-- A23-49: SkillBar's Q goes through the same path as HUD's own Q (throttle, cooldown, MP toast, face the target)
function HUD.Release()
	doRelease()
end

-- the HUD takes input now (no picker / opening / dead state): SkillBar's buttons follow it
function HUD.InputAllowed()
	return inputAllowed()
end

-- SkillBar has drawn Q · Z · X (it starts after HUD in ClientMain ORDER): HUD's own Q stays built (its refreshers keep
-- working) but hidden, so there is one Q button
function HUD.SkillBarReady()
	if ui.release then ui.release.Visible = false end
end

-- A23-36: where the 'now do' quest row happens (QuestTarget.ForEntry) or nil; QuestMarker draws it
function HUD.QuestTarget()
	local qt = C and C.QuestTarget
	local rows = questState.Rows
	if type(qt) ~= "table" or type(qt.ForEntry) ~= "function" or type(rows) ~= "table" then return nil end
	local e = rows[questState.Shown or 1]
	if not e then return nil end
	local ok, target = pcall(qt.ForEntry, e, attr("ZoneId", ""), getFaction())
	return ok and target or nil
end

----------------------------------------------------------------- lifecycle
function HUD.Init(registry)
	C = registry
	UIKit = C and C.UIKit
	if type(UIKit) ~= "table" or not UIKit.Gui then
		error("UIKit is not initialized")
	end
	-- review of 27246d1: the key-badge rule comes from Keybinds (keyboard present, touch laptops included)
	local kb = C and C.Keybinds
	if type(kb) == "table" and type(kb.ShowsKeys) == "function" then
		local ok, shows = pcall(kb.ShowsKeys)
		if ok then L.KeyDevice, L.ShowKeys = shows == true, shows == true end
	end
	Theme = UIKit.Theme
	L.HL = require(script.Parent:WaitForChild("HudLayout")) -- A23-26 v2 rects (pure module, not in ClientMain ORDER)

	ui.root = UIKit.Create("Frame", {
		Name = "HUD",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 5,
		Parent = UIKit.Gui,
	})

	-- CR-L50: listen to the quest list remote inside Init (synchronously, before any Start) so the first list is
	-- never missed. Bound before the build* steps: if one of them throws, Start still runs (ui.root exists) and the
	-- list must still arrive (onQuests only stores it until Start). Never yields here: a missing remote (old server)
	-- is bound later from a background wait.
	local function bindQuests(r)
		r.OnClientEvent:Connect(function(payload)
			local ok, err = pcall(onQuests, payload)
			if not ok then warnThrottled("Quests handler error: " .. tostring(err)) end
		end)
	end
	local questsRemote = remote("Quests")
	if questsRemote then
		bindQuests(questsRemote)
	else
		task.spawn(function()
			local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
			local r = folder and folder:WaitForChild("Quests", 30)
			if r and r:IsA("RemoteEvent") then
				bindQuests(r)
			else
				warnThrottled("remote missing: Quests")
			end
		end)
	end

	buildStats(ui.root)
	buildWar(ui.root)
	buildChips(ui.root)
	buildQuests(ui.root)
	L.BuildQuestLines(ui.root)
	buildTravel(ui.root)
	buildButtons(ui.root)
end

function HUD.Start()
	if not ui.root then
		Util.Warn("HUD", "HUD was not built (Init failed); HUD disabled")
		return
	end

	-- visibility itself is owned by the 0.2 s loop: the pickers start after HUD, so checking IsOpen() here could
	-- flash the HUD for a frame before the faction picker opens
	UIKit.OnAttr({ "DataLoaded" }, function()
		if attr("DataLoaded", false) == true and not levelBaselineReady then
			levelBaselineReady = true
			prevLevel = math.floor(num("Level", 1))
		end
		refreshGuides()
	end)
	UIKit.OnAttr({ "Level", "XP", "Faction", "Class", "Honor", "Infamy", "FallMarks", "RedeemMarks", "SessionTitle", "TitleSel",
		"BankGold", "CarriedGold", "WantedStars", "Bounty" }, refreshStats)
	UIKit.OnAttr({ "Faction", "Class", "ClassChosen", "CharacterGender", "SizeMult" }, L.RefreshPortrait)
	UIKit.OnAttr({ "Level" }, function() L.Pow.LevelAt = os.clock() end) -- BB5: no "+N" next to a level-up banner
	UIKit.OnAttr({ "CombatPower", "DataLoaded", "ClassChosen" }, L.PowerChanged)
	UIKit.OnAttr({ "AutoCombatUnlocked", "AutoCombatEnabled", "ClassChosen" }, L.RefreshAuto)
	-- user 2026-10-06 (A23-26 update): TextChatService chat keeps Roblox's own place and size (top-left, opened with the
	-- top-bar chat bubble or '/'); this code no longer moves ChatWindowConfiguration. It starts closed on desktop too,
	-- so it never covers the top-left status plate until the player opens it, and the plate never has to move out of
	-- its way (review rubric 5: nothing gets pushed by motion). Touch already starts closed.
	if not IS_TOUCH then task.spawn(L.CloseChatOnce) end
	-- auto combat + ranged class: while I stand still, keep facing the nearest monster so the server's aim cone fits
	task.spawn(function()
		while true do
			task.wait(0.25)
			if attr("AutoCombatEnabled", false) == true then
				local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.MoveDirection.Magnitude < 0.1 then pcall(L.FaceTarget) end
			end
		end
	end)
	UIKit.OnAttr({ "Mana", "SkillReadyAt" }, refreshSkill)
	UIKit.OnAttr({ "Class", "ClassChosen" }, L.RefreshAttackGlyph)
	UIKit.OnAttr({ "Class", "ClassChosen", "Faction" }, L.RefreshSkillIcon)
	UIKit.OnAttr({ "Level", "Rebirths", "VacationDays" }, refreshMenuGlow)
	questState.Started = true -- CR-L50: "Quests" remote payloads refresh the rows from now on
	UIKit.OnAttr({ "DailyClaims", "RerollReadyAt" }, refreshQuests) -- the list itself comes from onQuests
	UIKit.OnAttr({ "ZoneTown", "ZonePvP", "Rookie", "Protected", "InCombatUntil", "SizeMult", "BullyStacks",
		"KaijuState", "Faction" }, refreshChips)
	UIKit.OnAttr({ "WarPoints", "Faction" }, refreshWar)
	UIKit.OnGameAttr({ "WarHaloScore", "WarHornsScore", "WarMode", "WarBlessing", "WarRoundEndsAt" }, refreshWar)
	UIKit.OnAttr({ "TravelingUntil" }, refreshTravel)
	UIKit.OnAttr({ "TutorialStep", "ZoneId", "BlacksmithVisited", "TutorialKills" }, refreshGuides)
	UIKit.OnAttr({ "Level" }, onLevelChanged)

	bindButtonInput()
	task.spawn(placeLegacyChat)
	-- BB1: Keybinds forwards every UserInputService press / release (plus its Dispatch test inputs)
	local kb = C.Keybinds
	if type(kb) == "table" and type(kb.Began) == "table" then
		kb.Began:Connect(onInputBegan)
		kb.Ended:Connect(onInputEnded)
		kb.Changed:Connect(L.RefreshKeys)
		kb.Changed:Connect(function() -- quest rows show the new key (L.QuestText)
			if questState.Started then refreshQuests() end
		end)
	else
		UserInputService.InputBegan:Connect(onInputBegan)
		UserInputService.InputEnded:Connect(onInputEnded)
	end
	if type(C.Settings) == "table" and type(C.Settings.Changed) == "table" then C.Settings.Changed:Connect(L.RefreshKeys) end
	L.RefreshKeys()
	UserInputService.WindowFocusReleased:Connect(clearHolds)
	-- A23-38: Esc opens Roblox's menu and folds the [메뉴] squares back; so does any press outside them (L.FoldInput)
	GuiService.MenuOpened:Connect(function()
		L.SetFold(false)
	end)
	UserInputService.InputBegan:Connect(L.FoldInput)

	LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
	LocalPlayer.CharacterAdded:Connect(L.RefreshPortrait)
	LocalPlayer.CharacterRemoving:Connect(L.PortraitRemoving)
	LocalPlayer.CharacterAppearanceLoaded:Connect(L.RefreshPortrait)

	-- layout follows viewport / UIScale / top-bar changes
	UIKit.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(requestLayout)
	-- A23-40 보강: Roblox's top bar buttons grow / shrink (its menu opened, chat on / off): the bar row follows
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(requestLayout)
	end)
	local scale = UIKit.Gui:FindFirstChildOfClass("UIScale")
	if scale then
		scale:GetPropertyChangedSignal("Scale"):Connect(requestLayout)
	end

	-- H5: touch devices wait (bounded) for the jump button, then lay the buttons out around it
	if UserInputService.TouchEnabled then
		task.spawn(function()
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			local tg = pg and pg:WaitForChild("TouchGui", JUMP_WAIT)
			local frame = tg and tg:WaitForChild("TouchControlFrame", JUMP_WAIT)
			local jb = frame and frame:WaitForChild("JumpButton", JUMP_WAIT)
			if jb and jb:IsA("GuiObject") then
				hookJumpButton(jb)
			end
		end)
	end

	-- A23-51: a left press on the world attacks once (holding or dragging never repeats); the camera turns with the
	-- right mouse drag only (Roblox's default camera).
	C.CameraFollow.PrimaryClick:Connect(function()
		if inputAllowed() then fire("Swing") end
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local ok, err = pcall(tick)
			if not ok then warnThrottled("tick error: " .. tostring(err)) end
		end
	end)

	requestLayout()
	task.delay(1, requestLayout)

	print("[HUD] started")
end

return HUD
]]></ProtectedString>
					<string name="ScriptGuid">{20ED0D38-723D-4A22-AB85-17CC1836F833}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">HUD</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c99063480b229a50ad663aa000008b9</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6C73527CA9904590BBA201147A7ACCFD">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- HudLayout.luau : A23-40 screen layout B ("보여 준 게임처럼") as one pure function (no instances, no services).
-- The rectangles of docs/design/hud_layout_B_imgdev_2026-10-06.json are real pixels on two reference screens: desktop
-- 1280x720 (MainGui UIScale 0.8; the PC numbers are 검수's docs/design/hud_layout_B_2026-10-06.json) and phone 749x361
-- (UIScale 0.75; 이미지 개발 placed the phone by the A23-40 rules), both with a 58 px top bar.
-- HudLayout.Compute turns them into MainGui logical units (before UIScale) for the current screen: every item keeps its
-- distance to the edge it belongs to (top-left / top-centre / top-right / bottom-centre / bottom-right), the top rows follow
-- the real top-bar inset, the phone combat cluster follows the real jump button, the centre column narrows between the
-- left and right blocks, and on PCs the bottom-centre group moves left when the corner cluster would cover it.
--   PC:    top-left round minimap + 2 quest lines under it, top-centre war meter -> chips -> next event -> notify,
--          bottom-centre face + 'Lv · 전투력' + HP | MP + XP + icon tile row, bottom-right combat cluster, top-right the
--          [메뉴] tile (A23-40 정정: its tiles fold out to the left; the Tab list opens under it).
--   phone: the bottom centre belongs to the thumbstick and the combat buttons, so the face / bars / tile row sit top-right
--          (the quest lines beside the minimap, the centre column between them).
--   A23-40 보강 (user 2026-10-06 "메뉴 위치랑 가운데 바가 로블록스 기본 메뉴랑 위치가 같으면 좋겠어"): on both, [메뉴] and the war
--          meter sit IN the Roblox top bar row (env.Topbar = GuiService.TopbarInset, the free part of the bar right of
--          Roblox's own buttons), on the same middle line as Roblox's buttons; [메뉴] is as big as a Roblox button
--          (TOPBAR.Button real px, >= MIN_TAP on touch) and TOPBAR.Edge px from the bar's free right end; both keep their
--          real px size on every UIScale. The chips, the next-event line and notify start right under the bar, and the
--          [메뉴] fold-out runs left along the bar first, then down.
local HudLayout = {}

-- reference screens of the approved sheets (real px)
local REF = {
	Desktop = { W = 1280, H = 720, Scale = 0.8, Inset = 58 },
	Touch = { W = 749, H = 361, Scale = 0.75, Inset = 58, Jump = { 654, 271, 70, 70 } },
}

-- id = { desktop anchor, desktop { x, y, w, h }, touch { x, y, w, h }, touch anchor (default: the desktop one) }
-- anchors: TL top-left, TC top-centre, TR top-right, BC bottom-centre, BR bottom-right (touch: the jump button)
local ITEMS = {
	minimap = { "TL", { 14, 66, 150, 150 }, { 8, 62, 84, 84 } },
	quest = { "TL", { 14, 226, 300, 52 }, { 98, 62, 150, 45 } },
	-- TB = in the Roblox top bar: x like TC, centred on the bar's middle, its height in REAL px (Roblox's buttons do not
	-- follow our UIScale); the sheet's y = on the middle line of Roblox's buttons (34 px)
	war_meter = { "TB", { 496, 13, 288, 42 }, { 255, 15, 240, 38 } },
	chips = { "TC", { 516, 62, 248, 22 }, { 255, 62, 240, 17 } },
	event = { "TC", { 546, 88, 188, 22 }, { 300, 81, 150, 16 } },
	notify = { "TC", { 496, 116, 288, 46 }, { 255, 100, 240, 34 } },
	portrait = { "BC", { 362, 586, 50, 50 }, { 502, 62, 45, 45 }, "TR" },
	power_line = { "BC", { 420, 578, 440, 16 }, { 551, 62, 190, 14 }, "TR" },
	hp_bar = { "BC", { 420, 598, 216, 20 }, { 551, 78, 93, 13 }, "TR" },
	mp_bar = { "BC", { 644, 598, 216, 20 }, { 648, 78, 93, 13 }, "TR" },
	xp_bar = { "BC", { 420, 622, 440, 8 }, { 551, 95, 190, 6 }, "TR" },
	tiles = { "BC", { 420, 640, 440, 52 }, { 502, 112, 239, 45 }, "TR" },
	-- A23-40 정정 + 보강: [메뉴] in the top bar's right end (TB anchor; size and position come from TOPBAR, the rects are
	-- the 1280x720 / 749x361 results). out.fold = its fold-out room
	menu = { "TB", { 1224, 12, 44, 44 }, { 692, 12, 45, 45 } },
	combo = { "BC", { 580, 463, 120, 24 }, { 305, 236, 144, 20 } },
	potions = { "BR", { 926, 646, 122, 58 }, { 337, 298, 112, 54 } },
	-- A23-49 three skills Q · Z · X (docs/design/skill_kit_beta_2026-10-06.md §6-1): the X button joins the cluster; Q / Z /
	-- auto move on PCs and the grudge ghost on phones so the four round buttons keep clear of each other
	ghost = { "BR", { 987, 577, 61, 61 }, { 386, 170, 57, 57 } },
	q = { "BR", { 1052, 596, 77, 77 }, { 455, 252, 72, 72 } },
	z = { "BR", { 1100, 518, 77, 77 }, { 497, 180, 72, 72 } },
	x = { "BR", { 1186, 499, 77, 77 }, { 580, 164, 72, 72 } },
	auto = { "BR", { 1219, 440, 51, 51 }, { 665, 215, 48, 48 } },
	attack = { "BR", { 1146, 592, 118, 118 }, { 534, 241, 112, 112 } },
}
HudLayout.Items = ITEMS
HudLayout.Ref = REF

local CENTER = { "war_meter", "chips", "event", "notify" }
-- the Roblox top bar row (real px, UiSandbox PC + phones 2026-10-06): Left = where Roblox's own buttons end when Roblox
-- reports no TopbarInset (164), Button = their height in a 58 px bar (smaller bars: Inset - 4), Bottom = their gap to the
-- bar's bottom (44 px buttons at y 12..56: middle 34 px), Edge = the gap we keep from the bar's free right end, Tap = the
-- touch floor of [메뉴] (= MIN_TAP at the phone's 0.75 UIScale)
local TOPBAR = { Left = 164, Button = 44, Bottom = 2, Edge = 12, Tap = 45 }
HudLayout.Topbar = TOPBAR
local FOLD_MIN = 4 -- the [메뉴] squares that must fit beside it on the bar (새 소식 · 이동 · 도움말 · 설정)
local MIN_CENTER = 240 -- logical units: narrowest centre column (the war meter stays >= 240du)
local GAP = 8
-- touch targets never shrink below 60 logical units (~45 real px at the phone's 0.75 UIScale). A scaled down button
-- grows back: the portrait from its top-left corner (the bars beside it give way, the tile row under it moves down), the
-- tiles to MIN_TAP squares (fewer fit the row), the quest lines downwards, the round combat buttons around their centre,
-- the potions upwards and then to the left (both cells: the potions rect holds HP and MP side by side, POTION_GAP apart)
local MIN_TAP = 60
local ROUND_TAPS = { "ghost", "q", "z", "x", "auto", "attack" }
local POTION_GAP = 6 -- real px between the HP and MP buttons on both reference sheets (out.potions.Gap, in du)
HudLayout.PotionGap = POTION_GAP
local TILE_GAP = 3 -- real px: the least gap between two tiles of the icon row (out.tiles.Gap, in du)
local STICK = { X = 0.4, Y = 1 / 3 } -- touch thumbstick zone: x < 0.4 W and y > H / 3
-- desktop: the bottom-centre group (face, power line, bars, XP, tiles) and the corner cluster it must stay clear of
local BC_GROUP = { "portrait", "power_line", "hp_bar", "mp_bar", "xp_bar", "tiles" }
local CLUSTER = { "potions", "ghost", "q", "z", "x", "auto", "attack" }
-- touch: the plate beside the portrait (moves right when the portrait grows back to MIN_TAP)
local PLATE = { "power_line", "hp_bar", "mp_bar", "xp_bar" }
-- [메뉴] fold-out: lines of squares as big as [메뉴], filled from [메뉴] to the left. The first line is [메뉴]'s own (in the
-- top bar, never over Roblox's buttons); more lines go down (A23-38's "위쪽에서만": [메뉴] is the topmost thing now).
-- While open it may run over the centre column's info rows (chips / next event / notify), on phones also over the tile
-- row and the face / bars, but never over the war meter, the minimap, the quest lines, a combat button, the jump button
-- or the thumbstick zone
local FOLD_OVER = { tiles = true, menu = true, chips = true, event = true, notify = true, combo = true }
local FOLD_OVER_TOUCH = { portrait = true, power_line = true, hp_bar = true, mp_bar = true, xp_bar = true }
local FOLD_ROWS = 3
local FOLD_GAP = 4 -- real px between two fold-out squares on PCs

local function rect(x, y, w, h)
	return { X = x, Y = y, W = w, H = h }
end

local function anchorOf(id, touch)
	local def = ITEMS[id]
	if not def then return "TL" end
	return touch and def[4] or def[1]
end
HudLayout.AnchorOf = anchorOf

-- env = { W, H = MainGui size in logical units, Scale = UIScale, Inset = top bar inset (real px), Touch = bool,
--         Jump = { X, Y, W, H } of the touch jump button in logical units or nil, Hidden = { [id] = true },
--         Topbar = { X0, Y0, X1, Y1 } = the free part of the Roblox top bar (GuiService.TopbarInset) in logical units
--         (MainGui space) or nil (then TOPBAR.Left .. W, 0 .. Inset) }
-- returns { [id] = { X, Y, W, H } } in logical units (MainGui space, before UIScale). potions also carries Gap (du between
-- its HP and MP cells: cell width = (W - Gap) / 2); tiles carries Size (square tile side), Gap (least gap) and Count (how
-- many tiles fit the row: the HUD shows that many, the rest go into the [메뉴] tile)
function HudLayout.Compute(env)
	local touch = env.Touch == true
	local ref = touch and REF.Touch or REF.Desktop
	local k = 1 / ref.Scale -- reference px -> logical units
	local s = (type(env.Scale) == "number" and env.Scale > 0) and env.Scale or 1
	local W, H = env.W, env.H
	local top = (tonumber(env.Inset) or ref.Inset) / s -- logical y of the top bar's bottom edge
	local jump = touch and env.Jump or nil
	local hidden = env.Hidden or {}
	-- the Roblox top bar row (logical units): its free part and the button size there (real px -> du, no UIScale)
	local tb = type(env.Topbar) == "table" and env.Topbar or nil
	local bar = {
		X0 = tb and tonumber(tb.X0) or TOPBAR.Left / s,
		Y0 = tb and tonumber(tb.Y0) or 0,
		X1 = tb and tonumber(tb.X1) or W,
		Y1 = tb and tonumber(tb.Y1) or top,
	}
	if not (bar.X1 > bar.X0 and bar.Y1 > bar.Y0) then bar = { X0 = TOPBAR.Left / s, Y0 = 0, X1 = W, Y1 = top } end
	local barPx = (bar.Y1 - bar.Y0) * s
	local btn = math.min(TOPBAR.Button, math.max(1, barPx - 4)) / s
	-- the middle of Roblox's own buttons (they sit TOPBAR.Bottom px above the bar's bottom): ours share it
	local barMid = bar.Y1 - TOPBAR.Bottom / s - btn / 2
	-- touch: a safe area narrower / shorter than the reference phone (notch insets: 749x361 -> 655x340) scales the
	-- whole layout down by the same factor, so the stick zone and the gaps stay free
	if touch then
		k *= math.min(1, W / (ref.W / ref.Scale), H / (ref.H / ref.Scale))
	end
	local rj = touch and ref.Jump or nil -- the approved sheet's jump button (real px)
	local out = {}
	for id, def in ITEMS do
		local r = touch and def[3] or def[2]
		local x, y, w, h = r[1], r[2], r[3] * k, r[4] * k
		local anchor = anchorOf(id, touch)
		if anchor == "BC" and jump then anchor = "BR" end -- touch: the combo line rides with the cluster (never under Q)
		local X, Y
		if anchor == "TL" then
			X, Y = x * k, top + (y - ref.Inset) * k
		elseif anchor == "TR" then
			X, Y = W - (ref.W - x) * k, top + (y - ref.Inset) * k
		elseif anchor == "TC" then
			X, Y = W / 2 + (x - ref.W / 2) * k, top + (y - ref.Inset) * k
		elseif anchor == "TB" then
			-- in the Roblox top bar: centred on its middle, as tall as on the sheet in real px (never taller than a button)
			h = math.min(r[4], TOPBAR.Button, math.max(1, barPx - 4)) / s
			X, Y = W / 2 + (x - ref.W / 2) * k, barMid - h / 2
		elseif anchor == "BC" then
			X, Y = W / 2 + (x - ref.W / 2) * k, H - (ref.H - y) * k
		elseif jump and rj then
			-- BR on touch: keep the approved gaps to the live jump button's edges (Roblox draws it 70 or 120 px, so its
			-- centre alone would put a big button over it): left of it -> gap to its left edge, over it (자동) -> centred;
			-- wholly above it -> gap to its top, else the offset to its middle
			if x >= rj[1] then
				X = jump.X + jump.W / 2 + (x + r[3] / 2 - rj[1] - rj[3] / 2) * k - w / 2
			else
				X = jump.X - (rj[1] - x) * k
			end
			if y + r[4] <= rj[2] then
				Y = jump.Y - (rj[2] - y) * k
			else
				Y = jump.Y + jump.H / 2 + (y - rj[2] - rj[4] / 2) * k
			end
		else -- BR
			X, Y = W - (ref.W - x) * k, H - (ref.H - y) * k
		end
		out[id] = rect(X, Y, w, h)
	end
	out.potions.Gap = POTION_GAP * k
	local tileGap = TILE_GAP * k

	if touch then
		-- portrait: grows from its top-left corner; the plate beside it gives way (same right edge), the tile row moves down
		local p = out.portrait
		if p.W < MIN_TAP then
			local g = MIN_TAP - p.W
			p.W, p.H = MIN_TAP, MIN_TAP
			for _, id in PLATE do
				local r = out[id]
				r.X, r.W = r.X + g, math.max(1, r.W - g)
			end
			out.tiles.Y += g
		end
		-- quest lines: one MIN_TAP target (two text lines), grown downward
		if out.quest.H < MIN_TAP then out.quest.H = MIN_TAP end
		for _, id in ROUND_TAPS do
			local r = out[id]
			if r.W < MIN_TAP then
				r.X, r.Y, r.W, r.H = r.X + r.W / 2 - MIN_TAP / 2, r.Y + r.H / 2 - MIN_TAP / 2, MIN_TAP, MIN_TAP
			end
		end
		-- potions: two cells side by side (HP, MP), each >= MIN_TAP. The rect grows upwards, then to the left with the
		-- same right edge (Q sits right of it), but never into the thumbstick zone or onto an item level with it on the
		-- left; a phone without that room keeps the widest cells it can get (the offline test names it as an exception)
		local pot = out.potions
		if pot.H < MIN_TAP then pot.Y, pot.H = pot.Y + pot.H - MIN_TAP, MIN_TAP end
		local potRight = pot.X + pot.W
		local minX = potRight - (2 * MIN_TAP + pot.Gap)
		if pot.Y + pot.H > H * STICK.Y then minX = math.max(minX, W * STICK.X) end
		for oid, o in out do
			if oid ~= "potions" and not hidden[oid] and o.X + o.W <= pot.X + 0.01 and o.Y < pot.Y + pot.H and o.Y + o.H > pot.Y then
				minX = math.max(minX, o.X + o.W + GAP)
			end
		end
		if minX < pot.X then pot.X, pot.W = minX, potRight - minX end
	end

	-- tile row: square tiles as tall as the row (>= MIN_TAP on touch), Count = how many fit with the least gap
	local tiles = out.tiles
	local size = touch and math.max(tiles.H, MIN_TAP) or tiles.H
	tiles.H = size
	tiles.Size = size
	tiles.Gap = tileGap
	tiles.Count = math.max(1, math.floor((tiles.W + tileGap) / (size + tileGap) + 1e-6))
	-- [메뉴]: a Roblox-button-sized square in the top bar, TOPBAR.Edge px from its free right end, centred on the bar's
	-- middle like Roblox's own buttons (A23-40 보강); on touch never under TOPBAR.Tap real px (= MIN_TAP at the phone's
	-- 0.75 UIScale; on tablets MIN_TAP du would no longer fit the 58 px bar)
	local menu = out.menu
	local mSize = touch and math.max(btn, TOPBAR.Tap / s) or btn
	menu.W, menu.H = mSize, mSize
	menu.X = bar.X1 - TOPBAR.Edge / s - mSize
	menu.Y = barMid - mSize / 2

	-- touch: a round button that reaches up into the plate's tile row steps down under it (short / narrow phones: the plate
	-- hangs from the top, the cluster from the jump button, so the X skill can meet the row; A23-49)
	if touch then
		local rowBottom = tiles.Y + tiles.H + GAP / 2
		for _, id in ROUND_TAPS do
			local r = out[id]
			if r.X < tiles.X + tiles.W and r.X + r.W > tiles.X and r.Y < rowBottom then r.Y = rowBottom end
		end
	end

	-- desktop: the bottom-centre group moves left (keeping its shape) when the corner cluster reaches it, but never past
	-- the left margin; if that is still not enough it is squeezed from its left edge (narrow 4:3 / 5:4 windows)
	if not touch then
		local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
		for _, id in BC_GROUP do
			local r = out[id]
			minX, maxX = math.min(minX, r.X), math.max(maxX, r.X + r.W)
			minY, maxY = math.min(minY, r.Y), math.max(maxY, r.Y + r.H)
		end
		local clusterLeft = math.huge
		for _, id in CLUSTER do
			local r = out[id]
			if not hidden[id] and r.Y < maxY and r.Y + r.H > minY then clusterLeft = math.min(clusterLeft, r.X) end
		end
		local limit = clusterLeft - GAP
		if maxX > limit then
			local shift = math.min(maxX - limit, math.max(0, minX - GAP))
			for _, id in BC_GROUP do out[id].X -= shift end
			minX, maxX = minX - shift, maxX - shift
			if maxX > limit and maxX - minX > 1 then
				local f = math.max(0.5, (limit - minX) / (maxX - minX))
				for _, id in BC_GROUP do
					local r = out[id]
					r.X = minX + (r.X - minX) * f
					if id ~= "portrait" then r.W *= f end
				end
				tiles.Count = math.max(1, math.floor((tiles.W + tileGap) / (size + tileGap) + 1e-6))
			end
		end
	end

	-- centre column (war meter, chips, next event, notify): the rows share one room (the tightest gap between the left
	-- and right items level with any of them) and one centre x, so the column stays straight and never runs under a
	-- neighbour on narrow phones / small windows
	-- In the top bar row the left neighbour is Roblox's own buttons and the right one [메뉴] with room for FOLD_MIN fold
	-- squares beside it (the war meter never takes the fold's first line)
	local leftEdge, rightEdge = 0, W
	local fGapRow = touch and tileGap or FOLD_GAP * k
	for _, id in CENTER do
		local c = out[id]
		for oid, o in out do
			local anchor = anchorOf(oid, touch)
			if not hidden[oid] and anchor ~= "TC" and anchor ~= "BC" and oid ~= "combo" and oid ~= "war_meter"
				and o.Y < c.Y + c.H and o.Y + o.H > c.Y then
				if o.X + o.W / 2 < W / 2 then
					leftEdge = math.max(leftEdge, o.X + o.W + GAP)
				elseif oid == "menu" then
					rightEdge = math.min(rightEdge, o.X - FOLD_MIN * (o.W + fGapRow) - GAP)
				else
					rightEdge = math.min(rightEdge, o.X - GAP)
				end
			end
		end
		if c.Y < bar.Y1 and c.Y + c.H > bar.Y0 then leftEdge = math.max(leftEdge, bar.X0 + GAP) end
	end
	local room, widest = rightEdge - leftEdge, 0
	for _, id in CENTER do
		local r = out[id]
		local w = math.max(math.min(r.W, room), math.min(MIN_CENTER, r.W))
		r.W = w
		widest = math.max(widest, w)
	end
	local cx = math.clamp(W / 2, leftEdge + widest / 2, math.max(leftEdge + widest / 2, rightEdge - widest / 2))
	for _, id in CENTER do
		local r = out[id]
		r.X = cx - r.W / 2
	end

	-- everything stays on screen and below the top bar (big tablets / very short windows); the top bar items stay in it
	for id, r in out do
		r.X = math.clamp(r.X, 0, math.max(0, W - r.W))
		if anchorOf(id, touch) == "TB" then
			r.Y = math.clamp(r.Y, bar.Y0, math.max(bar.Y0, bar.Y1 - r.H))
		else
			r.Y = math.clamp(r.Y, top, math.max(top, H - r.H))
		end
	end

	-- [메뉴] fold-out room: Lines = { { X, Y, Cols } } right-aligned one gap left of [메뉴]; each line reaches left to the
	-- nearest item it may not cover (an item level with it that reaches under [메뉴] leaves no room: the line closes). X / Y / W / H = the box
	-- around all lines, Cols = the first line's squares, Rows = #Lines
	local m = out.menu
	local fGap = touch and tileGap or FOLD_GAP * k -- phones: the tile row's gap (the first line lies on that row)
	local fSize = m.H
	local right = m.X - fGap
	local blockers = {}
	for oid, o in out do
		if not hidden[oid] and not FOLD_OVER[oid] and not (touch and FOLD_OVER_TOUCH[oid]) then table.insert(blockers, o) end
	end
	table.insert(blockers, rect(0, bar.Y0, bar.X0, bar.Y1 - bar.Y0)) -- Roblox's own top bar buttons
	if touch then
		table.insert(blockers, rect(0, H * STICK.Y, W * STICK.X, H - H * STICK.Y))
		if jump then table.insert(blockers, jump) end
	end
	local function colsAt(y0)
		local left = 0
		for _, o in blockers do
			if o.Y < y0 + fSize and o.Y + o.H > y0 and o.X < m.X - 0.01 then
				left = math.max(left, o.X + o.W + GAP)
			end
		end
		return math.max(0, math.floor((right - left + fGap) / (fSize + fGap) + 1e-6))
	end
	-- the first line on [메뉴]'s own (top bar) line, the next ones from just under the bar down
	local lines = {}
	local y, step = m.Y, fSize + fGap
	local x0, y0, y1 = right, math.huge, -math.huge
	while #lines < FOLD_ROWS and y >= math.min(top, bar.Y0) - 0.01 and y + fSize <= H + 0.01 do
		local cols = colsAt(y)
		if cols < 1 then break end
		local lx = right - cols * (fSize + fGap) + fGap
		table.insert(lines, { X = lx, Y = y, Cols = cols })
		x0, y0, y1 = math.min(x0, lx), math.min(y0, y), math.max(y1, y + fSize)
		y = math.max(y + step, top + fGap)
	end
	if #lines == 0 then -- no room at all (a tiny window): one square over [메뉴]'s left neighbour
		lines[1] = { X = right - fSize, Y = m.Y, Cols = 1 }
		x0, y0, y1 = right - fSize, m.Y, m.Y + fSize
	end
	out.fold = { X = x0, Y = y0, W = right - x0, H = y1 - y0, Size = fSize, Gap = fGap, Cols = lines[1].Cols,
		Rows = #lines, Lines = lines }
	return out
end

function HudLayout.Init() end
function HudLayout.Start() end

return HudLayout
]]></ProtectedString>
					<string name="ScriptGuid">{AFA22E7A-1ADE-43A5-B128-886E21366AB2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">HudLayout</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c99063480b229a50ad663aa000008bb</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX36130CDB5A94451C82157BF304ED9ADF">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MiniMap.luau : the live minimap in the HUD's top-left slot (SPEC_ADDENDUM A23-26 "실시간 지도").
-- Only my surroundings are shown (the whole world stays in WorldMap, A12). A23-51 (user 2026-10-06 "지도도 사용자가 가는
-- 방향으로 회전해야 돼"): the map turns so the way my CHARACTER faces is up (eased every frame, never a jump), my arrow
-- (MapPlayerArrow art in my faction colour) always points up in the middle, the 'N' rides the ring toward north. Marks:
-- me, other players (faction colour dots), the quest target (★ inside the view, a ▲ chevron on the edge outside it), the potion
-- merchant and the blacksmith anvil, and nearby monsters (small dots). Presentation only: no buttons and every instance
-- is Active = false, so on phones the box (inside the thumbstick zone) never sinks a touch.
-- Drawing: Config lands / zones / roads / bridges as axis-aligned Frames on one big canvas (Scale positions, like
-- WorldMap) inside a clipping view; per tick only the canvas moves. The box is C.HUD.Layout.Rects.minimap (logical
-- MainGui units), read again by MiniMap.Relayout (HUD calls it after each layout pass; also on viewport changes and
-- once a second). Rates: one Heartbeat with accumulators (move 20 Hz, scan + visibility 5 Hz, landmarks + layout 1 Hz).
--
-- Public API: MiniMap.Init(C), MiniMap.Start(), MiniMap.Relayout(), MiniMap.IsShown()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local LocalPlayer = Players.LocalPlayer

local MiniMap = {}

local TAG = "MiniMap"
local C = nil -- client registry (set in Init)
local UIKit = nil -- C.UIKit (set in Start)

----------------------------------------------------------------- tuning (du = logical MainGui units; studs)
local IS_TOUCH = UserInputService.TouchEnabled
local T = {
	Radius = IS_TOUCH and 80 or 110, -- studs from me to the view edge (px per stud = view width / (2 * Radius))
	Margin = 1.05, -- players / monsters inside the view box + 5% get a dot (the view clips the rest)
	MoveDt = 1 / 15, -- canvas, map turn, quest marker (user 2026-10-06: <= 15 Hz)
	ScanDt = 1 / 5, -- visibility, players, monsters, quest target
	-- A23-51: the map turns with my character's facing (up = where it faces), the 'N' rides the ring; my arrow stays up
	HeadingUp = true,
	TurnEase = 8, -- 1/s: the map eases toward the character's facing every frame (smooth, no jump on a quick turn)
	TurnMin = 0.3, -- degrees: smaller turns are not written (no CanvasGroup re-render while standing still)
	MeSize = IS_TOUCH and 20 or 22, -- du: my arrow (user 2026-10-06 "너무 커": ~15-18 px; still bigger than a monster dot)
	MeArt = "MapPlayerArrow", -- white art with a navy rim: ImageColor3 = my faction colour, up = forward
	NorthR = 0.435, -- 'N' marker: distance from the centre / side (on the ring's navy band)
	NorthD = 0.13, -- 'N' marker disc / side
	NorthPx = 17, -- ...but never under this many real px
	StrongDot = 8, -- big monsters (Scale >= StrongScale): a bigger dot with a dark rim
	StrongScale = 1.4,
	BossIcon = IS_TOUCH and 18 or 20, -- event bosses (MonsterTypes Boss): their IconMon<Kind> head
	SlowDt = 1, -- merchant / anvil, relayout
	MinMove = 0.25, -- du: smaller canvas / chevron moves are not written
	MinTurn = 1, -- degrees: smaller arrow turns are not written
	-- A23-40 layout B: a round map. Config.UIArt.Parts key MinimapRing (Firefly 83eaffb: navy ring + gold rims, the hole
	-- d386 of 512 at the centre); the view is a circle clipped by a CanvasGroup
	ArtKey = "MinimapRing",
	-- hole of the approved ring while the part has no Inner (63 .. 449 of 512)
	ArtInner = { 63 / 512, 63 / 512, 386 / 512, 386 / 512 },
	Bleed = 2, -- du the view reaches under the art rim (no seam along the hole's soft edge)
	Inset = IS_TOUCH and 4 or 6, -- view inset inside the code-drawn frame
	Corner = 12, -- code-drawn frame corner (like the other HUD panels)
	Arrow = IS_TOUCH and 16 or 18, -- >= 15 du on phones: MinTextSize 11 px at UIScale 0.75
	Star = IS_TOUCH and 15 or 16,
	Icon = IS_TOUCH and 14 or 16, -- potion merchant / anvil icons
	-- players vs monsters: Horns red is close to the monster red, so the size gap (and the players' outline) tells them apart
	PlayerDot = 9,
	MonsterDot = 5,
	BossDot = 10,
	MaxPlayers = 19,
	MaxMonsters = 30,
	WorldPad = 12, -- studs of sea around the drawn world (WorldMap WORLD_PAD)
	Shallow = 16, -- studs of lighter water around each land (WorldMap SHALLOW)
	PassCorridor = 20, -- road corridor |z| < 20 through the mountain pass (A10)
	ExtremeLevel = 25, -- PvP zones from this level use the extreme colour (WorldMap / MapBuilder)
	WarnEvery = 10, -- seconds between warnings
}

----------------------------------------------------------------- colours (WorldMap terrain palette, ART_DIRECTION 2.1 / 2.4)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local COL = {
	SeaTop = Color3.fromRGB(52, 112, 158),
	SeaBottom = Color3.fromRGB(22, 56, 96),
	Shallow = Color3.fromRGB(110, 175, 205),
	Land = Color3.fromRGB(104, 142, 82),
	LandDark = Color3.fromRGB(78, 58, 60), -- Horns island basalt
	Coast = Color3.fromRGB(222, 204, 150),
	Road = Color3.fromRGB(226, 205, 150),
	Bridge = Color3.fromRGB(150, 108, 66),
	BridgeEdge = Color3.fromRGB(70, 48, 30),
	Rock = Color3.fromRGB(112, 100, 92),
	Safe = Color3.fromRGB(80, 220, 120),
	PvP = Color3.fromRGB(255, 150, 40),
	Extreme = Color3.fromRGB(255, 60, 60),
	-- marks (Theme values copied in at build)
	Monster = Color3.fromRGB(255, 80, 80),
	Golden = Color3.fromRGB(255, 200, 30),
	Quest = Color3.fromRGB(255, 210, 60),
	-- my arrow by faction (A23-51: 빛 금 · 뿔 빨강 · 장인 청록; nobody yet: white)
	MeHalo = Color3.fromRGB(252, 198, 52),
	MeHorns = Color3.fromRGB(243, 38, 44),
	MeNeutral = Color3.fromRGB(40, 200, 190),
	Potion = Color3.fromRGB(80, 220, 120), -- dot only when the potion icon art is missing
	Smith = Color3.fromRGB(40, 200, 190), -- dot only when the sword icon art is missing (장인 길드 teal)
}

----------------------------------------------------------------- text (glyphs only; Util.GlyphSafe symbols)
local TXT = {
	Me = "▲", -- my arrow (points up at Rotation 0 = map up); always white, so it never looks like the gold chevron
	Quest = "★", -- quest target inside the view (fallback when the marker diamond art is missing)
	Edge = "▲", -- quest target outside: chevron on the view edge, turned toward it
	North = "N", -- the north marker on the ring
}

----------------------------------------------------------------- state
-- drawn world rect (studs) and the Config pieces drawn on the canvas (prepareData)
local W = { MinX = -200, MaxX = 200, MinZ = -200, MaxZ = 200, Wd = 400, Ht = 400, Lands = {}, Zones = {}, Roads = {},
	Bridges = {}, PassX = nil }
local S = {
	built = false,
	shown = false,
	isArt = false,
	inner = nil, -- { x, y, w, h } scale of the art hole (UIKit.ArtInner)
	rectOk = false,
	rx = nil, ry = nil, side = nil, -- last applied box (du)
	lastTry = -math.huge, -- last relayout attempt while the rect was missing
	pps = 1, -- du per stud
	cx = 0, cy = 0, -- view centre (du, view space)
	halfX = 1, halfY = 1, -- half the visible hole (du)
	rangeX = 1, rangeZ = 1, -- studs from me that get a dot
	x = nil, z = nil, -- my last position
	ox = nil, oy = nil, -- last written canvas offset
	chevX = nil, chevY = nil, -- last written chevron offset
	questPos = nil,
	smithPos = nil, -- last seen anvil
	camConn = nil,
	lastWarnAt = -math.huge,
}
local ui = {} -- root, view, canvas, rim, me, star, chev, potion, smith
local pool = { players = {}, monsters = {}, bosses = {} }
local acc = { Move = 0, Scan = 0, Slow = 0 }

----------------------------------------------------------------- helpers
local function warnThrottled(msg)
	local now = os.clock()
	if now - S.lastWarnAt < T.WarnEvery then return end
	S.lastWarnAt = now
	Util.Warn(TAG, msg)
end

local function guard(fn, what)
	local ok, err = pcall(fn)
	if not ok then warnThrottled(what .. " error: " .. tostring(err)) end
end

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return default
end

local function setVisible(inst, visible)
	if inst and inst.Visible ~= visible then inst.Visible = visible end
end

local function moduleOpen(name)
	local m = C and C[name]
	if type(m) ~= "table" or type(m.IsOpen) ~= "function" then return false end
	local ok, open = pcall(m.IsOpen)
	return ok and open == true
end

local function instPos(inst)
	if typeof(inst) ~= "Instance" then return nil end
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then
		if inst.PrimaryPart then return inst.PrimaryPart.Position end
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and typeof(cf) == "CFrame" then return cf.Position end
	end
	return nil
end

-- canvas position of a world point (Scale, so a relayout only resizes the canvas)
local function toScale(pos)
	return UDim2.fromScale((pos.X - W.MinX) / W.Wd, (pos.Z - W.MinZ) / W.Ht)
end

local function factionColor(faction, none)
	local theme = UIKit and UIKit.Theme
	if type(theme) == "table" and (faction == "Halo" or faction == "Horns" or faction == "Neutral") then
		local c = theme[faction]
		if typeof(c) == "Color3" then return c end
	end
	return none
end

local function dangerColor(z)
	if not z.PvP then return COL.Safe end
	if z.MinLevel >= T.ExtremeLevel then return COL.Extreme end
	return COL.PvP
end

local function myPose()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then return hrp.Position, hrp.CFrame.LookVector end
	local cam = workspace.CurrentCamera
	if cam then return cam.Focus.Position, cam.CFrame.LookVector end
	return nil, nil
end

----------------------------------------------------------------- world data (Config -> drawable lists, WorldMap prepareData)
local function readRects(list)
	local out = {}
	if type(list) ~= "table" then return out end
	for _, l in list do
		if type(l) == "table" then
			local a, b, c, d = num(l.MinX), num(l.MaxX), num(l.MinZ), num(l.MaxZ)
			if a and b and c and d and b > a and d > c then
				table.insert(out, { Name = tostring(l.Name or ""), MinX = a, MaxX = b, MinZ = c, MaxZ = d })
			end
		end
	end
	return out
end

local function prepareData()
	local map = type(Config.Map) == "table" and Config.Map or {}
	W.Lands = readRects(map.Lands)
	W.Roads = readRects(map.Roads) -- the strips preview_map builds as Decor.Roads (CR-L46)
	W.PassX = num(map.PassX)
	W.Bridges = {}
	for _, br in (type(map.Bridges) == "table" and map.Bridges or {}) do
		if type(br) == "table" and typeof(br.From) == "Vector3" and typeof(br.To) == "Vector3" then
			table.insert(W.Bridges, { Name = tostring(br.Name or ""), From = br.From, To = br.To,
				Width = math.max(4, num(br.Width, 18)) })
		end
	end
	W.Zones = {}
	local zones = type(Config.Zones) == "table" and Config.Zones or {}
	for _, id in (type(Config.ZoneOrder) == "table" and Config.ZoneOrder or {}) do
		local z = zones[id]
		if type(z) == "table" and typeof(z.Center) == "Vector3" and typeof(z.Size) == "Vector3" then
			table.insert(W.Zones, {
				Id = tostring(id),
				Center = z.Center,
				Size = z.Size,
				PvP = z.PvP == true,
				MinLevel = math.floor(num(z.MinLevel, 1)),
				FloorColor = typeof(z.FloorColor) == "Color3" and z.FloorColor or COL.Land,
			})
		end
	end

	-- drawn world = Bounds united with every land and zone, plus a little sea
	local b = type(map.Bounds) == "table" and map.Bounds or {}
	local minX, maxX = num(b.MinX, math.huge), num(b.MaxX, -math.huge)
	local minZ, maxZ = num(b.MinZ, math.huge), num(b.MaxZ, -math.huge)
	for _, l in W.Lands do
		minX, maxX = math.min(minX, l.MinX), math.max(maxX, l.MaxX)
		minZ, maxZ = math.min(minZ, l.MinZ), math.max(maxZ, l.MaxZ)
	end
	for _, z in W.Zones do
		minX, maxX = math.min(minX, z.Center.X - z.Size.X / 2), math.max(maxX, z.Center.X + z.Size.X / 2)
		minZ, maxZ = math.min(minZ, z.Center.Z - z.Size.Z / 2), math.max(maxZ, z.Center.Z + z.Size.Z / 2)
	end
	if not (maxX > minX and maxZ > minZ) then minX, maxX, minZ, maxZ = -200, 200, -200, 200 end
	W.MinX, W.MaxX = minX - T.WorldPad, maxX + T.WorldPad
	W.MinZ, W.MaxZ = minZ - T.WorldPad, maxZ + T.WorldPad
	W.Wd = math.max(1, W.MaxX - W.MinX)
	W.Ht = math.max(1, W.MaxZ - W.MinZ)
end

----------------------------------------------------------------- drawing (canvas children use Scale positions)
local function corner(scale, offset)
	return UIKit.Create("UICorner", { CornerRadius = UDim.new(scale or 0, offset or 0) })
end

local function stroke(color, thickness, transparency)
	return UIKit.Create("UIStroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function rect(minX, maxX, minZ, maxZ, props, children)
	props.Position = UDim2.fromScale((minX - W.MinX) / W.Wd, (minZ - W.MinZ) / W.Ht)
	props.Size = UDim2.fromScale((maxX - minX) / W.Wd, (maxZ - minZ) / W.Ht)
	props.Active = false
	props.Parent = ui.canvas
	return UIKit.Create("Frame", props, children)
end

-- round dot (never a text glyph); outlined = dark rim for the player dots / icon stand-ins
local function newDot(name, size, color, zIndex, outlined)
	local kids = { corner(0.5, 0) }
	if outlined then table.insert(kids, stroke(BLACK, 1.5, 0.2)) end
	return UIKit.Create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		ZIndex = zIndex,
		Active = false,
		Visible = false,
		Parent = ui.canvas,
	}, kids)
end

-- glyph mark (LightText: white-or-colour text with the dark HUD outline)
local function textMark(name, text, size, color, zIndex, parent)
	return UIKit.LightText({
		Name = name,
		Text = text,
		TextSize = size,
		Color = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		ZIndex = zIndex,
		Active = false,
		Visible = false,
		Parent = parent,
	})
end

-- approved item icon on the canvas, or a coloured dot while the art is missing (IMG-R4)
local function npcMark(name, artKey, color)
	local icon = UIKit.ArtImage(artKey, {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(T.Icon, T.Icon),
		ZIndex = 6,
		Active = false,
		Visible = false,
		Parent = ui.canvas,
	})
	return icon or newDot(name, math.floor(T.Icon * 0.6), color, 6, true)
end

local function drawWorld()
	-- shallow water rings, then lands (rivers and sea are the gaps between them)
	for _, l in W.Lands do
		rect(l.MinX - T.Shallow, l.MaxX + T.Shallow, l.MinZ - T.Shallow, l.MaxZ + T.Shallow, {
			Name = "Shallow_" .. l.Name,
			BackgroundColor3 = COL.Shallow,
			BackgroundTransparency = 0.6,
			ZIndex = 1,
		}, { corner(0.14, 0) })
	end
	for _, l in W.Lands do
		local dark = string.find(l.Name, "Horns", 1, true) ~= nil
		rect(l.MinX, l.MaxX, l.MinZ, l.MaxZ, {
			Name = "Land_" .. l.Name,
			BackgroundColor3 = dark and COL.LandDark or COL.Land,
			ZIndex = 2,
		}, { corner(0.07, 0), stroke(COL.Coast, 1.5, 0.2) })
	end
	-- zones: floor colour + danger-colour border (ART_DIRECTION 2.4)
	for _, z in W.Zones do
		local hx, hz = z.Size.X / 2, z.Size.Z / 2
		rect(z.Center.X - hx, z.Center.X + hx, z.Center.Z - hz, z.Center.Z + hz, {
			Name = "Zone_" .. z.Id,
			BackgroundColor3 = z.FloorColor,
			BackgroundTransparency = 0.3,
			ZIndex = 3,
		}, { corner(0.08, 0), stroke(dangerColor(z), 2, 0.05) })
	end
	for i, r in W.Roads do
		rect(r.MinX, r.MaxX, r.MinZ, r.MaxZ, {
			Name = "Road" .. i,
			BackgroundColor3 = COL.Road,
			BackgroundTransparency = 0.15,
			ZIndex = 4,
		}, { corner(0.5, 0) })
	end
	-- mountain pass ridges (north and south of the road corridor)
	local px = W.PassX
	if px then
		for _, l in W.Lands do
			if px > l.MinX and px < l.MaxX and l.MinZ < -T.PassCorridor and l.MaxZ > T.PassCorridor then
				for _, span in { { l.MinZ + 6, -T.PassCorridor }, { T.PassCorridor, l.MaxZ - 6 } } do
					if span[2] - span[1] >= 4 then
						rect(px - 14, px + 14, span[1], span[2], {
							Name = "PassRidge",
							BackgroundColor3 = COL.Rock,
							ZIndex = 5,
						}, { corner(0.5, 0), stroke(BLACK, 1, 0.6) })
					end
				end
				break
			end
		end
	end
	-- bridges: axis-aligned only (a diagonal one would need a rotated Frame; none in Config v3)
	for i, br in W.Bridges do
		local f, t, w = br.From, br.To, br.Width
		local name = "Bridge_" .. (br.Name ~= "" and br.Name or tostring(i))
		local minX, maxX, minZ, maxZ = nil, nil, nil, nil
		if math.abs(t.Z - f.Z) < 0.5 then
			minX, maxX, minZ, maxZ = math.min(f.X, t.X), math.max(f.X, t.X), f.Z - w / 2, f.Z + w / 2
		elseif math.abs(t.X - f.X) < 0.5 then
			minX, maxX, minZ, maxZ = f.X - w / 2, f.X + w / 2, math.min(f.Z, t.Z), math.max(f.Z, t.Z)
		end
		if minX then
			rect(minX, maxX, minZ, maxZ, { Name = name, BackgroundColor3 = COL.Bridge, ZIndex = 5 },
				{ corner(0, 2), stroke(COL.BridgeEdge, 1, 0.1) })
		end
	end
end

local function build()
	UIKit = C and C.UIKit
	assert(type(UIKit) == "table" and UIKit.Gui, "UIKit is not initialized")
	local theme = UIKit.Theme
	local artCol = type(UIKit.ArtColors) == "table" and UIKit.ArtColors or {}
	if typeof(theme.Bad) == "Color3" then COL.Monster = theme.Bad end
	if typeof(theme.Gold) == "Color3" then COL.Quest = theme.Gold end
	if typeof(theme.Good) == "Color3" then COL.Potion = theme.Good end
	if typeof(theme.Neutral) == "Color3" then COL.Smith = theme.Neutral end
	local mc = type(Config.Monsters) == "table" and Config.Monsters or {}
	if typeof(mc.GoldenColor) == "Color3" then COL.Golden = mc.GoldenColor end

	-- frame: the approved MinimapRing art, else a navy disc with a gold rim (IMG-R4)
	local root, isArt = UIKit.ArtFrame(T.ArtKey, {
		Name = "MiniMap",
		Size = UDim2.fromOffset(100, 100), -- real box from Relayout
		ZIndex = 4,
		Active = false,
		Visible = false,
	}, {
		BackgroundColor3 = typeof(artCol.NavyDeep) == "Color3" and artCol.NavyDeep or theme.Bg,
		BackgroundTransparency = 0.04,
		CornerRadius = UDim.new(0.5, 0),
		StrokeColor = typeof(artCol.Gold) == "Color3" and artCol.Gold or theme.Gold,
		StrokeThickness = 2,
		StrokeTransparency = 0,
	})
	ui.root = root
	S.isArt = isArt == true
	if S.isArt then
		local ip, is = UIKit.ArtInner(T.ArtKey)
		if typeof(ip) == "UDim2" and typeof(is) == "UDim2" then
			S.inner = { ip.X.Scale, ip.Y.Scale, is.X.Scale, is.Y.Scale }
		end
	end
	pcall(function()
		root.Interactable = false -- never takes input (thumbstick zone on phones)
	end)

	-- view: a circle (CanvasGroup + UICorner clips the canvas round; a plain Frame would clip to its square) over the sea
	-- gradient (like WorldMap's map background; a gradient on the group itself would tint every mark, so it has its own
	-- frame)
	ui.view = UIKit.Create("CanvasGroup", {
		Name = "View",
		BackgroundTransparency = 1,
		ZIndex = 1,
		Active = false,
		Parent = root,
	}, {
		corner(0.5, 0),
	})
	UIKit.Create("Frame", {
		Name = "Sea",
		BackgroundColor3 = WHITE, -- tinted by the gradient
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Active = false,
		Parent = ui.view,
	}, {
		UIKit.Create("UIGradient", { Color = ColorSequence.new(COL.SeaTop, COL.SeaBottom), Rotation = 90 }),
	})
	-- the map turns with the camera (T.HeadingUp): "Rot" covers the view, so its centre (= my spot) is the pivot; the
	-- sea stays still under it, the CanvasGroup still clips everything round
	ui.rot = UIKit.Create("Frame", {
		Name = "Rot",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Active = false,
		Parent = ui.view,
	})
	ui.canvas = UIKit.Create("Frame", {
		Name = "Canvas",
		BackgroundTransparency = 1,
		ZIndex = 1,
		Active = false,
		Parent = ui.rot,
	})
	local okWorld, errWorld = pcall(drawWorld)
	if not okWorld then Util.Warn(TAG, "world drawing failed: " .. tostring(errWorld)) end

	-- art frame: the rim is drawn above the view (the holder image itself stays invisible, so the soft edge is not doubled)
	if S.isArt then
		root.ImageTransparency = 1
		ui.rim = UIKit.ArtImage(T.ArtKey, {
			Name = "Rim",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			Active = false,
			Parent = root,
		})
		if not ui.rim then root.ImageTransparency = 0 end
	end

	-- marks: landmarks (6) < monsters (7) < players (8) < quest diamond (9) on the canvas; chevron and my arrow above it.
	-- Icons on the turning canvas are kept upright (S.upright, counter-turned in moveStep)
	ui.potion = npcMark("PotionMerchant", "IconPotionHP", COL.Potion)
	ui.smith = npcMark("Blacksmith", "IconSword", COL.Smith)
	-- A23-36: the quest target is the marker diamond (IconQuestMarker, tinted), the edge chevron its arrow art
	ui.star = UIKit.ArtImage("IconQuestMarker", {
		Name = "Quest", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(T.Star, T.Star),
		ImageColor3 = COL.Quest, ZIndex = 9, Active = false, Visible = false, Parent = ui.canvas,
	}) or textMark("Quest", TXT.Quest, T.Star, COL.Quest, 9, ui.canvas)
	ui.chev = UIKit.ArtImage("IconQuestMarkerArrow", {
		Name = "QuestEdge", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(T.Star, T.Star),
		ImageColor3 = COL.Quest, ZIndex = 2, Active = false, Visible = false, Parent = ui.view,
	}) or textMark("QuestEdge", TXT.Edge, T.Star, COL.Quest, 2, ui.view)
	-- A23-51: my arrow art in the middle, always up (the map turns under it); the "▲" text when the art is missing
	ui.me = UIKit.ArtImage(T.MeArt, {
		Name = "Me", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(T.MeSize, T.MeSize), ZIndex = 3, Active = false, Parent = ui.view,
	}) or textMark("Me", TXT.Me, T.Arrow, theme.Text, 3, ui.view)
	ui.me.Visible = true
	S.meArt = ui.me:IsA("ImageLabel")
	MiniMap.PaintMe()
	S.upright = { ui.potion, ui.smith, ui.star }
	-- 'N': a small navy disc with a white N riding the ring toward north (above the rim art)
	if T.HeadingUp then
		ui.north = UIKit.Create("Frame", {
			Name = "North",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = typeof(artCol.Navy) == "Color3" and artCol.Navy or theme.Bg,
			Size = UDim2.fromOffset(16, 16),
			ZIndex = 5,
			Active = false,
			Parent = root,
		}, {
			corner(0.5, 0),
			stroke(typeof(artCol.Gold) == "Color3" and artCol.Gold or theme.Gold, 1.5, 0),
		})
		local n = UIKit.LightText({
			Name = "N", Text = TXT.North, TextScaled = true, Size = UDim2.fromScale(0.9, 0.9),
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), ZIndex = 6, Active = false,
			Parent = ui.north,
		})
		if type(UIKit.StyleText) == "function" then UIKit.StyleText(n, "NameTag") end
	end

	root.Parent = UIKit.Gui
	S.built = true
end

----------------------------------------------------------------- layout (C.HUD.Layout.Rects.minimap)
local function readRect()
	local hud = C and C.HUD
	local layout = type(hud) == "table" and hud.Layout or nil -- a new table every HUD layout pass: never cached
	local rects = type(layout) == "table" and layout.Rects or nil
	local r = type(rects) == "table" and rects.minimap or nil
	if type(r) ~= "table" then return nil end
	local x, y, w, h = num(r.X), num(r.Y), num(r.W), num(r.H)
	if not (x and y and w and h) or w < 16 or h < 16 then return nil end
	return x, y, w, h
end

local function relayout()
	if not ui.root then return end
	local x, y, w, h = readRect()
	if not (x and y and w and h) then
		S.rectOk, S.rx = false, nil
		S.shown = false
		setVisible(ui.root, false)
		return
	end
	S.rectOk = true
	local side = math.floor(math.min(w, h) + 0.5) -- square: the art frame is drawn with Fit
	x, y = math.floor(x + 0.5), math.floor(y + 0.5)
	if x == S.rx and y == S.ry and side == S.side then return end
	S.rx, S.ry, S.side = x, y, side
	ui.root.Position = UDim2.fromOffset(x, y)
	ui.root.Size = UDim2.fromOffset(side, side)

	-- the visible hole (du, root space); the art view bleeds a little under the rim
	local hx, hy, hw, hh
	if S.isArt then
		local r = S.inner or T.ArtInner
		hx, hy, hw, hh = r[1] * side, r[2] * side, r[3] * side, r[4] * side
	else
		hx, hy, hw, hh = T.Inset, T.Inset, side - 2 * T.Inset, side - 2 * T.Inset
	end
	hw, hh = math.max(4, hw), math.max(4, hh)
	local bleed = S.isArt and T.Bleed or 0
	ui.view.Position = UDim2.fromOffset(hx - bleed, hy - bleed)
	ui.view.Size = UDim2.fromOffset(hw + 2 * bleed, hh + 2 * bleed)
	S.cx, S.cy = hw / 2 + bleed, hh / 2 + bleed
	S.halfX, S.halfY = hw / 2, hh / 2
	S.pps = math.max(0.01, math.min(hw, hh) / (2 * T.Radius))
	S.rangeX, S.rangeZ = S.halfX / S.pps * T.Margin, S.halfY / S.pps * T.Margin
	ui.canvas.Size = UDim2.fromOffset(W.Wd * S.pps, W.Ht * S.pps)
	S.ox, S.chevX = nil, nil -- the next move tick writes the canvas / chevron again
	if ui.north then
		-- at least NorthPx real px: the 'N' (text floor 12 px) has to fit (UiSandbox 2026-10-06: an 11 px disc on phones
		-- showed no letter)
		local gui = UIKit and UIKit.Gui
		local sc = gui and gui:FindFirstChildOfClass("UIScale")
		local s = (sc and sc.Scale > 0) and sc.Scale or 1
		local d = math.max(math.ceil(T.NorthPx / s), math.floor(side * T.NorthD + 0.5))
		ui.north.Size = UDim2.fromOffset(d, d)
		S.northR = side * T.NorthR
		S.heading = nil -- the next move tick turns the map and places the N again
	end
end

----------------------------------------------------------------- live updates
local function questTarget()
	local hud = C and C.HUD
	if type(hud) ~= "table" or type(hud.GuideTarget) ~= "function" then return nil end
	local ok, p = pcall(hud.GuideTarget)
	if not ok then return nil end
	if typeof(p) == "Vector3" then return p end
	if typeof(p) == "CFrame" then return p.Position end
	return instPos(p)
end

local function merchantPos()
	local vit = type(Config.Vitals) == "table" and Config.Vitals or {}
	if vit.MerchantEnabled ~= true then return nil end -- MapBuilder builds the NPC only then
	local map = workspace:FindFirstChild("Map")
	local npcs = map and map:FindFirstChild("NPCs")
	local name = vit.PotionMerchantName
	local p = instPos(npcs and type(name) == "string" and npcs:FindFirstChild(name) or nil)
	if p then return p end
	-- the NPC is built after MapBuilder.Build returns: same spot as MapBuilder (Crossroads spawn + offset)
	local off = vit.PotionMerchantOffset
	local cross = type(Config.Zones) == "table" and Config.Zones.Crossroads or nil
	if type(off) == "table" and num(off.X) and num(off.Z) and type(cross) == "table" and typeof(cross.Spawn) == "Vector3" then
		return cross.Spawn + Vector3.new(off.X, 0, off.Z)
	end
	return nil
end

local function anvilPos()
	local map = workspace:FindFirstChild("Map")
	local lm = map and map:FindFirstChild("Landmarks")
	local guild = lm and lm:FindFirstChild("ArtisanGuild")
	local anvil = guild and guild:FindFirstChild("Anvil")
	if anvil and anvil:IsA("BasePart") then return anvil.Position end
	return nil
end

local function placeDot(dot, pos, color, size)
	dot.Position = toScale(pos)
	if dot.BackgroundColor3 ~= color then dot.BackgroundColor3 = color end
	if dot.Size.X.Offset ~= size then dot.Size = UDim2.fromOffset(size, size) end
	if not dot.Visible then dot.Visible = true end
end

local function hideRest(list, used)
	for i = used + 1, #list do
		setVisible(list[i], false)
	end
end

local function scanPlayers(x, z)
	local used = 0
	for _, p in Players:GetPlayers() do
		if used >= T.MaxPlayers then break end
		if p ~= LocalPlayer then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and hrp and hrp:IsA("BasePart") then
				local pos = hrp.Position
				if math.abs(pos.X - x) <= S.rangeX and math.abs(pos.Z - z) <= S.rangeZ then
					used += 1
					local dot = pool.players[used]
					if not dot then
						dot = newDot("Player" .. used, T.PlayerDot, COL.Quest, 8, true)
						pool.players[used] = dot
					end
					placeDot(dot, pos, factionColor(p:GetAttribute("Faction"), UIKit.Theme.SubText), T.PlayerDot)
				end
			end
		end
	end
	hideRest(pool.players, used)
end

local function byDistance(a, b)
	return a[2] < b[2]
end

local function scanMonsters(x, z)
	local folder = workspace:FindFirstChild("Monsters")
	local list = {}
	if folder then
		local me = LocalPlayer.UserId
		local types = type(Config.MonsterTypes) == "table" and Config.MonsterTypes or {}
		for _, m in folder:GetChildren() do
			if m:IsA("Model") then
				local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
				-- anchored root = dying / leaving (MonsterService deathPop); owned spawns of other players stay hidden
				if root and root:IsA("BasePart") and not root.Anchored and m:GetAttribute("Leaving") ~= true then
					local owner = m:GetAttribute("OwnerUserId")
					if owner == nil or owner == me then
						local pos = root.Position
						local dx, dz = pos.X - x, pos.Z - z
						if math.abs(dx) <= S.rangeX and math.abs(dz) <= S.rangeZ then
							local def = types[m:GetAttribute("MonsterKind")]
							local kind = m:GetAttribute("MonsterKind")
							table.insert(list, { pos, dx * dx + dz * dz, m:GetAttribute("Golden") == true,
								type(def) == "table" and def.Boss == true,
								type(def) == "table" and (tonumber(def.Scale) or 1) >= T.StrongScale, kind })
						end
					end
				end
			end
		end
	end
	if #list > T.MaxMonsters then table.sort(list, byDistance) end
	local used = math.min(#list, T.MaxMonsters)
	-- user 2026-10-06: normal monsters = small red dots, big ones (Scale >= StrongScale) = bigger dots with a dark rim,
	-- event bosses (MonsterTypes Boss, e.g. the Pumpkin King) = their head icon (IconMon<Kind>, kept upright)
	local usedDots, usedBoss = 0, 0
	for i = 1, used do
		local e = list[i]
		local bossKey = e[4] and ("IconMon" .. tostring(e[6])) or nil
		local bossId = bossKey and UIKit.ArtId(bossKey) or nil
		if bossId then
			usedBoss += 1
			local icon = pool.bosses[usedBoss]
			if not icon then
				icon = UIKit.ArtImage(bossKey, {
					Name = "Boss" .. usedBoss, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(T.BossIcon, T.BossIcon),
					ZIndex = 8, Active = false, Visible = false, Parent = ui.canvas,
				})
				pool.bosses[usedBoss] = icon
			end
			if icon then
				if icon.Image ~= bossId then icon.Image = bossId end
				icon.Position = toScale(e[1])
				icon.Rotation = S.heading or 0
				if not icon.Visible then icon.Visible = true end
			end
		else
			usedDots += 1
			local dot = pool.monsters[usedDots]
			if not dot then
				dot = newDot("Monster" .. usedDots, T.MonsterDot, COL.Monster, 7, true)
				pool.monsters[usedDots] = dot
			end
			local strong = e[4] or e[5]
			placeDot(dot, e[1], e[3] and COL.Golden or COL.Monster, e[4] and T.BossDot or (strong and T.StrongDot or T.MonsterDot))
			local rim = dot:FindFirstChildOfClass("UIStroke")
			if rim and rim.Enabled ~= strong then rim.Enabled = strong end
		end
	end
	hideRest(pool.monsters, usedDots)
	hideRest(pool.bosses, usedBoss)
end

local function scan()
	local x, z = S.x, S.z
	if not x then return end
	local tp = questTarget()
	if tp then
		if not S.questPos or (tp - S.questPos).Magnitude > 0.5 then
			S.questPos = tp
			ui.star.Position = toScale(tp)
		end
	else
		S.questPos = nil
	end
	scanPlayers(x, z)
	scanMonsters(x, z)
end

-- quest target: ★ at its spot inside the view, else a ▲ chevron on the view edge turned toward it
local function placeQuest(x, z)
	local tp = S.questPos
	if not tp then
		setVisible(ui.star, false)
		setVisible(ui.chev, false)
		return
	end
	local vx, vy = (tp.X - x) * S.pps, (tp.Z - z) * S.pps
	if T.HeadingUp and S.heading then
		-- the map is turned by -heading (where the camera looks is up): turn the offset the same way for the chevron
		local ang = math.rad(-S.heading)
		vx, vy = vx * math.cos(ang) - vy * math.sin(ang), vx * math.sin(ang) + vy * math.cos(ang)
	end
	local m = T.Star / 2 + 1
	-- the round view: inside the circle -> the star, else the chevron on the circle toward it
	local r = math.max(1, math.min(S.halfX, S.halfY) - m)
	local d = math.sqrt(vx * vx + vy * vy)
	if d <= r then
		setVisible(ui.chev, false)
		setVisible(ui.star, true)
		return
	end
	setVisible(ui.star, false)
	local t = r / math.max(d, 1e-3)
	local px, py = S.cx + vx * t, S.cy + vy * t
	if not S.chevX or math.abs(px - S.chevX) >= T.MinMove or math.abs(py - S.chevY) >= T.MinMove then
		S.chevX, S.chevY = px, py
		ui.chev.Position = UDim2.fromOffset(px, py)
	end
	local rot = math.deg(math.atan2(vx, -vy))
	if math.abs(rot - ui.chev.Rotation) >= T.MinTurn then ui.chev.Rotation = rot end
	setVisible(ui.chev, true)
end

local function angleDiff(a, b)
	return (a - b + 180) % 360 - 180
end

-- turns the map so the heading h (degrees clockwise from north) is up (Rot = -h around my spot), keeps icons upright and
-- the 'N' on the ring toward north: north (0, -1) turned by -heading is (-sin h, -cos h) in GUI space (y down)
local function turnMap(h)
	S.heading = h
	ui.rot.Rotation = -h
	for _, m in S.upright do
		if m then m.Rotation = h end
	end
	for _, b in pool.bosses do b.Rotation = h end
	if ui.north and S.northR and S.side then
		local r = math.rad(h)
		ui.north.Position = UDim2.fromOffset(S.side / 2 - math.sin(r) * S.northR, S.side / 2 - math.cos(r) * S.northR)
	end
end

-- 15 Hz: canvas under my position, the map turn (or my arrow on a north-up map), quest marker
local function moveStep()
	local pos, look = myPose()
	if not pos then return end
	S.x, S.z = pos.X, pos.Z
	local ox = S.cx - (pos.X - W.MinX) * S.pps
	local oy = S.cy - (pos.Z - W.MinZ) * S.pps
	if not S.ox or math.abs(ox - S.ox) >= T.MinMove or math.abs(oy - S.oy) >= T.MinMove then
		S.ox, S.oy = ox, oy
		ui.canvas.Position = UDim2.fromOffset(ox, oy)
	end
	placeQuest(pos.X, pos.Z)
end

-- every frame (A23-51): the map turns so my CHARACTER's facing (HumanoidRootPart LookVector, degrees clockwise from
-- north) is up, eased (T.TurnEase) so a quick turn never jumps; my arrow stays at Rotation 0 (up)
local function turnStep(dt)
	local _, look = myPose()
	if not T.HeadingUp or not look or look.X * look.X + look.Z * look.Z < 1e-6 then return end
	local yaw = math.deg(math.atan2(look.X, -look.Z))
	if not S.heading then
		turnMap(yaw)
		return
	end
	local step = angleDiff(yaw, S.heading)
	if math.abs(step) < T.TurnMin then return end
	turnMap(angleDiff(S.heading + step * math.min(1, dt * T.TurnEase), 0))
end

-- 1 Hz: box, potion merchant, anvil
local function slowStep()
	relayout()
	if not S.rectOk then return end
	local mp = merchantPos()
	if mp then ui.potion.Position = toScale(mp) end
	setVisible(ui.potion, mp ~= nil)
	local sp = anvilPos()
	if sp then S.smithPos = sp end
	if S.smithPos then ui.smith.Position = toScale(S.smithPos) end
	setVisible(ui.smith, S.smithPos ~= nil)
end

-- HUD showing (HUD.IsVisible; without it: HUD has published Rects), world map closed, no panel over a phone screen
local function hudShowing()
	local hud = C and C.HUD
	if type(hud) ~= "table" then return false end
	if type(hud.IsVisible) == "function" then
		local ok, visible = pcall(hud.IsVisible)
		return ok and visible == true
	end
	local layout = hud.Layout
	return type(layout) == "table" and type(layout.Rects) == "table"
end

local function refreshVisibility()
	if not ui.root then return end
	local want = hudShowing() and not moduleOpen("WorldMap")
		and not (UserInputService.TouchEnabled and moduleOpen("Panels"))
	if want and not S.rectOk then
		local now = os.clock()
		if now - S.lastTry >= T.SlowDt then
			S.lastTry = now
			relayout()
		end
	end
	local show = want and S.rectOk
	if show == S.shown then return end
	S.shown = show
	ui.root.Visible = show
	if show then
		-- first frame after showing: box, landmarks and position at once (the scan follows in the same Heartbeat)
		S.ox, S.chevX = nil, nil
		acc.Move, acc.Slow = 0, 0
		slowStep()
		moveStep()
	end
end

local function onHeartbeat(dt)
	acc.Scan += dt
	if acc.Scan >= T.ScanDt then
		acc.Scan = 0
		guard(refreshVisibility, "visibility")
		if S.shown then guard(scan, "scan") end
	end
	if not S.shown then return end -- hidden: no work besides the visibility check
	acc.Slow += dt
	if acc.Slow >= T.SlowDt then
		acc.Slow = 0
		guard(slowStep, "landmark")
	end
	acc.Move += dt
	if acc.Move >= T.MoveDt then
		acc.Move = math.min(acc.Move - T.MoveDt, T.MoveDt)
		guard(moveStep, "move")
	end
	guard(function() turnStep(dt) end, "turn")
end

local function bindCamera()
	if S.camConn then
		S.camConn:Disconnect()
		S.camConn = nil
	end
	local cam = workspace.CurrentCamera
	if cam then
		S.camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			task.defer(MiniMap.Relayout) -- after HUD's own pass when it runs first; the 1 Hz step catches the rest
		end)
	end
end

----------------------------------------------------------------- public API
function MiniMap.Init(registry)
	C = registry
	local ok, err = pcall(prepareData)
	if not ok then Util.Warn(TAG, "map data failed: " .. tostring(err)) end
end

function MiniMap.Start()
	local ok, err = pcall(build)
	if not ok or not S.built then
		Util.Warn(TAG, "build failed: " .. tostring(err))
		return
	end
	RunService.Heartbeat:Connect(onHeartbeat)
	LocalPlayer:GetAttributeChangedSignal("Faction"):Connect(function()
		guard(MiniMap.PaintMe, "paint me")
	end)
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()
	MiniMap.Relayout()
	print("[MiniMap] started")
end

-- my arrow in my faction's colour (the art is white with a navy rim; the text fallback stays white)
function MiniMap.PaintMe()
	if not ui.me or not S.meArt then return end
	local f = LocalPlayer:GetAttribute("Faction")
	ui.me.ImageColor3 = (f == "Halo" and COL.MeHalo) or (f == "Horns" and COL.MeHorns) or (f == "Neutral" and COL.MeNeutral)
		or WHITE
end

-- re-reads C.HUD.Layout.Rects.minimap (HUD calls this right after each layout pass); no rect = hidden
function MiniMap.Relayout()
	if not S.built then return end
	guard(relayout, "relayout")
end

function MiniMap.IsShown()
	return S.shown == true
end

return MiniMap
]]></ProtectedString>
					<string name="ScriptGuid">{211F93A7-A78E-4CE8-8DF6-87F8726215C7}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MiniMap</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c99063480b229a50ad663aa000008bd</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX27A570A68BCC4A258CA5FF0842718A57">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MonsterMotion.luau : plays Tripo-made monster clips (Idle / Walk / Slash / Hurt / Fall) on rigged monster visuals by
-- writing Bone.Transform every frame on this client only. The clips are data modules made by
-- tools/glb_anim_to_luau.py in ReplicatedStorage.MonsterAnims ("<MonsterKind>_<Clip>"), so no Roblox animation asset
-- upload is needed. Only monsters near the camera move. Unrigged monsters keep Fx's procedural wobble.
--   moving -> Walk (loop, played as fast as the monster really walks; Run at its chase pace), still -> Idle (loop)
--   with one LookAround now and then, attack -> Slash once, HurtSeq bump -> Hurt once, dying (anchored root) -> Fall
--   once, faster, and hold the last frame (Leaving = Idle). Changes cross-fade over BLEND seconds.
-- Monster motion review 2026-10-06 (docs/design/monster_motion_survey_2026-10-06.md 4-1): every attack restarts Slash
-- (it used to freeze on its last frame when two attacks came back to back); Slash starts at the wind-up (WindupAt) and
-- skips its first part so the clip's fastest frame (HitTime) lands on the impact (wind-up end) instead of ~1.1 s after
-- the damage; loops start at each monster's own phase and speed (a group never moves in step).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)

local MonsterMotion = {}
local C = nil

local M = {
	Range = 130, -- studs from the camera
	Blend = 0.15,
	HurtMax = 0.6, -- a hit reaction never plays longer than this
	FallRate = 1.8, -- the fall plays this much faster (the server keeps the body ~1.1 s: MonsterService DEATH)
	FallImpactAt = 0.5, -- s after death when the fall's fastest frame (hitting the ground) shows
	WalkRate = { Min = 0.45, Max = 1.5 }, -- Walk / Run speed = real flat speed / the kind's chase Speed, clamped
	RunAbove = 0.75, -- at this share of the chase Speed or more it runs (Run clip, ab7e7a5); a wander walks at half
	LookEvery = { 6, 12 }, -- s between two LookAround clips of a standing monster (its own rhythm)
	Jitter = 0.08, -- each monster's loops run +-8% faster / slower
	SlashFresh = 1.2, -- s: an AttackSeq this soon after a seen wind-up belongs to that wind-up (no restart)
	Clips = { "Idle", "Walk", "Run", "LookAround", "Slash", "Hurt", "Fall" },
	Cache = {}, -- ["Goblin_Walk"] = clip table | false
	State = {}, -- [model] = per-monster state
}

-- s into a clip where its bones turn fastest (the swing's contact), measured once per clip
function M.HitTime(clip)
	if clip.HitTime then return clip.HitTime end
	local best, bestI = -1, 0
	for i = 0, clip.Frames - 2 do
		local sum = 0
		for _, entry in clip.Bones do
			local r = entry.r
			local dot = r[i * 4 + 1] * r[i * 4 + 5] + r[i * 4 + 2] * r[i * 4 + 6] + r[i * 4 + 3] * r[i * 4 + 7]
				+ r[i * 4 + 4] * r[i * 4 + 8]
			sum += 2 * math.acos(math.min(1, math.abs(dot)))
		end
		if sum > best then best, bestI = sum, i end
	end
	clip.HitTime = (bestI + 0.5) / (clip.Fps or 15)
	return clip.HitTime
end

-- the wind-up length of a monster (attribute WindupTime, else Config.HitReact.MonsterWindup)
function M.Windup(model)
	local v = model:GetAttribute("WindupTime")
	if type(v) == "number" and v > 0 then return v end
	local react = Config.HitReact
	return type(react) == "table" and tonumber(react.MonsterWindup) or 0.28
end

local function clipFor(kind, name)
	local key = kind .. "_" .. name
	local cached = M.Cache[key]
	if cached ~= nil then return cached or nil end
	local folder = ReplicatedStorage:FindFirstChild("MonsterAnims")
	local mod = folder and folder:FindFirstChild(key)
	local ok, data = false, nil
	if mod and mod:IsA("ModuleScript") then ok, data = pcall(require, mod) end
	if ok and type(data) == "table" and type(data.Bones) == "table" and (data.Frames or 0) > 1 then
		data.Length = (data.Frames - 1) / (data.Fps or 15)
		M.Cache[key] = data
		return data
	end
	M.Cache[key] = false
	return nil
end

-- pose of one bone in a clip at time t (seconds), interpolated between frames
local function pose(clip, entry, t, scale)
	local fps = clip.Fps or 15
	local last = clip.Frames - 1
	local x = math.clamp(t * fps, 0, last)
	local i = math.floor(x)
	local u = x - i
	local j = math.min(i + 1, last)
	local r = entry.r
	local a = CFrame.new(0, 0, 0, r[i * 4 + 1], r[i * 4 + 2], r[i * 4 + 3], r[i * 4 + 4])
	local b = CFrame.new(0, 0, 0, r[j * 4 + 1], r[j * 4 + 2], r[j * 4 + 3], r[j * 4 + 4])
	local cf = a:Lerp(b, u)
	local p = entry.p
	if p then
		local pa = Vector3.new(p[i * 3 + 1], p[i * 3 + 2], p[i * 3 + 3])
		local pb = Vector3.new(p[j * 3 + 1], p[j * 3 + 2], p[j * 3 + 3])
		cf = CFrame.new(pa:Lerp(pb, u) * scale) * cf
	end
	return cf
end

-- a new attack: Slash restarts at clip time `from` (token bump = restart even when Slash is already playing)
local function startSlash(st, clip, from)
	st.SlashToken += 1
	st.SlashFrom = math.clamp(from, 0, clip.Length)
	st.AttackUntil = os.clock() + (clip.Length - st.SlashFrom)
end

local function track(model)
	local kind = model:GetAttribute("MonsterKind")
	local visual = model:FindFirstChild("CustomVisual")
	if type(kind) ~= "string" or not visual then return false end
	if not clipFor(kind, "Idle") and not clipFor(kind, "Walk") then return false end
	local bones = {}
	for _, d in visual:GetDescendants() do
		if d:IsA("Bone") then bones[d.Name] = d end
	end
	if next(bones) == nil then return false end
	local okScale, scale = pcall(visual.GetScale, visual)
	local def = Config.MonsterTypes and Config.MonsterTypes[kind]
	local st = {
		Kind = kind, Bones = bones, Scale = (okScale and type(scale) == "number") and scale or 1,
		Root = model:FindFirstChild("HumanoidRootPart"), Clip = nil, T = 0, Once = false,
		From = nil, BlendT = 0, AttackUntil = 0, HurtUntil = 0, Active = false, Model = model,
		Speed = def and tonumber(def.Speed) or 12, -- the kind's chase speed (the Walk clip's natural pace)
		Phase = math.random(), Rate = 1 + (math.random() * 2 - 1) * M.Jitter, -- own loop phase / speed
		SlashToken = 0, SlashFrom = 0, PlayToken = nil, SlashSeenAt = -math.huge,
		LookUntil = 0, Looks = 0,
	}
	st.LookAt = os.clock() + 2 + 6 * st.Phase -- the first LookAround: 2-8 s after it shows up (own rhythm)
	-- the wind-up starts the swing so that its fastest frame meets the impact (wind-up end)
	model:GetAttributeChangedSignal("WindupAt"):Connect(function()
		local c = clipFor(kind, "Slash")
		local v = model:GetAttribute("WindupAt")
		if not c or type(v) ~= "number" or v <= 0 then return end
		local okNow, serverNow = pcall(function() return workspace:GetServerTimeNow() end)
		local elapsed = (okNow and type(serverNow) == "number") and math.max(0, serverNow - v) or 0
		local toImpact = math.max(0, M.Windup(model) - elapsed)
		startSlash(st, c, M.HitTime(c) - toImpact)
		st.SlashSeenAt = os.clock()
	end)
	-- the impact: a swing already started by its wind-up goes on; otherwise (wind-up missed) show the follow-through
	model:GetAttributeChangedSignal("AttackSeq"):Connect(function()
		local c = clipFor(kind, "Slash")
		if not c or os.clock() - st.SlashSeenAt <= M.SlashFresh then return end
		startSlash(st, c, M.HitTime(c))
	end)
	model:GetAttributeChangedSignal("HurtSeq"):Connect(function()
		local c = clipFor(kind, "Hurt")
		if c then st.HurtUntil = os.clock() + math.min(M.HurtMax, c.Length) end
	end)
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then M.State[model] = nil end
	end)
	M.State[model] = st
	return st
end

-- the current pose of every animated bone (used as the "from" side of a cross-fade)
local function snapshot(st)
	local snap = {}
	for name, bone in st.Bones do snap[name] = bone.Transform end
	return snap
end

-- switches clip (cross-fade); `token` restarts the same clip when it changed; loops start at the monster's own phase
local function play(st, name, once, clip, token, from)
	if st.Clip == name and st.PlayToken == token then return end
	st.From = snapshot(st)
	st.BlendT = 0
	st.Clip = name
	st.T = from or (once and 0 or st.Phase * clip.Length)
	st.Once = once
	st.PlayToken = token
end

local function rest(st)
	if not st.Active then return end
	st.Active = false
	for _, bone in st.Bones do bone.Transform = CFrame.identity end
	st.Clip = nil
end

local function step(dt)
	local cam = workspace.CurrentCamera
	local folder = workspace:FindFirstChild("Monsters")
	if not cam or not folder then return end
	local camPos = cam.CFrame.Position
	local now = os.clock()
	for _, model in folder:GetChildren() do
		local st = M.State[model]
		if st == nil and model:IsA("Model") then
			st = track(model)
			if st == false then
				M.State[model] = false
				-- review C-7: an untrackable model (no clips) is forgotten when it leaves, so the table never grows
				model.AncestryChanged:Connect(function(_, parent)
					if parent == nil then M.State[model] = nil end
				end)
			end
		end
		if st and st.Root and st.Root.Parent then
			if (st.Root.Position - camPos).Magnitude > M.Range then
				rest(st)
			else
				st.Active = true
				-- choose the clip and how fast it runs
				local want, once, rate = "Idle", false, st.Rate
				local v = st.Root.AssemblyLinearVelocity
				local flat2 = v.X * v.X + v.Z * v.Z
				if st.Root.Anchored then
					-- dying: fall (faster); an event monster going home (Leaving) floats away calmly instead
					if model:GetAttribute("Leaving") == true then
						want = "Idle"
					else
						want, once, rate = "Fall", true, M.FallRate
					end
				elseif now < st.AttackUntil then
					want, once, rate = "Slash", true, 1
					st.LookUntil = 0
				elseif now < st.HurtUntil then
					want, once, rate = "Hurt", true, 1
					st.LookUntil = 0
				elseif flat2 > 2.25 then
					st.LookUntil = 0
					local ratio = math.sqrt(flat2) / math.max(st.Speed, 1)
					want = (ratio >= M.RunAbove and clipFor(st.Kind, "Run")) and "Run" or "Walk" -- chase runs, wander walks
					rate = st.Rate * math.clamp(ratio, M.WalkRate.Min, M.WalkRate.Max)
				else
					-- standing: now and then one LookAround (two head turns), then Idle again
					if now >= st.LookAt then
						local look = clipFor(st.Kind, "LookAround")
						if look then st.LookUntil = now + look.Length / st.Rate end
						st.Looks += 1
						st.LookAt = now + (look and look.Length or 0) + M.LookEvery[1]
							+ (M.LookEvery[2] - M.LookEvery[1]) * ((st.Phase + st.Looks * 0.618) % 1)
					end
					if now < st.LookUntil then want, once = "LookAround", true end
				end
				if not clipFor(st.Kind, want) then want, once, rate = "Idle", false, st.Rate end
				local clip = clipFor(st.Kind, want)
				if clip then
					if want == "Slash" then
						play(st, want, once, clip, st.SlashToken, st.SlashFrom)
					elseif want == "Fall" then
						-- skip the start so the body hits the ground FallImpactAt s after death, before the fade
						play(st, want, once, clip, nil, math.max(0, M.HitTime(clip) - M.FallImpactAt * M.FallRate))
					else
						play(st, want, once, clip, nil, nil)
					end
					st.T += dt * rate
					local t = st.T
					if once then t = math.min(t, clip.Length) else t = t % math.max(clip.Length, 0.05) end
					st.BlendT += dt
					local w = math.clamp(st.BlendT / M.Blend, 0, 1)
					for name, bone in st.Bones do
						local entry = clip.Bones[name]
						local target = entry and pose(clip, entry, t, st.Scale) or CFrame.identity
						if w < 1 and st.From and st.From[name] then
							target = st.From[name]:Lerp(target, w)
						end
						bone.Transform = target
					end
				end
			end
		end
	end
end

-- read-only view for the offline test (tools/test_monster_motion.py): clip choice, clip time, slash restarts
MonsterMotion.Debug = M

-- Fx's procedural wobble skips monsters this module animates
function MonsterMotion.IsRigged(model)
	local st = M.State[model]
	return st ~= nil and st ~= false
end

function MonsterMotion.Init(c)
	C = c
end

function MonsterMotion.Start()
	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if not ok and not M.Warned then
			M.Warned = true
			warn("[MonsterMotion] " .. tostring(err))
		end
	end)
	print("[MonsterMotion] started")
end

return MonsterMotion
]]></ProtectedString>
					<string name="ScriptGuid">{8CF7784C-B959-4F1D-9B7B-1C1DA603F9CA}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MonsterMotion</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c99063480b229a50ad663aa000008bf</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX718104E5C8094DC5BB71C66D791C0B04">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- QuestMarker.luau : the quest target marker (SPEC_ADDENDUM A23-36, user 2026-10-06: "퀘스트 장소를 이렇게 표시하자" -
-- a small floating diamond + "33m"). One marker at a time, for the pinned quest row's place:
--   source  : C.HUD.QuestTarget() -> QuestTarget.ForEntry result { Part, Position, Tag, Claim, ... } | nil (2 Hz;
--             nothing is drawn while HUD does not expose it)
--   colour  : in progress white, done and waiting for [Claim] light gold (검수 2026-10-06 "하늘색/흰색, 받기 금";
--             Config.UIArt.Colors MarkerGo / MarkerClaim tint the white IconQuestMarker art). White + the art's navy
--             rim keep >= 3:1 on every zone floor and sky (rubric 4); sky blue fell to 2.2:1 on dark meadow grass.
--   size    : the icon is never under 48 real px (검수 2026-10-06), the distance 15 px (rubric >= 14 px); du = px / the
--             HUD's UIScale (T.Fit)
--   drawn   : in its own ScreenGui "QuestMarkerGui" just under MainGui (same inset / safe-area settings and UIScale, one
--             DisplayOrder lower), so it is always in front of the 3D world (never hidden behind a wall or a hill) and
--             the HUD stays on top of it. Placed every frame after the camera (BindToRenderStep).
--   on screen : the icon at the point above the target (part top + T.Lift studs), the distance "Nm" under it
--             (metres = studs / 3.5, rounded)
--   off screen / behind the camera: the same icon + the arrow turned toward the target + the distance at the screen
--             edge, kept inside the screen minus T.Margin and pushed out of the HUD blocks of C.HUD.Layout.Rects (minimap
--             + quest lines, the plate + icon tiles, the top centre column, the combat cluster, [Menu]) and, on touch,
--             out of the thumbstick zone. Where the edge is all HUD (phones) it walks in along the ray to the spot
--             covering the least HUD, which rings my character.
--   near    : fades out inside T.FadeM metres, hidden inside T.HideM
--   hidden  : HUD.IsVisible() false, the world map / a panel / the opening open, no target, no character
-- (A world BillboardGui was tried first: AlwaysOnTop billboards do not show in Studio MCP screen captures, so the marker
-- could never be checked on the sheets; the screen-space marker looks the same and is checkable.)
-- Icon: Config.UIArt parts "IconQuestMarker" (white diamond, tinted by code) and "IconQuestMarkerArrow" (points up,
-- Rotation turns it) through UIKit.ArtImage when they exist, else the code fallbacks (a tinted Frame turned 45 degrees
-- with a navy rim and a white dot, a "▲" text; IMG-R4). The distance is UIKit's "Number" text style.
-- A thin dark halo (the same art, dark, half see-through, T.HaloPx larger) sits under the icon and the arrow so they keep
-- >= 3:1 next to bright lamps and on light grass (검수 2026-10-06).
-- Presentation only: every instance is Active = false and nothing is a button, so no input is ever sunk.
--
-- Public API: QuestMarker.Init(C), QuestMarker.Start(), QuestMarker.Refresh(), QuestMarker.IsShown()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))

local LocalPlayer = Players.LocalPlayer

local QuestMarker = {}

local TAG = "QuestMarker"
local C = nil -- client registry (set in Init)
local UIKit = nil -- C.UIKit (set in Start)

----------------------------------------------------------------- tuning (du = logical HUD units; px; studs)
local IS_TOUCH = UserInputService.TouchEnabled
local T = {
	TargetDt = 1 / 2, -- ask HUD for the target
	StudsPerMeter = 3.5, -- A23-36: metres = studs / 3.5, rounded
	FadeM = 10, -- starts fading inside this many metres...
	HideM = 6, -- ...and is gone inside this many
	Lift = 3, -- studs above the target part's top (or above a bare position)
	-- sizes in REAL screen px; du = px / UIScale (T.Fit)
	IconPx = 48, -- 검수 2026-10-06: the marker is at least 48 px
	ArrowPx = 24,
	TextPx = 15, -- rubric: text over the 3D world >= 14 px
	TextWPx = 64, -- "123m" never clips
	HaloPx = 3, -- the dark halo is this much larger than the art (about 1.5 px on each side)
	HaloAlpha = 0.45, -- its transparency
	Margin = 48, -- kept from every screen edge (du)
	TopBar = 60, -- Roblox top bar: the indicator stays below it
	Pad = 6, -- kept between the indicator and a HUD block
	StickX = 0.4, -- touch thumbstick zone: x < StickX * W and y > H * StickTop
	StickTop = 1 / 3,
	WalkSteps = 16, -- crowded screens: spots tried along the ray between the edge and MinRing
	-- crowded screens: how much covering a rect counts (the notify column / chips are mostly see-through text)
	Weight = { notify = 0.2, chips = 0.6 },
	MinMove = 0.25, -- du: smaller moves are not written
	MinTurn = 1, -- degrees
	ArtKey = "IconQuestMarker",
	ArrowKey = "IconQuestMarkerArrow",
	Step = "QuestMarker", -- BindToRenderStep name (after the camera)
	WarnEvery = 10,
}
-- the indicator in du for the HUD's UIScale s: icon, arrow, label, the footprint half-size around the icon centre
-- (icon + arrow beside it + label under it) and the ring it never enters around the screen centre (my character)
function T.Fit(s)
	T.Icon = math.ceil(T.IconPx / s)
	T.Arrow = math.ceil(T.ArrowPx / s)
	T.Text = math.ceil(T.TextPx / s)
	T.TextW = math.ceil(T.TextWPx / s)
	T.Halo = T.HaloPx / s
	T.HalfX = math.max(T.Icon / 2 + T.Arrow + 2, T.TextW / 2) + T.Pad
	T.HalfY = T.Icon / 2 + math.max(T.Arrow, T.Text + 4) + T.Pad
	T.MinRing = T.Icon + T.Arrow + 8
end
T.Fit(1)

-- HUD layout B blocks the edge indicator stays out of (C.HUD.Layout.Rects ids, each group = one union box)
local AVOID = {
	{ "minimap", "quest" }, -- top-left minimap + quest lines
	{ "portrait", "hp_bar", "mp_bar", "power_line", "xp_bar", "tiles" }, -- plate + icon tiles (PC bottom, phone top-right)
	{ "war_meter", "chips", "event", "notify" }, -- top centre column
	{ "potions", "ghost", "q", "z", "x", "auto", "attack" }, -- bottom-right combat cluster (x: A23-49 SkillBar)
	{ "menu" }, -- [Menu] (A23-40 정정: PC top-right corner, phones the tile row's right end)
}

----------------------------------------------------------------- colours / text
local COL = {
	Go = Color3.fromRGB(255, 255, 255), -- in progress: white (ArtColors.MarkerGo, copied in at build)
	Claim = Color3.fromRGB(255, 228, 128), -- done, waiting for [Claim]: light gold (ArtColors.MarkerClaim)
	Rim = Color3.fromRGB(26, 40, 79), -- ArtColors.Navy: dark navy outline over 3D
	Dot = Color3.new(1, 1, 1),
	Halo = Color3.fromRGB(8, 12, 28), -- the dark halo under the art (never tinted)
}
local TXT = {
	Distance = "%dm",
	Arrow = "▲", -- points up at Rotation 0 (turned toward the target)
}

----------------------------------------------------------------- state
local S = {
	built = false,
	shown = false, -- the marker is showing (on screen or at the edge)
	target = nil, -- { Part, Position, Tag, Claim } from the last retarget
	claim = nil, -- the colour last written (true = gold)
	scale = nil, -- the UIScale T.Fit last sized the marker for
	meters = nil, -- last written distance
	alpha = nil, -- last written fade (0..1)
	onScreen = nil,
	posX = nil, posY = nil, rot = nil, labelUp = nil,
	layoutRef = nil, layoutW = nil, layoutH = nil, -- the HUD.Layout the avoid boxes were built from
	avoid = {}, -- HUD block unions { { x0, y0, x1, y1 } } in du, inflated by the indicator's footprint
	raw = {}, -- the single HUD rects (+ thumbstick zone), not inflated
	targetAcc = 0,
	lastWarnAt = -math.huge,
}
local ui = {} -- gui, scale, holder, iconBox, icon, iconHalo, arrow, arrowHalo, text
local fades = {} -- { { inst, prop, base } }
local tinted = {} -- { { inst, colour property } } recoloured by setTint

----------------------------------------------------------------- helpers
local function warnThrottled(msg)
	local now = os.clock()
	if now - S.lastWarnAt < T.WarnEvery then return end
	S.lastWarnAt = now
	Util.Warn(TAG, msg)
end

local function guard(fn, what)
	local ok, err = pcall(fn)
	if not ok then warnThrottled(what .. " error: " .. tostring(err)) end
end

local function num(v)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return nil
end

local function moduleOpen(name)
	local m = C and C[name]
	if type(m) ~= "table" or type(m.IsOpen) ~= "function" then return false end
	local ok, open = pcall(m.IsOpen)
	return ok and open == true
end

local function hudShowing()
	local hud = C and C.HUD
	if type(hud) ~= "table" then return false end
	if type(hud.IsVisible) == "function" then
		local ok, visible = pcall(hud.IsVisible)
		return ok and visible == true
	end
	return LocalPlayer:GetAttribute("DataLoaded") == true
end

local function myRoot()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and root:IsA("BasePart") and root or nil
end

-- MainGui's UIScale (logical du -> px)
local function guiScale()
	local gui = UIKit and UIKit.Gui
	local sc = gui and gui:FindFirstChildOfClass("UIScale")
	local s = sc and num(sc.Scale) or nil
	if not s or s <= 0 then
		local layout = C and type(C.HUD) == "table" and C.HUD.Layout or nil
		s = type(layout) == "table" and num(layout.Scale) or 1
	end
	return (s and s > 0) and s or 1
end

-- records every fadeable property under root with its current value as the "fully shown" base
local function collectFades(root)
	local function add(inst)
		if inst:IsA("ImageLabel") then
			table.insert(fades, { inst, "ImageTransparency", inst.ImageTransparency })
		elseif inst:IsA("TextLabel") then
			table.insert(fades, { inst, "TextTransparency", inst.TextTransparency })
		elseif inst:IsA("UIStroke") then
			table.insert(fades, { inst, "Transparency", inst.Transparency })
		end
		if inst:IsA("GuiObject") and inst.BackgroundTransparency < 1 then
			table.insert(fades, { inst, "BackgroundTransparency", inst.BackgroundTransparency })
		end
	end
	add(root)
	for _, d in root:GetDescendants() do add(d) end
end

----------------------------------------------------------------- drawing
local function tint(inst, prop)
	table.insert(tinted, { inst, prop })
	return inst
end

-- the dark halo under an art image: the same image, dark, half see-through, one layer lower (sized by the caller)
local function halo(art)
	local h = art:Clone()
	h.Name = art.Name .. "Halo"
	h.ImageColor3 = COL.Halo
	h.ImageTransparency = T.HaloAlpha
	h.ZIndex = art.ZIndex - 1
	h.Parent = art.Parent
	return h
end

-- the marker icon filling `box`: the IconQuestMarker art tinted by state, else the code diamond (IMG-R4)
local function makeIcon(box)
	local art = UIKit.ArtImage(T.ArtKey, {
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		ImageColor3 = COL.Go,
		ZIndex = 3,
		Active = false,
		Parent = box,
	})
	if art then
		ui.iconHalo = halo(art)
		ui.iconHalo.AnchorPoint = Vector2.new(0.5, 0.5)
		ui.iconHalo.Position = UDim2.fromScale(0.5, 0.5)
		ui.iconHalo.Size = UDim2.new(1, T.Halo, 1, T.Halo)
		return tint(art, "ImageColor3")
	end
	local diamond = UIKit.Create("Frame", {
		Name = "Diamond",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.66, 0.66), -- turned 45 degrees: the corners reach ~0.93 of the box
		Rotation = 45,
		BackgroundColor3 = COL.Go,
		ZIndex = 3,
		Active = false,
		Parent = box,
	}, {
		UIKit.Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
		UIKit.Create("UIStroke", { Color = COL.Rim, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	UIKit.Create("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.34, 0.34),
		BackgroundColor3 = COL.Dot,
		ZIndex = 3,
		Active = false,
		Parent = diamond,
	}, {
		UIKit.Create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
	})
	return tint(diamond, "BackgroundColor3")
end

-- the edge arrow: the IconQuestMarkerArrow art (points up), else a "▲" text (IMG-R4)
local function makeArrow(parent)
	local props = {
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(T.Arrow, T.Arrow),
		ImageColor3 = COL.Go,
		ZIndex = 4,
		Active = false,
		Visible = false,
		Parent = parent,
	}
	local art = UIKit.ArtImage(T.ArrowKey, props)
	if art then
		ui.arrowHalo = halo(art)
		ui.arrowHalo.Size = UDim2.fromOffset(T.Arrow + T.Halo, T.Arrow + T.Halo)
		return tint(art, "ImageColor3")
	end
	props.ImageColor3 = nil
	props.Text = TXT.Arrow
	props.TextSize = T.Arrow
	props.Color = COL.Go
	props.Outline = COL.Rim
	props.OutlineThickness = 2
	return tint(UIKit.LightText(props), "TextColor3")
end

-- the distance: UIKit's "Number" style over the 3D world (white -> cream, navy rim; A23-48 Fredoka One)
local function makeDistance(parent)
	local props = {
		Name = "Distance",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, T.Icon / 2 + T.Text / 2 + 2),
		Size = UDim2.fromOffset(T.TextW, T.Text + 2),
		TextSize = T.Text,
		ZIndex = 4,
		Active = false,
		Parent = parent,
	}
	if type(UIKit.StyledLabel) == "function" then return UIKit.StyledLabel(props, "Number") end
	props.Color = Color3.new(1, 1, 1)
	props.Outline = COL.Rim
	props.OutlineThickness = 2
	props.Number = true
	return UIKit.LightText(props)
end

local function build()
	UIKit = C and C.UIKit
	assert(type(UIKit) == "table" and UIKit.Gui, "UIKit is not initialized")
	local main = UIKit.Gui
	local artCol = type(UIKit.ArtColors) == "table" and UIKit.ArtColors or {}
	if typeof(artCol.MarkerGo) == "Color3" then COL.Go = artCol.MarkerGo end
	if typeof(artCol.MarkerClaim) == "Color3" then COL.Claim = artCol.MarkerClaim end
	if typeof(artCol.Navy) == "Color3" then COL.Rim = artCol.Navy end

	-- the same screen space as MainGui (inset + safe area), one layer under it: the HUD draws over the marker
	local gui = Instance.new("ScreenGui")
	gui.Name = "QuestMarkerGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = main.IgnoreGuiInset
	gui.DisplayOrder = main.DisplayOrder - 1
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		gui.ScreenInsets = main.ScreenInsets
	end)
	ui.gui = gui
	ui.scale = UIKit.Create("UIScale", { Scale = 1, Parent = gui })

	-- a 0x0 holder at the icon centre; children sit at offsets around it
	local holder = UIKit.Create("Frame", {
		Name = "QuestMarker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Active = false,
		Visible = false,
		Parent = gui,
	})
	pcall(function()
		holder.Interactable = false -- never takes input (the thumbstick zone on phones)
	end)
	ui.holder = holder
	ui.iconBox = UIKit.Create("Frame", {
		Name = "IconBox",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(T.Icon, T.Icon),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Active = false,
		Parent = holder,
	})
	ui.icon = makeIcon(ui.iconBox)
	ui.arrow = makeArrow(holder)
	ui.text = makeDistance(holder)
	collectFades(holder)
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
	gui.Parent = playerGui
	S.built = true
end

----------------------------------------------------------------- HUD blocks (C.HUD.Layout, read lazily)
-- S.avoid = union boxes of the AVOID groups inflated by the indicator's footprint, S.raw = every rect of those
-- groups on its own; both with the thumbstick zone on touch ({ x0, y0, x1, y1 } du). Rebuilt only when HUD made a
-- new Layout table, the screen size or the indicator's size changed.
local function readAvoid(W, H)
	local hud = C and C.HUD
	local layout = type(hud) == "table" and hud.Layout or nil -- a NEW table every HUD layout pass: never cached
	if layout == S.layoutRef and W == S.layoutW and H == S.layoutH then return end
	S.layoutRef, S.layoutW, S.layoutH = layout, W, H
	local boxes, raw = {}, {}
	local rects = type(layout) == "table" and type(layout.Rects) == "table" and layout.Rects or nil
	if rects then
		for _, group in AVOID do
			local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
			for _, id in group do
				local r = rects[id]
				local x, y, w, h = nil, nil, nil, nil
				if type(r) == "table" then x, y, w, h = num(r.X), num(r.Y), num(r.W), num(r.H) end
				if x and y and w and h and w > 0 and h > 0 then
					x0, y0 = math.min(x0, x), math.min(y0, y)
					x1, y1 = math.max(x1, x + w), math.max(y1, y + h)
					table.insert(raw, { x, y, x + w, y + h, T.Weight[id] or 1 })
				end
			end
			if x1 > x0 then table.insert(boxes, { x0, y0, x1, y1 }) end
		end
	elseif type(layout) == "table" and num(layout.ClusterLeft) and num(layout.ClusterTop) then
		-- before HUD v2: only the bottom-right button cluster is published
		table.insert(boxes, { layout.ClusterLeft, layout.ClusterTop, W, H })
		table.insert(raw, { layout.ClusterLeft, layout.ClusterTop, W, H })
	end
	if IS_TOUCH then
		table.insert(boxes, { 0, H * T.StickTop, W * T.StickX, H })
		table.insert(raw, { 0, H * T.StickTop, W * T.StickX, H })
	end
	for _, b in boxes do
		b[1], b[2], b[3], b[4] = b[1] - T.HalfX, b[2] - T.HalfY, b[3] + T.HalfX, b[4] + T.HalfY
	end
	S.avoid, S.raw = boxes, raw
end

local function hitAny(px, py, list)
	for _, b in list do
		if px > b[1] and px < b[3] and py > b[2] and py < b[4] then return true end
	end
	return false
end

-- moves (px, py) out of every avoid box by the smallest step that stays inside the track box (a few passes, so a
-- point pushed from one block into another is pushed again); keeps the last spot when no exit fits
local function pushOut(px, py, box, avoid)
	for _ = 1, 3 do
		local moved = false
		for _, b in avoid do
			if px > b[1] and px < b[3] and py > b[2] and py < b[4] then
				local best, bx, by = math.huge, px, py
				for _, c in { { b[1], py }, { b[3], py }, { px, b[2] }, { px, b[4] } } do
					local cx = math.clamp(c[1], box[1], box[3])
					local cy = math.clamp(c[2], box[2], box[4])
					local inside = cx > b[1] and cx < b[3] and cy > b[2] and cy < b[4]
					local d = math.abs(cx - px) + math.abs(cy - py)
					if not inside and d < best then best, bx, by = d, cx, cy end
				end
				if best < math.huge then
					px, py, moved = bx, by, true
				end
			end
		end
		if not moved then break end
	end
	return px, py
end

-- du^2 of HUD the indicator would cover with its icon centre at (px, py) (the single rects, not inflated)
local function overlap(px, py)
	local fx, fy = T.HalfX - T.Pad, T.HalfY - T.Pad
	local sum = 0
	for _, b in S.raw do
		local w = math.min(px + fx, b[3]) - math.max(px - fx, b[1])
		local h = math.min(py + fy, b[4]) - math.max(py - fy, b[2])
		if w > 0 and h > 0 then sum += w * h * (b[5] or 1) end
	end
	return sum
end

-- where the edge indicator goes for the ray (cx, cy) + (dx, dy) * t (t = the track-box edge):
-- 1. the edge point pushed out of the HUD blocks; 2. crowded (phone) screens: the spot on the ray, from the edge in
-- to T.MinRing from the centre, that covers the least HUD (the outermost one on a tie: a clear spot ends the walk)
local function edgeSpot(cx, cy, dx, dy, t, box)
	local px, py = pushOut(cx + dx * t, cy + dy * t, box, S.avoid)
	if not hitAny(px, py, S.avoid) then return px, py end
	local minR = math.min(t, T.MinRing)
	local bx, by, best = cx + dx * t, cy + dy * t, math.huge
	for k = 0, T.WalkSteps do
		local tk = t - (t - minR) * k / T.WalkSteps
		local qx, qy = cx + dx * tk, cy + dy * tk
		local a = overlap(qx, qy)
		if a < best - 1 then bx, by, best = qx, qy, a end
		if a <= 0 then break end
	end
	return bx, by
end

----------------------------------------------------------------- placing
-- the marker's du for the HUD's UIScale s (48 px icon on every screen); a new size rebuilds the avoid boxes and
-- rewrites every position
local function fitScale(s)
	if s == S.scale then return end
	S.scale = s
	T.Fit(s)
	ui.scale.Scale = s
	ui.iconBox.Size = UDim2.fromOffset(T.Icon, T.Icon)
	if ui.iconHalo then ui.iconHalo.Size = UDim2.new(1, T.Halo, 1, T.Halo) end
	ui.arrow.Size = UDim2.fromOffset(T.Arrow, T.Arrow)
	if ui.arrowHalo then ui.arrowHalo.Size = UDim2.fromOffset(T.Arrow + T.Halo, T.Arrow + T.Halo) end
	if ui.arrow:IsA("TextLabel") then ui.arrow.TextSize = T.Arrow end
	ui.text.Size = UDim2.fromOffset(T.TextW, T.Text + 2)
	ui.text.TextSize = T.Text
	S.layoutRef = false -- never equal to a Layout table or nil: readAvoid rebuilds
	S.posX, S.rot, S.labelUp = nil, nil, nil
end

-- white while in progress, light gold once the row waits for [Claim]
local function setTint(claim)
	if claim == S.claim then return end
	S.claim = claim
	local c = claim and COL.Claim or COL.Go
	for _, e in tinted do e[1][e[2]] = c end
end

local function setDistance(meters)
	if meters == S.meters then return end
	S.meters = meters
	ui.text.Text = string.format(TXT.Distance, meters)
end

local function setAlpha(a)
	if S.alpha and math.abs(S.alpha - a) < 0.02 then return end
	S.alpha = a
	for _, e in fades do
		local v = 1 - (1 - e[3]) * a
		if math.abs(e[1][e[2]] - v) > 0.01 then e[1][e[2]] = v end
	end
end

local function hideAll()
	if ui.holder and ui.holder.Visible then ui.holder.Visible = false end
	S.shown, S.onScreen = false, nil
end

-- world point the marker floats at (live part position, so a moving target is followed)
local function targetPoint()
	local t = S.target
	if not t then return nil, nil end
	local part = t.Part
	if part and part.Parent and part:IsA("BasePart") then
		local p = part.Position
		return p, p + Vector3.new(0, part.Size.Y / 2 + T.Lift, 0)
	end
	local p = t.Position
	return p, p + Vector3.new(0, T.Lift, 0)
end

local function moveTo(px, py)
	if not S.posX or math.abs(px - S.posX) >= T.MinMove or math.abs(py - S.posY) >= T.MinMove then
		S.posX, S.posY = px, py
		ui.holder.Position = UDim2.fromOffset(px, py)
	end
end

-- the distance under the icon, or above it while the edge arrow points down
local function labelAbove(up)
	if up == S.labelUp then return end
	S.labelUp = up
	local off = T.Icon / 2 + T.Text / 2 + 2
	ui.text.Position = UDim2.new(0.5, 0, 0.5, up and -off or off)
end

-- edge indicator: from the screen centre toward the target (camera space, so behind the camera works too), on the
-- track box, out of the HUD blocks; the arrow beside the icon points the way, the distance sits on the other side
local function placeEdge(cam, origin, s, W, H, lifted)
	local centre3 = cam:WorldToScreenPoint(cam.CFrame.Position + cam.CFrame.LookVector * 10)
	local cx, cy = (centre3.X - origin.X) / s, (centre3.Y - origin.Y) / s
	local rel = cam.CFrame:PointToObjectSpace(lifted)
	local dx, dy = rel.X, -rel.Y
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 1e-3 then dx, dy, len = 0, 1, 1 end
	dx, dy = dx / len, dy / len

	-- the whole indicator (icon + the arrow beside it + the distance) stays on screen: the icon centre keeps at least its
	-- footprint from every edge (UiSandbox 2026-10-06: a 48 du margin left half the arrow outside on the left)
	local mx, my = math.max(T.Margin, T.HalfX), math.max(T.Margin, T.HalfY)
	local box = { mx, math.max(my, T.TopBar + T.HalfY), W - mx, H - my }
	if box[3] <= box[1] or box[4] <= box[2] then
		box = { W / 2, H / 2, W / 2, H / 2 } -- a tiny viewport: park it in the middle
	end
	cx, cy = math.clamp(cx, box[1], box[3]), math.clamp(cy, box[2], box[4])
	local tx = dx > 0 and (box[3] - cx) / dx or (dx < 0 and (box[1] - cx) / dx or math.huge)
	local ty = dy > 0 and (box[4] - cy) / dy or (dy < 0 and (box[2] - cy) / dy or math.huge)
	local t = math.max(0, math.min(tx, ty))
	readAvoid(W, H)
	local px, py = edgeSpot(cx, cy, dx, dy, t, box)
	moveTo(px, py)
	local rot = math.deg(math.atan2(dx, -dy)) -- the arrow points up at Rotation 0; GUI rotation is clockwise
	if not S.rot or math.abs(rot - S.rot) >= T.MinTurn then
		S.rot = rot
		local r = T.Icon / 2 + T.Arrow / 2 + 1
		for _, a in { ui.arrow, ui.arrowHalo } do
			a.Rotation = rot
			a.Position = UDim2.new(0.5, dx * r, 0.5, dy * r)
		end
	end
	labelAbove(dy > 0.6) -- the arrow points down: the distance goes above the icon
end

-- every frame after the camera: visibility, distance, fade, colour, on-screen spot or edge indicator
local function moveStep()
	local root = myRoot()
	local cam = workspace.CurrentCamera
	local gui = ui.gui
	local base, lifted = targetPoint()
	if not (root and cam and gui and gui.Parent and base) or not hudShowing() or moduleOpen("WorldMap")
		or moduleOpen("Panels") or moduleOpen("Intro") then
		hideAll()
		return
	end
	local meters = math.floor((base - root.Position).Magnitude / T.StudsPerMeter + 0.5)
	if meters <= T.HideM then
		hideAll()
		return
	end
	setDistance(meters)
	setAlpha(math.clamp((meters - T.HideM) / math.max(0.01, T.FadeM - T.HideM), 0, 1))
	setTint(S.target ~= nil and S.target.Claim == true)

	local s = guiScale()
	fitScale(s)
	local origin, size = gui.AbsolutePosition, gui.AbsoluteSize
	local W, H = size.X / s, size.Y / s
	-- on screen = in front of the camera and inside the gui box
	local sp = cam:WorldToScreenPoint(lifted)
	local lx, ly = (sp.X - origin.X) / s, (sp.Y - origin.Y) / s
	local onScreen = sp.Z > 0 and lx >= 0 and lx <= W and ly >= 0 and ly <= H
	if onScreen ~= S.onScreen then
		S.onScreen = onScreen
		ui.arrow.Visible = not onScreen
		if ui.arrowHalo then ui.arrowHalo.Visible = not onScreen end
		S.posX, S.rot, S.labelUp = nil, nil, nil -- the next placement writes everything
	end
	if onScreen then
		moveTo(lx, ly)
		labelAbove(false)
	else
		placeEdge(cam, origin, s, W, H, lifted)
	end
	if not ui.holder.Visible then ui.holder.Visible = true end
	S.shown = true
end

-- Studio-only check hook (UiSandbox captures in every ZoneLook zone): the local attribute QuestMarkerPreview =
-- "x,y,z" (in progress) or "x,y,z,claim" (gold) replaces HUD's target; never read outside Studio
local function previewTarget()
	if not RunService:IsStudio() then return nil end
	local v = LocalPlayer:GetAttribute("QuestMarkerPreview")
	if type(v) ~= "string" or v == "" then return nil end
	local x, y, z, flag = string.match(v, "^%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)%s*,%s*(%-?[%d%.]+)%s*,?%s*(%a*)")
	if not x then return nil end
	return { Position = Vector3.new(tonumber(x), tonumber(y), tonumber(z)), Tag = "preview", Claim = flag == "claim" }
end

-- 2 Hz: the pinned row's place from HUD (QuestTarget.ForEntry result)
local function retarget()
	local t = previewTarget()
	if t then
		S.target = t
		return
	end
	local hud = C and C.HUD
	if type(hud) == "table" and type(hud.QuestTarget) == "function" then
		local ok, r = pcall(hud.QuestTarget)
		if ok and type(r) == "table" and typeof(r.Position) == "Vector3" then
			local part = typeof(r.Part) == "Instance" and r.Part:IsA("BasePart") and r.Part or nil
			t = { Part = part, Position = r.Position, Tag = r.Tag, Claim = r.Claim == true }
		end
	end
	S.target = t
end

local function onRender(dt)
	S.targetAcc += dt
	if S.targetAcc >= T.TargetDt then
		S.targetAcc = 0
		guard(retarget, "retarget")
	end
	guard(moveStep, "move")
end

----------------------------------------------------------------- public API
function QuestMarker.Init(registry)
	C = registry
end

function QuestMarker.Start()
	local ok, err = pcall(build)
	if not ok or not S.built then
		Util.Warn(TAG, "build failed: " .. tostring(err))
		return
	end
	RunService:BindToRenderStep(T.Step, Enum.RenderPriority.Camera.Value + 1, onRender)
	QuestMarker.Refresh()
	print("[QuestMarker] started")
end

-- asks HUD for the target now and places the marker at once (e.g. right after the quest list changed)
function QuestMarker.Refresh()
	if not S.built then return end
	S.targetAcc = 0
	guard(retarget, "retarget")
	guard(moveStep, "move")
end

function QuestMarker.IsShown()
	return S.shown == true
end

return QuestMarker
]]></ProtectedString>
					<string name="ScriptGuid">{A2AC6C59-7F83-40C6-B9B8-32942A2BF93A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">QuestMarker</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c99063480b229a50ad663aa000008c1</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB483248F231A417C99604783CCF05500">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- QuestTarget.luau : the ONE place that answers "where does the current quest step happen" (A23-36 quest marker,
-- MiniMap quest star, HUD guide beam). Pure resolution: reads Config, workspace.Map and the local player's attributes.
-- The only thing it ever creates is the invisible local anchor HUD already uses (workspace.HUDGuideAnchor_<key>); it is
-- looked up by name first, so HUD and QuestTarget never make two (HUD's localAnchor should call QuestTarget.Anchor).
-- Same parts / positions as HUD.luau findTravelTarget, L.MeadowTarget, L.BlacksmithTarget, L.StoryTap, L.PinnedTap and
-- refreshGuides:
--   travel to a zone : Crossroads pad Pad_<zone> -> gate Gate_<zone> -> anchor at the zone spawn (+3). From a faction
--                      town to the meadow: that island's bridge (Decor.Bridge_Halo / Bridge_Horns, L.MeadowTarget).
--                      From outside the Crossroads / faction towns the nearer of pad and gate (the pads stand in the
--                      Crossroads, so from the woods the meadow gate is the way, from a bridge the pad).
--   tutorial step 1/2 : the meadow (step 2 only while kills are left); nil inside the meadow
--   step 99           : visit / iron-gold goal -> the anvil (Crossroads); level goals -> the hunting zone
--   story Guide       : Blacksmith (anvil), SlimePond (pond spot), Fountain (CrownShard -> Fountain -> spot),
--                       Goose (GoosePerch -> Config.Goose.Position), OwnTown (Config.HomeZoneId), zone ids; other
--                       zones first route there with Travel. Talk / choice steps (Panel) have no place.
--   PumpkinPatch (A23-30, seasonal): outside the meadow -> Travel SlimeMeadow, in the meadow -> the south-end sign,
--                       in the passage -> the field centre, in the field -> nil; nil while the season is off.
--   HauntedHollow (A23-45, seasonal): west of the patch, its only way in is the gap in the patch's west fence: in the
--                       patch -> that gap, elsewhere -> the patch route, in the hollow -> nil.
-- Positions are studs. Nothing here yields; every Config read degrades to nil when a table is missing.
--
-- Public API (Init / Start are no-ops, so the module can be required directly or listed in ClientMain ORDER):
--   QuestTarget.Travel(zoneId, fromZone, pos?)        -> BasePart | nil
--   QuestTarget.Blacksmith()                          -> BasePart | nil
--   QuestTarget.Story(guide, fromZone, pos?, faction?) -> BasePart | Vector3 | nil
--   QuestTarget.ForEntry(entry, myZone?, faction?, pos?) -> { Part, Position, Tag, Label, Zone, Travel, Claim } | nil
--                                                        (Claim = the row is done and waits for [Claim]: QuestMarker gold)
--   QuestTarget.Anchor(key, position)                 -> BasePart (workspace.HUDGuideAnchor_<key>)
-- pos defaults to my character's position, myZone to the ZoneId attribute, faction to the Faction attribute.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local LocalPlayer = Players.LocalPlayer

local QuestTarget = {}

----------------------------------------------------------------- constants
local TUT = type(Config.Tutorial) == "table" and Config.Tutorial or {}
local TUT_STEPS = type(TUT.Steps) == "table" and TUT.Steps or {}
local STORY = type(Config.StoryQuests) == "table" and Config.StoryQuests or {}
local STORY_SPOTS = type(STORY.Landmarks) == "table" and STORY.Landmarks or {}

local K = {
	GuideZone = TUT.GuideZone or "SlimeMeadow", -- HUD TUT_GUIDE_ZONE
	GuideStep = TUT_STEPS.Guide or 1,
	QuestStep = TUT_STEPS.Quest or 2,
	DoneStep = TUT_STEPS.Done or 99,
	QuestKills = tonumber(TUT.QuestKills) or 5,
	Town = "Crossroads", -- the anvil, the fountain and the goose perch stand here
	IronTier = 3, -- QuestService IRON_TIER (the "next goal" iron weapon)
	AnchorPrefix = "HUDGuideAnchor_", -- HUD localAnchor name
	Lift = Vector3.new(0, 3, 0), -- anchor above a zone spawn (HUD findTravelTarget)
	FountainLift = Vector3.new(0, 4, 0), -- HUD L.StoryTap fountain fallback anchor
	HomeBridge = { HaloTown = "Bridge_Halo", HornsTown = "Bridge_Horns" }, -- HUD HOME_BRIDGE
	PadFrom = { Crossroads = true, HaloTown = true, HornsTown = true }, -- pads first from these (HUD order)
	NearShare = 0.75, -- a Near step's spot counts as reached inside this share of its Radius
	-- the anvil from outside the Crossroads: true = route to the Crossroads (Travel); false = nil like HUD's beam,
	-- which only shows inside the Crossroads (refreshGuides)
	SmithFromAfar = true,
	-- A23-30 PumpkinPatch: = MapBuilder PATCH (PathX 360 +- PassHalfW 9, PassFromZ 126 .. PassToZ 194, SignPos)
	Pumpkin = {
		Zone = "PumpkinPatch",
		Sign = Vector3.new(368, 3, 136), -- the meadow's south-end sign (Map.Landmarks.PumpkinPatchSign)
		SignName = "PumpkinPatchSign",
		Passage = { MinX = 351, MaxX = 369, MinZ = 126, MaxZ = 194 },
		Field = Vector3.new(360, 3, 235), -- used when Config.Zones.PumpkinPatch has no Center
		MeadowLand = "LandMeadow", -- Config.Map.Lands: counts as "in the meadow" even where ZoneId says Outskirts
	},
	-- A23-45 HauntedHollow: = MapBuilder HOLLOW (land x 160..280, z 185..295; WestGateZ 245 on the patch's west edge)
	Hollow = {
		Zone = "HauntedHollow",
		Gate = Vector3.new(280, 3, 245), -- the gap in the patch's west fence
		PatchLand = "LandPumpkinPatch", -- Config.Map.Lands: counts as "in the patch" even where ZoneId says Outskirts
	},
}

-- player-facing labels (A23-48: English only, names from docs/design/glossary_en_2026-10-06.md; zone names come from
-- Config.Zones NameEn when it is there)
local TXT = {
	Blacksmith = "Forge",
	Pond = "Slime Pond",
	Fountain = "Fountain",
	Goose = "Golden Goose Nest",
	PumpkinSign = "To the Pumpkin Patch",
}

----------------------------------------------------------------- state
local anchors = {} -- [key] = BasePart (workspace.HUDGuideAnchor_<key>)

----------------------------------------------------------------- helpers
local function attr(name, default)
	local v = LocalPlayer:GetAttribute(name)
	if v == nil then return default end
	return v
end

local function num(v, default)
	v = tonumber(v)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then return default end
	return v
end

local function myFaction()
	local f = attr("Faction", "None")
	if type(f) ~= "string" or f == "" then return "None" end
	return f
end

local function myPos()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then return root.Position end
	return nil
end

local function zoneDef(zoneId)
	local zones = type(Config.Zones) == "table" and Config.Zones or {}
	local z = type(zoneId) == "string" and zones[zoneId] or nil
	return type(z) == "table" and z or nil
end

-- a seasonal zone exists only while its season is on (Config.ZoneAt)
local function zoneLive(z)
	if z.Season == nil then return true end
	if type(Config.SeasonOn) ~= "function" then return false end
	local ok, on = pcall(Config.SeasonOn, z.Season)
	return ok and on == true
end

local function zoneName(zoneId)
	local z = zoneDef(zoneId)
	if not z then return nil end
	if type(z.NameEn) == "string" and z.NameEn ~= "" then return z.NameEn end
	return type(z.Name) == "string" and z.Name or nil
end

local function insideRect(p, minX, maxX, minZ, maxZ)
	return p ~= nil and p.X >= minX and p.X <= maxX and p.Z >= minZ and p.Z <= maxZ
end

local function insideZone(p, z)
	if p == nil or typeof(z.Center) ~= "Vector3" or typeof(z.Size) ~= "Vector3" then return false end
	return math.abs(p.X - z.Center.X) <= z.Size.X / 2 and math.abs(p.Z - z.Center.Z) <= z.Size.Z / 2
end

local function flatDist(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- same as HUD resolvePart: BasePart, Model (PrimaryPart / first part), Attachment parent, else the first descendant part
local function resolvePart(target)
	if typeof(target) ~= "Instance" then return nil end
	if target:IsA("BasePart") then return target end
	if target:IsA("Model") then
		return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
	end
	if target:IsA("Attachment") and target.Parent and target.Parent:IsA("BasePart") then
		return target.Parent
	end
	return target:FindFirstChildWhichIsA("BasePart", true)
end

-- workspace.Map.<folder>.<name> (nil when any piece is missing)
local function mapChild(folder, name)
	local map = workspace:FindFirstChild("Map")
	local f = map and map:FindFirstChild(folder)
	return f and f:FindFirstChild(name) or nil
end

----------------------------------------------------------------- anchors
-- local-only invisible anchor (HUD localAnchor): reuses HUD's part of the same name, else makes it once
function QuestTarget.Anchor(key, position)
	local a = anchors[key]
	if a and a.Parent then return a end
	local name = K.AnchorPrefix .. tostring(key)
	local found = workspace:FindFirstChild(name)
	if found and found:IsA("BasePart") then
		anchors[key] = found
		return found
	end
	a = Instance.new("Part")
	a.Name = name
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.CastShadow = false
	a.Transparency = 1
	a.Size = Vector3.new(1, 1, 1)
	a.Position = position
	a.Parent = workspace
	anchors[key] = a
	return a
end

----------------------------------------------------------------- travel
-- A23-30: meadow -> south-end sign -> passage -> field; nil in the field or while the season is off
local function pumpkinRoute(fromZone, pos)
	local P = K.Pumpkin
	local z = zoneDef(P.Zone)
	if not z or not zoneLive(z) then return nil end
	if fromZone == P.Zone or insideZone(pos, z) then return nil end
	local pass = P.Passage
	if insideRect(pos, pass.MinX, pass.MaxX, pass.MinZ, pass.MaxZ) then
		local field = typeof(z.Center) == "Vector3" and (z.Center + K.Lift) or P.Field
		return QuestTarget.Anchor("PumpkinField", field)
	end
	local inMeadow = fromZone == K.GuideZone
	if not inMeadow and pos then
		local lands = type(Config.Map) == "table" and type(Config.Map.Lands) == "table" and Config.Map.Lands or {}
		for _, l in lands do
			if type(l) == "table" and l.Name == P.MeadowLand
				and insideRect(pos, num(l.MinX, 0), num(l.MaxX, 0), num(l.MinZ, 0), num(l.MaxZ, 0)) then
				inMeadow = true
				break
			end
		end
	end
	if inMeadow then
		local sign = mapChild("Landmarks", P.SignName)
		local part = resolvePart(sign and (sign:FindFirstChild("Board") or sign))
		return part or QuestTarget.Anchor("PumpkinSign", P.Sign)
	end
	return QuestTarget.Travel(K.GuideZone, fromZone, pos)
end

-- Config.Map.Lands entry by name (nil when missing)
local function landRect(name)
	local lands = type(Config.Map) == "table" and type(Config.Map.Lands) == "table" and Config.Map.Lands or {}
	for _, l in lands do
		if type(l) == "table" and l.Name == name then return l end
	end
	return nil
end

-- A23-45: in the patch -> the gap in its west fence; elsewhere the patch route; nil in the hollow / out of season
local function hollowRoute(fromZone, pos)
	local H = K.Hollow
	local z = zoneDef(H.Zone)
	if not z or not zoneLive(z) then return nil end
	if fromZone == H.Zone or insideZone(pos, z) then return nil end
	local inPatch = fromZone == K.Pumpkin.Zone
	if not inPatch and pos then
		local l = landRect(H.PatchLand)
		inPatch = l ~= nil and insideRect(pos, num(l.MinX, 0), num(l.MaxX, 0), num(l.MinZ, 0), num(l.MaxZ, 0))
	end
	if inPatch then return QuestTarget.Anchor("HollowGate", H.Gate) end
	return pumpkinRoute(fromZone, pos)
end

-- the zone's Crossroads pad, its gate, else an anchor at its spawn (+3); see the header for the faction-town bridge
-- and the pad / gate choice. nil when fromZone already is zoneId or the zone does not exist (or is out of season).
function QuestTarget.Travel(zoneId, fromZone, pos)
	local z = zoneDef(zoneId)
	if not z or not zoneLive(z) then return nil end
	if type(fromZone) ~= "string" then fromZone = "" end
	if zoneId == K.Pumpkin.Zone then return pumpkinRoute(fromZone, pos or myPos()) end
	if zoneId == K.Hollow.Zone then return hollowRoute(fromZone, pos or myPos()) end
	if fromZone == zoneId then return nil end
	-- L.MeadowTarget: from a faction town the meadow beam first points at that island's bridge
	local bridge = zoneId == K.GuideZone and K.HomeBridge[fromZone] or nil
	if bridge then
		local part = resolvePart(mapChild("Decor", bridge))
		if part then return part end
	end
	local pad = resolvePart(mapChild("Pads", "Pad_" .. zoneId))
	local gate = resolvePart(mapChild("Gates", "Gate_" .. zoneId))
	if pad and gate and fromZone ~= "" and not K.PadFrom[fromZone] then
		pos = pos or myPos()
		if pos then
			return flatDist(pos, pad.Position) <= flatDist(pos, gate.Position) and pad or gate
		end
	end
	if pad or gate then return pad or gate end
	if typeof(z.Spawn) ~= "Vector3" then return nil end
	return QuestTarget.Anchor(zoneId, z.Spawn + K.Lift)
end

----------------------------------------------------------------- spots
-- L.BlacksmithTarget: the anvil of the artisan guild
function QuestTarget.Blacksmith()
	local guild = mapChild("Landmarks", "ArtisanGuild")
	local anvil = guild and guild:FindFirstChild("Anvil")
	return anvil and anvil:IsA("BasePart") and anvil or nil
end

-- L.StoryTap "Fountain": the shard in the fountain, the fountain itself, else the Config spot (+4)
local function fountainTarget()
	local shard = mapChild("Landmarks", "CrownShard")
	local part = shard and (shard:IsA("BasePart") and shard or shard:FindFirstChildWhichIsA("BasePart", true))
	if part then return part end
	local fountain = mapChild("Landmarks", "Fountain")
	if fountain then
		part = (fountain:IsA("BasePart") and fountain)
			or (fountain:IsA("Model") and fountain.PrimaryPart) or fountain:FindFirstChildWhichIsA("BasePart", true)
		if part then return part end
	end
	local spot = STORY_SPOTS.Fountain
	return typeof(spot) == "Vector3" and (spot + K.FountainLift) or nil
end

-- the goose perch (MapBuilder GoosePerch), else Config.Goose.Position at hover height
local function gooseTarget()
	local perch = resolvePart(mapChild("Landmarks", "GoosePerch"))
	if perch then return perch end
	local goose = type(Config.Goose) == "table" and Config.Goose or {}
	if typeof(goose.Position) ~= "Vector3" then return nil end
	return goose.Position + Vector3.new(0, num(goose.HoverHeight, 4), 0)
end

-- L.StoryTap "SlimePond": Config.StoryQuests.Landmarks.SlimePond (+3) = HUD STORY_SPOT
local function pondSpot()
	local spot = STORY_SPOTS.SlimePond
	return typeof(spot) == "Vector3" and (spot + K.Lift) or Vector3.new(280, 3, -45)
end

-- the zone a story Guide happens in (L.StoryTap's target mapping)
local function guideZone(guide, faction)
	if guide == "OwnTown" then
		return type(Config.HomeZoneId) == "function" and Config.HomeZoneId(faction or myFaction()) or K.Town
	end
	if guide == "SlimePond" then return K.GuideZone end
	if guide == "Fountain" or guide == "Goose" or guide == "Blacksmith" then return K.Town end
	return guide
end

local function smithFrom(fromZone, pos)
	if fromZone == K.Town then return QuestTarget.Blacksmith() end
	if not K.SmithFromAfar then return nil end
	return QuestTarget.Travel(K.Town, fromZone, pos)
end

-- where a story step's Guide points from fromZone: a travel target while I am in another zone, the spot inside it,
-- nil when there is nothing to point at (already in a plain zone guide's zone, unknown guide)
function QuestTarget.Story(guide, fromZone, pos, faction)
	if type(guide) ~= "string" or guide == "" then return nil end
	if type(fromZone) ~= "string" then fromZone = attr("ZoneId", "") end
	if guide == "Blacksmith" then return smithFrom(fromZone, pos) end
	local zone = guideZone(guide, faction)
	if not zoneDef(zone) then return nil end
	if zone == K.Pumpkin.Zone or zone == K.Hollow.Zone or fromZone ~= zone then return QuestTarget.Travel(zone, fromZone, pos) end
	if guide == "SlimePond" then return pondSpot() end
	if guide == "Fountain" then return fountainTarget() end
	if guide == "Goose" then return gooseTarget() end
	return nil -- a plain zone guide: I am already there
end

----------------------------------------------------------------- quest rows
-- the step's objective (the faction variant first, e.g. M2_1 Neutral), for Near radii
local function stepObj(st, faction)
	local defs = type(STORY.Defs) == "table" and STORY.Defs or {}
	local def = defs[st.Id]
	local steps = type(def) == "table" and type(def.Steps) == "table" and def.Steps or nil
	local step = steps and steps[math.floor(num(st.St, 1))] or nil
	if type(step) ~= "table" then return nil end
	local variant = type(faction) == "string" and step[faction] or nil
	if type(variant) == "table" and type(variant.Obj) == "table" then return variant.Obj end
	return type(step.Obj) == "table" and step.Obj or nil
end

local function storyLabel(guide, zone)
	if guide == "Blacksmith" then return TXT.Blacksmith end
	if guide == "SlimePond" then return TXT.Pond end
	if guide == "Fountain" then
		local speakers = type(STORY.SpeakersEn) == "table" and STORY.SpeakersEn or {}
		return type(speakers.Fountain) == "string" and speakers.Fountain or TXT.Fountain
	end
	if guide == "Goose" then return TXT.Goose end
	return zoneName(zone)
end

-- result table (nil when t resolves to nothing)
local function pack(t, tag, label, zone, travel)
	local part = typeof(t) == "Instance" and resolvePart(t) or nil
	local p = part and part.Position or (typeof(t) == "Vector3" and t or nil)
	if not p then return nil end
	return { Part = part, Position = p, Tag = tag, Label = label, Zone = zone, Travel = travel == true }
end

-- step 2 counts as "needs the meadow" only while kills are left (L.NeedsMeadowGuide)
local function needsMeadow(step, entry)
	if step == K.GuideStep then return true end
	if step ~= K.QuestStep then return false end
	local kills = num(attr("TutorialKills", nil), nil) or num(entry.Progress, 0)
	return kills < K.QuestKills
end

local function storyEntry(st, myZone, faction, pos)
	if st.Panel then return nil end -- a talk / choice card: no place
	local guide = st.Guide
	if type(guide) ~= "string" or guide == "" then return nil end
	local zone = guideZone(guide, faction)
	local t = QuestTarget.Story(guide, myZone, pos, faction)
	if t == nil then return nil end
	local travel = myZone ~= zone or zone == K.Pumpkin.Zone or zone == K.Hollow.Zone
	local r = pack(t, "story:" .. guide, storyLabel(guide, zone), zone, travel)
	if not r or travel or not pos then return r end
	-- a Near step (pond slimes, the fountain) already happens inside its radius
	local obj = stepObj(st, faction)
	local radius = type(obj) == "table" and num(obj.Radius, nil) or nil
	if radius and flatDist(pos, r.Position) <= radius * K.NearShare then return nil end
	return r
end

-- the row is done and waits for [Claim] (HUD refreshQuests canClaim)
local function claimable(entry)
	return entry.CanClaim == true and num(entry.Progress, 0) >= num(entry.Target, 1)
		and (entry.Pinned == true or entry.Kind == "Daily" or entry.Kind == "Sub")
end

-- the pinned / next-goal / story row's place (L.PinnedTap + refreshGuides), nil where nothing points anywhere:
-- step 0 (the guide talk), a talk / choice step, daily rows, or when I already stand where it happens
local function placeFor(entry, myZone, faction, pos)
	if type(entry.Story) == "table" then return storyEntry(entry.Story, myZone, faction, pos) end
	if entry.Pinned ~= true then return nil end
	local step = num(entry.TutorialStep, -1)
	if step == K.GuideStep or step == K.QuestStep then
		if not needsMeadow(step, entry) or myZone == K.GuideZone then return nil end
		return pack(QuestTarget.Travel(K.GuideZone, myZone, pos), "tutorial", zoneName(K.GuideZone), K.GuideZone, true)
	end
	if step ~= K.DoneStep then return nil end
	-- step 99: the blacksmith visit and the iron-weapon gold goal go to the anvil (L.PinnedTap -> doUpgrade)
	local level = math.floor(num(attr("Level", 1), 1))
	local weapons = type(Config.Weapons) == "table" and Config.Weapons or {}
	local iron = weapons[K.IronTier]
	local text = type(entry.Text) == "string" and entry.Text or ""
	-- the gold goal row (HUD L.PinnedTap: the Korean word or, since A23-48, "gold")
	local ironGold = type(iron) == "table" and level >= num(iron.MinLevel, math.huge)
		and (string.find(text, "골드", 1, true) ~= nil or string.find(string.lower(text), "gold", 1, true) ~= nil)
	if entry.NextGoal ~= true or ironGold then
		if entry.NextGoal ~= true and attr("BlacksmithVisited", false) == true then return nil end
		return pack(smithFrom(myZone, pos), "blacksmith", TXT.Blacksmith, K.Town, myZone ~= K.Town)
	end
	-- level goals: the zone I level up in (QuestZoneForLevel = the meadow below Lv10, like L.PinnedTap)
	local zone = type(Config.QuestZoneForLevel) == "function" and Config.QuestZoneForLevel(level) or K.GuideZone
	if myZone == zone then return nil end
	return pack(QuestTarget.Travel(zone, myZone, pos), "zone:" .. tostring(zone), zoneName(zone), zone, true)
end

function QuestTarget.ForEntry(entry, myZone, faction, pos)
	if type(entry) ~= "table" then return nil end
	if type(myZone) ~= "string" then myZone = attr("ZoneId", "") end
	if type(faction) ~= "string" or faction == "" then faction = myFaction() end
	local r = placeFor(entry, myZone, faction, pos or myPos())
	if r then r.Claim = claimable(entry) end
	return r
end

----------------------------------------------------------------- lifecycle (nothing to set up)
function QuestTarget.Init(_registry) end

function QuestTarget.Start() end

return QuestTarget
]]></ProtectedString>
					<string name="ScriptGuid">{2F7DDA0D-35C7-459F-BA0D-5E19C751A346}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">QuestTarget</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7c99063480b229a50ad663aa000008c3</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX56828C3171D24E3781869115B5BCDEB9">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- SkillBar.luau : the three skill buttons Q · Z · X (SPEC_ADDENDUM A23-49, docs/design/skill_kit_beta_2026-10-06.md §6)
-- in the bottom-right combat cluster, on HudLayout's rects q / z / x (C.HUD.Layout, read again after every HUD layout pass
-- through SkillBar.Relayout).
--   look   : the round skill disc (Config.UIArt "BtnSkill<Faction>" when that art exists, else the approved "BtnSpecial"),
--            my kit's icon (Skill_<Kit>_<Slot>, ~74% of the disc; Blacksmith Q / Z use Warrior's, Alchemist Q / Z Mage's
--            in the beta); on PCs the name pill on the lower rim (NameEn) and the key badge (Keybinds.Label, keyboards
--            only); phones show the icon only (§6-2). A23-60 (user 2026-10-06): no MP number on the button - the MP cost
--            lives in the skill's description only
--   state  : cooling down = a dark radial sweep + whole seconds left (attributes SkillReadyAt / SkillReadyAtZ /
--            SkillReadyAtX), then a short white flash; MP short = the whole button dimmed (a press says "Not enough
--            MP"); locked (Level < Unlock) = shaded face + lock glyph + "Lv N"; a slot whose flag is off
--            (Config.Skills.ZEnabled / XEnabled) stays hidden and keeps its rect free
--   input  : a press = SkillBar.Use(slot): one press, one cast. Inside the 0.5 s gap between casts one press waits in
--            line (white rim) and goes when the gap ends. Refused here (locked, cooling, MP) -> the button shakes and a
--            short word floats up. Q goes through HUD.Release (the live Release remote) until SkillService's UseSkill
--            remote exists; Z / X fire UseSkill(slot) (SKL-2). HUD's key dispatch sends SkillQ / SkillZ / SkillX here.
--   Studio : the local attribute SkillBarPreview = true shows Z / X with their flags off (UiSandbox captures only)
-- Presentation + input only: the server decides every cast (MP, cooldown, targets).
--
-- Public API: SkillBar.Init(C), SkillBar.Start(), SkillBar.Relayout(), SkillBar.Use(slot) -> bool, SkillBar.Owns(slot)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local LocalPlayer = Players.LocalPlayer

local SkillBar = {}

local TAG = "SkillBar"
local C = nil -- client registry (set in Init)
local UIKit = nil -- C.UIKit (set in Start)

----------------------------------------------------------------- tuning
local IS_TOUCH = UserInputService.TouchEnabled -- the same rule as HUD (HudLayout's touch rects)
local T = {
	Slots = { "Q", "Z", "X" },
	Rect = { Q = "q", Z = "z", X = "x" }, -- HudLayout ids
	Ready = { Q = "SkillReadyAt", Z = "SkillReadyAtZ", X = "SkillReadyAtX" }, -- server attributes (os time)
	Flag = { Z = "ZEnabled", X = "XEnabled" }, -- Config.Skills flags (Q is always on)
	Unlock = { Q = 1, Z = 5, X = 8 }, -- Config.Skills.Unlock wins when it is there
	Action = { Q = "SkillQ", Z = "SkillZ", X = "SkillX" }, -- Keybinds actions
	Gap = 0.5, -- s: the global gap between two casts (one press waits in line)
	Tick = 0.1, -- s: cooldown sweep / seconds refresh
	Icon = 0.74, -- icon / disc (skill_kit §6-2)
	FaceX = 0.5, FaceY = 0.47, Face = 0.72, -- the disc's inner circle (scale of the button)
	Disc = "BtnSpecial", -- the approved skill disc (BtnSkill art)
	Rim = { Halo = "BtnSkillHalo", Horns = "BtnSkillHorns", Neutral = "BtnSkillNeutral" }, -- faction rims when drawn
	Sweep = 0.4, -- transparency of the cooldown shade
	Shake = { 7, -6, 4, -2, 0 }, -- degrees, one step each
	ShakeStep = 0.035,
	FloatTime = 0.7, -- s: the refusal word floats up and fades
	Flash = 0.28, -- s: the ready flash
	MinTap = 60, -- du (HudLayout MIN_TAP; the rects are already >= it on touch)
}
-- beta: the artisan kits reuse the base class's Q / Z art (skill_kit §7)
local REUSE = { Blacksmith = "Warrior", Alchemist = "Mage" }

local COL = {
	White = Color3.new(1, 1, 1),
	Black = Color3.new(0, 0, 0),
	Navy = Color3.fromRGB(26, 40, 79),
	Gold = Color3.fromRGB(240, 190, 60),
	Bad = Color3.fromRGB(225, 50, 50),
	Dim = Color3.fromRGB(150, 150, 160),
	Locked = Color3.fromRGB(105, 105, 118),
	Fallback = Color3.fromRGB(56, 144, 253), -- the disc when its art is missing (QuestBlue)
}

-- player-facing words (A23-48: English only, short for kids)
local TXT = {
	Default = { Q = "Skill", Z = "Skill 2", X = "Skill 3" }, -- until Config.Skills.Defs names the kit's skills
	Level = "Lv %d",
	Unlock = "Unlocks at Lv %d",
	NeedMP = "Not enough MP",
	Wait = "Not yet",
}

----------------------------------------------------------------- state
local S = {
	built = false,
	gapUntil = 0, -- os.clock(): the next cast may go
	queued = nil, -- the slot waiting in line
	queueToken = 0,
	layoutRef = nil,
	lastWarnAt = -math.huge,
}
local ui = {} -- root, buttons = { [slot] = b }
local acc = { Tick = 0 }

----------------------------------------------------------------- helpers
local function warnThrottled(msg)
	local now = os.clock()
	if now - S.lastWarnAt < 10 then return end
	S.lastWarnAt = now
	Util.Warn(TAG, msg)
end

local function guard(fn, what)
	local ok, err = pcall(fn)
	if not ok then warnThrottled(what .. " error: " .. tostring(err)) end
end

local function attr(name, default)
	local v = LocalPlayer:GetAttribute(name)
	if v == nil then return default end
	return v
end

local function num(name, default)
	local v = tonumber(attr(name, default))
	if v == nil or v ~= v then return default end
	return v
end

local function skills()
	return type(Config.Skills) == "table" and Config.Skills or {}
end

local function preview()
	return RunService:IsStudio() and attr("SkillBarPreview", false) == true
end

-- the slot is in the game today (Q always; Z / X behind their Config.Skills flags)
local function slotOn(slot)
	if slot == "Q" then return true end
	return skills()[T.Flag[slot]] == true or preview()
end

local function unlockLevel(slot)
	local u = skills().Unlock
	return math.floor(tonumber(type(u) == "table" and u[slot] or nil) or T.Unlock[slot] or 1)
end

local function myClass()
	local c = attr("Class", "Warrior")
	if type(c) ~= "string" or type(Config.Classes) ~= "table" or not Config.Classes[c] then return "Warrior" end
	return c
end

local function myFaction()
	local f = attr("Faction", "None")
	if type(f) ~= "string" or f == "" then return "None" end
	return f
end

-- the skill kit of my class in my faction (Config.SkillKit once SKL-1 adds it)
local function kitOf(class, faction)
	if type(Config.SkillKit) == "function" then
		local ok, k = pcall(Config.SkillKit, class, faction)
		if ok and type(k) == "string" and k ~= "" then return k end
	end
	if faction == "Neutral" then
		if type(Config.IsTamer) == "function" and Config.IsTamer(class, faction) then return "Tamer" end
		if class == "Warrior" then return "Blacksmith" end
		if class == "Mage" then return "Alchemist" end
	end
	return class
end

-- { MP, CD, Name } of a slot for my kit; Q falls back to Config.BasicSkill, names to TXT.Default
local function defOf(slot)
	local class, faction = myClass(), myFaction()
	local def = nil
	if type(Config.SkillDef) == "function" then
		local ok, d = pcall(Config.SkillDef, class, faction, slot)
		if ok and type(d) == "table" then def = d end
	end
	if not def then
		local defs = skills().Defs
		local kit = type(defs) == "table" and defs[kitOf(class, faction)] or nil
		def = type(kit) == "table" and type(kit[slot]) == "table" and kit[slot] or nil
	end
	local basic = type(Config.BasicSkill) == "table" and Config.BasicSkill or {}
	local out = {
		MP = tonumber(def and def.MP) or (slot == "Q" and tonumber(basic.ManaCost) or 0) or 0,
		CD = tonumber(def and def.CD) or (slot == "Q" and tonumber(basic.Cooldown) or 3) or 3,
		Name = def and def.NameEn or nil,
	}
	-- X: the faction's own name (Guardian Roar / Rage Roar ...)
	local fx = def and type(def[faction]) == "table" and def[faction] or nil
	if fx and type(fx.NameEn) == "string" then out.Name = fx.NameEn end
	if type(out.Name) ~= "string" or out.Name == "" then out.Name = TXT.Default[slot] end
	return out
end

local function iconKey(slot)
	if attr("ClassChosen", false) ~= true then return "IconSpecial" end
	local kit = kitOf(myClass(), myFaction())
	local key = "Skill_" .. kit .. "_" .. slot
	if UIKit.ArtId(key) then return key end
	local base = REUSE[kit]
	if base and UIKit.ArtId("Skill_" .. base .. "_" .. slot) then return "Skill_" .. base .. "_" .. slot end
	return "IconSpecial"
end

local function discKey()
	local rim = T.Rim[myFaction()]
	if rim and UIKit.ArtId(rim) then return rim end
	return T.Disc
end

-- MainGui's UIScale
local function guiScale()
	local gui = UIKit and UIKit.Gui
	local sc = gui and gui:FindFirstChildOfClass("UIScale")
	return (sc and sc.Scale > 0) and sc.Scale or 1
end

----------------------------------------------------------------- building
local function corner(r)
	return UIKit.Create("UICorner", { CornerRadius = r or UDim.new(0.5, 0) })
end

-- a dark half disc inside a half-width clip; its UIGradient's sharp step turns to show / hide the wedge
local function sweepHalf(parent, right)
	-- the left clip is 1 px wider than half, so the two halves never leave a hairline gap down the middle; each shade is
	-- still exactly the face's circle (2 x the clip minus that px)
	local clip = UIKit.Create("Frame", {
		Name = right and "Right" or "Left",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromScale(right and 0.5 or 0, 0),
		Size = right and UDim2.fromScale(0.5, 1) or UDim2.new(0.5, 1, 1, 0),
		ZIndex = 4,
		Active = false,
		Parent = parent,
	})
	local disc = UIKit.Create("Frame", {
		Name = "Shade",
		BackgroundColor3 = COL.Black,
		BackgroundTransparency = T.Sweep,
		Position = right and UDim2.fromScale(-1, 0) or UDim2.fromScale(0, 0),
		Size = right and UDim2.fromScale(2, 1) or UDim2.new(2, -2, 1, 0),
		ZIndex = 4,
		Active = false,
		Parent = clip,
	}, { corner() })
	local grad = UIKit.Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.499, 0),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = disc,
	})
	return grad
end

-- the shade over the disc for `left` (0..1 of the cooldown still to go): the elapsed part (from 12 o'clock, clockwise)
-- is clear, the rest dark. A sharp-step gradient's dark side faces away from its axis; axis angle = elapsed + 180
local function setSweep(b, left)
	left = math.clamp(left, 0, 1)
	local full = left >= 0.999
	local shown = left > 0.001 and not full
	if b.Sweep.Visible ~= shown then b.Sweep.Visible = shown end
	if b.Full.Visible ~= full then b.Full.Visible = full end
	if not shown then return end
	local e = 360 * (1 - left)
	b.SweepR.Rotation = math.min(e, 180) + 180
	b.SweepL.Rotation = math.max(e, 180) + 180
end

local function smallLabel(props, style)
	props.BackgroundTransparency = 1
	props.Active = false
	if type(UIKit.StyledLabel) == "function" then return UIKit.StyledLabel(props, style) end
	props.TextColor3 = COL.White
	props.TextScaled = true
	return UIKit.Create("TextLabel", props)
end

local function buildButton(slot)
	local b = { Slot = slot }
	local holder = UIKit.Create("TextButton", {
		Name = "Skill" .. slot,
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(72, 72),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 2,
		Parent = ui.root,
	}, { UIKit.Create("UIScale", { Name = "PressScale" }) })
	b.Holder = holder
	if type(UIKit.ButtonFeel) == "function" then UIKit.ButtonFeel(holder, { Fast = true }) end
	holder.Activated:Connect(function()
		SkillBar.Use(slot)
	end)

	b.Disc = UIKit.ArtFrame(discKey(), {
		Name = "Disc", Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = holder,
	}, { Color = COL.Fallback, BackgroundTransparency = 0.08, CornerRadius = UDim.new(0.5, 0), StrokeColor = COL.White,
		StrokeThickness = 4, StrokeTransparency = 0.35 })
	b.DiscKey = discKey()

	-- the face = a square on the disc's inner circle (BtnSpecial Inner 61,57 .. 450,425 of 512: centre 0.5 / 0.47, the
	-- shorter side 0.72): the cooldown shade and the seconds; the icon sits under it on the holder
	local face = UIKit.Create("Frame", {
		Name = "Face",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(T.FaceX, T.FaceY),
		Size = UDim2.fromScale(T.Face, T.Face),
		ZIndex = 4,
		Active = false,
		Parent = holder,
	})
	b.Face = face
	b.IconKey = nil
	b.Sweep = UIKit.Create("Frame", {
		Name = "Sweep", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Active = false,
		Visible = false, Parent = face,
	})
	b.SweepL = sweepHalf(b.Sweep, false)
	b.SweepR = sweepHalf(b.Sweep, true)
	b.Full = UIKit.Create("Frame", { -- the whole face shaded: one disc, no seam
		Name = "Full", BackgroundColor3 = COL.Black, BackgroundTransparency = T.Sweep, Size = UDim2.fromScale(1, 1),
		ZIndex = 4, Active = false, Visible = false, Parent = face,
	}, { corner() })
	b.Seconds = smallLabel({
		Name = "Seconds", Text = "", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.42), TextScaled = true, ZIndex = 6, Visible = false, Parent = face,
	}, "Number")

	-- locked: lock glyph (+ "Lv N" on PCs)
	b.Lock = UIKit.ArtImage("GlyphLock", {
		Name = "Lock", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromScale(0.34, 0.34), ZIndex = 7, Visible = false, Active = false, Parent = holder,
	})
	b.LockText = smallLabel({
		Name = "Level", Text = "", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.68),
		Size = UDim2.fromScale(0.66, 0.24), TextScaled = true, ZIndex = 7, Visible = false, Parent = holder,
	}, "Number")

	-- PCs: the name pill on the lower rim, the key badge in the lower right (keyboards)
	if not IS_TOUCH then
		b.Pill = UIKit.Create("Frame", {
			Name = "Name", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.9),
			Size = UDim2.fromScale(0.96, 0.22), BackgroundColor3 = COL.Navy, BackgroundTransparency = 0.12, ZIndex = 7,
			Active = false, Parent = holder,
		}, { corner() })
		b.PillText = smallLabel({
			Name = "Text", Text = "", Size = UDim2.fromScale(1, 1), TextScaled = true, ZIndex = 8, Parent = b.Pill,
		}, "Button")
	end
	local kb = C and C.Keybinds
	local showKeys = type(kb) == "table" and type(kb.ShowsKeys) == "function" and kb.ShowsKeys() or false
	if showKeys then
		b.Key = smallLabel({
			Name = "Key", Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromScale(0.3, 0.3), TextScaled = true, ZIndex = 9, Parent = holder,
		}, "Number")
	end

	-- queued press (white) / ready flash rim
	b.Ring = UIKit.Create("Frame", {
		Name = "Ring", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 8, Active = false,
		Parent = holder,
	}, {
		corner(),
		UIKit.Create("UIStroke", { Name = "Stroke", Color = COL.White, Thickness = 3, Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	b.RingStroke = b.Ring:FindFirstChild("Stroke")

	-- the refusal word above the button
	b.Word = smallLabel({
		Name = "Word", Text = "", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, -0.05),
		Size = UDim2.fromScale(1.6, 0.3), TextScaled = true, ZIndex = 10, Visible = false, Parent = holder,
	}, "NameTag")
	ui.buttons[slot] = b
	return b
end

----------------------------------------------------------------- refresh
local function setIcon(b)
	local key = iconKey(b.Slot)
	if b.IconKey == key and b.Icon and b.Icon.Parent then return end
	b.IconKey = key
	if b.Icon then b.Icon:Destroy() end
	b.Icon = UIKit.ArtImage(key, {
		Name = "Icon", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(T.FaceX, T.FaceY),
		Size = UDim2.fromScale(T.Icon, T.Icon), ZIndex = 3, Active = false, Parent = b.Holder,
	})
end

-- the slot's live state: { On, Locked, Unlock, Left (s), Frac (0..1 of the cooldown still to go), MPShort, Def }
local function stateOf(slot)
	local def = defOf(slot)
	local unlock = unlockLevel(slot)
	local level = math.floor(num("Level", 1))
	local readyAt = num(T.Ready[slot], 0)
	local left = math.max(0, readyAt - Util.Now())
	return {
		On = slotOn(slot),
		Locked = level < unlock,
		Unlock = unlock,
		Left = left,
		Frac = def.CD > 0 and math.clamp(left / def.CD, 0, 1) or 0,
		MPShort = num("Mana", 0) < def.MP,
		Def = def,
	}
end

local function paintButton(b)
	local st = stateOf(b.Slot)
	b.State = st
	local visible = st.On
	if b.Holder.Visible ~= visible then b.Holder.Visible = visible end
	if not visible then return end
	setIcon(b)
	if b.Icon and b.Icon:IsA("ImageLabel") then
		b.Icon.ImageColor3 = (st.Locked and COL.Locked) or (st.MPShort and COL.Dim) or COL.White
	end
	if st.Locked then setSweep(b, 1) end -- the face stays shaded while locked (the 10 Hz tick leaves it alone)
	-- MP short: the whole button dims (A23-60: no MP number on it)
	if b.Disc and b.Disc:IsA("ImageLabel") then b.Disc.ImageColor3 = (st.MPShort and not st.Locked) and COL.Dim or COL.White end
	if b.Lock then b.Lock.Visible = st.Locked end
	if b.LockText then
		b.LockText.Visible = st.Locked
		b.LockText.Text = string.format(TXT.Level, st.Unlock)
	end
	if b.PillText then b.PillText.Text = st.Def.Name end
	if b.Pill then b.Pill.Visible = not st.Locked end
	if b.Key then
		-- only a key that works now (Keybinds.IsLive: SkillZ / SkillX are live once their flags are on)
		local kb = C and C.Keybinds
		local action = T.Action[b.Slot]
		local text = ""
		if type(kb) == "table" and type(kb.Label) == "function" and type(kb.IsLive) == "function" then
			local okLive, live = pcall(kb.IsLive, action)
			local okLabel, label = pcall(kb.Label, action)
			if okLive and live and okLabel and type(label) == "string" then text = label end
		end
		b.Key.Text = text
		b.Key.Visible = text ~= ""
	end
	-- the disc art follows my faction's rim when that art exists
	local key = discKey()
	if key ~= b.DiscKey and b.Disc and b.Disc:IsA("ImageLabel") then
		local def = UIKit.ArtPart and UIKit.ArtPart(key)
		if def and def.Id then
			b.Disc.Image = def.Id
			b.DiscKey = key
		end
	end
end

local function flash(b)
	local s = b.RingStroke
	if not s then return end
	s.Color = COL.White
	s.Transparency = 0
	TweenService:Create(s, TweenInfo.new(T.Flash, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
end

-- 10 Hz: cooldown shade + seconds, the ready flash
local function tickButton(b)
	local st = b.State
	if not st or not st.On or st.Locked then return end
	local left = math.max(0, num(T.Ready[b.Slot], 0) - Util.Now())
	local frac = st.Def.CD > 0 and math.clamp(left / st.Def.CD, 0, 1) or 0
	setSweep(b, frac)
	local cooling = left > 0.05
	b.Seconds.Visible = cooling
	if cooling then b.Seconds.Text = tostring(math.ceil(left)) end
	if b.WasCooling and not cooling then
		flash(b)
		local fx = C and C.Fx
		if type(fx) == "table" and type(fx.PlaySound) == "function" then pcall(fx.PlaySound, "Click") end
		guard(function() paintButton(b) end, "paint")
	end
	b.WasCooling = cooling
end

local function refreshAll()
	for _, slot in T.Slots do
		local b = ui.buttons[slot]
		if b then guard(function() paintButton(b) end, "paint " .. slot) end
	end
end

----------------------------------------------------------------- refusals / queue
local function shake(b, word)
	local h = b.Holder
	b.ShakeToken = (b.ShakeToken or 0) + 1
	local token = b.ShakeToken
	task.spawn(function()
		for _, deg in T.Shake do
			if b.ShakeToken ~= token then return end
			h.Rotation = deg
			task.wait(T.ShakeStep)
		end
	end)
	if word and word ~= "" then
		local w = b.Word
		w.Text = word
		w.Visible = true
		w.TextTransparency = 0
		w.Position = UDim2.fromScale(0.5, -0.05)
		local info = TweenInfo.new(T.FloatTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(w, info, { Position = UDim2.fromScale(0.5, -0.35), TextTransparency = 1 }):Play()
		local stroke = w:FindFirstChildWhichIsA("UIStroke")
		if stroke then
			stroke.Transparency = 0
			TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		end
		task.delay(T.FloatTime, function()
			if b.ShakeToken == token then w.Visible = false end
		end)
	end
end

local function showQueue(slot, on)
	for s, b in ui.buttons do
		if b.RingStroke then
			local mine = on and s == slot
			b.RingStroke.Color = COL.White
			b.RingStroke.Transparency = mine and 0 or 1
		end
	end
end

local function remote(name)
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild(name)
	return (r and r:IsA("RemoteEvent")) and r or nil
end

local function cast(slot)
	S.gapUntil = os.clock() + T.Gap
	if slot == "Q" then
		local hud = C and C.HUD
		if type(hud) == "table" and type(hud.Release) == "function" then
			guard(hud.Release, "release")
			return
		end
	end
	local r = remote("UseSkill") -- SKL-2 SkillService
	if r then
		r:FireServer(slot)
	elseif slot == "Q" then
		local rel = remote("Release")
		if rel then rel:FireServer() end
	end
end

-- after the gap: the press that waited in line goes (if it still may)
local function flushQueue()
	S.queueToken += 1
	local token = S.queueToken
	task.delay(math.max(0, S.gapUntil - os.clock()), function()
		if S.queueToken ~= token or not S.queued then return end
		local slot = S.queued
		S.queued = nil
		showQueue(slot, false)
		SkillBar.Use(slot)
	end)
end

----------------------------------------------------------------- layout
local function placeAll()
	local hud = C and C.HUD
	local layout = type(hud) == "table" and hud.Layout or nil
	local rects = type(layout) == "table" and type(layout.Rects) == "table" and layout.Rects or nil
	for _, slot in T.Slots do
		local b = ui.buttons[slot]
		local r = rects and rects[T.Rect[slot]] or nil
		if b and type(r) == "table" and tonumber(r.W) then
			b.Holder.Position = UDim2.fromOffset(r.X + r.W / 2, r.Y + r.H / 2)
			b.Holder.Size = UDim2.fromOffset(r.W, r.H)
		end
	end
	-- the words / pills keep a readable size on every UIScale (UIKit text styles floor them)
	local s = guiScale()
	for _, b in ui.buttons do
		if b.Word then b.Word.Size = UDim2.new(1.6, 0, 0, math.ceil(14 / s)) end
	end
end

----------------------------------------------------------------- public API
function SkillBar.Owns(slot)
	return S.built and ui.buttons[slot] ~= nil
end

-- one press of a skill (button, key or pad). false when refused here (the button shook)
function SkillBar.Use(slot)
	local b = ui.buttons[slot]
	if not b or not b.Holder.Visible then return false end
	local hud = C and C.HUD
	if type(hud) == "table" and type(hud.InputAllowed) == "function" then
		local ok, allowed = pcall(hud.InputAllowed)
		if ok and allowed == false then return false end
	end
	local st = stateOf(slot)
	b.State = st
	if st.Locked then
		shake(b, string.format(TXT.Unlock, st.Unlock))
		return false
	end
	if st.Left > 0.05 then
		shake(b, TXT.Wait)
		return false
	end
	if st.MPShort then
		shake(b, TXT.NeedMP)
		local audio = C and C.Audio -- the 'no' sound once Audio.luau exists (quality ideas ①)
		if type(audio) == "table" and type(audio.Play) == "function" then pcall(audio.Play, "No") end
		return false
	end
	if os.clock() < S.gapUntil then
		-- inside the gap between casts: this press waits in line (the newest one wins)
		S.queued = slot
		showQueue(slot, true)
		flushQueue()
		return true
	end
	cast(slot)
	return true
end

function SkillBar.Relayout()
	if not S.built then return end
	guard(placeAll, "layout")
end

function SkillBar.Init(registry)
	C = registry
end

function SkillBar.Start()
	UIKit = C and C.UIKit
	if type(UIKit) ~= "table" or not UIKit.Gui then
		Util.Warn(TAG, "UIKit is not initialized")
		return
	end
	local ok, err = pcall(function()
		ui.buttons = {}
		ui.root = UIKit.Create("Frame", {
			Name = "SkillBar", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Active = false,
			Parent = UIKit.Gui,
		})
		pcall(function()
			ui.root.Interactable = true
		end)
		for _, slot in T.Slots do buildButton(slot) end
		S.built = true
	end)
	if not ok or not S.built then
		Util.Warn(TAG, "build failed: " .. tostring(err))
		return
	end
	-- the HUD root hides the bar with it (pickers, opening, loading)
	local function follow()
		local hud = C and C.HUD
		local shown = true
		if type(hud) == "table" and type(hud.IsVisible) == "function" then
			local okV, v = pcall(hud.IsVisible)
			shown = okV and v == true
		end
		if ui.root.Visible ~= shown then ui.root.Visible = shown end
	end
	UIKit.OnAttr({ "Mana", "MaxMana", "Level", "Class", "ClassChosen", "Faction", "SkillReadyAt", "SkillReadyAtZ",
		"SkillReadyAtX", "SkillBarPreview" }, refreshAll)
	RunService.Heartbeat:Connect(function(dt)
		acc.Tick += dt
		if acc.Tick < T.Tick then return end
		acc.Tick = 0
		guard(follow, "visibility")
		if not ui.root.Visible then return end
		for _, b in ui.buttons do tickButton(b) end
		-- the HUD made a new layout (screen size, scale): follow it
		local hud = C and C.HUD
		local layout = type(hud) == "table" and hud.Layout or nil
		if layout ~= S.layoutRef then
			S.layoutRef = layout
			guard(placeAll, "layout")
		end
	end)
	refreshAll()
	SkillBar.Relayout()
	-- one Q button: HUD hides its own
	local hud = C and C.HUD
	if type(hud) == "table" and type(hud.SkillBarReady) == "function" then guard(hud.SkillBarReady, "hand-off") end
	print("[SkillBar] started")
end

return SkillBar
]]></ProtectedString>
					<string name="ScriptGuid">{F82BDBC1-0CEB-4689-B58D-ABE4FC9844EE}</string>
