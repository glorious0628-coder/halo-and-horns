				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ShopService.luau : chosen basic weapons at the blacksmith and potions from their merchant.
-- UpgradeWeapon is the legacy purchase remote name; it does not enhance the current weapon.
-- CharacterVisuals rebuilds the weapon model from the WeaponTier attribute change.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local M = {}

local S = nil
local BLACKSMITH = { PromptName = "HHC_BlacksmithPrompt", Distance = 12, PromptRate = 0.5 }

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function notifyBad(player, key, ...)
	Net.Notify(player, string.format(Config.Text[key], ...), "bad")
end

local function onUpgradeWeapon(player, selectedTier)
	-- Client chooses only the catalog tier. Price, ownership and all eligibility stay on the server.
	if not finite(selectedTier) or selectedTier ~= math.floor(selectedTier) or selectedTier < 1
		or selectedTier > Config.MaxWeaponTier then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "UpgradeWeapon", Config.RateLimits.UpgradeWeapon) then return end
	-- Recheck the physical shop on EVERY purchase, even if its panel was opened earlier.
	if not M.CanBuyWeapon(player) then
		Net.Notify(player, Config.Text.WeaponShopFar, "bad")
		return
	end

	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end

	local maxTier = Config.MaxWeaponTier
	local tier = data.WeaponTier
	-- A23-34: 0 = bare hands (a new player buys the optional wood weapon before or after the free M1_1 tier 1)
	if not finite(tier) or tier ~= math.floor(tier) or tier < 0 or tier > maxTier then return end
	local shop = Config.WeaponShop
	local saleLimit = type(shop) == "table" and shop.MaxSoldTier or nil
	-- An absent/malformed sale list must never silently expose rare tiers for gold.
	if not finite(saleLimit) or saleLimit ~= math.floor(saleLimit) or saleLimit < 1 or saleLimit > maxTier then
		Util.Warn("ShopService", "invalid WeaponShop.MaxSoldTier; weapon purchase refused")
		return
	end
	if selectedTier > saleLimit then
		Net.Notify(player, Config.Text.WeaponNotSold, "info")
		return
	end
	local selectedDef = Config.Weapons[selectedTier]
	if type(selectedDef) ~= "table" then return end
	local ownedMask = data.WeaponOwnedMask
	local validMask = bit32.lshift(1, maxTier) - 1
	-- A23-34: no bit is required any more (0 = nothing owned; tier 1 is owned only after the M1_1 gift)
	if not finite(ownedMask) or ownedMask ~= math.floor(ownedMask) or ownedMask < 0
		or ownedMask > validMask then return end
	local selectedBit = bit32.lshift(1, selectedTier - 1)
	local alreadyOwned = bit32.band(ownedMask, selectedBit) ~= 0
	if selectedTier == 1 and not alreadyOwned then -- tier 1 is never sold: the M1_1 blacksmith gives it (A23-34)
		Net.Notify(player, Config.Text.WeaponFromQuest, "info")
		return
	end

	-- A23-28: MinLevel gates the purchase AND the equip, an owned weapon too (after a rebirth / Lv5+ free class change
	-- it is equippable again once the level is back; same rule as LootService.onEquipWeapon, Config.WeaponUsable)
	local level, minLevel = data.Level, selectedDef.MinLevel
	if not finite(level) or not finite(minLevel) then return end
	if level < minLevel then
		notifyBad(player, alreadyOwned and "EquipNeedLevel" or "WeaponNeedLevel", minLevel)
		return
	end

	-- the faction weapon needs a chosen faction (Halo, Horns or Neutral — never "None")
	local faction = S.FactionService.GetFaction(player)
	if type(faction) ~= "string" then faction = "None" end
	if selectedDef.RequiresFaction and faction == "None" then
		notifyBad(player, "NeedFaction")
		return
	end
	-- review B6: the same state rules as the item-list equip (LootService.onEquipWeapon): alive (CanBuyWeapon above)
	-- and not in PvP combat. Checked before any gold is spent; a purchase always equips, so it is refused too.
	if S.CombatService.IsInCombat(player) then
		Net.Notify(player, Config.Loot.Text.EquipCombat, "bad")
		return
	end

	if not alreadyOwned then
		local price = selectedDef.Price
		if not finite(price) or price <= 0 or price ~= math.floor(price) then
			Util.Warn("ShopService", "invalid weapon price; weapon purchase refused")
			return
		end
		-- No yields between debit, ownership and equipment: duplicate requests cannot debit twice.
		if not S.ProgressionService.SpendGold(player, price) then
			notifyBad(player, "NotEnoughGold")
			return
		end
		S.PlayerService.SetStat(player, "WeaponOwnedMask", bit32.bor(ownedMask, selectedBit))
	end

	S.PlayerService.SetStat(player, "WeaponTier", selectedTier)
	S.PlayerService.SetStat(player, "BlacksmithVisited", true) -- A23-4: a verified anvil trade counts as the visit
	S.PlayerService.MarkActive(player)
	local weaponName = Config.WeaponName(selectedTier, S.ClassService.GetClass(player), faction)
	local equipFmt = (Config.Loot and Config.Loot.Text and Config.Loot.Text.Equip) or Config.Text.WeaponBought
	Net.Notify(player, string.format(alreadyOwned and equipFmt or Config.Text.WeaponBought, weaponName), alreadyOwned and "info" or "reward")
	if tier ~= selectedTier then Net.Fx(player, "Upgrade", { Tier = selectedTier }) end
end

local function onSellWeapon(player, selectedTier)
	if not finite(selectedTier) or selectedTier ~= math.floor(selectedTier) or selectedTier < 2
		or selectedTier > Config.MaxWeaponTier then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "SellWeapon", Config.RateLimits.SellWeapon or Config.RateLimits.UpgradeWeapon) then return end
	if not M.CanBuyWeapon(player) then
		Net.Notify(player, Config.Text.WeaponSellFar, "bad")
		return
	end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end
	local maxTier = Config.MaxWeaponTier
	local shop = Config.WeaponShop
	local saleLimit = type(shop) == "table" and shop.MaxSoldTier or nil
	if not finite(saleLimit) or saleLimit ~= math.floor(saleLimit) or saleLimit < 1 or saleLimit > maxTier then return end
	if selectedTier > saleLimit then return end
	local tier, ownedMask = data.WeaponTier, data.WeaponOwnedMask
	if not finite(tier) or tier ~= math.floor(tier) or tier < 0 or tier > maxTier then return end -- A23-34: 0 = bare hands
	local validMask = bit32.lshift(1, maxTier) - 1
	if not finite(ownedMask) or ownedMask ~= math.floor(ownedMask) or ownedMask < 0
		or ownedMask > validMask then return end
	local selectedBit = bit32.lshift(1, selectedTier - 1)
	if bit32.band(ownedMask, selectedBit) == 0 then return end
	local definition = Config.Weapons[selectedTier]
	local price = type(definition) == "table" and definition.Price or nil
	if not finite(price) or price <= 0 or price ~= math.floor(price) then return end
	local proceeds = math.floor(price * 0.1)
	-- Remove ownership before emitting any gold signal: a repeated or reentrant sale cannot pay twice.
	local leftMask = bit32.band(ownedMask, bit32.bnot(selectedBit))
	S.PlayerService.SetStat(player, "WeaponOwnedMask", leftMask)
	-- A23-34: selling the equipped weapon equips the best weapon still owned and usable (0 = bare hands), never an
	-- unowned tier 1
	if tier == selectedTier then S.PlayerService.SetStat(player, "WeaponTier", Config.BestUsableWeapon(leftMask, data.Level)) end
	S.ProgressionService.AddCarriedGold(player, proceeds, "Sale")
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	S.PlayerService.MarkActive(player)
	local weaponName = Config.WeaponName(selectedTier, S.ClassService.GetClass(player), S.FactionService.GetFaction(player))
	Net.Notify(player, string.format(Config.Text.WeaponSold, weaponName, tostring(proceeds)), "good")
end

local function finitePosition(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

local function blacksmithAnvil()
	local map = workspace:FindFirstChild("Map")
	if not map or map.Parent ~= workspace or (not map:IsA("Folder") and not map:IsA("Model")) then return nil end
	local landmarks = map:FindFirstChild("Landmarks")
	if not landmarks or not landmarks:IsA("Folder") or landmarks.Parent ~= map then return nil end
	local guild = landmarks:FindFirstChild("ArtisanGuild")
	if not guild or not guild:IsA("Model") or guild.Parent ~= landmarks then return nil end
	local anvil = guild:FindFirstChild("Anvil")
	if not anvil or not anvil:IsA("BasePart") or anvil.Parent ~= guild or not anvil.Anchored then return nil end
	return anvil
end

-- Attach the interaction to the existing approved map prop; create no new NPC or scenery.
function M.EnsureBlacksmithPrompt()
	local anvil = blacksmithAnvil()
	if not anvil then return false end
	local prompt = anvil:FindFirstChild(BLACKSMITH.PromptName)
	if prompt and not prompt:IsA("ProximityPrompt") then return false end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = BLACKSMITH.PromptName
	end
	prompt.ActionText, prompt.ObjectText = Config.Text.BlacksmithPromptAction, Config.Text.BlacksmithPromptObject
	prompt.KeyboardKeyCode = Enum.KeyCode.E -- standard interact key; the skill is Q only (2026-10-06 playtest)
	prompt.HoldDuration, prompt.MaxActivationDistance = 0, BLACKSMITH.Distance -- a shop opens on a tap, no hold
	prompt.RequiresLineOfSight, prompt.Enabled = false, true
	prompt.Parent = anvil
	return true
end

local function blacksmith()
	local anvil = blacksmithAnvil()
	if not anvil then return nil end
	local prompt = anvil:FindFirstChild(BLACKSMITH.PromptName)
	if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Parent ~= anvil or not prompt.Enabled then return nil end
	return anvil, prompt
end

function M.CanBuyWeapon(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" or data.ClassChosen ~= true then return false end
	local anvil, prompt = blacksmith()
	local root = Util.GetRoot(player)
	if not anvil or not root or not root:IsA("BasePart")
		or not finitePosition(anvil.Position) or not finitePosition(root.Position) then return false end
	local activation = prompt.MaxActivationDistance
	if not finite(activation) or activation <= 0 then return false end
	-- Increasing a prompt's radius never expands the purchase radius beyond the server contract.
	local distance = (root.Position - anvil.Position).Magnitude
	return finite(distance) and distance <= math.min(BLACKSMITH.Distance, activation)
end

local function onBlacksmithPrompt(prompt, player)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt")
		or prompt.Name ~= BLACKSMITH.PromptName or not M.CanBuyWeapon(player) then return end
	local _, expected = blacksmith()
	if expected ~= prompt then return end -- cloned/renamed prompts cannot open the weapon shop
	if not Util.RateLimit(player, "BlacksmithPrompt", BLACKSMITH.PromptRate) then return end
	S.PlayerService.SetStat(player, "BlacksmithVisited", true)
	-- A23-34: an active M1_1 finishes right here, so its free first weapon is in hand before the shop opens
	local story = S.StoryQuestService
	if type(story) == "table" and type(story.Refresh) == "function" then pcall(story.Refresh, player) end
	Net.Get("OpenPanel"):FireClient(player, "WeaponShop")
end

function M.CanBuyPotions(player)
	if Config.Vitals.MerchantEnabled ~= true or typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
	if player.Parent ~= Players or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false end
	local map = workspace:FindFirstChild("Map")
	if not map or map.Parent ~= workspace or (not map:IsA("Folder") and not map:IsA("Model")) then return false end
	local npcs = map:FindFirstChild("NPCs")
	if not npcs or not npcs:IsA("Folder") or npcs.Parent ~= map then return false end
	local merchant = npcs:FindFirstChild(Config.Vitals.PotionMerchantName)
	local part = merchant and merchant:IsA("Model") and merchant:GetAttribute("HHC_PotionMerchant") == true and merchant.PrimaryPart
	local root = Util.GetRoot(player)
	if not merchant or merchant.Parent ~= npcs or not part or not part:IsA("BasePart")
		or not part:IsDescendantOf(merchant) or not root or not root:IsA("BasePart")
		or not finitePosition(part.Position) or not finitePosition(root.Position) then return false end
	local prompt = part:FindFirstChild(Config.Vitals.PotionMerchantPrompt)
	-- Direct BuyPotion calls require the same live server prompt as opening the shop, including its enabled state.
	if not prompt or not prompt:IsA("ProximityPrompt") or prompt.Parent ~= part or not prompt.Enabled then return false end
	local limit = Config.Vitals.PotionMerchantDistance
	if not finite(limit) or limit <= 0 then return false end
	local distance = (root.Position - part.Position).Magnitude
	return finite(distance) and distance <= limit
end

local function onPotionPrompt(prompt, player)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return end
	if prompt.Name ~= Config.Vitals.PotionMerchantPrompt or not M.CanBuyPotions(player) then return end
	local map = workspace:FindFirstChild("Map")
	local npcs = map and map:FindFirstChild("NPCs")
	local merchant = npcs and npcs:FindFirstChild(Config.Vitals.PotionMerchantName)
	local part = merchant and merchant.PrimaryPart
	if not part or prompt.Parent ~= part or part:FindFirstChild(Config.Vitals.PotionMerchantPrompt) ~= prompt then return end
	if not Util.RateLimit(player, "PotionMerchantPrompt", Config.Vitals.PotionMerchantPromptRate) then return end
	Net.Get("OpenPanel"):FireClient(player, "PotionShop")
end

function M.BuyPotion(player, kind, amount)
	local key = Config.PotionStockKey(kind)
	if not key or type(amount) ~= "number" or (amount ~= 1 and amount ~= 5) then return false, "Invalid" end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not S.PlayerService.IsReady(player) or not Util.IsAlive(player) then return false, "NotReady" end
	if not Util.RateLimit(player, "BuyPotion", Config.RateLimits.BuyPotion) then return false, "Cooldown" end
	if not M.CanBuyPotions(player) then
		Net.Notify(player, Config.Text.PotionShopFar, "bad")
		return false, "MerchantDistance"
	end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return false, "NotReady" end
	local count, cap = data[key], Config.Vitals.PotionInventoryCap
	if not finite(count) or count < 0 or count ~= math.floor(count) or count > cap then return false, "InvalidStock" end
	if count + amount > cap then
		Net.Notify(player, string.format(Config.Text.PotionStockFull, cap), "bad")
		return false, "FullStock"
	end
	local price = Config.Vitals.PotionPrices[kind]
	if not finite(price) or price <= 0 or price ~= math.floor(price) then return false, "InvalidPrice" end
	-- Validate the whole purchase before debiting. SpendGold and SetStat do not yield; no request can interleave here.
	-- No datastore write, prompt callback, Notify or remote call occurs between these two mutations.
	if not S.ProgressionService.SpendGold(player, price * amount) then
		notifyBad(player, "NotEnoughGold")
		return false, "NotEnoughGold"
	end
	S.PlayerService.SetStat(player, key, count + amount)
	S.PlayerService.MarkActive(player)
	Net.Notify(player, string.format(Config.Text.PotionBought, kind, amount), "good")
	return true, "Bought"
end

function M.Init(registry)
	S = registry
end

function M.Start()
	if not M.EnsureBlacksmithPrompt() then
		-- Minimal/headless maps may intentionally omit this optional town prop.
		print("[ShopService] no ArtisanGuild.Anvil; weapon shop stays closed")
	end
	-- Global, exact-instance validation survives a MapBuilder rebuild and rejects cloned/renamed prompts.
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local ok, err = pcall(onPotionPrompt, prompt, player)
		if not ok then Util.Warn("ShopService", "potion prompt: " .. tostring(err)) end
		local shopOk, shopErr = pcall(onBlacksmithPrompt, prompt, player)
		if not shopOk then Util.Warn("ShopService", "blacksmith prompt: " .. tostring(shopErr)) end
	end)
	Net.Get("UpgradeWeapon").OnServerEvent:Connect(function(player, ...)
		-- Exactly one catalog tier is accepted; prices, quantities or extra payloads are rejected.
		if select("#", ...) ~= 1 then return end
		local ok, err = pcall(onUpgradeWeapon, player, ...)
		if not ok then Util.Warn("ShopService", "weapon purchase: " .. tostring(err)) end
	end)
	Net.Get("SellWeapon").OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then return end
		local ok, err = pcall(onSellWeapon, player, ...)
		if not ok then Util.Warn("ShopService", "weapon sale: " .. tostring(err)) end
	end)
	Net.Get("BuyPotion").OnServerEvent:Connect(function(player, kind, amount)
		local ok, err = pcall(M.BuyPotion, player, kind, amount)
		if not ok then Util.Warn("ShopService", tostring(err)) end
	end)
	print("[ShopService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{1740EDA1-5420-4D85-A0C3-5FED6DE0C30F}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ShopService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050001b0fe</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX85BEC0741CBD4FCB9D30B6ED32DE024A">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- JusticeService.luau : Size Justice ("덩치 저울"): faction power sums, per-faction S, bully stacks + decay,
-- and the smooth character scale lerp. The ONLY service that scales characters (always via Util.SafeScaleTo).
-- Addendum A6: "Neutral" players are excluded from power sums / ratios and their S is always 1.0.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "JusticeService"
local DECAY_TICK = 1 -- bully decay loop interval (spec §4.12)
local SCALE_EPSILON = 0.005 -- lerp stops when this close to the target
local S_EPSILON = 0.001 -- a faction S change smaller than this does not refresh characters
local MIN_SCALE = 0.1 -- safety floor for Model:ScaleTo
local SCALE_RETRY_SECONDS = 2 -- after a failed ScaleTo, wait this long before trying that character again
local LEAVE_FORGET_SECONDS = 60
local WARN_THROTTLE = 10
local PIVOT_HEIGHT_AT_SCALE_1 = 3 -- approx. root-center height above the feet for R6 and R15 at scale 1
-- CR-M20: who adds power to the faction sums (everyone still gets their side's S)
local COUNT_RULE = {
	IdleSeconds = 120, -- no input / combat for this long (PlayerService.GetLastActive) = not counted
	TownSeconds = 60, -- standing in a town for this long = not counted
}

local JusticeService = {}

local S = nil
local scaleOf = { Halo = 1, Horns = 1 } -- current S per combat faction
local weakerFaction = "None"
local leaving = {} -- [Player] = true while leaving (excluded from sums)
local lastAppliedS = {} -- [Player] = S last pushed to SizeMult / RefreshCharacter
local lastFaction = {} -- [Player] = faction at the last recompute pass
local targets = {} -- [Player] = last computed visual scale target
local bully = {} -- [Player] = { Stacks: number, Last: number (os.clock) }
local townSince = {} -- [Player] = os.clock() when the player entered a town (nil outside towns), CR-M20
local hipBase = setmetatable({}, { __mode = "k" }) -- [Character] = R15 HipHeight at scale 1
local scaleFailUntil = setmetatable({}, { __mode = "k" }) -- [Character] = os.clock()
local recomputePending = false
local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function round2(x)
	return math.floor(x * 100 + 0.5) / 100
end

local function factionOf(player)
	if S and S.FactionService and S.FactionService.GetFaction then
		return S.FactionService.GetFaction(player)
	end
	local f = player and player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function kaijuState(player)
	local k = S and S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

-- only Halo / Horns can be bullies (A6: Neutral never gets bully stacks; "None" has not picked a side)
local function isFighterFaction(factionId)
	return factionId == "Halo" or factionId == "Horns"
end

local function computeTarget(player)
	local s = JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
	if kaijuState(player) == "Active" then
		s *= Config.Kaiju.VisualScale
	end
	return math.max(MIN_SCALE, math.min(Config.Justice.MaxVisualScale, s))
end

local function writeVisualScale(player, scale)
	local v = round2(scale)
	if player:GetAttribute("VisualScale") ~= v then
		player:SetAttribute("VisualScale", v)
	end
end

-- R15 hover height does not follow the body when scaled at runtime; keep it proportional (no-op if ScaleTo did it).
local function fixHipHeight(character, scale)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local base = hipBase[character]
	if not base or base <= 0 then return end
	local want = base * scale
	if math.abs(hum.HipHeight - want) > 0.01 then
		hum.HipHeight = want
	end
end

local function rememberHipBase(character)
	if hipBase[character] then return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local cur = character:GetScale()
	if cur > 0 then
		hipBase[character] = hum.HipHeight / cur
	end
end

-- applies `scale` to the character; returns true on success
local function applyScale(character, scale)
	local blockedUntil = scaleFailUntil[character]
	if blockedUntil and os.clock() < blockedUntil then return false end
	if Util.SafeScaleTo(character, scale) then
		fixHipHeight(character, scale)
		return true
	end
	scaleFailUntil[character] = os.clock() + SCALE_RETRY_SECONDS
	return false
end

local function requestRecompute()
	if recomputePending then return end
	recomputePending = true
	task.defer(function()
		recomputePending = false
		local ok, err = pcall(JusticeService.Recompute)
		if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
	end)
end

local function clearPlayer(player)
	lastAppliedS[player] = nil
	lastFaction[player] = nil
	targets[player] = nil
	bully[player] = nil
	townSince[player] = nil
end

-- CR-M20: keep townSince in step with the zone (also covers spawning in Crossroads, which fires no ZoneChanged)
local function syncTown(player, now)
	local zs = S and S.ZoneService
	if not zs or not zs.IsTown then return end
	local ok, inTown = pcall(zs.IsTown, player)
	if not ok then return end
	if inTown == true then
		townSince[player] = townSince[player] or now
	else
		townSince[player] = nil
	end
end

-- CR-M20: rookies, 120 s idlers and 60 s town loiterers add no power to the faction sums
local function countsForSums(player, now)
	syncTown(player, now)
	local pvp = S.PvPService
	if pvp and pvp.IsRookie then
		local ok, rookie = pcall(pvp.IsRookie, player)
		if ok and rookie == true then return false end
	end
	local ps = S.PlayerService
	if ps.GetLastActive then
		local ok, t = pcall(ps.GetLastActive, player)
		if ok and type(t) == "number" and now - t > COUNT_RULE.IdleSeconds then return false end
	end
	local since = townSince[player]
	return not (since and now - since >= COUNT_RULE.TownSeconds)
end

-- level, equipped weapon tier and its scroll +N (review B5: the server-written WeaponEnhance attribute;
-- Config.EnhanceMult clamps it to 0..Config.Loot.MaxEnhance and treats a missing value as +0)
local function levelAndTier(player)
	local level = math.max(1, tonumber(player:GetAttribute("Level")) or 1)
	local tier = math.clamp(math.floor(tonumber(player:GetAttribute("WeaponTier")) or 0), 0, Config.MaxWeaponTier) -- A23-34: 0 = bare hands
	local enhance = tonumber(player:GetAttribute("WeaponEnhance")) or 0
	return level, tier, enhance
end

------------------------------------------------------------------ public API
-- faction-sum power (includes the rebirth bonus)
function JusticeService.GetPower(player)
	if not player then return 0 end
	local level, tier, enhance = levelAndTier(player)
	local rebirthBonus = tonumber(player:GetAttribute("RebirthBonus")) or 0
	return Config.PowerOf(level, tier, 1 + rebirthBonus, enhance)
end

-- BB4 "전투력" (integer, Config.CombatPower): the weak-victim (bully) rule and the boldness ratios compare it.
-- CR-L5: the rebirth bonus is gold / XP only, so it is left out
function JusticeService.GetCombatPower(player)
	if not player then return 0 end
	local level, tier, enhance = levelAndTier(player)
	return Config.CombatPower(level, tier, enhance)
end

-- BB4: the CombatPower attribute follows Level / WeaponTier / WeaponEnhance. One deferred refresh per frame, because
-- LootService writes WeaponEnhance right after WeaponTier (an equip changes the attribute exactly once).
local POWER = { Conns = {}, Pending = {} }

function POWER.Refresh(player)
	POWER.Pending[player] = nil
	if player.Parent == nil or not POWER.Conns[player] then return end
	local n = JusticeService.GetCombatPower(player)
	if player:GetAttribute("CombatPower") ~= n then player:SetAttribute("CombatPower", n) end
end

function POWER.Schedule(player)
	if POWER.Pending[player] then return end
	POWER.Pending[player] = true
	task.defer(POWER.Refresh, player)
end

function POWER.Drop(player)
	for _, c in POWER.Conns[player] or {} do c:Disconnect() end
	POWER.Conns[player], POWER.Pending[player] = nil, nil
end

function POWER.Watch(player)
	POWER.Drop(player)
	local list = {}
	for _, attr in { "Level", "WeaponTier", "WeaponEnhance" } do
		table.insert(list, player:GetAttributeChangedSignal(attr):Connect(function() POWER.Schedule(player) end))
	end
	POWER.Conns[player] = list
	POWER.Refresh(player)
end

-- 1 for "None" and "Neutral" (A6)
function JusticeService.GetFactionScale(factionId)
	if factionId == "Halo" or factionId == "Horns" then
		return scaleOf[factionId] or 1
	end
	return 1
end

function JusticeService.GetWeakerFaction()
	return weakerFaction
end

function JusticeService.GetDamageMult(player)
	return JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
end

function JusticeService.GetHealthMult(player)
	local mult = JusticeService.GetFactionScale(factionOf(player))
	local k = S and S.KaijuService
	if k and k.GetHealthMult then
		local ok, km = pcall(k.GetHealthMult, player)
		if ok and type(km) == "number" and km > 0 then
			mult *= km
		end
	end
	return mult
end

function JusticeService.GetBullyStacks(player)
	local b = player and bully[player]
	return b and b.Stacks or 0
end

-- A23-22: os.time() when the last stack decays (0 = no penalty); the HUD shows "(N분)" from it.
-- The BullyStacks attribute and this one are written together through publishBully.
local function publishBully(player, b)
	local stacks = b and b.Stacks or 0
	local endsAt = 0
	if stacks > 0 then
		local period = math.max(1, tonumber(Config.Bully.DecaySeconds) or 300)
		local left = (stacks - 1) * period + math.max(0, period - (os.clock() - b.Last))
		endsAt = os.time() + math.ceil(left)
	end
	player:SetAttribute("BullyStacks", stacks)
	player:SetAttribute("BullyEndsAt", endsAt)
end

function JusticeService.AddBullyStack(player)
	if not player then return 0 end
	if not isFighterFaction(factionOf(player)) then return 0 end -- A6: Neutral / None never become bullies
	local b = bully[player]
	if not b then
		b = { Stacks = 0, Last = os.clock() }
		bully[player] = b
	end
	b.Stacks = math.min(Config.Bully.MaxStacks, b.Stacks + 1)
	b.Last = os.clock()
	publishBully(player, b)
	JusticeService.RefreshScale(player)
	return b.Stacks
end

-- recompute this player's visual scale target now (the scale loop moves the character toward it)
function JusticeService.RefreshScale(player)
	if not player then return end
	targets[player] = computeTarget(player)
end

function JusticeService.Recompute()
	if not S then return end
	local now = os.clock()
	local haloSum, hornsSum, haloCount, hornsCount = 0, 0, 0, 0
	local entries = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = factionOf(p)
			-- CR-M20: excluded players still get an entry below (and so their side's S)
			if (f == "Halo" or f == "Horns") and countsForSums(p, now) then
				local ok, power = pcall(JusticeService.GetPower, p)
				power = (ok and type(power) == "number") and power or 0
				if f == "Halo" then
					haloSum += power
					haloCount += 1
				else
					hornsSum += power
					hornsCount += 1
				end
			end
			table.insert(entries, { Player = p, Faction = f })
		end
	end

	local sHalo, sHorns = 1, 1
	if haloCount >= 1 and hornsCount >= 1 then
		sHalo = Config.SizeJustice(haloSum, hornsSum)
		sHorns = Config.SizeJustice(hornsSum, haloSum)
	end
	scaleOf.Halo, scaleOf.Horns = sHalo, sHorns

	-- an empty faction counts as 0; "None" if both sums are 0 or equal
	if (haloSum == 0 and hornsSum == 0) or haloSum == hornsSum then
		weakerFaction = "None"
	elseif haloSum < hornsSum then
		weakerFaction = "Halo"
	else
		weakerFaction = "Horns"
	end

	local gs = Net.GameState()
	gs:SetAttribute("HaloPower", math.floor(haloSum + 0.5))
	gs:SetAttribute("HornsPower", math.floor(hornsSum + 0.5))
	gs:SetAttribute("HaloSize", round2(sHalo))
	gs:SetAttribute("HornsSize", round2(sHorns))
	gs:SetAttribute("WeakerFaction", weakerFaction)

	for _, e in entries do
		local p, f = e.Player, e.Faction
		local s = JusticeService.GetFactionScale(f)
		local prev = lastAppliedS[p]
		if lastFaction[p] ~= f or prev == nil or math.abs(prev - s) > S_EPSILON then
			lastAppliedS[p] = s
			lastFaction[p] = f
			local ok, err = pcall(function()
				p:SetAttribute("SizeMult", round2(s))
				S.PlayerService.RefreshCharacter(p, false) -- HP % preserved
				JusticeService.RefreshScale(p)
			end)
			if not ok then warnThrottled("apply", "apply S failed: " .. tostring(err)) end
		end
	end
end

------------------------------------------------------------------ subscriptions
-- CR-M12: bring back the stacks saved at the last leave, minus the decay that would have happened meanwhile
local function restoreBully(player, data)
	if type(data) ~= "table" then return end
	local saved = math.floor(tonumber(data.SavedBully) or 0)
	local at = tonumber(data.SavedBullyAt) or 0
	-- one-shot: a crash before the next leave must not bring them back a second time
	data.SavedBully, data.SavedBullyAt = 0, 0
	if saved <= 0 or at <= 0 then return end
	if not isFighterFaction(data.Faction) then return end -- A6: only Halo / Horns carry stacks
	local period = math.max(1, tonumber(Config.Bully.DecaySeconds) or 300)
	local elapsed = math.max(0, os.time() - at)
	local decayed = math.floor(elapsed / period)
	local stacks = math.min(Config.Bully.MaxStacks, saved - decayed)
	if stacks <= 0 then return end
	-- keep the running decay period: the next stack drops `period` after the last drop, not after the join
	bully[player] = { Stacks = stacks, Last = os.clock() - (elapsed - decayed * period) }
	publishBully(player, bully[player])
	JusticeService.RefreshScale(player)
end

local function onPlayerReady(player, data)
	leaving[player] = nil
	clearPlayer(player)
	player:SetAttribute("SizeMult", 1)
	player:SetAttribute("BullyStacks", 0)
	player:SetAttribute("BullyEndsAt", 0)
	player:SetAttribute("VisualScale", 1)
	local ok, err = pcall(restoreBully, player, data)
	if not ok then warnThrottled("bullyrestore", "bully restore failed: " .. tostring(err)) end
	POWER.Watch(player)
	requestRecompute()
end

local function onPlayerLeaving(player, data)
	leaving[player] = true
	POWER.Drop(player)
	-- CR-M12: save the stacks; SavedBullyAt = os.time() of the start of the running decay period
	if type(data) == "table" then
		local b = bully[player]
		local stacks = JusticeService.GetBullyStacks(player)
		local into = (stacks > 0 and b) and math.floor(math.max(0, os.clock() - b.Last)) or 0
		data.SavedBully = stacks
		data.SavedBullyAt = os.time() - into
	end
	requestRecompute()
	-- CR-L1: later PlayerLeaving handlers (PvP bounty CR-M11) still read the stacks; clear after them
	task.defer(clearPlayer, player)
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

-- CR-M20: town entry time (the 60 s town rule); leaving a town or crossing the 60 s mark re-weighs the sums
local function onZoneChanged(player, newZoneId)
	if not player or leaving[player] then return end
	local zone = Config.Zones[newZoneId]
	if zone and zone.Town == true then
		if townSince[player] then return end -- town to town keeps the clock
		local t = os.clock()
		townSince[player] = t
		task.delay(COUNT_RULE.TownSeconds + 0.5, function()
			if townSince[player] == t then requestRecompute() end
		end)
	else
		local was = townSince[player]
		townSince[player] = nil
		if was and os.clock() - was >= COUNT_RULE.TownSeconds then requestRecompute() end
	end
end

-- fresh characters start at scale 1: snap straight to the target (no lerp)
local function onCharacterSpawned(player, character)
	if not player or not character or not character.Parent then return end
	if player.Character ~= character then return end
	rememberHipBase(character)
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	if math.abs(target - cur) > SCALE_EPSILON and applyScale(character, target) then
		if target > cur then
			-- CR-H2: a server-side move; the spawn grace (not the shorter default) so ZoneService's own one is not cut
			local zs = S and S.ZoneService
			if zs and zs.MarkTeleported then
				local ac = Config.AntiCheat
				pcall(zs.MarkTeleported, player, (ac and tonumber(ac.SpawnGrace)) or 2)
			end
			-- ScaleTo keeps the pivot (root) in place, so the longer legs would start inside the floor: lift by the growth
			pcall(function()
				character:PivotTo(character:GetPivot() + Vector3.new(0, (target - cur) * PIVOT_HEIGHT_AT_SCALE_1, 0))
			end)
		end
		cur = target
	end
	writeVisualScale(player, cur)
end

------------------------------------------------------------------ loops
local function scaleStep(player, step)
	if not Util.IsAlive(player) then return end
	local character = Util.GetCharacter(player)
	if not character then return end
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	local diff = target - cur
	if math.abs(diff) <= SCALE_EPSILON then
		writeVisualScale(player, cur)
		return
	end
	rememberHipBase(character)
	local new = cur + math.clamp(diff, -step, step)
	if applyScale(character, new) then
		writeVisualScale(player, new)
	end
end

local function decayStep(player, b)
	if b.Stacks <= 0 then return end
	if os.clock() - b.Last < Config.Bully.DecaySeconds then return end
	b.Stacks -= 1
	b.Last = os.clock()
	if player.Parent ~= Players then return end
	publishBully(player, b)
	Net.Notify(player, string.format(Config.Text.BullyDecay, b.Stacks), "info")
	JusticeService.RefreshScale(player)
end

function JusticeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player, newFaction)
			-- A6: a bully who switches to Neutral (altar / rebirth) sheds the stacks at once
			-- (no shrink, no -15% damage, no "깡패" tag); Halo <-> Horns keeps them.
			-- CR-L9: the altar and rebirth refuse Neutral while stacks remain, so this is only a safety net
			if player and not isFighterFaction(newFaction) then
				local had = bully[player] ~= nil or (tonumber(player:GetAttribute("BullyStacks")) or 0) > 0
				bully[player] = nil
				if had then
					local ok, err = pcall(function()
						publishBully(player, nil)
						JusticeService.RefreshScale(player)
					end)
					if not ok then warnThrottled("bullyclear", "bully clear failed: " .. tostring(err)) end
				end
			end
			requestRecompute()
		end)
	end
	if S.ClassService and S.ClassService.ClassChanged then
		S.ClassService.ClassChanged:Connect(function()
			requestRecompute()
		end)
	end
	if S.ProgressionService and S.ProgressionService.Rebirthed then
		S.ProgressionService.Rebirthed:Connect(function()
			requestRecompute()
		end)
	end
	if S.ZoneService and S.ZoneService.ZoneChanged then
		S.ZoneService.ZoneChanged:Connect(onZoneChanged) -- CR-M20
	end
	-- players removed before they were ever ready never fire PlayerLeaving
	-- CR-L1: a ready player is cleared by onPlayerLeaving (deferred, after the other leave handlers)
	Players.PlayerRemoving:Connect(function(player)
		if not S.PlayerService.IsReady(player) then
			clearPlayer(player)
		end
	end)
end

function JusticeService.Start()
	-- periodic recompute
	task.spawn(function()
		while true do
			task.wait(Config.Justice.RecalcInterval)
			local ok, err = pcall(JusticeService.Recompute)
			if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
		end
	end)

	-- smooth scale lerp
	task.spawn(function()
		local interval = Config.Justice.ScaleTick
		local step = Config.Justice.ScaleRatePerSec * interval -- max scale change per tick
		while true do
			task.wait(interval)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(scaleStep, p, step)
				if not ok then warnThrottled("scale", "scale step failed: " .. tostring(err)) end
			end
		end
	end)

	-- bully stack decay
	task.spawn(function()
		while true do
			task.wait(DECAY_TICK)
			for p, b in bully do
				local ok, err = pcall(decayStep, p, b)
				if not ok then warnThrottled("decay", "bully decay failed: " .. tostring(err)) end
			end
		end
	end)

	requestRecompute()
	print("[JusticeService] started")
end

return JusticeService
]]></ProtectedString>
				<string name="ScriptGuid">{76E7E424-6724-4F69-B2A1-F3A5FB5E0DF8}</string>
