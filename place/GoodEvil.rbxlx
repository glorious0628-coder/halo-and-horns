		Visible = false,
		Parent = root,
	})
	ui.travelLabel = UIKit.Label({
		Name = "Label",
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 19,
		Parent = ui.travel,
	})
	local _, setTravel = UIKit.Bar({
		Name = "Progress",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 36),
		Size = UDim2.fromOffset(310, 14),
		Color = Theme.XP,
		Parent = ui.travel,
