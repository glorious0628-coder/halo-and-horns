	}, ui.Strip)
	make("UIStroke", { Color = GOLD, Thickness = 1.5, Transparency = 0.3 }, ui.GooseChip)
	ui.GooseChipText = makeLabel({
		Name = "Text",
		Position = UDim2.fromOffset(8, 3),
		Size = UDim2.new(1, -16, 1, -6),
