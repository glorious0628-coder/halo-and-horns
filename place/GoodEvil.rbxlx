		<Item class="ModuleScript" referent="RBX56B52357B91449529F3E64FCBA998FDB">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- TitleService.luau : BB16 (docs/design/beta_basics_2026-10-05.md) owned titles + the one shown on the nametag.
-- data.Titles = { [id] = os.time() first owned }, data.TitleSel = "" (automatic: faction rank / gray legend) or an owned
-- id from Config.TitleDefs. Titles never give stats. Grants: BetaPioneer (joined before the full launch, A23-18; the old
-- boolean data.BetaPioneer migrates here) and GrayLegend (fall + redeem marks, kept once earned).
-- Remote c->s "SetTitle"(id): one string <= 32 chars, owned or "" (anything else is ignored).
-- The client reads the TitleSel attribute (mirrored) and TitlesOwned ("id,id", for the BB8 picker).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local TitleService = {}
local S = nil
local CONNS = {} -- [Player] = { RBXScriptConnection } (gray legend watchers, dropped on leave)

local function titles(data)
	if type(data.Titles) ~= "table" then data.Titles = {} end
	return data.Titles
end

-- "BetaPioneer,GrayLegend" in Config.TitleDefs order (stable for the picker)
local function publish(player, data)
	local owned = {}
	for _, id in Config.TitleOrder do
		if titles(data)[id] then table.insert(owned, id) end
	end
	player:SetAttribute("TitlesOwned", table.concat(owned, ","))
end

-- returns true when the title is new for this player
function TitleService.Grant(player, id)
	if not Config.TitleDefs[id] then return false end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" or titles(data)[id] then return false end
	titles(data)[id] = os.time()
	publish(player, data)
	return true
end

-- BB10 timed titles (Config.TitleDefs[id].Timed: the weekly "이번 주 명예 1위" titles): RankingService removes them
-- when their week ends; a removed selected title falls back to automatic (""). Returns true when it was owned.
function TitleService.Revoke(player, id)
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" or type(data.Titles) ~= "table" or data.Titles[id] == nil then return false end
	data.Titles[id] = nil
	if data.TitleSel == id then S.PlayerService.SetStat(player, "TitleSel", "") end
	publish(player, data)
	return true
end

function TitleService.Owns(player, id)
	local data = S.PlayerService.GetData(player)
	return type(data) == "table" and type(data.Titles) == "table" and data.Titles[id] ~= nil
end

local function checkGrayLegend(player)
	local min = Config.Rebirth.GrayLegendMin
	if (tonumber(player:GetAttribute("FallMarks")) or 0) >= min and (tonumber(player:GetAttribute("RedeemMarks")) or 0) >= min then
		TitleService.Grant(player, "GrayLegend")
	end
end

local function onReady(player, data)
	local beta = Config.Beta
	local pioneer = data.BetaPioneer == true or (beta.GrantPioneer == true and os.time() < beta.PioneerUntil)
	if pioneer then TitleService.Grant(player, "BetaPioneer") end
	-- review 381f6a1: the faction rank (GDD §0) stays the default title; the pioneer shows as a small mark on the
	-- nametag's second line instead. A TitleSel the player never picked (data.TitleSelAt, set only by SetTitle) was the
	-- old one-time auto-select: back to automatic once. Owned titles stay.
	if data.TitleSel == "BetaPioneer" and data.TitleSelAt == nil then
		S.PlayerService.SetStat(player, "TitleSel", "")
	end
	checkGrayLegend(player)
	-- a selected title the player no longer owns (data edited / removed def) falls back to automatic
	if data.TitleSel ~= "" and not (Config.TitleDefs[data.TitleSel] and titles(data)[data.TitleSel]) then
		S.PlayerService.SetStat(player, "TitleSel", "")
	end
	publish(player, data)
	for _, c in CONNS[player] or {} do c:Disconnect() end
	CONNS[player] = {
		player:GetAttributeChangedSignal("FallMarks"):Connect(function() pcall(checkGrayLegend, player) end),
		player:GetAttributeChangedSignal("RedeemMarks"):Connect(function() pcall(checkGrayLegend, player) end),
	}
end

local function onSetTitle(player, ...)
	if select("#", ...) ~= 1 then return end
	local id = ...
	if type(id) ~= "string" or #id > 32 then return end
	if not S.PlayerService.IsReady(player) or not Util.RateLimit(player, "SetTitle", Config.RateLimits.SetTitle) then return end
	if id ~= "" and not (Config.TitleDefs[id] and TitleService.Owns(player, id)) then return end
	local data = S.PlayerService.GetData(player)
	if type(data) == "table" then data.TitleSelAt = os.time() end -- an explicit pick (never undone by the migration)
	S.PlayerService.SetStat(player, "TitleSel", id)
end

function TitleService.Init(registry)
	S = registry
end

function TitleService.Start()
	S.PlayerService.PlayerReady:Connect(function(player, data)
		local ok, err = pcall(onReady, player, data)
		if not ok then Util.Warn("TitleService", "ready: " .. tostring(err)) end
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		for _, c in CONNS[player] or {} do c:Disconnect() end
		CONNS[player] = nil
	end)
	Net.Get("SetTitle").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onSetTitle, player, ...)
		if not ok then Util.Warn("TitleService", "SetTitle: " .. tostring(err)) end
	end)
	print("[TitleService] started")
end

return TitleService
]]></ProtectedString>
				<string name="ScriptGuid">{B157C2D7-FB4F-4020-B058-497EC92848CC}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">TitleService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c05000008c1</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3649024F38DF47DE9E4FDC76156ABBCA">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- RankingService.luau : BB10 weekly rankings and the ONE weekly settle of A23-22 / A23-23 / A23-24 (server only).
-- Plan + 검수 decisions D1-D6: docs/design/ranking_service_plan_2026-10-06.md; contract: beta_basics BB10 (2026-10-06 notes).
--
-- Boards (Config.Ranking.Order), weekly from Monday 00:00 KST (Config.WeekIndex):
--   Honor (Halo) / Infamy (Horns): fair PvP points only (PvPService -> PlayerService.GrantFame -> CreditFame; D1)
--   Artisan (Neutral): scroll enhance gains with scrolls my own kills dropped while in the guild (A23-24)
--   PvP (every faction): +1 per unfair KO (JudgeKO), the "무단 PvP" board whose top 3 become next week's outlaws
-- Points live in data.Rank (week fields, Config.SanitizeRank) and in one OrderedDataStore per season / board / week:
-- HH_Rank_<season>_<board>_W<week>, key U_<userId>, value = score*100 + hidden*10 + factionCode. The season is
-- "STUDIO" in Studio / memory mode, so Studio play never touches PRE / B1 rows.
-- Weekly settle (TickSettle): 10 min after Monday 00:00 KST the first server that finds no settle document reads last
-- week's top 3 per board and stores them once (HH_RankSettle_<season>, key W<week>, first writer wins); every server
-- applies that same document: data.RankReward / data.Outlaw = { WeekId = this week, Season } (idempotent). Failing board
-- reads retry every SettleRetrySeconds; after SettleGiveUpSeconds the server stores { Skipped = true } instead, also
-- first-writer-wins, so every server applies the same decision (D4). Nothing is applied while the store is unreachable.
-- Points, rewards and outlaw weeks carry their season: a Studio test (STUDIO) never acts on a live server and back.
-- Effects are published as attributes the other services read: Outlaw (bool), RankReward ("" or the board id, only
-- while in that board's faction), RankRewardRank, Week<board> (this week's points).
-- Remote c->s "RequestRankings"(board, "Server" | "Global") -> owner-only "Rankings" from the server cache only.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local UserService = game:GetService("UserService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local RankingService = {}
local S = nil
local TAG = "RankingService"
local R = Config.Ranking
local TXT = R.Text

-- per-server state. Player keys are dropped when the leave write finished; the tables are weak-keyed so a write still
-- running when a player leaves can never keep the Player alive.
local function weak() return setmetatable({}, { __mode = "k" }) end
local ST = {
	Dirty = weak(), -- [Player] = true: this week's rows changed since the last write
	Force = weak(), -- [Player] = true: write at the next loop step whatever WriteEverySeconds says
	LastWrite = weak(), -- [Player] = os.clock()
	Pending = weak(), -- [Player] = last week's snapshot still to write to last week's stores (week flip while online)
	LastWeek = weak(), -- [Player] = last week's snapshot (kept for the STUDIO settle from this server's board)
	HideQueue = weak(), -- [Player] = true until every row carries the new hidden flag (then Rank.HideSynced)
	Gen = weak(), -- [Player] = n, +1 on every change a write must carry (a change during a yielding write is not lost)
	Writing = weak(), -- [Player] = true while writePlayer runs (the leave write waits for it)
	Leaving = 0, -- leave writes still running (PlayerService's BindToClose waits for them)
	-- [userId] = { [store] = value last written by this server in the player's CURRENT session (false = removed) };
	-- cleared at join and after the leave write: another server may have written the rows in between
	Written = {},
	Cache = {}, -- [board] = { WeekId, Rows = { { UserId, Value, Hidden, Faction } }, UpdatedAt }
	Names = {}, -- [userId] = { Name, At }
	Friends = {}, -- ["<lo>:<hi>"] = bool (successful IsFriendsWith calls only)
	Asking = {}, -- ["<lo>:<hi>"] = true while a background IsFriendsWith runs
	Settled = {}, -- [weekId] = the applied settle document of that week ({ Skipped = true } after D4's give-up)
	SettleFirstFail = {}, -- [weekId] = os.time() of the first failed attempt
	SettleNextTry = 0,
	ReadNext = {}, -- [board] = os.clock() of the next global read
	WarnAt = {}, -- [key] = os.clock() of the last throttled warning
	SeenOutlaw = weak(), -- [Player] = true once this server showed the player as an outlaw (for the OutlawEnd notice)
	-- the STUDIO season on a save whose ranking belongs to a live season (the working Studio uses the live saves):
	-- this session's points and results live here and are never saved, so a Studio test never touches live data
	Shadow = weak(), -- [Player] = the session's Rank table
	StudioResult = weak(), -- [Player] = { RankReward, Outlaw } of a Studio settle / DebugSettle
}
RankingService.Stats = { Reads = 0, Writes = 0, Skipped = 0, Refused = {}, Settles = 0, SettleSkipped = 0 }

-- an unfair KO (when no exemption covers it) adds 1 to the killer's PvP board: the A23-23 / plan §4 list (weak, idle,
-- new, 4th of the week, just respawned) + "Repeated" (3 KOs of one victim in 10 min, the A23-22 bully rule; 검수
-- 2026-10-06). One KO is one point whatever reasons overlap. YieldCap, WeekCap and Private are not fair either but count
-- on no board.
local UNFAIR = { Weak = true, Fresh = true, Repeated = true, Idle = true, Newbie = true, Repeat = true }
local KILLER_BOARD = { Halo = "Honor", Horns = "Infamy" } -- the board a fair KO by this faction scores on
local HAND = {} -- [Enh scroll id] = true (A23-24 장인 tags)
for _, id in R.HandScrollIds do
	HAND[id] = true
end
local REWARD_BOARDS = {} -- boards whose top 3 get the A23-22 reward (their timed titles)
for _, board in R.Order do
	if R.Boards[board].Reward then table.insert(REWARD_BOARDS, board) end
end

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	if now - (ST.WarnAt[key] or -math.huge) >= 30 then
		ST.WarnAt[key] = now
		Util.Warn(TAG, msg)
	end
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

local function week()
	return Config.WeekIndex(os.time())
end

local function factionOf(p)
	local f = p:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function lastOwn(p)
	local PS = S.PlayerService
	local fn = PS.GetLastOwnActive or PS.GetLastActive
	local ok, t = pcall(fn, p)
	return ok and tonumber(t) or 0
end

local function refuse(reason)
	local s = RankingService.Stats.Refused
	s[reason] = (s[reason] or 0) + 1
end

local function budget(kind)
	local ok, n = pcall(function() return DataStoreService:GetRequestBudgetForRequestType(kind) end)
	return ok and tonumber(n) or 0
end

local function hiddenName(faction)
	local f = faction ~= "None" and Config.Factions[faction] or nil
	return f and string.format(Config.Announce.Text.HiddenName, f.Name) or Config.Announce.Text.Someone
end

local function publicName(p)
	local A = S.AnnounceService
	if A and A.PublicName then
		local ok, name = pcall(A.PublicName, p)
		if ok and type(name) == "string" then return name end
	end
	return p:GetAttribute("HideAnnounceName") == true and hiddenName(factionOf(p)) or Util.PlayerDisplayName(p)
end

-- "STUDIO" in Studio or DataStore memory mode (never PRE / B1 rows from a test), else Config.Ranking.Season
function RankingService.EffectiveSeason()
	local ds = S and S.DataService
	local memory = false
	if ds and ds.IsMemoryMode then
		local ok, m = pcall(ds.IsMemoryMode)
		memory = ok and m == true
	end
	if RunService:IsStudio() or memory then return "STUDIO" end
	return R.Season
end

function RankingService.StoreName(board, weekId)
	return R.StorePrefix .. RankingService.EffectiveSeason() .. "_" .. board .. "_W" .. tostring(weekId)
end

local function keyOf(userId)
	return "U_" .. tostring(userId)
end

local function userIdOf(key)
	return tonumber(string.match(tostring(key), "^U_(%-?%d+)$"))
end

function RankingService.Encode(score, hidden, faction)
	return math.max(0, math.floor(score)) * 100 + (hidden and 10 or 0) + (R.FactionCode[faction] or 0)
end

-- (score, hidden, faction)
function RankingService.Decode(value)
	local v = math.max(0, math.floor(tonumber(value) or 0))
	local code = v % 10
	local faction = "None"
	for id, c in R.FactionCode do
		if c == code then faction = id end
	end
	return math.floor(v / 100), math.floor(v / 10) % 10 == 1, faction
end

-- 검수 tie rule: rows ranked by the decoded score only (never the hidden bit or the faction code of the stored value),
-- competition ranks 1, 2, 2, 4; inside a tie the order is UserId (neutral). Sorts `rows` ({ UserId, Value }) in place
-- and sets each row's Rank.
local function rankRows(rows)
	table.sort(rows, function(a, b)
		if a.Value ~= b.Value then return a.Value > b.Value end
		return a.UserId < b.UserId
	end)
	for i, r in rows do
		r.Rank = (i > 1 and rows[i - 1].Value == r.Value) and rows[i - 1].Rank or i
	end
	return rows
end

-- the settle list of one board: everyone whose competition rank is within RewardTop (all tied with 3rd included) and
-- who has at least `min` points -> { userIds }, { ranks }
local function settleList(rows, min)
	local ids, ranks = {}, {}
	for _, r in rankRows(rows) do
		if r.Rank <= R.RewardTop and r.Value >= min then
			table.insert(ids, r.UserId)
			table.insert(ranks, r.Rank)
		end
	end
	return ids, ranks
end

-- this week's points on the attributes (HUD / Tab list fame / character window)
local function publish(p, rank)
	for _, board in R.Order do
		local v = rank[board] or 0
		if p:GetAttribute("Week" .. board) ~= v then p:SetAttribute("Week" .. board, v) end
	end
end

-- data.Rank for the current week and season. A player online across Monday 00:00 KST: last week's points are kept as
-- a snapshot for one more write to last week's stores, then the week fields start over (Config.SanitizeRank). Points of
-- another season (a Studio test on the live saves, or live points in Studio) are dropped, never written here.
-- faction: the faction the snapshot belongs to when the caller knows better (a FactionChanged handler: the old one).
local function liveSeason(s)
	return type(s) == "string" and s ~= "" and s ~= "STUDIO"
end

local function ensureWeek(p, data, faction)
	local rank = data.Rank
	local cur, season = week(), RankingService.EffectiveSeason()
	if season == "STUDIO" and type(rank) == "table" and liveSeason(rank.Season) then
		-- a Studio test on a live save: the live Rank stays untouched, this session counts in a shadow table
		local shadow = ST.Shadow[p]
		if not shadow or shadow.WeekId ~= cur then
			local tmp = { Rank = shadow }
			Config.SanitizeRank(tmp, os.time())
			shadow = tmp.Rank
			shadow.Season = season
			ST.Shadow[p] = shadow
			publish(p, shadow)
		end
		return shadow
	end
	if type(rank) == "table" and rank.WeekId == cur and rank.Season == season then return rank end
	if type(rank) == "table" and rank.Season == season and (tonumber(rank.WeekId) or 0) > 0 then
		local snap = { WeekId = rank.WeekId, Faction = faction or factionOf(p), Hidden = data.HideAnnounceName == true }
		for _, board in R.Order do
			snap[board] = tonumber(rank[board]) or 0
		end
		ST.Pending[p], ST.LastWeek[p] = snap, snap
	elseif type(rank) == "table" then
		rank.WeekId = 0 -- a Studio-born or older-season save on a live server: this week's fields start over
	end
	Config.SanitizeRank(data, os.time())
	data.Rank.Season = season
	publish(p, data.Rank)
	return data.Rank
end

-- a change the next write must carry
local function bump(p)
	ST.Gen[p] = (ST.Gen[p] or 0) + 1
	ST.Dirty[p] = true
end

-- global boards: accounts younger than MinAccountDays / less play than MinPlaySeconds, Tainted saves outside STUDIO and
-- ExcludeUserIds are shown on the server board only
local function eligible(p, data)
	if table.find(R.ExcludeUserIds, p.UserId) then return false, "Excluded" end
	local studio = RankingService.EffectiveSeason() == "STUDIO"
	if data.DebugTainted == true and not studio then return false, "Tainted" end
	if studio then return true end
	if (tonumber(p.AccountAge) or 0) < R.MinAccountDays or (tonumber(data.PlaytimeSeconds) or 0) < R.MinPlaySeconds then
		return false, "Ineligible"
	end
	return true
end

------------------------------------------------------------------ points
-- +n on this week's board. Counts nothing on a private / reserved server, for another faction's board, or past the
-- board's WeekCap. Returns true when the points landed.
function RankingService.Credit(player, board, n, _why)
	n = math.floor(tonumber(n) or 0)
	local def = R.Boards[board]
	if not def or n <= 0 or typeof(player) ~= "Instance" then return false end
	if game.PrivateServerId ~= "" then refuse("Private"); return false end
	if def.Faction and factionOf(player) ~= def.Faction then refuse("Faction"); return false end
	local data = getData(player)
	if not data then return false end
	local rank = ensureWeek(player, data)
	local cap = R.WeekCap[board]
	local cur = rank[board] or 0
	if cap and cur >= cap then
		refuse("WeekCap")
		warnThrottled("cap:" .. board, ("%s reached the weekly %s cap %d"):format(player.Name, board, cap))
		return false
	end
	rank[board] = cap and math.min(cap, cur + n) or cur + n
	publish(player, rank)
	bump(player)
	return true
end

local function pairKey(a, b)
	return tostring(math.min(a.UserId, b.UserId)) .. ":" .. tostring(math.max(a.UserId, b.UserId))
end

-- friends never score on any board; a failed IsFriendsWith counts as friends (and is asked again next time).
-- noYield (a PlayerLeaving handler): only the cache answers, an unknown pair counts as friends (no points)
local function friends(a, b, noYield)
	local key = pairKey(a, b)
	local cached = ST.Friends[key]
	if cached ~= nil then return cached end
	if noYield then return true end
	local ok, res = pcall(function() return a:IsFriendsWith(b.UserId) end)
	if not ok then return true end
	ST.Friends[key] = res == true
	return res == true
end

-- CombatService's death pipeline calls this BEFORE PvPService.HandleKO changes anything: it waits (at most
-- FriendWaitSeconds, well under the respawn time) only for the background call the first hit already started, and
-- never asks Roblox itself. A pair still unknown counts as friends in JudgeKO (no board points).
function RankingService.ResolveFriends(a, b)
	if RankingService.EffectiveSeason() == "STUDIO" then return end
	if typeof(a) ~= "Instance" or typeof(b) ~= "Instance" or a == b then return end
	local key = pairKey(a, b)
	local t0 = os.clock()
	while ST.Friends[key] == nil and ST.Asking[key] and os.clock() - t0 < R.FriendWaitSeconds do
		task.wait(0.1)
	end
end

-- the first PvP hit between two players asks Roblox in the background (CombatService.PlayerDamaged), so the KO itself
-- never waits for a web call of its own
function RankingService.WarmFriends(a, b)
	if RankingService.EffectiveSeason() == "STUDIO" then return end -- friends never matter there
	if typeof(a) ~= "Instance" or typeof(b) ~= "Instance" or a == b then return end
	local key = pairKey(a, b)
	if ST.Friends[key] ~= nil or ST.Asking[key] then return end
	ST.Asking[key] = true
	task.spawn(function()
		friends(a, b)
		ST.Asking[key] = nil
	end)
end

-- BB10 PvPCreditOK: nil = a fair KO, else the first failing reason. facts from PvPService.HandleKO (Bold, Fresh,
-- Repeated). Studio season skips the victim's account age / playtime.
function RankingService.PvPCreditOK(killer, victim, facts)
	facts = type(facts) == "table" and facts or {}
	if game.PrivateServerId ~= "" then return "Private" end -- nothing counts there; the fair counters never move either
	if (tonumber(facts.Bold) or 1) < 1 then return "Weak" end
	if facts.Fresh == true then return "Fresh" end
	if facts.Repeated == true then return "Repeated" end
	local last = lastOwn(victim)
	if last <= 0 or os.clock() - last > R.VictimActiveSeconds then return "Idle" end
	local vdata = getData(victim)
	if RankingService.EffectiveSeason() ~= "STUDIO" and ((tonumber(victim.AccountAge) or 0) < R.PvPMinVictimAccountDays
		or (tonumber(vdata and vdata.PlaytimeSeconds) or 0) < R.PvPMinVictimPlaytime) then
		return "Newbie"
	end
	local kdata = getData(killer)
	if not kdata then return "NoData" end
	if (ensureWeek(killer, kdata).Victims["U" .. tostring(victim.UserId)] or 0) >= R.MaxCreditPerVictimPerWeek then
		return "Repeat"
	end
	if vdata then
		local vrank = ensureWeek(victim, vdata)
		if vrank.YieldDay == Config.DayIndex(os.time()) and vrank.YieldN >= R.MaxYieldPerVictimPerDay then return "YieldCap" end
	end
	-- a killer whose board is already at WeekCap: the point could not land, so it must not use up the fair counters
	local board = KILLER_BOARD[factionOf(killer)]
	local cap = board and R.WeekCap[board]
	if cap and (ensureWeek(killer, kdata)[board] or 0) >= cap then return "WeekCap" end
	return nil
end

-- the ranking verdict of one PvP KO: { Fair, Reason?, Exempt?, Unfair? }. An unfair KO no exemption covers adds 1 to
-- the killer's PvP board here. Exempt (D2 / A23-23): revenge, Wanted / bully / outlaw / kaiju victims, a kaiju killer,
-- a thief carrying a grudge sack and self-defense never count as unfair.
function RankingService.JudgeKO(killer, victim, facts)
	facts = type(facts) == "table" and facts or {}
	local verdict = { Fair = false }
	if RankingService.EffectiveSeason() ~= "STUDIO" and friends(killer, victim, facts.NoYield == true) then
		verdict.Reason = "Friend"
		refuse("Friend")
		return verdict
	end
	local exempt = (facts.Revenge == true and "Revenge") or (facts.VictimWanted == true and "Wanted")
		or (facts.VictimBully == true and "Bully") or (facts.VictimOutlaw == true and "Outlaw")
		or (facts.VictimKaiju == true and "Kaiju") or (facts.KillerKaiju == true and "KillerKaiju")
		or (facts.VictimHadSack == true and "Sack") or (facts.Defense == true and "Defense") or nil
	local reason = RankingService.PvPCreditOK(killer, victim, facts)
	if reason == nil then
		verdict.Fair = true
		return verdict
	end
	refuse(reason)
	verdict.Reason, verdict.Exempt = reason, exempt
	if exempt == nil and UNFAIR[reason] then
		verdict.Unfair = reason
		RankingService.Credit(killer, "PvP", 1, reason)
	end
	return verdict
end

-- a fair point was really given: the killer's per-victim week count and the victim's daily yield go up
function RankingService.CommitFair(killer, victim)
	local kdata, vdata = getData(killer), getData(victim)
	if kdata then
		local list = ensureWeek(killer, kdata).Victims
		local key = "U" .. tostring(victim.UserId)
		if list[key] == nil then
			local n, lowKey, low = 0, nil, math.huge
			for k, c in list do
				n += 1
				if c < low then lowKey, low = k, c end
			end
			if n >= R.MaxVictimKeys and lowKey then list[lowKey] = nil end -- the save stays bounded
		end
		list[key] = math.min(99, (list[key] or 0) + 1)
	end
	if vdata then
		local rank = ensureWeek(victim, vdata)
		local today = Config.DayIndex(os.time())
		if rank.YieldDay ~= today then rank.YieldDay, rank.YieldN = today, 0 end
		rank.YieldN = math.min(99, rank.YieldN + 1)
	end
end

-- PlayerService.GrantFame: ctx.RankPoints (a paid grudge sack) credits exactly that; ctx.PvP credits n only when
-- ctx.Fair (then the fair counters go up); no ctx / anything else (story, goose) never reaches a board (D1)
function RankingService.CreditFame(player, stat, n, ctx)
	if type(ctx) ~= "table" then return false end
	local board = (stat == "Honor" and "Honor") or (stat == "Infamy" and "Infamy") or nil
	if not board then return false end
	if ctx.RankPoints ~= nil then
		return RankingService.Credit(player, board, ctx.RankPoints, "Sack")
	end
	if ctx.PvP == true and ctx.Fair == true then
		local ok = RankingService.Credit(player, board, n, "PvP")
		if ok and typeof(ctx.Victim) == "Instance" then RankingService.CommitFair(player, ctx.Victim) end
		return ok
	end
	return false
end

------------------------------------------------------------------ 장인 명성 (A23-24)
-- scrolls from my own kills (RollKill -> ItemsGranted, incl. the first king-slime scroll) while in the guild and
-- active within HandActiveSeconds get one tag each; away auto-hunting and other factions' scrolls get none
local function onItemsGranted(player, gained)
	if factionOf(player) ~= "Neutral" or type(gained) ~= "table" then return end
	if game.PrivateServerId ~= "" then return end -- private-server scrolls never score later on a public server
	local last = lastOwn(player)
	if last <= 0 or os.clock() - last > R.HandActiveSeconds then return end
	local data = getData(player)
	if not data then return end
	local tags = ensureWeek(player, data).HandScroll
	for _, g in gained do
		if type(g) == "table" and HAND[g.Item] then
			local n = math.max(0, math.floor(tonumber(g.N) or 0))
			tags[g.Item] = math.min(Config.Loot.ItemCap, (tags[g.Item] or 0) + n)
		end
	end
end

-- an enhance with a tagged scroll: one tag is used; a success scores the steps it really rose (+10 cut already in
-- after - before). Failures and transfer scrolls score nothing.
local function onEnhanced(player, _tier, before, after, success, id)
	if not HAND[id] then return end
	local data = getData(player)
	if not data then return end
	local tags = ensureWeek(player, data).HandScroll
	local held = type(data.Items) == "table" and math.floor(tonumber(data.Items[id]) or 0) or 0
	local have = math.min(tags[id] or 0, held + 1) -- the used scroll was already taken out of Items
	if have <= 0 then
		tags[id] = nil
		return
	end
	tags[id] = have > 1 and have - 1 or nil
	local gain = success == true and math.max(0, math.floor((tonumber(after) or 0) - (tonumber(before) or 0))) or 0
	if gain > 0 and RankingService.Credit(player, "Artisan", gain, "Enhance") then
		pcall(Net.Notify, player, string.format(TXT.ArtisanGain, gain), "reward")
	end
end

------------------------------------------------------------------ writes
-- one row: SetAsync (or RemoveAsync for nil) unless this server already wrote that value in this session; false = retry
local function writeRow(written, name, key, value)
	local want = value -- false = "removed" in the cache (never `value == nil and false or value`: that is nil again)
	if want == nil then want = false end
	if written[name] == want then return true end
	if budget(Enum.DataStoreRequestType.SetIncrementSortedAsync) < R.MinBudget then
		RankingService.Stats.Skipped += 1
		return false
	end
	local ok, err = pcall(function()
		local store = DataStoreService:GetOrderedDataStore(name)
		if value == nil then
			store:RemoveAsync(key)
		else
			store:SetAsync(key, value)
		end
	end)
	if not ok then
		warnThrottled("write", "write " .. name .. " failed: " .. tostring(err))
		return false
	end
	written[name] = want
	RankingService.Stats.Writes += 1
	return true
end

-- { [storeName] = value } a player should have: faction boards only for the faction, points > 0 only
local function rowsOf(p, src, hidden)
	local out = {}
	local faction = src.Faction or factionOf(p)
	if src.Hidden ~= nil then hidden = src.Hidden end
	for _, board in R.Order do
		local def = R.Boards[board]
		local score = tonumber(src[board]) or 0
		if score > 0 and (def.Faction == nil or def.Faction == faction) then
			out[RankingService.StoreName(board, src.WeekId)] = RankingService.Encode(score, hidden, faction)
		end
	end
	return out
end

-- the rows a faction change dropped (Rank.Drop, kept in the save until the removal lands; a board the player is back on
-- with points is simply overwritten), then last week's snapshot and this week's rows (eligible players only).
-- Flags are cleared only for the state this write carried: a change made while it yielded (another Credit, a hide
-- toggle) stays queued for the next loop step. true = everything landed.
local function writePlayer(p, data)
	local key = keyOf(p.UserId)
	local written = ST.Written[p.UserId] or {}
	ST.Written[p.UserId] = written
	local rank = ST.Shadow[p] or data.Rank
	local gen0, hidden = ST.Gen[p] or 0, data.HideAnnounceName == true
	local ok = eligible(p, data)
	local want = ok and rowsOf(p, rank, hidden) or {}
	ST.Writing[p] = true
	local all = true
	for board, wk in table.clone(rank.Drop) do
		local name = RankingService.StoreName(board, wk) -- a removal from last week survives the Monday flip
		if want[name] ~= nil or writeRow(written, name, key, nil) then
			rank.Drop[board] = nil
		else
			all = false
		end
	end
	local done = true
	if not ok then
		RankingService.Stats.Skipped += 1
		ST.Pending[p] = nil
	else
		local snap = ST.Pending[p]
		if snap then
			local sent = true
			for name, value in rowsOf(p, snap, hidden) do
				sent = writeRow(written, name, key, value) and sent
			end
			if sent and ST.Pending[p] == snap then ST.Pending[p] = nil end
			all = all and sent
		end
		for name, value in want do
			done = writeRow(written, name, key, value) and done
		end
	end
	ST.LastWrite[p] = os.clock()
	ST.Writing[p] = nil
	if done then
		if (ST.Gen[p] or 0) == gen0 then ST.Dirty[p] = nil end
		if ST.HideQueue[p] and (data.HideAnnounceName == true) == hidden then
			ST.HideQueue[p] = nil
			rank.HideSynced = hidden
		end
	end
	return all and done
end

-- the hidden flag changed: every row is rewritten at the next loop step (WriteEverySeconds ignored) until it lands
function RankingService.MarkHideChanged(player)
	if typeof(player) ~= "Instance" then return end
	ST.HideQueue[player] = true
	bump(player)
end

function RankingService.TickWrite()
	local now = os.clock()
	for _, p in S.PlayerService.GetReadyPlayers() do
		local data = getData(p)
		if data and not ST.Writing[p] then
			local rank = ensureWeek(p, data)
			local due = ST.Force[p] or ST.HideQueue[p] or ST.Pending[p] or next(rank.Drop) ~= nil
				or (ST.Dirty[p] and now - (ST.LastWrite[p] or -math.huge) >= R.WriteEverySeconds)
			if due then
				ST.Force[p] = nil
				local ok, err = pcall(writePlayer, p, data)
				if not ok then warnThrottled("writePlayer", "writePlayer: " .. tostring(err)) end
			end
		end
	end
end

------------------------------------------------------------------ reads
local function nameOf(userId)
	if userId <= 0 then return string.format(R.StudioNames, math.abs(userId)) end
	local c = ST.Names[userId]
	if c and os.clock() - c.At < R.NameCacheSeconds then return c.Name end
	return nil
end

local function fetchNames(ids)
	local need = {}
	for _, id in ids do
		if id > 0 and nameOf(id) == nil then table.insert(need, id) end
	end
	if #need == 0 then return end
	local ok, infos = pcall(function() return UserService:GetUserInfosByUserIdsAsync(need) end)
	if not ok or type(infos) ~= "table" then
		warnThrottled("names", "name lookup failed: " .. tostring(infos))
		return
	end
	for _, info in infos do
		local id = type(info) == "table" and tonumber(info.Id)
		if id then
			ST.Names[id] = { Name = tostring(info.DisplayName or info.Username or TXT.Unknown), At = os.clock() }
		end
	end
end

-- one global read of this week's board into the server cache (clients only ever get the cache)
function RankingService.ReadBoard(board)
	if not R.Boards[board] then return false end
	if budget(Enum.DataStoreRequestType.GetSortedAsync) < R.MinReadBudget then
		RankingService.Stats.Skipped += 1
		return false
	end
	local weekId = week()
	local ok, page = pcall(function()
		return DataStoreService:GetOrderedDataStore(RankingService.StoreName(board, weekId)):GetSortedAsync(false, R.TopN)
			:GetCurrentPage()
	end)
	if not ok or type(page) ~= "table" then
		warnThrottled("read:" .. board, "read " .. board .. " failed: " .. tostring(page))
		return false
	end
	RankingService.Stats.Reads += 1
	local rows, ids = {}, {}
	for _, entry in page do
		local userId = type(entry) == "table" and userIdOf(entry.key)
		if userId then
			local score, hidden, faction = RankingService.Decode(entry.value)
			if score > 0 then
				table.insert(rows, { UserId = userId, Value = score, Hidden = hidden, Faction = faction })
				table.insert(ids, userId)
			end
		end
	end
	rankRows(rows) -- same score = same rank number (the stored order also used the hidden bit / faction code)
	fetchNames(ids)
	ST.Cache[board] = { WeekId = weekId, Rows = rows, UpdatedAt = Util.Now() }
	return true
end

function RankingService.TickRead()
	local now = os.clock()
	for i, board in R.Order do
		if ST.ReadNext[board] == nil then ST.ReadNext[board] = now + (i - 1) * R.ReadStagger end
		if now >= ST.ReadNext[board] then
			ST.ReadNext[board] = now + R.RefreshSeconds
			RankingService.ReadBoard(board)
		end
	end
end

-- rows sent to clients + the real user id of each row (ids[i], never sent: hidden rows have UserId 0)
local function globalRows(board)
	local cache = ST.Cache[board]
	if not cache or cache.WeekId ~= week() then return {}, {}, 0 end
	local rows, ids = {}, {}
	for i, r in cache.Rows do
		local live = Players:GetPlayerByUserId(r.UserId)
		local hidden = r.Hidden
		if live then hidden = live:GetAttribute("HideAnnounceName") == true end -- re-masked from the live choice
		local row = { Rank = r.Rank or i, UserId = hidden and 0 or r.UserId, Faction = r.Faction, Value = r.Value }
		if hidden then
			row.Name = hiddenName(r.Faction)
		else
			row.Name = nameOf(r.UserId) or TXT.Unknown
			if live then
				local nick = Util.PlayerDisplayName(live)
				if nick ~= row.Name then row.Sub = nick end
			end
		end
		rows[i], ids[i] = row, r.UserId
	end
	return rows, ids, cache.UpdatedAt
end

-- this server's live points of one board (weekId = last week: the snapshots taken at the Monday flip)
local function serverRows(board, weekId)
	local def = R.Boards[board]
	local cur = week()
	local list = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		local data = getData(p)
		if data then
			local v, f = 0, factionOf(p)
			if weekId == nil or weekId == cur then
				v = ensureWeek(p, data)[board] or 0
			else
				local snap = ST.LastWeek[p]
				if snap and snap.WeekId == weekId then v, f = snap[board] or 0, snap.Faction end
			end
			if v > 0 and (def.Faction == nil or def.Faction == f) then
				table.insert(list, { P = p, UserId = p.UserId, Value = v, Faction = f, Test = data.DebugTainted == true or nil })
			end
		end
	end
	rankRows(list)
	local rows, ids = {}, {}
	for i = 1, math.min(R.TopN, #list) do
		local e = list[i]
		local hidden = e.P:GetAttribute("HideAnnounceName") == true
		rows[i] = { Rank = e.Rank, UserId = hidden and 0 or e.P.UserId, Name = publicName(e.P), Faction = e.Faction,
			Value = e.Value, Test = e.Test }
		ids[i] = e.P.UserId
	end
	return rows, ids, Util.Now()
end

-- BB11 town board (PvPService.updateBoard): this server's top `n` of one weekly board, ranked like the window (ties
-- share a number), names through PublicName; Outlaw = the player is an outlaw NOW (last week's settle), never this
-- week's candidates (검수 2026-10-06)
function RankingService.ServerTop(board, n)
	if not R.Boards[board] then return {} end
	local rows, ids = serverRows(board)
	local out = {}
	for i = 1, math.min(tonumber(n) or R.RewardTop, #rows) do
		local p = Players:GetPlayerByUserId(ids[i])
		table.insert(out, { Rank = rows[i].Rank, Name = rows[i].Name, Value = rows[i].Value,
			Outlaw = p ~= nil and p:GetAttribute("Outlaw") == true })
	end
	return out
end

local function onRequest(player, ...)
	if select("#", ...) ~= 2 then return end
	local board, scope = ...
	if type(board) ~= "string" or R.Boards[board] == nil or (scope ~= "Server" and scope ~= "Global") then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "RequestRankings", Config.RateLimits.RequestRankings) then return end
	local rows, ids, updatedAt
	if scope == "Server" then
		rows, ids, updatedAt = serverRows(board)
	else
		rows, ids, updatedAt = globalRows(board)
	end
	local me = { Value = 0 }
	local data = getData(player)
	if data then
		me.Value = ensureWeek(player, data)[board] or 0
		local at = table.find(ids, player.UserId)
		me.Rank = at and rows[at].Rank or nil
		if game.PrivateServerId ~= "" then
			me.Note = "Private"
		elseif scope == "Global" and not eligible(player, data) then
			me.Note = "Ineligible"
		elseif data.HideAnnounceName == true then
			me.Note = "Hidden" -- my rows show '<진영> 한 명' to others (BB37)
		end
	end
	local cur = week()
	Net.Get("Rankings"):FireClient(player, { Board = board, Scope = scope, Rows = rows, Me = me, UpdatedAt = updatedAt,
		WeekId = cur, WeekEndsAt = Config.WeekStart(cur + 1) })
end

------------------------------------------------------------------ weekly settle + effects
-- the timed "이번 주 …" titles of the reward boards: only this week's reward keeps its title
local function syncTitles(p, rr, cur)
	local T = S.TitleService
	if not (T and T.Revoke) then return end
	if RankingService.EffectiveSeason() == "STUDIO" then return end -- a Studio test never removes a live title
	for _, board in REWARD_BOARDS do
		for rank = 1, R.RewardTop do
			if not (rr.WeekId == cur and rr.Board == board and rr.Rank == rank) then
				pcall(T.Revoke, p, "Rank" .. board .. rank)
			end
		end
	end
end

-- attributes from the saved results of this season: Outlaw (this week), RankReward / RankRewardRank (this week AND in
-- that board's faction)
local function resultsOf(p, data)
	if RankingService.EffectiveSeason() == "STUDIO" and liveSeason(type(data.Rank) == "table" and data.Rank.Season) then
		ST.StudioResult[p] = ST.StudioResult[p] or {}
		return ST.StudioResult[p] -- Studio on a live save: session-only results
	end
	return data
end

function RankingService.RefreshEffects(p)
	local data = getData(p)
	if not data then return end
	local cur, season = week(), RankingService.EffectiveSeason()
	data = resultsOf(p, data)
	local ol = type(data.Outlaw) == "table" and data.Outlaw or {}
	local outlaw = ol.WeekId == cur and ol.Season == season
	local rr = type(data.RankReward) == "table" and data.RankReward or {}
	local mine = rr.WeekId == cur and rr.Season == season
	local def = R.Boards[rr.Board]
	local on = mine and def ~= nil and def.Reward == true and def.Faction == factionOf(p)
	if outlaw then ST.SeenOutlaw[p] = true end
	if p:GetAttribute("Outlaw") ~= outlaw then
		p:SetAttribute("Outlaw", outlaw)
		-- the end of the week: still a bully -> nothing here (CombatService says BullyPenaltyEnd when the stacks go)
		if not outlaw and ST.SeenOutlaw[p] then
			ST.SeenOutlaw[p] = nil
			if (tonumber(p:GetAttribute("BullyStacks")) or 0) < 1 then
				local text = p:GetAttribute("AutoCombatUnlocked") == true and TXT.OutlawEnd or TXT.OutlawEndNoAuto
				pcall(Net.Notify, p, text, "good")
			end
		end
	end
	local board = on and rr.Board or ""
	if p:GetAttribute("RankReward") ~= board then p:SetAttribute("RankReward", board) end
	local rank = on and rr.Rank or 0
	if p:GetAttribute("RankRewardRank") ~= rank then p:SetAttribute("RankRewardRank", rank) end
	syncTitles(p, mine and rr or {}, cur)
end

-- one settle document applied to one player (idempotent): results count for the week after the settled one only
local function applySettle(p, doc)
	if type(doc) ~= "table" or doc.Skipped or type(doc.Boards) ~= "table" then return end
	local effect = (tonumber(doc.Week) or 0) + 1
	if effect ~= week() then return end
	local data = getData(p)
	if not data then return end
	data = resultsOf(p, data)
	local season = RankingService.EffectiveSeason()
	local best = nil
	for _, board in R.Order do
		local list = doc.Boards[board]
		local at = type(list) == "table" and table.find(list, p.UserId) or nil
		local ranks = type(doc.Ranks) == "table" and doc.Ranks[board] or nil
		local r = at and math.clamp(math.floor(tonumber(type(ranks) == "table" and ranks[at]) or at), 1, R.RewardTop) or nil
		if r and R.Boards[board].Outlaw then
			local ol = data.Outlaw
			if type(ol) ~= "table" or ol.WeekId ~= effect or ol.Season ~= season then
				data.Outlaw = { WeekId = effect, Season = season }
				pcall(Net.Notify, p, string.format(TXT.OutlawStart, r), "bad", 8)
			end
		elseif r and R.Boards[board].Reward and (best == nil or r < best.Rank) then
			best = { Board = board, Rank = r }
		end
	end
	-- the week's title, also given back when something removed it (Grant is a no-op when it is owned)
	if best and S.TitleService and S.TitleService.Grant then pcall(S.TitleService.Grant, p, "Rank" .. best.Board .. best.Rank) end
	local rr = data.RankReward
	if best and not (type(rr) == "table" and rr.WeekId == effect and rr.Season == season and rr.Board == best.Board
		and rr.Rank == best.Rank) then
		data.RankReward = { WeekId = effect, Season = season, Board = best.Board, Rank = best.Rank }
		local f = R.Boards[best.Board].Faction
		local text = string.format(TXT.RewardStart, TXT.BoardNames[best.Board], best.Rank)
		if f ~= factionOf(p) then -- switched since: the title is given, the +10% waits for that faction
			text = string.format(TXT.RewardStartOff, TXT.BoardNames[best.Board], best.Rank, Config.Factions[f].Name)
		end
		pcall(Net.Notify, p, text, "reward", 8)
	end
	RankingService.RefreshEffects(p)
end

-- the top-RewardTop list of one board of week `weekId` from the global store: everyone tied with 3rd included (the
-- page is TopN long for that), ranked by the decoded score only; PvP needs OutlawMinScore points -> { ids }, { ranks }
local function topOf(board, weekId)
	local page = DataStoreService:GetOrderedDataStore(RankingService.StoreName(board, weekId))
		:GetSortedAsync(false, R.TopN):GetCurrentPage()
	local min = R.Boards[board].Outlaw and R.OutlawMinScore or 1
	local rows = {}
	for _, entry in page do
		local userId = type(entry) == "table" and userIdOf(entry.key)
		local score = userId and RankingService.Decode(entry.value) or 0
		if userId and score > 0 then table.insert(rows, { UserId = userId, Value = score }) end
	end
	local ids, ranks = settleList(rows, min)
	if #page >= R.TopN and #ids > 0 and rows[#rows].Value >= rows[#ids].Value then
		warnThrottled("tie:" .. board, ("%s week %d: a tie at the top reaches the %d-row page; rows past it are not read"):format(
			board, weekId, R.TopN))
	end
	return ids, ranks
end

-- the same lists from this server's points of week `fromWeek` (the STUDIO season settle: last week's snapshots;
-- DebugSettle: this week's live points), stored as the results of week `weekId`
local function serverDoc(weekId, fromWeek)
	local doc = { Week = weekId, Boards = {}, Ranks = {}, At = os.time(), Server = true }
	for _, board in R.Order do
		local rows, ids = serverRows(board, fromWeek)
		local list = {}
		for i, row in rows do
			table.insert(list, { UserId = ids[i], Value = row.Value })
		end
		doc.Boards[board], doc.Ranks[board] = settleList(list, R.Boards[board].Outlaw and R.OutlawMinScore or 1)
	end
	return doc
end

-- once per week per server: last week's results (the stored document, or built and stored first-writer-wins)
function RankingService.TickSettle()
	local cur = week()
	local prev = cur - 1
	if ST.Settled[prev] ~= nil then return end
	if os.time() < Config.WeekStart(cur) + R.SettleDelaySeconds or os.clock() < ST.SettleNextTry then return end
	local season = RankingService.EffectiveSeason()
	local first = ST.SettleFirstFail[prev]
	local giveUp = season ~= "STUDIO" and first ~= nil and os.time() - first >= R.SettleGiveUpSeconds
	local ok, doc = pcall(function()
		local store = DataStoreService:GetDataStore(R.SettleStorePrefix .. season)
		local key = "W" .. tostring(prev)
		local stored = store:GetAsync(key)
		if type(stored) == "table" then return stored end
		local built
		if giveUp then
			-- D4: after SettleGiveUpSeconds of failed reads the skip itself is stored, first writer wins (a real document
			-- another server stored first is still applied), so every server applies the same decision
			built = { Week = prev, Skipped = true, At = os.time() }
		else
			built = { Week = prev, Boards = {}, Ranks = {}, At = os.time() }
			for _, board in R.Order do
				built.Boards[board], built.Ranks[board] = topOf(board, prev)
			end
		end
		return store:UpdateAsync(key, function(old)
			return type(old) == "table" and old or built
		end)
	end)
	if not ok or type(doc) ~= "table" then
		if season ~= "STUDIO" then
			-- nothing is applied until a document (real or skipped) is read or stored: no per-server lists
			ST.SettleFirstFail[prev] = first or os.time()
			ST.SettleNextTry = os.clock() + R.SettleRetrySeconds
			warnThrottled("settle", ("week %d settle failed, retrying in %d s: %s"):format(prev, R.SettleRetrySeconds,
				tostring(doc)))
			return
		end
		doc = serverDoc(prev, prev) -- D4: the STUDIO season settles from this server's board (last week's snapshots)
	end
	ST.Settled[prev] = doc
	if doc.Skipped then
		RankingService.Stats.SettleSkipped += 1
		Util.Warn(TAG, ("week %d settle skipped: board reads failed for %d s (no rewards / outlaws on any server)"):format(
			prev, R.SettleGiveUpSeconds))
		return
	end
	RankingService.Stats.Settles += 1
	for _, p in S.PlayerService.GetReadyPlayers() do
		local okApply, err = pcall(applySettle, p, doc)
		if not okApply then warnThrottled("apply", "apply settle: " .. tostring(err)) end
	end
end

-- every loop step: the week of every online player, the GameState week mirror and the effect attributes
function RankingService.TickWeek()
	local cur = week()
	local okGs, gs = pcall(Net.GameState)
	if okGs and gs then
		if gs:GetAttribute("RankWeekId") ~= cur then gs:SetAttribute("RankWeekId", cur) end
		local ends = Config.WeekStart(cur + 1)
		if gs:GetAttribute("RankWeekEndsAt") ~= ends then gs:SetAttribute("RankWeekEndsAt", ends) end
	end
	for _, p in S.PlayerService.GetReadyPlayers() do
		local data = getData(p)
		if data then
			ensureWeek(p, data)
			RankingService.RefreshEffects(p)
		end
	end
end

------------------------------------------------------------------ debug (Studio season only)
-- DebugCommand "RankSettle": settles THIS week's server board now and applies it at once (results act this week)
function RankingService.DebugSettle()
	if RankingService.EffectiveSeason() ~= "STUDIO" then return "STUDIO season only" end
	local doc = serverDoc(week() - 1, week())
	for _, p in S.PlayerService.GetReadyPlayers() do
		pcall(applySettle, p, doc)
	end
	local parts = {}
	for _, board in R.Order do
		local ids = {}
		for _, id in doc.Boards[board] do table.insert(ids, tostring(id)) end
		table.insert(parts, board .. "=" .. table.concat(ids, ","))
	end
	return table.concat(parts, " ")
end

-- DebugCommand "RankWrite": write this player's rows at the next loop step
function RankingService.DebugWrite(player)
	ST.Force[player] = true
	ST.Dirty[player] = true
	return "queued"
end

------------------------------------------------------------------ lifecycle
local function onReady(p, data)
	data = type(data) == "table" and data or getData(p)
	if not data then return end
	ST.Written[p.UserId] = nil -- a new session never trusts what this server wrote earlier (another server may have since)
	local rank = ensureWeek(p, data)
	publish(p, rank)
	for _, board in R.Order do
		if (rank[board] or 0) > 0 then ST.Dirty[p] = true end -- a last write that never landed is redone
	end
	if next(rank.Drop) ~= nil then ST.Force[p] = true end -- a removal that never landed
	local doc = ST.Settled[week() - 1]
	if doc then applySettle(p, doc) end
	RankingService.RefreshEffects(p)
	if rank.HideSynced ~= (data.HideAnnounceName == true) then RankingService.MarkHideChanged(p) end
end

-- faction change (altar, rebirth, first pick): the old faction's board row goes (this week's points there are gone; the
-- removal is kept in the save as Rank.Drop until it lands); leaving the guild also drops the 장인 tags; the PvP row keeps
-- its points with the new faction code
local function onFactionChanged(p, newFaction, oldFaction)
	local data = getData(p)
	if not data then return end
	local rank = ensureWeek(p, data, oldFaction) -- a week flip first seen here belongs to the old faction
	for _, board in R.Order do
		local f = R.Boards[board].Faction
		if f and f == oldFaction and f ~= newFaction then
			rank[board] = 0
			rank.Drop[board] = rank.WeekId
		end
	end
	if oldFaction == "Neutral" and newFaction ~= "Neutral" then rank.HandScroll = {} end
	publish(p, rank)
	bump(p)
	ST.Force[p] = true
	RankingService.RefreshEffects(p)
end

local function forget(p)
	for _, t in { ST.Dirty, ST.Force, ST.LastWrite, ST.Pending, ST.LastWeek, ST.HideQueue, ST.Gen, ST.Writing, ST.SeenOutlaw,
		ST.Shadow, ST.StudioResult } do
		t[p] = nil
	end
	ST.Written[p.UserId] = nil
end

-- PlayerLeaving handlers must not yield (the final save waits for them): the last write runs in its own thread with the
-- data table it captured (still valid after the release). It waits for a loop write of the same player still running,
-- tries LeaveWriteTries times, and PlayerService's BindToClose waits for it (RankingService.PendingWrites).
local function onLeaving(p, data)
	data = type(data) == "table" and data or getData(p)
	if type(data) ~= "table" or type(ST.Shadow[p] or data.Rank) ~= "table" then
		forget(p)
		return
	end
	ensureWeek(p, data)
	ST.Leaving += 1
	task.spawn(function()
		local t0 = os.clock()
		while ST.Writing[p] and os.clock() - t0 < R.LeaveWaitSeconds do
			task.wait(0.1)
		end
		for attempt = 1, R.LeaveWriteTries do
			local ok, res = pcall(writePlayer, p, data)
			if not ok then warnThrottled("leave", "leave write: " .. tostring(res)) end
			if ok and res == true then break end
			if attempt < R.LeaveWriteTries then task.wait(1) end
		end
		forget(p)
		ST.Leaving -= 1
	end)
end

-- leave writes still running (PlayerService's BindToClose waits for them after the saves)
function RankingService.PendingWrites()
	return ST.Leaving
end

function RankingService.Init(registry)
	S = registry
end

function RankingService.Start()
	S.PlayerService.PlayerReady:Connect(function(p, data)
		local ok, err = pcall(onReady, p, data)
		if not ok then Util.Warn(TAG, "ready: " .. tostring(err)) end
	end)
	S.PlayerService.PlayerLeaving:Connect(function(p, data)
		local ok, err = pcall(onLeaving, p, data)
		if not ok then Util.Warn(TAG, "leaving: " .. tostring(err)) end
	end)
	S.FactionService.FactionChanged:Connect(function(p, newFaction, oldFaction)
		local ok, err = pcall(onFactionChanged, p, newFaction, oldFaction)
		if not ok then Util.Warn(TAG, "faction: " .. tostring(err)) end
	end)
	S.LootService.ItemsGranted:Connect(function(p, gained)
		local ok, err = pcall(onItemsGranted, p, gained)
		if not ok then Util.Warn(TAG, "items: " .. tostring(err)) end
	end)
	S.LootService.Enhanced:Connect(function(p, ...)
		local ok, err = pcall(onEnhanced, p, ...)
		if not ok then Util.Warn(TAG, "enhance: " .. tostring(err)) end
	end)
	if S.CombatService and S.CombatService.PlayerDamaged then
		S.CombatService.PlayerDamaged:Connect(function(victim, _applied, attacker)
			RankingService.WarmFriends(attacker, victim)
		end)
	end
	Net.Get("RequestRankings").OnServerEvent:Connect(function(p, ...)
		local ok, err = pcall(onRequest, p, ...)
		if not ok then Util.Warn(TAG, "RequestRankings: " .. tostring(err)) end
	end)
	task.spawn(function()
		while true do
			task.wait(R.LoopSeconds)
			for _, step in { RankingService.TickWeek, RankingService.TickWrite, RankingService.TickRead, RankingService.TickSettle } do
				local ok, err = pcall(step)
				if not ok then warnThrottled("loop", "loop: " .. tostring(err)) end
			end
		end
	end)
	print("[RankingService] started")
end

return RankingService
]]></ProtectedString>
				<string name="ScriptGuid">{FC394813-0FCD-47DC-A8CD-6F40520791A7}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RankingService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c05000008b7</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXA495235E124D4340895E7C7FB4442DAA">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- TelemetryService.luau : P6 (mmorpg_painpoints §2) Roblox AnalyticsService funnel / custom events, no personal data
-- (no names, no chat; AnalyticsService ties events to the player by itself). Read-only observer: it only listens to
-- existing signals / attributes and never changes game state. Every call is pcall'd and throttled; a missing
-- AnalyticsService (Studio, old engine) costs nothing.
--   Onboarding funnel (each step once per player, in any order; saved in data.Telemetry.Steps = { [n] = true }): 1 Joined, 2 OpeningDone, 3 FactionChosen,
--     4 ClassChosen, 5 FirstMissionAccepted, 6 FirstMissionDone, 7 FirstWeaponOwned, 8 AutoCombatUnlocked
--   Custom events: FirstDeath (cause Monster/PvP), AutoToggle (1/0), SackOutcome (Paid/Avenged/Returned),
--     SessionMinutes (+ bucket), LeftAfterEnhanceDrop, RookieFirstKillSeconds (meadow entry -> first kill),
--     HighLevelInMeadow, ServerPopulation (+ Halo/Horns counts), CrownTrialMiss (reason)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local TelemetryService = {}
local S = nil
local T = {
	Analytics = nil,
	JoinedAt = {}, -- [Player] = os.clock()
	MeadowAt = {}, -- [Player] = os.clock() of the first SlimeMeadow entry this session (rookies only)
	EnhanceDropAt = {}, -- [Player] = os.clock() of the last enhance failure that lost a level
	Throttle = {}, -- ["<userId>:<key>"] = os.clock()
	Conns = {}, -- [Player] = { RBXScriptConnection } (attribute watchers, dropped on leave)
	Steps = { "Joined", "OpeningDone", "FactionChosen", "ClassChosen", "FirstMissionAccepted", "FirstMissionDone",
		"FirstWeaponOwned", "AutoCombatUnlocked" },
}

local function analytics()
	if T.Analytics == nil then
		local ok, svc = pcall(game.GetService, game, "AnalyticsService")
		T.Analytics = ok and svc or false
	end
	return T.Analytics or nil
end

local function fields(a, b, c)
	local f = {}
	local keys = Enum.AnalyticsCustomFieldKeys
	if a ~= nil then f[keys.CustomField01.Name] = tostring(a) end
	if b ~= nil then f[keys.CustomField02.Name] = tostring(b) end
	if c ~= nil then f[keys.CustomField03.Name] = tostring(c) end
	return f
end

local function throttled(player, key, seconds)
	local k = tostring(player.UserId) .. ":" .. key
	local now = os.clock()
	if T.Throttle[k] and now - T.Throttle[k] < seconds then return true end
	T.Throttle[k] = now
	return false
end

-- review: no Parent check — leave-time events (session length, sack returned) fire while the Player is being removed
function TelemetryService.Custom(player, name, value, a, b, c)
	local svc = analytics()
	if not svc or typeof(player) ~= "Instance" or not player:IsA("Player") then return end
	pcall(svc.LogCustomEvent, svc, player, name, tonumber(value) or 1, fields(a, b, c))
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

-- onboarding funnel step: each step at most once per player, whatever order they happen in (S0 can finish before the
-- first mission; review of 5493770). The first build saved only the highest step (Onb = n): read as steps 1..n.
function TelemetryService.Step(player, step)
	local data = getData(player)
	if not data then return end
	if type(data.Telemetry) ~= "table" then data.Telemetry = {} end
	local tel = data.Telemetry
	if type(tel.Steps) ~= "table" then
		tel.Steps = {}
		for n = 1, math.clamp(math.floor(tonumber(tel.Onb) or 0), 0, #T.Steps) do tel.Steps[tostring(n)] = true end
		tel.Onb = nil
	end
	if tel.Steps[tostring(step)] then return end
	tel.Steps[tostring(step)] = true
	local svc = analytics()
	if not svc then return end
	pcall(svc.LogOnboardingFunnelStepEvent, svc, player, step, T.Steps[step] or tostring(step))
end

local function watch(player, attr, fn)
	T.Conns[player] = T.Conns[player] or {}
	table.insert(T.Conns[player], player:GetAttributeChangedSignal(attr):Connect(function()
		local ok, err = pcall(fn, player:GetAttribute(attr))
		if not ok then Util.Warn("TelemetryService", attr .. ": " .. tostring(err)) end
	end))
end

local function onReady(player, data)
	T.JoinedAt[player] = os.clock()
	TelemetryService.Step(player, 1)
	-- catch up the steps a returning player already passed (never logs the same step twice)
	if data.IntroSeen == true then TelemetryService.Step(player, 2) end
	if data.Faction ~= "None" then TelemetryService.Step(player, 3) end
	if data.ClassChosen == true then TelemetryService.Step(player, 4) end
	local tut = tonumber(data.TutorialStep) or 0
	if tut >= 1 then TelemetryService.Step(player, 5) end
	if tut == 99 then TelemetryService.Step(player, 6) end
	if (tonumber(data.WeaponOwnedMask) or 0) > 0 then TelemetryService.Step(player, 7) end -- A23-34: any weapon owned
	if data.AutoCombatUnlocked == true then TelemetryService.Step(player, 8) end
	for _, c in T.Conns[player] or {} do c:Disconnect() end
	T.Conns[player] = nil
	watch(player, "IntroSeen", function(v) if v == true then TelemetryService.Step(player, 2) end end)
	watch(player, "ClassChosen", function(v) if v == true then TelemetryService.Step(player, 4) end end)
	watch(player, "TutorialStep", function(v)
		-- accepting the guide mission sets TutorialStep 1 (2 = arrived in the meadow, 99 = first mission claimed)
		if (tonumber(v) or 0) >= 1 then TelemetryService.Step(player, 5) end
		if v == 99 then TelemetryService.Step(player, 6) end
	end)
	watch(player, "WeaponOwnedMask", function(v)
		if (tonumber(v) or 0) > 0 then TelemetryService.Step(player, 7) end
	end)
	watch(player, "AutoCombatUnlocked", function(v) if v == true then TelemetryService.Step(player, 8) end end)
	watch(player, "AutoCombatEnabled", function(v)
		if not throttled(player, "auto", 10) then TelemetryService.Custom(player, "AutoToggle", v == true and 1 or 0) end
	end)
end

local function onLeaving(player)
	local joined = T.JoinedAt[player]
	if joined then
		local minutes = math.floor((os.clock() - joined) / 60)
		local bucket = minutes < 5 and "0-5" or minutes < 15 and "5-15" or minutes < 30 and "15-30"
			or minutes < 60 and "30-60" or "60+"
		TelemetryService.Custom(player, "SessionMinutes", minutes, bucket)
	end
	local drop = T.EnhanceDropAt[player]
	if drop and os.clock() - drop <= 60 then
		TelemetryService.Custom(player, "LeftAfterEnhanceDrop", math.floor(os.clock() - drop))
	end
	T.JoinedAt[player], T.MeadowAt[player], T.EnhanceDropAt[player] = nil, nil, nil
	for _, c in T.Conns[player] or {} do c:Disconnect() end
	T.Conns[player] = nil
	for k in T.Throttle do
		if string.sub(k, 1, #tostring(player.UserId) + 1) == tostring(player.UserId) .. ":" then T.Throttle[k] = nil end
	end
end

local function connect(service, signal, fn)
	local svc = S[service]
	local sig = svc and svc[signal]
	if type(sig) == "table" and type(sig.Connect) == "function" then
		sig:Connect(function(...)
			local ok, err = pcall(fn, ...)
			if not ok then Util.Warn("TelemetryService", service .. "." .. signal .. ": " .. tostring(err)) end
		end)
	end
end

function TelemetryService.Init(registry)
	S = registry
end

function TelemetryService.Start()
	connect("PlayerService", "PlayerReady", onReady)
	connect("PlayerService", "PlayerLeaving", onLeaving)
	connect("FactionService", "FactionChanged", function(player, newFaction)
		if newFaction and newFaction ~= "None" then TelemetryService.Step(player, 3) end
	end)
	connect("PlayerService", "CharacterDied", function(player)
		local data = getData(player)
		if not data then return end
		if type(data.Telemetry) ~= "table" then data.Telemetry = {} end
		if data.Telemetry.FirstDeath then return end
		data.Telemetry.FirstDeath = true
		-- PvP = a player hit me within the combat tag; Monster = any damage in the last 3 s (DamagePlayer); else a fall,
		-- a reset or the void ("Other"). BB14 will provide the real By.
		local cause = "Other"
		local ok, attacker = pcall(S.CombatService.GetLastPvPAttacker, player)
		local okHit, hitAt = pcall(S.CombatService.GetLastDamagedAt, player)
		if ok and typeof(attacker) == "Instance" then
			cause = "PvP"
		elseif okHit and os.clock() - (tonumber(hitAt) or 0) <= 3 then
			cause = "Monster"
		end
		TelemetryService.Custom(player, "FirstDeath", 1, cause, player:GetAttribute("ZoneId"))
	end)
	connect("GrudgeService", "SackResolved", function(thief, outcome, total)
		TelemetryService.Custom(thief, "SackOutcome", tonumber(total) or 0, outcome)
	end)
	connect("LootService", "Enhanced", function(player, _tier, before, after)
		if tonumber(after) and tonumber(before) and after < before then T.EnhanceDropAt[player] = os.clock() end
	end)
	connect("ZoneService", "ZoneChanged", function(player, newZone)
		if newZone == "SlimeMeadow" and T.MeadowAt[player] == nil and (tonumber(player:GetAttribute("Level")) or 1) < 10 then
			T.MeadowAt[player] = os.clock()
		end
	end)
	connect("MonsterService", "MonsterKilled", function(player, info)
		local at = T.MeadowAt[player]
		if at and at > 0 then
			T.MeadowAt[player] = -1 -- once per session
			TelemetryService.Custom(player, "RookieFirstKillSeconds", math.floor(os.clock() - at), info and info.Kind)
		end
		-- the crown-shard trial "3 slimes with basic attacks only" (S0 step 2) did not count this slime: a skill hit it
		local data = getData(player)
		local st = data and data.Story
		local s0 = type(st) == "table" and type(st.Subs) == "table" and st.Subs.S0
		-- only while trial "a" (basic-attack slimes) is still open; a skill kill during trial "b" is expected
		local trialA = 3
		pcall(function() trialA = Config.StoryQuests.Defs.S0.Steps[2].Obj.List[1].Count end)
		local doneA = type(s0) == "table" and type(s0.T) == "table" and tonumber(s0.T.a) or 0
		if type(s0) == "table" and s0.St == 2 and doneA < trialA and type(info) == "table"
			and Config.QuestKind(info.Kind) == "Slime" -- review C-9: a pumpkin slime counts as a slime there too
			and info.SkillHit == true and not throttled(player, "trialmiss", 300) then
			TelemetryService.Custom(player, "CrownTrialMiss", 1, "SkillHit", info.Kind)
		end
	end)
	-- every 5 minutes: high levels farming the meadow, and the server's population / faction balance
	task.spawn(function()
		while true do
			task.wait(300)
			local ok, err = pcall(function()
				local ready = S.PlayerService.GetReadyPlayers()
				local halo, horns = 0, 0
				for _, p in ready do
					local f = p:GetAttribute("Faction")
					if f == "Halo" then halo += 1 elseif f == "Horns" then horns += 1 end
					if p:GetAttribute("ZoneId") == "SlimeMeadow" and (tonumber(p:GetAttribute("Level")) or 1) >= 20 then
						TelemetryService.Custom(p, "HighLevelInMeadow", tonumber(p:GetAttribute("Level")) or 0)
					end
				end
				if ready[1] then TelemetryService.Custom(ready[1], "ServerPopulation", #ready, halo, horns) end
			end)
			if not ok then Util.Warn("TelemetryService", "population: " .. tostring(err)) end
		end
	end)
	print("[TelemetryService] started")
end

return TelemetryService
]]></ProtectedString>
				<string name="ScriptGuid">{3C0DE1DD-30D0-49E8-ADE4-CFC6E660CA7F}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">TelemetryService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050001b102</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXF0C8D2F518D04CBE8656696000860E9C">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CombatService.luau : manual class swings, MP skills, damage formulas,
-- player damage / heal, regen and the death pipeline (the ONLY KO entry point).
-- Server-authoritative: clients only send Swing / Release / SetAutoAttack intents.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "CombatService"

local CombatService = {}

------------------------------------------------------------------ public signals (top level)
-- info = { Stacks, Auto, Perfect, Center, Radius, Total, MonstersHit, PlayersHit, Healed = { Player } }
-- (Total = HP really removed, CR-M10; the Release Fx shows the dealt numbers)
CombatService.Released = Util.Signal.new()
-- (victim, amount, attacker) : fired by DamagePlayer only when attacker ~= nil, after the damage.
-- amount = HP actually removed (CR-M10: no overkill; 0 under a ForceField, still fired for the bait log)
CombatService.PlayerDamaged = Util.Signal.new()

local S = nil

------------------------------------------------------------------ private constants
local MANUAL_GRACE = 0.2 -- a press this close to swing-ready is queued once for network jitter
local MANUAL_QUEUE_RETRIES = 3 -- timer-precision retries for a queued manual swing
local WHIFF_REACH = 12 -- studs in front of the player used as the visual target of a whiffed ranged swing
local LOOP_WARN_INTERVAL = 10 -- seconds between two warnings of the same loop

-- factions that take part in PvP / goose tug (addendum A6: "Neutral" and "None" never do)
local PVP_FACTIONS = { Halo = true, Horns = true }

-- A15 hit feel: every damaged player gets a "Pain" Fx to ALL clients (pain sticker over that player), at most one per
-- victim per PAIN_GAP s; Big = crit or >= BIG_FRACTION of the victim's MaxHealth. Monsters a swing / release lands on
-- are shoved SHOVE_* studs (MonsterService.Shove applies the zone / water / owner rules) SHOVE_DELAY[attack][class] s
-- after the damage, so the slide starts when clients show the hit (contact frame / projectile flight).
-- Config.HitReact, fallbacks.
local HIT_REACT = Config.HitReact or {}
local REACT = {
	PAIN_GAP = HIT_REACT.PainGap or 0.4,
	BIG_FRACTION = HIT_REACT.BigHitFraction or 0.5,
	SHOVE_SWING = HIT_REACT.ShoveSwing or 1.2,
	SHOVE_CRIT = HIT_REACT.ShoveCrit or 1.6,
	SHOVE_RELEASE = HIT_REACT.ShoveRelease or 2,
	SHOVE_DELAY = type(HIT_REACT.ShoveDelay) == "table" and HIT_REACT.ShoveDelay or {},
}

-- review R1 tuning
local TUNE = {
	-- CR-L49: Swing / Release Fx go to the attacker + players whose root is within FxCullDistance + FX_SEND_PAD + the
	-- attack extent of the center (pad >= camera max zoom: 40, kaiju 60; clients cull from the camera)
	FX_CULL = (Config.Visuals and Config.Visuals.FxCullDistance) or 150,
	FX_SEND_PAD = 60,
	-- Approved clips: cosmetic contact/flight only; damage and cooldown still resolve immediately.
	MOTION = {
		Swing = {
			Warrior = { Contact = 0.23 },
			Mage = { Launch = 0.24, Flight = 0.2, Contact = 0.44 },
			Archer = { Launch = 0.22, Flight = 0.15, Contact = 0.37 },
			Punch = { Contact = 0.15 }, -- A23-34 bare hands (every class): a short jab, no projectile
			PetHeadbutt = { Contact = 0.3 }, -- A23-39 pet tamer: the pet reaches its target and bonks it
		},
		Release = {
			Warrior = { Contact = 0.24 },
			Mage = { Launch = 0.35, Contact = 0.35 },
			Archer = { Launch = 0.18, Contact = 0.4 },
			PetDash = { Contact = 0.35 }, -- A23-39 pet tamer: the pet dashes into the area
		},
	},
}

------------------------------------------------------------------ per-player state (session only)
local nextSwingAt = {} -- [Player] = os.clock() when the next manual swing is allowed
local lastManualAt = {} -- [Player] = os.clock() of the last manual attack / skill request (auto combat yields)
local pendingManual = {} -- [Player] = true while one queued manual swing waits for the cooldown
local lastDamagedAt = {} -- [Player] = os.clock() of the last damage of any kind
local lastPvPAttacker = {} -- [Player] = { Player = Player, T = os.clock() }
local lastSource = {} -- BB14: [Player] = { Kind = monster kind | "Kaiju", T = os.clock() } of the last non-player hit
local lastPvPTime = {} -- [Player] = os.clock() of the last PvP damage dealt or received
local painAt = {} -- [Player] = os.clock() of the last "Pain" Fx (A15)
local lastLoopWarn = {} -- [loopName] = os.clock()
local guard = {
	releaseAt = {}, -- accepted skill time; protects direct server calls as well as the remote
	acLogAt = {}, -- CR-H2: [Player] = os.clock() of the last implausible-position log
}

------------------------------------------------------------------ small helpers
local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function numAttr(player, key, default)
	local v = player:GetAttribute(key)
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return v
end

local function byDist(a, b)
	return a.Dist < b.Dist
end

local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= LOOP_WARN_INTERVAL then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

-- faction(p) = S.FactionService.GetFaction(p)
local function faction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then
		return "None"
	end
	return f
end

-- perks = S.FactionService.GetPerks(p) (falls back to the Config table / None)
local function perksOf(player)
	local p = S.FactionService.GetPerks(player)
	if type(p) ~= "table" then
		p = Config.Factions[faction(player)] or Config.Factions.None
	end
	return p
end

-- cls(p) = S.ClassService.GetClassDef(p)
local function cls(player)
	local c = S.ClassService.GetClassDef(player)
	if type(c) ~= "table" then
		c = Config.Classes.Warrior
	end
	return c
end

-- A23-34: the basic attack's shape (Config.AttackProfile): the class row itself with a weapon, the punch when bare-handed
local function attackShape(player, c)
	return Config.AttackProfile((c or cls(player)).Id, numAttr(player, "WeaponTier", 0), faction(player))
end

-- stars(p) = S.PvPService.GetStars(p)
local function stars(player)
	local n = S.PvPService.GetStars(player)
	if type(n) ~= "number" then
		return 0
	end
	return n
end

-- kstate(p) = S.KaijuService.GetState(p)
local function kstate(player)
	local st = S.KaijuService.GetState(player)
	if type(st) ~= "string" then
		return "None"
	end
	return st
end

-- goose body center if this player's swings can count on it (Halo / Horns only), else nil
local function goosePositionFor(player)
	if not PVP_FACTIONS[faction(player)] then
		return nil
	end
	local pos = S.GooseService.GetPosition()
	if typeof(pos) ~= "Vector3" then
		return nil
	end
	return pos
end

-- bare = an A23-34 punch: no weapon to aim from, the right hand for every class
local function weaponPosition(character, classId, fallback, bare)
	local weapon = not bare and character:FindFirstChild("WeaponModel")
	local muzzle = weapon and weapon:GetAttribute("Class") == classId
		and weapon:FindFirstChild("AttackMuzzle", true)
	if muzzle and muzzle:IsA("Attachment") and muzzle.Parent and muzzle.Parent:IsA("BasePart") then
		return muzzle.WorldPosition
	end
	local left = classId == "Archer" and not bare
	local hand = left and Util.FindPart(character, "LeftHand", "Left Arm")
		or (not left and Util.FindPart(character, "RightHand", "Right Arm"))
	if hand then
		return hand.Position
	end
	return fallback
end

-- a point `reach` studs in front of the root on the ground plane (visual target of a whiffed ranged swing)
local function forwardPoint(root, reach)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end
	return root.Position + flat * reach
end

-- CR-H2: true when this Swing / Release must be ignored. The zone level gate (the attacker stands in a zone whose
-- MinLevel is above their Level: a teleport hop into a gated zone) is always enforced. ZoneService.IsPlausible logs
-- an implausible position itself ("suspicious move (check, ...)", shared LogCooldown with its zone loop) and returns
-- false ONLY while Config.AntiCheat.Enforce is true, so in log-only mode nothing is blocked or logged here. The
-- Swing / Release line below (at most once per AntiCheat.LogCooldown s) appears only when enforcing; `enforce` is
-- re-checked so blocking stays gated on Config even if ZoneService ever returns false without it.
local function attackBlocked(player, root, what)
	local pos = root.Position
	local zone = Config.ZoneAt(pos)
	if (zone.MinLevel or 1) > numAttr(player, "Level", 1) then
		return true
	end
	local zs = S.ZoneService
	if not (zs and type(zs.IsPlausible) == "function") then
		return false
	end
	local ok, plausible = pcall(zs.IsPlausible, player, pos)
	if not ok then
		loopWarn("IsPlausible", plausible)
		return false
	end
	if plausible ~= false then
		return false
	end
	local ac = Config.AntiCheat or {}
	local enforce = ac.Enforce == true
	local now = os.clock()
	if now - (guard.acLogAt[player] or -math.huge) >= (ac.LogCooldown or 10) then
		guard.acLogAt[player] = now
		Util.Warn(
			TAG,
			string.format(
				"CR-H2%s implausible %s position: %s (%d) at %s",
				enforce and "" or " (log only)",
				tostring(what),
				player.Name,
				player.UserId,
				tostring(pos)
			)
		)
	end
	return enforce
end

-- CR-L49: a Swing / Release Fx for the attacker and the players near `center` only (`extent` = the attack's reach
-- around the center); everyone else would cull it on the client anyway
local function fxNear(attacker, kind, center, extent, data)
	local reach = TUNE.FX_CULL + TUNE.FX_SEND_PAD + math.max(0, tonumber(extent) or 0)
	for _, rp in Players:GetPlayers() do
		local send = rp == attacker
		if not send then
			local r = Util.GetRoot(rp)
			send = r ~= nil and (r.Position - center).Magnitude <= reach
		end
		if send then
			Net.Fx(rp, kind, data)
		end
	end
end

------------------------------------------------------------------ removed gauge: legacy attributes stay zero
local function resetLegacyCharge(player)
	if player.Parent == nil then
		return
	end
	player:SetAttribute("Charge", 0)
	player:SetAttribute("ChargeCap", 0)
	player:SetAttribute("PerfectUntil", 0)
end

------------------------------------------------------------------ target selection
-- alive monsters this player may hit within `radius` (flat) of `point`, nearest first: { { Rec, Pos, Dist } }
-- (addendum C2: always passes the attacking player; personal monsters of other players are filtered here too)
-- CR-H2: zone monsters of a zone whose MinLevel is above the attacker's Level are never targets (personal: always)
local function monstersNear(player, point, radius)
	local out = {}
	if radius <= 0 then
		return out
	end
	local list = S.MonsterService.GetMonstersInRadius(point, radius, player)
	if type(list) ~= "table" then
		return out
	end
	local level = numAttr(player, "Level", 1)
	for _, rec in list do
		local zone = type(rec) == "table" and rec.Owner == nil and Config.Zones[rec.ZoneId] or nil
		local gated = zone ~= nil and (zone.MinLevel or 1) > level
		if type(rec) == "table" and rec.Alive and (rec.Owner == nil or rec.Owner == player) and not gated then
			local root = rec.Root
			if root and root.Parent then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius then
					table.insert(out, { Rec = rec, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- ranged classes aim forward: keep only entries within `cone` degrees of the root's flat facing (nil = no limit).
-- The client turns the character toward its target when the button is pressed, so this rarely drops a target.
local function inAim(root, pos, cone)
	if type(cone) ~= "number" or cone >= 180 then return true end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	local dir = (pos - root.Position) * Vector3.new(1, 0, 1)
	if dir.Magnitude < 1 or look.Magnitude < 0.01 then return true end -- on top of me: always fine
	return look.Unit:Dot(dir.Unit) >= math.cos(math.rad(cone))
end

local function aimed(list, root, cone)
	if type(cone) ~= "number" then return list end
	local out = {}
	for _, e in list do
		if inAim(root, e.Pos, cone) then table.insert(out, e) end
	end
	return out
end

-- other players `attacker` may damage (S.PvPService.CanAttack) within `radius` (flat) of `point`, nearest first:
-- { { Player, Pos, Dist } }. Neutral / None never attack and are never attacked (addendum A6).
local function playersNear(attacker, point, radius)
	local out = {}
	if radius <= 0 or not PVP_FACTIONS[faction(attacker)] then
		return out
	end
	for _, v in S.PlayerService.GetReadyPlayers() do
		if v ~= attacker and v.Parent and PVP_FACTIONS[faction(v)] and Util.IsAlive(v) then
			local root = Util.GetRoot(v)
			if root then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius and S.PvPService.CanAttack(attacker, v) == true then
					table.insert(out, { Player = v, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- other alive Halo players within the party-aura radius of the attacker
local function countAuraAllies(attacker, radius)
	if type(radius) ~= "number" or radius <= 0 then
		return 0
	end
	local root = Util.GetRoot(attacker)
	if not root then
		return 0
	end
	local n = 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if p ~= attacker and p.Parent and faction(p) == "Halo" and Util.IsAlive(p) then
			local r = Util.GetRoot(p)
			if r and Util.FlatDistance(r.Position, root.Position) <= radius then
				n += 1
			end
		end
	end
	return n
end

------------------------------------------------------------------ damage formulas (public)
-- additive bonus sum
function CombatService.GetDamageBonus(attacker, victim)
	local perks = perksOf(attacker)
	local bonus = perks.DamageBonus or 0
	bonus += stars(attacker) * Config.PvP.StarDamageBonus
	if faction(attacker) == "Halo" and (perks.PartyAuraPerAlly or 0) > 0 then
		local allies = math.min(perks.PartyAuraMaxAllies or 0, countAuraAllies(attacker, perks.PartyAuraRadius))
		bonus += perks.PartyAuraPerAlly * allies
	end
	if victim ~= nil and S.PvPService.HasRevenge(attacker, victim) == true then
		bonus += Config.Revenge.Bonus
	end
	return bonus
end

-- multiplicative factor: Size Justice S x bully factor (JusticeService) x ranged-vs-player factor
-- shape = the basic attack's Config.AttackProfile (A23-34: a punch is never ranged); nil = the class (skill Q)
function CombatService.GetDamageMult(attacker, victim, shape)
	local c = shape or cls(attacker)
	local mult = S.JusticeService.GetDamageMult(attacker)
	if type(mult) ~= "number" or mult ~= mult then
		mult = 1
	end
	if victim ~= nil and c.Ranged then
		mult *= (c.PvPMult or 1)
	end
	return mult
end

-- NORMAL per-target monster hit (unrounded), before the 50% immediate rule. shape = the swing's Config.AttackProfile
-- (A23-34: a punch has class multiplier 1); nil = the class row (skill Q keeps the class multiplier, bare-handed too)
function CombatService.ComputeMonsterHit(attacker, allowCrit, shape)
	local c = shape or cls(attacker)
	local level = numAttr(attacker, "Level", 1)
	local tier = numAttr(attacker, "WeaponTier", 0)
	local dmg = Config.WeaponDamage(tier, level, numAttr(attacker, "WeaponEnhance", 0))
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, nil))
		* CombatService.GetDamageMult(attacker, nil, shape)
	local crit = allowCrit == true and Util.Random:NextNumber() < Config.Combat.CritChance
	if crit then
		dmg *= Config.Combat.CritMult
	end
	return dmg, crit
end

-- NORMAL per-target PvP hit (unrounded): based on the victim's BASE MaxHealth (no Size Justice, no kaiju).
-- shape: as ComputeMonsterHit (A23-34: a punch has class multiplier 1 and no ranged factor)
function CombatService.ComputePvPHit(attacker, victim, shape)
	local c = shape or cls(attacker)
	local aLevel = numAttr(attacker, "Level", 1)
	local aTier = numAttr(attacker, "WeaponTier", 0)
	local vLevel = numAttr(victim, "Level", 1)
	local vTier = numAttr(victim, "WeaponTier", 0)
	local vClass = S.ClassService.GetClass(victim)
	local base = Config.MaxHealth(vLevel, faction(victim), vClass) * Config.PvP.HitPctOfMaxHP
	-- A23-12: enhancement and the legendary tier only move this ratio; the PvP clamp below still caps it
	local vWeapon = Config.WeaponDamage(vTier, vLevel, numAttr(victim, "WeaponEnhance", 0))
	local ratio = Config.PvP.PowerRatioMax
	if vWeapon > 0 then
		ratio = Config.WeaponDamage(aTier, aLevel, numAttr(attacker, "WeaponEnhance", 0)) / vWeapon
	end
	-- A23-34 (검수 2026-10-06): a bare-handed attacker never gets the weapon floor PowerRatioMin, so a punch (and a
	-- bare-handed skill) stays weaker than any tier-1 weapon against every opponent (Config.Combat.Unarmed.PvPRatioMin)
	local floor = Config.Weapons[aTier] and Config.PvP.PowerRatioMin or Config.Combat.Unarmed.PvPRatioMin
	ratio = math.clamp(ratio, floor, Config.PvP.PowerRatioMax)
	return base
		* ratio
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, victim))
		* CombatService.GetDamageMult(attacker, victim, shape)
end

------------------------------------------------------------------ heal / damage (public)
function CombatService.HealPlayer(player, amount)
	if not isPlayer(player) then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return 0 -- never revive
	end
	local missing = hum.MaxHealth - hum.Health
	if missing <= 0 then
		return 0
	end
	local heal = math.min(Util.RoundDamage(amount), missing)
	hum.Health = hum.Health + heal
	return heal
end

local function tagCombat(player)
	lastPvPTime[player] = os.clock()
	if player.Parent then
		player:SetAttribute("InCombatUntil", Util.Now() + Config.PvP.CombatTagTime)
	end
end

-- A15: "Pain" Fx to every client (pain sticker / flinch over the victim), throttled per victim. A lethal hit is left to
-- the KO effects.
local function sendPain(victim, hum, rootPos, applied, crit)
	if applied <= 0 or hum.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - (painAt[victim] or -math.huge) < REACT.PAIN_GAP then
		return
	end
	painAt[victim] = now
	local big = crit == true or (hum.MaxHealth > 0 and applied >= hum.MaxHealth * REACT.BIG_FRACTION)
	Net.Fx(nil, "Pain", { UserId = victim.UserId, Pos = rootPos, Big = big })
end

-- attacker nil = monster (or any non-player source); crit (optional) = the hit was a critical hit (Pain "Big").
-- Returns the HP actually removed (CR-M10: no overkill, 0 when nothing was applied).
function CombatService.DamagePlayer(victim, amount, attacker, crit, sourceKind)
	if not isPlayer(victim) or victim.Parent == nil then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	if attacker ~= nil and (not isPlayer(attacker) or attacker == victim) then
		attacker = nil
	end
	-- addendum A6: Neutral (and unassigned) players never deal or receive player damage
	if attacker and (not PVP_FACTIONS[faction(attacker)] or not PVP_FACTIONS[faction(victim)]) then
		return 0
	end
	if not Util.IsAlive(victim) then
		return 0
	end
	local hum = Util.GetHumanoid(victim)
	local root = Util.GetRoot(victim)
	if not hum or not root then
		return 0
	end

	amount = Util.RoundDamage(amount)
	local now = os.clock()
	lastDamagedAt[victim] = now
	-- BB14: who knocked me out when no player did (MonsterService passes the monster kind, KaijuService "Kaiju")
	if attacker == nil and type(sourceKind) == "string" then lastSource[victim] = { Kind = sourceKind, T = now } end
	if attacker then
		-- bookkeeping BEFORE the damage so a lethal hit is always credited by the death pipeline
		lastPvPAttacker[victim] = { Player = attacker, T = now }
		tagCombat(victim)
		tagCombat(attacker)
	end

	local rootPos = root.Position
	local before = hum.Health
	hum:TakeDamage(amount) -- respects ForceField
	local applied = math.max(0, before - hum.Health)
	-- P1 (2026-10-05): only a PLAYER hit is the victim's activity; an AFK player hit by a slime stays idle
	-- (regular luck, size scale and faction headcount use IdleSeconds)
	-- BB10 D6: kind "Hit" = not the victim's own action (the fair-points idle check reads GetLastOwnActive)
	if attacker then S.PlayerService.MarkActive(victim, "Hit") end
	local okPain, errPain = pcall(sendPain, victim, hum, rootPos, applied, crit)
	if not okPain then
		loopWarn("Pain", errPain)
	end

	-- CR-M23: the victim always sees the hit number + red edge, whoever the attacker is (PvP swings, kaiju stomps)
	if applied > 0 then
		Net.Fx(victim, "Hurt", { Pos = rootPos, Amount = applied })
	end

	if attacker then
		CombatService.PlayerDamaged:Fire(victim, applied, attacker) -- CR-M10: real damage (fired even when 0)
	end
	return applied
end

------------------------------------------------------------------ queries (public)
function CombatService.IsInCombat(player)
	local t = lastPvPTime[player]
	return t ~= nil and os.clock() - t <= Config.PvP.CombatTagTime
end

function CombatService.GetLastDamagedAt(player)
	return lastDamagedAt[player] or 0
end

function CombatService.GetLastPvPAttacker(player)
	local e = lastPvPAttacker[player]
	if not e then
		return nil
	end
	if os.clock() - e.T > Config.PvP.CombatTagTime then
		return nil
	end
	local p = e.Player
	if not p or p.Parent == nil then
		return nil
	end
	return p
end

function CombatService.GetCharge(_player)
	return 0 -- compatibility query; the gauge no longer exists
end

-- Retired Studio QA setter: may clear compatibility attributes, but cannot restore a gauge.
function CombatService.DebugSetCharge(player, amount)
	if not game:GetService("RunService"):IsStudio() or not isPlayer(player)
		or type(amount) ~= "number" or amount ~= amount or amount == math.huge or amount == -math.huge then
		return false
	end
	resetLegacyCharge(player)
	return amount == 0 -- legacy QA cannot restore removed gameplay
end

------------------------------------------------------------------ lifesteal
local function applyLifesteal(player, perks, total)
	local rate = perks.Lifesteal or 0
	if rate <= 0 or total <= 0 then
		return
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return
	end
	-- CR-M8: an Active kaiju's cap uses its health WITHOUT the kaiju multiplier (x20 MaxHealth outhealed the raid)
	local capBase = hum.MaxHealth
	if kstate(player) == "Active" and S.KaijuService and type(S.KaijuService.GetHealthMult) == "function" then
		local okK, km = pcall(S.KaijuService.GetHealthMult, player)
		if okK and type(km) == "number" and km > 1 then
			capBase = capBase / km
		end
	end
	CombatService.HealPlayer(player, math.min(total * rate, capBase * (perks.LifestealCapPct or 0)))
end

-- CR-M10: damage a monster and return the HP it actually lost (no overkill; 0 when the hit was refused).
-- killed = DamageMonster's own result
local function damageMonster(rec, dealt, player, crit)
	local hpBefore = math.max(0, tonumber(rec.HP) or 0)
	local killed = S.MonsterService.DamageMonster(rec, dealt, player, crit)
	local applied = math.max(0, hpBefore - math.max(0, tonumber(rec.HP) or 0))
	return killed, applied
end

------------------------------------------------------------------ A15 monster shove
-- a small slide of a monster my hit landed on, away from `fromPos` (cosmetic: a failure never breaks the hit loop)
local function shoveMonster(rec, fromPos, studs, player)
	if not rec.Alive or type(S.MonsterService.Shove) ~= "function" then
		return
	end
	local ok, err = pcall(S.MonsterService.Shove, rec, fromPos, studs, player)
	if not ok then
		loopWarn("Shove", err)
	end
end

-- Cosmetic shove follows the same contact frame that the Fx packet announces. style = the swing's Fx Style
-- (A23-34 "Punch"): only its contact time; the class check below still uses classId.
local function shoveLater(attack, classId, rec, fromPos, studs, player, style)
	local byClass = REACT.SHOVE_DELAY[attack]
	local motion = TUNE.MOTION[attack] and TUNE.MOTION[attack][style or classId]
	local d = motion and motion.Contact or (type(byClass) == "table" and tonumber(byClass[classId]) or 0)
	if d > 0 then
		local character = Util.GetCharacter(player)
		task.delay(math.min(d, 1), function()
			if player.Parent and Util.IsAlive(player) and Util.GetCharacter(player) == character
				and cls(player).Id == classId then shoveMonster(rec, fromPos, studs, player) end
		end)
	else
		shoveMonster(rec, fromPos, studs, player)
	end
end

------------------------------------------------------------------ auto combat (A23-1)
-- Unlocked by the optional quest "내 싸움을 배우는 왕관 조각", starts OFF, toggled and saved by the player.
-- The server loop calls the same Swing / Release paths with the auto flag: same interval, MP, cooldown, range and
-- "one cast = one hit" rules; the auto branches never select players (monsters / goose only, no PvP).
-- A23-22: a bully (BullyStacks >= 1) cannot use auto combat until every stack decayed; A23-23: neither can this week's
-- outlaw (the Outlaw attribute, RankingService). Both at once is still the one penalty.
local function bullyNoAuto(player)
	local pen = Config.Bully.Penalty
	return type(pen) == "table" and pen.NoAuto == true
		and ((tonumber(player:GetAttribute("BullyStacks")) or 0) >= 1 or player:GetAttribute("Outlaw") == true)
end

local function autoReady(player)
	return isPlayer(player) and player.Parent ~= nil and not bullyNoAuto(player)
		and player:GetAttribute("AutoCombatUnlocked") == true and player:GetAttribute("AutoCombatEnabled") == true
		and player:GetAttribute("ClassChosen") == true and kstate(player) == "None"
		and player:GetAttribute("AutoResting") ~= true -- P2: away for 15 min
		and S.PlayerService.IsReady(player) and Util.IsAlive(player)
end

-- P2 idle rest: Zzz above the head while resting (plain text label, removed on wake)
local AUTO_IDLE = { Warned = {} }
function AUTO_IDLE.SetResting(p, on)
	if (p:GetAttribute("AutoResting") == true) == on then return end
	p:SetAttribute("AutoResting", on)
	local head = p.Character and p.Character:FindFirstChild("Head")
	local old = head and head:FindFirstChild("HHC_AutoZzz")
	if old then old:Destroy() end
	if on and head then
		local bb = Instance.new("BillboardGui")
		bb.Name = "HHC_AutoZzz"
		bb.Size = UDim2.fromOffset(80, 40)
		bb.StudsOffset = Vector3.new(0, 3.2, 0)
		bb.AlwaysOnTop = false
		bb.MaxDistance = 80
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Text = "Zzz"
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.2
		label.Parent = bb
		bb.Parent = head
	end
	pcall(Net.Notify, p, Config.Text[on and "AutoRestOn" or "AutoRestOff"], "info")
end

-- true while the auto loop must wait: idle rest (with the 30 s warning first) or a pending choice card
function AUTO_IDLE.Check(p)
	local cfg = Config.Combat
	if cfg.AutoIdleRest ~= true then -- user 2026-10-05: auto keeps hunting while away
		if p:GetAttribute("AutoResting") == true then AUTO_IDLE.SetResting(p, false) end
		return false
	end
	local last = S.PlayerService.GetLastActive(p)
	if last <= 0 then
		S.PlayerService.MarkActive(p) -- nothing seen on this server yet: start counting now
		last = os.clock()
	end
	local idle = os.clock() - last
	if idle >= cfg.AutoIdleSeconds then
		AUTO_IDLE.SetResting(p, true)
		return true
	end
	if p:GetAttribute("AutoResting") == true then AUTO_IDLE.SetResting(p, false) end
	if idle >= cfg.AutoIdleSeconds - cfg.AutoIdleWarnSeconds then
		if not AUTO_IDLE.Warned[p] then
			AUTO_IDLE.Warned[p] = true
			pcall(Net.Notify, p, Config.Text.AutoSleepy, "info", cfg.AutoIdleWarnSeconds)
		end
	else
		AUTO_IDLE.Warned[p] = nil
	end
	return false
end

------------------------------------------------------------------ swing (public)
function CombatService.Swing(player, isManual)
	if isManual ~= true and not autoReady(player) then return end -- auto only while auto combat is ON
	isManual = isManual == true
	if not isPlayer(player) or player.Parent == nil or not S.PlayerService.IsReady(player)
		or player:GetAttribute("ClassChosen") ~= true or not Util.IsAlive(player) then
		return
	end
	local character = Util.GetCharacter(player)
	local root = Util.GetRoot(player)
	if not character or not root then
		return
	end
	-- CR-H2: zone level gate + movement plausibility (before the cooldown: a refused swing costs nothing)
	if attackBlocked(player, root, "Swing") then
		return
	end

	-- 1. server-owned manual swing cooldown
	local now = os.clock()
	if now < (nextSwingAt[player] or 0) then
		return
	end
	local c = cls(player)
	-- A23-34: w = this swing's shape (the class row with a weapon; the same short punch for every class bare-handed:
	-- one nearest target within 7, its own interval, no class multiplier, no Mage MP)
	local w = attackShape(player, c)
	if c.Id == "Mage" and not w.Unarmed
		and not S.VitalsService.TrySpendMana(player, Config.Vitals.MageSwingCost, not isManual) then
		return
	end
	nextSwingAt[player] = now + (w.SwingInterval or 1)

	local pos = root.Position
	local fac = faction(player)
	local perks = perksOf(player)
	local goosePos = goosePositionFor(player)
	local gooseReach = Config.Goose.HitRadius
	local range = w.Range or 10

	-- 2. select targets by class pattern
	local monsters = {} -- { { Rec, Pos, Dist } }
	local victims = {} -- { { Player, Pos, Dist } }
	local hitGoose = false
	local center = pos
	local radius = range
	local targets = {}

	if w.Pattern == "Splash" then
		radius = w.Splash or 0
		local pickPos, pickDist, pickIsGoose = nil, math.huge, false
		local nearMon = aimed(monstersNear(player, pos, range), root, w.AimCone)
		if nearMon[1] then
			pickPos, pickDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if isManual then
			local nearPl = aimed(playersNear(player, pos, range), root, w.AimCone)
			if nearPl[1] and nearPl[1].Dist < pickDist then
				pickPos, pickDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if goosePos and inAim(root, goosePos, w.AimCone) then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach and d < pickDist then
				pickPos, pickDist, pickIsGoose = goosePos, d, true
			end
		end
		if pickPos then
			center = pickPos
			monsters = monstersNear(player, center, radius)
			if isManual then
				victims = playersNear(player, center, radius)
			end
			hitGoose = goosePos ~= nil
				and (pickIsGoose or Util.FlatDistance(goosePos, center) <= radius + gooseReach)
		else
			center = forwardPoint(root, math.min(range, WHIFF_REACH)) -- whiff: the orb flies forward
		end
		targets = { center }
	elseif w.Pattern == "Multi" then
		radius = 0
		local maxTargets = w.Targets or 0
		local candidates = {}
		for _, m in aimed(monstersNear(player, pos, range), root, w.AimCone) do
			table.insert(candidates, { Kind = "M", Entry = m, Pos = m.Pos, Dist = m.Dist })
		end
		if isManual then
			for _, v in aimed(playersNear(player, pos, range), root, w.AimCone) do
				table.insert(candidates, { Kind = "P", Entry = v, Pos = v.Pos, Dist = v.Dist })
			end
		end
		if goosePos and inAim(root, goosePos, w.AimCone) then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach then
				table.insert(candidates, { Kind = "G", Pos = goosePos, Dist = d })
			end
		end
		table.sort(candidates, byDist)
		for i, cand in candidates do
			if maxTargets > 0 and i > maxTargets then
				break
			end
			table.insert(targets, cand.Pos)
			if cand.Kind == "M" then
				table.insert(monsters, cand.Entry)
			elseif cand.Kind == "P" then
				table.insert(victims, cand.Entry)
			else
				hitGoose = true
			end
		end
		if #targets == 0 then
			targets = { forwardPoint(root, math.min(range, WHIFF_REACH)) } -- whiff: the arrow flies forward
		end
	else -- "Around" (default): everything within Range of self, in front of me (AimCone)
		monsters = aimed(monstersNear(player, pos, range), root, w.AimCone)
		if isManual then
			victims = aimed(playersNear(player, pos, range), root, w.AimCone)
		end
		hitGoose = goosePos ~= nil and Util.FlatDistance(goosePos, pos) <= range + gooseReach
			and inAim(root, goosePos, w.AimCone)
	end

	local hits = {}
	local totalDealt, monstersHit, playersHit = 0, 0, 0

	-- 3. monsters: 50% of the normal hit right away (crit rolled per target)
	if #monsters > 0 then
		local base = CombatService.ComputeMonsterHit(player, false, w)
		for _, m in monsters do
			local rec = m.Rec
			if rec.Alive then
				local crit = Util.Random:NextNumber() < Config.Combat.CritChance
				local d = base * (crit and Config.Combat.CritMult or 1)
				local dealt = Util.RoundDamage(d * ((Config.BasicSkill and Config.BasicSkill.SwingImmediate) or 0.5))
				local killed, applied = damageMonster(rec, dealt, player, crit)
				if killed or applied > 0 then -- 0 = refused by MonsterService (owner / zone rules): not a hit
					if not killed then
						shoveLater("Swing", c.Id, rec, pos, crit and REACT.SHOVE_CRIT or REACT.SHOVE_SWING, player, w.Style) -- A15
					end
					table.insert(hits, { P = m.Pos, A = dealt, C = crit, K = "M" }) -- the number shows the hit as dealt
					totalDealt += applied -- CR-M10: lifesteal counts real damage only
					monstersHit += 1
				end
			end
		end
	end

	-- 4. players (manual swings only; already validated with CanAttack)
	for _, v in victims do
		local vp = v.Player
		if vp.Parent and Util.IsAlive(vp) then
			local dealt = Util.RoundDamage(CombatService.ComputePvPHit(player, vp, w)
				* ((Config.BasicSkill and Config.BasicSkill.SwingImmediate) or 0.5))
			totalDealt += CombatService.DamagePlayer(vp, dealt, player) or 0 -- CR-M10
			table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P", V = vp.UserId }) -- CR-M23: V = victim
			playersHit += 1
		end
	end
	if playersHit > 0 then
		S.PvPService.BreakProtection(player)
	end

	-- 5. golden goose: no damage, no charge. CR-L21: the number is what RegisterHit really counted (0 = none)
	if hitGoose and goosePos then
		local okG, counted = pcall(S.GooseService.RegisterHit, player, isManual)
		if not okG then
			loopWarn("GooseHit", counted)
			counted = 0
		elseif counted == nil then
			counted = isManual and Config.Goose.ManualCount or Config.Goose.AutoCount -- GooseService without a return
		end
		if type(counted) == "number" and counted == counted and counted > 0 then
			table.insert(hits, {
				P = goosePos,
				A = math.floor(counted * 10 + 0.5) / 10,
				C = false,
				K = "G",
			})
		end
	end

	-- 7. lifesteal (Horns)
	applyLifesteal(player, perks, totalDealt)

	-- 8. activity
	local anyHit = monstersHit + playersHit > 0 or hitGoose
	if isManual or anyHit then
		if isManual then S.PlayerService.MarkActive(player) end -- auto hits never count as the player being active

		-- 9. visuals for the attacker + everyone near (manual whiffs too, with empty Hits). CR-L49: the extent covers
		-- the hand (Splash center up to Range away) and Multi targets (radius 0, up to Range away)
		-- A23-34: Style = "Punch" for a bare-handed swing (clients draw a jab from the right hand, no projectile / arc);
		-- nil = the class weapon attack. Class stays the real class id.
		local motion = TUNE.MOTION.Swing[w.Style or c.Id]
		fxNear(player, "Swing", center, math.max(radius, range), {
			UserId = player.UserId,
			Character = character,
			Class = c.Id,
			Style = w.Style,
			Faction = fac,
			From = weaponPosition(character, c.Id, pos, w.Unarmed),
			ContactDelay = motion and motion.Contact,
			LaunchDelay = motion and motion.Launch,
			FlightTime = motion and motion.Flight,
			Pos = center,
			Radius = radius,
			Targets = targets,
			Hits = hits,
			Manual = isManual, -- A15: clients kick the camera on manual hits only
		})
	end
end

------------------------------------------------------------------ release (public)
function CombatService.Release(player, isAuto)
	if isAuto == true and not autoReady(player) then return end -- auto skills only while auto combat is ON
	isAuto = isAuto == true
	if not isPlayer(player) or player.Parent == nil or not S.PlayerService.IsReady(player)
		or player:GetAttribute("ClassChosen") ~= true or not Util.IsAlive(player) then
		return
	end
	local root = Util.GetRoot(player)
	if not root then
		return
	end
	-- CR-H2: zone level gate + movement plausibility (MP is kept)
	if attackBlocked(player, root, "Release") then
		return
	end

	-- 1. MP and a server cooldown are the only skill resources; there is no gauge or PERFECT window.
	local skill = Config.BasicSkill or {}
	local now = os.clock()
	local cooldown = skill.Cooldown or 3
	if now - (guard.releaseAt[player] or -math.huge) < cooldown then return end
	if not S.VitalsService.TrySpendMana(player, skill.ManaCost or Config.Vitals.ReleaseCost, isAuto) then return end -- auto: silent
	guard.releaseAt[player] = now -- failed eligibility/MP checks do not consume the successful-use cooldown
	player:SetAttribute("SkillReadyAt", Util.Now() + cooldown)
	local c = cls(player)
	local fac = faction(player)
	local perks = perksOf(player)
	local style = Config.IsTamer(c.Id, fac) and Config.Tamer.SkillStyle or nil -- A23-39 (look only)

	-- 3. center + radius
	local pos = root.Position
	local center = pos
	if c.ReleaseCenter == "Target" then
		local range = c.Range or 10
		local bestPos, bestDist = nil, math.huge
		local nearMon = aimed(monstersNear(player, pos, range), root, c.AimCone)
		if nearMon[1] then
			bestPos, bestDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if not isAuto then
			local nearPl = aimed(playersNear(player, pos, range), root, c.AimCone)
			if nearPl[1] and nearPl[1].Dist < bestDist then
				bestPos, bestDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if bestPos then
			center = bestPos
		end
	end
	local radius = skill.Radius or 9
	local releaseMult = (skill.DamageMultiplier or 6) * (c.ReleaseMult or 1)

	local hits = {}
	-- total = HP really removed (CR-M10: heal / lifesteal / Released.Total); shownTotal = the dealt numbers (Fx)
	local total, shownTotal, monstersHit, playersHit = 0, 0, 0, 0

	-- 4. monsters (never crit)
	local monsters = monstersNear(player, center, radius)
	if #monsters > 0 then
		local D = CombatService.ComputeMonsterHit(player, false)
		local dealt = Util.RoundDamage(D * releaseMult)
		for _, m in monsters do
			if m.Rec.Alive then
				-- marked before the damage: a kill made by this skill counts as a skill kill (S0 trial: basic-attack-only)
				m.Rec._skillBy = m.Rec._skillBy or {}
				m.Rec._skillBy[player] = true
				local killed, applied = damageMonster(m.Rec, dealt, player, nil)
				if killed or applied > 0 then -- 0 = refused by MonsterService (owner / zone rules): not a hit
					if not killed then
						-- A15: a blast pushes outward from its center; the monster at the center goes away from me
						local from = Util.FlatDistance(m.Pos, center) > 0.5 and center or pos
						shoveLater("Release", c.Id, m.Rec, from, REACT.SHOVE_RELEASE, player, style)
					end
					table.insert(hits, { P = m.Pos, A = dealt, C = false, K = "M" })
					total += applied
					shownTotal += dealt
					monstersHit += 1
				end
			end
		end
	end

	-- 5. players (manual releases only), capped at PvPCapPct of the target's current MaxHealth
	-- (CR-M7: an Active kaiju at Kaiju.ReleaseCapPct, so its x20 HP is not 3 shots of saved-up stacks)
	if not isAuto then
		for _, v in playersNear(player, center, radius) do
			local vp = v.Player
			local vHum = Util.GetHumanoid(vp)
			if vp.Parent and vHum and vHum.Health > 0 then
				local D = CombatService.ComputePvPHit(player, vp)
				local capPct = skill.PvPCapPct or 0.35
				if kstate(vp) == "Active" then
					capPct = Config.Kaiju.ReleaseCapPct or 0.08
				end
				local raw = math.min(D * releaseMult, capPct * vHum.MaxHealth)
				local dealt = Util.RoundDamage(raw)
				total += CombatService.DamagePlayer(vp, dealt, player) or 0 -- CR-M10
				table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P", V = vp.UserId }) -- CR-M23: V = victim
				shownTotal += dealt
				playersHit += 1
			end
		end
		if playersHit > 0 then
			S.PvPService.BreakProtection(player)
		end
	end

	-- 6. Halo skill support heals nearby allies (self included); no charge-sharing remains.
	-- Healing still uses actual HP removed, so a whiff heals nothing.
	local healed = {}
	local healPct = skill.HaloHealPct or 0.10
	local healCapPct = skill.HaloHealCapPct or 0.30
	if perks.ReleaseSupport == true and fac == "Halo" then
		for _, a in S.PlayerService.GetReadyPlayers() do
			if a.Parent and faction(a) == "Halo" and Util.IsAlive(a) then
				local aRoot = Util.GetRoot(a)
				local aHum = Util.GetHumanoid(a)
				if aRoot and aHum and Util.FlatDistance(aRoot.Position, center) <= radius then
					local amount = CombatService.HealPlayer(
						a,
						math.min(healPct * total, healCapPct * aHum.MaxHealth)
					)
					if a ~= player then
						if amount > 0 then
							table.insert(healed, a)
						end
					end
				end
			end
		end
	end

	-- 7. lifesteal (Horns) on the total
	applyLifesteal(player, perks, total)

	-- 8. activity
	if not isAuto then
		S.PlayerService.MarkActive(player)
	end

	-- 9. visuals (CR-L49: the attacker + players near the blast) + signal. A23-39: Style = "PetDash" for the pet tamer
	-- (the same Archer skill; the pet dashes in instead of the arrow rain), nil for every other class
	local motion = TUNE.MOTION.Release[style or c.Id]
	fxNear(player, "Release", center, radius, {
		UserId = player.UserId,
		Character = Util.GetCharacter(player),
		Class = c.Id,
		Style = style,
		Faction = fac,
		ContactDelay = motion and motion.Contact,
		LaunchDelay = motion and motion.Launch,
		Pos = center,
		Radius = radius,
		Stacks = 0, -- legacy Fx compatibility only
		Perfect = false,
		Auto = isAuto,
		Total = shownTotal, -- the big number = the sum of the hit numbers shown
		Hits = hits,
	})
	CombatService.Released:Fire(player, {
		Stacks = 0, -- legacy event compatibility; never fabricate quest charge
		Auto = isAuto,
		Perfect = false,
		Center = center,
		Radius = radius,
		Total = total,
		MonstersHit = monstersHit,
		PlayersHit = playersHit,
		Healed = healed,
	})
end

------------------------------------------------------------------ death pipeline (the only KO entry point)
local function pipelineCall(label, fn, ...)
	if type(fn) ~= "function" then
		Util.Warn(TAG, "death pipeline: missing " .. label)
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		Util.Warn(TAG, "death pipeline: " .. label .. " failed: " .. tostring(err))
	end
end

-- BB14: the cause, the gold this KO took and the sack, to the victim only (Net.Fx "KO"; Config.Death)
local function sendKO(victim, killer, ctx, carriedBefore, died)
	local D = Config.Death
	local by, name, killerFaction = "Other", "", ""
	local src = lastSource[victim]
	local recent = src ~= nil and ctx.At - src.T <= D.SourceSeconds
	local A = S.AnnounceService
	local function publicName(p)
		if A and A.PublicName then
			local ok, n = pcall(A.PublicName, p)
			if ok and type(n) == "string" then return n end
		end
		return Util.PlayerDisplayName(p)
	end
	if killer then
		by, name, killerFaction = "Player", publicName(killer), faction(killer)
	elseif recent and src.Kind == "Kaiju" then
		local K = S.KaijuService
		local okK, k = pcall(function() return K and K.GetActive and K.GetActive() end)
		by, name = "Kaiju", (okK and typeof(k) == "Instance") and publicName(k) or ""
	elseif recent and Config.MonsterTypes[src.Kind] then
		by, name = "Monster", Config.MonsterTypes[src.Kind].Name
	elseif died.Freefall or died.Pos == nil
		or died.Pos.Y < (Config.ZoneAt(died.Pos).Center.Y or 0) - D.FallBelowFloor then
		by = "Fall" -- falling, the body already gone (the void) or far below its zone's floor
	end
	local lost = math.max(0, math.floor(carriedBefore - numAttr(victim, "CarriedGold", 0)))
	Net.Fx(victim, "KO", { By = by, Name = name, Faction = killerFaction, Lost = lost, Sack = ctx.HadSack == true,
		RespawnIn = Config.Player.RespawnTime })
end

local function runDeathPipeline(victim, diedAt, died)
	if victim.Parent == nil then
		-- the victim already left: leave flows (GrudgeService / ProgressionService) handle it
		lastPvPAttacker[victim] = nil
		return
	end

	local killer = CombatService.GetLastPvPAttacker(victim)
	if killer then
		local fk, fv = faction(killer), faction(victim)
		-- "None" and "Neutral" never take part in PvP KOs (addendum A6)
		if killer == victim or killer.Parent == nil or fk == fv or not PVP_FACTIONS[fk] or not PVP_FACTIONS[fv] then
			killer = nil
		end
	end

	-- BB10: the weekly ranking's friend check may wait for Roblox (IsFriendsWith). It runs HERE, before anything below
	-- changes state, so PvPService.HandleKO never yields; then both players must still be here.
	local ranking = S.RankingService
	local okActive, activeState = pcall(kstate, victim)
	local kaijuDeath = okActive and activeState == "Active" -- HandleKaijuDeath never asks the ranking
	if killer and ranking and ranking.ResolveFriends and not kaijuDeath and game.PrivateServerId == "" then
		local okFriends, errFriends = pcall(ranking.ResolveFriends, killer, victim)
		if not okFriends then loopWarn("ResolveFriends", errFriends) end
		if victim.Parent == nil then
			lastPvPAttacker[victim] = nil
			return -- left while waiting: the leave flows handle it
		end
		if killer.Parent == nil then killer = nil end
	end

	-- BB10 D2: a thief KO'd while carrying a grudge sack is never an unfair KO (seen before step 1 closes the sack)
	local okSack, hadSack = pcall(S.GrudgeService.HasSack, victim)
	-- At = the KO's own time: the fresh-spawn, bait, revenge and self-defense checks never see the wait above
	local koCtx = { HadSack = okSack and hadSack == true, At = diedAt }

	local carriedBefore = numAttr(victim, "CarriedGold", 0) -- BB14: Lost = what steps 1-2 took

	-- 1. resolve a grudge sack first (no-op without one)
	pipelineCall("GrudgeService.OnCarrierDown", S.GrudgeService.OnCarrierDown, victim, killer)

	-- 2. kaiju / PvP KO / non-PvP death
	local okState, state = pcall(kstate, victim)
	if okState and state == "Active" then
		pipelineCall("KaijuService.HandleKaijuDeath", S.KaijuService.HandleKaijuDeath, victim, killer)
	elseif killer then
		pipelineCall("PvPService.HandleKO", S.PvPService.HandleKO, victim, killer, koCtx)
	else
		pipelineCall("PvPService.HandleNonPvPDeath", S.PvPService.HandleNonPvPDeath, victim)
	end

	-- BB14: the KO screen's facts (owner only)
	pipelineCall("CombatService.sendKO", sendKO, victim, killer, koCtx, carriedBefore, died or {})

	-- 3. clear legacy attributes and forget the attacker
	resetLegacyCharge(victim)
	lastPvPAttacker[victim] = nil
	lastSource[victim] = nil
end

local function onCharacterDied(player, _character)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	local diedAt = os.clock() -- BB10: the KO's time, before the friend check may wait (and the victim respawn)
	-- BB14: where the body was when it fell (Pos nil = already gone, the void) and whether it was in free fall
	local root = Util.GetRoot(player)
	local hum = Util.GetHumanoid(player)
	local okState, hstate = pcall(function() return hum and hum:GetState() end)
	local died = { Pos = root and root.Position or nil, Freefall = okState and hstate == Enum.HumanoidStateType.Freefall }
	-- deferred so the lethal hit's PlayerDamaged handlers (kaiju damage share, bait log) always run first,
	-- whatever the Workspace.SignalBehavior is
	task.defer(function()
		local ok, err = pcall(runDeathPipeline, player, diedAt, died)
		if not ok then
			Util.Warn(TAG, "death pipeline error: " .. tostring(err))
		end
	end)
end

------------------------------------------------------------------ player lifecycle handlers
local function onPlayerReady(player, _data)
	if not isPlayer(player) or player.Parent == nil then
		return
	end
	nextSwingAt[player] = 0
	guard.releaseAt[player] = nil
	player:SetAttribute("SkillReadyAt", 0)
	player:SetAttribute("AutoAttack", false)
	player:SetAttribute("InCombatUntil", 0)
	resetLegacyCharge(player)
	-- A23-22: becoming a bully switches auto combat OFF (with the reason); the end of the penalty is announced.
	-- A23-23: an outlaw week does the same (reason OutlawAutoOff); its end is announced by RankingService (OutlawEnd)
	local wasBully = bullyNoAuto(player)
	local function penaltyChanged(fromOutlaw)
		local now = bullyNoAuto(player)
		if now and not wasBully and player:GetAttribute("AutoCombatEnabled") == true and S.PlayerService.IsReady(player) then
			S.PlayerService.SetStat(player, "AutoCombatEnabled", false)
			local outlawOnly = (tonumber(player:GetAttribute("BullyStacks")) or 0) < 1
			Net.Notify(player, outlawOnly and Config.Ranking.Text.OutlawAutoOff or Config.Text.BullyAutoOff, "bad")
		elseif wasBully and not now and not fromOutlaw and (tonumber(player:GetAttribute("BullyStacks")) or 0) <= 0 then
			local unlocked = player:GetAttribute("AutoCombatUnlocked") == true
			Net.Notify(player, unlocked and Config.Text.BullyPenaltyEnd or Config.Text.BullyPenaltyEndNoAuto, "good")
		end
		wasBully = now
	end
	player:GetAttributeChangedSignal("BullyStacks"):Connect(function() penaltyChanged(false) end)
	player:GetAttributeChangedSignal("Outlaw"):Connect(function() penaltyChanged(true) end)
	if wasBully and player:GetAttribute("AutoCombatEnabled") == true then
		S.PlayerService.SetStat(player, "AutoCombatEnabled", false) -- rejoined with saved stacks
	end
end

local function onCharacterSpawned(player, _character, _humanoid, cosmetic)
	if not isPlayer(player) or player.Parent == nil then return end
	resetLegacyCharge(player)
	player:SetAttribute("AutoAttack", false)
	if not cosmetic then
		-- Match VitalsService's real-respawn MP reset; changing appearance cannot bypass a skill cooldown.
		guard.releaseAt[player] = nil
		player:SetAttribute("SkillReadyAt", 0)
	end
end

local function onPlayerLeaving(player, _data)
	-- deferred: other PlayerLeaving handlers (ProgressionService combat-log penalty) still read IsInCombat
	task.defer(function()
		nextSwingAt[player] = nil
		lastManualAt[player] = nil
		pendingManual[player] = nil
		lastDamagedAt[player] = nil
		lastPvPAttacker[player] = nil
		lastSource[player] = nil
		lastPvPTime[player] = nil
		painAt[player] = nil
		guard.releaseAt[player] = nil
		guard.acLogAt[player] = nil -- CR-H2
	end)
end

local function onFactionChanged(player, _newFaction, _oldFaction, _reason)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	resetLegacyCharge(player)
end

local function onClassChanged(player, _newClass, _oldClass)
	if not isPlayer(player) then
		return
	end
	pendingManual[player] = nil
	resetLegacyCharge(player)
end

------------------------------------------------------------------ remotes
-- one queued manual swing that fires as soon as the shared cooldown is ready (addendum H3)
local function queueManualSwing(player)
	local request = { Character = Util.GetCharacter(player), Class = cls(player).Id, Faction = faction(player) }
	pendingManual[player] = request
	local tries = 0
	local function attempt()
		if pendingManual[player] ~= request then
			return
		end
		if player.Parent == nil or not S.PlayerService.IsReady(player) or player:GetAttribute("ClassChosen") ~= true
			or not Util.IsAlive(player)
			or Util.GetCharacter(player) ~= request.Character or cls(player).Id ~= request.Class
			or faction(player) ~= request.Faction then
			pendingManual[player] = nil
			return
		end
		local remaining = (nextSwingAt[player] or 0) - os.clock()
		if remaining > 0 and tries < MANUAL_QUEUE_RETRIES then
			tries += 1
			task.delay(remaining, attempt)
			return
		end
		pendingManual[player] = nil
		CombatService.Swing(player, true)
	end
	task.delay(math.max(0, (nextSwingAt[player] or 0) - os.clock()), attempt)
end

local function onSwingRemote(player)
	if not S.PlayerService.IsReady(player) or player:GetAttribute("ClassChosen") ~= true then
		return
	end
	if not Util.RateLimit(player, "Swing", Config.RateLimits.Swing) then
		return
	end
	S.PlayerService.MarkActive(player)
	lastManualAt[player] = os.clock()
	if pendingManual[player] then
		return -- a manual swing is already queued
	end
	local remaining = (nextSwingAt[player] or 0) - os.clock()
	if remaining <= 0 then
		CombatService.Swing(player, true)
	elseif remaining <= MANUAL_GRACE then
		-- queue a single jitter-early press; holding a button never starts a server attack loop
		queueManualSwing(player)
	end
	-- otherwise an early repeat of a manual swing: silently ignored
end

local function onReleaseRemote(player)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if not Util.RateLimit(player, "Release", Config.RateLimits.Release) then
		return
	end
	lastManualAt[player] = os.clock()
	CombatService.Release(player, false) -- MarkActive inside
end

-- A23-1: ON/OFF only after the unlock; the choice is saved (AutoCombatEnabled)
local function onSetAutoAttackRemote(player, enabled, ...)
	if select("#", ...) ~= 0 or not S.PlayerService.IsReady(player) then
		return
	end
	if type(enabled) ~= "boolean" then
		return
	end
	if not Util.RateLimit(player, "SetAutoAttack", Config.RateLimits.SetAutoAttack) then
		return
	end
	if player:GetAttribute("AutoCombatUnlocked") ~= true or player:GetAttribute("ClassChosen") ~= true
		or not Util.IsAlive(player) then
		return
	end
	if enabled and bullyNoAuto(player) then
		local outlawOnly = (tonumber(player:GetAttribute("BullyStacks")) or 0) < 1
		Net.Notify(player, outlawOnly and Config.Ranking.Text.OutlawNoAuto or Config.Text.BullyNoAuto, "bad")
		return
	end
	S.PlayerService.SetStat(player, "AutoCombatEnabled", enabled)
end

-- the crown-shard quest calls this once; it never turns auto combat ON by itself
function CombatService.UnlockAutoCombat(player)
	if not isPlayer(player) or not S.PlayerService.IsReady(player) then return false end
	S.PlayerService.SetStat(player, "AutoCombatUnlocked", true)
	return true
end

-- one auto step: a swing when its interval is up and a monster is in reach; the skill when MP / cooldown allow
-- and the blast would hit at least one monster (no whiffs, no MP wasted)
local function autoTick(p)
	-- P2: a resting player wakes the moment they act; the rest flag never outlives auto combat being ON
	if p:GetAttribute("AutoResting") == true and p:GetAttribute("AutoCombatEnabled") == true
		and S.PlayerService.IsReady(p) then
		AUTO_IDLE.Check(p)
		return
	end
	if p:GetAttribute("AutoResting") == true and p:GetAttribute("AutoCombatEnabled") ~= true then
		AUTO_IDLE.SetResting(p, false)
	end
	if not autoReady(p) then return end
	if AUTO_IDLE.Check(p) then return end
	local root = Util.GetRoot(p)
	if not root then return end
	local c = cls(p)
	local w = attackShape(p, c) -- A23-34: the swing's reach / interval (a bare-handed punch: 7 studs, 0.8 s)
	-- my own presses win: auto waits one swing interval + ManualYieldPad after a manual attack / skill
	local lm = lastManualAt[p]
	if lm and os.clock() - lm < (w.SwingInterval or 1) + (Config.Combat.ManualYieldPad or 0.3) then return end
	local pos = root.Position
	local range = c.Range or 10 -- the class range: the skill Q reach below (Q is the class skill, bare-handed too)
	if os.clock() >= (nextSwingAt[p] or 0) and #aimed(monstersNear(p, pos, w.Range or 10), root, w.AimCone) > 0 then
		CombatService.Swing(p, false)
	end
	local skill = Config.BasicSkill or {}
	if os.clock() - (guard.releaseAt[p] or -math.huge) < (skill.Cooldown or 3) then return end
	if numAttr(p, "Mana", 0) < (skill.ManaCost or Config.Vitals.ReleaseCost) then return end
	local reach = (c.ReleaseCenter == "Target") and range or (skill.Radius or 9)
	local inReach = monstersNear(p, pos, reach)
	if c.ReleaseCenter == "Target" then inReach = aimed(inReach, root, c.AimCone) end
	if #inReach > 0 then
		CombatService.Release(p, true)
	end
end

------------------------------------------------------------------ loops
local function regenTick(p)
	local hum = Util.GetHumanoid(p)
	if not hum or hum.Health <= 0 or hum.Health >= hum.MaxHealth then
		return
	end
	local pct
	-- an Active kaiju never gets the town regen (it would make the event unwinnable in Crossroads)
	if S.ZoneService.IsTown(p) and kstate(p) ~= "Active" then
		pct = Config.Combat.TownRegenPerSec
	else
		pct = perksOf(p).RegenPerSec or 0
	end
	if type(pct) == "number" and pct > 0 then
		CombatService.HealPlayer(p, hum.MaxHealth * pct * Config.Combat.RegenTick)
	end
end

local function startPlayerLoop(loopName, interval, body)
	task.spawn(function()
		while true do
			task.wait(interval)
			local ok, players = pcall(S.PlayerService.GetReadyPlayers)
			if ok and type(players) == "table" then
				for _, p in players do
					if p.Parent then
						local okBody, err = pcall(body, p)
						if not okBody then
							loopWarn(loopName, err)
						end
					end
				end
			elseif not ok then
				loopWarn(loopName, players)
			end
		end
	end)
end

------------------------------------------------------------------ lifecycle
local function connectSignal(serviceName, signalName, fn)
	local service = S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function CombatService.Init(registry)
	S = registry
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
	connectSignal("PlayerService", "CharacterDied", onCharacterDied)
	connectSignal("PlayerService", "CharacterSpawned", onCharacterSpawned)
	connectSignal("FactionService", "FactionChanged", onFactionChanged)
	connectSignal("ClassService", "ClassChanged", onClassChanged)
end

function CombatService.Start()
	Net.Get("Swing").OnServerEvent:Connect(onSwingRemote)
	Net.Get("Release").OnServerEvent:Connect(onReleaseRemote)
	Net.Get("SetAutoAttack").OnServerEvent:Connect(onSetAutoAttackRemote)

	startPlayerLoop("RegenLoop", Config.Combat.RegenTick, regenTick)
	startPlayerLoop("AutoCombatLoop", Config.Combat.AutoTick or 0.2, autoTick)

	print("[CombatService] started")
end

return CombatService
]]></ProtectedString>
				<string name="ScriptGuid">{BC5CD3FC-6D92-413F-AA3E-316409DB7CD3}</string>
