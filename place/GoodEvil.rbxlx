				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">MonsterService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300021525</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX544A0713272A485E956A701FC88024F7">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PlayerService.luau : join/leave lifecycle, attribute mirroring, leaderstats, spawn/respawn, MaxHealth/WalkSpeed,
-- playtime, Regular's Luck minutes, the no-player-collision group (addendum A7-5), slope limit (A11-R2), camera zoom
-- limits (A12), anti-collusion pair cooldowns (CR-M4) and BindToClose. Fall rescue (A10) is owned by ZoneService.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local TAG = "PlayerService"

local PlayerService = {}

-- public signals (top level so they exist before any Init)
PlayerService.PlayerReady = Util.Signal.new() -- (player, data)
PlayerService.PlayerLeaving = Util.Signal.new() -- (player, data) fired once, BEFORE the final save
PlayerService.CharacterSpawned = Util.Signal.new() -- (player, character, humanoid, cosmetic: boolean?)
PlayerService.CharacterDied = Util.Signal.new() -- (player, character)

local S = nil

local ready = {} -- [Player] = true
local joining = {} -- [Player] = true while the data load runs
local finalizing = {} -- [Player] = true while FinalizeLeave runs
-- CR-M2: [Player] = true once onClose fired PlayerLeaving (ready kept); "saving" while that player's release runs
local leftFired = {}
local removed = setmetatable({}, { __mode = "k" }) -- [Player] = true once PlayerRemoving fired
local conns = {} -- [Player] = { RBXScriptConnection }
local lastActive = {} -- [Player] = os.clock() of the last input/combat
local lastOwn = {} -- [Player] = os.clock() of the last OWN action (MarkActive without kind "Hit"; BB10 D6)
local mirrored = {} -- [key] = true for every key of Config.Data.Mirrored
local characterLoading = {} -- [Player] = true while a normal spawn is being installed
local respawnQueued = {} -- [Player] = one additional requested respawn while the current load yields
local cosmeticContext = setmetatable({}, { __mode = "k" }) -- [Model] = server-only snapshot for an appearance replacement
local nativeRestore = {} -- [Player] = pending engine-owned avatar restoration; registered before CharacterAdded
local deathBound = setmetatable({}, { __mode = "k" }) -- [Humanoid] = death listener installed once
local closing = false

local COLLISION_GROUP = Config.Player.CollisionGroup or "Players"
local collisionGroupOk = false

local CHILD_TIMEOUT = 5 -- seconds to wait for Humanoid / HumanoidRootPart / parenting
local CLOSE_TIMEOUT = 25 -- BindToClose budget
local FINALIZE_WAIT = 30 -- a second FinalizeLeave call waits this long for the first one
-- attributes any Tab list column reads (BB12 COLUMN below); a change of one refreshes the row
local LEADERSTAT_KEYS = { "CombatPower", "Level", "WeaponTier", "WeaponEnhance", "BankGold", "CarriedGold", "Rebirths",
	"Honor", "Infamy", "WeekArtisan", "Faction" }

local MAX_SLOPE_ANGLE = 46 -- A11-R2: Terrain ridges (>= 50 deg) cannot be walked over
local CAMERA_MAX_ZOOM = 40 -- A12: players never see the whole world (kaiju may raise it while transformed)
local CAMERA_MIN_ZOOM = 6
-- CR-M4: PairCD entries older than this are dropped at PlayerReady (>= every pair cooldown / window that uses them)
local PAIR = {
	MinKeep = 1800,
	MaxKeys = 200,
	-- { Config table, key } read for the keep window (a longer configured cooldown keeps its entries longer)
	KeepFrom = {
		{ "Kaiju", "PairRewardCooldown" }, { "PvP", "PairRewardCooldown" }, { "Bully", "RepeatWindow" },
		{ "Grudge", "RefundBonusCooldown" }, { "Grudge", "RestealWindow" },
	},
}
------------------------------------------------------------------ helpers
local lastLoopWarn = {}
local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= 10 then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

local function addConn(player, conn)
	local list = conns[player]
	if not list then
		list = {}
		conns[player] = list
	end
	table.insert(list, conn)
end

-- persisted value (data table first, attribute as fallback)
local function stat(player, key, default)
	local data = S.DataService.Get(player)
	local v = data and data[key]
	if v == nil then v = player:GetAttribute(key) end
	if v == nil then return default end
	return v
end

local function classDef(player)
	local cs = S.ClassService
	if cs and cs.GetClassDef then
		local ok, def = pcall(cs.GetClassDef, player)
		if ok and type(def) == "table" then return def end
	end
	return Config.Classes[stat(player, "Class", "Warrior")] or Config.Classes.Warrior
end

local function healthMult(player)
	local js = S.JusticeService
	if js and js.GetHealthMult then
		local ok, m = pcall(js.GetHealthMult, player)
		if ok and type(m) == "number" and m == m and m > 0 and m < math.huge then return m end
	end
	return 1
end

local function computeMaxHealth(player)
	local level = tonumber(stat(player, "Level", 1)) or 1
	local faction = stat(player, "Faction", "None")
	local class = stat(player, "Class", "Warrior")
	return math.max(1, math.floor(Config.MaxHealth(level, faction, class) * healthMult(player)))
end

-- health/speed formula on a given humanoid (used on spawn and by RefreshCharacter)
local function applyStats(player, humanoid, fullHeal)
	local maxHP = computeMaxHealth(player)
	if humanoid.Health <= 0 then
		humanoid.MaxHealth = maxHP -- never revive
		return
	end
	local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
	humanoid.MaxHealth = maxHP
	if fullHeal then
		humanoid.Health = maxHP
	else
		humanoid.Health = math.clamp(ratio * maxHP, 1, maxHP)
	end
	humanoid.WalkSpeed = PlayerService.ComputeWalkSpeed(player)
end

-- A23-68 #1: while the first mission runs (accepted, not yet claimed: Tutorial.Steps.Guide / Quest) a respawn starts
-- at the meadow entrance; otherwise at the faction's home
local function respawnZoneId(player)
	local tut = Config.Tutorial or {}
	local steps = tut.Steps or {}
	local step = stat(player, "TutorialStep", 0)
	if tut.RespawnInMeadow == true and type(tut.GuideZone) == "string" and Config.Zones[tut.GuideZone]
		and (step == steps.Guide or step == steps.Quest) then
		return tut.GuideZone
	end
	return Config.HomeZoneId(stat(player, "Faction", "None"))
end

local function spawnCFrame(zoneId)
	local zs = S.ZoneService
	if zs and zs.GetSpawnCFrame then
		local ok, cf = pcall(zs.GetSpawnCFrame, zoneId)
		if ok and typeof(cf) == "CFrame" then return cf end
		if not ok then Util.Warn(TAG, "GetSpawnCFrame failed: " .. tostring(cf)) end
	end
	local z = Config.Zones[zoneId] or Config.Zones.Crossroads
	return CFrame.new(z.Spawn + Vector3.new(0, 4, 0))
end

-- CR-H2: tell ZoneService's movement check that the server is about to move this player (no false "teleport" log)
local function markTeleported(player, seconds)
	local zs = S.ZoneService
	if zs and zs.MarkTeleported then
		local ok, err = pcall(zs.MarkTeleported, player, seconds)
		if not ok then loopWarn("MarkTeleported", err) end
	end
end

local function loadCharacter(player)
	if player.Parent == nil or not ready[player] then return end
	if characterLoading[player] then
		respawnQueued[player] = true
		return
	end
	characterLoading[player] = true
	-- CR-H2: the new character appears at a spawn point first; onCharacterAdded marks again before placing it
	markTeleported(player, (Config.AntiCheat and Config.AntiCheat.SpawnGrace) or 2)
	local ok, err = pcall(function()
		player:LoadCharacter() -- A23-5: always the player's own Roblox avatar (no costume rig)
	end)
	characterLoading[player] = nil
	if not ok then
		Util.Warn(TAG, "LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
	if respawnQueued[player] then
		respawnQueued[player] = nil
		if ready[player] and player.Parent then task.defer(loadCharacter, player) end
	end
end

-- A12: on join and on every CharacterAdded (max first, so min never exceeds max)
local function applyCameraLimits(player)
	local ok, err = pcall(function()
		player.CameraMaxZoomDistance = CAMERA_MAX_ZOOM
		player.CameraMinZoomDistance = CAMERA_MIN_ZOOM
	end)
	if not ok then
		loopWarn("camera limits", err)
	end
end

------------------------------------------------------------------ pair cooldowns (CR-M4)
local function pairKeepSeconds()
	local keep = PAIR.MinKeep
	for _, ref in PAIR.KeepFrom do
		local t = Config[ref[1]]
		local v = type(t) == "table" and tonumber(t[ref[2]]) or nil
		if v and v == v and v > keep and v < math.huge then keep = v end
	end
	local b = Config.Bully
	if type(b) == "table" then -- PvPService's bully bounty window (DecaySeconds * MaxStacks)
		local v = (tonumber(b.DecaySeconds) or 0) * (tonumber(b.MaxStacks) or 0)
		if v == v and v > keep and v < math.huge then keep = v end
	end
	return keep
end

-- os.time() of an entry: a number, or the newest of a { t1, t2 } list ("kolog:<victimUserId>")
local function pairStamp(v)
	if type(v) == "table" then
		local newest = nil
		for _, item in v do
			local t = tonumber(item)
			if t and t == t and (newest == nil or t > newest) then newest = t end
		end
		return newest
	end
	local t = tonumber(v)
	if t and t == t then return t end
	return nil
end

-- drops entries older than the keep window (or far in the future: bad clock), then the oldest above MaxKeys
local function prunePairCD(data)
	if type(data) ~= "table" then return end
	if type(data.PairCD) ~= "table" then
		data.PairCD = {}
		return
	end
	local cd = data.PairCD
	local now = os.time()
	local keep = pairKeepSeconds()
	local list = {}
	for k, v in cd do
		local t = pairStamp(v)
		if type(k) ~= "string" or t == nil or now - t > keep or t - now > keep then
			cd[k] = nil
		else
			table.insert(list, { K = k, T = t })
		end
	end
	if #list > PAIR.MaxKeys then
		table.sort(list, function(a, b) return a.T < b.T end)
		for i = 1, #list - PAIR.MaxKeys do
			cd[list[i].K] = nil
		end
	end
end

------------------------------------------------------------------ collision group (A7-5)
local function setupCollisionGroup()
	local ok, err = pcall(function()
		if not PhysicsService:IsCollisionGroupRegistered(COLLISION_GROUP) then
			PhysicsService:RegisterCollisionGroup(COLLISION_GROUP)
		end
		PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, COLLISION_GROUP, false)
	end)
	collisionGroupOk = ok
	if not ok then
		Util.Warn(TAG, "collision group setup failed: " .. tostring(err))
	end
end

local function setPartGroup(inst)
	if inst:IsA("BasePart") then
		inst.CollisionGroup = COLLISION_GROUP
	end
end

local function assignCollisionGroup(character)
	if not collisionGroupOk then return end
	for _, d in character:GetDescendants() do
		setPartGroup(d)
	end
	-- the connection dies with the character
	character.DescendantAdded:Connect(setPartGroup)
end

------------------------------------------------------------------ leaderstats
local function toInt(v)
	v = tonumber(v) or 0
	if v ~= v or v == math.huge or v == -math.huge then return 0 end
	return math.floor(v)
end

-- BB12: the value of one Tab list column (Config.Leaderstats.Columns ids), read from the mirrored attributes
local COLUMN = {
	-- BB4 power (JusticeService sets CombatPower on PlayerReady; before that the same formula from the attributes)
	Power = function(p)
		local v = p:GetAttribute("CombatPower")
		if v == nil then
			v = Config.CombatPower(math.max(1, toInt(p:GetAttribute("Level"))),
				math.clamp(toInt(p:GetAttribute("WeaponTier")), 0, Config.MaxWeaponTier), toInt(p:GetAttribute("WeaponEnhance")))
		end
		return toInt(v)
	end,
	Level = function(p) return toInt(p:GetAttribute("Level")) end,
	Rebirths = function(p) return toInt(p:GetAttribute("Rebirths")) end,
	-- Halo: Honor, Horns: Infamy, Neutral: this week's 장인 명성 (A23-24, RankingService's WeekArtisan), None: 0
	Fame = function(p)
		local f = p:GetAttribute("Faction")
		local key = (f == "Halo" and "Honor") or (f == "Horns" and "Infamy") or (f == "Neutral" and "WeekArtisan") or nil
		return key and toInt(p:GetAttribute(key)) or 0
	end,
	-- bank + carried (A23-21: not listed, it picked plunder targets; kept so a one-line Config change brings it back)
	Gold = function(p) return toInt(p:GetAttribute("BankGold")) + toInt(p:GetAttribute("CarriedGold")) end,
}

local function buildLeaderstats(player)
	local old = player:FindFirstChild("leaderstats")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	-- creation order = column order in the player list (Roblox sorts the list by the first column)
	local L = Config.Leaderstats
	local columns = {}
	for _, id in L.Columns do
		if COLUMN[id] and not columns[id] then
			local v = Instance.new("IntValue")
			v.Name = L.Names[id] or id
			v.Parent = folder
			columns[id] = v
		else
			Util.Warn(TAG, "leaderstats: unknown or repeated column " .. tostring(id))
		end
	end

	local function update()
		for id, v in columns do
			v.Value = COLUMN[id](player)
		end
	end
	update()
	folder.Parent = player

	for _, key in LEADERSTAT_KEYS do
		addConn(player, player:GetAttributeChangedSignal(key):Connect(update))
	end
end

------------------------------------------------------------------ character lifecycle
-- Humanoid.HipHeight uses different standing-height formulas for R15 and R6.
local function standingHeight(character, humanoid, root)
	if not character or not humanoid or not root or not root:IsA("BasePart") then return nil end
	local height = humanoid.HipHeight + root.Size.Y * 0.5
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		if not leg or not leg:IsA("BasePart") then return nil end
		height += leg.Size.Y
	end
	return height == height and height > 0 and height < math.huge and height or nil
end

local function cosmeticPivot(character, humanoid, root, context)
	local pivot = context.OriginalPivot or context.Pivot
	local height = standingHeight(character, humanoid, root)
	if height and context.StandingHeight then
		-- World Y only: preserve the feet's height, XZ, facing and airborne offset.
		pivot += Vector3.new(0, height - context.StandingHeight, 0)
	end
	context.Pivot = pivot -- recompute from OriginalPivot after spawn handlers scale the new rig
	return pivot
end

local function bindCharacterDeath(player, character, humanoid)
	if deathBound[humanoid] then return end
	deathBound[humanoid] = true
	local handled = false
	local function died()
		if handled or not ready[player] or player.Parent == nil or player.Character ~= character then return end
		handled = true
		PlayerService.CharacterDied:Fire(player, character)
		task.delay(Config.Player.RespawnTime, function()
			if player.Parent and player.Character == character and ready[player] then loadCharacter(player) end
		end)
	end
	humanoid.Died:Once(died)
	if humanoid.Health <= 0 then died() end -- CharacterAdded may arrive after an engine-load death.
end

local function onCharacterAdded(player, character)
	local context = cosmeticContext[character]
	cosmeticContext[character] = nil
	local native = nativeRestore[player]
	if not context and native and character ~= native.ExpectedOld and player.Character == character then
		context = native
	end
	if context and context.Native then context.Character = character end
	local humanoid = character:WaitForChild("Humanoid", CHILD_TIMEOUT)
	if not humanoid or not humanoid:IsA("Humanoid") then return end
	bindCharacterDeath(player, character, humanoid)
	-- A deferred engine callback must never turn an expired cosmetic request into a fresh spawn.
	if character:GetAttribute("HHC_RestoreCancelled") then return end
	if context and context.Native then
		if nativeRestore[player] == context then nativeRestore[player] = nil end
		context.Character = character
		character:SetAttribute("HHC_OriginalRestore", true)
		-- The engine installs the owner's native controllers/appearance after CharacterAdded.
		-- Do not place or scale its unfinished avatar and do not replace its Animate/joint setup.
		local started = os.clock()
		while not context.NativeReady and player.Character == character and ready[player]
			and os.clock() - started < 30 do task.wait() end
		if not context.NativeReady or context.Cancelled or context.Failed then
			context.Failed = true
			return
		end
	end
	assignCollisionGroup(character)

	local root = character:WaitForChild("HumanoidRootPart", CHILD_TIMEOUT)
	if not humanoid or not root or not humanoid:IsA("Humanoid") then
		if player.Character == character then
			Util.Warn(TAG, "character of " .. player.Name .. " has no Humanoid/HumanoidRootPart; skipped")
		end
		return
	end
	humanoid.MaxSlopeAngle = MAX_SLOPE_ANGLE -- A11-R2 (Swimming stays enabled for players, A10)
	if player.Character ~= character or not ready[player] then return end
	applyCameraLimits(player)

	-- CharacterAdded can fire before the model is parented: wait until it is in the world before placing it
	local t0 = os.clock()
	while character.Parent == nil and os.clock() - t0 < CHILD_TIMEOUT do
		task.wait()
	end
	if player.Character ~= character or character.Parent == nil or not ready[player] then return end
	if context and (context.Cancelled or context.Failed or humanoid.Health <= 0) then
		context.Failed = true
		return
	end

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	applyStats(player, humanoid, true)
	if context then humanoid.Health = math.min(context.Health, humanoid.MaxHealth) end
	if not context then markTeleported(player, (Config.AntiCheat and Config.AntiCheat.SpawnGrace) or 2) end -- CR-H2
	character:PivotTo(context and cosmeticPivot(character, humanoid, root, context) or spawnCFrame(respawnZoneId(player)))

	PlayerService.CharacterSpawned:Fire(player, character, humanoid, context ~= nil)
	if context and player.Character == character and character.Parent and humanoid.Health > 0 then
		-- JusticeService may scale the new rig; recalculate its standing height without accumulating an offset.
		character:PivotTo(cosmeticPivot(character, humanoid, root, context))
		root.AssemblyLinearVelocity = context.LinearVelocity
		root.AssemblyAngularVelocity = context.AngularVelocity
	end
	if context and context.MovementTrack and S.ZoneService and S.ZoneService.RestoreMovementTrack then
		-- Spawn handlers (including JusticeService scale/lift) are synchronous and may mark a teleport.
		-- Restore after all of them: a cosmetic switch neither resets the position sample nor renews grace.
		S.ZoneService.RestoreMovementTrack(player, context.MovementTrack, character)
	end
	if context then context.Completed = true end
end

------------------------------------------------------------------ join
local function onJoin(player)
	if ready[player] or joining[player] or finalizing[player] then return end
	applyCameraLimits(player) -- A12: before the first character
	joining[player] = true
	local ok, data = pcall(S.DataService.Load, player)
	if not ok then
		Util.Warn(TAG, "load error for " .. player.Name .. ": " .. tostring(data))
		data = nil
	end

	-- left (or the server started closing) while the load was finishing: hand the data straight back.
	-- CR-L2: joining stays set until the release finished, so onClose waits for this save too
	if data ~= nil and (player.Parent == nil or removed[player] or closing) then
		local okRel, errRel = pcall(S.DataService.Release, player)
		if not okRel then Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(errRel)) end
		joining[player] = nil
		return
	end
	joining[player] = nil
	if player.Parent == nil then return end
	if data == nil then
		player:Kick(string.format(Config.Text.LoadFailed))
		return
	end

	local okPrune, errPrune = pcall(prunePairCD, data) -- CR-M4
	if not okPrune then Util.Warn(TAG, "PairCD prune failed for " .. player.Name .. ": " .. tostring(errPrune)) end

	for _, key in Config.Data.Mirrored do
		local v = data[key]
		if v ~= nil and type(v) ~= "table" then
			player:SetAttribute(key, v)
		end
	end
	-- A saved nickname is untrusted until the global reservation and current text filter are verified.
	player:SetAttribute("Nickname", "")
	player:SetAttribute("NicknameVerified", false)
	player:SetAttribute("NicknameStatus", "Loading")
	buildLeaderstats(player)

	-- connected before PlayerReady so a Respawn() from a PlayerReady handler is never missed
	addConn(player, player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end))

	ready[player] = true
	-- (A23-18 "베타 개척자" is granted by TitleService on PlayerReady: BB16 data.Titles)
	player:SetAttribute("DataLoaded", true)
	PlayerService.PlayerReady:Fire(player, data)

	if ready[player] then
		loadCharacter(player)
	end
end

------------------------------------------------------------------ shutdown
local function onClose()
	closing = true
	local targets = {}
	for _, p in Players:GetPlayers() do
		targets[p] = true
	end
	for p in ready do
		targets[p] = true
	end

	-- CR-M2: fire PlayerLeaving for every ready player BEFORE any of them is released, keeping ready set, so
	-- cross-player handlers (e.g. a thief's sack refund to a victim) still land in the other player's data.
	-- FinalizeLeave then only runs the final save (leftFired branch).
	local pre = {}
	for p in ready do
		table.insert(pre, p)
	end
	for _, p in pre do
		if ready[p] and not finalizing[p] and not leftFired[p] then
			finalizing[p] = true -- a concurrent FinalizeLeave (PlayerRemoving) waits while the handlers run
			local okFire, errFire = pcall(function()
				PlayerService.PlayerLeaving:Fire(p, S.DataService.Get(p))
			end)
			if not okFire then Util.Warn(TAG, "PlayerLeaving on close failed: " .. tostring(errFire)) end
			leftFired[p] = true
		end
	end

	local pending = 0
	for p in targets do
		pending += 1
		task.spawn(function()
			local ok, err = pcall(PlayerService.FinalizeLeave, p)
			if not ok then Util.Warn(TAG, "FinalizeLeave on close failed: " .. tostring(err)) end
			pending -= 1
		end)
	end

	local t0 = os.clock()
	local function mailPending() -- P3: grudge letters still being written (GrudgeService)
		local g = S.GrudgeService
		local ok, n = pcall(function() return g and g.MailPending and g.MailPending() or 0 end)
		return ok and tonumber(n) or 0
	end
	local function rankingPending() -- BB10: the last ranking rows of the leavers (after the saves, same timeout)
		local r = S.RankingService
		local ok, n = pcall(function() return r and r.PendingWrites and r.PendingWrites() or 0 end)
		return ok and tonumber(n) or 0
	end
	while (pending > 0 or next(finalizing) ~= nil or next(joining) ~= nil or mailPending() > 0 or rankingPending() > 0)
		and os.clock() - t0 < CLOSE_TIMEOUT do
		task.wait(0.1)
	end
end

------------------------------------------------------------------ public API
function PlayerService.Init(registry)
	S = registry
	Players.CharacterAutoLoads = false
	for _, key in Config.Data.Mirrored do
		mirrored[key] = true
	end
	setupCollisionGroup()
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onJoin, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		removed[player] = true
		PlayerService.FinalizeLeave(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end

	game:BindToClose(onClose)

	-- playtime
	task.spawn(function()
		local step = Config.Player.PlaytimeTick
		while true do
			task.wait(step)
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(PlayerService.AddStat, p, "PlaytimeSeconds", step)
				if not ok then loopWarn("playtime loop", err) end
			end
		end
	end)

	-- A23-18 오늘의 운: every goose / kaiju event a player took part in raises today's rare chance
	local function luckSignal(service, signal, fn)
		local svc = S[service]
		local sig = svc and svc[signal]
		if type(sig) == "table" and type(sig.Connect) == "function" then sig:Connect(fn) end
	end
	luckSignal("GooseService", "GooseFinished", function(_result, counts)
		if type(counts) ~= "table" then return end
		for p, n in counts do
			if typeof(p) == "Instance" and p:IsA("Player") and tonumber(n) and n > 0 then
				pcall(PlayerService.AddLuckEvent, p)
			end
		end
	end)
	luckSignal("KaijuService", "KaijuEnded", function(kaiju, outcome, participants)
		local seen = {}
		for _, p in (type(participants) == "table" and participants or {}) do
			if typeof(p) == "Instance" and p:IsA("Player") and not seen[p] then
				seen[p] = true
				pcall(PlayerService.AddLuckEvent, p)
			end
		end
		-- a kaiju cancelled before it started is not an event (review of c08c382)
		if outcome ~= "Cancelled" and typeof(kaiju) == "Instance" and kaiju:IsA("Player") and not seen[kaiju] then
			pcall(PlayerService.AddLuckEvent, kaiju)
		end
	end)
	-- P2: walking counts as activity (MarkActive) even without remote calls, so idle = no input AND no movement
	task.spawn(function()
		-- review of 5c977d6: only a living player's own walking counts (horizontal), never a respawn, ragdoll or a
		-- server teleport/correction: the baseline is re-taken when the root changes, the player is dead, or a
		-- MarkTeleported grace is running
		local lastPos = {} -- [Player] = { Root = BasePart, Pos = Vector3 }
		while true do
			task.wait(1)
			local studs = Config.Combat.AutoIdleMoveStuds or 1.5
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(function()
					local root = Util.GetRoot(p)
					local prev = lastPos[p]
					local zs = S.ZoneService
					local teleported = zs and type(zs.IsTeleportGrace) == "function" and zs.IsTeleportGrace(p) == true
					if not root or not Util.IsAlive(p) then
						lastPos[p] = nil
						return
					end
					if prev and prev.Root == root and not teleported and Util.FlatDistance(root.Position, prev.Pos) > studs then
						PlayerService.MarkActive(p)
					end
					lastPos[p] = { Root = root, Pos = root.Position }
				end)
				if not ok then loopWarn("walk activity", err) end
			end
			for p in lastPos do
				if p.Parent == nil then lastPos[p] = nil end
			end
		end
	end)
	-- a new KST day shows 0 at once: on join and once a minute (the roll itself always re-checks the day)
	PlayerService.PlayerReady:Connect(function(p) pcall(PlayerService.GetLuckEvents, p) end)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in PlayerService.GetReadyPlayers() do pcall(PlayerService.GetLuckEvents, p) end
		end
	end)

	print("[PlayerService] started")
end

function PlayerService.IsReady(player)
	return player ~= nil and ready[player] == true
end

function PlayerService.GetReadyPlayers()
	local out = {}
	for _, p in Players:GetPlayers() do
		if ready[p] then
			table.insert(out, p)
		end
	end
	return out
end

function PlayerService.GetData(player)
	return S.DataService.Get(player)
end

function PlayerService.SetStat(player, key, value)
	local data = S.DataService.Get(player)
	if not data then return end
	data[key] = value
	if mirrored[key] then
		player:SetAttribute(key, value)
	end
end

function PlayerService.AddStat(player, key, delta)
	local data = S.DataService.Get(player)
	if not data then return 0 end
	local newValue = (tonumber(data[key]) or 0) + (tonumber(delta) or 0)
	PlayerService.SetStat(player, key, newValue)
	return newValue
end

-- BB10: the ONE way Honor / Infamy go up for PvP. AddStat (the stat itself never depends on the ranking) and then the
-- weekly board credit: ctx = { PvP = true, Fair = verdict.Fair, Victim = victim } (PvPService.HandleKO /
-- payLeaveBounty) or { RankPoints = n } (a paid grudge sack: only its RankInfamy). Anything else (one-time story /
-- goose points, D1) adds the stat only. Returns the new stat value.
function PlayerService.GrantFame(player, stat, n, ctx)
	if stat ~= "Honor" and stat ~= "Infamy" then return 0 end
	local value = PlayerService.AddStat(player, stat, n)
	local ranking = S.RankingService
	if type(ranking) == "table" and type(ranking.CreditFame) == "function" then
		local ok, err = pcall(ranking.CreditFame, player, stat, n, ctx)
		if not ok then loopWarn("GrantFame", err) end
	end
	return value
end

function PlayerService.Respawn(player)
	if not ready[player] or player.Parent == nil then return end
	task.spawn(loadCharacter, player)
end

function PlayerService.IsSpawning(player)
	return characterLoading[player] == true
end

-- Server-owned character installation. Appearance swaps do not fire CharacterDied or grant a new spawn shield.
local function installCharacter(player, character, context, expectedOld)
	if not ready[player] or player.Parent ~= Players or player.Character ~= expectedOld then return false end
	if typeof(character) ~= "Instance" or not character:IsA("Model") or character.Parent ~= nil then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then return false end
	local ok, err = pcall(function()
		character.Name = player.Name
		character.PrimaryPart = root
		if context then
			context.OriginalPivot = context.Pivot
			for _, child in character:GetChildren() do
				if child:IsA("ForceField") then child:Destroy() end
			end
			character:PivotTo(cosmeticPivot(character, humanoid, root, context))
			cosmeticContext[character] = context
		end
		character.Parent = workspace
		-- The context is registered before CharacterAdded fires, for both immediate and deferred signal modes.
		player.Character = character
	end)
	if not ok then
		cosmeticContext[character] = nil
		pcall(character.Destroy, character)
		Util.Warn(TAG, "character installation failed: " .. tostring(err))
		return false
	end
	if expectedOld and expectedOld ~= character then
		-- Move existing shields rather than cloning them: their original expiration callbacks still apply.
		if context then
			for _, child in expectedOld:GetChildren() do
				if child:IsA("ForceField") then child.Parent = character end
			end
		end
		pcall(expectedOld.Destroy, expectedOld)
	end
	pcall(root.SetNetworkOwner, root, player)
	return true
end

function PlayerService.SpawnCharacter(player, character)
	return installCharacter(player, character, nil, player.Character)
end

function PlayerService.ReplaceCharacter(player, character, expectedOld)
	local old = player.Character
	if old ~= expectedOld or characterLoading[player] or not Util.IsAlive(player) then return false end
	local humanoid = Util.GetHumanoid(player)
	local root = Util.GetRoot(player)
	local context = {
		Health = humanoid.Health,
		Pivot = old:GetPivot(),
		StandingHeight = standingHeight(old, humanoid, root),
		LinearVelocity = root.AssemblyLinearVelocity,
		AngularVelocity = root.AssemblyAngularVelocity,
	}
	if S.ZoneService and S.ZoneService.CaptureMovementTrack then
		context.MovementTrack = S.ZoneService.CaptureMovementTrack(player)
	end
	return installCharacter(player, character, context, old)
end

-- OFF uses the player's engine spawn path. Manually assigning a detached native avatar can leave
-- current R15 AnimationConstraint/controller physics uninitialized on the owning client.
function PlayerService.RestoreOwnerCharacter(player, description, expectedOld, stillWanted)
	if not ready[player] or player.Parent ~= Players or player.Character ~= expectedOld
		or characterLoading[player] or not Util.IsAlive(player) then return false end
	if typeof(description) ~= "Instance" or not description:IsA("HumanoidDescription") then return false end
	local copiedOk, copied = pcall(description.Clone, description)
	if not copiedOk or not copied then return false end
	local old = player.Character
	local humanoid, root = Util.GetHumanoid(player), Util.GetRoot(player)
	if not humanoid or not root or (stillWanted and not stillWanted()) then copied:Destroy(); return false end
	local context = {
		ExpectedOld = old, Health = humanoid.Health, OriginalPivot = old:GetPivot(), Pivot = old:GetPivot(),
		StandingHeight = standingHeight(old, humanoid, root),
		LinearVelocity = root.AssemblyLinearVelocity, AngularVelocity = root.AssemblyAngularVelocity,
		Native = true, NativeReady = false, Completed = false,
	}
	if S.ZoneService and S.ZoneService.CaptureMovementTrack then
		context.MovementTrack = S.ZoneService.CaptureMovementTrack(player)
	end
	local holder = Instance.new("Folder")
	holder.Name = "CosmeticRestoreShields"
	holder.Parent = ServerStorage
	local shields = {}
	for _, child in old:GetChildren() do
		if child:IsA("ForceField") then shields[child] = true; child.Parent = holder end
	end
	local added = player.CharacterAdded:Connect(function(character)
		if character == old then return end
		-- Delete only the engine's newly granted spawn shield. Original shield instances keep their deadlines.
		for _, child in character:GetChildren() do
			if child:IsA("ForceField") and not shields[child] then child:Destroy() end
		end
		character.DescendantAdded:Connect(function(child)
			if not context.NativeReady and child:IsA("ForceField") and not shields[child] then child:Destroy() end
		end)
	end)
	characterLoading[player] = true
	nativeRestore[player] = context
	local ok, err = pcall(player.LoadCharacterWithHumanoidDescriptionAsync, player, copied)
	copied:Destroy()
	added:Disconnect()
	if not ok then context.Failed = true end
	context.NativeReady = true
	local current = player.Character
	-- In deferred signal mode the engine call may finish before CharacterAdded runs. Register
	-- that exact model before clearing the player slot so the cosmetic snapshot cannot be lost.
	if current and current ~= old and not context.Character then cosmeticContext[current] = context end
	if nativeRestore[player] == context then nativeRestore[player] = nil end
	if current and current.Parent and ready[player] then
		for _, child in current:GetChildren() do
			if child:IsA("ForceField") and not shields[child] then child:Destroy() end
		end
		for _, child in holder:GetChildren() do child.Parent = current end
	end
	holder:Destroy()
	local started = os.clock()
	while ok and not context.Completed and not context.Failed and player.Character == current
		and player.Parent == Players and ready[player] and os.clock() - started < CHILD_TIMEOUT do task.wait() end
	local restored = ok and context.Completed and not context.Failed and player.Character == current
		and current ~= old and Util.IsAlive(player)
	if not restored then
		context.Cancelled, context.Failed = true, true
		if current and current ~= old then
			if cosmeticContext[current] == context then cosmeticContext[current] = nil end
			current:SetAttribute("HHC_RestoreCancelled", true)
		end
	end
	characterLoading[player] = nil
	if respawnQueued[player] then
		respawnQueued[player] = nil
		if ready[player] and player.Parent then task.defer(loadCharacter, player) end
	end
	if not ok then Util.Warn(TAG, "owner avatar restore failed: " .. tostring(err)) end
	return restored
end

-- recompute MaxHealth + WalkSpeed of the current character (keeps the HP ratio unless fullHeal)
function PlayerService.RefreshCharacter(player, fullHeal)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid then return end
	applyStats(player, humanoid, fullHeal == true)
end

-- PET-1: the ONE walk speed (Config.WalkSpeed) from the class (classDef), the equipped pet (EquippedPet / PetLv attributes,
-- PetService) and the kaiju state (KaijuService.GetState "Active" = no pet bonus). applyStats and RefreshSpeed are the
-- only writers of a player's WalkSpeed (KaijuService / ClassService / JusticeService refresh through RefreshCharacter).
function PlayerService.ComputeWalkSpeed(player)
	local kaiju = false
	local ks = S.KaijuService
	if type(ks) == "table" and type(ks.GetState) == "function" then
		local ok, st = pcall(ks.GetState, player)
		kaiju = ok and st == "Active"
	end
	return Config.WalkSpeed(classDef(player).Id, player:GetAttribute("EquippedPet"), player:GetAttribute("PetLv"), kaiju)
end

-- PET-1: WalkSpeed only (a pet equipped or levelled up); a dead or missing character is left alone
function PlayerService.RefreshSpeed(player)
	local humanoid = Util.GetHumanoid(player)
	if humanoid and humanoid.Health > 0 then humanoid.WalkSpeed = PlayerService.ComputeWalkSpeed(player) end
end

-- idempotent: PlayerLeaving + final save once; always clears per-player state
function PlayerService.FinalizeLeave(player)
	if leftFired[player] == true then
		-- CR-M2: onClose already fired PlayerLeaving (ready was kept for cross-player refunds): only the save is left
		leftFired[player] = "saving" -- a concurrent call takes the finalizing branch below and waits
		ready[player] = nil
		local ok, err = pcall(S.DataService.Release, player)
		if not ok then
			Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(err))
		end
		finalizing[player] = nil
	elseif finalizing[player] then
		local t0 = os.clock()
		while finalizing[player] and os.clock() - t0 < FINALIZE_WAIT do
			task.wait(0.1)
		end
		return
	elseif ready[player] then
		finalizing[player] = true
		PlayerService.PlayerLeaving:Fire(player, S.DataService.Get(player))
		ready[player] = nil -- loops and remotes stop touching the player while the final save runs
		local ok, err = pcall(S.DataService.Release, player)
		if not ok then
			Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(err))
		end
		finalizing[player] = nil
	end

	ready[player] = nil
	leftFired[player] = nil
	Util.ClearPlayer(player)
	lastActive[player] = nil
	lastOwn[player] = nil
	characterLoading[player] = nil
	respawnQueued[player] = nil
	nativeRestore[player] = nil
	local list = conns[player]
	conns[player] = nil
	if list then
		for _, c in list do
			c:Disconnect()
		end
	end
end

-- kind = "Hit" for a hit taken from another player (P1: it keeps the idle timers awake) — that is not the player's
-- own action, so it never moves GetLastOwnActive (BB10 D6: the "victim was idle" check of the fair-points rule)
function PlayerService.MarkActive(player, kind)
	if ready[player] then
		lastActive[player] = os.clock()
		if kind ~= "Hit" then lastOwn[player] = os.clock() end
	end
end

-- CR-M20: os.clock() of the player's last input/combat (MarkActive); 0 = none yet on this server
function PlayerService.GetLastActive(player)
	return (player ~= nil and lastActive[player]) or 0
end

-- BB10 D6: os.clock() of the player's last OWN action (input, walking, manual attacks; not hits taken, not auto combat);
-- 0 = none yet on this server
function PlayerService.GetLastOwnActive(player)
	return (player ~= nil and lastOwn[player]) or 0
end

-- CR-M2: true once BindToClose started (the server is shutting down; leaves are not the players' choice)
function PlayerService.IsShuttingDown()
	return closing
end

-- CR-M4: anti-collusion pair cooldown kept in the HOLDER's save (key "<kind>:<otherUserId>" = os.time()), so it
-- follows the player across servers. true = the last commit is at least `cooldown` s old (or there is none);
-- commit ~= false records now on true. false when the holder has no loaded data (no reward).
function PlayerService.PairReady(holder, otherUserId, kind, cooldown, commit)
	if holder == nil or otherUserId == nil or type(kind) ~= "string" then return false end
	local d = S.DataService.Get(holder)
	if type(d) ~= "table" then return false end
	if type(d.PairCD) ~= "table" then d.PairCD = {} end
	local cd = d.PairCD
	local k = kind .. ":" .. tostring(otherUserId)
	local now = os.time()
	local last = tonumber(cd[k]) or 0
	if last ~= last then last = 0 end
	local need = tonumber(cooldown) or 0
	if need ~= need then need = 0 end
	if now - last < need then return false end
	if commit ~= false then
		local isNew = cd[k] == nil
		cd[k] = now
		if isNew then
			-- bound growth within a long session too (PlayerReady prunes the rest)
			local n = 0
			for _ in cd do
				n += 1
			end
			if n > PAIR.MaxKeys then
				local okPrune, errPrune = pcall(prunePairCD, d)
				if not okPrune then loopWarn("PairCD prune", errPrune) end
			end
		end
	end
	return true
end

-- A23-18: today's event count (0 on a new KST day); the saved day keeps it across servers
local function luckToday(player)
	local data = PlayerService.GetData(player)
	if type(data) ~= "table" then return nil, 0 end
	local today = Config.DayIndex(os.time())
	if tonumber(data.LuckDay) ~= today then
		data.LuckDay, data.LuckEvents = today, 0
		player:SetAttribute("LuckEvents", 0)
	end
	local n = tonumber(data.LuckEvents) or 0
	if n ~= n or n < 0 then n = 0 end
	return data, math.floor(n)
end

function PlayerService.GetLuckEvents(player)
	local _, n = luckToday(player)
	return n
end

function PlayerService.AddLuckEvent(player)
	local data, n = luckToday(player)
	if not data then return 0 end
	n = math.min(n + 1, 99)
	PlayerService.SetStat(player, "LuckEvents", n)
	return n
end

return PlayerService
]]></ProtectedString>
				<string name="ScriptGuid">{BFBDC658-28CC-47B2-9504-BF997CDDDD93}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PlayerService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300021527</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXDABA3100DFCE49E8ADAD31FF3A885028">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PvPService.luau : PvP rules (CanAttack, rookie / spawn protection), bully detection, KO outcomes
-- (plunder -> grudge sack, honor, bounty), Wanted stars + bounty, revenge marks and the Most Wanted board.
-- Server only. See TECH_SPEC §4.13 and SPEC_ADDENDUM A6 / A10-V3-3.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "PvPService"

-- (the A3-M3 "under attack while auto-attack is ON" hint is sent by CombatService.DamagePlayer only)
local LOOP_INTERVAL = 1
local PRUNE_INTERVAL = 60 -- seconds between prunes of the bait damage log
local LOOP_WARN_INTERVAL = 10
-- ⑤ (quality_ideas §1, 검수): the spawn shield shows no bubble; the protected body wears this outline instead
local PROTECT_GLOW = "ProtectGlow"

-- review-fix tuning knobs (grouped to keep the chunk's local count low)
local GUARD = {
	DmgLogMax = 64, -- CR-M15: hits kept per attacker/victim pair (oldest dropped first)
	RecentHitSeconds = 3, -- CR-L4: a non-PvP death without damage this recent (reset / fall) keeps the stars
	KoLogKeep = math.max(1, Config.Bully.RepeatKOs - 1), -- CR-M4: KO times kept per killer/victim pair ({ t1, t2 })
	-- BB10 D2: a pair with no hit for this long starts a new fight (whose first hit decides self-defense)
	EngageGap = 2 * Config.Ranking.DefenseWindowSeconds,
}

-- Most Wanted board lines (TECH_SPEC §4.13 board text)
local BOARD_ROWS = 3 -- BB11: top 3 of each weekly board + the wanted line (texts: Config.Ranking.Text.Board)

local PvPService = {}

PvPService.PlayerKO = Util.Signal.new() -- (killer, victim, info)

local S = nil

-- per-player state (Player keys; cleaned on PlayerLeaving)
local stars = {} -- [Player] = number
local lastStarChange = {} -- [Player] = os.clock()
local protectedUntil = {} -- [Player] = os.clock() (0 = not protected)
local graceUntil = {} -- [Player] = os.clock() end of the A23-18 graduation grace
local wasRookie = {} -- [Player] = last rookie state seen by tickPlayer (graduation edge)
local spawnedAt = {} -- [Player] = os.clock() of the last CharacterSpawned
-- CR-M15: [attacker][victim] = { { T = os.clock(), A = damage }, ... } within Config.Bully.BaitWindow (bait check)
local dmgLog = {}
-- BB10 D2: ["<lo>:<hi>" UserIds] = { By = the player who struck first, T = os.clock() of that hit, Last = of the latest
-- hit either way, A / B = the two players } (a new fight starts after GUARD.EngageGap without a hit)
local engage = {}
local revenge = {} -- [Player] = { Target = Player, Until = os.clock() }

-- CR-M4: pair state (minted KO reward, repeat-KO log, claimed bully bounty) lives in the saved PairCD of the player
-- it belongs to, so a server hop or rejoin cannot reset it (pairReady / logKO below; pruned by PlayerService)

-- anti-farm: the minted bully part of a bounty is paid at most once per victim (any killer) per this window,
-- the time a max-stack bully needs to decay back to clean. Stored in the victim's PairCD as "bully:0".
local BULLY_BOUNTY_COOLDOWN = Config.Bully.DecaySeconds * Config.Bully.MaxStacks

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

-- BB37: every server-wide line names players through AnnounceService.PublicName (hidden -> "<faction> 한 명")
local function publicName(p, honorific)
	local A = S.AnnounceService
	if A and A.PublicName then
		local ok, name = pcall(A.PublicName, p, honorific)
		if ok and type(name) == "string" then return name end
	end
	return Util.PlayerDisplayName(p) .. (honorific and Config.Announce.Text.Honorific or "")
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind, sound)
	if isPlaying(p) then
		Net.Notify(p, text, kind, nil, sound)
	end
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function faction(p)
	return S.FactionService.GetFaction(p)
end

-- only Halo and Horns ever take part in PvP ("Neutral" and "None" never do; addendum A6)
local function isFighter(f)
	return f == "Halo" or f == "Horns"
end

local function kstate(p)
	local kaiju = S.KaijuService
	if kaiju and kaiju.GetState then
		return kaiju.GetState(p) or "None"
	end
	return "None"
end

-- persisted stat: live data table first, mirrored attribute as fallback
local function num(p, key, default)
	local data = S.PlayerService.GetData(p)
	local v = data and data[key]
	if v == nil then
		v = p:GetAttribute(key)
	end
	return tonumber(v) or default
end

local function bullyStacksOf(p)
	return tonumber(S.JusticeService.GetBullyStacks(p)) or 0
end

local function classOf(p)
	local C = S.ClassService
	return (C and C.GetClass and C.GetClass(p)) or "Warrior"
end

-- CR-M4: pair cooldown kept in the holder's saved PairCD ("<kind>:<otherUserId>" = os.time()). PlayerService.PairReady
-- owns it; the inline copy follows the same contract. commit = false only checks. No data -> false (no reward).
local function pairReady(holder, otherUserId, kind, cooldown, commit)
	if not holder then
		return false
	end
	local PS = S.PlayerService
	if PS.PairReady then
		local ok, res = pcall(PS.PairReady, holder, otherUserId, kind, cooldown, commit)
		return ok and res == true
	end
	local d = PS.GetData(holder)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = kind .. ":" .. tostring(otherUserId)
	local t = os.time()
	if t - (tonumber(d.PairCD[k]) or 0) < cooldown then
		return false
	end
	if commit ~= false then
		d.PairCD[k] = t
	end
	return true
end

-- CR-M4: the killer's recent KO times on this victim live in the killer's PairCD as "kolog:<victimUserId>" =
-- { t1, t2 } (os.time, oldest first). Records this KO; true when it is the RepeatKOs-th within RepeatWindow.
local function logKO(killer, victim)
	local B = Config.Bully
	local d = S.PlayerService.GetData(killer)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = "kolog:" .. tostring(victim.UserId)
	local t = os.time()
	local times = {}
	local old = d.PairCD[k]
	if type(old) == "table" then
		for _, v in old do
			local x = tonumber(v)
			if x and t - x <= B.RepeatWindow then
				table.insert(times, x)
			end
		end
		table.sort(times)
	end
	table.insert(times, t)
	local repeated = #times >= B.RepeatKOs
	while #times > GUARD.KoLogKeep do
		table.remove(times, 1)
	end
	d.PairCD[k] = times
	return repeated
end

-- bully stacks that still carry a bounty: 0 while this bully's bounty was already claimed (BULLY_BOUNTY_COOLDOWN,
-- the victim's PairCD "bully:0"). The stacks themselves (size / damage penalty, "깡패" tag) stay with JusticeService.
-- A23-23 D3: this week's outlaw counts as (at least) one bully stack for the bounty (Config.Bounty: units >= 1 and
-- x BountyMult once, so bully + outlaw is still at most x2), with the same claim cooldown.
local function bountyBullyStacks(p)
	local n = bullyStacksOf(p)
	if p:GetAttribute("Outlaw") == true then n = math.max(n, 1) end
	if n <= 0 or not pairReady(p, 0, "bully", BULLY_BOUNTY_COOLDOWN, false) then
		return 0
	end
	return n
end

-- marks this bully's bounty as claimed (by any killer) for BULLY_BOUNTY_COOLDOWN
local function claimBullyBounty(p)
	pairReady(p, 0, "bully", 0)
end

-- CR-L5: weak-victim check power WITHOUT the rebirth bonus (that bonus is gold / XP only)
local function combatPower(p)
	local J = S.JusticeService
	if J and J.GetCombatPower then
		local ok, v = pcall(J.GetCombatPower, p)
		if ok and type(v) == "number" then
			return v
		end
	end
	local level = math.max(1, num(p, "Level", 1))
	local tier = math.clamp(math.floor(num(p, "WeaponTier", 0)), 0, Config.MaxWeaponTier) -- A23-34: 0 = bare hands
	-- review B5: the equipped scroll +N counts. Read the attribute directly: data.WeaponEnhance is the per-tier table.
	return Config.CombatPower(level, tier, tonumber(p:GetAttribute("WeaponEnhance")) or 0) -- BB4 (same as Justice)
end

-- A23-18 boldness: x2 vs a much stronger victim, x0.5 vs a much weaker one (honor / infamy / war points only)
function PvPService.BoldMult(killer, victim)
	local P = Config.PvP
	local mine, theirs = combatPower(killer), combatPower(victim)
	if type(mine) ~= "number" or type(theirs) ~= "number" or mine ~= mine or theirs ~= theirs or mine <= 0 then return 1 end
	local ratio = theirs / mine
	if ratio >= P.BoldStrongRatio then return P.BoldStrongMult end
	if ratio < P.BoldWeakRatio then return P.BoldWeakMult end
	return 1
end

-- integer points x mult with fair rounding (x0.5 of 1 point = 50% chance of 1), so weak KOs still average half
function PvPService.ScalePoints(points, mult)
	local v = (tonumber(points) or 0) * (tonumber(mult) or 1)
	local whole = math.floor(v)
	if Util.Random:NextNumber() < v - whole then whole += 1 end
	return whole
end

-- addendum A10-V3-3: inside a PvP zone, or combat-tagged (Config.PvP.CombatTagTime) anywhere outside a town
-- (Outskirts, bridges, safe hunting land), so a fight or a sack chase does not end at a zone edge
local function inPvP(p)
	return S.ZoneService.IsPvPZone(p) or (not S.ZoneService.IsTown(p) and S.CombatService.IsInCombat(p))
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

-- CR-M15: remove every hit with T < cutoff from an ascending dmgLog list
local function pruneHits(hits, cutoff)
	while hits[1] ~= nil and hits[1].T < cutoff do
		table.remove(hits, 1)
	end
end

-- CR-M15: total damage `attacker` dealt to `victim` within Config.Bully.BaitWindow
local function recentDamage(attacker, victim, now)
	local byVictim = dmgLog[attacker]
	local hits = byVictim and byVictim[victim]
	if not hits then
		return 0
	end
	local sum = 0
	for _, h in hits do
		if now - h.T <= Config.Bully.BaitWindow then
			sum += h.A
		end
	end
	return sum
end

local function engageKey(a, b)
	return tostring(math.min(a.UserId, b.UserId)) .. ":" .. tostring(math.max(a.UserId, b.UserId))
end

-- BB10 D2 self-defense (never an unfair KO): the current fight between the two began with the victim's hit and the KO
-- landed within Config.Ranking.DefenseWindowSeconds of that first hit
local function victimStruckFirst(victim, killer, now)
	local e = engage[engageKey(victim, killer)]
	return e ~= nil and now - e.Last <= GUARD.EngageGap and e.By == victim
		and now - e.T <= Config.Ranking.DefenseWindowSeconds
end

-- BB37 (검수): the bounty line; a hidden knight is "빛의 기사단 한 명" already, so the hidden line has no faction prefix
local function bountyLine(p, bounty)
	local A = S.AnnounceService
	local okHidden, hidden = false, false
	if A and A.IsHidden then okHidden, hidden = pcall(A.IsHidden, p) end
	if not okHidden then hidden = p:GetAttribute("HideAnnounceName") == true end
	return fmt(hidden == true and "BountyAnnounceHidden" or "BountyAnnounce", publicName(p, true), Util.FormatNumber(bounty))
end

-- BB10: the ranking verdict of one PvP KO ({ Fair, Unfair?, Exempt?, Reason? }; { Fair = false } without RankingService)
local function judgeKO(killer, victim, facts)
	local R = S.RankingService
	if R and R.JudgeKO then
		local ok, v = pcall(R.JudgeKO, killer, victim, facts)
		if ok and type(v) == "table" then return v end
		if not ok then Util.Warn(TAG, "JudgeKO: " .. tostring(v)) end
	end
	return { Fair = false }
end

-- BB10: Honor / Infamy from PvP go through PlayerService.GrantFame (the stat + the fair weekly board points)
local function grantFame(p, stat, n, verdict, victim)
	S.PlayerService.GrantFame(p, stat, n, { PvP = true, Fair = verdict.Fair == true, Victim = victim })
end

local function computeBounty(p)
	if not isFighter(faction(p)) then
		return 0
	end
	return Config.Bounty(num(p, "Level", 1), stars[p] or 0, bountyBullyStacks(p))
end

local function refreshStarAttrs(p)
	if not isPlaying(p) then
		return
	end
	setAttr(p, "WantedStars", stars[p] or 0)
	setAttr(p, "Bounty", computeBounty(p))
end

-- the newbie PvP shield is meaningless for Neutral (never in PvP at all; addendum A6)
local function rookieAttr(p)
	return faction(p) ~= "Neutral" and PvPService.IsRookie(p)
end

local function announceIfMostWanted(p, before, after)
	if before < Config.PvP.AnnounceStars and after >= Config.PvP.AnnounceStars then
		Net.NotifyAll(fmt("MostWanted", publicName(p, true), Util.FormatNumber(computeBounty(p))))
	end
end

local function addStar(killer)
	local before = stars[killer] or 0
	local after = math.min(Config.PvP.MaxStars, before + 1)
	stars[killer] = after
	lastStarChange[killer] = os.clock()
	refreshStarAttrs(killer)
	announceIfMostWanted(killer, before, after)
end

-- the shield and its outline always go together
local function destroyForceFields(p)
	local character = p.Character
	if not character then
		return
	end
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") or (child:IsA("Highlight") and child.Name == PROTECT_GLOW) then
			child:Destroy()
		end
	end
end

-- ⑤ a soft outline in the faction color (no fill, hidden behind walls) while protected. Protect adds it; the 1 s loop
-- puts it back on a rebuilt body (an appearance swap moves the ForceField, not this)
local function addProtectGlow(p)
	local character = p.Character
	local f = Config.Factions[faction(p)]
	if not character or not character.Parent or character:FindFirstChild(PROTECT_GLOW) or not (f and f.Color) then
		return
	end
	local h = Instance.new("Highlight")
	h.Name = PROTECT_GLOW
	h.FillTransparency = 1
	h.OutlineColor = f.Color
	h.OutlineTransparency = Config.PvP.ProtectGlow.OutlineTransparency
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = character
end

local function clearRevenge(p)
	revenge[p] = nil
	if isPlaying(p) then
		setAttr(p, "RevengeTargetId", 0)
		setAttr(p, "RevengeUntil", 0)
	end
end

-- clears p's own revenge mark and every other player's mark that targets p
local function clearRevengeInvolving(p)
	local holders = {}
	for holder, r in revenge do
		if holder == p or r.Target == p then
			table.insert(holders, holder)
		end
	end
	for _, holder in holders do
		clearRevenge(holder)
	end
end

------------------------------------------------------------------ public API
function PvPService.GetStars(player)
	return (player and stars[player]) or 0
end

function PvPService.ResetStars(player)
	if not player then
		return
	end
	stars[player] = 0
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
end

function PvPService.DebugSetStars(player, n)
	if not isPlaying(player) then
		return
	end
	local before = stars[player] or 0
	local after = math.clamp(math.floor(tonumber(n) or 0), 0, Config.PvP.MaxStars)
	stars[player] = after
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
	announceIfMostWanted(player, before, after)
end

-- Rebirths == 0 and (Level < RookieLevel or PlaytimeSeconds < RookiePlaytime)
function PvPService.IsRookie(player)
	if not player then
		return false
	end
	if num(player, "Rebirths", 0) ~= 0 then
		return false
	end
	return num(player, "Level", 1) < Config.PvP.RookieLevel
		or num(player, "PlaytimeSeconds", 0) < Config.PvP.RookiePlaytime
end

-- A23-18 graduation grace (review of c08c382): started on the rookie -> graduate edge for Halo / Horns only, saved as
-- an absolute time (data.GraduateGraceUntil) so a rejoin keeps the rest; checked lazily wherever PvP damage is decided
local function startGrace(p, seconds)
	if seconds <= 0 then return end
	graceUntil[p] = os.clock() + seconds
	local data = S.PlayerService.GetData(p)
	if type(data) == "table" then data.GraduateGraceUntil = os.time() + math.ceil(seconds) end
	setAttr(p, "GraduateGraceUntil", Util.Now() + seconds)
end

local function checkGraduation(p)
	if not isPlaying(p) then return end
	local isRookie = PvPService.IsRookie(p)
	local f = faction(p)
	if wasRookie[p] == true and not isRookie and (f == "Halo" or f == "Horns") and not graceUntil[p] then
		startGrace(p, Config.PvP.GraduateGraceSeconds)
		notify(p, fmt("GraduateStart"), "reward")
	end
	wasRookie[p] = isRookie
end

function PvPService.InGrace(p)
	if not p then return false end
	checkGraduation(p) -- closes the up-to-1 s gap before the next tick
	return (graceUntil[p] or 0) > os.clock()
end

-- rookie shield or graduation grace: no PvP damage either way (CanAttack, kaiju stomp)
function PvPService.IsShielded(p)
	return PvPService.IsRookie(p) or PvPService.InGrace(p)
end

function PvPService.HasRevenge(attacker, victim)
	local r = attacker and revenge[attacker]
	return r ~= nil and victim ~= nil and r.Target == victim and os.clock() < r.Until
end

function PvPService.Protect(player, seconds)
	if not isPlaying(player) then
		return
	end
	seconds = tonumber(seconds) or 0
	if seconds <= 0 then
		return
	end
	local character = player.Character
	if character and character.Parent and not character:FindFirstChildOfClass("ForceField") then
		local ff = Instance.new("ForceField")
		ff.Visible = false -- ⑤ no bubble (Humanoid:TakeDamage still respects it); the outline shows the shield
		ff.Parent = character
	end
	protectedUntil[player] = math.max(protectedUntil[player] or 0, os.clock() + seconds)
	setAttr(player, "Protected", true)
	addProtectGlow(player)
end

function PvPService.BreakProtection(player)
	if not player then
		return
	end
	-- cheap early-out: CombatService calls this after every PvP hit
	if (protectedUntil[player] or 0) == 0 and player:GetAttribute("Protected") ~= true then
		return
	end
	protectedUntil[player] = 0
	destroyForceFields(player)
	if isPlaying(player) then
		setAttr(player, "Protected", false)
	end
end

-- (allowed: boolean, reasonKey: string?)
function PvPService.CanAttack(attacker, victim)
	if attacker == nil or victim == nil or attacker == victim then
		return false, "Self"
	end
	local PS = S.PlayerService
	if not PS.IsReady(attacker) or not PS.IsReady(victim) then
		return false, "NotReady"
	end
	if not Util.IsAlive(attacker) or not Util.IsAlive(victim) then
		return false, "Dead"
	end
	local fa, fv = faction(attacker), faction(victim)
	if fa == "Neutral" or fv == "Neutral" then
		return false, "Neutral" -- addendum A6: Neutral never hits / is hit by players, anywhere
	end
	if not isFighter(fa) or not isFighter(fv) or fa == fv then
		return false, "SameFaction"
	end
	-- kaiju exception: Halo may hit the Active kaiju in any zone (rookies allowed, protection ignored)
	if fa == "Halo" and kstate(victim) == "Active" then
		return true, nil
	end
	if not inPvP(attacker) or not inPvP(victim) then
		return false, "SafeZone"
	end
	if PvPService.IsRookie(attacker) or PvPService.IsRookie(victim) then
		return false, "Rookie"
	end
	if PvPService.InGrace(attacker) or PvPService.InGrace(victim) then
		return false, "Rookie" -- A23-18: 60 s graduation grace, both ways
	end
	if victim:GetAttribute("Protected") == true then
		return false, "Protected"
	end
	return true, nil
end

-- called ONLY by CombatService's death pipeline (no kill credit: monster, fall, reset)
function PvPService.HandleNonPvPDeath(victim)
	if not victim then
		return
	end
	if (stars[victim] or 0) >= 1 then
		-- CR-L4: a death in town or without damage in the last few seconds (reset, fall) keeps the stars and bounty:
		-- carried gold is 0 in town, so a reset there would otherwise wipe them for free
		local lastHit = tonumber(S.CombatService.GetLastDamagedAt(victim)) or 0
		if S.ZoneService.IsTown(victim) == true or os.clock() - lastHit > GUARD.RecentHitSeconds then
			return
		end
		local carried = num(victim, "CarriedGold", 0)
		local loss = math.floor(carried * Config.PvP.VillainLossOnWantedPvEDeath)
		if loss > 0 then
			S.ProgressionService.TakeCarriedGold(victim, loss, "Penalty")
		end
	end
	PvPService.ResetStars(victim)
end

-- called ONLY by CombatService's death pipeline (after GrudgeService.OnCarrierDown). ctx = { HadSack = the victim
-- carried a grudge sack when it fell (seen before step 1 of the pipeline closed it) }
function PvPService.HandleKO(victim, killer, ctx)
	if not victim then
		return
	end
	if killer == nil or killer == victim or not isPlaying(killer) then
		PvPService.HandleNonPvPDeath(victim)
		return
	end
	local fk, fv = faction(killer), faction(victim)
	if not isFighter(fk) or not isFighter(fv) or fk == fv then
		-- defensive: Neutral / None / same-faction deaths are never PvP KOs (addendum A6)
		PvPService.HandleNonPvPDeath(victim)
		return
	end

	local P = Config.PvP
	local B = Config.Bully
	local Justice = S.JusticeService
	local Progression = S.ProgressionService
	-- the KO's own time (the death pipeline may wait for the friend answer; a respawn after it is not "fresh")
	local now = (type(ctx) == "table" and tonumber(ctx.At)) or os.clock()

	-- 1. snapshot + KO log (CR-M4: the log is kept in the killer's save)
	local starsBefore = stars[victim] or 0
	local bullyBefore = bullyStacksOf(victim)
	-- the victim's bully stacks that still pay a bounty (0 once claimed; anti-farm, see BULLY_BOUNTY_COOLDOWN)
	local bountyBully = bountyBullyStacks(victim)
	local repeated = logKO(killer, victim)

	-- 2. bully check (any faction pairing)
	local weak = combatPower(victim) < B.WeakPowerRatio * combatPower(killer) -- CR-L5
	-- CR-M15: bait = the victim dealt >= BaitMinPct of the killer's base MaxHealth to the killer within BaitWindow
	local baitNeed = (B.BaitMinPct or 0.2) * Config.MaxHealth(num(killer, "Level", 1), fk, classOf(killer))
	local baitDealt = recentDamage(victim, killer, now)
	local baited = baitDealt > 0 and baitDealt >= baitNeed
	if weak and baited then
		weak = false -- anti-bait: the victim attacked the killer first
	end
	local victimOutlaw = victim:GetAttribute("Outlaw") == true -- A23-23: an outlaw is hunted like a bully
	if weak and B.WantedIgnoresWeakRule and (starsBefore > 0 or bullyBefore > 0 or victimOutlaw) then
		weak = false
	end
	local spawned = spawnedAt[victim]
	local fresh = spawned ~= nil and spawned <= now and now - spawned < B.FreshSpawnSeconds
	local bully = weak or fresh or repeated
	-- CR-M14: a fresh / repeat KO of a victim who baited the killer is self-defense (no bully stack, no rewards),
	-- and a kaiju never becomes a bully (that would double its kaiju pool)
	local defense = baited and (fresh or repeated)
	if defense or kstate(killer) ~= "None" then
		bully = false
	end

	-- BB10 / A23-23: the weekly ranking verdict, decided before the revenge marks below change. A fair KO (PvPCreditOK)
	-- lets the Honor / Infamy below reach the weekly board; an unfair one (weak / idle / new / 4th of the week / fresh)
	-- that no exemption covers adds 1 to the killer's PvP board inside JudgeKO. Never yields: the death pipeline already
	-- asked IsFriendsWith (RankingService.ResolveFriends), so JudgeKO reads the friend cache only (NoYield).
	local bold = PvPService.BoldMult(killer, victim) -- A23-18: honor / infamy / war points only
	local killerMark = revenge[killer]
	local verdict = judgeKO(killer, victim, {
		Bold = bold, Fresh = fresh, Repeated = repeated,
		Defense = defense or victimStruckFirst(victim, killer, now),
		Revenge = killerMark ~= nil and killerMark.Target == victim and now < killerMark.Until,
		VictimWanted = starsBefore > 0, VictimBully = bullyBefore > 0, VictimOutlaw = victimOutlaw,
		VictimKaiju = kstate(victim) ~= "None", KillerKaiju = kstate(killer) == "Active", -- D2: a killer who IS a kaiju
		VictimHadSack = type(ctx) == "table" and ctx.HadSack == true, NoYield = true,
	})

	-- 3. revenge (always)
	revenge[victim] = { Target = killer, Until = now + Config.Revenge.Duration }
	setAttr(victim, "RevengeTargetId", killer.UserId)
	setAttr(victim, "RevengeUntil", Util.Now() + Config.Revenge.Duration)
	notify(victim, fmt("Revenge", Util.PlayerDisplayName(killer)), "info")
	local killerRevenge = revenge[killer]
	if killerRevenge and killerRevenge.Target == victim then
		local wasActive = now < killerRevenge.Until
		clearRevenge(killer)
		if wasActive then
			notify(killer, fmt("RevengeDone"), "good")
		end
	end

	local info
	if defense then
		-- CR-M14: self-defense KO: no bully stack, stars, plunder, honor/infamy, bounty or war points
		info = { Kind = "Defense", Bully = false, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	elseif bully then
		-- 4. bully KO: no plunder, stars, honor/infamy, bounty or war points
		local n = math.floor(tonumber(Justice.AddBullyStack(killer)) or 0)
		notify(killer, fmt("BullyKO", n), "bad", "None") -- a consequence, not a refused press
		notify(victim, fmt("BullyVictim"), "info")
		refreshStarAttrs(killer) -- bounty doubles while a bully
		info = { Kind = "Bully", Bully = true, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	else
		-- 5. pair cooldown for minted rewards (CR-M4: kept in the killer's save as "ko:<victimUserId>")
		local pairOk = pairReady(killer, victim.UserId, "ko", P.PairRewardCooldown)
		if pairOk and bold > 1 then notify(killer, fmt("BoldStrong"), "reward")
		elseif pairOk and bold < 1 then notify(killer, fmt("BoldWeak"), "info") end
		local vLevel = num(victim, "Level", 1)

		if fk == "Horns" then
			-- 6a. Horns KO Halo: plunder into the grudge sack
			if pairOk then
				addStar(killer) -- CR-M3: a farmed pair (inside the cooldown) adds no star
			end
			local stolen = 0
			if not S.GrudgeService.CanSteal(killer, victim) then
				notify(killer, fmt("PlunderTooSoon"), "info")
			else
				local carried = num(victim, "CarriedGold", 0)
				local safeFloor = P.SafeFloorPerLevel * vLevel
				stolen = math.min(math.floor(math.max(0, carried - safeFloor) * P.PlunderRate), P.PlunderCapPerLevel * vLevel)
				if stolen > 0 then
					stolen = math.floor(tonumber(Progression.TakeCarriedGold(victim, stolen, "Plunder")) or 0)
				end
				if stolen > 0 then
					-- A23-18 boldness; BB10: the sack also carries the fair weekly points (paid only if the thief keeps it)
					local inf = pairOk and PvPService.ScalePoints(1, bold) or 0
					local rankPts = verdict.Fair == true and inf or 0
					S.GrudgeService.AddToSack(killer, victim, stolen, inf, rankPts)
					if rankPts > 0 and S.RankingService and S.RankingService.CommitFair then
						pcall(S.RankingService.CommitFair, killer, victim)
					end
					local from, to = rootPos(victim), rootPos(killer)
					if from and to then
						Net.Fx(nil, "Plunder", { From = from, To = to, Amount = stolen })
					end
					notify(victim, fmt("Plundered", Util.PlayerDisplayName(killer), Util.FormatNumber(stolen)), "bad", "None")
					notify(killer, fmt("PlunderGain", Util.FormatNumber(stolen), stars[killer] or 0), "reward")
				end
			end
			if stolen == 0 and pairOk then
				local inf = PvPService.ScalePoints(1, bold) -- A23-18 boldness
				if inf > 0 then grantFame(killer, "Infamy", inf, verdict, victim) end -- no sack to carry it
			end
			local bullyBounty = 0
			if bountyBully > 0 and pairOk then
				bullyBounty = Config.Bounty(vLevel, 0, bountyBully)
				if bullyBounty > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
					Progression.AddBankGold(killer, bullyBounty, "Bounty")
					notify(killer, fmt("BullyBountyGain", Util.FormatNumber(bullyBounty)), "reward", "GoldPickup")
				end
			end
			info = {
				Kind = "Plunder", Bully = false, VictimStars = starsBefore,
				Stolen = stolen, Bounty = bullyBounty, Rewarded = pairOk, BoldMult = bold,
			}
		elseif starsBefore == 0 and bountyBully == 0 then
			-- 6b. Halo KO a clean Horns (or a bully whose bounty was already claimed): honor
			if pairOk then
				local honor = PvPService.ScalePoints(P.HonorPerKOMin, bold) -- A23-18 boldness
				if honor > 0 then
					grantFame(killer, "Honor", honor, verdict, victim)
					notify(killer, fmt("HonorGain", honor), "reward")
				end
			end
			info = { Kind = "Honor", Bully = false, VictimStars = 0, Stolen = 0, Bounty = 0, Rewarded = pairOk, BoldMult = bold }
		else
			-- 6c. Halo KO a Wanted (or bully) Horns: bounty
			local bounty = pairOk and Config.Bounty(vLevel, starsBefore, bountyBully) or 0
			if bounty > 0 then
				if bountyBully > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
				end
				Progression.AddBankGold(killer, bounty, "Bounty")
			end
			local honor = pairOk and PvPService.ScalePoints(math.max(1, starsBefore), bold) or 0 -- A23-18 boldness
			if honor > 0 then
				grantFame(killer, "Honor", honor, verdict, victim)
			end
			if starsBefore > 0 then
				local carried = num(victim, "CarriedGold", 0)
				local loss = math.floor(carried * P.VillainLossOnBountyKO)
				if loss > 0 then
					Progression.TakeCarriedGold(victim, loss, "Penalty")
				end
			end
			if bounty > 0 or honor > 0 then
				notify(killer, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward", "GoldPickup")
			end
			if starsBefore >= P.GlowStars and bounty > 0 then
				Net.NotifyAll(bountyLine(killer, bounty))
			end
			info = {
				Kind = "Bounty", Bully = false, VictimStars = starsBefore,
				Stolen = 0, Bounty = bounty, Rewarded = pairOk, BoldMult = bold,
			}
		end
	end

	-- 7. victim's stars are gone; tell everyone
	PvPService.ResetStars(victim)
	PvPService.PlayerKO:Fire(killer, victim, info)
end

------------------------------------------------------------------ board
-- RichText-safe player text on the board (nicknames are validated, Roblox names too; escaped anyway)
local function boardEsc(text)
	return (string.gsub(tostring(text), "[&<>\"]", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;" }))
end

-- BB11 (검수 2026-10-06): the crossroads board shows THIS server's weekly boards (Honor / Infamy / Artisan / PvP, the
-- same numbers as the ranking window, ties share a rank) and one wanted line. Names through PublicName; the red outlaw
-- tag only for players who ARE outlaws this week (shown even when the name is hidden, A23-23).
local function updateBoard()
	local ok, label = pcall(function()
		return S.MapBuilder.GetBoardLabel()
	end)
	if not ok or not label then
		return
	end
	local T = Config.Ranking.Text.Board
	local outlawTag = ' <font color="#FF4A4A">' .. Config.Ranking.Text.OutlawTag .. "</font>"
	local R = S.RankingService
	local lines = { T.Header }
	for _, board in Config.Ranking.Order do
		local rows = {}
		if R and R.ServerTop then
			local okTop, top = pcall(R.ServerTop, board, BOARD_ROWS)
			if okTop and type(top) == "table" then rows = top end
		end
		local parts = {}
		for _, row in rows do
			local text = string.format(T.Row, row.Rank, boardEsc(row.Name), Util.FormatNumber(row.Value))
			if row.Outlaw then text ..= outlawTag end
			table.insert(parts, text)
		end
		table.insert(lines, "<b>" .. T.Titles[board] .. "</b>  " .. (#parts > 0 and table.concat(parts, T.Sep) or T.Empty))
	end

	local wanted = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		local bounty = tonumber(p:GetAttribute("Bounty")) or 0
		if bounty > 0 then
			table.insert(wanted, { P = p, Name = publicName(p), Bounty = bounty, Stars = stars[p] or 0, Bully = bullyStacksOf(p) })
		end
	end
	table.sort(wanted, function(a, b)
		if a.Bounty ~= b.Bounty then
			return a.Bounty > b.Bounty
		end
		return a.P.UserId < b.P.UserId
	end)
	local parts = {}
	for i = 1, math.min(BOARD_ROWS, #wanted) do
		local w = wanted[i]
		local text = string.format("%d. %s", i, boardEsc(w.Name))
		if w.Stars > 0 then
			text ..= " " .. string.rep("★", w.Stars)
		end
		text ..= " " .. Util.FormatNumber(w.Bounty) .. T.Gold
		if w.Bully > 0 then
			text ..= " " .. T.Bully
		end
		if w.P:GetAttribute("Outlaw") == true then text ..= outlawTag end
		table.insert(parts, text)
	end
	table.insert(lines, "<b>" .. T.Wanted .. "</b>  " .. (#parts > 0 and table.concat(parts, T.Sep) or T.Empty))

	local text = table.concat(lines, "\n")
	if label.RichText ~= true then label.RichText = true end
	if label.Text ~= text then
		label.Text = text
	end
end

------------------------------------------------------------------ loops
local function tickPlayer(p, now)
	-- protection expiry (while protected: the outline back on a rebuilt body)
	local pu = protectedUntil[p]
	if pu and pu > 0 and now >= pu then
		protectedUntil[p] = 0
		destroyForceFields(p)
		setAttr(p, "Protected", false)
	elseif pu and pu > 0 then
		addProtectGlow(p)
	end

	-- star decay: one star per StarDecaySeconds, paused while queued / siren / active kaiju
	local s = stars[p] or 0
	if s > 0 then
		if kstate(p) ~= "None" then
			lastStarChange[p] = now
		elseif now - (lastStarChange[p] or now) >= Config.PvP.StarDecaySeconds then
			stars[p] = s - 1
			lastStarChange[p] = now
		end
	end
	refreshStarAttrs(p)
	checkGraduation(p)
	if graceUntil[p] and now >= graceUntil[p] then
		graceUntil[p] = nil
		local data = S.PlayerService.GetData(p)
		if type(data) == "table" then data.GraduateGraceUntil = 0 end
		setAttr(p, "GraduateGraceUntil", 0)
		notify(p, fmt("GraduateEnd"), "info")
	end
	setAttr(p, "Rookie", rookieAttr(p))

	-- revenge expiry
	local r = revenge[p]
	if r and (now >= r.Until or not isPlaying(r.Target)) then
		clearRevenge(p)
	end
end

-- CR-M15: drop bait-log hits older than BaitWindow (pair state itself is in the saves, CR-M4); BB10: finished fights
local function pruneDmgLog(now)
	for key, e in engage do
		if now - e.Last > GUARD.EngageGap then engage[key] = nil end
	end
	local cutoff = now - Config.Bully.BaitWindow
	for attacker, byVictim in dmgLog do
		for victim, hits in byVictim do
			pruneHits(hits, cutoff)
			if #hits == 0 then
				byVictim[victim] = nil
			end
		end
		if next(byVictim) == nil then
			dmgLog[attacker] = nil
		end
	end
end

-- CR-M12: stars saved at leave come back on the next join minus the decay for the time away, capped below the kaiju
-- threshold. Clears the saved fields. Returns (stars, seconds already spent toward the next decay step).
local function takeSavedStars(player, data)
	if type(data) ~= "table" then
		return 0, 0
	end
	local saved = math.floor(tonumber(data.SavedStars) or 0)
	local at = tonumber(data.SavedStarsAt) or 0
	data.SavedStars = 0
	data.SavedStarsAt = 0
	if saved <= 0 or at <= 0 or not isFighter(faction(player)) then
		return 0, 0
	end
	local step = math.max(1, Config.PvP.StarDecaySeconds)
	local away = math.max(0, os.time() - at)
	local decayed = math.floor(away / step)
	local needed = (Config.Kaiju and Config.Kaiju.StarsNeeded) or Config.PvP.MaxStars
	local cap = math.max(0, math.min(Config.PvP.MaxStars, needed - 1))
	local n = math.clamp(saved - decayed, 0, cap)
	return n, away - decayed * step
end

-- CR-M11: a Wanted Horns logging out while combat-tagged pays the bounty (+ honor, like a bounty KO) to the last Halo
-- attacker, once per pair per PairRewardCooldown. Returns true when paid (the stars count as claimed).
local function payLeaveBounty(player)
	-- CR-M11 / CR-M2: a server shutdown is not the player's choice; keep the stars (saved by CR-M12) instead
	local PS = S.PlayerService
	if PS and type(PS.IsShuttingDown) == "function" then
		local okS, closing = pcall(PS.IsShuttingDown)
		if okS and closing == true then
			return false
		end
	end
	local s = stars[player] or 0
	if s < 1 or faction(player) ~= "Horns" or kstate(player) == "Active" then
		return false -- an Active kaiju's logout is resolved by KaijuService
	end
	local C = S.CombatService
	if not C.IsInCombat(player) then
		return false
	end
	local a = C.GetLastPvPAttacker(player)
	if a == nil or a == player or not isPlaying(a) or not S.PlayerService.IsReady(a) or faction(a) ~= "Halo" then
		return false
	end
	if not pairReady(a, player.UserId, "ko", Config.PvP.PairRewardCooldown) then
		return false
	end
	local bully = bountyBullyStacks(player) -- 0 when this bully's bounty was already claimed
	local bounty = Config.Bounty(num(player, "Level", 1), s, bully)
	local bold = PvPService.BoldMult(a, player)
	local honor = PvPService.ScalePoints(math.max(1, s), bold) -- A23-18 boldness (same as a KO)
	-- BB10: judged like a KO with the leaver as the victim (their data is still loaded here); Wanted = never unfair
	local lastMark = revenge[a]
	local verdict = judgeKO(a, player, {
		Bold = bold, Fresh = false, Repeated = false, Defense = victimStruckFirst(player, a, os.clock()),
		Revenge = lastMark ~= nil and lastMark.Target == player and os.clock() < lastMark.Until,
		VictimWanted = true, VictimBully = bully > 0, VictimOutlaw = player:GetAttribute("Outlaw") == true,
		VictimKaiju = kstate(player) ~= "None", KillerKaiju = kstate(a) == "Active", VictimHadSack = false,
		NoYield = true, -- a PlayerLeaving handler: no web call (friends cache only)
	})
	if bounty > 0 then
		if bully > 0 then
			claimBullyBounty(player)
		end
		S.ProgressionService.AddBankGold(a, bounty, "Bounty")
	end
	if honor > 0 then grantFame(a, "Honor", honor, verdict, player) end
	notify(a, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward", "GoldPickup")
	if s >= Config.PvP.GlowStars and bounty > 0 then
		Net.NotifyAll(bountyLine(a, bounty))
	end
	return true
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player, data)
	-- CR-M12: bring back the stars saved at the last leave (decayed); failures just start clean
	local okSaved, restored, partial = pcall(takeSavedStars, player, data or S.PlayerService.GetData(player))
	if not okSaved then
		Util.Warn(TAG, "saved stars restore failed: " .. tostring(restored))
		restored, partial = 0, 0
	end
	stars[player] = restored
	lastStarChange[player] = os.clock() - (restored > 0 and partial or 0)
	protectedUntil[player] = 0
	player:SetAttribute("WantedStars", 0)
	player:SetAttribute("Bounty", 0)
	player:SetAttribute("Rookie", rookieAttr(player))
	wasRookie[player] = PvPService.IsRookie(player) -- graduation edge starts from the loaded state
	local saved = tonumber(type(data) == "table" and data.GraduateGraceUntil or 0) or 0
	if saved > os.time() then
		startGrace(player, saved - os.time()) -- a rejoin keeps the rest of the 60 s grace
	else
		player:SetAttribute("GraduateGraceUntil", 0)
	end
	player:SetAttribute("Protected", false)
	player:SetAttribute("RevengeTargetId", 0)
	player:SetAttribute("RevengeUntil", 0)
	if restored > 0 then
		refreshStarAttrs(player)
	end
end

local function cleanupPlayer(player)
	clearRevengeInvolving(player)
	stars[player] = nil
	lastStarChange[player] = nil
	protectedUntil[player] = nil
	spawnedAt[player] = nil
	revenge[player] = nil
	dmgLog[player] = nil
	for _, byVictim in dmgLog do
		byVictim[player] = nil
	end
	for key, e in engage do
		if e.A == player or e.B == player then engage[key] = nil end
	end
end

local function onPlayerLeaving(player, data)
	graceUntil[player], wasRookie[player] = nil, nil
	-- CR-M11: runs before KaijuService's handler (init order) and while JusticeService still reports the bully
	-- stacks (CR-L1 defers their cleanup)
	local okPay, paid = pcall(payLeaveBounty, player)
	if not okPay then
		Util.Warn(TAG, "leave bounty failed: " .. tostring(paid))
		paid = false
	end
	-- CR-M12: save the unclaimed stars so a rejoin cannot wipe them; a paid leave bounty or an Active kaiju
	-- (KaijuService resolves it) leaves none
	local d = data or S.PlayerService.GetData(player)
	if type(d) == "table" then
		local keep = (paid == true or kstate(player) == "Active") and 0 or (stars[player] or 0)
		-- CR-M12: like SavedBullyAt, back-date by the time already spent toward the next decay step this session
		-- (a queued / siren kaiju refreshes lastStarChange every tick, so into ~ 0 there)
		local step = math.max(1, Config.PvP.StarDecaySeconds)
		local now = os.clock()
		local into = math.clamp(math.floor(now - (lastStarChange[player] or now)), 0, step - 1)
		d.SavedStars = keep
		d.SavedStarsAt = keep > 0 and (os.time() - into) or 0
	end
	-- other services' PlayerLeaving handlers (e.g. KaijuService) may still call ResetStars; clean up after them
	clearRevengeInvolving(player)
	task.defer(cleanupPlayer, player)
end

local function onCharacterSpawned(player, _character, _humanoid, cosmetic)
	if cosmetic then return end -- replacing an appearance never renews spawn protection / the spawn clock
	spawnedAt[player] = os.clock()
	PvPService.Protect(player, Config.PvP.SpawnProtection)
end

-- CR-M15: log each PvP hit with its damage (the applied amount once CR-M10 lands) for the bait check
local function onPlayerDamaged(victim, amount, attacker)
	if victim == nil or attacker == nil then
		return
	end
	-- BB10 D2: who struck first in this fight (any hit, even one a shield blocked)
	local nowFight = os.clock()
	local key = engageKey(attacker, victim)
	local e = engage[key]
	if e == nil or nowFight - e.Last > GUARD.EngageGap then
		engage[key] = { By = attacker, T = nowFight, Last = nowFight, A = attacker, B = victim }
	else
		e.Last = nowFight
	end
	amount = tonumber(amount) or 0
	if amount ~= amount or amount <= 0 then
		return
	end
	local now = os.clock()
	local byVictim = dmgLog[attacker]
	if not byVictim then
		byVictim = {}
		dmgLog[attacker] = byVictim
	end
	local hits = byVictim[victim]
	if not hits then
		hits = {}
		byVictim[victim] = hits
	end
	pruneHits(hits, now - Config.Bully.BaitWindow)
	table.insert(hits, { T = now, A = amount })
	while #hits > GUARD.DmgLogMax do
		table.remove(hits, 1)
	end
end

local function onFactionChanged(player)
	PvPService.ResetStars(player)
	-- revenge marks never cross a faction change (and Neutral never gives/gets revenge; A6)
	clearRevengeInvolving(player)
	if isPlaying(player) then
		setAttr(player, "Rookie", rookieAttr(player))
	end
end

------------------------------------------------------------------ lifecycle
function PvPService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	S.CombatService.PlayerDamaged:Connect(onPlayerDamaged)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
end

function PvPService.Start()
	local okBoard, errBoard = pcall(updateBoard)
	if not okBoard then
		Util.Warn(TAG, "board update failed: " .. tostring(errBoard))
	end

	task.spawn(function()
		local boardAcc = 0
		local pruneAcc = 0
		while true do
			task.wait(LOOP_INTERVAL)
			local now = os.clock()
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tickPlayer, p, now)
				if not ok then
					warnLoop(err)
				end
			end

			boardAcc += LOOP_INTERVAL
			if boardAcc >= Config.PvP.BoardRefresh then
				boardAcc = 0
				local ok, err = pcall(updateBoard)
				if not ok then
					warnLoop(err)
				end
			end

			pruneAcc += LOOP_INTERVAL
			if pruneAcc >= PRUNE_INTERVAL then
				pruneAcc = 0
				local ok, err = pcall(pruneDmgLog, now)
				if not ok then
					warnLoop(err)
				end
			end
		end
	end)

	print("[PvPService] started")
end

return PvPService
]]></ProtectedString>
				<string name="ScriptGuid">{7EC92731-6279-4F18-A09F-E9E4E867152E}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PvPService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300021529</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXF1D564B3B7284253B158FC00F2E7F90F">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- DataService.luau : DataStore load/save with a session lock, retries, autosave, v1 -> v2 -> v3 migration and an
-- in-memory fallback for Studio sessions without API access. BindToClose is owned by PlayerService.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local TAG = "DataService"

local DataService = {}

local S = nil -- registry (unused at runtime; kept for the service pattern)

local store = nil -- GlobalDataStore, set by the probe in Start
local memoryMode = false
local probeDone = false

local cache = {} -- [Player] = live session table
local releasing = {} -- [Player] = true while Release() runs
local foreignLock = {} -- [Player] = true once another server owns the record (further saves are refused)
-- CR-M1: [userId] = { token, ... } FIFO of DataStore operations for that user; q[1] holds the slot (serializes
-- writes in request order, so a fast rejoin's Load can never jump ahead of the previous session's Release)
local slotQueue = {}
-- [Player] = GUID this session wrote into the stored record at Load (field SessionToken). A save only lands while the
-- stored token is still ours, so a delayed write of an old session can never overwrite a newer session's record.
local sessionTokens = {}

local PROBE_TIMEOUT = 30 -- seconds Load waits for the Start probe before giving up
local SLOT_TIMEOUT = 90 -- seconds a writer waits for the previous writer of the same user
local RELEASE_WAIT = 60 -- seconds a second Release() call waits for the first one

local TUTORIAL_NEW = (Config.Tutorial and Config.Tutorial.Steps and Config.Tutorial.Steps.Kill) or 0
local TUTORIAL_DONE = (Config.Tutorial and Config.Tutorial.Steps and Config.Tutorial.Steps.Done) or 99

------------------------------------------------------------------ helpers
local function keyFor(userId)
	return Config.Data.KeyPrefix .. tostring(userId)
end

-- per-user write slot: an older copy must never land after a newer one (autosave vs forced save vs release).
-- CR-M1: first come, first served. nil = the slot was not reached within SLOT_TIMEOUT (the caller fails; it never
-- writes without the slot)
local function acquireSlot(userId)
	local q = slotQueue[userId]
	if not q then
		q = {}
		slotQueue[userId] = q
	end
	local token = {}
	table.insert(q, token)
	local t0 = os.clock()
	while q[1] ~= token do
		if os.clock() - t0 >= SLOT_TIMEOUT then
			local i = table.find(q, token)
			if i then table.remove(q, i) end
			if #q == 0 and slotQueue[userId] == q then slotQueue[userId] = nil end
			return nil
		end
		task.wait(0.1)
	end
	return token
end

local function releaseSlot(userId, token)
	local q = slotQueue[userId]
	if not q then return end
	local i = table.find(q, token)
	if i then table.remove(q, i) end
	if #q == 0 and slotQueue[userId] == q then slotQueue[userId] = nil end
end

-- CR-M1: true while another Player object of this user (a fast rejoin to this server) still has a cached session
local function hasOtherSession(player)
	local userId = player.UserId
	for p in cache do
		if p ~= player and p.UserId == userId then return true end
	end
	return false
end

local function isLock(lock)
	return type(lock) == "table" and type(lock.JobId) == "string"
end

-- the session lock this server writes. Studio = a Studio test session wrote it (its JobId is "" as well)
local function newLock()
	return { JobId = game.JobId, Time = os.time(), Studio = RunService:IsStudio() or nil }
end

-- a lock held by ANOTHER server that is still considered alive. A23-48 batch (검수 2026-10-06): a lock left by a Studio
-- test session (JobId "" or Studio = true) never holds a live server back: a stopped Studio Play often skips its final
-- unlocked save, and a tester joining the live game right after must not wait for it (the SessionToken check in
-- writeRecord still stops every later save of that Studio session)
local function isLiveForeignLock(lock)
	if not isLock(lock) or lock.JobId == game.JobId then return false end
	if (lock.JobId == "" or lock.Studio == true) and not RunService:IsStudio() then return false end
	local t = tonumber(lock.Time)
	if not t then return false end
	return os.time() - t < Config.Data.LockTimeout
end

-- true if the stored value holds real player data (not just nothing / a bare session lock + token)
local function hasStoredData(old)
	if type(old) ~= "table" then return false end
	for k in old do
		if k ~= "SessionLock" and k ~= "SessionToken" then return true end
	end
	return false
end

-- stepwise v1 -> v2 -> v3 (each step idempotent; a record runs every step it has not reached yet)
local function migrate(d, player)
	if (tonumber(d.Version) or 1) < 2 then
		d.WeaponTier = d.WeaponTier or d.SwordTier or 1 -- v1 field SwordTier is renamed
		d.SwordTier = nil
		d.RebirthBonus = (tonumber(d.Rebirths) or 0) * Config.Rebirth.BonusNormal
		d.Class = "Warrior"
		d.ClassChosen = false -- migrated players get one free class pick (keeps their level)
		d.Quests = {} -- QuestService regenerates (DailyDay = 0 -> fresh dailies, no vacation)
		d.Version = 2
		print("[DataService] migrated v1 -> v2 for " .. player.Name)
	end
	-- B4 (A23-12): v3 adds weapon tier 8 (slime legendary, mask bit 7) and the Items / WeaponEnhance / LootFlags
	-- tables. No field changes: the new tables come from the defaults and fillDefaults normalizes the weapon fields.
	-- The bump exists so an older v2 server refuses these records (CR-L3 guard in loadLocked) instead of clamping an
	-- equipped tier 8 down to tier 7 and saving it (a free 90,000-gold weapon once the record is back on new code).
	if (tonumber(d.Version) or 1) < 3 then
		-- A23-34: every v1 / v2 record is from before the bare-handed start, when tier 1 was always owned (A23-4). Keep
		-- that here, because fillDefaults no longer forces bit 1: a missing / broken tier is tier 1 and bit 1 stays owned.
		-- v3 records written by older servers already carry bit 1 (their fillDefaults wrote it on every load).
		local tier = d.WeaponTier
		if type(tier) ~= "number" or tier ~= math.floor(tier) or tier < 1 or tier > Config.MaxWeaponTier then
			d.WeaponTier = 1
		end
		local mask = d.WeaponOwnedMask
		if type(mask) ~= "number" or mask ~= mask or mask < 0 or mask ~= math.floor(mask)
			or mask >= bit32.lshift(1, Config.MaxWeaponTier) then mask = 0 end
		d.WeaponOwnedMask = bit32.bor(mask, 1)
		d.Version = 3
	end
end

-- add missing keys from the defaults and repair obviously corrupted values
local function fillDefaults(d, playerName)
	for k, v in Config.Data.Defaults do
		local cur = d[k]
		if cur == nil then
			d[k] = Util.DeepCopy(v)
		elseif type(cur) ~= type(v) then
			Util.Warn(TAG, ("%s: field %s had type %s, reset to default"):format(playerName, k, type(cur)))
			d[k] = Util.DeepCopy(v)
		end
	end

	-- table default Tickets: also fill missing sub-keys
	if type(d.Tickets) ~= "table" then d.Tickets = {} end
	for _, kind in { "Class", "Faction" } do
		local n = tonumber(d.Tickets[kind])
		d.Tickets[kind] = (n and n == n and n > 0) and math.floor(n) or 0
	end

	-- receipts: array of strings, at most MaxReceiptsKept (oldest dropped)
	local receipts = {}
	if type(d.ProcessedReceipts) == "table" then
		for _, id in d.ProcessedReceipts do
			if type(id) == "string" or type(id) == "number" then table.insert(receipts, tostring(id)) end
		end
	end
	while #receipts > Config.Tickets.MaxReceiptsKept do
		table.remove(receipts, 1)
	end
	d.ProcessedReceipts = receipts

	-- ids that other services branch on
	if not Config.Factions[d.Faction] then d.Faction = "None" end
	if not Config.Classes[d.Class] then d.Class = "Warrior" end
	-- Appearance preferences are additive save fields; older records do not need a version reset.
	if d.CharacterGender ~= "M" and d.CharacterGender ~= "F" then d.CharacterGender = "M" end
	-- Never re-save a cached name before today's filter and global claim check. The separate directory is authoritative.
	d.Nickname = ""
	for _, key in { "HPPotionCount", "MPPotionCount" } do
		d[key] = Config.NormalizePotionCount(d[key])
	end
	d.Level = math.clamp(math.floor(tonumber(d.Level) or 1), 1, Config.Levels.MaxLevel)
	-- A23-34: 0 is valid for both weapon fields (bare hands, nothing owned) and no bit is forced any more; records from
	-- before the bare-handed start got their tier-1 bit in migrate (v1 / v2) or already saved it (v3).
	-- B4 + review: a mask that is not an integer mask of the weapon tiers (non-number, NaN, +-inf, < 0, fraction, or
	-- above validMask = any bit beyond MaxWeaponTier) is corrupted -> nothing owned (plus the equipped tier below).
	-- v3 records never carry higher bits (an older server refuses v3, a v2 server reset them), so keeping the low bits
	-- of e.g. 0xFFFFFFFF would hand out every weapon incl. T7 and the never-sold legendary.
	local owned = d.WeaponOwnedMask
	local validMask = bit32.lshift(1, Config.MaxWeaponTier) - 1
	if type(owned) ~= "number" or owned ~= owned or owned < 0 or owned > validMask
		or owned ~= math.floor(owned) then
		owned = 0
	end
	-- B4: a stored tier that is not an integer in 0..MaxWeaponTier is corrupted -> the best owned weapon usable at this
	-- level (0 = bare hands). Never clamp: clamping turned e.g. tier 9 into the last tier (8 = the never-sold legendary).
	local weaponTier = d.WeaponTier
	if type(weaponTier) ~= "number" or weaponTier ~= math.floor(weaponTier) or weaponTier < 0
		or weaponTier > Config.MaxWeaponTier then -- NaN fails the floor test, +-inf the range test
		weaponTier = Config.BestUsableWeapon(owned, d.Level)
	end
	d.WeaponTier = weaponTier
	-- Older saves only prove ownership of the equipped weapon. Preserve it, including rare tiers, without granting
	-- speculative earlier purchases.
	d.WeaponOwnedMask = weaponTier >= 1 and bit32.bor(owned, bit32.lshift(1, weaponTier - 1)) or owned
	-- Additive onboarding progress. Do not re-open a claimed/legacy tutorial or erase an unclaimed 5/5.
	local steps = Config.Tutorial and Config.Tutorial.Steps or { Kill = 0, Guide = 1, Quest = 2, Done = 99 }
	if d.TutorialStep ~= steps.Kill and d.TutorialStep ~= steps.Guide
		and d.TutorialStep ~= steps.Quest and d.TutorialStep ~= steps.Done then
		d.TutorialStep = TUTORIAL_DONE
	end
	local kills = d.TutorialKills
	if type(kills) ~= "number" or kills ~= kills or math.abs(kills) == math.huge then kills = 0 end
	local target = (Config.Tutorial and Config.Tutorial.QuestKills) or 5
	d.TutorialKills = math.clamp(math.floor(kills), 0, target)
	-- BB2: additive settings blob (Version stays 3): unknown / broken fields fall back to the defaults, keys are checked
	d.Settings = Config.SanitizeSettings(d.Settings)
	-- BB10 weekly ranking fields (additive): repaired, and an older week's points start over (written at the last leave).
	-- (Guarded: some offline suites load a cut-down Config without the ranking block.)
	if Config.SanitizeRank then Config.SanitizeRank(d, os.time()) end
	-- A23-32 bag '얻은 순' numbers (additive; an old save starts with 0 everywhere)
	if Config.SanitizeItemSeq then Config.SanitizeItemSeq(d) end
end

-- One UpdateAsync write of `data` (deep-copied now). The caller holds the user's write slot.
-- `sessionToken` = the token this session wrote at Load; the write is cancelled unless the stored record still carries it.
-- Returns (ok, abortedByForeignLock).
local function writeRecord(userId, data, release, label, sessionToken)
	if not store then return false, false end
	if type(sessionToken) ~= "string" then
		Util.Warn(TAG, ("save of %s refused: no session token"):format(label))
		return false, true
	end
	local copy = Util.DeepCopy(data)
	if release then
		copy.SessionLock = nil
	else
		copy.SessionLock = newLock()
	end
	copy.SessionToken = sessionToken

	local key = keyFor(userId)
	local attempts = 1 + math.max(0, Config.Data.SaveRetries)
	for attempt = 1, attempts do
		local foreign = false
		local ok, err = pcall(store.UpdateAsync, store, key, function(old)
			-- a newer session (this or another server) loaded the record after ours, or it was deleted: never
			-- overwrite it, even when that session already released its lock
			if type(old) ~= "table" or old.SessionToken ~= sessionToken then
				foreign = true
				return nil
			end
			if isLock(old.SessionLock) and old.SessionLock.JobId ~= game.JobId then
				foreign = true
				return nil -- another server owns this record: cancel the write
			end
			foreign = false
			return copy
		end)
		if ok then
			if foreign then
				Util.Warn(TAG, ("save of %s aborted: a newer session owns this data"):format(label))
				return false, true
			end
			return true, false
		end
		Util.Warn(TAG, ("save attempt %d/%d failed for %s: %s"):format(attempt, attempts, label, tostring(err)))
		if attempt < attempts then
			task.wait(2 ^ (attempt - 1)) -- 1, 2, 4 s
		end
	end
	return false, false
end

local function waitForProbe()
	local t0 = os.clock()
	while not probeDone do
		if os.clock() - t0 > PROBE_TIMEOUT then return false end
		task.wait()
	end
	return true
end

------------------------------------------------------------------ public API
function DataService.Init(registry)
	S = registry
end

function DataService.Start()
	-- DataStore probe (memory mode only ever in Studio)
	task.spawn(function()
		local okStore, result = pcall(function()
			return DataStoreService:GetDataStore(Config.Data.StoreName)
		end)
		if okStore and result then
			store = result
		end
		if RunService:IsStudio() then
			-- Studio test aid (game dev 1, 2026-10-06): ServerStorage attribute StudioFreshSave = true -> in-memory data, i.e. a
			-- brand-new save that is never written, for first-session checks without touching the tester's real save
			local okFresh, freshTest = pcall(function()
				return game:GetService("ServerStorage"):GetAttribute("StudioFreshSave") == true
			end)
			freshTest = okFresh and freshTest == true
			local usable = false
			if store and not freshTest then
				usable = pcall(function()
					store:GetAsync("__probe")
				end)
			end
			if not usable then
				memoryMode = true
				warn(freshTest and "[DataService] StudioFreshSave is on: fresh in-memory data; nothing will be saved."
					or "[DataService] DataStore unavailable (enable Studio Access to API Services). Using in-memory data; nothing will be saved.")
			end
		elseif not store then
			Util.Warn(TAG, "GetDataStore failed: " .. tostring(result))
		end
		probeDone = true
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			if probeDone and not memoryMode then
				local list = {}
				for player in cache do
					if not releasing[player] and not foreignLock[player] and player.Parent ~= nil then
						table.insert(list, player)
					end
				end
				for _, player in list do
					task.spawn(DataService.Save, player, false)
				end
			end
		end
	end)

	print("[DataService] started")
end

-- Load body; the caller holds the user's write slot. nil = failed or the player left
local function loadLocked(player)
	local userId = player.UserId
	local key = keyFor(userId)
	-- one token per Load (retries reuse it, so a committed-but-errored attempt is still recognised as ours)
	local sessionToken = HttpService:GenerateGUID(false)

	local loaded, fresh = nil, false
	local retries = math.max(1, Config.Data.LoadRetries)
	local warnedLock = false
	local tooNew, storedVersion = false, nil
	for attempt = 1, retries do
		if player.Parent == nil then
			return nil
		end
		local final = (attempt == retries) -- the final attempt steals the lock (dead-server recovery)
		local locked, captured, capturedFresh = false, nil, false
		local ok, err = pcall(store.UpdateAsync, store, key, function(old)
			tooNew = false
			-- CR-L3: a record saved by a newer data version is never rewritten (or locked) by this older server
			if type(old) == "table" and (tonumber(old.Version) or 1) > Config.Data.Version then
				tooNew, storedVersion = true, old.Version
				locked, captured = false, nil
				return nil
			end
			if not final and type(old) == "table" and isLiveForeignLock(old.SessionLock) then
				locked, captured = true, nil
				return nil -- cancel the write and retry later
			end
			locked = false
			capturedFresh = not hasStoredData(old)
			local d = (type(old) == "table") and old or {}
			d.SessionLock = newLock()
			d.SessionToken = sessionToken
			captured = d
			return d
		end)
		if ok and tooNew then
			break
		end
		if ok and captured and not locked then
			loaded, fresh = captured, capturedFresh
			break
		end
		if not ok then
			Util.Warn(TAG, ("load attempt %d/%d failed for %s: %s"):format(attempt, retries, player.Name, tostring(err)))
		elseif locked and not warnedLock then
			warnedLock = true
			Util.Warn(TAG, ("data of %s is locked by another server; retrying"):format(player.Name))
		end
		if not final then
			-- A23-48 batch: the player waits for a retry (a live lock of another server or a DataStore error): say it
			-- once and mark it for the loading screen (attribute SaveLoading; DataService.Load clears it)
			if player:GetAttribute("SaveLoading") ~= true then
				player:SetAttribute("SaveLoading", true)
				local okNote, errNote = pcall(function() -- Net only on this rare path (DataService needs no remotes otherwise)
					require(ReplicatedStorage.Shared.Net).Notify(player, Config.Text.SaveLoading, "info")
				end)
				if not okNote then Util.Warn(TAG, "SaveLoading notice failed: " .. tostring(errNote)) end
			end
			task.wait(Config.Data.LoadRetryDelay)
		end
	end

	if tooNew then
		-- CR-L3: kicked with LoadFailed; the player rejoins a server running the newer version
		Util.Warn(TAG, ("data of %s has version %s (> %d): saved by a newer server; refusing to load"):format(
			player.Name, tostring(storedVersion), Config.Data.Version))
		return nil
	end
	if not loaded then
		return nil
	end

	local d = Util.DeepCopy(loaded)
	d.SessionLock = nil
	d.SessionToken = nil -- kept in sessionTokens, never in the session table

	-- A4 / A5-C5: onboarding step BEFORE the generic default fill
	if fresh then
		d.TutorialStep = TUTORIAL_NEW
	elseif type(d.TutorialStep) ~= "number" then
		d.TutorialStep = TUTORIAL_DONE
	end

	if not fresh then
		migrate(d, player) -- a brand-new record gets everything from the defaults below
		-- A23-71 (user 2026-10-07): skills are learned at Lv5 / 15 / 25 now (Q was there from the start, Z Lv5, X Lv8).
		-- An older save gets its slots once from its level and rebirths (this may lower them, once); after that
		-- SkillService only raises them (Version stays 3: an additive fix like BB2)
		if d.SkillsA71 ~= true then
			d.SkillSlots = Config.SkillSlotsFor(d.Level, d.Rebirths)
			d.SkillsA71 = true
		end
	end
	fillDefaults(d, player.Name)
	d.Version = Config.Data.Version
	if (tonumber(d.FirstJoinTime) or 0) == 0 then
		d.FirstJoinTime = os.time()
	end

	if player.Parent == nil then
		-- left during the load: write it back unlocked; nothing is cached
		writeRecord(userId, d, true, player.Name, sessionToken)
		return nil
	end

	sessionTokens[player] = sessionToken
	cache[player] = d
	return d
end

-- yields. nil = failed (caller kicks) or the player left during the load
function DataService.Load(player)
	if cache[player] then return cache[player] end
	if not waitForProbe() then
		Util.Warn(TAG, "DataStore probe did not finish; cannot load " .. player.Name)
		return nil
	end
	if player.Parent == nil then return nil end

	if memoryMode then
		local d = Util.DeepCopy(Config.Data.Defaults)
		d.TutorialStep = TUTORIAL_NEW -- always a fresh record in memory mode (A5-C5)
		d.Version = Config.Data.Version
		d.FirstJoinTime = os.time()
		cache[player] = d
		return d
	end
	if not store then
		Util.Warn(TAG, "no DataStore available; cannot load " .. player.Name)
		return nil
	end

	local userId = player.UserId
	-- CR-M1: a previous session of this user on this server (fast rejoin) must finish its Release first; its final
	-- save may not have queued for the slot yet (PlayerLeaving handlers still running)
	local tWait = os.clock()
	while hasOtherSession(player) do
		if player.Parent == nil then return nil end
		if os.clock() - tWait >= SLOT_TIMEOUT then
			Util.Warn(TAG, "the previous session of " .. player.Name .. " is still saving; cannot load")
			return nil
		end
		task.wait(0.1)
	end
	if player.Parent == nil then return nil end

	-- holding the slot also waits for any queued save of this user (autosave retries, release) to finish first
	local token = acquireSlot(userId)
	if not token then
		Util.Warn(TAG, "a previous save of " .. player.Name .. " is still running; cannot load")
		return nil
	end
	-- the slot is always released, even if the body throws (a leaked slot would block every later load / save)
	local okBody, result = pcall(loadLocked, player)
	releaseSlot(userId, token)
	if player:GetAttribute("SaveLoading") ~= nil then player:SetAttribute("SaveLoading", nil) end -- the wait is over
	if not okBody then
		Util.Warn(TAG, "load error for " .. player.Name .. ": " .. tostring(result))
		return nil
	end
	return result
end

-- the live session table (mutable)
function DataService.Get(player)
	return cache[player]
end

-- yields; safe to call concurrently (writes of one user are serialized)
function DataService.Save(player, release)
	release = (release == true)
	if not cache[player] then return false end
	if memoryMode then return true end
	if not store or foreignLock[player] then return false end

	local userId = player.UserId
	local token = acquireSlot(userId)
	if not token then
		Util.Warn(TAG, "save of " .. player.Name .. " skipped: the previous save is still running")
		return false
	end
	local data = cache[player]
	-- re-check after waiting: the session may have been released, or a release may be in progress
	if not data or foreignLock[player] or (releasing[player] and not release) then
		releaseSlot(userId, token)
		return false
	end
	-- pcall: the slot must be released even if the write throws (CR-M1)
	local okCall, ok, foreign = pcall(writeRecord, userId, data, release, player.Name, sessionTokens[player])
	releaseSlot(userId, token)
	if not okCall then
		Util.Warn(TAG, "save error for " .. player.Name .. ": " .. tostring(ok))
		return false
	end
	if foreign then
		foreignLock[player] = true
	end
	return ok == true
end

-- yields; sets LastLogoutTime, final unlocked save, drops the cache. Idempotent.
function DataService.Release(player)
	if releasing[player] then
		local t0 = os.clock()
		while releasing[player] and os.clock() - t0 < RELEASE_WAIT do
			task.wait(0.1)
		end
		return
	end
	local data = cache[player]
	if not data then return end

	releasing[player] = true
	data.LastLogoutTime = os.time()
	local ok, result = pcall(DataService.Save, player, true)
	if not ok then
		Util.Warn(TAG, "final save error for " .. player.Name .. ": " .. tostring(result))
	elseif not result and not memoryMode then
		Util.Warn(TAG, "final save failed for " .. player.Name)
	end
	cache[player] = nil
	sessionTokens[player] = nil
	foreignLock[player] = nil
	releasing[player] = nil
end

function DataService.IsMemoryMode()
	return memoryMode
end

function DataService.IsPersistentReady()
	return probeDone and not memoryMode and store ~= nil
end

return DataService
]]></ProtectedString>
				<string name="ScriptGuid">{9B0A285A-2E72-4FED-8C71-91F40EB827F9}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DataService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e5300025514</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXCDAADE02207D4F65A190963306747C83">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- BoardService.luau : E11 hunting-field job boards (docs/design/quest_volume_2026-10-06.md §3-3 / §4, 검수 OK
-- 2026-10-07). Config.Board: each field's board (Meadow, Woods) shows this player Cards cards built from the J1..J10
-- templates with the field's own values; a card is taken as [Kind] or [Sneaky] (the side is only counted in
-- data.Story.N: no honor / infamy / ranking points, A23-23 D1); a player carries up to Hold jobs. A finished job pays
-- at once (HuntValue(the board's Level, 1); x AfterMult after FullPerDay jobs a KST day; the BonusAt-th job of a day
-- also gives BonusItem, once) and says which way the shard leaned. A taken or swapped card is replaced by a template
-- that is not one of that board's last two. Nothing ever times out, fails or disappears (kid-friendly).
-- Enabled = false (until game dev 1's board window ships): the remote does nothing and QuestService keeps its extra
-- quests; on, a claimed daily slot stays empty and the boards take that role (QuestService.extraOrEmpty).
-- data.Board = { Day, Done, Bonus, RerollAt, Held = { { Id, Board, Side, Target, P } }, Cards = { [board] = { id.. } },
--   Recent = { [board] = { id, id } } }
-- Remote c->s "BoardAction"(boardId, "Open" | "Take" | "Reroll", slot 1..Cards, side "Kind" | "Sneaky"): the player
-- must stand within Range of the board spot (Config.StoryQuests.Landmarks[board.Spot]). s->c "Board": the payload of
-- payloadFor (owner only).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local BoardService = {}
local S = nil
local TAG = "BoardService"
local B = Config.Board or {}
local TICK = 1
-- J10 Near.Stay: [Player] = { [job id .. ":" .. board] = os.clock() when the player came inside } (session only)
local stays = {}

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return default or 0
end

local function on()
	return B.Enabled == true
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

local function notify(player, text, kind, sound)
	if type(text) == "string" and text ~= "" then pcall(Net.Notify, player, text, kind or "info", nil, sound) end
end

local function dirty(player)
	if S.QuestService and type(S.QuestService.MarkDirty) == "function" then pcall(S.QuestService.MarkDirty, player) end
end

------------------------------------------------------------------ data
local function jobDef(id)
	for _, j in B.Jobs or {} do
		if j.Id == id then return j end
	end
	return nil
end

local function state(data)
	local st = data.Board
	if type(st) ~= "table" then
		st = {}
		data.Board = st
	end
	if type(st.Held) ~= "table" then st.Held = {} end
	if type(st.Cards) ~= "table" then st.Cards = {} end
	if type(st.Recent) ~= "table" then st.Recent = {} end
	st.Done = math.max(0, math.floor(num(st.Done)))
	st.Bonus = st.Bonus == true
	-- a new KST day: the full-reward count and the bonus start again (held jobs and cards stay)
	local today = Config.DayIndex(os.time())
	if num(st.Day) ~= today then
		st.Day, st.Done, st.Bonus = today, 0, false
	end
	return st
end

-- drop unknown boards / jobs and bad numbers (an old or edited save never breaks the board)
local function sanitize(data)
	local st = state(data)
	local held = {}
	for _, h in st.Held do
		if type(h) == "table" and jobDef(h.Id) and type(B.Boards) == "table" and B.Boards[h.Board]
			and (h.Side == "Kind" or h.Side == "Sneaky") and #held < num(B.Hold, 3) then
			h.Target = math.max(1, math.floor(num(h.Target, 1)))
			h.P = math.clamp(num(h.P), 0, h.Target)
			table.insert(held, h)
		end
	end
	st.Held = held
	for id, cards in st.Cards do
		if type(B.Boards) ~= "table" or not B.Boards[id] or type(cards) ~= "table" then st.Cards[id] = nil end
	end
end

------------------------------------------------------------------ cards
-- the job's objective with this board's values ("$Unit", "$Big", "$Arrival", "$Camp", "$Gate")
local function objFor(job, board)
	local o = {}
	for k, v in job.Obj do
		if type(v) == "string" and string.sub(v, 1, 1) == "$" then
			o[k] = board[string.sub(v, 2)]
		else
			o[k] = v
		end
	end
	return o
end

local function countFor(job, boardId)
	local c = type(job.Count) == "table" and job.Count[boardId] or job.Count
	return math.max(1, math.floor(num(c, 1)))
end

-- a template this player can do at all: Auto Battle unlocked for NeedAuto, A23-71 a skill learned for NeedSkill (the
-- first skill comes at Lv5)
local function canDo(player, job)
	if job.NeedAuto and player:GetAttribute("AutoCombatUnlocked") ~= true then return false end
	return not job.NeedSkill or Config.SkillLearned(player:GetAttribute("SkillSlots"), player:GetAttribute("Level"),
		player:GetAttribute("Rebirths"))
end

-- a template this player can do on this board, not shown already and not one of its last two
local function eligible(player, job, boardId, avoid)
	if avoid[job.Id] then return false end
	if not canDo(player, job) then return false end
	local only = job.Boards
	return only == nil or only[boardId] == true
end

local function pick(player, boardId, avoid)
	local pool, total = {}, 0
	for _, job in B.Jobs or {} do
		if eligible(player, job, boardId, avoid) then
			table.insert(pool, job)
			total += math.max(0, num(job.Weight, 3))
		end
	end
	if #pool == 0 then return nil end
	local r = Util.Random:NextNumber() * total
	for _, job in pool do
		local w = math.max(0, num(job.Weight, 3))
		if r < w then return job.Id end
		r -= w
	end
	return pool[#pool].Id
end

local function avoidSet(st, boardId, cards, except)
	local avoid = {}
	for i, id in cards do
		if i ~= except then avoid[id] = true end
	end
	for _, id in st.Recent[boardId] or {} do avoid[id] = true end
	return avoid
end

local function remember(st, boardId, id)
	local recent = st.Recent[boardId] or {}
	table.insert(recent, 1, id)
	while #recent > 2 do table.remove(recent) end
	st.Recent[boardId] = recent
end

-- a board with SafeIds (the PvP woods) always keeps at least one card that is done outside the PvP zone
local function keepSafe(player, st, boardId, cards)
	local safe = B.Boards[boardId].SafeIds
	if type(safe) ~= "table" then return end
	for _, id in cards do
		if safe[id] then return end
	end
	local avoid = avoidSet(st, boardId, cards, #cards)
	for id in safe do avoid[id] = nil end
	local choices = {}
	for _, job in B.Jobs or {} do
		if safe[job.Id] and eligible(player, job, boardId, avoid) then table.insert(choices, job.Id) end
	end
	table.sort(choices)
	if #choices > 0 then cards[#cards] = choices[Util.Random:NextInteger(1, #choices)] end
end

local function cardsOf(player, st, boardId)
	local cards = st.Cards[boardId]
	if type(cards) ~= "table" then cards = {} end
	-- saved cards stay while the player can do them (A23-71 S11: a 'Hit 3 at once' card saved before the first skill is
	-- swapped for another job)
	local valid = {}
	for _, id in cards do
		local job = jobDef(id)
		if job and canDo(player, job) and #valid < num(B.Cards, 4) then table.insert(valid, id) end
	end
	cards = valid
	while #cards < num(B.Cards, 4) do
		local id = pick(player, boardId, avoidSet(st, boardId, cards, 0))
		if not id then break end
		table.insert(cards, id)
	end
	keepSafe(player, st, boardId, cards)
	st.Cards[boardId] = cards
	return cards
end

-- the card in `slot` is replaced by a new template (not on the board, not one of the last two)
local function replaceCard(player, st, boardId, slot)
	local cards = cardsOf(player, st, boardId)
	local old = cards[slot]
	if old then remember(st, boardId, old) end
	local id = pick(player, boardId, avoidSet(st, boardId, cards, slot))
	if id then cards[slot] = id end
	keepSafe(player, st, boardId, cards)
end

------------------------------------------------------------------ rewards
local function reward(boardId, done)
	local board = B.Boards[boardId]
	local g, x = Config.HuntValue(math.max(1, num(board.Level, 1)), 1)
	if done >= num(B.FullPerDay, 10) then
		g, x = math.floor(g * num(B.AfterMult, 0.5)), math.floor(x * num(B.AfterMult, 0.5))
	end
	return math.max(1, math.floor(g)), math.max(1, math.floor(x))
end

local function goalText(job, board, h)
	local t = string.gsub(job.Goal or job.Id, "{(%w+)}", function(key)
		local id = board[key]
		local m = type(id) == "string" and Config.MonsterTypes[id]
		return (m and (m.Short or m.Name)) or (type(board[key .. "Name"]) == "string" and board[key .. "Name"]) or tostring(id)
	end)
	local ok, text = pcall(string.format, t, math.floor(num(h.P)), h.Target)
	return ok and text or t
end

local function finish(player, data, index)
	local st = state(data)
	local h = st.Held[index]
	if not h then return end
	-- saved first: the job leaves the list before anything is paid, so it can never pay twice
	table.remove(st.Held, index)
	if stays[player] then stays[player][h.Id .. ":" .. h.Board] = nil end
	local g, x = reward(h.Board, st.Done)
	st.Done += 1
	S.ProgressionService.AddBankGold(player, g, "Quest")
	S.ProgressionService.AddXP(player, x)
	local story = type(data.Story) == "table" and data.Story or {}
	data.Story = story
	if type(story.N) ~= "table" then story.N = {} end
	story.N[h.Side] = math.floor(num(story.N[h.Side])) + 1
	local T = B.Text or {}
	notify(player, string.format(T.Done or "Job done! +%s gold · +%s XP", Util.FormatNumber(g), Util.FormatNumber(x)), "reward",
		"QuestDone")
	notify(player, h.Side == "Kind" and T.LeanKind or T.LeanSneaky, "info")
	if st.Done == num(B.BonusAt, 5) and not st.Bonus then
		st.Bonus = true -- saved before the scroll
		local loot = S.LootService
		if type(loot) == "table" and type(loot.GrantItem) == "function" and type(B.BonusItem) == "string" then
			local ok, given = pcall(loot.GrantItem, player, B.BonusItem, 1)
			if not ok then Util.Warn(TAG, "GrantItem: " .. tostring(given)) end
			local item = Config.Loot.Items[B.BonusItem]
			if ok and num(given) > 0 then
				notify(player, string.format(T.Bonus or "%s", item and item.Name or B.BonusItem), "reward", "None")
			end
		end
	end
	dirty(player)
end

------------------------------------------------------------------ progress
local function feed(player, ev)
	if not on() then return end
	local data = getData(player)
	if not data then return end
	local st = state(data)
	local story = S.StoryQuestService
	if type(story) ~= "table" or type(story.EventAmount) ~= "function" then return end
	for i = #st.Held, 1, -1 do
		local h = st.Held[i]
		local job = jobDef(h.Id)
		local board = job and B.Boards[h.Board]
		if job and board and job.Obj.Type ~= "Near" then
			local ok, add = pcall(story.EventAmount, player, objFor(job, board), ev)
			if ok and num(add) > 0 then
				h.P = math.min(h.Target, num(h.P) + num(add))
				dirty(player)
				if h.P >= h.Target then finish(player, data, i) end
			end
		end
	end
end

-- J10: stand within Radius of the spot for Target seconds in one go (leaving starts again)
local function tickStays(player)
	local data = getData(player)
	if not data then return end
	local st = state(data)
	local root = Util.GetRoot(player)
	local mine = stays[player]
	for i = #st.Held, 1, -1 do
		local h = st.Held[i]
		local job = jobDef(h.Id)
		local board = job and B.Boards[h.Board]
		if job and board and job.Obj.Type == "Near" then
			local o = objFor(job, board)
			local spot = Config.StoryQuests.Landmarks[o.Spot]
			local key = h.Id .. ":" .. h.Board
			local inside = spot ~= nil and root ~= nil and Util.FlatDistance(root.Position, spot) <= num(o.Radius, 14)
			if inside then
				if not mine then
					mine = {}
					stays[player] = mine
				end
				mine[key] = mine[key] or os.clock()
				local held = math.min(h.Target, math.floor(os.clock() - mine[key]))
				if held ~= num(h.P) then
					h.P = held
					dirty(player)
				end
				if held >= h.Target then finish(player, data, i) end
			else
				if mine then mine[key] = nil end
				if num(h.P) ~= 0 then
					h.P = 0
					dirty(player)
				end
			end
		end
	end
end

------------------------------------------------------------------ the board payload + remote
local function payloadFor(player, data, boardId)
	local st = state(data)
	local board = B.Boards[boardId]
	local cards = {}
	local g, x = reward(boardId, st.Done)
	for i, id in cardsOf(player, st, boardId) do
		local job = jobDef(id)
		local kindText = type(job.Kind) == "table" and (job.Kind[boardId] or job.Kind.All) or job.Kind
		local sneakyText = type(job.Sneaky) == "table" and (job.Sneaky[boardId] or job.Sneaky.All) or job.Sneaky
		table.insert(cards, { Slot = i, Id = id, Kind = kindText, Sneaky = sneakyText,
			Goal = goalText(job, board, { P = 0, Target = countFor(job, boardId) }), Target = countFor(job, boardId),
			RewardGold = g, RewardXP = x })
	end
	local n = type(data.Story) == "table" and type(data.Story.N) == "table" and data.Story.N or {}
	return { Board = boardId, Cards = cards, Held = #st.Held, Hold = num(B.Hold, 3), Done = st.Done,
		FullPerDay = num(B.FullPerDay, 10), Kind = math.floor(num(n.Kind)), Sneaky = math.floor(num(n.Sneaky)),
		RerollAt = num(st.RerollAt) }
end

local function send(player, data, boardId)
	local ok, err = pcall(function()
		Net.Get("Board"):FireClient(player, payloadFor(player, data, boardId))
	end)
	if not ok then Util.Warn(TAG, "Board send: " .. tostring(err)) end
end

local function nearBoard(player, board)
	local spot = Config.StoryQuests.Landmarks[board.Spot]
	local root = Util.GetRoot(player)
	return spot ~= nil and root ~= nil and Util.FlatDistance(root.Position, spot) <= num(B.Range, 14)
end

local function onBoardAction(player, boardId, action, slot, side, ...)
	if not on() then return end
	if select("#", ...) ~= 0 or type(boardId) ~= "string" or type(action) ~= "string" then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "BoardAction", (Config.RateLimits and Config.RateLimits.BoardAction) or 0.3) then return end
	local board = type(B.Boards) == "table" and B.Boards[boardId] or nil
	local data = getData(player)
	if not board or not data or not nearBoard(player, board) then return end
	local st = state(data)
	if action == "Open" then
		send(player, data, boardId)
		return
	end
	if type(slot) ~= "number" or slot ~= slot or slot % 1 ~= 0 or slot < 1 or slot > num(B.Cards, 4) then return end
	local cards = cardsOf(player, st, boardId)
	if not cards[slot] then return end
	if action == "Take" then
		if side ~= "Kind" and side ~= "Sneaky" then return end
		if #st.Held >= num(B.Hold, 3) then
			notify(player, (B.Text or {}).Full, "info")
			return
		end
		local job = jobDef(cards[slot])
		table.insert(st.Held, { Id = job.Id, Board = boardId, Side = side, Target = countFor(job, boardId), P = 0 })
		st.Seen = true -- the hint row goes away
		replaceCard(player, st, boardId, slot)
		dirty(player)
		send(player, data, boardId)
	elseif action == "Reroll" then
		if side ~= nil then return end
		local now = os.time()
		if now < num(st.RerollAt) then return end
		replaceCard(player, st, boardId, slot)
		st.RerollAt = now + num(B.RerollCooldown, 60)
		send(player, data, boardId)
	end
end

------------------------------------------------------------------ public
-- the held jobs as quest-list rows (QuestService.publish; Kind "Job", no [Claim]: a job pays when it is done)
function BoardService.JobRows(player, data)
	if not on() or type(data) ~= "table" then return {} end
	local st = state(data)
	local rows = {}
	-- quest_volume §4: after M1_4 one "Job Board · tap for directions" row guides to the meadow board until the first
	-- job is taken (st.Seen)
	local done = type(data.Story) == "table" and type(data.Story.Done) == "table" and data.Story.Done or {}
	if st.Seen ~= true and #st.Held == 0 and done[B.HintAfter or "M1_4"] and type(B.HintBoard) == "string"
		and B.Boards[B.HintBoard] then
		table.insert(rows, { Id = "job:board", Kind = "Job", Pinned = false, Text = (B.Text or {}).Hint or "Job Board",
			ShortName = (B.Text or {}).HintShort,
			Progress = 0, Target = 1, RewardGold = 0, RewardXP = 0, CanClaim = false, ShowProgress = false,
			Job = { Board = B.HintBoard, Guide = B.Boards[B.HintBoard].Spot } })
	end
	for i, h in st.Held do
		local job = jobDef(h.Id)
		local board = job and B.Boards[h.Board]
		if job and board then
			local g, x = reward(h.Board, st.Done)
			table.insert(rows, {
				Id = "job:" .. i, Kind = "Job", Pinned = false, Text = goalText(job, board, h), ShortName = job.ShortName,
				Progress = math.floor(num(h.P) * 10) / 10, Target = h.Target, RewardGold = g, RewardXP = x,
				CanClaim = false, ShowProgress = h.Target > 1,
				Job = { Board = h.Board, Side = h.Side, Card = h.Id, Guide = board.Zone },
			})
		end
	end
	return rows
end

function BoardService.IsOn()
	return on()
end

local function connect(serviceName, signalName, fn)
	local service = S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function BoardService.Init(registry)
	S = registry
end

function BoardService.Start()
	Net.Get("BoardAction").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onBoardAction, player, ...)
		if not ok then Util.Warn(TAG, "BoardAction: " .. tostring(err)) end
	end)
	connect("MonsterService", "MonsterKilled", function(player, info)
		if type(info) == "table" and typeof(player) == "Instance" and player:IsA("Player") then
			feed(player, { Kind = "Kill", Info = info })
		end
	end)
	connect("CombatService", "Released", function(player, info)
		if type(info) == "table" then feed(player, { Kind = "Skill", Info = info }) end
	end)
	connect("ProgressionService", "GoldEarned", function(player, amount, source)
		feed(player, { Kind = "Gold", Amount = amount, Source = source })
	end)
	connect("PlayerService", "PlayerReady", function(player)
		local data = getData(player)
		if data then pcall(sanitize, data) end
	end)
	task.spawn(function()
		while true do
			task.wait(TICK)
			if on() then
				for _, p in S.PlayerService.GetReadyPlayers() do
					local ok, err = pcall(tickStays, p)
					if not ok then Util.Warn(TAG, "stay: " .. tostring(err)) end
				end
			end
			for p in stays do
				if p.Parent == nil then stays[p] = nil end
			end
		end
	end)
	print("[BoardService] started" .. (on() and "" or " (off: Config.Board.Enabled = false)"))
end

return BoardService
]]></ProtectedString>
				<string name="ScriptGuid">{6647911D-76D4-4F1B-9ECE-DE0593BF507A}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">BoardService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">00a781d6b8ab04140ad785ab0000636b</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXE1FF884CBEB74199A33FF6888A80AEA2">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- TelemetryService.luau : P6 / BB38 (docs/design/beta_basics_2026-10-05.md BB38, mmorpg_painpoints §2, 검수 2026-10-07:
-- economy + friends, emergent_play_watch §2) Roblox AnalyticsService funnel / custom events, no personal data: no
-- names, UserIds, chat or free text in an event name or field (every name and field comes from a fixed list: Config,
-- zone / monster / window ids). Read-only observer: it only listens to signals / attributes and never changes game
-- state. Every call is pcall'd; a missing AnalyticsService (Studio, old engine) costs nothing. Config.Analytics.Debug
-- (default: Studio) prints every call.
--   Onboarding funnel (each step once per account, any order; data.Telemetry.Funnel = { [name] = true }):
--     Config.Analytics.Steps = IntroDone, Faction, Class, FirstMissionAccept, MeadowArrive, FirstHit, FirstKill,
--     FirstMissionDone, ForgeArrive, FirstWeapon, FirstSkillHit, AutoUnlocked, Level10 (A23-68 #5: the first 3 minutes;
--     A23-71 S13: the first skill comes at Lv5, before Auto Battle opens)
--   Right away: FirstDeath_<By> (BB14 KO cause, once per account), AutoOn / AutoOff, Plunder_Kept / _Avenged /
--     _Returned, KeyRebind (actions changed), WindowOpen_<id> (UiMetric, once per session per window),
--     RookieFirstKillSeconds, HighLevelInMeadow, ServerPopulation, CrownTrialMiss, SameKindStreak, ReturnAct (the first
--     actions of a returning player: a zone entered or a window opened)
--   At leave (per session sums): SessionMinutes, AutoAwayMinutes (auto ON with no own action for AwayAfter s),
--     EnhanceFailLeave (left within EnhanceFailLeave s of a failed enhance), GoldIn / GoldOut (per source / sink),
--     FriendMinutes (a friend on the server), KillsTogether / KillsWithFriend, ZoneMinutes (per zone), RankingViews
--     (per board)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local TelemetryService = {}
local S = nil
local A = Config.Analytics or {}
local T = {
	Analytics = nil,
	Debug = nil,
	Steps = A.Steps or { "IntroDone", "Faction", "Class", "FirstMissionAccept", "MeadowArrive", "FirstHit", "FirstKill",
		"FirstMissionDone", "ForgeArrive", "FirstWeapon", "FirstSkillHit", "AutoUnlocked", "Level10" },
	FirstHit = {}, -- [Player] = true once FirstHit is logged (or passed): later hits skip the funnel lookup
	UiIds = {}, -- [window id] = true (Config.Analytics.UiIds)
	JoinedAt = {}, -- [Player] = os.clock()
	MeadowAt = {}, -- [Player] = os.clock() of the first SlimeMeadow entry this session (rookies only)
	EnhanceFailAt = {}, -- [Player] = os.clock() of the last failed enhance
	Throttle = {}, -- ["<userId>:<key>"] = os.clock()
	Conns = {}, -- [Player] = { RBXScriptConnection } (attribute watchers, dropped on leave)
	Session = {}, -- [Player] = per-session sums and once-flags (see newSession)
	Friend = {}, -- ["<lowId>:<highId>"] = true / false (IsFriendsWith, cached for the server's life)
}
for _, id in A.UiIds or {} do T.UiIds[id] = true end

local function num(v, default)
	v = tonumber(v)
	if v == nil or v ~= v then return default or 0 end
	return v
end

local function analytics()
	if T.Analytics == nil then
		local ok, svc = pcall(game.GetService, game, "AnalyticsService")
		T.Analytics = ok and svc or false
	end
	return T.Analytics or nil
end

local function debugOn()
	if T.Debug == nil then
		if A.Debug ~= nil then
			T.Debug = A.Debug == true
		else
			local ok, studio = pcall(RunService.IsStudio, RunService)
			T.Debug = ok and studio == true
		end
	end
	return T.Debug
end

local function fields(a, b, c)
	local f = {}
	local keys = Enum.AnalyticsCustomFieldKeys
	if a ~= nil then f[keys.CustomField01.Name] = tostring(a) end
	if b ~= nil then f[keys.CustomField02.Name] = tostring(b) end
	if c ~= nil then f[keys.CustomField03.Name] = tostring(c) end
	return f
end

local function throttled(player, key, seconds)
	local k = tostring(player.UserId) .. ":" .. key
	local now = os.clock()
	if T.Throttle[k] and now - T.Throttle[k] < seconds then return true end
	T.Throttle[k] = now
	return false
end

-- review: no Parent check — leave-time events (session length, sack returned) fire while the Player is being removed
function TelemetryService.Custom(player, name, value, a, b, c)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then return end
	value = tonumber(value) or 1
	if debugOn() then
		print(string.format("[Metrics] %s = %s (%s, %s, %s)", tostring(name), tostring(value), tostring(a), tostring(b),
			tostring(c)))
	end
	local svc = analytics()
	if not svc then return end
	pcall(svc.LogCustomEvent, svc, player, name, value, fields(a, b, c))
end

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

local function telemetryOf(data)
	if type(data.Telemetry) ~= "table" then data.Telemetry = {} end
	return data.Telemetry
end

-- onboarding funnel step (a Config.Analytics.Steps name): each step at most once per account, whatever order they
-- happen in. The step number is its place in the list.
function TelemetryService.Step(player, name)
	local index = table.find(T.Steps, name)
	local data = index and getData(player)
	if not data then return end
	local tel = telemetryOf(data)
	if type(tel.Funnel) ~= "table" then tel.Funnel = {} end
	if tel.Funnel[name] then return end
	tel.Funnel[name] = true
	if debugOn() then print(string.format("[Metrics] step %d %s", index, name)) end
	local svc = analytics()
	if not svc then return end
	pcall(svc.LogOnboardingFunnelStepEvent, svc, player, index, name)
end

------------------------------------------------------------------ per-session state
local function newSession(player, data)
	local tel = telemetryOf(data)
	local before = math.floor(num(tel.Sessions))
	tel.Sessions = before + 1
	T.Session[player] = {
		Returning = before >= 1, -- emergent_play_watch §2: the first actions of a player who came back
		Acts = 0,
		Windows = {}, -- [window id] = true (WindowOpen once a session)
		AwayMin = 0,
		GoldIn = {}, -- [source] = gold
		GoldOut = {}, -- [sink] = gold
		FriendMin = 0,
		Together = 0,
		WithFriend = 0,
		ZoneMin = {}, -- [zone id] = minutes
		Rankings = {}, -- [board] = views
		Streak = { Kind = nil, N = 0, Logged = {} },
	}
end

local function session(player)
	return T.Session[player]
end

-- emergent_play_watch §2: a returning player's first Config.Analytics.ReturnActs actions (a zone entered, a window opened)
local function returnAct(player, kind, id)
	local s = session(player)
	if not s or not s.Returning or s.Acts >= math.floor(num(A.ReturnActs, 3)) then return end
	s.Acts += 1
	TelemetryService.Custom(player, "ReturnAct", s.Acts, kind, id)
end

------------------------------------------------------------------ friends (IsFriendsWith, cached per pair)
local function pairKey(a, b)
	local x, y = a.UserId, b.UserId
	if x > y then x, y = y, x end
	return tostring(x) .. ":" .. tostring(y)
end

local function isFriend(a, b)
	return T.Friend[pairKey(a, b)] == true
end

-- the new player against everyone already here (the later joiner checks the pair), at most FriendCheckMax web calls
local function checkFriends(player)
	local done = 0
	for _, other in S.PlayerService.GetReadyPlayers() do
		if done >= math.floor(num(A.FriendCheckMax, 12)) or player.Parent == nil then break end
		if other ~= player and other.Parent ~= nil and T.Friend[pairKey(player, other)] == nil then
			done += 1
			local ok, friends = pcall(player.IsFriendsWith, player, other.UserId)
			T.Friend[pairKey(player, other)] = ok and friends == true
		end
	end
end

------------------------------------------------------------------ join / leave
local function watch(player, attr, fn)
	T.Conns[player] = T.Conns[player] or {}
	table.insert(T.Conns[player], player:GetAttributeChangedSignal(attr):Connect(function()
		local ok, err = pcall(fn, player:GetAttribute(attr))
		if not ok then Util.Warn("TelemetryService", attr .. ": " .. tostring(err)) end
	end))
end

local function onReady(player, data)
	T.JoinedAt[player] = os.clock()
	newSession(player, data)
	-- catch up the steps a returning player already passed (never logs the same step twice)
	local Step = TelemetryService.Step
	if data.IntroSeen == true then Step(player, "IntroDone") end
	if data.Faction ~= "None" then Step(player, "Faction") end
	if data.ClassChosen == true then Step(player, "Class") end
	local tut = num(data.TutorialStep)
	if tut >= 1 then Step(player, "FirstMissionAccept") end
	if tut >= 2 then Step(player, "MeadowArrive") end -- 2 = arrived in the meadow, 99 = claimed
	if num(data.TotalKills) > 0 then
		Step(player, "FirstHit")
		Step(player, "FirstKill")
	end
	if tut == 99 then Step(player, "FirstMissionDone") end
	if data.BlacksmithVisited == true then Step(player, "ForgeArrive") end
	if num(data.WeaponOwnedMask) > 0 then Step(player, "FirstWeapon") end -- A23-34: any weapon owned
	local done = type(data.Story) == "table" and type(data.Story.Done) == "table" and data.Story.Done or {}
	if done.M1_3 or done.S0 then Step(player, "FirstSkillHit") end -- both need a manual skill that hit a monster
	if data.AutoCombatUnlocked == true then Step(player, "AutoUnlocked") end
	if num(data.Level, 1) >= 10 then Step(player, "Level10") end
	for _, c in T.Conns[player] or {} do c:Disconnect() end
	T.Conns[player] = nil
	watch(player, "IntroSeen", function(v) if v == true then Step(player, "IntroDone") end end)
	watch(player, "ClassChosen", function(v) if v == true then Step(player, "Class") end end)
	watch(player, "TutorialStep", function(v)
		-- accepting the guide mission sets TutorialStep 1 (2 = arrived in the meadow, 99 = first mission claimed)
		if num(v) >= 1 then Step(player, "FirstMissionAccept") end
		if num(v) >= 2 then Step(player, "MeadowArrive") end
		if v == 99 then Step(player, "FirstMissionDone") end
	end)
	watch(player, "BlacksmithVisited", function(v) if v == true then Step(player, "ForgeArrive") end end)
	watch(player, "WeaponOwnedMask", function(v) if num(v) > 0 then Step(player, "FirstWeapon") end end)
	watch(player, "AutoCombatUnlocked", function(v) if v == true then Step(player, "AutoUnlocked") end end)
	watch(player, "Level", function(v) if num(v, 1) >= 10 then Step(player, "Level10") end end)
	watch(player, "AutoCombatEnabled", function(v)
		if not throttled(player, "auto", 10) then TelemetryService.Custom(player, v == true and "AutoOn" or "AutoOff", 1) end
	end)
	task.spawn(function()
		local ok, err = pcall(checkFriends, player)
		if not ok then Util.Warn("TelemetryService", "friends: " .. tostring(err)) end
	end)
end

local function bucketOf(minutes)
	return minutes < 5 and "0-5" or minutes < 15 and "5-15" or minutes < 30 and "15-30" or minutes < 60 and "30-60" or "60+"
end

local function onLeaving(player)
	local Custom = TelemetryService.Custom
	local joined = T.JoinedAt[player]
	if joined then
		local minutes = math.floor((os.clock() - joined) / 60)
		Custom(player, "SessionMinutes", minutes, bucketOf(minutes))
	end
	local failAt = T.EnhanceFailAt[player]
	if failAt and os.clock() - failAt <= num(A.EnhanceFailLeave, 300) then
		Custom(player, "EnhanceFailLeave", math.floor(os.clock() - failAt))
	end
	local s = session(player)
	if s then
		if s.AwayMin > 0 then Custom(player, "AutoAwayMinutes", s.AwayMin) end
		for source, gold in s.GoldIn do Custom(player, "GoldIn", gold, source) end
		for sink, gold in s.GoldOut do Custom(player, "GoldOut", gold, sink) end
		Custom(player, "FriendMinutes", s.FriendMin, s.FriendMin > 0 and "WithFriend" or "Solo")
		if s.Together > 0 then Custom(player, "KillsTogether", s.Together) end
		if s.WithFriend > 0 then Custom(player, "KillsWithFriend", s.WithFriend) end
		for zone, minutes in s.ZoneMin do Custom(player, "ZoneMinutes", minutes, zone) end
		for board, views in s.Rankings do Custom(player, "RankingViews", views, board) end
	end
	T.JoinedAt[player], T.MeadowAt[player], T.EnhanceFailAt[player], T.Session[player] = nil, nil, nil, nil
	T.FirstHit[player] = nil
	for _, c in T.Conns[player] or {} do c:Disconnect() end
	T.Conns[player] = nil
	for k in T.Throttle do
		if string.sub(k, 1, #tostring(player.UserId) + 1) == tostring(player.UserId) .. ":" then T.Throttle[k] = nil end
	end
end

------------------------------------------------------------------ handlers
-- BB38: c->s "UiMetric"(id): a window the client opened (Config.Analytics.UiIds), once a session per window
local function onUiMetric(player, ...)
	if select("#", ...) ~= 1 then return end
	local id = ...
	if type(id) ~= "string" or not T.UiIds[id] then return end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "UiMetric", num(Config.RateLimits.UiMetric, 2)) then return end
	local s = session(player)
	if not s or s.Windows[id] then return end
	s.Windows[id] = true
	TelemetryService.Custom(player, "WindowOpen_" .. id, 1)
	returnAct(player, "Window", id)
end

local function onKilled(player, info)
	if type(info) ~= "table" then return end
	TelemetryService.Step(player, "FirstKill") -- A23-68 #5
	local at = T.MeadowAt[player]
	if at and at > 0 then
		T.MeadowAt[player] = -1 -- once per session
		TelemetryService.Custom(player, "RookieFirstKillSeconds", math.floor(os.clock() - at), info.Kind)
	end
	local s = session(player)
	if s then
		-- 검수 2026-10-07 friends: a kill earned with others (MonsterService Party / Others)
		if num(info.Party, 1) >= 2 then s.Together += 1 end
		if type(info.Others) == "table" then
			for _, o in info.Others do
				if typeof(o) == "Instance" and isFriend(player, o) then
					s.WithFriend += 1
					break
				end
			end
		end
		-- emergent_play_watch §2: the same kind again and again (once a session per kind)
		local st = s.Streak
		if info.Kind == st.Kind then st.N += 1 else st.Kind, st.N = info.Kind, 1 end
		if st.N >= math.floor(num(A.SameKindStreak, 30)) and not st.Logged[st.Kind] then
			st.Logged[st.Kind] = true
			TelemetryService.Custom(player, "SameKindStreak", st.N, st.Kind)
		end
	end
	-- the crown-shard trial "3 slimes with basic attacks only" (S0 step 2) did not count this slime: a skill hit it
	local data = getData(player)
	local story = data and data.Story
	local s0 = type(story) == "table" and type(story.Subs) == "table" and story.Subs.S0
	-- only while trial "a" (basic-attack slimes) is still open; a skill kill during trial "b" is expected
	local trialA = 3
	pcall(function() trialA = Config.StoryQuests.Defs.S0.Steps[2].Obj.List[1].Count end)
	local doneA = type(s0) == "table" and type(s0.T) == "table" and tonumber(s0.T.a) or 0
	if type(s0) == "table" and s0.St == 2 and doneA < trialA
		and Config.QuestKind(info.Kind) == "Slime" -- review C-9: a pumpkin slime counts as a slime there too
		and info.SkillHit == true and not throttled(player, "trialmiss", 300) then
		TelemetryService.Custom(player, "CrownTrialMiss", 1, "SkillHit", info.Kind)
	end
end

-- every minute: auto combat while away, minutes with a friend here, minutes per zone
local function minuteTick()
	local ready = S.PlayerService.GetReadyPlayers()
	for _, p in ready do
		local s = session(p)
		if s and p.Parent then
			if p:GetAttribute("AutoCombatEnabled") == true then
				local own = math.max(num(S.PlayerService.GetLastOwnActive(p)), T.JoinedAt[p] or 0)
				if os.clock() - own >= num(A.AwayAfter, 300) then s.AwayMin += 1 end
			end
			for _, q in ready do
				if q ~= p and q.Parent and isFriend(p, q) then
					s.FriendMin += 1
					break
				end
			end
			local zone = p:GetAttribute("ZoneId")
			if type(zone) == "string" and Config.Zones[zone] then s.ZoneMin[zone] = (s.ZoneMin[zone] or 0) + 1 end
		end
	end
end

local function connect(service, signal, fn)
	local svc = S[service]
	local sig = svc and svc[signal]
	if type(sig) == "table" and type(sig.Connect) == "function" then
		sig:Connect(function(...)
			local ok, err = pcall(fn, ...)
			if not ok then Util.Warn("TelemetryService", service .. "." .. signal .. ": " .. tostring(err)) end
		end)
	end
end

function TelemetryService.Init(registry)
	S = registry
end

function TelemetryService.Start()
	Net.Get("UiMetric").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onUiMetric, player, ...)
		if not ok then Util.Warn("TelemetryService", "UiMetric: " .. tostring(err)) end
	end)
	connect("PlayerService", "PlayerReady", onReady)
	connect("PlayerService", "PlayerLeaving", onLeaving)
	connect("FactionService", "FactionChanged", function(player, newFaction)
		if newFaction and newFaction ~= "None" then TelemetryService.Step(player, "Faction") end
	end)
	-- BB14: the KO screen's cause (Player / Kaiju / Monster / Fall / Other), the first KO of an account
	connect("CombatService", "KnockedOut", function(player, by)
		local data = getData(player)
		if not data then return end
		local tel = telemetryOf(data)
		if tel.FirstDeath then return end
		tel.FirstDeath = true
		TelemetryService.Custom(player, "FirstDeath_" .. tostring(by), 1, player:GetAttribute("ZoneId"))
	end)
	connect("GrudgeService", "SackResolved", function(thief, outcome, total)
		local name = ({ Paid = "Kept", Avenged = "Avenged", Returned = "Returned" })[outcome]
		if name then TelemetryService.Custom(thief, "Plunder_" .. name, num(total)) end
	end)
	connect("LootService", "Enhanced", function(player, _tier, _before, _after, success)
		if success == false then T.EnhanceFailAt[player] = os.clock() end
	end)
	connect("SettingsService", "KeysChanged", function(player, changed)
		TelemetryService.Custom(player, "KeyRebind", num(changed, 1))
	end)
	connect("RankingService", "Viewed", function(player, board)
		local s = session(player)
		if s and type(board) == "string" then s.Rankings[board] = (s.Rankings[board] or 0) + 1 end
	end)
	-- 검수 2026-10-07 economy: where gold comes from and where it goes (per session sums, logged at leave)
	connect("ProgressionService", "GoldEarned", function(player, amount, source)
		local s = session(player)
		if s and type(source) == "string" then s.GoldIn[source] = (s.GoldIn[source] or 0) + math.max(0, num(amount)) end
	end)
	connect("ProgressionService", "GoldSpent", function(player, amount, sink)
		local s = session(player)
		if s and type(sink) == "string" then s.GoldOut[sink] = (s.GoldOut[sink] or 0) + math.max(0, num(amount)) end
	end)
	-- A23-68 #5: the first hit that landed, the first manual skill that hit a monster
	connect("CombatService", "MonsterHit", function(player)
		if T.FirstHit[player] then return end
		T.FirstHit[player] = true
		TelemetryService.Step(player, "FirstHit")
	end)
	connect("CombatService", "Released", function(player, info)
		if type(info) == "table" and info.Auto ~= true and num(info.MonstersHit) >= 1 then
			TelemetryService.Step(player, "FirstSkillHit")
		end
	end)
	connect("ZoneService", "ZoneChanged", function(player, newZone)
		if newZone == "SlimeMeadow" then TelemetryService.Step(player, "MeadowArrive") end
		if newZone == "SlimeMeadow" and T.MeadowAt[player] == nil and num(player:GetAttribute("Level"), 1) < 10 then
			T.MeadowAt[player] = os.clock()
		end
		if type(newZone) == "string" and Config.Zones[newZone] then returnAct(player, "Zone", newZone) end
	end)
	connect("MonsterService", "MonsterKilled", onKilled)
	task.spawn(function()
		while true do
			task.wait(60)
			local ok, err = pcall(minuteTick)
			if not ok then Util.Warn("TelemetryService", "minute: " .. tostring(err)) end
		end
	end)
	-- every 5 minutes: high levels farming the meadow, and the server's population / faction balance
	task.spawn(function()
		while true do
			task.wait(300)
			local ok, err = pcall(function()
				local ready = S.PlayerService.GetReadyPlayers()
				local halo, horns = 0, 0
				for _, p in ready do
					local f = p:GetAttribute("Faction")
					if f == "Halo" then halo += 1 elseif f == "Horns" then horns += 1 end
					if p:GetAttribute("ZoneId") == "SlimeMeadow" and num(p:GetAttribute("Level"), 1) >= 20 then
						TelemetryService.Custom(p, "HighLevelInMeadow", num(p:GetAttribute("Level")))
					end
				end
				if ready[1] then TelemetryService.Custom(ready[1], "ServerPopulation", #ready, halo, horns) end
			end)
			if not ok then Util.Warn("TelemetryService", "population: " .. tostring(err)) end
		end
	end)
	print("[TelemetryService] started")
end

return TelemetryService
]]></ProtectedString>
				<string name="ScriptGuid">{EBC09101-CDC1-4DBD-997C-13D0E802A995}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">TelemetryService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">00a781d6b8ab04140ad785ab00006373</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3031D5AAE2304B5A9B61950953364514">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- QuestService.luau : 3 quest slots (KST dailies first, then rolling extras), claim, daily chest, reroll,
-- vacation bonus and quest-list publishing to the owner only via the "Quests" remote (TECH_SPEC §4.20, CR-L50),
-- plus persistent first-hunt guidance (2026-10-04: no personal monster in a safe town)
-- and the faction-filtered quest pool (A6 Neutral).
-- data.Quests is mutated directly (documented exception); every other persisted stat goes through SetStat/AddStat.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "QuestService"

local M = {}

local S = nil

local PUBLISH_INTERVAL = 0.5
local TUTORIAL_TICK = 1
local WARN_THROTTLE = 10
local PROGRESS_EPS = 1e-6 -- Kill/Golden progress is fractional (killWeight)

------------------------------------------------------------------ tutorial constants (A4) — all from Config.Tutorial
local TUT_CFG = Config.Tutorial
local TUT_ID = TUT_CFG.QuestId -- claim id (N1) and quest-list Id of the pinned tutorial entry
local TUT_KIND = "Tutorial"
local STEP_WELCOME = TUT_CFG.Steps.Kill -- 0: faction guide dialogue; only explicit acceptance advances
local STEP_GUIDE = TUT_CFG.Steps.Guide -- 1: HUD guide beam to GuideZone
local STEP_QUEST = TUT_CFG.Steps.Quest -- 2: pinned tutorial quest
local TUT_DONE = TUT_CFG.Steps.Done -- 99
local TUT_TARGET = TUT_CFG.QuestKills
local TUT_GOLD = TUT_CFG.QuestRewardGold
local TUT_XP = TUT_CFG.QuestRewardXP or 0
local TUT_TEXT = Config.Plural(string.format(TUT_CFG.QuestText, TUT_TARGET))
local TUT_ZONE = TUT_CFG.GuideZone
local TUT_MESSAGES = TUT_CFG.Text or {}
local TUT_SHORT = TUT_CFG.ShortNames or {} -- 검수 2026-10-07: each row's ShortName (the phone HUD quest row, <= 14)
local TUT_START_TEXT = TUT_MESSAGES.QuestStart or "First mission: %s! (Reward: %s gold)" -- (TUT_TEXT, gold)
local TUT_READY_TEXT = TUT_MESSAGES.QuestReady or "First mission done! Press [Claim]."
local TUT_CLAIMED_TEXT = TUT_MESSAGES.Claimed or "First mission reward +%s gold! Check your next goal."
local RESUME_DELAY_ON_SPAWN = 1
local RESUME_DELAY_ON_CLASS = 0.5

-- kills that count for the tutorial quest: monsters living in Slime Meadow (looked up with Config.QuestKind(kind), so a
-- seasonal kind counts as the kind it stands in for)
local TUTORIAL_KINDS = {}
for id, def in Config.MonsterTypes do
	if type(def) == "table" and def.Zone == TUT_ZONE then
		TUTORIAL_KINDS[id] = true
	end
end

------------------------------------------------------------------ templates
local TEMPLATE_BY_ID = {}
for _, t in Config.Quests.Templates do
	TEMPLATE_BY_ID[t.Id] = t
end

-- A6: quests that need a Halo/Horns side (PvP, plunder, bounty, goose tug, kaiju). Neutral and "None" never get them.
local SIDE_ONLY_IDS = { Hunt = true, Plunder = true, Goose = true, Bounty = true, Kaiju = true }

-- A23-14: short, different Lv1-9 dailies and their smaller rewards (nil table = old behaviour everywhere)
local NEWBIE = Config.Quests.Newbie
-- E12 (quest_volume §3-4): the Goblin Woods band Lv10-24 works the same way (Lv25+ keeps the template dailies)
local WOODS = Config.Quests.Woods

------------------------------------------------------------------ state (session only)
local dirty = {} -- [Player] = true -> quest list republished by the publish loop
local lastSent = {} -- [Player] = last JSON fired on the "Quests" remote (CR-L50: fire only on change)
local rerollReadyAt = {} -- [Player] = server time
local lastLoopWarn = {} -- [loopName] = os.clock()
local welcomeShown = {} -- [Player] = true after this session's first automatic guide dialogue
-- F10-4: [Player] = os.clock() when this server first saw the first mission at 5/5 unclaimed (safety-net timer)
local TUT_READY_AT = {}
local claimTutorial -- defined with the claim code below; the tutorial loop (safety net) calls it

------------------------------------------------------------------ helpers
local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default or 0
end

local function loopWarn(loopName, err)
	local now = os.clock()
	local last = lastLoopWarn[loopName]
	if last and now - last < WARN_THROTTLE then return end
	lastLoopWarn[loopName] = now
	Util.Warn(TAG, loopName .. ": " .. tostring(err))
end

local function connectSignal(serviceName, signalName, fn)
	local service = S and S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

local function getData(player)
	if S == nil or player == nil then return nil end
	if not S.PlayerService.IsReady(player) then return nil end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return nil end
	return data
end

local function getFaction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then return "None" end
	return f
end

local function getLevel(data)
	return math.max(1, math.floor(num(data and data.Level, 1)))
end

-- CR-M6: unclaimed rewards never pay more than the CURRENT level's value (free class change / rebirth to Lv1).
-- After a level-up the stored value is the smaller one, so it is paid unchanged.
local function capTo(g, x, capG, capX)
	return math.min(g, math.floor(num(capG))), math.min(x, math.floor(num(capX)))
end

local function isSlotIndex(v)
	return type(v) == "number" and v == v and v % 1 == 0 and v >= 1 and v <= Config.Quests.Slots
end

local function isValidQuest(q)
	return type(q) == "table"
		and type(q.Id) == "string" and TEMPLATE_BY_ID[q.Id] ~= nil
		and (q.Kind == "Daily" or q.Kind == "Extra")
		and type(q.Target) == "number" and q.Target == q.Target and q.Target > 0
		and type(q.Progress) == "number" and q.Progress == q.Progress
		and type(q.RewardGold) == "number" and type(q.RewardXP) == "number"
		and type(q.Text) == "string"
end

local function isComplete(q)
	return q.Progress >= q.Target
end

local function othersExcept(quests, index)
	local out = {}
	for i, q in quests do
		if i ~= index and type(q) == "table" then
			table.insert(out, q)
		end
	end
	return out
end

local function isSide(faction)
	return faction == "Halo" or faction == "Horns"
end

-- A23-14: Lv1..Newbie.MaxLevel get the short newbie dailies and the smaller newbie chest
local function isNewbieLevel(level)
	return type(NEWBIE) == "table" and type(NEWBIE.Dailies) == "table" and #NEWBIE.Dailies > 0
		and level <= num(NEWBIE.MaxLevel, 0)
end

-- E12: the daily band of a level: Newbie (Lv1..Newbie.MaxLevel), Woods (Woods.MinLevel..MaxLevel) or nil (templates)
local function bandAt(level)
	if isNewbieLevel(level) then return NEWBIE end
	if type(WOODS) == "table" and type(WOODS.Dailies) == "table" and #WOODS.Dailies > 0
		and level >= num(WOODS.MinLevel, math.huge) and level <= num(WOODS.MaxLevel, 0) then
		return WOODS
	end
	return nil
end

-- full-set chest at one level; Lv1-9 pays Newbie.ChestMinutes of hunting instead of Daily's (Lv10-24: Woods')
local function chestAt(level)
	if isNewbieLevel(level) then
		return Config.HuntValue(level, num(NEWBIE.ChestMinutes, Config.Daily.ChestMinutes))
	end
	local band = bandAt(level)
	if band then return Config.HuntValue(level, num(band.ChestMinutes, Config.Daily.ChestMinutes)) end
	return Config.DailyChestReward(level)
end

-- the chest pays the SMALLER of the current level's chest and the chest of the level the day's dailies were generated
-- at (genLevel, saved as data.DailyLevel; 0 = unknown -> current only). A Lv9 player who levels to 10 before the last
-- claim therefore gets the newbie chest (144/240), not the Lv10 one (1920/3360); a reborn player never gets more either.
local function chestReward(level, genLevel)
	local g, x = chestAt(level)
	genLevel = math.floor(num(genLevel))
	if genLevel >= 1 and genLevel ~= level then
		local gg, gx = chestAt(math.min(genLevel, Config.Levels.MaxLevel))
		g, x = math.min(g, gg), math.min(x, gx)
	end
	return g, x
end

local function templateFitsFaction(t, faction)
	if t.Faction ~= nil and t.Faction ~= faction then return false end
	if not isSide(faction) and (t.PvP or SIDE_ONLY_IDS[t.Id]) then return false end
	return true
end

-- a template the player can do now: its faction rule, and A23-71 the skill row ("Release") only once a skill is learned
local function templateFitsNow(t, faction, data)
	if not templateFitsFaction(t, faction) then return false end
	return t.Id ~= "Release" or (data ~= nil and Config.SkillLearned(data.SkillSlots, data.Level, data.Rebirths))
end

local function pickWeighted(list)
	local total = 0
	for _, t in list do
		total += math.max(0, num(t.Weight))
	end
	if total <= 0 then
		return list[Util.Random:NextInteger(1, #list)]
	end
	local r = Util.Random:NextNumber() * total
	for _, t in list do
		local w = math.max(0, num(t.Weight))
		if w > 0 then
			if r < w then return t end
			r -= w
		end
	end
	return list[#list]
end

------------------------------------------------------------------ quest generation
-- E11: with the job boards on (Config.Board.Enabled) a slot that would get an extra quest stays empty ({ Kind = "Empty" }:
-- not listed, never rerolled, refilled by the next day's dailies); the boards take that role. Off: extras as before.
local function boardOn()
	return type(Config.Board) == "table" and Config.Board.Enabled == true
end

local function isEmptySlot(q)
	return type(q) == "table" and q.Kind == "Empty"
end

-- others = quests in the OTHER slots (used for the PvP limit and the "different template" preference)
local function newQuest(player, kind, others)
	local data = S.PlayerService.GetData(player)
	local level = getLevel(data)
	local faction = getFaction(player)
	-- A23-14: Lv1-9 dailies come from Config.Quests.Newbie.Dailies (rows reuse a template Id); E12: Lv10-24 from
	-- Config.Quests.Woods.Dailies the same way (band = the rows' table); everything else as before
	local newbie = kind == "Daily" and isNewbieLevel(level)
	local band = (kind == "Daily" and bandAt(level)) or nil
	local mainId = Config.ZoneMainMonster[Config.QuestZoneForLevel(level)]
	-- the monster a row's quest counts (its Unit): the zone's unit monster, or a band row's Monster (e.g. BigSlime)
	local function unitOf(row)
		if band and type(row.Monster) == "string" and type(Config.MonsterTypes[row.Monster]) == "table" then return row.Monster end
		return mainId
	end

	local otherIds, otherKeys, otherPvP = {}, {}, 0
	for _, q in others or {} do
		if type(q) == "table" and type(q.Id) == "string" then
			otherIds[q.Id] = true
			otherKeys[q.Id .. "|" .. tostring(q.Unit)] = true
			local ot = TEMPLATE_BY_ID[q.Id]
			if ot and ot.PvP then otherPvP += 1 end
		end
	end

	local pvpAllowed = level >= Config.Quests.PvPMinLevel
		and otherPvP < (Config.Quests.MaxPvPQuests or 1)
		and not S.PvPService.IsRookie(player)

	-- rows = templates, or A23-14 / E12 band rows ({ Id = template Id, Targets, Monster?, Strict? }). A new goal first
	-- (another template), else (A23-71 S9 / D3) at least another monster: Lv1-4 has no skill row, so its set is always
	-- King Slime 3 + Slime 12-15 + Gold, never the King Slime row twice; else anything that fits
	local candidates, preferred, otherUnit = {}, {}, {}
	for _, row in (if band then band.Dailies else Config.Quests.Templates) do
		local rt = type(row) == "table" and TEMPLATE_BY_ID[row.Id]
		if rt and templateFitsNow(rt, faction, data) and (not rt.PvP or pvpAllowed) then
			table.insert(candidates, row)
			if not otherIds[row.Id] then
				table.insert(preferred, row)
			elseif not otherKeys[row.Id .. "|" .. tostring(unitOf(row))] then
				table.insert(otherUnit, row)
			end
		end
	end
	local pool = (#preferred > 0 and preferred) or (#otherUnit > 0 and otherUnit) or candidates
	local row
	if #pool > 0 then
		row = pickWeighted(pool)
	else
		newbie, band = false, nil -- nothing fits: the old Kill daily (sizes and reward) is the safe fallback
		row = TEMPLATE_BY_ID.Kill or Config.Quests.Templates[1]
	end
	local t = TEMPLATE_BY_ID[row.Id] or row

	local unitsList
	if band then
		unitsList = row.Targets
	else
		unitsList = (kind == "Daily" and t.DailyUnits) or t.Units
	end
	if type(unitsList) ~= "table" or #unitsList == 0 then unitsList = { 1 } end
	local units = num(unitsList[Util.Random:NextInteger(1, #unitsList)], 1)

	local main = Config.MonsterTypes[mainId]
	-- the monster a Kill/Golden quest counts: the zone's unit monster, or the newbie row's Monster (e.g. BigSlime)
	local unitId = unitOf(row)
	local unitDef = Config.MonsterTypes[unitId]
	local target = units -- band Targets are exact (a Gold row already says gold)
	if t.Id == "Gold" and not band then
		target = units * main.Gold
	end
	target = math.max(1, math.floor(target))

	local rewardGold, rewardXP
	if kind == "Daily" then
		if newbie then
			rewardGold, rewardXP = Config.HuntValue(level, num(NEWBIE.RewardMinutes, Config.Daily.QuestMinutes))
		elseif band then
			rewardGold, rewardXP = Config.HuntValue(level, num(band.RewardMinutes, Config.Daily.QuestMinutes)) -- E12
		else
			rewardGold, rewardXP = Config.DailyQuestReward(level)
		end
	else
		local per = num(t.RewardPerUnit, 1)
		local mult = Config.Quests.ExtraRewardMult
		rewardGold = math.floor(units * main.Gold * per * mult)
		rewardXP = math.floor(units * main.XP * per * mult)
	end

	local text
	if t.Id == "Gold" then
		text = string.format(t.Text, tostring(target)) -- CR-L31: exact number (FormatNumber rounds to "3.2K")
	elseif t.Id == "Kill" or t.Id == "Golden" then
		text = string.format(t.Text, tostring(unitDef.Short or unitDef.Name), target) -- CR-M27: (monster name, target)
	else
		text = string.format(t.Text, target)
	end
	text = Config.Plural(text) -- "Join the Golden Goose tug 1 time"

	local progress = 0
	if target >= 5 then
		progress = math.floor(target * Util.Random:NextNumber(Config.Quests.EndowedMin, Config.Quests.EndowedMax))
	end

	return {
		Id = t.Id,
		Kind = kind,
		Target = target,
		Progress = progress,
		RewardGold = math.floor(num(rewardGold)),
		RewardXP = math.floor(num(rewardXP)),
		Text = text,
		MinStacks = t.MinStacks,
		Unit = unitId, -- Kill/Golden progress is measured in kills of this monster (see killWeight)
		Strict = (band and row.Strict == true) or nil, -- A23-14 / E12: only Unit (or stronger) kills count, 1 each
	}
end

-- exactly Config.Quests.Slots valid quests; missing/invalid entries become fresh extras
local function ensureSlots(player, data)
	local slots = Config.Quests.Slots
	local old = (type(data.Quests) == "table") and data.Quests or {}
	local fixed = {}
	for i = 1, slots do
		local q = old[i]
		if isValidQuest(q) then
			q.Progress = math.clamp(q.Progress, 0, q.Target)
			if q.Id == "Release" then
				q.MinStacks = nil
				q.Text = Config.Plural(string.format(TEMPLATE_BY_ID.Release.Text, q.Target))
			end
			q.Text = Config.Plural(q.Text) -- saves from before 2026-10-07 said "tug 1 times"
			fixed[i] = q
		end
	end
	for i = 1, slots do
		if not fixed[i] then
			local others = {}
			for j = 1, slots do
				if j ~= i and fixed[j] then table.insert(others, fixed[j]) end
			end
			fixed[i] = boardOn() and { Kind = "Empty" } or newQuest(player, "Extra", others) -- E11
		end
	end
	data.Quests = fixed
end

-- unfinished quests the player cannot do now (another side's, or A23-71 a skill row before the first skill) are remade
local function remakeUnfit(player, data, faction)
	if type(data.Quests) ~= "table" then return end
	local quests = data.Quests
	for i = 1, #quests do
		local q = quests[i]
		if isValidQuest(q) and not isComplete(q) and not templateFitsNow(TEMPLATE_BY_ID[q.Id], faction, data) then
			local nq = newQuest(player, q.Kind, othersExcept(quests, i))
			if q.Kind == "Daily" then
				-- CR-L12: a remade daily keeps the reward it had (a rebirth must not shrink it to Lv1 here;
				-- claiming caps it to the current level anyway: CR-M6)
				nq.RewardGold = math.max(nq.RewardGold, math.floor(num(q.RewardGold)))
				nq.RewardXP = math.max(nq.RewardXP, math.floor(num(q.RewardXP)))
			end
			quests[i] = nq
			dirty[player] = true
		end
	end
end

------------------------------------------------------------------ tutorial (A4 / A5)
local function getStep(player)
	local data = getData(player)
	if not data then return TUT_DONE end
	local step = data.TutorialStep
	if type(step) ~= "number" or step ~= step then return TUT_DONE end
	return step
end

-- A saved counter, not a session cache: 4/5 and unclaimed 5/5 survive a normal save/rejoin.
-- A23-34: true when this save owns tier 1, the first weapon (saves from before A23-34 always do)
local function hasFirstWeapon(data)
	return type(data) == "table" and bit32.btest(math.floor(num(data.WeaponOwnedMask, 0)), 1)
end

local function getTutorialKills(data)
	return math.clamp(math.floor(num(data and data.TutorialKills)), 0, TUT_TARGET)
end

local function setStep(player, step)
	if not getData(player) then return end
	local previous = getStep(player)
	S.PlayerService.SetStat(player, "TutorialStep", step)
	dirty[player] = true -- step 0/1 guidance is published too, even before there is a kill quest
	-- defensive mirror in case TutorialStep is missing from Config.Data.Mirrored
	if player:GetAttribute("TutorialStep") ~= step then
		player:SetAttribute("TutorialStep", step)
	end
	if step == STEP_GUIDE then
		if S.ZoneService.GetZoneId(player) == TUT_ZONE then
			setStep(player, STEP_QUEST) -- already standing in the meadow
		end
	elseif step == STEP_QUEST and previous ~= STEP_QUEST then
		Net.Notify(player, string.format(TUT_START_TEXT, TUT_TEXT, Util.FormatNumber(TUT_GOLD)), "good")
	end
end

local function canWelcome(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players
		or not Util.IsAlive(player) then return false end
	local data = getData(player)
	local welcome = TUT_CFG.Welcome
	return data ~= nil and data.ClassChosen == true and Config.Classes[data.Class] ~= nil
		and getStep(player) == STEP_WELCOME and type(welcome) == "table"
		and type(welcome[getFaction(player)]) == "table"
end

local function openWelcome(player)
	if not canWelcome(player) then return end
	Net.Get("OpenPanel"):FireClient(player, "Welcome")
	welcomeShown[player] = true
end

local function onRequestTutorial(player, ...)
	if select("#", ...) ~= 0 or not canWelcome(player) then return end
	if not Util.RateLimit(player, "RequestTutorial", TUT_CFG.WelcomeRate or 0.5) then return end
	openWelcome(player)
end

-- A23-9: the client reports the first-time opening ended; only the server writes the saved flag
local function onIntroSeen(player, ...)
	if select("#", ...) ~= 0 or not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "IntroSeen", 1) then return end
	local data = getData(player)
	if not data or data.IntroSeen == true then return end
	S.PlayerService.SetStat(player, "IntroSeen", true)
end

-- A23-68 #1: AcceptTravelSeconds after [Accept] the player is moved to the meadow entrance (an instant Travel: the
-- usual level / kaiju / sack / stars / combat rules still refuse it, and the HUD guide beam stays the way there).
-- Contract with game dev 1 (client fade): Fx "Travel" { UserId, To, T } at the accept, Fx "TravelDone" { UserId } when
-- the move ran (or was skipped); MoveLockUntil (server time) refuses swings and skills in between (CombatService)
local function travelToMeadow(player, character)
	if player.Parent ~= Players or Util.GetCharacter(player) ~= character or not Util.IsAlive(player) then return end
	if getStep(player) ~= STEP_GUIDE or S.ZoneService.GetZoneId(player) == TUT_ZONE then return end
	local ok, err = pcall(S.ZoneService.Travel, player, TUT_ZONE, true)
	if not ok then Util.Warn(TAG, "meadow travel: " .. tostring(err)) end
end

local function travelDone(player)
	if player.Parent ~= Players then return end
	player:SetAttribute("MoveLockUntil", 0)
	pcall(Net.Fx, player, "TravelDone", { UserId = player.UserId })
end

local function onAcceptTutorial(player, ...)
	if select("#", ...) ~= 0 or not canWelcome(player) then return end
	if not Util.RateLimit(player, "AcceptTutorial", TUT_CFG.WelcomeRate or 0.5) then return end
	welcomeShown[player] = true
	S.PlayerService.SetStat(player, "TutorialKills", 0) -- a fresh acceptance never inherits stale kills
	setStep(player, STEP_GUIDE) -- acceptance in the meadow can enter step 2, without crediting any kill
	local wait = tonumber(TUT_CFG.AcceptTravelSeconds) or 0
	if wait > 0 and getStep(player) == STEP_GUIDE then
		local character = Util.GetCharacter(player)
		player:SetAttribute("MoveLockUntil", Util.Now() + wait + 1.5) -- the client's fade lasts at most T + 1.5 s
		pcall(Net.Fx, player, "Travel", { UserId = player.UserId, To = TUT_ZONE, T = wait })
		task.delay(wait, function()
			local ok, err = pcall(travelToMeadow, player, character)
			if not ok then Util.Warn(TAG, "meadow travel: " .. tostring(err)) end
			travelDone(player)
		end)
	end
end

-- Restore existing accepted progress. Step 0 only opens dialogue; closing it never accepts a mission.
local function tryTutorial(player)
	local data = getData(player)
	if not data then return end
	local step = getStep(player)
	if step == TUT_DONE then
		-- The existing watchdog observes purchases and level changes; publish deduplicates identical JSON.
		dirty[player] = true
		return
	end
	if step == STEP_GUIDE then
		if S.ZoneService.GetZoneId(player) == TUT_ZONE then
			setStep(player, STEP_QUEST)
		end
		return
	end
	if step == STEP_QUEST then
		-- F10-4 safety net: a finished first mission is never left unpaid (the [받기] row stays the normal way)
		if getTutorialKills(data) >= TUT_TARGET then
			TUT_READY_AT[player] = TUT_READY_AT[player] or os.clock()
			if os.clock() - TUT_READY_AT[player] >= num(TUT_CFG.AutoClaimSeconds, 60) then
				claimTutorial(player, true)
			end
		else
			TUT_READY_AT[player] = nil
		end
		return
	end
	if step ~= STEP_WELCOME or welcomeShown[player] then return end
	openWelcome(player)
end

local function tutorialKill(player, info)
	local data = getData(player)
	if not data then return end
	local cur = getTutorialKills(data)
	if cur >= TUT_TARGET or not TUTORIAL_KINDS[Config.QuestKind(info.Kind)] or info.Personal == true
		or info.ZoneId ~= TUT_ZONE then return end
	cur += 1
	S.PlayerService.SetStat(player, "TutorialKills", cur)
	dirty[player] = true
	if cur >= TUT_TARGET then
		Net.Notify(player, string.format(TUT_READY_TEXT), "good")
	end
end

-- auto = the F10-4 safety net paid it (Tutorial.AutoClaimSeconds after 5/5 without a claim)
function claimTutorial(player, auto)
	if getStep(player) ~= STEP_QUEST then return end
	if getTutorialKills(getData(player)) < TUT_TARGET then return end
	-- A23-34: M1_1 (show the jelly to the smith, get the first weapon) needs a smithy visit made after this claim, as
	-- the Claimed line says: an anvil visit before the first mission does not hand the weapon over in the meadow. A save
	-- that already owns tier 1 (from before A23-34) gets the old lines and keeps its visit.
	local hasFirst = hasFirstWeapon(getData(player))
	if not hasFirst then S.PlayerService.SetStat(player, "BlacksmithVisited", false) end
	setStep(player, TUT_DONE) -- first, so it can never be paid twice
	TUT_READY_AT[player] = nil
	S.ProgressionService.AddBankGold(player, TUT_GOLD, "Quest")
	if TUT_XP > 0 then
		S.ProgressionService.AddXP(player, TUT_XP)
	end
	local text = auto and (TUT_MESSAGES.AutoClaimed or TUT_CLAIMED_TEXT) or TUT_CLAIMED_TEXT
	if hasFirst then
		text = auto and (TUT_MESSAGES.AutoClaimedArmed or text) or (TUT_MESSAGES.ClaimedArmed or text)
	end
	Net.Notify(player, string.format(text, Util.FormatNumber(TUT_GOLD)), "reward", auto and 6 or nil, "QuestDone")
end

-- A23-3: one fixed next-goal line after the blacksmith visit, from existing state only (no new reward).
local IRON_TIER = 3
local NEXT_ZONE = "GoblinWoods"
local hadNextGoal = {} -- [Player] = true while the pinned row shows a next goal (GuideDone toast on its end)
local function nextGoalText(data)
	local level = getLevel(data)
	local iron = Config.Weapons[IRON_TIER]
	local owned = math.floor(num(data.WeaponOwnedMask, 1))
	local hasIron = bit32.btest(owned, bit32.lshift(1, IRON_TIER - 1)) or num(data.WeaponTier, 1) >= IRON_TIER
	if iron and not hasIron then
		if level < iron.MinLevel then
			-- A23-71 D6 / S16: the first skill comes at the same level (Skills.Unlock.Q): one line for both
			local q = math.floor(num((Config.Skills.Unlock or {}).Q))
			if q == iron.MinLevel and TUT_MESSAGES.NextSkillIron
				and not Config.SkillLearned(data.SkillSlots, level, data.Rebirths) then
				return string.format(TUT_MESSAGES.NextSkillIron, iron.MinLevel, level), "SkillIron", iron.MinLevel
			end
			return string.format(TUT_MESSAGES.NextIronLevel, iron.MinLevel, level), "IronLevel", iron.MinLevel
		end
		local gold = math.floor(math.max(0, num(data.CarriedGold)) + math.max(0, num(data.BankGold)))
		return string.format(TUT_MESSAGES.NextIronGold, Util.FormatNumber(iron.Price), Util.FormatNumber(gold)), "IronGold"
	end
	local zone = Config.Zones[NEXT_ZONE]
	if zone and level < zone.MinLevel then
		return string.format(TUT_MESSAGES.NextZone, zone.MinLevel, tostring(zone.Name), level), "Zone", zone.MinLevel
	end
	return nil
end

-- ShortName of a next-goal row: Config.Tutorial.ShortNames[kind], "%d" = the level the goal needs
local function goalShort(kind, need)
	local short = TUT_SHORT[kind]
	if type(short) ~= "string" then return nil end
	local ok, text = pcall(string.format, short, need or 0)
	return ok and text or short
end

local function tutorialEntry(player, data)
	local step = getStep(player)
	local entry = {
		Id = TUT_ID, Kind = TUT_KIND, Pinned = true, TutorialStep = step,
		Progress = 0, Target = 1, RewardGold = 0, RewardXP = 0,
		CanClaim = false, ShowProgress = false,
	}
	if step == STEP_WELCOME then
		-- 3rd idea round #3: the guide by name (there is no guide NPC in the world to look for)
		local guide = TUT_CFG.Welcome and TUT_CFG.Welcome[getFaction(player)]
		local name = type(guide) == "table" and type(guide.Name) == "string" and guide.Name or "the Guide"
		entry.Text = string.format(TUT_MESSAGES.Welcome or "Tap here: first quest from %s", name)
		entry.ShortName = type(TUT_SHORT.Welcome) == "string" and string.format(TUT_SHORT.Welcome, name) or nil
	elseif step == STEP_GUIDE then
		entry.Text = TUT_MESSAGES.Travel or "Go to the Squishy Meadow · Menu > Travel > Squishy Meadow"
		entry.ShortName = TUT_SHORT.Travel
	elseif step == STEP_QUEST then
		entry.Progress, entry.Target = getTutorialKills(data), TUT_TARGET
		entry.Text = if entry.Progress >= TUT_TARGET then TUT_READY_TEXT else TUT_TEXT
		entry.ShortName = TUT_SHORT.Quest
		entry.RewardGold, entry.RewardXP = TUT_GOLD, TUT_XP
		entry.CanClaim, entry.ShowProgress = true, true
	elseif step == TUT_DONE and data.ClassChosen == true and getFaction(player) ~= "None" then
		if data.BlacksmithVisited ~= true then
			entry.Text = (hasFirstWeapon(data) and TUT_MESSAGES.VisitBlacksmithArmed or TUT_MESSAGES.VisitBlacksmith)
				or "Check the weapons · Crossroads Forge"
			entry.ShortName = TUT_SHORT.Forge
		else
			local text, kind, need = nextGoalText(data)
			if not text then return nil end
			entry.Text = text
			entry.ShortName = goalShort(kind, need)
			entry.NextGoal = true
			-- A23-48: which next goal this is ("SkillIron" (A23-71 S16) | "IronLevel" | "IronGold" | "Zone"), so clients
			-- never search the (now English) text for a word
			entry.GoalKind = kind
		end
	else
		return nil
	end
	return entry
end

------------------------------------------------------------------ publish
local function publish(player)
	dirty[player] = nil
	if player.Parent == nil then
		lastSent[player] = nil -- left: never fire to (or keep state for) a removed player
		hadNextGoal[player] = nil
		return
	end
	local data = getData(player)
	if not data then return end
	local list = {}
	local tutorial = tutorialEntry(player, data)
	-- after the first mission the story main row takes the pinned slot (the next-goal line stays the fallback)
	local story = S.StoryQuestService
	if getStep(player) == TUT_DONE and story and type(story.MainRow) == "function" then
		local okMain, main = pcall(story.MainRow, player, data)
		if okMain and main then tutorial = main end
	end
	if tutorial then table.insert(list, tutorial) end -- always first, never occupies/rerolls a daily slot
	if story and type(story.SubRows) == "function" then
		local okSubs, subs = pcall(story.SubRows, player, data)
		if okSubs and type(subs) == "table" then
			for _, row in subs do table.insert(list, row) end
		end
	end
	-- E11: the jobs carried from the boards (Kind "Job"; they pay when done, no [Claim])
	local board = S.BoardService
	if boardOn() and board and type(board.JobRows) == "function" then
		local okJobs, jobs = pcall(board.JobRows, player, data)
		if okJobs and type(jobs) == "table" then
			for _, row in jobs do table.insert(list, row) end
		end
	end
	-- the guide chain just ran out (iron weapon owned and Lv10 reached): say so once, then the row disappears
	local hasGoal = tutorial ~= nil and (tutorial.NextGoal == true or tutorial.Story ~= nil)
	if hadNextGoal[player] and not hasGoal and getStep(player) == TUT_DONE then
		Net.Notify(player, TUT_MESSAGES.GuideDone or "That's all from me! Now hunt and get stronger.", "good")
	end
	hadNextGoal[player] = hasGoal or nil
	if type(data.Quests) == "table" then
		-- CR-M6: dailies show what a claim pays now (stored reward capped to the current level; stored value kept)
		local capG, capX = Config.DailyQuestReward(getLevel(data))
		for i, q in ipairs(data.Quests) do
			if type(q) == "table" and not isEmptySlot(q) then
				local rg, rx = num(q.RewardGold), num(q.RewardXP)
				if q.Kind == "Daily" then
					rg, rx = capTo(math.floor(rg), math.floor(rx), capG, capX)
				end
				local tpl = TEMPLATE_BY_ID[q.Id]
				table.insert(list, {
					Id = tostring(q.Id),
					Kind = q.Kind,
					Text = tostring(q.Text),
					ShortName = tpl and tpl.ShortName or nil, -- 검수 2026-10-07: the phone HUD quest row
					-- CR-M27: Kill/Golden progress is fractional; sent floored to 1 decimal (0.43 -> 0.4)
					Progress = math.floor(num(q.Progress) * 10 + PROGRESS_EPS) / 10,
					Target = num(q.Target),
					RewardGold = rg,
					RewardXP = rx,
					Unit = type(q.Unit) == "string" and q.Unit or nil, -- Kill/Golden: the monster (row icon)
					Slot = i, -- N1: clients address quests by Slot, never by array index
				})
			end
		end
	end
	-- A23-68 #4: until the first [Claim] only the first mission's line shows; the others are kept but folded
	if TUT_CFG.FoldOthers == true and getStep(player) ~= TUT_DONE then
		for _, row in list do
			if row.Id ~= TUT_ID then row.Folded = true end
		end
	end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, list)
	if not ok then
		Util.Warn(TAG, "quest list encode failed: " .. tostring(json))
		return
	end
	-- CR-L50: owner-only remote instead of the QuestsJson attribute (which replicated to every client), fired only
	-- on change. Payload = the same JSON string the attribute held.
	if lastSent[player] == json then return end
	local okF, err = pcall(function()
		Net.Get("Quests"):FireClient(player, json)
	end)
	if okF then
		lastSent[player] = json
	else
		Util.Warn(TAG, "Quests fire failed: " .. tostring(err))
	end
end

------------------------------------------------------------------ progress & completion
local function payReward(player, gold, xp)
	if gold > 0 then
		S.ProgressionService.AddBankGold(player, gold, "Quest")
	end
	if xp > 0 then
		S.ProgressionService.AddXP(player, xp)
	end
end

-- bonus chest for the full set of dailies (claimed by hand, or completed by the midnight auto-pay: CR-M21).
-- genLevel = level the set was generated at (default data.DailyLevel; the midnight auto-pay passes the OLD day's)
local function payChest(player, data, genLevel)
	if genLevel == nil then genLevel = data.DailyLevel end
	local cg, cx = chestReward(getLevel(data), genLevel)
	cg, cx = math.floor(num(cg)), math.floor(num(cx))
	payReward(player, cg, cx)
	Net.Notify(player, string.format(Config.Text.DailyChest, Util.FormatNumber(cg), Util.FormatNumber(cx)), "reward", nil,
		"GoldPickup")
	if Util.Random:NextNumber() < Config.Daily.ChestTicketChance then
		local ok, err = pcall(S.MonetizationService.AddTickets, player, "Class", 1)
		if ok then
			Net.Notify(player, string.format(Config.Text.DailyChestTicket), "reward", nil, "None")
		else
			Util.Warn(TAG, "chest ticket failed: " .. tostring(err))
		end
	end
end

local function completeQuest(player, data, index, q)
	q.Progress = q.Target
	dirty[player] = true
	-- A23-3: before the first mission is accepted the dailies are folded on screen, so no "done" toasts either
	local quiet = getStep(player) == STEP_WELCOME
	if q.Kind == "Extra" then
		-- replace first so the finished quest can never be paid twice (E11 boards on: the slot stays empty)
		data.Quests[index] = boardOn() and { Kind = "Empty" } or newQuest(player, "Extra", othersExcept(data.Quests, index))
		payReward(player, math.floor(num(q.RewardGold)), math.floor(num(q.RewardXP)))
		if not quiet then
			Net.Notify(player, string.format(Config.Text.QuestDone, Util.FormatNumber(q.RewardGold)), "reward", nil, "QuestDone")
		end
	elseif not quiet then
		-- dailies stay in their slot until claimed
		Net.Notify(player, string.format(Config.Text.DailyReady), "good")
	end
end

-- Kill/Golden progress of one kill of monster `kind`, in units of the quest's monster (q.Unit, fixed at generation):
-- a weaker monster counts def.XP / unit.XP (never more than 1), so quests whose rewards were sized for the player's
-- level zone cannot be farmed on safe low-zone slimes (also not after a free class change or a rebirth).
-- Seasonal kinds count as Config.QuestKind(kind) (a pumpkin slime is a slime, a bat goblin a goblin).
local function killWeight(q, kind, level)
	kind = Config.QuestKind(kind)
	local unitId = q.Unit
	if type(unitId) ~= "string" or Config.MonsterTypes[unitId] == nil then
		unitId = Config.ZoneMainMonster[Config.QuestZoneForLevel(level)] -- quests saved before Unit existed
	end
	local unit = Config.MonsterTypes[unitId]
	local def = Config.MonsterTypes[kind]
	local strict = q.Strict == true -- A23-14 "왕 슬라임 3마리": a weaker monster counts 0, not a fraction
	if type(unit) ~= "table" or type(def) ~= "table" or num(unit.XP) <= 0 then
		return if strict and kind ~= unitId then 0 else 1
	end
	local w = math.clamp(num(def.XP) / unit.XP, 0, 1)
	if strict and w < 1 then return 0 end
	return w
end

-- amount: number, or function(q) -> number (per-quest amount); accept(q) optional filter
local function addProgress(player, questId, amount, accept)
	if type(amount) ~= "function" then
		amount = num(amount)
		if amount <= 0 then return end
	end
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return end
	local quests = data.Quests
	for i = 1, #quests do
		local q = quests[i]
		if type(q) == "table" and q.Id == questId and type(q.Progress) == "number" and type(q.Target) == "number"
			and q.Progress < q.Target and (accept == nil or accept(q)) then
			local add = if type(amount) == "function" then num(amount(q)) else amount
			if add > 0 then
				local progress = q.Progress + add
				if progress >= q.Target - PROGRESS_EPS then
					progress = q.Target -- fractional kill weights must never leave a quest at 49.9999 / 50
				end
				q.Progress = progress
				dirty[player] = true
				if q.Progress >= q.Target then
					completeQuest(player, data, i, q)
				end
			end
		end
	end
end

------------------------------------------------------------------ day check / vacation
local function runDayCheck(player)
	local data = getData(player)
	if not data then return end
	local today = Config.DayIndex(os.time())
	local dailyDay = math.floor(num(data.DailyDay))
	if dailyDay == today then return end

	-- build the fresh dailies first (no side effects yet)
	local fresh = {}
	for i = 1, Config.Quests.Slots do
		fresh[i] = newQuest(player, "Daily", fresh)
	end

	-- completed but unclaimed dailies of the old day are paid automatically
	local toPay = {}
	if type(data.Quests) == "table" then
		for _, q in data.Quests do
			if isValidQuest(q) and q.Kind == "Daily" and isComplete(q) then
				table.insert(toPay, q)
			end
		end
	end

	-- CR-M21: dailies of the old day that count as done = claimed ones + the ones auto-paid below
	local slots = Config.Quests.Slots
	local prevClaims = math.clamp(math.floor(num(data.DailyClaims)), 0, slots)
	local claims = math.min(slots, prevClaims + #toPay)
	-- the old day's dailies were generated at this level (0 = unknown save -> the current level's band)
	local oldGenLevel = math.floor(num(data.DailyLevel))
	local level = getLevel(data)

	-- commit: the day flips before anything is paid, so a failure can never double-pay
	S.PlayerService.SetStat(player, "DailyDay", today)
	S.PlayerService.SetStat(player, "DailyClaims", 0)
	data.DailyLevel = level -- the fresh set's band (caps its chest, see chestReward)

	-- CR-M21: vacation days = (1 - f) for the old day + every whole missed day (fractional, no floor), where
	-- f = share of a full day's daily value (3 dailies + chest) earned on the old day. A partly played day
	-- therefore never pays less than an absent one. A23-14 review: f uses the minutes of the old day's band (Lv1-9 =
	-- Newbie 2 x 3 + 4, else Daily 5 x 3 + 10) and Config.VacationReward the current level's band, so a missed
	-- Lv1-9 day (252 gold / 420 XP) pays less than a played one (360 / 600).
	if dailyDay > 0 and today > dailyDay then
		local D = Config.Daily
		local band = oldGenLevel >= 1 and oldGenLevel or level
		local dayBand = bandAt(band) -- A23-14 Newbie / E12 Woods / nil = the template dailies
		local perQuest = dayBand and num(dayBand.RewardMinutes, D.QuestMinutes) or D.QuestMinutes
		local chestMin = dayBand and num(dayBand.ChestMinutes, D.ChestMinutes) or D.ChestMinutes
		local fullDay = perQuest * slots + chestMin
		local earned = claims * perQuest + ((claims >= slots) and chestMin or 0)
		local f = if fullDay > 0 then math.clamp(earned / fullDay, 0, 1) else 1
		local add = (1 - f) + math.max(0, today - dailyDay - 1)
		if add > 0 then
			local days = math.min(D.VacationMaxDays, math.max(0, num(data.VacationDays)) + add)
			days = math.floor(days * 1000 + 0.5) / 1000 -- keep the mirrored attribute tidy
			local g, x = Config.VacationReward(getLevel(data), days)
			S.PlayerService.SetStat(player, "VacationDays", days)
			S.PlayerService.SetStat(player, "VacationGold", g)
			S.PlayerService.SetStat(player, "VacationXP", x)
		end
	end

	data.Quests = fresh
	dirty[player] = true

	local capG, capX = Config.DailyQuestReward(getLevel(data)) -- CR-M6
	local paidGold = 0
	for _, q in toPay do
		local g, x = capTo(math.floor(num(q.RewardGold)), math.floor(num(q.RewardXP)), capG, capX)
		paidGold += g
		payReward(player, g, x)
	end
	if paidGold > 0 then
		Net.Notify(player, string.format(Config.Text.DailyAutoPaid, Util.FormatNumber(paidGold)), "reward", nil, "QuestDone")
	end
	-- CR-M21: an auto-pay that completes the set also pays the bonus chest (capped to the OLD day's band)
	if prevClaims < slots and claims >= slots then
		payChest(player, data, oldGenLevel)
	end
end

------------------------------------------------------------------ remotes
local function onClaimQuest(player, slot)
	if not S.PlayerService.IsReady(player) then return end
	if type(slot) == "string" and string.sub(slot, 1, 6) == "story:" then -- story rows claim by id
		if not Util.RateLimit(player, "ClaimQuest", Config.RateLimits.ClaimQuest) then return end
		local story = S.StoryQuestService
		if story and type(story.Claim) == "function" then pcall(story.Claim, player, string.sub(slot, 7)) end
		return
	end
	local isTutorial = (slot == TUT_ID)
	if not isTutorial and not isSlotIndex(slot) then return end
	if not Util.RateLimit(player, "ClaimQuest", Config.RateLimits.ClaimQuest) then return end
	local data = getData(player)
	if not data then return end

	if isTutorial then
		claimTutorial(player)
		return
	end

	if type(data.Quests) ~= "table" then return end
	local q = data.Quests[slot]
	if not isValidQuest(q) or q.Kind ~= "Daily" or not isComplete(q) then return end -- silent

	data.Quests[slot] = boardOn() and { Kind = "Empty" } or newQuest(player, "Extra", othersExcept(data.Quests, slot)) -- E11
	dirty[player] = true

	local g, x = math.floor(num(q.RewardGold)), math.floor(num(q.RewardXP))
	g, x = capTo(g, x, Config.DailyQuestReward(getLevel(data))) -- CR-M6
	payReward(player, g, x)
	Net.Notify(player, string.format(Config.Text.DailyClaimed, Util.FormatNumber(g), Util.FormatNumber(x)), "reward", nil,
		"QuestDone")

	local claims = num(S.PlayerService.AddStat(player, "DailyClaims", 1))
	if claims == Config.Quests.Slots then
		payChest(player, data)
		-- P8: say once that the day's homework is done (DailyClaims resets with the KST day, so this is once a day)
		task.delay(2, function()
			if player.Parent then pcall(Net.Notify, player, Config.Text.DailyAllDone, "good", 6) end
		end)
	end
end

local function onRerollQuest(player, slot)
	if not S.PlayerService.IsReady(player) then return end
	if not isSlotIndex(slot) then return end
	if not Util.RateLimit(player, "RerollQuest", Config.RateLimits.RerollQuest) then return end
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return end

	local now = Util.Now()
	if now < (rerollReadyAt[player] or 0) then return end

	local q = data.Quests[slot]
	if boardOn() and not isValidQuest(q) then return end -- E11: an empty slot is never rerolled into an extra
	local kind = "Extra"
	if isValidQuest(q) then
		if isComplete(q) then return end
		kind = q.Kind
	end

	data.Quests[slot] = newQuest(player, kind, othersExcept(data.Quests, slot))
	local readyAt = now + Config.Quests.RerollCooldown
	rerollReadyAt[player] = readyAt
	player:SetAttribute("RerollReadyAt", readyAt)
	dirty[player] = true
end

local function onClaimVacation(player)
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "ClaimVacation", Config.RateLimits.ClaimVacation) then return end
	local data = getData(player)
	if not data then return end
	if num(data.VacationDays) <= 0 then return end -- silent

	local g = math.floor(math.max(0, num(data.VacationGold)))
	local x = math.floor(math.max(0, num(data.VacationXP)))
	g, x = capTo(g, x, Config.VacationReward(getLevel(data), num(data.VacationDays))) -- CR-M6
	-- zero first, so the reward can never be claimed twice
	S.PlayerService.SetStat(player, "VacationDays", 0)
	S.PlayerService.SetStat(player, "VacationGold", 0)
	S.PlayerService.SetStat(player, "VacationXP", 0)
	payReward(player, g, x)
	Net.Notify(player, string.format(Config.Text.VacationClaimed, Util.FormatNumber(g), Util.FormatNumber(x)), "reward", nil,
		"GoldPickup")
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player, data)
	if type(data) ~= "table" then data = getData(player) end
	if type(data) ~= "table" then return end

	rerollReadyAt[player] = 0
	player:SetAttribute("RerollReadyAt", 0)

	local step = data.TutorialStep
	if type(step) ~= "number" or step ~= step then step = TUT_DONE end
	if player:GetAttribute("TutorialStep") ~= step then
		player:SetAttribute("TutorialStep", step)
	end
	-- Never reset the saved TutorialKills here: a reconnect can have an unclaimed completed quest.

	ensureSlots(player, data)
	remakeUnfit(player, data, getFaction(player)) -- A23-71: a skill daily kept from before the Lv5 rule
	runDayCheck(player)
	tryTutorial(player) -- pending dialogue opens once when choices and a living character are ready
	publish(player)
end

local function onPlayerLeaving(player)
	dirty[player] = nil
	lastSent[player] = nil
	rerollReadyAt[player] = nil
	welcomeShown[player] = nil
	TUT_READY_AT[player] = nil
	hadNextGoal[player] = nil
end

local function onCharacterSpawned(player)
	-- CR-L50 safety net: resend the quest list once per spawn (the client keeps the last payload; same content)
	lastSent[player] = nil
	dirty[player] = true
	task.delay(RESUME_DELAY_ON_SPAWN, function()
		local ok, err = pcall(tryTutorial, player)
		if not ok then Util.Warn(TAG, "tutorial on spawn: " .. tostring(err)) end
	end)
end

local function onClassChanged(player)
	dirty[player] = true -- 3rd idea round #3: the welcome row names the side's guide
	task.delay(RESUME_DELAY_ON_CLASS, function()
		local ok, err = pcall(tryTutorial, player)
		if not ok then Util.Warn(TAG, "tutorial on class pick: " .. tostring(err)) end
	end)
end

local function onZoneChanged(player, newZoneId)
	if newZoneId == TUT_ZONE and getStep(player) == STEP_GUIDE then
		setStep(player, STEP_QUEST)
	end
end

local function onMonsterKilled(player, info)
	if type(info) ~= "table" then return end
	local data = getData(player)
	if not data then return end
	local step = getStep(player)
	local level = getLevel(data)
	local function weight(q)
		return killWeight(q, info.Kind, level)
	end
	addProgress(player, "Kill", weight)
	if info.Golden == true then
		addProgress(player, "Golden", weight)
	end
	if step == STEP_QUEST then
		tutorialKill(player, info)
	elseif step == STEP_GUIDE and info.Personal ~= true and info.ZoneId == TUT_ZONE
		and TUTORIAL_KINDS[Config.QuestKind(info.Kind)] then
		-- The kill signal may precede ZoneChanged by one tick.
		setStep(player, STEP_QUEST)
		tutorialKill(player, info)
	end
end

local function onGoldEarned(player, amount, source)
	if source ~= "Monster" then return end
	addProgress(player, "Gold", math.floor(num(amount)))
end

-- Only a server-confirmed manual skill that hit at least one monster counts (A23-1; no whiffs in town).
local function onReleased(player, info)
	if type(info) ~= "table" then return end
	if info.Auto == true then return end
	if num(info.MonstersHit) < 1 then return end
	addProgress(player, "Release", 1)
end

local function onGooseFinished(_result, counts)
	if type(counts) ~= "table" then return end
	for p, c in counts do
		if typeof(p) == "Instance" and p:IsA("Player") and num(c) > 0 then
			addProgress(p, "Goose", 1)
		end
	end
end

local function onPlayerKO(killer, _victim, info)
	if type(info) ~= "table" or typeof(killer) ~= "Instance" then return end
	if info.Kind == "Bounty" then
		addProgress(killer, "Hunt", 1)
	elseif info.Kind == "Plunder" then
		addProgress(killer, "Plunder", 1)
	end
end

local function onKaijuEnded(_kaiju, outcome, participants)
	if outcome ~= "Defeated" or type(participants) ~= "table" then return end
	for _, p in participants do
		if typeof(p) == "Instance" and p:IsA("Player") then
			addProgress(p, "Hunt", 1)
		end
	end
end

-- regenerate (same Kind) unfinished slots whose template no longer fits the new faction
local function onFactionChanged(player, newFaction)
	dirty[player] = true -- 3rd idea round #3: the welcome row names the side's guide
	local data = getData(player)
	if not data then return end
	if type(newFaction) ~= "string" then newFaction = getFaction(player) end
	remakeUnfit(player, data, newFaction)
end

-- dailies keep their stored rewards (capped to the current level when claimed: CR-M6); extras are regenerated
-- for the new (level 1) life. Also runs on ProgressionService.LevelReset (free class change, CR-M6).
local function onRebirthed(player)
	local data = getData(player)
	if not data then return end
	-- CR-M6: re-cap the mirrored vacation reward to the new level, so the vacation panel shows what a claim pays
	local vg = math.floor(math.max(0, num(data.VacationGold)))
	local vx = math.floor(math.max(0, num(data.VacationXP)))
	local cg, cx = capTo(vg, vx, Config.VacationReward(getLevel(data), num(data.VacationDays)))
	if cg ~= num(data.VacationGold) then
		S.PlayerService.SetStat(player, "VacationGold", cg)
	end
	if cx ~= num(data.VacationXP) then
		S.PlayerService.SetStat(player, "VacationXP", cx)
	end
	if type(data.Quests) ~= "table" then return end
	local quests = data.Quests
	for i = 1, Config.Quests.Slots do
		local q = quests[i]
		if not isValidQuest(q) or q.Kind == "Extra" then
			quests[i] = boardOn() and { Kind = "Empty" } or newQuest(player, "Extra", othersExcept(quests, i)) -- E11
		end
	end
	dirty[player] = true
end

-- CR-M6: the daily cap rises with the level -> republish so the shown (capped) daily rewards follow it
local function onLeveledUp(player)
	dirty[player] = true
end

------------------------------------------------------------------ public API
function M.GetQuests(player)
	local data = getData(player)
	if not data or type(data.Quests) ~= "table" then return {} end
	return data.Quests
end

-- Studio hook: pretend the player was away for `days` whole days, then run the day check
function M.DebugSimulateAbsence(player, days)
	if not getData(player) then return end
	days = math.max(0, math.floor(num(tonumber(days), 1)))
	local today = Config.DayIndex(os.time())
	S.PlayerService.SetStat(player, "DailyDay", today - (days + 1))
	runDayCheck(player)
	publish(player)
end

------------------------------------------------------------------ lifecycle
function M.Init(registry)
	S = registry
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
	connectSignal("PlayerService", "CharacterSpawned", onCharacterSpawned)
	connectSignal("MonsterService", "MonsterKilled", onMonsterKilled)
	connectSignal("ProgressionService", "GoldEarned", onGoldEarned)
	connectSignal("ProgressionService", "Rebirthed", onRebirthed)
	connectSignal("ProgressionService", "LevelReset", onRebirthed) -- CR-M6
	connectSignal("ProgressionService", "LeveledUp", onLeveledUp) -- CR-M6
	connectSignal("CombatService", "Released", onReleased)
	connectSignal("GooseService", "GooseFinished", onGooseFinished)
	connectSignal("PvPService", "PlayerKO", onPlayerKO)
	connectSignal("KaijuService", "KaijuEnded", onKaijuEnded)
	connectSignal("FactionService", "FactionChanged", onFactionChanged)
	connectSignal("ClassService", "ClassChanged", onClassChanged)
	connectSignal("ZoneService", "ZoneChanged", onZoneChanged)
end

-- StoryQuestService asks for a fresh quest list after story progress
function M.MarkDirty(player)
	if typeof(player) == "Instance" and player:IsA("Player") then dirty[player] = true end
end

function M.Start()
	Net.Get("RequestTutorial").OnServerEvent:Connect(onRequestTutorial)
	Net.Get("AcceptTutorial").OnServerEvent:Connect(onAcceptTutorial)
	Net.Get("IntroSeen").OnServerEvent:Connect(onIntroSeen)
	Net.Get("ClaimQuest").OnServerEvent:Connect(onClaimQuest)
	Net.Get("RerollQuest").OnServerEvent:Connect(onRerollQuest)
	Net.Get("ClaimVacation").OnServerEvent:Connect(onClaimVacation)

	-- publish dirty quest lists
	task.spawn(function()
		while true do
			task.wait(PUBLISH_INTERVAL)
			local list = {}
			for p in dirty do
				table.insert(list, p)
			end
			for _, p in list do
				local ok, err = pcall(publish, p)
				if not ok then loopWarn("publish loop", err) end
			end
		end
	end)

	-- KST day rollover for online players
	task.spawn(function()
		while true do
			task.wait(Config.Daily.CheckInterval)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(runDayCheck, p)
				if not ok then loopWarn("day loop", err) end
			end
		end
	end)

	-- Step 0 only opens the welcome once; entering the meadow advances accepted step 1, never bypasses acceptance.
	task.spawn(function()
		while true do
			task.wait(TUTORIAL_TICK)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tryTutorial, p)
				if not ok then loopWarn("tutorial loop", err) end
				-- the next-goal line reads level/gold; publish() only fires when the JSON really changed
				if getStep(p) == TUT_DONE then dirty[p] = true end
			end
		end
	end)

	print("[QuestService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{C0FCDFC4-F9C6-4DEA-8460-3FCF9DFE53A8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">QuestService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">00a781d6b8ab04140ad785ab0000636f</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3573C7C9D5864EA58F1BF96753B9C32D">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- MapBuilder.luau : reuses (or minimally builds) workspace.Map: zone floors, walls, gates, pads, altar, board, goose perch.
--
-- Build() is also run from the Studio command bar in EDIT mode to pre-bake the map:
--     require(game.ServerScriptService.MapBuilder).Build()
-- so it never touches S, never yields and is idempotent: every named element is looked up first and only the missing
-- pieces are created; existing functional pieces get their functional bits re-applied (pad TravelTo, AltarPrompt,
-- BoardGui.BoardText, zone floor ZoneId + invisibility, the two-line gate signs, the pad position + sign text from
-- Config.Map.Pads (CR-M22), the bounds walls' bottom below the sea floor (CR-L17)).
--
-- The real world is the Studio-saved place built by tools/preview_map.lua (addendum A8/A10/A11: Terrain landscape,
-- sea, rivers, ridges, bridges, sky crown). A reused map is adopted as-is: the four "Wall" parts get the contract names
-- (matched by orientation/side), its gate billboards get the spec text, and NOTHING is added to its ground or decor
-- (A10-V3-1: never a ground plate over the Bounds; it would cover the sea/rivers and z-fight the Terrain land).
-- A11-R3: with no workspace.Map at all, Build() warns and builds only minimal flat ground (Config.Map.Lands plates +
-- bridge decks named "Bridge_*" in Decor) plus the functional pieces; no Terrain, no decorative set.
-- A11-R1: zone floor parts are contract markers only: invisible, CanCollide/CanQuery/CanTouch false (build and reuse).
-- Lighting is never touched here: WarService owns it (addendum A9-3: no Atmosphere, no per-zone ColorCorrection).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local MapBuilder = {}

local TAG = "MapBuilder"
local FOLDER_NAMES = { "Ground", "Zones", "Walls", "Gates", "Pads", "Landmarks", "Decor", "NPCs" }
local WALL_NAMES = { "Wall_MinX", "Wall_MaxX", "Wall_MinZ", "Wall_MaxZ" }
local WALL_THICKNESS = 2
local WALL_ADOPT_LENGTH = 100 -- a pre-baked part at least this long in the Walls folder is a bounds wall
-- CR-L17: walls reach 20 studs below the water surface (under the sea floor) so nobody swims under them
local WALL_BOTTOM = (Config.Map.WaterTop or 0) - 20
local GATE_HALF_SPAN = 10 -- pillar centers 20 apart (17-stud passage)
local EXTREME_MIN_LEVEL = 25 -- PvP zones from this level use the "extreme" danger color
local SIGN_MAX_DISTANCE = 150
-- A23-36 (user 2026-10-06): no big 3D place text; a pad keeps only a small label seen up close (like shop names)
local PAD_SIGN = { Width = 190, Height = 32, MaxDistance = 40, OffsetY = 3,
	-- the woods and ruins pads stand in one line seen from the Crossroads walk: the farther label rides higher so the
	-- two never overlap (검수 2026-10-07, play-view photos)
	Lift = { SkeletonRuins = 3.6 } }
local SHOP_SIGN_MAX_DISTANCE = 50 -- shop / landmark name labels (the sky crown image has no TextLabel and stays)
-- the goose nest label sits beside the Crossroads walk: small, low and only up close, so it never floats behind the
-- HUD quest rows (검수 2026-10-07, play-view photo)
local PERCH_SIGN = { Width = 190, Height = 32, MaxDistance = 30, OffsetY = 3 }
local MAX_LIGHTS = 40 -- whole map
local MAX_LIGHT_RANGE = 40
local MAX_LIGHT_BRIGHTNESS = 2
local PERCH_DIAMETER = 10
local PERCH_HEIGHT = 1
local GROUND_THICKNESS = 4 -- minimal ground plates: top at Y = 0
local BRIDGE_WIDTH = 18 -- default deck width when Config.Map.Bridges has no Width
local ALTAR_PROMPT_KEY = Enum.KeyCode.E -- Roblox-standard interact key; the skill is Q only (2026-10-06 playtest)

local RGB = Color3.fromRGB
local SP = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)

local DANGER = { Safe = RGB(80, 220, 120), PvP = RGB(255, 150, 40), Extreme = RGB(255, 60, 60) }
local GATE_STYLE = { SlimeMeadow = "Meadow", GoblinWoods = "Goblin", SkeletonRuins = "Ruins", HaloTown = "Halo", HornsTown = "Horns" }

local S = nil -- registry (stored by Init; Build/Rebuild never use it)

------------------------------------------------------------------ instance helpers
-- ctx = { parts = BaseParts created, pieces = missing named pieces built, lights = PointLights created }
local function newCtx()
	return { parts = 0, pieces = 0, lights = 0 }
end

-- every map part: anchored, locked, SmoothPlastic unless told otherwise, Shape applied before Size, parented last;
-- small (< 4 studs) and Neon parts cast no shadow
local function part(ctx, props, parent, className)
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.Locked = true
	p.Material = SP
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	for k, v in props do
		if k ~= "Shape" then
			p[k] = v
		end
	end
	local s = p.Size
	if math.max(s.X, s.Y, s.Z) < 4 or p.Material == NEON then
		p.CastShadow = false
	end
	p.Parent = parent
	ctx.parts += 1
	return p
end

-- small decoration: no collision, no queries, no touches
local function prop(ctx, props, parent, className)
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return part(ctx, props, parent, className)
end

local function model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	if parent then m.Parent = parent end
	return m
end

local function light(ctx, p, color, range, brightness)
	if ctx.lights >= MAX_LIGHTS then return nil end
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = math.min(range or 16, MAX_LIGHT_RANGE)
	l.Brightness = math.min(brightness or 1.5, MAX_LIGHT_BRIGHTNESS)
	l.Shadows = false
	l.Parent = p
	ctx.lights += 1
	return l
end

local function billboard(adornee, name, text, offsetY, color, width, maxDist, height)
	local bb = Instance.new("BillboardGui")
	bb.Name = name
	bb.Size = UDim2.fromOffset(width or 260, height or 46)
	bb.StudsOffset = Vector3.new(0, offsetY or 4, 0)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = maxDist or SIGN_MAX_DISTANCE
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.RichText = true
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = color or WHITE
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = t
	t.Parent = bb
	bb.Parent = adornee
	return bb
end

-- upright cylinder: props.Size = (diameter, height, diameter), props.Position = center
local function cyl(ctx, props, parent)
	local d, h = props.Size.X, props.Size.Y
	props.Size = Vector3.new(h, d, d)
	props.CFrame = CFrame.new(props.Position) * CFrame.Angles(0, 0, math.rad(90))
	props.Position = nil
	props.Shape = Enum.PartType.Cylinder
	return part(ctx, props, parent)
end

local function disc(ctx, pos, diameter, thickness, color, parent, material)
	return cyl(ctx, {
		Name = "Disc", Size = Vector3.new(diameter, thickness, diameter), Position = pos,
		Color = color, Material = material or SP, CanCollide = false,
	}, parent)
end

-- horizontal ring of n block segments
local function ring(ctx, center, radius, n, size, color, parent, material)
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		prop(ctx, {
			Name = "RingSeg", Size = size,
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)) * CFrame.Angles(0, -a, 0),
			Color = color, Material = material or NEON,
		}, parent)
	end
end

local function getChildFolder(parent, name)
	local f = parent:FindFirstChild(name)
	if f then return f, false end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f, true
end

local function countParts(root)
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then n += 1 end
	end
	return n
end

-- moves a wrong-class instance out of the way of a contract name (never destroys user content)
local function retire(inst, suffix)
	Util.Warn(TAG, inst:GetFullName() .. " has the wrong class (" .. inst.ClassName .. "); renamed and rebuilt")
	inst.Name = inst.Name .. suffix
end

------------------------------------------------------------------ text helpers
local function dangerColor(zone)
	if not zone.PvP then return DANGER.Safe end
	if zone.MinLevel >= EXTREME_MIN_LEVEL then return DANGER.Extreme end
	return DANGER.PvP
end

local function padLabel(zone)
	return "→ " .. zone.Name .. " (Lv " .. zone.MinLevel .. "+)"
end

------------------------------------------------------------------ ground / zones / walls
-- one flat plate, top at Y = 0
local function groundPlate(ctx, folder, name, minX, maxX, minZ, maxZ, color, material)
	if folder:FindFirstChild(name) or maxX <= minX or maxZ <= minZ then return end
	part(ctx, {
		Name = name,
		Size = Vector3.new(maxX - minX, GROUND_THICKNESS, maxZ - minZ),
		Position = Vector3.new((minX + maxX) / 2, -GROUND_THICKNESS / 2, (minZ + maxZ) / 2),
		Color = color, Material = material,
	}, folder)
	ctx.pieces += 1
end

-- deck (top at Y = 0.2, like tools/preview_map.lua) + two collidable rails, as Decor model "Bridge_<Name>"
-- (A11-R1: ground raycasts include workspace.Map.Decor children named "Bridge_*")
local function buildBridge(ctx, decor, entry)
	local name = "Bridge_" .. tostring(entry.Name)
	if decor:FindFirstChild(name) then return end
	local from, to = entry.From, entry.To
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then return end
	from = Vector3.new(from.X, 0, from.Z)
	to = Vector3.new(to.X, 0, to.Z)
	local len = (to - from).Magnitude
	if len < 1 then return end
	local width = tonumber(entry.Width) or BRIDGE_WIDTH
	local cf = CFrame.lookAt((from + to) / 2, to)
	local br = model(name)
	local deck = part(ctx, {
		Name = "Deck", Size = Vector3.new(width, 1, len + 4), CFrame = cf * CFrame.new(0, -0.3, 0),
		Color = RGB(150, 110, 70), Material = Enum.Material.WoodPlanks,
	}, br)
	for _, side in { -1, 1 } do
		part(ctx, {
			Name = "Rail", Size = Vector3.new(0.8, 0.8, len + 4), CFrame = cf * CFrame.new(side * (width / 2 - 0.4), 2.8, 0),
			Color = RGB(110, 80, 50), Material = Enum.Material.Wood,
		}, br)
	end
	br.PrimaryPart = deck
	br.Parent = decor
	ctx.pieces += 1
end

local function terrainHasLand()
	local ok, cells = pcall(function()
		return workspace.Terrain:CountCells()
	end)
	return ok and type(cells) == "number" and cells > 0
end

-- A11-R3: only for a from-scratch build (no workspace.Map). Release builds come from the Studio-saved place (Terrain).
-- Config.Map.Lands plates + Config.Map.Bridges decks; an older Config without Lands gets one plate per zone rectangle.
-- Never one plate over the whole Bounds (A10-V3-1). When Terrain already exists (e.g. Rebuild() in the saved place)
-- the Terrain is the ground: no plates (they would z-fight its Y = 0 top), bridges only.
local function buildLandPlates(ctx, ground)
	local grass, grassColor = Enum.Material.Grass, RGB(106, 150, 72)
	local lands = Config.Map.Lands
	if type(lands) == "table" and #lands > 0 then
		for i, l in lands do
			local minX, maxX, minZ, maxZ = tonumber(l.MinX), tonumber(l.MaxX), tonumber(l.MinZ), tonumber(l.MaxZ)
			if minX and maxX and minZ and maxZ then
				groundPlate(ctx, ground, tostring(l.Name or ("Land" .. i)), minX, maxX, minZ, maxZ, grassColor, grass)
			end
		end
		return
	end
	for _, id in Config.ZoneOrder do
		local z = Config.Zones[id]
		if z then
			local hx, hz = z.Size.X / 2, z.Size.Z / 2
			groundPlate(ctx, ground, "Ground_" .. id, z.Center.X - hx, z.Center.X + hx, z.Center.Z - hz, z.Center.Z + hz,
				z.FloorColor or grassColor, z.FloorMaterial or grass)
		end
	end
end

local function buildMinimalGround(ctx, ground, decor)
	if not terrainHasLand() then
		buildLandPlates(ctx, ground)
	end
	if type(Config.Map.Bridges) == "table" then
		for _, entry in Config.Map.Bridges do
			if type(entry) == "table" then
				buildBridge(ctx, decor, entry)
			end
		end
	end
end

-- A11-R1: zone floors are contract markers only (players and monsters stand on Terrain / Map.Ground)
local function applyFloorMarker(floor)
	if not floor:IsA("BasePart") then return end
	floor.Transparency = 1
	floor.CanCollide = false
	floor.CanQuery = false
	floor.CanTouch = false
	floor.CastShadow = false
end

local function ensureZones(ctx, folder)
	for _, id in Config.ZoneOrder do
		local z = Config.Zones[id]
		if z then
			local floor = folder:FindFirstChild(id)
			local size = Vector3.new(z.Size.X, 1, z.Size.Z)
			local pos = Vector3.new(z.Center.X, -0.45, z.Center.Z) -- top at Y = 0.05
			if not floor then
				floor = part(ctx, {
					Name = id, Size = size, Position = pos, Color = z.FloorColor, Material = z.FloorMaterial,
				}, folder)
				ctx.pieces += 1
			elseif floor:IsA("BasePart") and ((floor.Size - size).Magnitude > 0.05 or (floor.Position - pos).Magnitude > 0.05) then
				-- map v2 (A23-53): a marker from an older layout follows the Config rectangle
				floor.Size, floor.CFrame = size, CFrame.new(pos)
			end
			applyFloorMarker(floor)
			floor:SetAttribute("ZoneId", id)
		end
	end
end

local function wallSpecs()
	local b = Config.Map.Bounds
	local h = Config.Map.WallHeight
	local t = WALL_THICKNESS
	local lenX = b.MaxX - b.MinX + 2 * t -- overlap the corners
	local lenZ = b.MaxZ - b.MinZ + 2 * t
	local cx, cz = (b.MinX + b.MaxX) / 2, (b.MinZ + b.MaxZ) / 2
	-- top at Y = WallHeight, bottom at WALL_BOTTOM (CR-L17)
	local sy, y = h - WALL_BOTTOM, (h + WALL_BOTTOM) / 2
	return {
		Wall_MinX = { Size = Vector3.new(t, sy, lenZ), Position = Vector3.new(b.MinX - t / 2, y, cz) },
		Wall_MaxX = { Size = Vector3.new(t, sy, lenZ), Position = Vector3.new(b.MaxX + t / 2, y, cz) },
		Wall_MinZ = { Size = Vector3.new(lenX, sy, t), Position = Vector3.new(cx, y, b.MinZ - t / 2) },
		Wall_MaxZ = { Size = Vector3.new(lenX, sy, t), Position = Vector3.new(cx, y, b.MaxZ + t / 2) },
	}
end

-- CR-L17: a reused upright wall whose bottom is above WALL_BOTTOM is stretched down to it (top, X/Z, rotation kept)
local function lowerWall(wall)
	if not wall:IsA("BasePart") then return end
	local cf, s = wall.CFrame, wall.Size
	if math.abs(cf.UpVector.Y) < 0.99 then return end -- tilted: Size.Y is not the height
	local top = cf.Position.Y + s.Y / 2
	local bottom = cf.Position.Y - s.Y / 2
	if bottom <= WALL_BOTTOM + 0.05 or top <= WALL_BOTTOM then return end
	wall.Size = Vector3.new(s.X, top - WALL_BOTTOM, s.Z)
	wall.CFrame = CFrame.new(cf.Position.X, (top + WALL_BOTTOM) / 2, cf.Position.Z) * cf.Rotation
end

-- which bounds edge a pre-baked wall stands on: long along X -> a Z edge, long along Z -> an X edge; side from the
-- map center. Works even when the pre-baked map uses different bounds than Config.
local function classifyWall(wall, center)
	local s = wall.Size
	if math.max(s.X, s.Z) < WALL_ADOPT_LENGTH then return nil end
	if s.X >= s.Z then
		return (wall.Position.Z < center.Z) and "Wall_MinZ" or "Wall_MaxZ"
	end
	return (wall.Position.X < center.X) and "Wall_MinX" or "Wall_MaxX"
end

-- map v2 (A23-53): a reused upright wall standing on older bounds moves onto the Config edge (X / Z place and length
-- from the spec, its own height kept; lowerWall then fixes the bottom). Returns true when it moved.
local function fitWall(wall, spec)
	if not wall:IsA("BasePart") or math.abs(wall.CFrame.UpVector.Y) < 0.99 then return false end
	local p, s = wall.Position, wall.Size
	local flat = Vector3.new(p.X - spec.Position.X, 0, p.Z - spec.Position.Z).Magnitude
	if flat < 0.5 and math.abs(s.X - spec.Size.X) < 0.5 and math.abs(s.Z - spec.Size.Z) < 0.5 then return false end
	wall.Size = Vector3.new(spec.Size.X, s.Y, spec.Size.Z)
	wall.CFrame = CFrame.new(spec.Position.X, p.Y, spec.Position.Z)
	return true
end

local function ensureWalls(ctx, folder)
	local specs = wallSpecs()
	local b = Config.Map.Bounds
	local center = Vector3.new((b.MinX + b.MaxX) / 2, 0, (b.MinZ + b.MaxZ) / 2)
	-- adopt pre-baked walls with other names (the preview script calls all four "Wall")
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and specs[child.Name] == nil then
			local name = classifyWall(child, center)
			if name and not folder:FindFirstChild(name) then
				child.Name = name
			end
		end
	end
	for _, name in WALL_NAMES do
		local wall = folder:FindFirstChild(name)
		if not wall then
			local spec = specs[name]
			part(ctx, {
				Name = name, Size = spec.Size, Position = spec.Position,
				Transparency = 1, CanCollide = true, CastShadow = false,
			}, folder)
			ctx.pieces += 1
		else
			if fitWall(wall, specs[name]) then Util.Log(TAG, "moved " .. name .. " onto Config.Map.Bounds") end
			lowerWall(wall) -- CR-L17
		end
	end
end

------------------------------------------------------------------ gates
-- A23-36 (user 2026-10-06): no big 3D place text on gates. Where I am = the HUD zone chip, where to go = the quest
-- marker, the level gate = ZoneService's own notice. Every billboard on a gate (the pre-baked preview_map sign or an
-- older "GateSign") is removed; the Lintel stays (HUD guide target). Returns 0 (nothing built).
local function clearGateSigns(gate)
	for _, d in gate:GetDescendants() do
		if d:IsA("BillboardGui") then d:Destroy() end
	end
	return 0
end

local function buildGate(ctx, parent, entry, zone)
	local gate = model("Gate_" .. entry.Zone)
	local style = GATE_STYLE[entry.Zone] or (zone.PvP and "Goblin" or "Meadow")
	local pos = entry.Position
	-- the path runs from the gate toward the zone center; the pillars stand across it
	local alongX = math.abs(zone.Center.X - pos.X) >= math.abs(zone.Center.Z - pos.Z)
	local off = alongX and Vector3.new(0, 0, GATE_HALF_SPAN) or Vector3.new(GATE_HALF_SPAN, 0, 0)
	local span = GATE_HALF_SPAN * 2 + 3
	local lintelSize = alongX and Vector3.new(3, 2.5, span) or Vector3.new(span, 2.5, 3)
	-- statues face the incoming path (toward the side away from the zone center)
	local fx = (pos.X - zone.Center.X) >= 0 and 1 or -1
	local lintel

	if style == "Halo" then
		for _, s in { -1, 1 } do
			cyl(ctx, { Name = "Tower", Size = Vector3.new(6, 22, 6), Position = pos + off * s + Vector3.new(0, 11, 0), Color = RGB(245, 242, 235) }, gate)
			part(ctx, {
				Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(6.4, 6.4, 6.4),
				Position = pos + off * s + Vector3.new(0, 22, 0), Color = RGB(212, 175, 55),
			}, gate)
		end
		lintel = part(ctx, { Name = "Lintel", Size = lintelSize, Position = pos + Vector3.new(0, 19, 0), Color = RGB(245, 242, 235) }, gate)
		ring(ctx, pos + Vector3.new(0, 25, 0), 3.5, 8, Vector3.new(0.5, 0.5, 2.8), RGB(255, 225, 130), gate)
	elseif style == "Horns" then
		for _, s in { -1, 1 } do
			part(ctx, {
				Name = "Pillar", Size = Vector3.new(4, 18, 4), Position = pos + off * s + Vector3.new(0, 9, 0),
				Color = RGB(45, 30, 35), Material = Enum.Material.Basalt,
			}, gate)
			for k = 1, 3 do
				local tilt = alongX and CFrame.Angles(math.rad(15 * k * s), 0, 0) or CFrame.Angles(0, 0, math.rad(-15 * k * s))
				prop(ctx, {
					Name = "Horn", Size = Vector3.new(2.4 - k * 0.5, 3, 2.4 - k * 0.5),
					CFrame = CFrame.new(pos + off * s * (1 - k * 0.12) + Vector3.new(0, 18 + k * 2.4, 0)) * tilt,
					Color = RGB(60, 40, 45), Material = Enum.Material.Basalt,
				}, gate, "WedgePart")
			end
			prop(ctx, {
				Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8),
				Position = pos + off * s * 0.92 + Vector3.new(0, 16, 0), Color = RGB(255, 60, 40), Material = NEON,
			}, gate)
		end
		lintel = part(ctx, {
			Name = "Lintel", Size = lintelSize, Position = pos + Vector3.new(0, 17, 0),
			Color = RGB(130, 25, 30), Material = Enum.Material.Fabric,
		}, gate)
	else
		local col = ({ Meadow = RGB(140, 100, 65), Goblin = RGB(110, 80, 50), Ruins = RGB(225, 220, 200) })[style]
		local mat = (style == "Ruins") and SP or Enum.Material.Wood
		for _, s in { -1, 1 } do
			part(ctx, { Name = "Pillar", Size = Vector3.new(3, 18, 3), Position = pos + off * s + Vector3.new(0, 9, 0), Color = col, Material = mat }, gate)
		end
		lintel = part(ctx, { Name = "Lintel", Size = lintelSize, Position = pos + Vector3.new(0, 18.5, 0), Color = col, Material = mat }, gate)
		local top = pos + Vector3.new(0, 24, 0)
		if style == "Meadow" then -- slime statue
			part(ctx, { Name = "SlimeStatue", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), Position = top, Color = RGB(120, 230, 150) }, gate)
			for _, ez in { -1.5, 1.5 } do
				prop(ctx, {
					Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4),
					Position = top + Vector3.new(3.4 * fx, 1, ez), Color = RGB(30, 30, 30),
				}, gate)
			end
		elseif style == "Goblin" then -- goblin totem + crossed spears
			part(ctx, { Name = "Totem", Size = Vector3.new(4, 7, 4), Position = top + Vector3.new(0, 0.5, 0), Color = RGB(80, 120, 50) }, gate)
			prop(ctx, {
				Name = "TotemEyes", Size = Vector3.new(0.4, 0.8, 2.6), Position = top + Vector3.new(2.1 * fx, 2, 0),
				Color = RGB(255, 220, 60), Material = NEON,
			}, gate)
			for _, a in { 35, -35 } do
				prop(ctx, {
					Name = "Spear", Size = Vector3.new(0.5, 12, 0.5),
					CFrame = CFrame.new(top + Vector3.new(0, 1, 0)) * CFrame.Angles(math.rad(a), 0, 0),
					Color = RGB(120, 90, 55), Material = Enum.Material.Wood,
				}, gate)
			end
		else -- skull arch
			part(ctx, { Name = "Skull", Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Position = top + Vector3.new(0, 2, 0), Color = RGB(225, 220, 200) }, gate)
			for _, ez in { -2.6, 2.6 } do
				local eye = prop(ctx, {
					Name = "SkullEye", Shape = Enum.PartType.Ball, Size = Vector3.new(2.5, 2.5, 2.5),
					Position = top + Vector3.new(5.2 * fx, 3, ez), Color = RGB(150, 110, 255), Material = NEON,
				}, gate)
				if ez < 0 then light(ctx, eye, RGB(150, 110, 255), 18, 1.5) end
			end
			prop(ctx, { Name = "Jaw", Size = Vector3.new(4, 2, 6), Position = top + Vector3.new(3.5 * fx, -3.5, 0), Color = RGB(205, 200, 180) }, gate)
		end
	end

	gate.PrimaryPart = lintel
	gate.Parent = parent
	return gate
end

-- map v2 (A23-53): a reused gate (built here, by preview_map or a kit model keeping its "Lintel") slides on X / Z so its
-- lintel stands over the Config position; height and turn stay. Returns true when it moved.
local function placeGate(gate, pos)
	if not gate:IsA("Model") then return false end
	local anchor = gate.PrimaryPart or gate:FindFirstChild("Lintel", true)
	local at = (anchor and anchor:IsA("BasePart")) and anchor.Position or gate:GetPivot().Position
	local delta = Vector3.new(pos.X - at.X, 0, pos.Z - at.Z)
	if delta.Magnitude < 0.5 then return false end
	gate:PivotTo(gate:GetPivot() + delta)
	return true
end

local function ensureGates(ctx, folder)
	for _, entry in Config.Map.Gates do
		local zone = Config.Zones[entry.Zone]
		if zone then
			local gate = folder:FindFirstChild("Gate_" .. entry.Zone)
			if not gate then
				gate = buildGate(ctx, folder, entry, zone)
				ctx.pieces += 1
			elseif placeGate(gate, entry.Position) then
				Util.Log(TAG, ("moved Gate_%s to (%g, %g)"):format(entry.Zone, entry.Position.X, entry.Position.Z))
			end
			ctx.pieces += clearGateSigns(gate)
		end
	end
end

------------------------------------------------------------------ pads
-- CR-M22: a reused pad is moved to its Config position (top at Y = 0.5) with every part under it (ring, decor);
-- the billboard is adorned to the pad and follows. Returns true when it moved.
local function placePad(pad, pos)
	-- the crossroads kit (tools/worldkit/crossroads_kit_main.luau) sets TopY: the pad lies on its kit base top
	local top = tonumber(pad:GetAttribute("TopY")) or 0.5
	local want = Vector3.new(pos.X, top - pad.Size.Y / 2, pos.Z)
	local delta = want - pad.Position
	if delta.Magnitude < 0.05 then return false end
	for _, d in pad:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame + delta
		end
	end
	pad.CFrame = pad.CFrame + delta
	return true
end

local function ensurePads(ctx, folder)
	local size = Config.Map.PadSize
	for _, entry in Config.Map.Pads do
		local zone = Config.Zones[entry.Dest]
		local name = "Pad_" .. entry.Dest
		local pad = folder:FindFirstChild(name)
		if not pad then
			local center = Vector3.new(entry.Position.X, 0.5 - size.Y / 2, entry.Position.Z) -- top at Y = 0.5
			pad = part(ctx, { Name = name, Size = size, Position = center, Color = RGB(80, 200, 255), Material = NEON }, folder)
			if zone then
				ring(ctx, Vector3.new(center.X, 0.55, center.Z), 6.2, 12, Vector3.new(0.6, 0.3, 3.4), dangerColor(zone), pad)
			end
			ctx.pieces += 1
		end
		-- functional bits (re-applied on reuse)
		pad:SetAttribute("TravelTo", entry.Dest)
		if pad:IsA("BasePart") then
			pad.CanTouch = true
			pad.CanCollide = pad:GetAttribute("KitBase") ~= true -- a kit base is the floor; the invisible pad only senses
			if placePad(pad, entry.Position) then -- CR-M22: an older map had pads on the east road
				Util.Log(TAG, ("moved %s to (%g, %g)"):format(name, entry.Position.X, entry.Position.Z))
			end
		end
		if zone then
			local sign = pad:FindFirstChildWhichIsA("BillboardGui")
			if not sign then
				sign = billboard(pad, "PadSign", padLabel(zone), PAD_SIGN.OffsetY + (PAD_SIGN.Lift[zone.Id] or 0), RGB(200, 240, 255), PAD_SIGN.Width,
					PAD_SIGN.MaxDistance, PAD_SIGN.Height)
				ctx.pieces += 1
			else
				-- CR-M22: the reused sign text follows Config (zone name / level)
				local label = sign:FindFirstChildWhichIsA("TextLabel", true)
				if label then label.Text = padLabel(zone) end
			end
			-- A23-36: a pre-baked (big, far) pad sign becomes the small near-only label
			sign.Size = UDim2.fromOffset(PAD_SIGN.Width, PAD_SIGN.Height)
			sign.MaxDistance = PAD_SIGN.MaxDistance
			sign.StudsOffset = Vector3.new(0, PAD_SIGN.OffsetY + (PAD_SIGN.Lift[zone.Id] or 0), 0)
		end
	end
end

------------------------------------------------------------------ landmarks (contract)
local function buildFountain(ctx, parent)
	local f = Config.Map.FountainPosition
	local m = model("Fountain")
	local marble = Enum.Material.Marble
	local stone, water = RGB(225, 225, 230), RGB(90, 180, 255)
	local base = cyl(ctx, { Name = "Tier1", Size = Vector3.new(26, 2, 26), Position = f + Vector3.new(0, 1, 0), Color = stone, Material = marble }, m)
	cyl(ctx, { Name = "Water1", Size = Vector3.new(23, 0.3, 23), Position = f + Vector3.new(0, 2.05, 0), Color = water, Transparency = 0.3, CanCollide = false }, m)
	cyl(ctx, { Name = "Tier2", Size = Vector3.new(14, 3, 14), Position = f + Vector3.new(0, 3.5, 0), Color = stone, Material = marble }, m)
	cyl(ctx, { Name = "Water2", Size = Vector3.new(12, 0.3, 12), Position = f + Vector3.new(0, 5.05, 0), Color = water, Transparency = 0.3, CanCollide = false }, m)
	cyl(ctx, { Name = "Tier3", Size = Vector3.new(6, 2, 6), Position = f + Vector3.new(0, 6, 0), Color = stone, Material = marble }, m)
	m.PrimaryPart = base
	m.Parent = parent
	return m
end

local function buildAltar(ctx, parent)
	local pos = Config.Map.AltarPosition
	local altar = part(ctx, {
		Name = "Altar", Size = Vector3.new(8, 4, 8), Position = pos + Vector3.new(0, 2, 0), -- bottom on the ground
		Color = RGB(110, 100, 130), Material = Enum.Material.Slate,
	}, parent)
	-- the top glows half gold (Halo) and half red (Horns)
	local topHalo = part(ctx, {
		Name = "AltarGlowHalo", Size = Vector3.new(6, 0.4, 3), Position = pos + Vector3.new(0, 4.2, -1.5),
		Color = RGB(255, 215, 90), Material = NEON, CanCollide = false,
	}, altar)
	part(ctx, {
		Name = "AltarGlowHorns", Size = Vector3.new(6, 0.4, 3), Position = pos + Vector3.new(0, 4.2, 1.5),
		Color = RGB(220, 50, 60), Material = NEON, CanCollide = false,
	}, altar)
	light(ctx, topHalo, RGB(255, 180, 160), 18, 1.5)
	for _, cx in { -6, 6 } do
		for _, cz in { -6, 6 } do
			part(ctx, {
				Name = "AltarColumn", Size = Vector3.new(2, 10, 2), Position = pos + Vector3.new(cx, 5, cz),
				Color = RGB(150, 140, 165), Material = Enum.Material.Slate,
			}, altar)
		end
	end
	billboard(altar, "AltarSign", "Altar of Fate", 8, RGB(230, 210, 255))
	return altar
end

-- returns 1 when the prompt had to be created
local function ensureAltarPrompt(altar)
	local built = 0
	local prompt = altar:FindFirstChild("AltarPrompt")
	if prompt and not prompt:IsA("ProximityPrompt") then
		retire(prompt, "_Old")
		prompt = nil
	end
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "AltarPrompt"
		built = 1
	end
	prompt.ActionText = "Switch side"
	prompt.ObjectText = "Altar of Fate"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = ALTAR_PROMPT_KEY
	prompt.Enabled = true
	prompt.Parent = altar
	return built
end

local function buildBoard(ctx, parent)
	local pos = Config.Map.BoardPosition
	local board = part(ctx, {
		Name = "MostWantedBoard", Size = Vector3.new(1, 12, 20), Position = pos + Vector3.new(0, 6, 0),
		Color = RGB(90, 60, 40), Material = Enum.Material.WoodPlanks,
	}, parent)
	for _, dz in { -10.5, 10.5 } do
		part(ctx, {
			Name = "BoardPost", Size = Vector3.new(1.2, 14, 1.2), Position = pos + Vector3.new(0, 7, dz),
			Color = RGB(70, 45, 30), Material = Enum.Material.Wood,
		}, board)
	end
	return board
end

-- SurfaceGui "BoardGui" on the +X face with TextLabel "BoardText". Returns the number of pieces created.
local function ensureBoardGui(board)
	local built = 0
	local gui = board:FindFirstChild("BoardGui")
	if gui and not gui:IsA("SurfaceGui") then
		retire(gui, "_Old")
		gui = nil
	end
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = "BoardGui"
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(400, 240)
		built += 1
	end
	gui.Face = Enum.NormalId.Right -- faces +X
	gui.LightInfluence = 0 -- readable under every sky
	gui.Parent = board
	local text = gui:FindFirstChild("BoardText")
	if text and not text:IsA("TextLabel") then
		retire(text, "_Old")
		text = nil
	end
	if not text then
		text = Instance.new("TextLabel")
		text.Name = "BoardText"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundColor3 = RGB(30, 25, 25)
		text.BackgroundTransparency = 0
		text.TextColor3 = WHITE
		text.Font = Enum.Font.GothamBold
		text.Text = "Wanted Board"
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 10)
		padding.PaddingRight = UDim.new(0, 10)
		padding.PaddingTop = UDim.new(0, 8)
		padding.PaddingBottom = UDim.new(0, 8)
		padding.Parent = text
		text.Parent = gui
		built += 1
	end
	text.TextScaled = true
	text.TextWrapped = true
	return built
end

-- round gold platform (Cylinder Ø10 × 1, top at Y = 1, Marble) + the event-stage ring and gold posts
local function buildGoosePerch(ctx, parent)
	local gp = Config.Goose.Position
	local perch = cyl(ctx, {
		Name = "GoosePerch", Size = Vector3.new(PERCH_DIAMETER, PERCH_HEIGHT, PERCH_DIAMETER),
		Position = Vector3.new(gp.X, PERCH_HEIGHT / 2, gp.Z), Color = RGB(255, 200, 60), Material = Enum.Material.Marble,
	}, parent)
	disc(ctx, Vector3.new(gp.X, 0.08, gp.Z), 22, 0.2, RGB(255, 240, 200), perch)
	for k = 0, 3 do
		local a = k * math.pi / 2 + math.pi / 4
		part(ctx, {
			Name = "GoldPost", Size = Vector3.new(1, 6, 1),
			Position = Vector3.new(gp.X + math.cos(a) * 10, 3, gp.Z + math.sin(a) * 10), Color = RGB(212, 175, 55),
		}, perch)
	end
	billboard(perch, "PerchSign", "Golden Goose Nest", PERCH_SIGN.OffsetY, RGB(255, 225, 120), PERCH_SIGN.Width,
		PERCH_SIGN.MaxDistance, PERCH_SIGN.Height)
	return perch
end

-- Part = true: a BasePart contract (other services read .Position / children)
local CONTRACT_LANDMARKS = {
	{ Name = "Fountain", Build = buildFountain },
	{ Name = "Altar", Build = buildAltar, Part = true },
	{ Name = "MostWantedBoard", Build = buildBoard, Part = true },
	{ Name = "GoosePerch", Build = buildGoosePerch },
}

local function ensureLandmarks(ctx, folder)
	for _, def in CONTRACT_LANDMARKS do
		local inst = folder:FindFirstChild(def.Name)
		if inst and def.Part and not inst:IsA("BasePart") then
			retire(inst, "_Decor")
			inst = nil
		end
		if not inst then
			def.Build(ctx, folder)
			ctx.pieces += 1
		end
	end
	local altar = folder:FindFirstChild("Altar")
	if altar then
		ctx.pieces += ensureAltarPrompt(altar)
	end
	local board = folder:FindFirstChild("MostWantedBoard")
	if board then
		ctx.pieces += ensureBoardGui(board)
	end
end

-- E11 job boards (Config.Board; image dev's BoardPanel opens the window with BoardAction(id, "Open")): at each board's
-- spot (Config.StoryQuests.Landmarks[<Spot>]) the host part of "JobBoard_<id>" (the placed 3D board model of that name,
-- else an invisible anchor) carries the ProximityPrompt "BoardPrompt" with the attribute Board = <id>. While
-- Config.Board.Enabled is false the prompt is there but switched off.
local function ensureJobBoards(ctx, folder)
	local B = Config.Board
	if type(B) ~= "table" or type(B.Boards) ~= "table" then return end
	local spots = type(Config.StoryQuests) == "table" and type(Config.StoryQuests.Landmarks) == "table"
		and Config.StoryQuests.Landmarks or {}
	for id, def in B.Boards do
		local spot = type(def) == "table" and spots[def.Spot] or nil
		if typeof(spot) == "Vector3" then
			local name = "JobBoard_" .. tostring(id)
			local holder = folder:FindFirstChild(name)
			local host = nil
			if holder and holder:IsA("Model") then
				host = holder.PrimaryPart or holder:FindFirstChildWhichIsA("BasePart", true)
			elseif holder and holder:IsA("BasePart") then
				host = holder
			end
			if not host then
				host = part(ctx, {
					Name = name, Size = Vector3.new(4, 6, 1), Position = spot + Vector3.new(0, 3, 0),
					Transparency = 1, CanCollide = false, CanTouch = false,
				}, folder)
				ctx.pieces += 1
			end
			local prompt = host:FindFirstChild("BoardPrompt")
			if prompt and not prompt:IsA("ProximityPrompt") then retire(prompt, "_Old"); prompt = nil end
			if not prompt then prompt = Instance.new("ProximityPrompt"); prompt.Name = "BoardPrompt" end
			prompt.ActionText, prompt.ObjectText = "Look at jobs", "Job Board"
			prompt.KeyboardKeyCode = Enum.KeyCode.E -- the standard interact key (the skill is Q)
			prompt.HoldDuration, prompt.MaxActivationDistance = 0, math.min(12, tonumber(B.Range) or 14)
			prompt.RequiresLineOfSight = false
			prompt.Enabled = B.Enabled == true
			prompt:SetAttribute("Board", tostring(id))
			prompt.Parent = host
		end
	end
end

-- invisible, non-colliding SpawnLocation (PlayerService places characters; this only avoids spawning at the origin)
local function buildPreviewSpawn(ctx, landmarks)
	if landmarks:FindFirstChild("PreviewSpawn") then return end
	local spawn = part(ctx, {
		Name = "PreviewSpawn", Size = Vector3.new(8, 1, 8), Position = Config.Zones.Crossroads.Spawn + Vector3.new(0, 0.1, 0),
		Color = RGB(200, 200, 200), Transparency = 1, CanCollide = false,
	}, landmarks, "SpawnLocation")
	spawn.Neutral = true
	spawn.Duration = 0 -- spawn protection is PvPService's ForceField, not the SpawnLocation's
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then decal:Destroy() end
end

-- The potion shop NPC: prompt on its root. The shop stays absent/disabled until Config.Vitals.MerchantEnabled.
local function ensureMerchantPrompt(merchant, tune)
	local root = merchant.PrimaryPart
	if not root or not root:IsA("BasePart") or not root:IsDescendantOf(merchant) then return false end
	local prompt = root:FindFirstChild(tune.PotionMerchantPrompt)
	if prompt and not prompt:IsA("ProximityPrompt") then retire(prompt, "_Old"); prompt = nil end
	if not prompt then prompt = Instance.new("ProximityPrompt"); prompt.Name = tune.PotionMerchantPrompt end
	prompt.ActionText, prompt.ObjectText = "Buy potions", tune.PotionMerchantLabel or "Potion Seller" -- ⑪ Fizzby
	prompt.KeyboardKeyCode = Enum.KeyCode.E -- standard interact key; the skill is Q only
	prompt.HoldDuration, prompt.MaxActivationDistance = 0, tune.PotionMerchantDistance -- a shop opens on a tap
	prompt.RequiresLineOfSight, prompt.Enabled = false, true
	prompt:SetAttribute("Conversation", true) -- verified NPC interaction
	prompt.Parent = root
	CollectionService:AddTag(merchant, "NPC")
	return true
end

local function ensurePotionMerchant(ctx, folder)
	local tune = Config.Vitals
	local merchant = folder:FindFirstChild(tune.PotionMerchantName)
	local function disableExisting()
		local part = merchant and merchant:IsA("Model") and merchant.PrimaryPart
		local prompt = part and part:FindFirstChild(tune.PotionMerchantPrompt)
		if prompt and prompt:IsA("ProximityPrompt") then prompt.Enabled = false end
	end
	if tune.MerchantEnabled ~= true then disableExisting(); return end
	if merchant and (not merchant:IsA("Model") or merchant:GetAttribute("HHC_PotionMerchant") ~= true) then
		Util.Warn(TAG, "PotionMerchant name is occupied by unrelated content; skipped")
		return
	end
	if merchant then
		ensureMerchantPrompt(merchant, tune)
		return
	end
	local offset = tune.PotionMerchantOffset
	if type(offset) ~= "table" or type(offset.X) ~= "number" or type(offset.Z) ~= "number"
		or offset.X ~= offset.X or offset.Z ~= offset.Z or math.abs(offset.X) > 30 or math.abs(offset.Z) > 30 then return end
	ctx.pieces += 1
	-- A23-6: a temporary default Roblox-style NPC built from a HumanoidDescription (no costume rig, no new art).
	-- Building the body loads Roblox's default meshes (yields), so it runs after Build returns (Build never yields).
	task.spawn(function()
		local colors = tune.PotionMerchantColors or {}
		local made, npc = pcall(function()
			local desc = Instance.new("HumanoidDescription")
			desc.HeadColor = colors.Head or Color3.fromRGB(234, 184, 146)
			desc.LeftArmColor, desc.RightArmColor = desc.HeadColor, desc.HeadColor
			desc.TorsoColor = colors.Torso or Color3.fromRGB(46, 120, 92)
			desc.LeftLegColor = colors.Legs or Color3.fromRGB(70, 55, 45)
			desc.RightLegColor = desc.LeftLegColor
			return game:GetService("Players"):CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		if not made or not npc then Util.Warn(TAG, "PotionMerchant NPC build failed: " .. tostring(npc)); return end
		if folder:FindFirstChild(tune.PotionMerchantName) then npc:Destroy(); return end -- built meanwhile
		local prepared, why = pcall(function()
			npc.Name = tune.PotionMerchantName
			for _, child in npc:GetDescendants() do
				if child:IsA("LuaSourceContainer") then
					child:Destroy()
				elseif child:IsA("BasePart") then
					child.Anchored = true
					child.CanCollide, child.CanTouch, child.CanQuery = false, false, false
				end
			end
			local humanoid = npc:FindFirstChildOfClass("Humanoid")
			local root = npc:FindFirstChild("HumanoidRootPart")
			assert(humanoid and root and root:IsA("BasePart"), "default NPC has no root/humanoid")
			humanoid.WalkSpeed, humanoid.JumpPower, humanoid.AutoRotate = 0, 0, false
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			npc.PrimaryPart = root
			local pivot = npc:GetPivot()
			local bounds, size = npc:GetBoundingBox()
			local target = Config.Zones.Crossroads.Spawn + Vector3.new(offset.X, 0, offset.Z)
			npc:PivotTo(pivot + Vector3.new(target.X - pivot.Position.X,
				target.Y - (bounds.Position.Y - size.Y * 0.5), target.Z - pivot.Position.Z))
			npc:SetAttribute("HHC_PotionMerchant", true)
			npc:SetAttribute("HHC_MerchantLook", "DefaultNPC") -- final look: Firefly redraw (A23-6)
			assert(ensureMerchantPrompt(npc, tune), "default NPC root is invalid")
			npc.Parent = folder
		end)
		if not prepared then npc:Destroy(); Util.Warn(TAG, "PotionMerchant preparation failed: " .. tostring(why)) end
	end)
end

------------------------------------------------------------------ public API
-- ENSURE: reuse workspace.Map if present, create only what is missing. No S, no yields, idempotent.
-- A reused map never gets ground or decor (its world is Terrain); a fresh one gets the A11-R3 minimal ground.
------------------------------------------------------------------ A23-30 PumpkinPatch (Halloween field)
-- Terrain land joined to the meadow's south shore (Config.Map.Lands "LandPumpkinPatch"; filled only while that spot is
-- still sea), a dirt path from the meadow road, furrows, pumpkins and a fence (plain parts, no new art) in
-- Map.Decor.PumpkinPatch, and the one road sign Map.Landmarks.PumpkinPatchSign (HalloweenService hides it out of
-- season). Idempotent: every piece is looked up by name first. Map v2 (A23-53): the path, gates and sign come from
-- Config.Map.Halloween; the coast is an open beach (no ridge), so the fence is the field's edge.
local HW = type(Config.Map.Halloween) == "table" and Config.Map.Halloween or {}
local PATCH = {
	Land = "LandPumpkinPatch",
	Pumpkin = RGB(235, 128, 34), Stem = RGB(92, 112, 44), Wood = RGB(128, 92, 58),
	Soil = Enum.Material.Mud, -- the Tex_PumpkinSoil slot (Config.Zones.PumpkinPatch.FloorMaterial); Ground = ruins soil
	PathX = tonumber(HW.PathX) or 535, PathHalfW = 6, PathFromZ = 9, -- from the meadow road (|z| <= 9) south into the patch
	-- a pass is cut only if something still stands on the path between the meadow and the patch (the v1 ridge)
	PassHalfW = 9, PassReach = 30, -- the cut runs PassReach studs either side of the patch's north edge
	FurrowStep = 24, PostStep = 16, Gate = 10, -- a 4-stud furrow every 24 studs; fence post every 16; gate half-width
	FenceInset = 2, -- the north fence 2 studs inside the land edge; pumpkins from 9 studs past it
	PumpkinStepX = 34,
	WestGateZ = (typeof(HW.HollowGate) == "Vector3" and HW.HollowGate.Z) or 340, -- A23-45: the gap into the HauntedHollow
	-- no pumpkins on the giant pumpkin house (world_map_v2 landmark, a later kit) or the hollow road
	Keep = { { Vector3.new(585, 0, 370), 34 } },
	SignPos = typeof(HW.SignPos) == "Vector3" and HW.SignPos or Vector3.new(525, 0, 226), -- west of the path; A23-36: no text
}

function PATCH.rect()
	for _, l in (type(Config.Map.Lands) == "table" and Config.Map.Lands or {}) do
		if type(l) == "table" and l.Name == PATCH.Land then return l end
	end
	return nil
end

function PATCH.northZ(l)
	return l.MinZ + PATCH.FenceInset
end

function PATCH.terrainHit(x, z)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	return workspace:Raycast(Vector3.new(x, 120, z), Vector3.new(0, -200, 0), params)
end

-- true while the patch centre is still sea (or nothing): then the land is filled once
function PATCH.landMissing(cx, cz)
	local hit = PATCH.terrainHit(cx, cz)
	return hit == nil or hit.Material == Enum.Material.Water
end

function PATCH.fillLand(l)
	local T = workspace.Terrain
	local w, d = l.MaxX - l.MinX, l.MaxZ - l.MinZ
	local cx, cz = (l.MinX + l.MaxX) / 2, (l.MinZ + l.MaxZ) / 2
	-- tools/preview_map.lua land(): FillBlock tops land 2 cells above the asked top, so every fill sits 2 lower
	T:FillBlock(CFrame.new(cx, -12, cz), Vector3.new(w + 16, 8, d + 16), Enum.Material.Sand)
	-- pumpkin soil (Mud = the Tex_PumpkinSoil slot) with leafy rows between the furrows
	T:FillBlock(CFrame.new(cx, -8, cz), Vector3.new(w, 12, d), PATCH.Soil)
	for z = l.MinZ + PATCH.FurrowStep + 12, l.MaxZ - 12, PATCH.FurrowStep do
		T:FillBlock(CFrame.new(cx, -4, z), Vector3.new(w - 24, 4, 4), Enum.Material.LeafyGrass)
	end
end

-- true while something higher than a step stands on the path where it crosses into the patch
function PATCH.passBlocked(l)
	local hit = PATCH.terrainHit(PATCH.PathX, l.MinZ)
	return hit ~= nil and hit.Position.Y > 3
end

-- the soil path from the meadow road to the north gate is missing (an older place, or a fresh Terrain)
function PATCH.pathMissing(l)
	local hit = PATCH.terrainHit(PATCH.PathX, (PATCH.PathFromZ + l.MinZ) / 2)
	return hit == nil or (hit.Material ~= PATCH.Soil and hit.Material ~= Enum.Material.Water)
end

-- the pass (cleared above the floor, floor at Y = 0) where the path enters the patch
function PATCH.cutPass(l)
	local T = workspace.Terrain
	local fromZ, toZ = l.MinZ - PATCH.PassReach, l.MinZ + PATCH.PassReach
	local midZ, w = (fromZ + toZ) / 2, PATCH.PassHalfW * 2
	T:FillBlock(CFrame.new(PATCH.PathX, 50, midZ), Vector3.new(w, 100, toZ - fromZ), Enum.Material.Air)
	T:FillBlock(CFrame.new(PATCH.PathX, -8, midZ), Vector3.new(w, 12, toZ - fromZ), Enum.Material.Grass)
end

-- the dirt path from the meadow road (|z| <= 9) to the north gate (a soil strip on the meadow grass)
function PATCH.paintPath(l)
	local fromZ, toZ = PATCH.PathFromZ, PATCH.northZ(l) + 4
	workspace.Terrain:FillBlock(CFrame.new(PATCH.PathX, -4, (fromZ + toZ) / 2), Vector3.new(PATCH.PathHalfW * 2, 4, toZ - fromZ),
		PATCH.Soil)
end

function PATCH.keepClear(px, pz)
	for _, k in PATCH.Keep do
		if Vector3.new(px - k[1].X, 0, pz - k[1].Z).Magnitude < k[2] then return false end
	end
	-- the hollow road (Config.Map.Roads RoadHollow: the west gate -> the path, z WestGateZ +- 5)
	if math.abs(pz - PATCH.WestGateZ) < 9 and px < PATCH.PathX + 6 then return false end
	return math.abs(px - PATCH.PathX) > 8
end

function PATCH.decor(ctx, l, decor)
	if decor:FindFirstChild("PumpkinPatch") then return end
	local m = model("PumpkinPatch")
	local rng = Random.new(1031) -- the same field every build
	local north = PATCH.northZ(l)
	-- pumpkins on the furrows: an orange ball, a stem and one leaf
	for z = math.max(l.MinZ + PATCH.FurrowStep, north + 9), l.MaxZ - 10, PATCH.FurrowStep do
		for x = l.MinX + 18, l.MaxX - 18, PATCH.PumpkinStepX do
			local px, pz = x + rng:NextNumber(-6, 6), z + rng:NextNumber(-1.5, 1.5)
			if PATCH.keepClear(px, pz) then
				local size = rng:NextNumber(2.2, 3.8)
				prop(ctx, { Name = "Pumpkin", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size),
					Position = Vector3.new(px, size * 0.42, pz), Color = PATCH.Pumpkin }, m)
				prop(ctx, { Name = "Stem", Size = Vector3.new(0.35, size * 0.3, 0.35),
					Position = Vector3.new(px, size * 0.92, pz), Color = PATCH.Stem }, m)
				prop(ctx, { Name = "Leaf", Size = Vector3.new(size * 0.45, 0.1, size * 0.3),
					CFrame = CFrame.new(px + size * 0.3, size * 0.2, pz + size * 0.25) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
					Color = PATCH.Stem }, m)
			end
		end
	end
	-- a low fence around the field with a gate in the north side (the path) and one in the west side (the hollow)
	local function post(x, z)
		prop(ctx, { Name = "FencePost", Size = Vector3.new(0.8, 3.2, 0.8), Position = Vector3.new(x, 1.6, z),
			Color = PATCH.Wood, Material = Enum.Material.WoodPlanks }, m)
	end
	local function rail(a, b)
		local mid, len = (a + b) / 2, (b - a).Magnitude
		prop(ctx, { Name = "FenceRail", Size = Vector3.new(0.4, 0.45, len),
			CFrame = CFrame.lookAt(mid + Vector3.new(0, 2.2, 0), b + Vector3.new(0, 2.2, 0)),
			Color = PATCH.Wood, Material = Enum.Material.WoodPlanks }, m)
	end
	local corners = { Vector3.new(l.MinX, 0, north), Vector3.new(l.MaxX, 0, north), Vector3.new(l.MaxX, 0, l.MaxZ),
		Vector3.new(l.MinX, 0, l.MaxZ) }
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		local n = math.max(1, math.floor((b - a).Magnitude / PATCH.PostStep + 0.5))
		for k = 0, n - 1 do
			local p0, p1 = a:Lerp(b, k / n), a:Lerp(b, (k + 1) / n)
			local gate = (i == 1 and math.abs((p0.X + p1.X) / 2 - PATCH.PathX) < PATCH.Gate)
				or (i == 4 and math.abs((p0.Z + p1.Z) / 2 - PATCH.WestGateZ) < PATCH.Gate)
			-- no post in the middle of a gate gap (the north one stood on the dirt path)
			local midGate = (i == 1 and math.abs(p0.X - PATCH.PathX) < PATCH.Gate - 1)
				or (i == 4 and math.abs(p0.Z - PATCH.WestGateZ) < PATCH.Gate - 1)
			if not midGate then post(p0.X, p0.Z) end
			if not gate then rail(p0, p1) end
		end
	end
	m.Parent = decor
	ctx.pieces += 1
end

-- the road sign at the path's meadow end: a post and a blank pumpkin-orange board (HalloweenService shows it only in
-- season). A23-36: no billboard text on it any more (an older "SignGui" is removed); the quest marker points into the
-- field. Map v2: a sign left on the old spot moves to PATCH.SignPos.
function PATCH.sign(ctx, landmarks)
	local sign = landmarks:FindFirstChild("PumpkinPatchSign")
	local p = PATCH.SignPos
	if not sign then
		sign = model("PumpkinPatchSign")
		local postPart = part(ctx, { Name = "Post", Size = Vector3.new(0.8, 6, 0.8), Position = p + Vector3.new(0, 3, 0),
			Color = PATCH.Wood, Material = Enum.Material.WoodPlanks }, sign)
		postPart:SetAttribute("ShownTransparency", 0)
		postPart:SetAttribute("ShownCollide", true)
		local board = part(ctx, { Name = "Board", Size = Vector3.new(6, 2.2, 0.4), Position = p + Vector3.new(0, 5.2, 0),
			Color = PATCH.Pumpkin, Material = Enum.Material.WoodPlanks, CanCollide = false }, sign)
		board:SetAttribute("ShownTransparency", 0)
		board:SetAttribute("ShownCollide", false)
		sign.PrimaryPart = postPart
		sign.Parent = landmarks
		ctx.pieces += 1
	elseif sign:IsA("Model") then
		local postPart = sign:FindFirstChild("Post")
		local at = (postPart and postPart:IsA("BasePart")) and postPart.Position or sign:GetPivot().Position
		local delta = Vector3.new(p.X - at.X, 0, p.Z - at.Z)
		if delta.Magnitude > 0.5 then sign:PivotTo(sign:GetPivot() + delta) end
	end
	for _, d in sign:GetDescendants() do
		if d:IsA("BillboardGui") then d:Destroy() end
	end
end

-- also used by MapBuilder.EnsurePumpkinPatch (Studio command bar / checks)
function PATCH.ensure(ctx, folders)
	local l = PATCH.rect()
	if not l then return end
	if PATCH.landMissing((l.MinX + l.MaxX) / 2, (l.MinZ + l.MaxZ) / 2) then
		local ok, err = pcall(PATCH.fillLand, l)
		if ok then ctx.pieces += 1 else Util.Warn(TAG, "PumpkinPatch land: " .. tostring(err)) end
	end
	if PATCH.passBlocked(l) then
		local ok, err = pcall(PATCH.cutPass, l)
		if ok then ctx.pieces += 1 else Util.Warn(TAG, "PumpkinPatch pass: " .. tostring(err)) end
	end
	if PATCH.pathMissing(l) then
		local ok, err = pcall(PATCH.paintPath, l)
		if ok then ctx.pieces += 1 else Util.Warn(TAG, "PumpkinPatch path: " .. tostring(err)) end
	end
	PATCH.decor(ctx, l, folders.Decor)
	PATCH.sign(ctx, folders.Landmarks)
end

------------------------------------------------------------------ A23-45 HauntedHollow (the ghost family's field)
-- Terrain land joined to the PumpkinPatch's west edge (Config.Map.Lands "LandHauntedHollow", filled only while that
-- spot is still sea) and Map.Decor.HauntedHollow: the free generated GF_* props of image session 1 (art/models/worldkit/
-- manifest.json ghost_forest, inserted into ServerStorage.KitStage by tools/apply_crossroads_kit.py) or plain-part
-- stand-ins without them. Blue lantern lights within the map light budget, no fog (A23-30 / A23-45 mood: ZoneLook).
-- Map v2: every prop sits at the same share of the land rectangle as in image session 1's v1 layout (U, V from the
-- west / north edge), the entrance arch just inside the patch's west gate.
local HOLLOW = {
	Land = "LandHauntedHollow",
	Soil = Enum.Material.Asphalt, -- the Tex_HauntedFloor slot (GE_HauntedFloor, tools/apply_surface_materials.lua)
	LanternLight = Color3.fromRGB(150, 200, 255),
	ArchInset = 7, -- the arch stands this far inside the west gate (its front faces the gate, +X)
	-- { kit, U, V, size along fit, fit ("h" | "w"), yaw, solid, lit }
	Props = {
		{ "GF_Tree", 0.125, 0.136, 17, "h", 20, true }, { "GF_Tree", 0.1, 0.545, 16, "h", 140, true },
		{ "GF_Tree", 0.183, 0.9, 18, "h", 250, true }, { "GF_Tree", 0.542, 0.964, 15, "h", 80, true },
		{ "GF_Tree", 0.85, 0.936, 16, "h", 310, true }, { "GF_Tree", 0.817, 0.127, 17, "h", 200, true },
		{ "GF_Tree", 0.433, 0.109, 15, "h", 0, true },
		{ "GF_Willow", 0.317, 0.736, 14, "h", 30, true }, { "GF_Willow", 0.7, 0.245, 14, "h", 160, true },
		{ "GF_Lantern", 0.6, 0.564, 9, "h", 0, true, true }, { "GF_Lantern", 0.267, 0.373, 9, "h", 90, true, true },
		{ "GF_Lantern", 0.783, 0.755, 9, "h", 200, true, true },
		{ "GF_Mushrooms", 0.417, 0.482, 2.5, "h", 0, false }, { "GF_Mushrooms", 0.167, 0.264, 2.5, "h", 70, false },
		{ "GF_Mushrooms", 0.75, 0.627, 2.5, "h", 140, false }, { "GF_Mushrooms", 0.533, 0.827, 2.5, "h", 210, false },
		{ "GF_Rock", 0.25, 0.609, 2.5, "h", 0, true }, { "GF_Rock", 0.883, 0.373, 2.5, "h", 60, true },
		{ "GF_Rock", 0.467, 0.264, 2.5, "h", 120, true },
	},
}

function HOLLOW.rect()
	for _, l in (type(Config.Map.Lands) == "table" and Config.Map.Lands or {}) do
		if type(l) == "table" and l.Name == HOLLOW.Land then return l end
	end
	return nil
end

-- a prop's world X / Z from its share of the rectangle
function HOLLOW.at(l, u, v)
	return l.MinX + u * (l.MaxX - l.MinX), l.MinZ + v * (l.MaxZ - l.MinZ)
end

function HOLLOW.fillLand(l)
	local T = workspace.Terrain
	local w, d = l.MaxX - l.MinX, l.MaxZ - l.MinZ
	local cx, cz = (l.MinX + l.MaxX) / 2, (l.MinZ + l.MaxZ) / 2
	-- same layering as PATCH.fillLand (FillBlock tops land 2 cells above the asked top)
	T:FillBlock(CFrame.new(cx, -12, cz), Vector3.new(w + 16, 8, d + 16), Enum.Material.Sand)
	T:FillBlock(CFrame.new(cx, -8, cz), Vector3.new(w, 12, d), HOLLOW.Soil)
end

-- a GF_* kit model clone sized / turned / grounded at (x, z), or nil when the kit model is missing
function HOLLOW.kitProp(name, x, z, size, fit, yaw)
	local stage = ServerStorage:FindFirstChild("KitStage")
	local src = stage and stage:FindFirstChild(name)
	if not (src and src:IsA("Model")) then return nil end
	local m = src:Clone()
	for _, d in m:GetDescendants() do
		if d:IsA("LuaSourceContainer") then d:Destroy() end -- A23-33: kit models never carry scripts
	end
	local _, sz = m:GetBoundingBox()
	local dim = fit == "w" and sz.X or sz.Y
	if dim > 0 then pcall(m.ScaleTo, m, m:GetScale() * (size / dim)) end
	m:PivotTo(CFrame.new(m:GetPivot().Position) * CFrame.Angles(0, math.rad(yaw or 0), 0))
	local cf, bs = m:GetBoundingBox()
	m:PivotTo(m:GetPivot() + (Vector3.new(x, bs.Y / 2, z) - cf.Position))
	return m
end

-- plain-part stand-in (no kit model): a dark trunk + lavender ball for trees, a post + blue glass for lanterns, ...
function HOLLOW.standIn(ctx, name, x, z, size, parent)
	local m = model(name)
	if name == "GF_Tree" or name == "GF_Willow" then
		part(ctx, { Name = "Trunk", Size = Vector3.new(2, size * 0.55, 2), Position = Vector3.new(x, size * 0.275, z),
			Color = RGB(70, 50, 90), Material = Enum.Material.Wood }, m)
		prop(ctx, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(size * 0.6, size * 0.6, size * 0.6),
			Position = Vector3.new(x, size * 0.7, z), Color = RGB(160, 140, 220) }, m)
	elseif name == "GF_Lantern" then
		part(ctx, { Name = "Post", Size = Vector3.new(0.8, size, 0.8), Position = Vector3.new(x, size / 2, z),
			Color = RGB(80, 60, 70), Material = Enum.Material.Wood }, m)
		prop(ctx, { Name = "Glass", Size = Vector3.new(1.6, 1.8, 1.6), Position = Vector3.new(x, size + 0.6, z),
			Color = RGB(150, 200, 255), Material = NEON }, m)
	elseif name == "GF_Arch" then
		for _, dz in { -8, 8 } do
			part(ctx, { Name = "Pillar", Size = Vector3.new(2, 14, 2), Position = Vector3.new(x, 7, z + dz),
				Color = RGB(70, 50, 90), Material = Enum.Material.Wood }, m)
		end
	else -- mushrooms / rocks: one small ball
		prop(ctx, { Name = "Blob", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size),
			Position = Vector3.new(x, size * 0.4, z), Color = name == "GF_Rock" and RGB(110, 105, 125) or RGB(120, 190, 255) }, m)
	end
	m.Parent = parent
	return m
end

function HOLLOW.place(ctx, root, name, x, z, size, fit, yaw, solid, lit)
	local m = HOLLOW.kitProp(name, x, z, size, fit, yaw)
	if m then
		m.Parent = root
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				if not solid then d.CanCollide = false end
			end
		end
	else
		m = HOLLOW.standIn(ctx, name, x, z, size, root)
	end
	if lit then
		local holder = part(ctx, { Name = "LanternLight", Size = Vector3.new(0.4, 0.4, 0.4),
			Position = Vector3.new(x, size * 0.95, z), Transparency = 1, CanCollide = false }, m)
		light(ctx, holder, HOLLOW.LanternLight, 16, 1.4)
	end
end

function HOLLOW.decor(ctx, l, decor)
	if decor:FindFirstChild("HauntedHollow") then return end
	local root = model("HauntedHollow")
	-- the entrance from the pumpkin field's west gate (front -> +X)
	HOLLOW.place(ctx, root, "GF_Arch", l.MaxX - HOLLOW.ArchInset, PATCH.WestGateZ, 18, "w", -90, false)
	for _, e in HOLLOW.Props do
		local x, z = HOLLOW.at(l, e[2], e[3])
		HOLLOW.place(ctx, root, e[1], x, z, e[4], e[5], e[6], e[7], e[8])
	end
	root.Parent = decor
	ctx.pieces += 1
end

function HOLLOW.ensure(ctx, folders)
	local l = HOLLOW.rect()
	if not l then return end
	if PATCH.landMissing((l.MinX + l.MaxX) / 2, (l.MinZ + l.MaxZ) / 2) then
		local ok, err = pcall(HOLLOW.fillLand, l)
		if ok then ctx.pieces += 1 else Util.Warn(TAG, "HauntedHollow land: " .. tostring(err)) end
	end
	HOLLOW.decor(ctx, l, folders.Decor)
end

function MapBuilder.Build()
	local ctx = newCtx()
	local map = workspace:FindFirstChild("Map")
	local fresh = map == nil
	if fresh then
		Util.Warn(TAG, "no pre-built map: building minimal ground")
		map = Instance.new("Folder")
		map.Name = "Map" -- parented at the end: nobody sees (or touches) a half-built map
	end

	local folders = {}
	for _, name in FOLDER_NAMES do
		local folder, created = getChildFolder(map, name)
		folders[name] = folder
		if created and not fresh then ctx.pieces += 1 end
	end

	if fresh then
		buildMinimalGround(ctx, folders.Ground, folders.Decor)
	end
	ensureZones(ctx, folders.Zones)
	ensureWalls(ctx, folders.Walls)
	ensureGates(ctx, folders.Gates)
	ensurePads(ctx, folders.Pads)
	ensureLandmarks(ctx, folders.Landmarks)
	ensureJobBoards(ctx, folders.Landmarks)
	ensurePotionMerchant(ctx, folders.NPCs)
	local okPatch, errPatch = pcall(PATCH.ensure, ctx, folders) -- A23-30
	if not okPatch then Util.Warn(TAG, "PumpkinPatch: " .. tostring(errPatch)) end
	local okHollow, errHollow = pcall(HOLLOW.ensure, ctx, folders) -- A23-45
	if not okHollow then Util.Warn(TAG, "HauntedHollow: " .. tostring(errHollow)) end
	-- A23-36: shop / landmark name labels (altar, goose nest, market, anvil) stay, seen only up close
	for _, d in folders.Landmarks:GetDescendants() do
		if d:IsA("BillboardGui") and d.MaxDistance > SHOP_SIGN_MAX_DISTANCE and d:FindFirstChildWhichIsA("TextLabel", true) then
			d.MaxDistance = SHOP_SIGN_MAX_DISTANCE
		end
		if d:IsA("BillboardGui") and d.Name == "PerchSign" then -- a nest label already saved in the place
			d.Size = UDim2.fromOffset(PERCH_SIGN.Width, PERCH_SIGN.Height)
			d.StudsOffset = Vector3.new(0, PERCH_SIGN.OffsetY, 0)
			d.MaxDistance = PERCH_SIGN.MaxDistance
		end
	end

	if fresh then
		buildPreviewSpawn(ctx, folders.Landmarks)
		map.Parent = workspace
	end

	-- shared runtime folders + the custom-model drop folder (addendum A1)
	Util.GetFolder(workspace, "Monsters")
	Util.GetFolder(workspace, "Effects")
	Util.GetFolder(ServerStorage, "CustomModels")

	if fresh then
		local total = countParts(map)
		if total > Config.Map.MaxParts then
			Util.Warn(TAG, ("built %d map parts; Config.Map.MaxParts is %d"):format(total, Config.Map.MaxParts))
		end
		print(("[MapBuilder] built workspace.Map (%d parts)"):format(total))
	else
		print(("[MapBuilder] reused workspace.Map (+%d missing pieces built)"):format(ctx.pieces))
	end
	return map
end

-- A23-30: only the PumpkinPatch pieces (land, pass, path, decor, sign); returns { land, pass, path } = what it had to make
function MapBuilder.EnsurePumpkinPatch()
	local map = workspace:FindFirstChild("Map")
	if not map then return nil end
	local folders = {}
	for _, name in FOLDER_NAMES do folders[name] = getChildFolder(map, name) end
	local l = PATCH.rect()
	local made = { land = l ~= nil and PATCH.landMissing((l.MinX + l.MaxX) / 2, (l.MinZ + l.MaxZ) / 2),
		pass = l ~= nil and PATCH.passBlocked(l), path = l ~= nil and PATCH.pathMissing(l) }
	PATCH.ensure(newCtx(), folders)
	return made
end

-- destroy workspace.Map, then Build() (Studio command bar helper)
function MapBuilder.Rebuild()
	local old = workspace:FindFirstChild("Map")
	if old then old:Destroy() end
	return MapBuilder.Build()
end

local function findLandmark(name)
	local map = workspace:FindFirstChild("Map")
	local landmarks = map and map:FindFirstChild("Landmarks")
	return landmarks and landmarks:FindFirstChild(name)
end

local function findAltar()
	local altar = findLandmark("Altar")
	if altar and altar:IsA("BasePart") and altar:FindFirstChild("AltarPrompt") then return altar end
	return nil
end

local function findBoardLabel()
	local board = findLandmark("MostWantedBoard")
	local gui = board and board:FindFirstChild("BoardGui")
	local label = gui and gui:FindFirstChild("BoardText")
	if label and label:IsA("TextLabel") then return label end
	return nil
end

-- workspace.Map.Landmarks.Altar (child ProximityPrompt "AltarPrompt"); rebuilt on demand if it went missing
function MapBuilder.GetAltar()
	local altar = findAltar()
	if not altar then
		MapBuilder.Build()
		altar = findAltar()
	end
	return altar
end

-- workspace.Map.Landmarks.MostWantedBoard.BoardGui.BoardText; rebuilt on demand if it went missing
function MapBuilder.GetBoardLabel()
	local label = findBoardLabel()
	if not label then
		MapBuilder.Build()
		label = findBoardLabel()
	end
	return label
end

function MapBuilder.Init(registry)
	S = registry
end

function MapBuilder.Start()
	MapBuilder.Build() -- synchronous
	print("[MapBuilder] started")
end

return MapBuilder
]]></ProtectedString>
				<string name="ScriptGuid">{004BB579-4EA9-4DA6-9B7B-E68F3E2C0605}</string>
