	HintMouse = "드래그: 이동 · 휠: 확대/축소 · M / Esc: 닫기",
	HintTouch = "드래그: 이동 · 두 손가락: 확대/축소",
	Crown = "균형의 왕관",
	Altar = "운명의 제단",
