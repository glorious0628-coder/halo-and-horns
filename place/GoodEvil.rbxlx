				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Main</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f3690000110f</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXD9A1A0EA134C49549BC096A49D30D3BE">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ShopService.luau : the UpgradeWeapon remote (TECH_SPEC §4.19). Buys the next weapon tier for the player's class.
-- CharacterVisuals rebuilds the weapon model from the WeaponTier attribute change.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local M = {}

local S = nil

local function notifyBad(player, key, ...)
	Net.Notify(player, string.format(Config.Text[key], ...), "bad")
end

local function onUpgradeWeapon(player)
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "UpgradeWeapon", Config.RateLimits.UpgradeWeapon) then return end

	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return end

	local maxTier = Config.MaxWeaponTier
	local tier = math.clamp(math.floor(tonumber(data.WeaponTier) or 1), 1, maxTier)
	if tier >= maxTier then
		notifyBad(player, "WeaponMaxed")
		return
	end

	local nextTier = tier + 1
	local nextDef = Config.Weapons[nextTier]
	if type(nextDef) ~= "table" then
		notifyBad(player, "WeaponMaxed")
		return
	end

	local level = tonumber(data.Level) or 1
	local minLevel = tonumber(nextDef.MinLevel) or 1
	if level < minLevel then
		notifyBad(player, "WeaponNeedLevel", minLevel)
		return
	end

	-- the faction weapon needs a chosen faction (Halo, Horns or Neutral — never "None")
	local faction = S.FactionService.GetFaction(player)
	if type(faction) ~= "string" then faction = "None" end
	if nextDef.RequiresFaction and faction == "None" then
		notifyBad(player, "NeedFaction")
		return
	end

	if not S.ProgressionService.SpendGold(player, tonumber(nextDef.Price) or 0) then
		notifyBad(player, "NotEnoughGold")
		return
	end

	S.PlayerService.SetStat(player, "WeaponTier", nextTier)
	local weaponName = Config.WeaponName(nextTier, S.ClassService.GetClass(player), faction)
	Net.Notify(player, string.format(Config.Text.WeaponBought, weaponName), "reward")
	Net.Fx(player, "Upgrade", { Tier = nextTier })
end

function M.Init(registry)
	S = registry
end

function M.Start()
	Net.Get("UpgradeWeapon").OnServerEvent:Connect(onUpgradeWeapon)
	print("[ShopService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{8A4526F8-C0A8-4534-AAF6-519C0674A538}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ShopService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f3690000111f</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX517B0B82328E4835A0F8B7A4A057D80C">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- CombatService.luau : class swing patterns, charge & release ("자동은 장전, 손은 발사"), damage formulas,
-- player damage / heal, regen, auto-attack and the death pipeline (the ONLY KO entry point).
-- Server-authoritative: clients only send Swing / Release / SetAutoAttack intents.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "CombatService"

local CombatService = {}

------------------------------------------------------------------ public signals (top level)
-- info = { Stacks, Auto, Perfect, Center, Radius, Total, MonstersHit, PlayersHit, Healed = { Player } }
CombatService.Released = Util.Signal.new()
-- (victim, amount, attacker) : fired by DamagePlayer only when attacker ~= nil, after the damage
CombatService.PlayerDamaged = Util.Signal.new()

local S = nil

------------------------------------------------------------------ private constants
-- addendum H3 auto-loop yield = Config.Combat.ManualPriority; addendum M3 hint = Config.Text.AutoUnderAttack
-- at most once per Config.Combat.AutoPvPHintCooldown (CombatService.DamagePlayer is the single sender)
local MANUAL_GRACE = 0.2 -- a manual request this close to the swing-ready time is queued (network jitter on "hold")
local MANUAL_QUEUE_RETRIES = 3 -- timer-precision retries for a queued manual swing
local WHIFF_REACH = 12 -- studs in front of the player used as the visual target of a whiffed ranged swing
local LOOP_WARN_INTERVAL = 10 -- seconds between two warnings of the same loop

-- factions that take part in PvP / goose tug (addendum A6: "Neutral" and "None" never do)
local PVP_FACTIONS = { Halo = true, Horns = true }

------------------------------------------------------------------ per-player state (session only)
local charge = {} -- [Player] = stacks (may be fractional)
local perfectUntil = {} -- [Player] = server time (Util.Now) of the PERFECT window end, 0 = none
local nextSwingAt = {} -- [Player] = os.clock() when the next swing is allowed (shared by manual + auto)
local lastSwingAuto = {} -- [Player] = true if the last executed swing was an auto swing
local lastManualAt = {} -- [Player] = os.clock() of the last accepted manual swing request
local pendingManual = {} -- [Player] = true while one queued manual swing waits for the cooldown
local lastDamagedAt = {} -- [Player] = os.clock() of the last damage of any kind
local lastPvPAttacker = {} -- [Player] = { Player = Player, T = os.clock() }
local lastPvPTime = {} -- [Player] = os.clock() of the last PvP damage dealt or received
local autoHintAt = {} -- [Player] = os.clock() of the last M3 hint
local lastLoopWarn = {} -- [loopName] = os.clock()

------------------------------------------------------------------ small helpers
local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function numAttr(player, key, default)
	local v = player:GetAttribute(key)
	if type(v) ~= "number" or v ~= v then
		return default
	end
	return v
end

local function byDist(a, b)
	return a.Dist < b.Dist
end

local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= LOOP_WARN_INTERVAL then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

-- faction(p) = S.FactionService.GetFaction(p)
local function faction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then
		return "None"
	end
	return f
end

-- perks = S.FactionService.GetPerks(p) (falls back to the Config table / None)
local function perksOf(player)
	local p = S.FactionService.GetPerks(player)
	if type(p) ~= "table" then
		p = Config.Factions[faction(player)] or Config.Factions.None
	end
	return p
end

-- cls(p) = S.ClassService.GetClassDef(p)
local function cls(player)
	local c = S.ClassService.GetClassDef(player)
	if type(c) ~= "table" then
		c = Config.Classes.Warrior
	end
	return c
end

-- stars(p) = S.PvPService.GetStars(p)
local function stars(player)
	local n = S.PvPService.GetStars(player)
	if type(n) ~= "number" then
		return 0
	end
	return n
end

-- kstate(p) = S.KaijuService.GetState(p)
local function kstate(player)
	local st = S.KaijuService.GetState(player)
	if type(st) ~= "string" then
		return "None"
	end
	return st
end

local function chargeCapOf(player)
	local cap = perksOf(player).ChargeCap
	if type(cap) ~= "number" or cap <= 0 then
		cap = Config.Factions.None.ChargeCap
	end
	return cap
end

-- goose body center if this player's swings can count on it (Halo / Horns only), else nil
local function goosePositionFor(player)
	if not PVP_FACTIONS[faction(player)] then
		return nil
	end
	local pos = S.GooseService.GetPosition()
	if typeof(pos) ~= "Vector3" then
		return nil
	end
	return pos
end

local function handPosition(character, fallback)
	local hand = Util.FindPart(character, "RightHand", "Right Arm")
	if hand then
		return hand.Position
	end
	return fallback
end

-- a point `reach` studs in front of the root on the ground plane (visual target of a whiffed ranged swing)
local function forwardPoint(root, reach)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end
	return root.Position + flat * reach
end

------------------------------------------------------------------ charge
local function publishCharge(player)
	if player.Parent == nil then
		return
	end
	player:SetAttribute("Charge", charge[player] or 0)
	player:SetAttribute("ChargeCap", chargeCapOf(player))
	player:SetAttribute("PerfectUntil", perfectUntil[player] or 0)
end

local function resetCharge(player)
	charge[player] = 0
	perfectUntil[player] = 0
	publishCharge(player)
end

local function addCharge(player, amount)
	if type(amount) ~= "number" or amount <= 0 then
		return
	end
	if player.Parent == nil then
		return
	end
	local cap = chargeCapOf(player)
	local value = math.min(cap, (charge[player] or 0) + amount)
	charge[player] = value
	if value >= cap and (perfectUntil[player] or 0) == 0 then
		perfectUntil[player] = Util.Now() + Config.Charge.PerfectWindow
	end
	publishCharge(player)
end

------------------------------------------------------------------ target selection
-- alive monsters this player may hit within `radius` (flat) of `point`, nearest first: { { Rec, Pos, Dist } }
-- (addendum C2: always passes the attacking player; personal monsters of other players are filtered here too)
local function monstersNear(player, point, radius)
	local out = {}
	if radius <= 0 then
		return out
	end
	local list = S.MonsterService.GetMonstersInRadius(point, radius, player)
	if type(list) ~= "table" then
		return out
	end
	for _, rec in list do
		if type(rec) == "table" and rec.Alive and (rec.Owner == nil or rec.Owner == player) then
			local root = rec.Root
			if root and root.Parent then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius then
					table.insert(out, { Rec = rec, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- other players `attacker` may damage (S.PvPService.CanAttack) within `radius` (flat) of `point`, nearest first:
-- { { Player, Pos, Dist } }. Neutral / None never attack and are never attacked (addendum A6).
local function playersNear(attacker, point, radius)
	local out = {}
	if radius <= 0 or not PVP_FACTIONS[faction(attacker)] then
		return out
	end
	for _, v in S.PlayerService.GetReadyPlayers() do
		if v ~= attacker and v.Parent and PVP_FACTIONS[faction(v)] and Util.IsAlive(v) then
			local root = Util.GetRoot(v)
			if root then
				local pos = root.Position
				local d = Util.FlatDistance(pos, point)
				if d <= radius and S.PvPService.CanAttack(attacker, v) == true then
					table.insert(out, { Player = v, Pos = pos, Dist = d })
				end
			end
		end
	end
	table.sort(out, byDist)
	return out
end

-- other alive Halo players within the party-aura radius of the attacker
local function countAuraAllies(attacker, radius)
	if type(radius) ~= "number" or radius <= 0 then
		return 0
	end
	local root = Util.GetRoot(attacker)
	if not root then
		return 0
	end
	local n = 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if p ~= attacker and p.Parent and faction(p) == "Halo" and Util.IsAlive(p) then
			local r = Util.GetRoot(p)
			if r and Util.FlatDistance(r.Position, root.Position) <= radius then
				n += 1
			end
		end
	end
	return n
end

------------------------------------------------------------------ damage formulas (public)
-- additive bonus sum
function CombatService.GetDamageBonus(attacker, victim)
	local perks = perksOf(attacker)
	local bonus = perks.DamageBonus or 0
	bonus += stars(attacker) * Config.PvP.StarDamageBonus
	if faction(attacker) == "Halo" and (perks.PartyAuraPerAlly or 0) > 0 then
		local allies = math.min(perks.PartyAuraMaxAllies or 0, countAuraAllies(attacker, perks.PartyAuraRadius))
		bonus += perks.PartyAuraPerAlly * allies
	end
	if victim ~= nil and S.PvPService.HasRevenge(attacker, victim) == true then
		bonus += Config.Revenge.Bonus
	end
	return bonus
end

-- multiplicative factor: Size Justice S x bully factor (JusticeService) x ranged-vs-player factor
function CombatService.GetDamageMult(attacker, victim)
	local c = cls(attacker)
	local mult = S.JusticeService.GetDamageMult(attacker)
	if type(mult) ~= "number" or mult ~= mult then
		mult = 1
	end
	if victim ~= nil and c.Ranged then
		mult *= (c.PvPMult or 1)
	end
	return mult
end

-- NORMAL per-target monster hit (unrounded), before the 50% immediate rule
function CombatService.ComputeMonsterHit(attacker, allowCrit)
	local c = cls(attacker)
	local level = numAttr(attacker, "Level", 1)
	local tier = numAttr(attacker, "WeaponTier", 1)
	local dmg = Config.WeaponDamage(tier, level)
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, nil))
		* CombatService.GetDamageMult(attacker, nil)
	local crit = allowCrit == true and Util.Random:NextNumber() < Config.Combat.CritChance
	if crit then
		dmg *= Config.Combat.CritMult
	end
	return dmg, crit
end

-- NORMAL per-target PvP hit (unrounded): based on the victim's BASE MaxHealth (no Size Justice, no kaiju)
function CombatService.ComputePvPHit(attacker, victim)
	local c = cls(attacker)
	local aLevel = numAttr(attacker, "Level", 1)
	local aTier = numAttr(attacker, "WeaponTier", 1)
	local vLevel = numAttr(victim, "Level", 1)
	local vTier = numAttr(victim, "WeaponTier", 1)
	local vClass = S.ClassService.GetClass(victim)
	local base = Config.MaxHealth(vLevel, faction(victim), vClass) * Config.PvP.HitPctOfMaxHP
	local vWeapon = Config.WeaponDamage(vTier, vLevel)
	local ratio = Config.PvP.PowerRatioMax
	if vWeapon > 0 then
		ratio = Config.WeaponDamage(aTier, aLevel) / vWeapon
	end
	ratio = math.clamp(ratio, Config.PvP.PowerRatioMin, Config.PvP.PowerRatioMax)
	return base
		* ratio
		* (c.Damage or 1)
		* (1 + CombatService.GetDamageBonus(attacker, victim))
		* CombatService.GetDamageMult(attacker, victim)
end

------------------------------------------------------------------ heal / damage (public)
function CombatService.HealPlayer(player, amount)
	if not isPlayer(player) then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return 0 -- never revive
	end
	local missing = hum.MaxHealth - hum.Health
	if missing <= 0 then
		return 0
	end
	local heal = math.min(Util.RoundDamage(amount), missing)
	hum.Health = hum.Health + heal
	return heal
end

local function tagCombat(player)
	lastPvPTime[player] = os.clock()
	if player.Parent then
		player:SetAttribute("InCombatUntil", Util.Now() + Config.PvP.CombatTagTime)
	end
end

-- attacker nil = monster (or any non-player source)
function CombatService.DamagePlayer(victim, amount, attacker)
	if not isPlayer(victim) or victim.Parent == nil then
		return
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	if attacker ~= nil and (not isPlayer(attacker) or attacker == victim) then
		attacker = nil
	end
	-- addendum A6: Neutral (and unassigned) players never deal or receive player damage
	if attacker and (not PVP_FACTIONS[faction(attacker)] or not PVP_FACTIONS[faction(victim)]) then
		return
	end
	if not Util.IsAlive(victim) then
		return
	end
	local hum = Util.GetHumanoid(victim)
	local root = Util.GetRoot(victim)
	if not hum or not root then
		return
	end

	amount = Util.RoundDamage(amount)
	local now = os.clock()
	lastDamagedAt[victim] = now
	if attacker then
		-- bookkeeping BEFORE the damage so a lethal hit is always credited by the death pipeline
		lastPvPAttacker[victim] = { Player = attacker, T = now }
		tagCombat(victim)
		tagCombat(attacker)
	end

	local rootPos = root.Position
	local before = hum.Health
	hum:TakeDamage(amount) -- respects ForceField
	local applied = before - hum.Health
	S.PlayerService.MarkActive(victim)

	if attacker then
		-- addendum M3: AFK-in-PvP hint for players relying on auto attack
		if
			victim:GetAttribute("AutoAttack") == true
			and now - (autoHintAt[victim] or -math.huge) >= Config.Combat.AutoPvPHintCooldown
		then
			autoHintAt[victim] = now
			Net.Notify(victim, Config.Text.AutoUnderAttack, "bad")
		end
		CombatService.PlayerDamaged:Fire(victim, amount, attacker)
	elseif applied > 0 then
		Net.Fx(victim, "Hurt", { Pos = rootPos, Amount = amount })
	end
end

------------------------------------------------------------------ queries (public)
function CombatService.IsInCombat(player)
	local t = lastPvPTime[player]
	return t ~= nil and os.clock() - t <= Config.PvP.CombatTagTime
end

function CombatService.GetLastDamagedAt(player)
	return lastDamagedAt[player] or 0
end

function CombatService.GetLastPvPAttacker(player)
	local e = lastPvPAttacker[player]
	if not e then
		return nil
	end
	if os.clock() - e.T > Config.PvP.CombatTagTime then
		return nil
	end
	local p = e.Player
	if not p or p.Parent == nil then
		return nil
	end
	return p
end

function CombatService.GetCharge(player)
	return charge[player] or 0
end

------------------------------------------------------------------ lifesteal
local function applyLifesteal(player, perks, total)
	local rate = perks.Lifesteal or 0
	if rate <= 0 or total <= 0 then
		return
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return
	end
	CombatService.HealPlayer(player, math.min(total * rate, hum.MaxHealth * (perks.LifestealCapPct or 0)))
end

------------------------------------------------------------------ swing (public)
function CombatService.Swing(player, isManual)
	isManual = isManual == true
	if not isPlayer(player) or player.Parent == nil or not Util.IsAlive(player) then
		return
	end
	local character = Util.GetCharacter(player)
	local root = Util.GetRoot(player)
	if not character or not root then
		return
	end

	-- 1. shared swing cooldown (manual + auto)
	local now = os.clock()
	if now < (nextSwingAt[player] or 0) then
		return
	end
	local c = cls(player)
	nextSwingAt[player] = now + (c.SwingInterval or 1)
	lastSwingAuto[player] = not isManual

	local pos = root.Position
	local fac = faction(player)
	local perks = perksOf(player)
	local goosePos = goosePositionFor(player)
	local gooseReach = Config.Goose.HitRadius
	local range = c.Range or 10

	-- 2. select targets by class pattern
	local monsters = {} -- { { Rec, Pos, Dist } }
	local victims = {} -- { { Player, Pos, Dist } }
	local hitGoose = false
	local center = pos
	local radius = range
	local targets = {}

	if c.Pattern == "Splash" then
		radius = c.Splash or 0
		local pickPos, pickDist, pickIsGoose = nil, math.huge, false
		local nearMon = monstersNear(player, pos, range)
		if nearMon[1] then
			pickPos, pickDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if isManual then
			local nearPl = playersNear(player, pos, range)
			if nearPl[1] and nearPl[1].Dist < pickDist then
				pickPos, pickDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if goosePos then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach and d < pickDist then
				pickPos, pickDist, pickIsGoose = goosePos, d, true
			end
		end
		if pickPos then
			center = pickPos
			monsters = monstersNear(player, center, radius)
			if isManual then
				victims = playersNear(player, center, radius)
			end
			hitGoose = goosePos ~= nil
				and (pickIsGoose or Util.FlatDistance(goosePos, center) <= radius + gooseReach)
		else
			center = forwardPoint(root, math.min(range, WHIFF_REACH)) -- whiff: the orb flies forward
		end
		targets = { center }
	elseif c.Pattern == "Multi" then
		radius = 0
		local maxTargets = c.Targets or 0
		local candidates = {}
		for _, m in monstersNear(player, pos, range) do
			table.insert(candidates, { Kind = "M", Entry = m, Pos = m.Pos, Dist = m.Dist })
		end
		if isManual then
			for _, v in playersNear(player, pos, range) do
				table.insert(candidates, { Kind = "P", Entry = v, Pos = v.Pos, Dist = v.Dist })
			end
		end
		if goosePos then
			local d = Util.FlatDistance(goosePos, pos)
			if d <= range + gooseReach then
				table.insert(candidates, { Kind = "G", Pos = goosePos, Dist = d })
			end
		end
		table.sort(candidates, byDist)
		for i, cand in candidates do
			if maxTargets > 0 and i > maxTargets then
				break
			end
			table.insert(targets, cand.Pos)
			if cand.Kind == "M" then
				table.insert(monsters, cand.Entry)
			elseif cand.Kind == "P" then
				table.insert(victims, cand.Entry)
			else
				hitGoose = true
			end
		end
		if #targets == 0 then
			targets = { forwardPoint(root, math.min(range, WHIFF_REACH)) } -- whiff: the arrow flies forward
		end
	else -- "Around" (default): everything within Range of self
		monsters = monstersNear(player, pos, range)
		if isManual then
			victims = playersNear(player, pos, range)
		end
		hitGoose = goosePos ~= nil and Util.FlatDistance(goosePos, pos) <= range + gooseReach
	end

	local hits = {}
	local totalDealt, monstersHit, playersHit = 0, 0, 0

	-- 3. monsters: 50% of the normal hit right away (crit rolled per target)
	if #monsters > 0 then
		local base = CombatService.ComputeMonsterHit(player, false)
		for _, m in monsters do
			local rec = m.Rec
			if rec.Alive then
				local crit = Util.Random:NextNumber() < Config.Combat.CritChance
				local d = base * (crit and Config.Combat.CritMult or 1)
				local dealt = Util.RoundDamage(d * Config.Charge.SwingImmediate)
				S.MonsterService.DamageMonster(rec, dealt, player)
				table.insert(hits, { P = m.Pos, A = dealt, C = crit, K = "M" })
				totalDealt += dealt
				monstersHit += 1
			end
		end
	end

	-- 4. players (manual swings only; already validated with CanAttack)
	for _, v in victims do
		local vp = v.Player
		if vp.Parent and Util.IsAlive(vp) then
			local dealt = Util.RoundDamage(CombatService.ComputePvPHit(player, vp) * Config.Charge.SwingImmediate)
			CombatService.DamagePlayer(vp, dealt, player)
			table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P" })
			totalDealt += dealt
			playersHit += 1
		end
	end
	if playersHit > 0 then
		S.PvPService.BreakProtection(player)
	end

	-- 5. golden goose: no damage, no charge
	if hitGoose and goosePos then
		S.GooseService.RegisterHit(player, isManual)
		table.insert(hits, {
			P = goosePos,
			A = isManual and Config.Goose.ManualCount or Config.Goose.AutoCount,
			C = false,
			K = "G",
		})
	end

	-- 6. charge
	if monstersHit + playersHit > 0 then
		addCharge(player, isManual and (c.ChargeManual or 0) or (c.ChargeAuto or 0))
	end

	-- 7. lifesteal (Horns)
	applyLifesteal(player, perks, totalDealt)

	-- 8. activity
	local anyHit = monstersHit + playersHit > 0 or hitGoose
	if isManual or anyHit then
		S.PlayerService.MarkActive(player)

		-- 9. visuals for everyone (manual whiffs too, with empty Hits)
		Net.Fx(nil, "Swing", {
			UserId = player.UserId,
			Class = c.Id,
			Faction = fac,
			From = handPosition(character, pos),
			Pos = center,
			Radius = radius,
			Targets = targets,
			Hits = hits,
		})
	end
end

------------------------------------------------------------------ release (public)
function CombatService.Release(player, isAuto)
	isAuto = isAuto == true
	if not isPlayer(player) or player.Parent == nil or not Util.IsAlive(player) then
		return
	end
	local root = Util.GetRoot(player)
	if not root then
		return
	end

	-- 1. enough stacks?
	local n = math.floor(charge[player] or 0)
	if n < Config.Charge.MinRelease then
		if isAuto then
			-- defensive: never keep re-triggering an automatic release that cannot happen
			if (perfectUntil[player] or 0) ~= 0 then
				perfectUntil[player] = 0
				publishCharge(player)
			end
		else
			Net.Notify(player, string.format(Config.Text.ReleaseNeed, Config.Charge.MinRelease), "bad")
		end
		return
	end

	local c = cls(player)
	local fac = faction(player)
	local perks = perksOf(player)

	-- 2. PERFECT window (manual only)
	local perfect = (not isAuto) and (perfectUntil[player] or 0) > Util.Now()

	-- 8 (early). consume the charge first so a failure below can never allow a double release
	charge[player] = 0
	perfectUntil[player] = 0
	publishCharge(player)

	-- 3. center + radius
	local pos = root.Position
	local center = pos
	if c.ReleaseCenter == "Target" then
		local range = c.Range or 10
		local bestPos, bestDist = nil, math.huge
		local nearMon = monstersNear(player, pos, range)
		if nearMon[1] then
			bestPos, bestDist = nearMon[1].Pos, nearMon[1].Dist
		end
		if not isAuto then
			local nearPl = playersNear(player, pos, range)
			if nearPl[1] and nearPl[1].Dist < bestDist then
				bestPos, bestDist = nearPl[1].Pos, nearPl[1].Dist
			end
		end
		if bestPos then
			center = bestPos
		end
	end
	local radius = Config.ReleaseRadius(n)
	local releaseMult = c.ReleaseMult or 1

	local hits = {}
	local total, monstersHit, playersHit = 0, 0, 0

	-- 4. monsters (never crit)
	local monsters = monstersNear(player, center, radius)
	if #monsters > 0 then
		local D = CombatService.ComputeMonsterHit(player, false)
		local dealt = Util.RoundDamage(Config.ReleaseDamage(D, n, isAuto) * releaseMult)
		for _, m in monsters do
			if m.Rec.Alive then
				S.MonsterService.DamageMonster(m.Rec, dealt, player)
				table.insert(hits, { P = m.Pos, A = dealt, C = false, K = "M" })
				total += dealt
				monstersHit += 1
			end
		end
	end

	-- 5. players (manual releases only), capped at PvPCapPct of the target's current MaxHealth
	if not isAuto then
		for _, v in playersNear(player, center, radius) do
			local vp = v.Player
			local vHum = Util.GetHumanoid(vp)
			if vp.Parent and vHum and vHum.Health > 0 then
				local D = CombatService.ComputePvPHit(player, vp)
				local raw = math.min(
					Config.ReleaseDamage(D, n, false) * releaseMult,
					Config.Charge.PvPCapPct * vHum.MaxHealth
				)
				local dealt = Util.RoundDamage(raw)
				CombatService.DamagePlayer(vp, dealt, player)
				table.insert(hits, { P = v.Pos, A = dealt, C = false, K = "P" })
				total += dealt
				playersHit += 1
			end
		end
		if playersHit > 0 then
			S.PvPService.BreakProtection(player)
		end
	end

	-- 6. Halo release support: heal Halo allies in the radius (self included), +stacks to OTHER allies.
	-- The stack share needs a release that hit something: otherwise Halo groups could pass charge around
	-- forever in a safe town (MinRelease 10 = HaloAllyStacks 10) and farm Release quests / PERFECT charge.
	-- (The heal is HaloHealPct x total, so a whiff heals nothing anyway.)
	local healed = {}
	local shareStacks = monstersHit + playersHit > 0
	if perks.ReleaseSupport == true and fac == "Halo" then
		for _, a in S.PlayerService.GetReadyPlayers() do
			if a.Parent and faction(a) == "Halo" and Util.IsAlive(a) then
				local aRoot = Util.GetRoot(a)
				local aHum = Util.GetHumanoid(a)
				if aRoot and aHum and Util.FlatDistance(aRoot.Position, center) <= radius then
					local amount = CombatService.HealPlayer(
						a,
						math.min(Config.Charge.HaloHealPct * total, Config.Charge.HaloHealCapPct * aHum.MaxHealth)
					)
					if a ~= player then
						if shareStacks then
							addCharge(a, Config.Charge.HaloAllyStacks)
						end
						if amount > 0 then
							table.insert(healed, a)
						end
					end
				end
			end
		end
	end

	-- 7. lifesteal (Horns) on the total
	applyLifesteal(player, perks, total)

	-- 8. activity (charge already reset above)
	if not isAuto then
		S.PlayerService.MarkActive(player)
	end

	-- 9. visuals + signal
	Net.Fx(nil, "Release", {
		UserId = player.UserId,
		Class = c.Id,
		Faction = fac,
		Pos = center,
		Radius = radius,
		Stacks = n,
		Perfect = perfect,
		Auto = isAuto,
		Total = total,
		Hits = hits,
	})
	CombatService.Released:Fire(player, {
		Stacks = n,
		Auto = isAuto,
		Perfect = perfect,
		Center = center,
		Radius = radius,
		Total = total,
		MonstersHit = monstersHit,
		PlayersHit = playersHit,
		Healed = healed,
	})
end

------------------------------------------------------------------ death pipeline (the only KO entry point)
local function pipelineCall(label, fn, ...)
	if type(fn) ~= "function" then
		Util.Warn(TAG, "death pipeline: missing " .. label)
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		Util.Warn(TAG, "death pipeline: " .. label .. " failed: " .. tostring(err))
	end
end

local function runDeathPipeline(victim)
	if victim.Parent == nil then
		-- the victim already left: leave flows (GrudgeService / ProgressionService) handle it
		lastPvPAttacker[victim] = nil
		return
	end

	local killer = CombatService.GetLastPvPAttacker(victim)
	if killer then
		local fk, fv = faction(killer), faction(victim)
		-- "None" and "Neutral" never take part in PvP KOs (addendum A6)
		if killer == victim or killer.Parent == nil or fk == fv or not PVP_FACTIONS[fk] or not PVP_FACTIONS[fv] then
			killer = nil
		end
	end

	-- 1. resolve a grudge sack first (no-op without one)
	pipelineCall("GrudgeService.OnCarrierDown", S.GrudgeService.OnCarrierDown, victim, killer)

	-- 2. kaiju / PvP KO / non-PvP death
	local okState, state = pcall(kstate, victim)
	if okState and state == "Active" then
		pipelineCall("KaijuService.HandleKaijuDeath", S.KaijuService.HandleKaijuDeath, victim, killer)
	elseif killer then
		pipelineCall("PvPService.HandleKO", S.PvPService.HandleKO, victim, killer)
	else
		pipelineCall("PvPService.HandleNonPvPDeath", S.PvPService.HandleNonPvPDeath, victim)
	end

	-- 3. reset charge, forget the attacker
	resetCharge(victim)
	lastPvPAttacker[victim] = nil
end

local function onCharacterDied(player, _character)
	if not isPlayer(player) then
		return
	end
	-- deferred so the lethal hit's PlayerDamaged handlers (kaiju damage share, bait log) always run first,
	-- whatever the Workspace.SignalBehavior is
	task.defer(function()
		local ok, err = pcall(runDeathPipeline, player)
		if not ok then
			Util.Warn(TAG, "death pipeline error: " .. tostring(err))
		end
	end)
end

------------------------------------------------------------------ player lifecycle handlers
local function onPlayerReady(player, _data)
	if not isPlayer(player) or player.Parent == nil then
		return
	end
	charge[player] = 0
	perfectUntil[player] = 0
	nextSwingAt[player] = 0
	lastSwingAuto[player] = false
	player:SetAttribute("AutoAttack", false)
	player:SetAttribute("InCombatUntil", 0)
	publishCharge(player) -- Charge = 0, ChargeCap = perks.ChargeCap, PerfectUntil = 0
end

local function onPlayerLeaving(player, _data)
	-- deferred: other PlayerLeaving handlers (ProgressionService combat-log penalty) still read IsInCombat
	task.defer(function()
		charge[player] = nil
		perfectUntil[player] = nil
		nextSwingAt[player] = nil
		lastSwingAuto[player] = nil
		lastManualAt[player] = nil
		pendingManual[player] = nil
		lastDamagedAt[player] = nil
		lastPvPAttacker[player] = nil
		lastPvPTime[player] = nil
		autoHintAt[player] = nil
	end)
end

local function onFactionChanged(player, _newFaction, _oldFaction, _reason)
	if not isPlayer(player) then
		return
	end
	resetCharge(player) -- also refreshes ChargeCap for the new faction
end

local function onClassChanged(player, _newClass, _oldClass)
	if not isPlayer(player) then
		return
	end
	resetCharge(player)
end

------------------------------------------------------------------ remotes
-- one queued manual swing that fires as soon as the shared cooldown is ready (addendum H3)
local function queueManualSwing(player)
	pendingManual[player] = true
	local tries = 0
	local function attempt()
		if pendingManual[player] ~= true then
			return
		end
		if player.Parent == nil or not S.PlayerService.IsReady(player) then
			pendingManual[player] = nil
			return
		end
		local remaining = (nextSwingAt[player] or 0) - os.clock()
		if remaining > 0 and tries < MANUAL_QUEUE_RETRIES then
			tries += 1
			task.delay(remaining, attempt)
			return
		end
		pendingManual[player] = nil
		CombatService.Swing(player, true)
	end
	task.delay(math.max(0, (nextSwingAt[player] or 0) - os.clock()), attempt)
end

local function onSwingRemote(player)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if not Util.RateLimit(player, "Swing", Config.RateLimits.Swing) then
		return
	end
	S.PlayerService.MarkActive(player)
	lastManualAt[player] = os.clock()
	if pendingManual[player] then
		return -- a manual swing is already queued
	end
	local remaining = (nextSwingAt[player] or 0) - os.clock()
	if remaining <= 0 then
		CombatService.Swing(player, true)
	elseif lastSwingAuto[player] or remaining <= MANUAL_GRACE then
		-- the cooldown was consumed by an auto swing (or the request is only jitter-early): never drop it
		queueManualSwing(player)
	end
	-- otherwise an early repeat of a manual swing: silently ignored
end

local function onReleaseRemote(player)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if not Util.RateLimit(player, "Release", Config.RateLimits.Release) then
		return
	end
	CombatService.Release(player, false) -- MarkActive inside
end

local function onSetAutoAttackRemote(player, enabled)
	if not S.PlayerService.IsReady(player) then
		return
	end
	if type(enabled) ~= "boolean" then
		return
	end
	if not Util.RateLimit(player, "SetAutoAttack", Config.RateLimits.SetAutoAttack) then
		return
	end
	if enabled and numAttr(player, "Level", 1) < Config.Combat.AutoUnlockLevel then
		Net.Notify(player, string.format(Config.Text.AutoLocked, Config.Combat.AutoUnlockLevel), "bad")
		enabled = false
	end
	player:SetAttribute("AutoAttack", enabled)
end

------------------------------------------------------------------ loops
local function autoTick(p)
	if p:GetAttribute("AutoAttack") ~= true then
		return
	end
	if numAttr(p, "Level", 1) < Config.Combat.AutoUnlockLevel then
		p:SetAttribute("AutoAttack", false)
		return
	end
	if not Util.IsAlive(p) then
		return
	end
	-- addendum H3: manual beats auto
	if pendingManual[p] then
		return
	end
	local lm = lastManualAt[p]
	if lm and os.clock() - lm < Config.Combat.ManualPriority then
		return
	end
	if os.clock() < (nextSwingAt[p] or 0) then
		return
	end
	local root = Util.GetRoot(p)
	if not root then
		return
	end
	local c = cls(p)
	local range = c.Range or 10
	local pos = root.Position
	local count = S.MonsterService.CountInRadius(pos, range, p)
	local hasTarget = type(count) == "number" and count > 0
	if not hasTarget then
		local goosePos = goosePositionFor(p)
		hasTarget = goosePos ~= nil and Util.FlatDistance(goosePos, pos) <= range + Config.Goose.HitRadius
	end
	if hasTarget then
		CombatService.Swing(p, false)
	end
end

local function chargeTick(p)
	local pu = perfectUntil[p]
	if pu and pu > 0 and Util.Now() >= pu then
		CombatService.Release(p, true) -- PERFECT window missed: automatic release (x1.5, monsters only)
	end
end

local function regenTick(p)
	local hum = Util.GetHumanoid(p)
	if not hum or hum.Health <= 0 or hum.Health >= hum.MaxHealth then
		return
	end
	local pct
	-- an Active kaiju never gets the town regen (it would make the event unwinnable in Crossroads)
	if S.ZoneService.IsTown(p) and kstate(p) ~= "Active" then
		pct = Config.Combat.TownRegenPerSec
	else
		pct = perksOf(p).RegenPerSec or 0
	end
	if type(pct) == "number" and pct > 0 then
		CombatService.HealPlayer(p, hum.MaxHealth * pct * Config.Combat.RegenTick)
	end
end

local function startPlayerLoop(loopName, interval, body)
	task.spawn(function()
		while true do
			task.wait(interval)
			local ok, players = pcall(S.PlayerService.GetReadyPlayers)
			if ok and type(players) == "table" then
				for _, p in players do
					if p.Parent then
						local okBody, err = pcall(body, p)
						if not okBody then
							loopWarn(loopName, err)
						end
					end
				end
			elseif not ok then
				loopWarn(loopName, players)
			end
		end
	end)
end

------------------------------------------------------------------ lifecycle
local function connectSignal(serviceName, signalName, fn)
	local service = S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

function CombatService.Init(registry)
	S = registry
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
	connectSignal("PlayerService", "CharacterDied", onCharacterDied)
	connectSignal("FactionService", "FactionChanged", onFactionChanged)
	connectSignal("ClassService", "ClassChanged", onClassChanged)
end

function CombatService.Start()
	Net.Get("Swing").OnServerEvent:Connect(onSwingRemote)
	Net.Get("Release").OnServerEvent:Connect(onReleaseRemote)
	Net.Get("SetAutoAttack").OnServerEvent:Connect(onSetAutoAttackRemote)

	startPlayerLoop("AutoLoop", Config.Combat.AutoLoopInterval, autoTick)
	startPlayerLoop("ChargeWatcher", Config.Combat.ChargeTick, chargeTick)
	startPlayerLoop("RegenLoop", Config.Combat.RegenTick, regenTick)

	print("[CombatService] started")
end

return CombatService
]]></ProtectedString>
				<string name="ScriptGuid">{DFF649BD-24A2-4CDF-AFB1-9AD9180ADD77}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">CombatService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f369000023e5</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX54276BECA1234BEFA487A8BCFB860CBF">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- FactionService.luau : Teams, first faction choice, altar faction switch (free / ticket), SetFaction, faction counts.
-- Factions: "Halo", "Horns", "Neutral" (playable, addendum A6) and "None" (not chosen yet).
-- Faction ratios / counts used by war, Size Justice and rebirth bonuses are Halo vs Horns only (A6).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "FactionService"
local RECOUNT_INTERVAL = 10 -- seconds between periodic faction recounts (spec §4.10)
local LEAVE_FORGET_SECONDS = 60 -- how long a leaving player stays in the "leaving" set (they are gone by then)
local ALTAR_PROMPT_RATE = 0.5 -- private rate limit for the altar ProximityPrompt
local WARN_THROTTLE = 10
-- TODO(config): no Config.Text key for a switch that costs nothing (leaving Neutral, addendum A6);
-- Config.Text.SwitchDonePlain is used instead once it exists.
local TEXT_SWITCH_DONE_PLAIN = "%s(으)로 진영을 바꿨어요!"
local SCORE_NAME = { Halo = "명예", Horns = "악명" } -- score lost by a FREE switch away from that faction

local FactionService = {}

FactionService.FactionChanged = Util.Signal.new() -- (player, newFaction, oldFaction, reason: "Choose" | "Altar" | "Rebirth")

local S = nil
local teams = {} -- [factionId] = Team
local leaving = {} -- [Player] = true while the player is leaving (excluded from counts)
local lastWarnAt = {}

local KNOWN = { Halo = true, Horns = true, Neutral = true, None = true }

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

-- a faction a player may pick / switch to (needs its Config entry)
local function isPlayable(factionId)
	return (factionId == "Halo" or factionId == "Horns" or factionId == "Neutral") and Config.Factions[factionId] ~= nil
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

local function notify(player, key, kind, ...)
	local fmt = Config.Text[key]
	if type(fmt) ~= "string" then return end
	Net.Notify(player, string.format(fmt, ...), kind)
end

local function applyTeam(player, factionId)
	local team = teams[factionId]
	local ok, err = pcall(function()
		if factionId ~= "None" and team and team.Parent then
			player.Neutral = false
			player.Team = team
		else
			player.Team = nil
			player.Neutral = true
		end
	end)
	if not ok then warnThrottled("team", "team assignment failed: " .. tostring(err)) end
end

local function getOrCreateTeam(def)
	if not def or type(def.TeamName) ~= "string" or def.TeamName == "" then return nil end
	local existing = Teams:FindFirstChild(def.TeamName)
	local team = (existing and existing:IsA("Team")) and existing or Instance.new("Team")
	team.Name = def.TeamName
	if def.TeamColor then team.TeamColor = def.TeamColor end
	team.AutoAssignable = false
	team.Parent = Teams
	return team
end

local function recount()
	if not S then return end
	local halo, horns = FactionService.GetCounts()
	local gs = Net.GameState()
	gs:SetAttribute("HaloCount", halo)
	gs:SetAttribute("HornsCount", horns)
end

local function safeRecount()
	local ok, err = pcall(recount)
	if not ok then warnThrottled("recount", "recount failed: " .. tostring(err)) end
end

local function kaijuState(player)
	local k = S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function wantedStars(player)
	local p = S.PvPService
	if p and p.GetStars then
		local ok, n = pcall(p.GetStars, player)
		if ok and type(n) == "number" then return n end
	end
	return 0
end

local function lastSwitchTime(player)
	local data = S.PlayerService.GetData(player)
	local t = data and data.LastSwitchTime
	if type(t) ~= "number" then t = player:GetAttribute("LastSwitchTime") end
	return tonumber(t) or 0
end

local function nearAltar(player)
	local root = Util.GetRoot(player)
	if not root then return false end
	local ok, altar = pcall(S.MapBuilder.GetAltar)
	if not ok or typeof(altar) ~= "Instance" or not altar:IsA("BasePart") then return false end
	return Util.FlatDistance(root.Position, altar.Position) <= Config.Switch.AltarRange
end

-- Spec payload is (useTicket: boolean). Addendum A6 makes the target ambiguous with three factions, so an optional
-- target faction id (string) is accepted in either position: (useTicket, target) or (target, useTicket).
local function parseSwitchArgs(a, b)
	if type(a) == "boolean" then
		if b == nil then return a, nil end
		if type(b) == "string" then return a, b end
		return nil, nil
	end
	if type(a) == "string" and type(b) == "boolean" then
		return b, a
	end
	return nil, nil
end

-- target when the client did not name one: Halo <-> Horns as in the spec; Neutral joins the side that needs players
local function defaultTarget(current)
	if current == "Halo" then return "Horns" end
	if current == "Horns" then return "Halo" end
	local weaker = "None"
	local j = S.JusticeService
	if j and j.GetWeakerFaction then
		local ok, w = pcall(j.GetWeakerFaction)
		if ok then weaker = w end
	end
	if weaker == "Halo" or weaker == "Horns" then return weaker end
	local halo, horns = FactionService.GetCounts()
	return (horns < halo) and "Horns" or "Halo"
end

------------------------------------------------------------------ public API
function FactionService.GetFaction(player)
	if not player then return "None" end
	local f = player:GetAttribute("Faction")
	if type(f) == "string" and KNOWN[f] then return f end
	return "None"
end

function FactionService.GetPerks(player)
	return Config.Factions[FactionService.GetFaction(player)] or Config.Factions.None
end

-- ready players only, excluding leaving players; Neutral / None are not counted (A6: ratios are Halo vs Horns)
function FactionService.GetCounts()
	if not S then return 0, 0 end
	local halo, horns = 0, 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = FactionService.GetFaction(p)
			if f == "Halo" then
				halo += 1
			elseif f == "Horns" then
				horns += 1
			end
		end
	end
	return halo, horns
end

function FactionService.GetTeam(factionId)
	local t = teams[factionId]
	if t and t.Parent then return t end
	return nil
end

-- the ONLY writer of the Faction stat. Never touches Honor/Infamy, tickets or cooldowns (callers do).
function FactionService.SetFaction(player, factionId, reason)
	if not player or not S then return end
	if type(factionId) ~= "string" or not KNOWN[factionId] or (factionId ~= "None" and not Config.Factions[factionId]) then
		Util.Warn(TAG, "SetFaction: invalid faction " .. tostring(factionId))
		return
	end
	local old = FactionService.GetFaction(player)
	S.PlayerService.SetStat(player, "Faction", factionId)
	applyTeam(player, factionId)
	FactionService.FactionChanged:Fire(player, factionId, old, reason or "Choose")
	safeRecount()
end

------------------------------------------------------------------ remotes
local function onChooseFaction(player, factionId)
	if not S.PlayerService.IsReady(player) then return end
	if type(factionId) ~= "string" or not isPlayable(factionId) then return end
	if not Util.RateLimit(player, "ChooseFaction", Config.RateLimits.ChooseFaction) then return end
	if FactionService.GetFaction(player) ~= "None" then return end -- silent: first choice only

	-- read BEFORE changing; the sign-on bonus is Halo vs Horns only (A6), GetWeakerFaction never returns "Neutral"
	local wasWeaker = false
	if factionId == "Halo" or factionId == "Horns" then
		wasWeaker = (S.JusticeService.GetWeakerFaction() == factionId)
	end

	FactionService.SetFaction(player, factionId, "Choose")

	if wasWeaker then
		S.ProgressionService.AddBankGold(player, Config.Justice.SignOnGold, "Other")
		notify(player, "UnderdogSignOn", "reward", Config.Justice.SignOnGold)
	end
	S.PlayerService.Respawn(player)
end

local function onSwitchFaction(player, a, b)
	if not S.PlayerService.IsReady(player) then return end
	local useTicket, target = parseSwitchArgs(a, b)
	if type(useTicket) ~= "boolean" then return end
	if target ~= nil and not isPlayable(target) then return end
	if not Util.RateLimit(player, "SwitchFaction", Config.RateLimits.SwitchFaction) then return end

	local old = FactionService.GetFaction(player)
	if old == "None" then return end -- silent
	local new = target or defaultTarget(old)
	if new == old or not isPlayable(new) then return end -- silent
	if not nearAltar(player) then return end -- silent

	if S.GrudgeService.HasSack(player) then
		notify(player, "BlockedSack", "bad")
		return
	end
	if kaijuState(player) ~= "None" then
		notify(player, "BlockedKaiju", "bad")
		return
	end
	if wantedStars(player) > 0 then
		notify(player, "BlockedStars", "bad")
		return
	end
	if S.CombatService.IsInCombat(player) then
		notify(player, "TravelBlockedCombat", "bad")
		return
	end
	local remaining = lastSwitchTime(player) + Config.Switch.Cooldown - os.time()
	if remaining > 0 then
		notify(player, "SwitchCooldown", "bad", Util.FormatTime(remaining))
		return
	end

	-- leaving Neutral costs nothing (A6: no Neutral score yet), so a ticket is never consumed for it
	local lostScore = SCORE_NAME[old]
	local ticketUsed = false
	if useTicket and lostScore then
		if not S.MonetizationService.UseTicket(player, "Faction") then
			notify(player, "NoTicket", "bad")
			return
		end
		ticketUsed = true
	end

	-- free switch: the score of the faction being LEFT resets ("배신의 대가")
	if not ticketUsed then
		if old == "Halo" then
			S.PlayerService.SetStat(player, "Honor", 0)
		elseif old == "Horns" then
			S.PlayerService.SetStat(player, "Infamy", 0)
		end
	end

	S.PlayerService.AddStat(player, "SwitchCount", 1)
	S.PlayerService.SetStat(player, "LastSwitchTime", os.time())
	FactionService.SetFaction(player, new, "Altar")

	local newName = (Config.Factions[new] and Config.Factions[new].Name) or new
	if ticketUsed then
		notify(player, "SwitchDoneTicket", "good", newName)
	elseif lostScore then
		notify(player, "SwitchDoneFree", "good", newName, lostScore)
	else
		local fmt = Config.Text.SwitchDonePlain
		Net.Notify(player, string.format(type(fmt) == "string" and fmt or TEXT_SWITCH_DONE_PLAIN, newName), "good")
	end
	S.PlayerService.Respawn(player)
end

local function onPromptTriggered(prompt, player)
	if not prompt or prompt.Name ~= "AltarPrompt" then return end
	local parent = prompt.Parent
	if not parent or parent.Name ~= "Altar" then return end
	if not player or not S.PlayerService.IsReady(player) then return end
	if FactionService.GetFaction(player) == "None" then return end
	if not Util.RateLimit(player, "AltarPrompt", ALTAR_PROMPT_RATE) then return end
	Net.Get("OpenPanel"):FireClient(player, "Altar")
end

------------------------------------------------------------------ lifecycle
local function onPlayerReady(player, data)
	leaving[player] = nil
	local f = data and data.Faction
	if type(f) ~= "string" or not KNOWN[f] or (f ~= "None" and not Config.Factions[f]) then
		-- corrupted / unknown value: fall back to "None" (picker shows again). No FactionChanged during join.
		Util.Warn(TAG, "invalid stored faction " .. tostring(f) .. " for " .. player.Name .. "; reset to None")
		S.PlayerService.SetStat(player, "Faction", "None")
		f = "None"
	end
	applyTeam(player, f)
	safeRecount()
end

local function onPlayerLeaving(player)
	leaving[player] = true
	safeRecount()
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

function FactionService.Init(registry)
	S = registry
	for _, id in { "Halo", "Horns", "Neutral" } do
		local def = Config.Factions[id]
		if def then
			local ok, teamOrErr = pcall(getOrCreateTeam, def)
			if ok then
				teams[id] = teamOrErr
			else
				Util.Warn(TAG, "could not create team for " .. id .. ": " .. tostring(teamOrErr))
			end
		end
	end
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
end

function FactionService.Start()
	Net.Get("ChooseFaction").OnServerEvent:Connect(onChooseFaction)
	Net.Get("SwitchFaction").OnServerEvent:Connect(onSwitchFaction)

	-- global hook (survives MapBuilder.Rebuild); filtered to workspace.Map.Landmarks.Altar.AltarPrompt
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
	local ok, altar = pcall(S.MapBuilder.GetAltar)
	if not ok or typeof(altar) ~= "Instance" or not altar:FindFirstChild("AltarPrompt") then
		Util.Warn(TAG, "altar or AltarPrompt not found at start; the altar panel cannot open until it exists")
	end

	task.spawn(function()
		while true do
			task.wait(RECOUNT_INTERVAL)
			safeRecount()
		end
	end)
	safeRecount()

	print("[FactionService] started")
end

return FactionService
]]></ProtectedString>
				<string name="ScriptGuid">{20001726-484F-4865-96EF-D6D061B0AF43}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">FactionService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f369000023e7</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXCEE0595C21AC4E909C2535C926410DAD">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- JusticeService.luau : Size Justice ("덩치 저울"): faction power sums, per-faction S, bully stacks + decay,
-- and the smooth character scale lerp. The ONLY service that scales characters (always via Util.SafeScaleTo).
-- Addendum A6: "Neutral" players are excluded from power sums / ratios and their S is always 1.0.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "JusticeService"
local DECAY_TICK = 1 -- bully decay loop interval (spec §4.12)
local SCALE_EPSILON = 0.005 -- lerp stops when this close to the target
local S_EPSILON = 0.001 -- a faction S change smaller than this does not refresh characters
local MIN_SCALE = 0.1 -- safety floor for Model:ScaleTo
local SCALE_RETRY_SECONDS = 2 -- after a failed ScaleTo, wait this long before trying that character again
local LEAVE_FORGET_SECONDS = 60
local WARN_THROTTLE = 10
local PIVOT_HEIGHT_AT_SCALE_1 = 3 -- approx. root-center height above the feet for R6 and R15 at scale 1

local JusticeService = {}

local S = nil
local scaleOf = { Halo = 1, Horns = 1 } -- current S per combat faction
local weakerFaction = "None"
local leaving = {} -- [Player] = true while leaving (excluded from sums)
local lastAppliedS = {} -- [Player] = S last pushed to SizeMult / RefreshCharacter
local lastFaction = {} -- [Player] = faction at the last recompute pass
local targets = {} -- [Player] = last computed visual scale target
local bully = {} -- [Player] = { Stacks: number, Last: number (os.clock) }
local hipBase = setmetatable({}, { __mode = "k" }) -- [Character] = R15 HipHeight at scale 1
local scaleFailUntil = setmetatable({}, { __mode = "k" }) -- [Character] = os.clock()
local recomputePending = false
local lastWarnAt = {}

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function round2(x)
	return math.floor(x * 100 + 0.5) / 100
end

local function factionOf(player)
	if S and S.FactionService and S.FactionService.GetFaction then
		return S.FactionService.GetFaction(player)
	end
	local f = player and player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function kaijuState(player)
	local k = S and S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

-- only Halo / Horns can be bullies (A6: Neutral never gets bully stacks; "None" has not picked a side)
local function isFighterFaction(factionId)
	return factionId == "Halo" or factionId == "Horns"
end

local function computeTarget(player)
	local s = JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
	if kaijuState(player) == "Active" then
		s *= Config.Kaiju.VisualScale
	end
	return math.max(MIN_SCALE, math.min(Config.Justice.MaxVisualScale, s))
end

local function writeVisualScale(player, scale)
	local v = round2(scale)
	if player:GetAttribute("VisualScale") ~= v then
		player:SetAttribute("VisualScale", v)
	end
end

-- R15 hover height does not follow the body when scaled at runtime; keep it proportional (no-op if ScaleTo did it).
local function fixHipHeight(character, scale)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local base = hipBase[character]
	if not base or base <= 0 then return end
	local want = base * scale
	if math.abs(hum.HipHeight - want) > 0.01 then
		hum.HipHeight = want
	end
end

local function rememberHipBase(character)
	if hipBase[character] then return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local cur = character:GetScale()
	if cur > 0 then
		hipBase[character] = hum.HipHeight / cur
	end
end

-- applies `scale` to the character; returns true on success
local function applyScale(character, scale)
	local blockedUntil = scaleFailUntil[character]
	if blockedUntil and os.clock() < blockedUntil then return false end
	if Util.SafeScaleTo(character, scale) then
		fixHipHeight(character, scale)
		return true
	end
	scaleFailUntil[character] = os.clock() + SCALE_RETRY_SECONDS
	return false
end

local function requestRecompute()
	if recomputePending then return end
	recomputePending = true
	task.defer(function()
		recomputePending = false
		local ok, err = pcall(JusticeService.Recompute)
		if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
	end)
end

local function clearPlayer(player)
	lastAppliedS[player] = nil
	lastFaction[player] = nil
	targets[player] = nil
	bully[player] = nil
end

------------------------------------------------------------------ public API
function JusticeService.GetPower(player)
	if not player then return 0 end
	local level = math.max(1, tonumber(player:GetAttribute("Level")) or 1)
	local tier = math.clamp(math.floor(tonumber(player:GetAttribute("WeaponTier")) or 1), 1, Config.MaxWeaponTier)
	local rebirthBonus = tonumber(player:GetAttribute("RebirthBonus")) or 0
	return Config.PowerOf(level, tier, 1 + rebirthBonus)
end

-- 1 for "None" and "Neutral" (A6)
function JusticeService.GetFactionScale(factionId)
	if factionId == "Halo" or factionId == "Horns" then
		return scaleOf[factionId] or 1
	end
	return 1
end

function JusticeService.GetWeakerFaction()
	return weakerFaction
end

function JusticeService.GetDamageMult(player)
	return JusticeService.GetFactionScale(factionOf(player)) * Config.BullyMult(JusticeService.GetBullyStacks(player))
end

function JusticeService.GetHealthMult(player)
	local mult = JusticeService.GetFactionScale(factionOf(player))
	local k = S and S.KaijuService
	if k and k.GetHealthMult then
		local ok, km = pcall(k.GetHealthMult, player)
		if ok and type(km) == "number" and km > 0 then
			mult *= km
		end
	end
	return mult
end

function JusticeService.GetBullyStacks(player)
	local b = player and bully[player]
	return b and b.Stacks or 0
end

function JusticeService.AddBullyStack(player)
	if not player then return 0 end
	if not isFighterFaction(factionOf(player)) then return 0 end -- A6: Neutral / None never become bullies
	local b = bully[player]
	if not b then
		b = { Stacks = 0, Last = os.clock() }
		bully[player] = b
	end
	b.Stacks = math.min(Config.Bully.MaxStacks, b.Stacks + 1)
	b.Last = os.clock()
	player:SetAttribute("BullyStacks", b.Stacks)
	JusticeService.RefreshScale(player)
	return b.Stacks
end

-- recompute this player's visual scale target now (the scale loop moves the character toward it)
function JusticeService.RefreshScale(player)
	if not player then return end
	targets[player] = computeTarget(player)
end

function JusticeService.Recompute()
	if not S then return end
	local haloSum, hornsSum, haloCount, hornsCount = 0, 0, 0, 0
	local entries = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = factionOf(p)
			if f == "Halo" or f == "Horns" then
				local ok, power = pcall(JusticeService.GetPower, p)
				power = (ok and type(power) == "number") and power or 0
				if f == "Halo" then
					haloSum += power
					haloCount += 1
				else
					hornsSum += power
					hornsCount += 1
				end
			end
			table.insert(entries, { Player = p, Faction = f })
		end
	end

	local sHalo, sHorns = 1, 1
	if haloCount >= 1 and hornsCount >= 1 then
		sHalo = Config.SizeJustice(haloSum, hornsSum)
		sHorns = Config.SizeJustice(hornsSum, haloSum)
	end
	scaleOf.Halo, scaleOf.Horns = sHalo, sHorns

	-- an empty faction counts as 0; "None" if both sums are 0 or equal
	if (haloSum == 0 and hornsSum == 0) or haloSum == hornsSum then
		weakerFaction = "None"
	elseif haloSum < hornsSum then
		weakerFaction = "Halo"
	else
		weakerFaction = "Horns"
	end

	local gs = Net.GameState()
	gs:SetAttribute("HaloPower", math.floor(haloSum + 0.5))
	gs:SetAttribute("HornsPower", math.floor(hornsSum + 0.5))
	gs:SetAttribute("HaloSize", round2(sHalo))
	gs:SetAttribute("HornsSize", round2(sHorns))
	gs:SetAttribute("WeakerFaction", weakerFaction)

	for _, e in entries do
		local p, f = e.Player, e.Faction
		local s = JusticeService.GetFactionScale(f)
		local prev = lastAppliedS[p]
		if lastFaction[p] ~= f or prev == nil or math.abs(prev - s) > S_EPSILON then
			lastAppliedS[p] = s
			lastFaction[p] = f
			local ok, err = pcall(function()
				p:SetAttribute("SizeMult", round2(s))
				S.PlayerService.RefreshCharacter(p, false) -- HP % preserved
				JusticeService.RefreshScale(p)
			end)
			if not ok then warnThrottled("apply", "apply S failed: " .. tostring(err)) end
		end
	end
end

------------------------------------------------------------------ subscriptions
local function onPlayerReady(player)
	leaving[player] = nil
	clearPlayer(player)
	player:SetAttribute("SizeMult", 1)
	player:SetAttribute("BullyStacks", 0)
	player:SetAttribute("VisualScale", 1)
	requestRecompute()
end

local function onPlayerLeaving(player)
	leaving[player] = true
	clearPlayer(player)
	requestRecompute()
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

-- fresh characters start at scale 1: snap straight to the target (no lerp)
local function onCharacterSpawned(player, character)
	if not player or not character or not character.Parent then return end
	if player.Character ~= character then return end
	rememberHipBase(character)
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	if math.abs(target - cur) > SCALE_EPSILON and applyScale(character, target) then
		if target > cur then
			-- ScaleTo keeps the pivot (root) in place, so the longer legs would start inside the floor: lift by the growth
			pcall(function()
				character:PivotTo(character:GetPivot() + Vector3.new(0, (target - cur) * PIVOT_HEIGHT_AT_SCALE_1, 0))
			end)
		end
		cur = target
	end
	writeVisualScale(player, cur)
end

------------------------------------------------------------------ loops
local function scaleStep(player, step)
	if not Util.IsAlive(player) then return end
	local character = Util.GetCharacter(player)
	if not character then return end
	local target = computeTarget(player)
	targets[player] = target
	local cur = character:GetScale()
	local diff = target - cur
	if math.abs(diff) <= SCALE_EPSILON then
		writeVisualScale(player, cur)
		return
	end
	rememberHipBase(character)
	local new = cur + math.clamp(diff, -step, step)
	if applyScale(character, new) then
		writeVisualScale(player, new)
	end
end

local function decayStep(player, b)
	if b.Stacks <= 0 then return end
	if os.clock() - b.Last < Config.Bully.DecaySeconds then return end
	b.Stacks -= 1
	b.Last = os.clock()
	if player.Parent ~= Players then return end
	player:SetAttribute("BullyStacks", b.Stacks)
	Net.Notify(player, string.format(Config.Text.BullyDecay, b.Stacks), "info")
	JusticeService.RefreshScale(player)
end

function JusticeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player, newFaction)
			-- A6: a bully who switches to Neutral (altar / rebirth) sheds the stacks at once
			-- (no shrink, no -15% damage, no "깡패" tag); Halo <-> Horns keeps them
			if player and not isFighterFaction(newFaction) then
				local had = bully[player] ~= nil or (tonumber(player:GetAttribute("BullyStacks")) or 0) > 0
				bully[player] = nil
				if had then
					local ok, err = pcall(function()
						player:SetAttribute("BullyStacks", 0)
						JusticeService.RefreshScale(player)
					end)
					if not ok then warnThrottled("bullyclear", "bully clear failed: " .. tostring(err)) end
				end
			end
			requestRecompute()
		end)
	end
	if S.ClassService and S.ClassService.ClassChanged then
		S.ClassService.ClassChanged:Connect(function()
			requestRecompute()
		end)
	end
	if S.ProgressionService and S.ProgressionService.Rebirthed then
		S.ProgressionService.Rebirthed:Connect(function()
			requestRecompute()
		end)
	end
	-- players removed before they were ever ready never fire PlayerLeaving
	Players.PlayerRemoving:Connect(function(player)
		clearPlayer(player)
	end)
end

function JusticeService.Start()
	-- periodic recompute
	task.spawn(function()
		while true do
			task.wait(Config.Justice.RecalcInterval)
			local ok, err = pcall(JusticeService.Recompute)
			if not ok then warnThrottled("recompute", "recompute failed: " .. tostring(err)) end
		end
	end)

	-- smooth scale lerp
	task.spawn(function()
		local interval = Config.Justice.ScaleTick
		local step = Config.Justice.ScaleRatePerSec * interval -- max scale change per tick
		while true do
			task.wait(interval)
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(scaleStep, p, step)
				if not ok then warnThrottled("scale", "scale step failed: " .. tostring(err)) end
			end
		end
	end)

	-- bully stack decay
	task.spawn(function()
		while true do
			task.wait(DECAY_TICK)
			for p, b in bully do
				local ok, err = pcall(decayStep, p, b)
				if not ok then warnThrottled("decay", "bully decay failed: " .. tostring(err)) end
			end
		end
	end)

	requestRecompute()
	print("[JusticeService] started")
end

return JusticeService
]]></ProtectedString>
				<string name="ScriptGuid">{3F5E21BD-1A91-43FD-902F-03D29233EC4B}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">JusticeService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">540d3fc5db7bff020ad0f369000023e9</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX48A65F4C4A104F18AD40D4947214DCB1">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PvPService.luau : PvP rules (CanAttack, rookie / spawn protection), bully detection, KO outcomes
-- (plunder -> grudge sack, honor, bounty), Wanted stars + bounty, revenge marks and the Most Wanted board.
-- Server only. See TECH_SPEC §4.13 and SPEC_ADDENDUM A6 / A10-V3-3.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "PvPService"

-- (the A3-M3 "under attack while auto-attack is ON" hint is sent by CombatService.DamagePlayer only)
local LOOP_INTERVAL = 1
local PRUNE_INTERVAL = 60 -- seconds between prunes of the pair tables
local LOOP_WARN_INTERVAL = 10

-- Most Wanted board lines (TECH_SPEC §4.13 board text)
local BOARD_WANTED_TITLE = "현상수배 TOP 3"
local BOARD_HONOR_TITLE = Config.Factions.Halo.Name .. " 명예 TOP 3"
local BOARD_EMPTY = "(아직 없음)"
local BOARD_BULLY = "깡패"
local BOARD_HONOR_WORD = "명예"
local BOARD_ROWS = 3

local PvPService = {}

PvPService.PlayerKO = Util.Signal.new() -- (killer, victim, info)

local S = nil

-- per-player state (Player keys; cleaned on PlayerLeaving)
local stars = {} -- [Player] = number
local lastStarChange = {} -- [Player] = os.clock()
local protectedUntil = {} -- [Player] = os.clock() (0 = not protected)
local spawnedAt = {} -- [Player] = os.clock() of the last CharacterSpawned
local lastHitOn = {} -- [attacker][victim] = os.clock() (attacker damaged victim)
local revenge = {} -- [Player] = { Target = Player, Until = os.clock() }

-- pair state keyed by "killerUserId:victimUserId" so a rejoin cannot reset it; pruned by age
local koLog = {} -- [pairKey] = { os.clock(), ... } within Config.Bully.RepeatWindow
local pairReward = {} -- [pairKey] = os.clock() of the last minted reward

-- anti-farm: the minted bully part of a bounty is paid at most once per victim (any killer) per this window,
-- the time a max-stack bully needs to decay back to clean. Keyed by victim UserId; pruned by age.
local BULLY_BOUNTY_COOLDOWN = Config.Bully.DecaySeconds * Config.Bully.MaxStacks
local bullyBountyAt = {} -- [victimUserId] = os.clock() of the last minted bully bounty on that victim

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind)
	if isPlaying(p) then
		Net.Notify(p, text, kind)
	end
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function faction(p)
	return S.FactionService.GetFaction(p)
end

-- only Halo and Horns ever take part in PvP ("Neutral" and "None" never do; addendum A6)
local function isFighter(f)
	return f == "Halo" or f == "Horns"
end

local function kstate(p)
	local kaiju = S.KaijuService
	if kaiju and kaiju.GetState then
		return kaiju.GetState(p) or "None"
	end
	return "None"
end

-- persisted stat: live data table first, mirrored attribute as fallback
local function num(p, key, default)
	local data = S.PlayerService.GetData(p)
	local v = data and data[key]
	if v == nil then
		v = p:GetAttribute(key)
	end
	return tonumber(v) or default
end

local function bullyStacksOf(p)
	return tonumber(S.JusticeService.GetBullyStacks(p)) or 0
end

-- bully stacks that still carry a bounty: 0 while this bully's bounty was already claimed (BULLY_BOUNTY_COOLDOWN).
-- The stacks themselves (size / damage penalty, "깡패" tag) stay with JusticeService.
local function bountyBullyStacks(p, now)
	local t = bullyBountyAt[p.UserId]
	if t ~= nil and (now or os.clock()) - t < BULLY_BOUNTY_COOLDOWN then
		return 0
	end
	return bullyStacksOf(p)
end

-- addendum A10-V3-3: inside a PvP zone, or combat-tagged (Config.PvP.CombatTagTime) anywhere outside a town
-- (Outskirts, bridges, safe hunting land), so a fight or a sack chase does not end at a zone edge
local function inPvP(p)
	return S.ZoneService.IsPvPZone(p) or (not S.ZoneService.IsTown(p) and S.CombatService.IsInCombat(p))
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

local function pairKey(a, b)
	return tostring(a.UserId) .. ":" .. tostring(b.UserId)
end

-- remove every time < cutoff from an ascending array of os.clock() values
local function pruneTimes(log, cutoff)
	local i = 1
	while i <= #log do
		if log[i] < cutoff then
			table.remove(log, i)
		else
			i += 1
		end
	end
end

local function computeBounty(p)
	if not isFighter(faction(p)) then
		return 0
	end
	return Config.Bounty(num(p, "Level", 1), stars[p] or 0, bountyBullyStacks(p))
end

local function refreshStarAttrs(p)
	if not isPlaying(p) then
		return
	end
	setAttr(p, "WantedStars", stars[p] or 0)
	setAttr(p, "Bounty", computeBounty(p))
end

-- the newbie PvP shield is meaningless for Neutral (never in PvP at all; addendum A6)
local function rookieAttr(p)
	return faction(p) ~= "Neutral" and PvPService.IsRookie(p)
end

local function announceIfMostWanted(p, before, after)
	if before < Config.PvP.AnnounceStars and after >= Config.PvP.AnnounceStars then
		Net.NotifyAll(fmt("MostWanted", p.DisplayName, Util.FormatNumber(computeBounty(p))))
	end
end

local function addStar(killer)
	local before = stars[killer] or 0
	local after = math.min(Config.PvP.MaxStars, before + 1)
	stars[killer] = after
	lastStarChange[killer] = os.clock()
	refreshStarAttrs(killer)
	announceIfMostWanted(killer, before, after)
end

local function destroyForceFields(p)
	local character = p.Character
	if not character then
		return
	end
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
end

local function clearRevenge(p)
	revenge[p] = nil
	if isPlaying(p) then
		setAttr(p, "RevengeTargetId", 0)
		setAttr(p, "RevengeUntil", 0)
	end
end

-- clears p's own revenge mark and every other player's mark that targets p
local function clearRevengeInvolving(p)
	local holders = {}
	for holder, r in revenge do
		if holder == p or r.Target == p then
			table.insert(holders, holder)
		end
	end
	for _, holder in holders do
		clearRevenge(holder)
	end
end

------------------------------------------------------------------ public API
function PvPService.GetStars(player)
	return (player and stars[player]) or 0
end

function PvPService.ResetStars(player)
	if not player then
		return
	end
	stars[player] = 0
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
end

function PvPService.DebugSetStars(player, n)
	if not isPlaying(player) then
		return
	end
	local before = stars[player] or 0
	local after = math.clamp(math.floor(tonumber(n) or 0), 0, Config.PvP.MaxStars)
	stars[player] = after
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
	announceIfMostWanted(player, before, after)
end

-- Rebirths == 0 and (Level < RookieLevel or PlaytimeSeconds < RookiePlaytime)
function PvPService.IsRookie(player)
	if not player then
		return false
	end
	if num(player, "Rebirths", 0) ~= 0 then
		return false
	end
	return num(player, "Level", 1) < Config.PvP.RookieLevel
		or num(player, "PlaytimeSeconds", 0) < Config.PvP.RookiePlaytime
end

function PvPService.HasRevenge(attacker, victim)
	local r = attacker and revenge[attacker]
	return r ~= nil and victim ~= nil and r.Target == victim and os.clock() < r.Until
end

function PvPService.Protect(player, seconds)
	if not isPlaying(player) then
		return
	end
	seconds = tonumber(seconds) or 0
	if seconds <= 0 then
		return
	end
	local character = player.Character
	if character and character.Parent and not character:FindFirstChildOfClass("ForceField") then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = character
	end
	protectedUntil[player] = math.max(protectedUntil[player] or 0, os.clock() + seconds)
	setAttr(player, "Protected", true)
end

function PvPService.BreakProtection(player)
	if not player then
		return
	end
	-- cheap early-out: CombatService calls this after every PvP hit
	if (protectedUntil[player] or 0) == 0 and player:GetAttribute("Protected") ~= true then
		return
	end
	protectedUntil[player] = 0
	destroyForceFields(player)
	if isPlaying(player) then
		setAttr(player, "Protected", false)
	end
end

-- (allowed: boolean, reasonKey: string?)
function PvPService.CanAttack(attacker, victim)
	if attacker == nil or victim == nil or attacker == victim then
		return false, "Self"
	end
	local PS = S.PlayerService
	if not PS.IsReady(attacker) or not PS.IsReady(victim) then
		return false, "NotReady"
	end
	if not Util.IsAlive(attacker) or not Util.IsAlive(victim) then
		return false, "Dead"
	end
	local fa, fv = faction(attacker), faction(victim)
	if fa == "Neutral" or fv == "Neutral" then
		return false, "Neutral" -- addendum A6: Neutral never hits / is hit by players, anywhere
	end
	if not isFighter(fa) or not isFighter(fv) or fa == fv then
		return false, "SameFaction"
	end
	-- kaiju exception: Halo may hit the Active kaiju in any zone (rookies allowed, protection ignored)
	if fa == "Halo" and kstate(victim) == "Active" then
		return true, nil
	end
	if not inPvP(attacker) or not inPvP(victim) then
		return false, "SafeZone"
	end
	if PvPService.IsRookie(attacker) or PvPService.IsRookie(victim) then
		return false, "Rookie"
	end
	if victim:GetAttribute("Protected") == true then
		return false, "Protected"
	end
	return true, nil
end

-- called ONLY by CombatService's death pipeline (no kill credit: monster, fall, reset)
function PvPService.HandleNonPvPDeath(victim)
	if not victim then
		return
	end
	if (stars[victim] or 0) >= 1 then
		local carried = num(victim, "CarriedGold", 0)
		local loss = math.floor(carried * Config.PvP.VillainLossOnWantedPvEDeath)
		if loss > 0 then
			S.ProgressionService.TakeCarriedGold(victim, loss)
		end
	end
	PvPService.ResetStars(victim)
end

-- called ONLY by CombatService's death pipeline (after GrudgeService.OnCarrierDown)
function PvPService.HandleKO(victim, killer)
	if not victim then
		return
	end
	if killer == nil or killer == victim or not isPlaying(killer) then
		PvPService.HandleNonPvPDeath(victim)
		return
	end
	local fk, fv = faction(killer), faction(victim)
	if not isFighter(fk) or not isFighter(fv) or fk == fv then
		-- defensive: Neutral / None / same-faction deaths are never PvP KOs (addendum A6)
		PvPService.HandleNonPvPDeath(victim)
		return
	end

	local P = Config.PvP
	local B = Config.Bully
	local Justice = S.JusticeService
	local Progression = S.ProgressionService
	local now = os.clock()
	local key = pairKey(killer, victim)

	-- 1. snapshot + KO log
	local starsBefore = stars[victim] or 0
	local bullyBefore = bullyStacksOf(victim)
	-- the victim's bully stacks that still pay a bounty (0 once claimed; anti-farm, see BULLY_BOUNTY_COOLDOWN)
	local bountyBully = bountyBullyStacks(victim, now)
	local log = koLog[key]
	if not log then
		log = {}
		koLog[key] = log
	end
	table.insert(log, now)
	pruneTimes(log, now - B.RepeatWindow)

	-- 2. bully check (any faction pairing)
	local weak = (tonumber(Justice.GetPower(victim)) or 0) < B.WeakPowerRatio * (tonumber(Justice.GetPower(killer)) or 0)
	local victimHits = lastHitOn[victim]
	local baitAt = victimHits and victimHits[killer]
	if weak and baitAt and now - baitAt <= B.BaitWindow then
		weak = false -- anti-bait: the victim hit the killer first
	end
	if weak and B.WantedIgnoresWeakRule and (starsBefore > 0 or bullyBefore > 0) then
		weak = false
	end
	local fresh = spawnedAt[victim] ~= nil and now - spawnedAt[victim] < B.FreshSpawnSeconds
	local repeated = #log >= B.RepeatKOs
	local bully = weak or fresh or repeated

	-- 3. revenge (always)
	revenge[victim] = { Target = killer, Until = now + Config.Revenge.Duration }
	setAttr(victim, "RevengeTargetId", killer.UserId)
	setAttr(victim, "RevengeUntil", Util.Now() + Config.Revenge.Duration)
	notify(victim, fmt("Revenge", killer.DisplayName), "info")
	local killerRevenge = revenge[killer]
	if killerRevenge and killerRevenge.Target == victim then
		local wasActive = now < killerRevenge.Until
		clearRevenge(killer)
		if wasActive then
			notify(killer, fmt("RevengeDone"), "good")
		end
	end

	local info
	if bully then
		-- 4. bully KO: no plunder, stars, honor/infamy, bounty or war points
		local n = math.floor(tonumber(Justice.AddBullyStack(killer)) or 0)
		notify(killer, fmt("BullyKO", n), "bad")
		notify(victim, fmt("BullyVictim"), "info")
		refreshStarAttrs(killer) -- bounty doubles while a bully
		info = { Kind = "Bully", Bully = true, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	else
		-- 5. pair cooldown for minted rewards
		local pairOk = now - (pairReward[key] or -math.huge) >= P.PairRewardCooldown
		if pairOk then
			pairReward[key] = now
		end
		local vLevel = num(victim, "Level", 1)

		if fk == "Horns" then
			-- 6a. Horns KO Halo: plunder into the grudge sack
			addStar(killer)
			local stolen = 0
			if not S.GrudgeService.CanSteal(killer, victim) then
				notify(killer, fmt("PlunderTooSoon"), "info")
			else
				local carried = num(victim, "CarriedGold", 0)
				local safeFloor = P.SafeFloorPerLevel * vLevel
				stolen = math.min(math.floor(math.max(0, carried - safeFloor) * P.PlunderRate), P.PlunderCapPerLevel * vLevel)
				if stolen > 0 then
					stolen = math.floor(tonumber(Progression.TakeCarriedGold(victim, stolen)) or 0)
				end
				if stolen > 0 then
					S.GrudgeService.AddToSack(killer, victim, stolen, pairOk and 1 or 0)
					local from, to = rootPos(victim), rootPos(killer)
					if from and to then
						Net.Fx(nil, "Plunder", { From = from, To = to, Amount = stolen })
					end
					notify(victim, fmt("Plundered", killer.DisplayName, Util.FormatNumber(stolen)), "bad")
					notify(killer, fmt("PlunderGain", Util.FormatNumber(stolen), stars[killer] or 0), "reward")
				end
			end
			if stolen == 0 and pairOk then
				S.PlayerService.AddStat(killer, "Infamy", 1) -- no sack to carry it
			end
			local bullyBounty = 0
			if bountyBully > 0 and pairOk then
				bullyBounty = Config.Bounty(vLevel, 0, bountyBully)
				if bullyBounty > 0 then
					bullyBountyAt[victim.UserId] = now -- claimed: no bully bounty on this victim for any killer for a while
					Progression.AddBankGold(killer, bullyBounty, "Bounty")
					notify(killer, fmt("BullyBountyGain", Util.FormatNumber(bullyBounty)), "reward")
				end
			end
			info = {
				Kind = "Plunder", Bully = false, VictimStars = starsBefore,
				Stolen = stolen, Bounty = bullyBounty, Rewarded = pairOk,
			}
		elseif starsBefore == 0 and bountyBully == 0 then
			-- 6b. Halo KO a clean Horns (or a bully whose bounty was already claimed): honor
			if pairOk then
				S.PlayerService.AddStat(killer, "Honor", P.HonorPerKOMin)
				notify(killer, fmt("HonorGain", P.HonorPerKOMin), "reward")
			end
			info = { Kind = "Honor", Bully = false, VictimStars = 0, Stolen = 0, Bounty = 0, Rewarded = pairOk }
		else
			-- 6c. Halo KO a Wanted (or bully) Horns: bounty
			local bounty = pairOk and Config.Bounty(vLevel, starsBefore, bountyBully) or 0
			if bounty > 0 then
				if bountyBully > 0 then
					bullyBountyAt[victim.UserId] = now -- claimed: no bully bounty on this victim for any killer for a while
				end
				Progression.AddBankGold(killer, bounty, "Bounty")
			end
			local honor = pairOk and math.max(1, starsBefore) or 0
			if honor > 0 then
				S.PlayerService.AddStat(killer, "Honor", honor)
			end
			if starsBefore > 0 then
				local carried = num(victim, "CarriedGold", 0)
				local loss = math.floor(carried * P.VillainLossOnBountyKO)
				if loss > 0 then
					Progression.TakeCarriedGold(victim, loss)
				end
			end
			if bounty > 0 or honor > 0 then
				notify(killer, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
			end
			if starsBefore >= P.GlowStars and bounty > 0 then
				Net.NotifyAll(fmt("BountyAnnounce", killer.DisplayName, Util.FormatNumber(bounty)))
			end
			info = {
				Kind = "Bounty", Bully = false, VictimStars = starsBefore,
				Stolen = 0, Bounty = bounty, Rewarded = pairOk,
			}
		end
	end

	-- 7. victim's stars are gone; tell everyone
	PvPService.ResetStars(victim)
	PvPService.PlayerKO:Fire(killer, victim, info)
end

------------------------------------------------------------------ board
local function updateBoard()
	local ok, label = pcall(function()
		return S.MapBuilder.GetBoardLabel()
	end)
	if not ok or not label then
		return
	end

	local wanted, heroes = {}, {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		local bounty = tonumber(p:GetAttribute("Bounty")) or 0
		if bounty > 0 then
			table.insert(wanted, { Name = p.DisplayName, Bounty = bounty, Stars = stars[p] or 0, Bully = bullyStacksOf(p) })
		end
		if faction(p) == "Halo" then
			local honor = num(p, "Honor", 0)
			if honor > 0 then
				table.insert(heroes, { Name = p.DisplayName, Honor = honor })
			end
		end
	end
	table.sort(wanted, function(a, b)
		if a.Bounty ~= b.Bounty then
			return a.Bounty > b.Bounty
		end
		return a.Name < b.Name
	end)
	table.sort(heroes, function(a, b)
		if a.Honor ~= b.Honor then
			return a.Honor > b.Honor
		end
		return a.Name < b.Name
	end)

	local lines = { BOARD_WANTED_TITLE }
	if #wanted == 0 then
		table.insert(lines, BOARD_EMPTY)
	else
		for i = 1, math.min(BOARD_ROWS, #wanted) do
			local w = wanted[i]
			local line = string.format("%d. %s", i, w.Name)
			if w.Stars > 0 then
				line ..= " " .. string.rep("★", w.Stars)
			end
			line ..= " " .. Util.FormatNumber(w.Bounty) .. "G"
			if w.Bully > 0 then
				line ..= " " .. BOARD_BULLY
			end
			table.insert(lines, line)
		end
	end
	table.insert(lines, "")
	table.insert(lines, BOARD_HONOR_TITLE)
	if #heroes == 0 then
		table.insert(lines, BOARD_EMPTY)
	else
		for i = 1, math.min(BOARD_ROWS, #heroes) do
			local h = heroes[i]
			table.insert(lines, string.format("%d. %s %s %s", i, h.Name, BOARD_HONOR_WORD, Util.FormatNumber(h.Honor)))
		end
	end

	local text = table.concat(lines, "\n")
	if label.Text ~= text then
		label.Text = text
	end
end

------------------------------------------------------------------ loops
local function tickPlayer(p, now)
	-- protection expiry
	local pu = protectedUntil[p]
	if pu and pu > 0 and now >= pu then
		protectedUntil[p] = 0
		destroyForceFields(p)
		setAttr(p, "Protected", false)
	end

	-- star decay: one star per StarDecaySeconds, paused while queued / siren / active kaiju
	local s = stars[p] or 0
	if s > 0 then
		if kstate(p) ~= "None" then
			lastStarChange[p] = now
		elseif now - (lastStarChange[p] or now) >= Config.PvP.StarDecaySeconds then
			stars[p] = s - 1
			lastStarChange[p] = now
		end
	end
	refreshStarAttrs(p)
	setAttr(p, "Rookie", rookieAttr(p))

	-- revenge expiry
	local r = revenge[p]
	if r and (now >= r.Until or not isPlaying(r.Target)) then
		clearRevenge(p)
	end
end

local function prunePairs(now)
	local rewardHorizon = Config.PvP.PairRewardCooldown
	for key, t in pairReward do
		if now - t > rewardHorizon then
			pairReward[key] = nil
		end
	end
	for userId, t in bullyBountyAt do
		if now - t >= BULLY_BOUNTY_COOLDOWN then
			bullyBountyAt[userId] = nil
		end
	end
	local cutoff = now - Config.Bully.RepeatWindow
	for key, log in koLog do
		pruneTimes(log, cutoff)
		if #log == 0 then
			koLog[key] = nil
		end
	end
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player)
	stars[player] = 0
	lastStarChange[player] = os.clock()
	protectedUntil[player] = 0
	player:SetAttribute("WantedStars", 0)
	player:SetAttribute("Bounty", 0)
	player:SetAttribute("Rookie", rookieAttr(player))
	player:SetAttribute("Protected", false)
	player:SetAttribute("RevengeTargetId", 0)
	player:SetAttribute("RevengeUntil", 0)
end

local function cleanupPlayer(player)
	clearRevengeInvolving(player)
	stars[player] = nil
	lastStarChange[player] = nil
	protectedUntil[player] = nil
	spawnedAt[player] = nil
	revenge[player] = nil
	lastHitOn[player] = nil
	for _, hits in lastHitOn do
		hits[player] = nil
	end
end

local function onPlayerLeaving(player)
	-- other services' PlayerLeaving handlers (e.g. KaijuService) may still call ResetStars; clean up after them
	clearRevengeInvolving(player)
	task.defer(cleanupPlayer, player)
end

local function onCharacterSpawned(player)
	spawnedAt[player] = os.clock()
	PvPService.Protect(player, Config.PvP.SpawnProtection)
end

local function onPlayerDamaged(victim, _amount, attacker)
	if victim == nil or attacker == nil then
		return
	end
	local hits = lastHitOn[attacker]
	if not hits then
		hits = {}
		lastHitOn[attacker] = hits
	end
	hits[victim] = os.clock()
end

local function onFactionChanged(player)
	PvPService.ResetStars(player)
	-- revenge marks never cross a faction change (and Neutral never gives/gets revenge; A6)
	clearRevengeInvolving(player)
	if isPlaying(player) then
		setAttr(player, "Rookie", rookieAttr(player))
	end
end

------------------------------------------------------------------ lifecycle
function PvPService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	S.CombatService.PlayerDamaged:Connect(onPlayerDamaged)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
end

function PvPService.Start()
	local okBoard, errBoard = pcall(updateBoard)
	if not okBoard then
		Util.Warn(TAG, "board update failed: " .. tostring(errBoard))
	end

	task.spawn(function()
		local boardAcc = 0
		local pruneAcc = 0
		while true do
			task.wait(LOOP_INTERVAL)
			local now = os.clock()
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tickPlayer, p, now)
				if not ok then
					warnLoop(err)
				end
			end

			boardAcc += LOOP_INTERVAL
			if boardAcc >= Config.PvP.BoardRefresh then
				boardAcc = 0
				local ok, err = pcall(updateBoard)
				if not ok then
					warnLoop(err)
				end
			end

			pruneAcc += LOOP_INTERVAL
			if pruneAcc >= PRUNE_INTERVAL then
				pruneAcc = 0
				local ok, err = pcall(prunePairs, now)
				if not ok then
					warnLoop(err)
				end
			end
		end
	end)

	print("[PvPService] started")
end

return PvPService
]]></ProtectedString>
