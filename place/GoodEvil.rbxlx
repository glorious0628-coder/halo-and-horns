		<Item class="ModuleScript" referent="RBXF1D5580D15E449658DA1FF4C45F862EC">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- FactionService.luau : Teams, first faction choice, altar faction switch (free / ticket), SetFaction, faction counts.
-- Factions: "Halo", "Horns", "Neutral" (playable, addendum A6) and "None" (not chosen yet).
-- Faction ratios / counts used by war, Size Justice and rebirth bonuses are Halo vs Horns only (A6).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "FactionService"
local RECOUNT_INTERVAL = 10 -- seconds between periodic faction recounts (spec §4.10)
local LEAVE_FORGET_SECONDS = 60 -- how long a leaving player stays in the "leaving" set (they are gone by then)
local ALTAR_PROMPT_RATE = 0.5 -- private rate limit for the altar ProximityPrompt
local WARN_THROTTLE = 10
-- TODO(config): no Config.Text key for a switch that costs nothing (leaving Neutral, addendum A6);
-- Config.Text.SwitchDonePlain is used instead once it exists.
local TEXT_SWITCH_DONE_PLAIN = "%s(으)로 진영을 바꿨어요!"
local SCORE_NAME = { Halo = "명예", Horns = "악명" } -- score lost by a FREE switch away from that faction
local SCORE_KEY = { Halo = "Honor", Horns = "Infamy" } -- CR-L11: the stat behind SCORE_NAME
local UNDERDOG_IDLE_SECONDS = 120 -- CR-L7: no input / combat for this long = not counted for the underdog bonus

local FactionService = {}

FactionService.FactionChanged = Util.Signal.new() -- (player, newFaction, oldFaction, reason: "Choose" | "Altar" | "Rebirth")

local S = nil
local teams = {} -- [factionId] = Team ("None" = players who have not picked yet)
local NONE_TEAM_NAME = "진영 고르는 중"
local leaving = {} -- [Player] = true while the player is leaving (excluded from counts)
local lastWarnAt = {}

local KNOWN = { Halo = true, Horns = true, Neutral = true, None = true }

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_THROTTLE then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

-- a faction a player may pick / switch to (needs its Config entry)
local function isPlayable(factionId)
	return (factionId == "Halo" or factionId == "Horns" or factionId == "Neutral") and Config.Factions[factionId] ~= nil
end

local function isCounted(player)
	return player ~= nil and player.Parent == Players and not leaving[player]
end

local function notify(player, key, kind, ...)
	local fmt = Config.Text[key]
	if type(fmt) ~= "string" then return end
	Net.Notify(player, string.format(fmt, ...), kind)
end

local function applyTeam(player, factionId)
	local team = teams[factionId]
	local ok, err = pcall(function()
		-- players who have not picked yet sit in the "진영 고르는 중" team, so the player list never shows "Neutral"
		if team and team.Parent then
			player.Neutral = false
			player.Team = team
		else
			player.Team = nil
			player.Neutral = true
		end
	end)
	if not ok then warnThrottled("team", "team assignment failed: " .. tostring(err)) end
end

local function getOrCreateTeam(def)
	if not def or type(def.TeamName) ~= "string" or def.TeamName == "" then return nil end
	local existing = Teams:FindFirstChild(def.TeamName)
	local team = (existing and existing:IsA("Team")) and existing or Instance.new("Team")
	team.Name = def.TeamName
	if def.TeamColor then team.TeamColor = def.TeamColor end
	team.AutoAssignable = false
	team.Parent = Teams
	return team
end

local function recount()
	if not S then return end
	local halo, horns = FactionService.GetCounts()
	local gs = Net.GameState()
	gs:SetAttribute("HaloCount", halo)
	gs:SetAttribute("HornsCount", horns)
	-- CR-L7: rebirth preview (Panels) reads the same counts the server bonus uses
	local uHalo, uHorns = FactionService.GetUnderdogCounts()
	gs:SetAttribute("UnderdogHalo", uHalo)
	gs:SetAttribute("UnderdogHorns", uHorns)
end

local function safeRecount()
	local ok, err = pcall(recount)
	if not ok then warnThrottled("recount", "recount failed: " .. tostring(err)) end
end

local function kaijuState(player)
	local k = S.KaijuService
	if k and k.GetState then
		local ok, st = pcall(k.GetState, player)
		if ok and type(st) == "string" then return st end
	end
	return "None"
end

local function wantedStars(player)
	local p = S.PvPService
	if p and p.GetStars then
		local ok, n = pcall(p.GetStars, player)
		if ok and type(n) == "number" then return n end
	end
	return 0
end

local function bullyStacks(player)
	local j = S.JusticeService
	if j and j.GetBullyStacks then
		local ok, n = pcall(j.GetBullyStacks, player)
		if ok and type(n) == "number" then return n end
	end
	return 0
end

-- data value first, mirrored attribute as fallback
local function statNum(player, key)
	local data = S.PlayerService.GetData(player)
	local v = data and data[key]
	if type(v) ~= "number" then v = player:GetAttribute(key) end
	return tonumber(v) or 0
end

local function lastSwitchTime(player)
	return statNum(player, "LastSwitchTime")
end

-- CR-L7: rookies (PvPService.IsRookie) and idlers (PlayerService.GetLastActive, CR-M20) do not count
local function isUnderdogEligible(player, now)
	local pvp = S.PvPService
	if pvp and pvp.IsRookie then
		local ok, rookie = pcall(pvp.IsRookie, player)
		if ok and rookie == true then return false end
	end
	local ps = S.PlayerService
	if ps and ps.GetLastActive then
		local ok, t = pcall(ps.GetLastActive, player)
		if ok and type(t) == "number" and now - t > UNDERDOG_IDLE_SECONDS then return false end
	end
	return true
end

local function nearAltar(player)
	local root = Util.GetRoot(player)
	if not root then return false end
	local ok, altar = pcall(S.MapBuilder.GetAltar)
	if not ok or typeof(altar) ~= "Instance" or not altar:IsA("BasePart") then return false end
	if Util.FlatDistance(root.Position, altar.Position) > Config.Switch.AltarRange then return false end
	-- CR-H2: a root that just teleported is not near. IsPlausible always logs a suspicious move and returns false
	-- only while Config.AntiCheat.Enforce is true (log-only mode: always true)
	local zs = S.ZoneService
	if zs and zs.IsPlausible then
		local okP, plausible = pcall(zs.IsPlausible, player, root.Position)
		if okP and plausible == false then return false end
	end
	return true
end

-- Spec payload is (useTicket: boolean). Addendum A6 makes the target ambiguous with three factions, so an optional
-- target faction id (string) is accepted in either position: (useTicket, target) or (target, useTicket).
local function parseSwitchArgs(a, b)
	if type(a) == "boolean" then
		if b == nil then return a, nil end
		if type(b) == "string" then return a, b end
		return nil, nil
	end
	if type(a) == "string" and type(b) == "boolean" then
		return b, a
	end
	return nil, nil
end

-- target when the client did not name one: Halo <-> Horns as in the spec; Neutral joins the side that needs players
local function defaultTarget(current)
	if current == "Halo" then return "Horns" end
	if current == "Horns" then return "Halo" end
	local weaker = "None"
	local j = S.JusticeService
	if j and j.GetWeakerFaction then
		local ok, w = pcall(j.GetWeakerFaction)
		if ok then weaker = w end
	end
	if weaker == "Halo" or weaker == "Horns" then return weaker end
	local halo, horns = FactionService.GetCounts()
	return (horns < halo) and "Horns" or "Halo"
end

------------------------------------------------------------------ public API
function FactionService.GetFaction(player)
	if not player then return "None" end
	local f = player:GetAttribute("Faction")
	if type(f) == "string" and KNOWN[f] then return f end
	return "None"
end

function FactionService.GetPerks(player)
	return Config.Factions[FactionService.GetFaction(player)] or Config.Factions.None
end

-- ready players only, excluding leaving players; Neutral / None are not counted (A6: ratios are Halo vs Horns)
function FactionService.GetCounts()
	if not S then return 0, 0 end
	local halo, horns = 0, 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = FactionService.GetFaction(p)
			if f == "Halo" then
				halo += 1
			elseif f == "Horns" then
				horns += 1
			end
		end
	end
	return halo, horns
end

-- CR-L7: GetCounts without rookies and 120 s idlers (underdog rebirth bonus + GameState UnderdogHalo/Horns).
-- `always` (optional Player) is counted even if idle, e.g. the player rebirthing at the altar right now.
function FactionService.GetUnderdogCounts(always)
	if not S then return 0, 0 end
	local now = os.clock()
	local halo, horns = 0, 0
	for _, p in S.PlayerService.GetReadyPlayers() do
		if isCounted(p) then
			local f = FactionService.GetFaction(p)
			if (f == "Halo" or f == "Horns") and (p == always or isUnderdogEligible(p, now)) then
				if f == "Halo" then
					halo += 1
				else
					horns += 1
				end
			end
		end
	end
	return halo, horns
end

function FactionService.GetTeam(factionId)
	local t = teams[factionId]
	if t and t.Parent then return t end
	return nil
end

-- the ONLY writer of the Faction stat. Never touches Honor/Infamy, tickets or cooldowns (callers do).
function FactionService.SetFaction(player, factionId, reason)
	if not player or not S then return end
	if type(factionId) ~= "string" or not KNOWN[factionId] or (factionId ~= "None" and not Config.Factions[factionId]) then
		Util.Warn(TAG, "SetFaction: invalid faction " .. tostring(factionId))
		return
	end
	local old = FactionService.GetFaction(player)
	S.PlayerService.SetStat(player, "Faction", factionId)
	applyTeam(player, factionId)
	FactionService.FactionChanged:Fire(player, factionId, old, reason or "Choose")
	safeRecount()
end

------------------------------------------------------------------ remotes
local function onChooseFaction(player, factionId)
	if not S.PlayerService.IsReady(player) then return end
	if type(factionId) ~= "string" or not isPlayable(factionId) then return end
	if not Util.RateLimit(player, "ChooseFaction", Config.RateLimits.ChooseFaction) then return end
	if FactionService.GetFaction(player) ~= "None" then return end -- silent: first choice only

	-- read BEFORE changing; the sign-on bonus is Halo vs Horns only (A6), GetWeakerFaction never returns "Neutral"
	local wasWeaker = false
	if factionId == "Halo" or factionId == "Horns" then
		wasWeaker = (S.JusticeService.GetWeakerFaction() == factionId)
	end

	FactionService.SetFaction(player, factionId, "Choose")

	if wasWeaker then
		-- CR-L10: the sign-on bonus starts the altar cooldown (no instant free switch after cashing it)
		S.PlayerService.SetStat(player, "LastSwitchTime", os.time())
		S.ProgressionService.AddBankGold(player, Config.Justice.SignOnGold, "Other")
		notify(player, "UnderdogSignOn", "reward", Config.Justice.SignOnGold)
	end
	S.PlayerService.Respawn(player)
end

local function onSwitchFaction(player, a, b)
	if not S.PlayerService.IsReady(player) then return end
	local useTicket, target = parseSwitchArgs(a, b)
	if type(useTicket) ~= "boolean" then return end
	if target ~= nil and not isPlayable(target) then return end
	if not Util.RateLimit(player, "SwitchFaction", Config.RateLimits.SwitchFaction) then return end

	local old = FactionService.GetFaction(player)
	if old == "None" then return end -- silent
	local new = target or defaultTarget(old)
	if new == old or not isPlayable(new) then return end -- silent
	if not nearAltar(player) then return end -- silent

	if S.GrudgeService.HasSack(player) then
		notify(player, "BlockedSack", "bad")
		return
	end
	if kaijuState(player) ~= "None" then
		notify(player, "BlockedKaiju", "bad")
		return
	end
	if wantedStars(player) > 0 then
		notify(player, "BlockedStars", "bad")
		return
	end
	if S.CombatService.IsInCombat(player) then
		notify(player, "TravelBlockedCombat", "bad")
		return
	end
	-- CR-L9: Neutral sheds bully stacks (A6), so a bully may not reach it through the altar
	if new == "Neutral" and bullyStacks(player) > 0 then
		notify(player, "BlockedBully", "bad")
		return
	end
	local remaining = lastSwitchTime(player) + Config.Switch.Cooldown - os.time()
	if remaining > 0 then
		notify(player, "SwitchCooldown", "bad", Util.FormatTime(remaining))
		return
	end

	-- leaving Neutral costs nothing (A6: no Neutral score yet), so a ticket is never consumed for it
	local lostScore = SCORE_NAME[old]
	-- CR-L11: a score of 0 has nothing to protect, so the ticket is kept then too
	local scoreKey = SCORE_KEY[old]
	local atStake = scoreKey ~= nil and statNum(player, scoreKey) > 0
	local ticketUsed = false
	if useTicket and lostScore and atStake then
		local okTicket, why = S.MonetizationService.UseTicket(player, "Faction")
		if not okTicket then
			-- CR-L25: a purchase still being saved is not "no ticket"
			notify(player, why == "Pending" and "TicketSaving" or "NoTicket", "bad")
			return
		end
		ticketUsed = true
	end

	-- free switch: the score of the faction being LEFT resets ("배신의 대가")
	if not ticketUsed then
		if old == "Halo" then
			S.PlayerService.SetStat(player, "Honor", 0)
		elseif old == "Horns" then
			S.PlayerService.SetStat(player, "Infamy", 0)
		end
	end

	S.PlayerService.AddStat(player, "SwitchCount", 1)
	S.PlayerService.SetStat(player, "LastSwitchTime", os.time())
	FactionService.SetFaction(player, new, "Altar")

	local newName = (Config.Factions[new] and Config.Factions[new].Name) or new
	if ticketUsed then
		notify(player, "SwitchDoneTicket", "good", newName)
	elseif lostScore and atStake then
		notify(player, "SwitchDoneFree", "good", newName, lostScore)
	else
		local fmt = Config.Text.SwitchDonePlain
		Net.Notify(player, string.format(type(fmt) == "string" and fmt or TEXT_SWITCH_DONE_PLAIN, newName), "good")
	end
	S.PlayerService.Respawn(player)
end

local function onPromptTriggered(prompt, player)
	if not prompt or prompt.Name ~= "AltarPrompt" then return end
	local parent = prompt.Parent
	if not parent or parent.Name ~= "Altar" then return end
	if not player or not S.PlayerService.IsReady(player) then return end
	if FactionService.GetFaction(player) == "None" then return end
	if not Util.RateLimit(player, "AltarPrompt", ALTAR_PROMPT_RATE) then return end
	Net.Get("OpenPanel"):FireClient(player, "Altar")
end

------------------------------------------------------------------ lifecycle
local function onPlayerReady(player, data)
	leaving[player] = nil
	local f = data and data.Faction
	if type(f) ~= "string" or not KNOWN[f] or (f ~= "None" and not Config.Factions[f]) then
		-- corrupted / unknown value: fall back to "None" (picker shows again). No FactionChanged during join.
		Util.Warn(TAG, "invalid stored faction " .. tostring(f) .. " for " .. player.Name .. "; reset to None")
		S.PlayerService.SetStat(player, "Faction", "None")
		f = "None"
	end
	applyTeam(player, f)
	safeRecount()
end

local function onPlayerLeaving(player)
	leaving[player] = true
	safeRecount()
	task.delay(LEAVE_FORGET_SECONDS, function()
		leaving[player] = nil
	end)
end

function FactionService.Init(registry)
	S = registry
	for _, id in { "Halo", "Horns", "Neutral" } do
		local def = Config.Factions[id]
		if def then
			local ok, teamOrErr = pcall(getOrCreateTeam, def)
			if ok then
				teams[id] = teamOrErr
			else
				Util.Warn(TAG, "could not create team for " .. id .. ": " .. tostring(teamOrErr))
			end
		end
	end
	local okNone, noneTeam = pcall(getOrCreateTeam, { TeamName = NONE_TEAM_NAME, TeamColor = BrickColor.new("Medium stone grey") })
	if okNone and noneTeam then
		noneTeam.AutoAssignable = true -- new players join it before they pick a faction
		teams.None = noneTeam
	end
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
end

function FactionService.Start()
	Net.Get("ChooseFaction").OnServerEvent:Connect(onChooseFaction)
	Net.Get("SwitchFaction").OnServerEvent:Connect(onSwitchFaction)

	-- global hook (survives MapBuilder.Rebuild); filtered to workspace.Map.Landmarks.Altar.AltarPrompt
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
	local ok, altar = pcall(S.MapBuilder.GetAltar)
	if not ok or typeof(altar) ~= "Instance" or not altar:FindFirstChild("AltarPrompt") then
		Util.Warn(TAG, "altar or AltarPrompt not found at start; the altar panel cannot open until it exists")
	end

	task.spawn(function()
		while true do
			task.wait(RECOUNT_INTERVAL)
			safeRecount()
		end
	end)
	safeRecount()

	print("[FactionService] started")
end

return FactionService
]]></ProtectedString>
				<string name="ScriptGuid">{3E26F62E-8530-4933-8158-3CFEC5AD2F8D}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">FactionService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">0812656d40bfdc0e0ad22bf2000008d1</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3798B416DDC040C7A2B180B9F5468B82">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- MonetizationService.luau : Robux change tickets ("변경권"). The ONLY server user of MarketplaceService:
-- owns ProcessReceipt (idempotent; grants only after a successful save) and the ticket counters.
-- data.Tickets and data.ProcessedReceipts are mutated directly here (documented exception).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "MonetizationService"

local MonetizationService = {}

local S = nil

local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet

local ATTRIBUTE = { Class = "ClassTickets", Faction = "FactionTickets" }
local GOT_TEXT = { Class = "ClassTicketGot", Faction = "FactionTicketGot" }
local WAIT_STEP = 0.5

local inFlight = {} -- [PurchaseId string] = true while a receipt is being granted (concurrent retries wait)
-- [Player] = number of that player's receipts being granted. Ticket use is refused meanwhile: a ticket spent before
-- the forced save finished could not be taken back by the rollback, and Roblox would deliver the receipt again.
local inFlightByPlayer = {}

------------------------------------------------------------------ helpers
local function ticketTable(player)
	local data = S.PlayerService.GetData(player)
	if not data then return nil end
	if type(data.Tickets) ~= "table" then
		data.Tickets = { Class = 0, Faction = 0 }
	end
	return data.Tickets
end

local function kindOfProduct(productId)
	for _, p in Config.Products do
		if p.Id ~= 0 and p.Id == productId then
			return p.Kind
		end
	end
	return nil
end

local function notify(player, textKey)
	if player.Parent == nil then return end
	pcall(Net.Notify, player, string.format(Config.Text[textKey]), "reward")
end

-- grant step for a NEW PurchaseId (caller holds inFlight[purchaseId]); returns the decision
local function grant(player, data, kind, purchaseId)
	local receipts = data.ProcessedReceipts
	table.insert(receipts, purchaseId)
	while #receipts > Config.Tickets.MaxReceiptsKept do
		table.remove(receipts, 1)
	end
	MonetizationService.AddTickets(player, kind, 1)

	-- force a save; the purchase is only "granted" once it is persisted
	local okSave, saved = pcall(S.DataService.Save, player, false)
	if okSave and saved then
		notify(player, GOT_TEXT[kind])
		return GRANTED
	end

	-- roll back the in-memory grant (only if this session table is still the live one); Roblox retries later
	if S.PlayerService.GetData(player) == data then
		if MonetizationService.GetTickets(player, kind) >= 1 then
			local idx = table.find(receipts, purchaseId)
			if idx then table.remove(receipts, idx) end
			MonetizationService.AddTickets(player, kind, -1)
		end
		-- else: the granted ticket is already spent (UseTicket is blocked while in flight, so this is a safety net).
		-- Keep the PurchaseId next to that spent ticket: whichever later save persists the spend also persists the id,
		-- so the redelivered receipt returns PurchaseGranted instead of granting a second ticket.
	end
	Util.Warn(TAG, ("save failed for purchase %s of %s; it will be retried"):format(purchaseId, player.Name))
	return NOT_YET
end

local function handleReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then return NOT_YET end

	-- wait for the buyer's data
	local waited = 0
	while not S.PlayerService.IsReady(player) and waited < Config.Tickets.ReceiptWaitSeconds do
		if player.Parent == nil then return NOT_YET end
		task.wait(WAIT_STEP)
		waited += WAIT_STEP
	end
	if player.Parent == nil or not S.PlayerService.IsReady(player) then return NOT_YET end

	local kind = kindOfProduct(info.ProductId)
	if not kind or not ATTRIBUTE[kind] then
		Util.Warn(TAG, ("unknown product id %s (purchase %s)"):format(tostring(info.ProductId), tostring(info.PurchaseId)))
		return NOT_YET
	end

	local data = S.PlayerService.GetData(player)
	if not data then return NOT_YET end
	if type(data.ProcessedReceipts) ~= "table" then
		data.ProcessedReceipts = {}
	end

	local purchaseId = tostring(info.PurchaseId)
	if inFlight[purchaseId] then return NOT_YET end -- the same receipt is being processed right now
	if table.find(data.ProcessedReceipts, purchaseId) then return GRANTED end -- already granted and saved

	inFlight[purchaseId] = true
	inFlightByPlayer[player] = (inFlightByPlayer[player] or 0) + 1
	local ok, decision = pcall(grant, player, data, kind, purchaseId)
	inFlight[purchaseId] = nil
	local left = (inFlightByPlayer[player] or 1) - 1
	if left > 0 then
		inFlightByPlayer[player] = left
	else
		inFlightByPlayer[player] = nil
	end
	if not ok then
		Util.Warn(TAG, "grant error: " .. tostring(decision))
		return NOT_YET
	end
	return decision
end

local function processReceipt(info)
	local ok, decision = pcall(handleReceipt, info)
	if not ok then
		Util.Warn(TAG, "ProcessReceipt error: " .. tostring(decision))
		return NOT_YET
	end
	return decision
end

local function publish(player)
	for kind, attr in ATTRIBUTE do
		player:SetAttribute(attr, MonetizationService.GetTickets(player, kind))
	end
end

------------------------------------------------------------------ public API
function MonetizationService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(function(player)
		publish(player)
	end)
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt -- assigned ONCE, only here

	if RunService:IsStudio() then
		local missing = false
		for _, p in Config.Products do
			if p.Id == 0 then missing = true end
		end
		if missing then
			print("[MonetizationService] Developer Product ids are 0: buy buttons show '상품 준비 중'. Create 2 Developer Products on create.roblox.com (your game > Monetization > Developer Products) and paste their ids into Config.Products.")
		end
	end

	print("[MonetizationService] started")
end

function MonetizationService.GetTickets(player, kind)
	if not ATTRIBUTE[kind] then return 0 end
	local t = ticketTable(player)
	if not t then return 0 end
	local n = tonumber(t[kind]) or 0
	if n ~= n then return 0 end
	return math.max(0, math.floor(n))
end

-- data.Tickets[kind] (>= 0) + attribute; returns the new count
function MonetizationService.AddTickets(player, kind, delta)
	if not ATTRIBUTE[kind] then
		Util.Warn(TAG, "unknown ticket kind: " .. tostring(kind))
		return 0
	end
	local t = ticketTable(player)
	if not t then return 0 end
	delta = tonumber(delta) or 0
	if delta ~= delta or delta == math.huge or delta == -math.huge then delta = 0 end
	local newCount = math.max(0, math.floor(MonetizationService.GetTickets(player, kind) + delta))
	t[kind] = newCount
	player:SetAttribute(ATTRIBUTE[kind], newCount)
	return newCount
end

-- consumes 1 if available. CR-L25: false, "Pending" while a purchase of this player is still being saved (callers
-- show Text.TicketSaving, not NoTicket: the bought ticket is already counted); false, "None" when there is none
function MonetizationService.UseTicket(player, kind)
	if inFlightByPlayer[player] then return false, "Pending" end
	if MonetizationService.GetTickets(player, kind) < 1 then return false, "None" end
	MonetizationService.AddTickets(player, kind, -1)
	return true
end

return MonetizationService
]]></ProtectedString>
				<string name="ScriptGuid">{39E2BB09-E7A0-42DA-BB0D-72E270B148B8}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">MonetizationService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">0812656d40bfdc0e0ad22bf2000008dd</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXA447F04E539246BEA781AFED967335F6">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- WarService.luau : crown war meter ("왕관 쟁탈전") — 10-minute rounds, faction points, blessing, sky color, war chests.
--
-- Story: each round decides which side "holds the crown"; the sky turns the crown's color (Dawn gold / Eclipse blood).
-- Only Halo and Horns take part (addendum A6): Neutral and None never earn war points, never get a chest and never
-- hold the blessing; per-capita scores use FactionService.GetCounts (Halo vs Horns only), averaged over the round
-- (CR-M19). One monster kill adds its WarPoints to the faction pool once, split between contributors (CR-M18).
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local WarService = {}

local TAG = "WarService"
local WAR_FACTIONS = { Halo = true, Horns = true }
local WARN_INTERVAL = 10

-- docs/ART_DIRECTION.md 3.1: fixed lighting applied once in Start (this service owns Lighting; no Atmosphere, A9-3).
-- Values match the A11 Elden-Ring mood baked by tools/preview_map.lua (ShadowSoftness 0.2, Bloom 24/1.4, rays spread 0.4)
-- so the server start does not change the look the creator approved in Studio.
local LIGHTING_FIXED = {
	GlobalShadows = true, ShadowSoftness = 0.2, GeographicLatitude = 35,
	EnvironmentDiffuseScale = 0.3, EnvironmentSpecularScale = 0.3,
}
local TINT_FIXED = { Brightness = 0.02, Contrast = 0.1, Saturation = 0.2 } -- only TintColor is tweened
local SKY_FIXED = { SunAngularSize = 14, MoonAngularSize = 18, StarCount = 3000 }
local BLOOM_FIXED = { Size = 24, Threshold = 1.4 }
local SUNRAYS_FIXED = { Spread = 0.4 }
-- ART_DIRECTION 3.2 per-sky values used only where Config.Sky[name] has no key of its own (Config.Sky stays the source
-- for everything it carries: FogStart / ExposureCompensation / BloomIntensity are read from the preset first).
-- Neutral = A11 (exposure -0.1, bloom 0.4) + preview sun rays 0.08.
local SKY_EXTRAS = {
	Neutral = { Exposure = -0.1, Bloom = 0.4, SunRays = 0.08, Clouds = Color3.fromRGB(255, 255, 255) },
	Dawn = { Exposure = 0.15, Bloom = 0.6, SunRays = 0.12, Clouds = Color3.fromRGB(255, 225, 190) },
	Eclipse = { Exposure = 0.35, Bloom = 0.7, SunRays = 0, Clouds = Color3.fromRGB(110, 40, 50) }, -- monsters stay visible at night
}

local S = nil
local points = { Halo = 0, Horns = 0 } -- faction pools of the current round
local personal = {} -- [Player] = personal points of the current round
local blessing = "None" -- faction holding the crown (decided at each round end, lasts one round)
local roundEndsAt = 0
local warTint = nil
local skyTweens = {}
local lastWarnAt = {}
-- CR-M19: head counts summed every tick of the current round; the per-capita divisor is the round AVERAGE, so a
-- last-second exodus cannot flip the result
local presence = { Halo = 0, Horns = 0, Ticks = 0 }
-- CR-L20: ClockTime is tweened through this NumberValue (always forward, wrapping at 24)
local clock = { Value = nil, Conn = nil }

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_INTERVAL then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, msg)
end

local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function getFaction(player)
	if S and S.FactionService then
		local ok, f = pcall(S.FactionService.GetFaction, player)
		if ok and type(f) == "string" then return f end
	end
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function isValidAmount(n)
	return type(n) == "number" and n == n and n > 0 and n < math.huge
end

local function round1(x)
	return math.floor(x * 10 + 0.5) / 10
end

local function setPersonal(player, value)
	personal[player] = value
	if player.Parent then
		player:SetAttribute("WarPoints", value)
	end
end

------------------------------------------------------------------ sky
-- sets each property in its own pcall (newer Lighting properties may be missing on older engines)
local function setProps(inst, props)
	for k, v in props do
		local ok, err = pcall(function()
			inst[k] = v
		end)
		if not ok then
			warnThrottled("prop:" .. k, ("could not set %s.%s: %s"):format(inst.ClassName, k, tostring(err)))
		end
	end
end

local function findOrCreate(parent, className)
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Parent = parent
	end
	return inst
end

local function ensureTint()
	if warTint and warTint.Parent == Lighting then return warTint end
	local existing = Lighting:FindFirstChild("WarTint")
	if existing and existing:IsA("ColorCorrectionEffect") then
		warTint = existing
	else
		if existing then
			existing.Name = "WarTint_Old" -- something else took the contract name; keep it, but out of the way
		end
		warTint = Instance.new("ColorCorrectionEffect")
		warTint.Name = "WarTint"
		setProps(warTint, TINT_FIXED)
		warTint.Parent = Lighting
	end
	return warTint
end

-- ART_DIRECTION 3.1, once in Start
local function bootstrapLighting()
	pcall(function()
		Lighting.LightingStyle = Enum.LightingStyle.Soft
	end)
	pcall(function()
		Lighting.PrioritizeLightingQuality = true
	end)
	setProps(Lighting, LIGHTING_FIXED)
	setProps(ensureTint(), TINT_FIXED)
	setProps(findOrCreate(Lighting, "Sky"), SKY_FIXED)
	setProps(findOrCreate(Lighting, "BloomEffect"), BLOOM_FIXED)
	setProps(findOrCreate(Lighting, "SunRaysEffect"), SUNRAYS_FIXED)
	if Lighting:FindFirstChildOfClass("Atmosphere") then
		Util.Warn(TAG, "Lighting has an Atmosphere: it hides the FogColor/FogEnd war sky (addendum A9-3). Remove it.")
	end
end

local function skyNameFor(winner)
	if winner == "Halo" then return "Dawn" end
	if winner == "Horns" then return "Eclipse" end
	return "Neutral"
end

local function num(v)
	return (type(v) == "number" and v == v) and v or nil
end

-- CR-L20: a tween of ClockTime toward `target` that only runs FORWARD (to < from -> to + 24, written back as v % 24);
-- a plain number tween ran the sun backwards (16.8 -> 0.5). nil when there is nothing to tween or it failed.
local function clockTween(target, info)
	local from = Lighting.ClockTime
	local to = target
	if to < from then
		to += 24
	end
	if to - from < 1e-3 then return nil end
	if not clock.Value then
		local nv = Instance.new("NumberValue")
		nv.Name = "WarClock"
		clock.Value = nv
		clock.Conn = nv.Changed:Connect(function(v)
			Lighting.ClockTime = v % 24
		end)
	end
	clock.Value.Value = from
	local ok, tweenOrErr = pcall(TweenService.Create, TweenService, clock.Value, info, { Value = to })
	if not ok then
		warnThrottled("clock", "clock tween failed: " .. tostring(tweenOrErr))
		setProps(Lighting, { ClockTime = target })
		return nil
	end
	return tweenOrErr
end

-- applies Config.Sky[name] to Lighting + WarTint (FogStart / ExposureCompensation / BloomIntensity when the preset has
-- them, addendum A9-4/A11/A12), plus the ART_DIRECTION extras for whatever the preset does not carry
local function applySky(name, animate)
	local preset = Config.Sky[name]
	if type(preset) ~= "table" then return end
	local extras = SKY_EXTRAS[name] or SKY_EXTRAS.Neutral
	for _, t in skyTweens do
		t:Cancel()
	end
	table.clear(skyTweens)

	-- ClockTime is not in the goal: it is tweened forward on its own (CR-L20)
	local lightingGoal = {
		Brightness = preset.Brightness, Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient, FogColor = preset.FogColor, FogEnd = preset.FogEnd,
		FogStart = num(preset.FogStart), -- nil (left as is) when the preset has none
		ExposureCompensation = num(preset.ExposureCompensation) or extras.Exposure,
	}
	local fogStart, fogEnd = lightingGoal.FogStart, num(preset.FogEnd)
	if fogStart and fogEnd and fogStart >= fogEnd then
		lightingGoal.FogStart = math.max(0, fogEnd - 1) -- FogStart must stay below FogEnd
	end
	local goals = { { Lighting, lightingGoal } }
	if preset.Tint then
		table.insert(goals, { ensureTint(), { TintColor = preset.Tint } })
	end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then table.insert(goals, { bloom, { Intensity = num(preset.BloomIntensity) or extras.Bloom } }) end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then table.insert(goals, { rays, { Intensity = extras.SunRays } }) end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then table.insert(goals, { clouds, { Color = extras.Clouds } }) end
	local clockTarget = num(preset.ClockTime)

	if animate then
		local info = TweenInfo.new(Config.Sky.TweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		for _, g in goals do
			local ok, tweenOrErr = pcall(TweenService.Create, TweenService, g[1], info, g[2])
			if ok then
				table.insert(skyTweens, tweenOrErr)
				tweenOrErr:Play()
			else
				warnThrottled("tween", "sky tween failed: " .. tostring(tweenOrErr))
				setProps(g[1], g[2])
			end
		end
		local clockT = clockTarget and clockTween(clockTarget, info)
		if clockT then
			table.insert(skyTweens, clockT)
			clockT:Play()
		end
	else
		for _, g in goals do
			setProps(g[1], g[2])
		end
		if clockTarget then
			setProps(Lighting, { ClockTime = clockTarget }) -- no animation: set at once (CR-L20)
		end
	end
end

------------------------------------------------------------------ round state
local function getCounts()
	if not (S and S.FactionService) then return 0, 0 end
	local ok, halo, horns = pcall(S.FactionService.GetCounts)
	if not ok then
		warnThrottled("counts", "GetCounts failed: " .. tostring(halo))
		return 0, 0
	end
	return tonumber(halo) or 0, tonumber(horns) or 0
end

-- CR-M19: adds this tick's head counts to the round sums; returns the round-average counts (an average below 0.5 -
-- a side that was barely online this round - counts as 0)
local function averageCounts(halo, horns)
	presence.Halo += halo
	presence.Horns += horns
	presence.Ticks += 1
	local aH = presence.Halo / presence.Ticks
	local aR = presence.Horns / presence.Ticks
	if aH < 0.5 then aH = 0 end
	if aR < 0.5 then aR = 0 end
	return aH, aR
end

local function modeFor(halo, horns)
	if halo == 0 and horns == 0 then return "Idle" end
	if halo == 0 or horns == 0 then return "Siege" end
	return "Normal"
end

-- writes the per-capita scores, mode and round end to GameState; returns (haloScore, hornsScore, mode).
-- halo / horns = head counts (the round averages during a round, CR-M19; may be fractional)
local function publish(halo, horns)
	local haloScore = points.Halo / math.max(1, halo)
	local hornsScore = points.Horns / math.max(1, horns)
	local mode = modeFor(halo, horns)
	local gs = Net.GameState()
	gs:SetAttribute("WarHaloScore", round1(haloScore))
	gs:SetAttribute("WarHornsScore", round1(hornsScore))
	gs:SetAttribute("WarRoundEndsAt", roundEndsAt)
	gs:SetAttribute("WarMode", mode)
	return haloScore, hornsScore, mode
end

local function decideWinner(mode, haloScore, hornsScore, halo, horns)
	if mode == "Normal" then
		if haloScore > hornsScore then return "Halo" end
		if hornsScore > haloScore then return "Horns" end
		return "None"
	elseif mode == "Siege" then
		local present = (halo > 0) and "Halo" or "Horns"
		local score = (present == "Halo") and haloScore or hornsScore
		if score >= Config.War.SiegeTarget then return present end
		return "None"
	end
	return "None" -- Idle
end

local function payChests(winner, snapshot)
	for _, player in S.PlayerService.GetReadyPlayers() do
		local ok, err = pcall(function()
			local f = getFaction(player)
			if not WAR_FACTIONS[f] then return end
			if (snapshot[player] or 0) < Config.War.ChestMinPoints then return end
			local level = tonumber(player:GetAttribute("Level")) or 1
			local perLevel = (winner ~= "None" and f == winner) and Config.War.WinnerChestPerLevel or Config.War.LoserChestPerLevel
			local amount = math.floor(level * perLevel)
			if amount <= 0 then return end
			S.ProgressionService.AddBankGold(player, amount, "War")
			Net.Notify(player, string.format(Config.Text.WarChest, Util.FormatNumber(amount)), "reward")
		end)
		if not ok then
			warnThrottled("chest", "war chest error: " .. tostring(err))
		end
	end
end

-- halo / horns = round-average head counts (decide the winner); curHalo / curHorns = counts now (next round's publish)
local function endRound(mode, haloScore, hornsScore, halo, horns, curHalo, curHorns)
	-- advance + reset first so a failure below can never re-trigger the same round end every tick
	local snapshot = table.clone(personal)
	roundEndsAt = Util.Now() + Config.War.RoundSeconds
	points.Halo = 0
	points.Horns = 0
	presence.Halo = 0 -- CR-M19
	presence.Horns = 0
	presence.Ticks = 0
	for player in snapshot do
		setPersonal(player, 0)
	end

	local winner = decideWinner(mode, haloScore, hornsScore, halo, horns)
	blessing = winner
	Net.GameState():SetAttribute("WarBlessing", winner)
	applySky(skyNameFor(winner), true)

	payChests(winner, snapshot)

	if mode ~= "Idle" then
		if winner ~= "None" and Config.Story.WarWin[winner] then
			Net.NotifyAll(string.format(Config.Story.WarWin[winner]))
		else
			Net.NotifyAll(string.format(Config.Story.WarDraw))
		end
	end

	publish(curHalo or halo, curHorns or horns) -- new round: no averages yet
end

local function tick()
	local halo, horns = getCounts()
	local aH, aR = averageCounts(halo, horns) -- CR-M19
	local haloScore, hornsScore, mode = publish(aH, aR)
	if Util.Now() >= roundEndsAt then
		endRound(mode, haloScore, hornsScore, aH, aR, halo, horns)
	end
end

------------------------------------------------------------------ public API
-- personal + faction pool (monster kills, rewarded PvP KOs). poolN (optional, CR-M18) = this player's share of the
-- pool: one monster killed by k same-faction contributors adds WarPoints / k each (WarShare), so the pool gets
-- WarPoints once while every contributor still gets n personal points. Invalid / missing poolN -> n (capped at n).
function WarService.AddPoints(player, n, poolN)
	if not isPlayer(player) or not isValidAmount(n) then return end
	if not (S and S.PlayerService.IsReady(player)) then return end
	local f = getFaction(player)
	if not WAR_FACTIONS[f] then return end -- None / Neutral never earn war points
	points[f] += isValidAmount(poolN) and math.min(poolN, n) or n
	setPersonal(player, (personal[player] or 0) + n)
end

-- faction pool only (events: goose, kaiju)
function WarService.AddFactionPoints(factionId, n)
	if not WAR_FACTIONS[factionId] or not isValidAmount(n) then return end
	points[factionId] += n
end

-- blessing faction == player's faction (Halo/Horns only)
function WarService.HasBlessing(player)
	if not isPlayer(player) or blessing == "None" then return false end
	local f = getFaction(player)
	return WAR_FACTIONS[f] == true and f == blessing
end

function WarService.GetBlessingFaction()
	return blessing
end

function WarService.GetPersonalPoints(player)
	return personal[player] or 0
end

-- server time of the current round end; valid after Start
function WarService.GetRoundEndsAt()
	if roundEndsAt <= 0 then
		return Util.Now() + Config.War.RoundSeconds
	end
	return roundEndsAt
end

------------------------------------------------------------------ lifecycle
function WarService.Init(registry)
	S = registry
	ensureTint()

	if S.MonsterService and S.MonsterService.MonsterKilled then
		S.MonsterService.MonsterKilled:Connect(function(player, info)
			if type(info) == "table" then
				WarService.AddPoints(player, info.WarPoints, info.WarShare) -- CR-M18: pool share per contributor
			end
		end)
	else
		Util.Warn(TAG, "MonsterService.MonsterKilled missing; monster kills give no war points")
	end

	if S.PvPService and S.PvPService.PlayerKO then
		S.PvPService.PlayerKO:Connect(function(killer, _victim, info)
			if type(info) == "table" and info.Rewarded == true then
				local stars = tonumber(info.VictimStars) or 0
				WarService.AddPoints(killer, Config.War.PvPKOPoints + Config.War.PvPKOPerStar * stars)
			end
		end)
	else
		Util.Warn(TAG, "PvPService.PlayerKO missing; PvP KOs give no war points")
	end

	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player)
			if isPlayer(player) then setPersonal(player, 0) end
		end)
	end

	S.PlayerService.PlayerReady:Connect(function(player)
		setPersonal(player, 0)
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		personal[player] = nil
	end)
end

function WarService.Start()
	bootstrapLighting()
	applySky("Neutral", false)
	roundEndsAt = Util.Now() + Config.War.RoundSeconds
	Net.GameState():SetAttribute("WarBlessing", blessing)
	local halo, horns = getCounts()
	publish(halo, horns)

	task.spawn(function()
		while true do
			task.wait(Config.War.Tick)
			local ok, err = pcall(tick)
			if not ok then
				warnThrottled("tick", "tick error: " .. tostring(err))
			end
		end
	end)

	print("[WarService] started")
end

return WarService
]]></ProtectedString>
