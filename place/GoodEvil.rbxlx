					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">UIKit</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">00a781d6b8ab04140ad785ab0000637d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX889A9A6672B64F81BABB588CA1C0B336">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- FountainFx.luau : flowing water on the plaza fountains, drawn by every client (user 2026-10-07: "물줄기도 나오게 해야지
-- 로블록스 이펙트 사용해서!"). Free Creator Store effect textures only (A23-62: texture ids, no imported scripts; sources in
-- docs/design/skill_vfx_sources.md): a jet from the top spout, thin water streams (Beams with a flowing texture) falling from
-- each bowl rim, droplet splashes + ripples where they land, a few sparkles on the pool, and for the Halo fountain a
-- golden halo ring with one warm light. Specs per fountain model name, as fractions of the model's bounding box (a
-- rescaled model still fits). Phones and "Screen Shake: Off" (or Roblox Reduced Motion) get fewer particles.
-- Everything is client-side (Anchored, no collision / queries / touch) in a "WaterFx" folder inside the model.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local FountainFx = {}
local TAG = "FountainFx"
local C = nil

local TEX = {
	Drop = "rbxassetid://401407269", -- "Fountain (water) particles" (SparkleWays, 458829107)
	Flow = "rbxassetid://6045867277", -- "Water Beam Effect VFX" (EvilArtist, 14582235284): thin soft streams
	Ripple = "rbxassetid://9833214445", -- "Stylized Water Particles Splash Effect RP" (MoonRocket29609, 104302188311459)
	Sparkle = "rbxassetid://244221535", -- "Sparkles Particle" (Nanonauts, 688891088)
}
local COL = {
	Water = Color3.fromRGB(150, 214, 255), -- a little more sky blue: reads from the walk (검수 play-view check)
	Foam = Color3.fromRGB(240, 251, 255),
	Gold = Color3.fromRGB(255, 226, 140),
	Halo = Color3.fromRGB(255, 214, 90),
}
-- Y / R are fractions of the bounding box (height / the wider of X and Z); R is measured from the centre
local SPECS = {
	-- Crossroads (Roblox generate_mesh kit, 21 x 20.4 x 21): top spout, small upper bowl, wide scalloped middle bowl,
	-- round pool (rim heights measured with rays on its collision mesh, 2026-10-07)
	K_Fountain = {
		Jet = { Y = 1.0, Up = 12 },
		Curtains = {
			{ FromY = 0.75, FromR = 0.21, ToY = 0.53, ToR = 0.235, Count = 16, Width = 2.2 },
			{ FromY = 0.525, FromR = 0.305, ToY = 0.13, ToR = 0.335, Count = 24, Width = 2.8, Ripples = true },
		},
		Pool = { Y = 0.13, R = 0.42 },
	},
	-- Halo town (Tripo 3b HD, two cloud tiers + a floating halo ring): first guess, tuned when the model is in the place
	Town_Halo_Fountain = {
		Jet = { Y = 0.86, Up = 11 },
		Curtains = {
			{ FromY = 0.62, FromR = 0.24, ToY = 0.18, ToR = 0.28, Count = 20, Width = 2.6, Ripples = true },
		},
		Pool = { Y = 0.17, R = 0.4 },
		Halo = { Y = 1.02, R = 0.18 },
	},
}
local S = { Started = false, Built = setmetatable({}, { __mode = "k" }), Emitters = {} } -- Emitters: { Emitter, Rate, Kind }

local function lowFx()
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local shakeOff = false
	local st = C and C.Settings
	if type(st) == "table" and type(st.Get) == "function" then
		local ok, v = pcall(st.Get, "Shake")
		shakeOff = ok and v == false
	end
	local okRm, reduced = pcall(function() return GuiService.ReducedMotionEnabled end)
	return touchOnly, shakeOff or (okRm and reduced == true)
end

-- the base rate times the device / setting factor (sparkles drop most)
local function applyRates()
	local phone, calm = lowFx()
	for _, e in S.Emitters do
		if e.Emitter.Parent then
			local k = 1
			if phone then k *= 0.55 end
			if calm then k *= (e.Kind == "Sparkle" and 0.25 or 0.7) end
			e.Emitter.Rate = e.Rate * k
		end
	end
end

local function seq(points)
	local kp = {}
	for _, p in points do table.insert(kp, NumberSequenceKeypoint.new(p[1], p[2])) end
	return NumberSequence.new(kp)
end

local function emitter(parent, kind, props)
	local e = Instance.new("ParticleEmitter")
	e.Name = kind
	e.LightInfluence = 0.5
	e.LockedToPart = false
	for k, v in props do e[k] = v end
	e.Parent = parent
	table.insert(S.Emitters, { Emitter = e, Rate = props.Rate or 5, Kind = kind })
	return e
end

local function hubPart(folder, cf)
	local p = Instance.new("Part")
	p.Name = "Hub"
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = cf
	p.Parent = folder
	return p
end

local function attach(hub, name, worldPos)
	local a = Instance.new("Attachment")
	a.Name = name
	a.Parent = hub
	a.WorldPosition = worldPos
	return a
end

local function build(model, spec)
	if S.Built[model] then return end
	S.Built[model] = true
	local cf, size = model:GetBoundingBox()
	local base = cf.Position - Vector3.new(0, size.Y / 2, 0)
	local H, W = size.Y, math.max(size.X, size.Z)
	local function at(r, y, angle)
		return base + Vector3.new(math.cos(angle) * r * W, y * H, math.sin(angle) * r * W)
	end
	local old = model:FindFirstChild("WaterFx")
	if old then old:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "WaterFx"
	folder.Parent = model
	local hub = hubPart(folder, CFrame.new(base))

	-- the jet: a short column out of the top spout, its drops falling back into the top bowl
	if spec.Jet then
		local a = attach(hub, "Jet", at(0, spec.Jet.Y, 0) + Vector3.new(0, 0.2, 0))
		emitter(a, "Jet", {
			Texture = TEX.Drop, EmissionDirection = Enum.NormalId.Top, Rate = 34,
			Speed = NumberRange.new(spec.Jet.Up * 0.85, spec.Jet.Up * 1.1), SpreadAngle = Vector2.new(5, 5),
			Acceleration = Vector3.new(0, -38, 0), Drag = 0.4, Lifetime = NumberRange.new(0.55, 0.75),
			Size = seq({ { 0, 0.35 }, { 0.15, 0.6 }, { 1, 0.25 } }), Transparency = seq({ { 0, 0.1 }, { 0.7, 0.25 }, { 1, 1 } }),
			Color = ColorSequence.new(COL.Water, COL.Foam), LightEmission = 0.3,
		})
		emitter(a, "Spray", {
			Texture = TEX.Drop, EmissionDirection = Enum.NormalId.Top, Rate = 14,
			Speed = NumberRange.new(4, 7), SpreadAngle = Vector2.new(38, 38), Acceleration = Vector3.new(0, -30, 0),
			Lifetime = NumberRange.new(0.6, 0.9), Size = seq({ { 0, 0.35 }, { 1, 0.12 } }),
			Transparency = seq({ { 0, 0.2 }, { 1, 1 } }), Color = ColorSequence.new(COL.Foam), LightEmission = 0.3,
		})
	end

	-- curtains: flowing sheets from each rim (texture runs down), a splash and ripples where they land
	for t, c in spec.Curtains or {} do
		local offset = (t % 2 == 0) and (math.pi / c.Count) or 0
		for i = 1, c.Count do
			local angle = (i - 0.5) / c.Count * math.pi * 2 + offset
			local a0 = attach(hub, "Rim" .. t .. "_" .. i, at(c.FromR, c.FromY, angle))
			local a1 = attach(hub, "Land" .. t .. "_" .. i, at(c.ToR, c.ToY, angle) + Vector3.new(0, 0.1, 0))
			local b = Instance.new("Beam")
			b.Name = "Curtain"
			b.Attachment0, b.Attachment1 = a0, a1
			b.Texture = TEX.Flow
			b.TextureMode = Enum.TextureMode.Wrap
			b.TextureLength = 3
			b.TextureSpeed = 1.6
			b.Width0, b.Width1 = c.Width * 0.8, c.Width
			b.FaceCamera = true
			b.Segments = 4
			b.Transparency = seq({ { 0, 0.15 }, { 0.5, 0.28 }, { 1, 0.6 } })
			b.Color = ColorSequence.new(COL.Water, COL.Foam)
			b.LightEmission = 0.7
			b.LightInfluence = 0.45
			b.Parent = a0
			emitter(a1, "Splash", {
				Texture = TEX.Drop, EmissionDirection = Enum.NormalId.Top, Rate = 2.5,
				Speed = NumberRange.new(3, 6), SpreadAngle = Vector2.new(45, 45), Acceleration = Vector3.new(0, -26, 0),
				Lifetime = NumberRange.new(0.4, 0.7), Size = seq({ { 0, 0.5 }, { 0.4, 0.95 }, { 1, 0.4 } }),
				Transparency = seq({ { 0, 0.12 }, { 0.6, 0.35 }, { 1, 1 } }), Color = ColorSequence.new(COL.Foam), LightEmission = 0.45,
			})
			if c.Ripples then
				emitter(a1, "Ripple", {
					Texture = TEX.Ripple, EmissionDirection = Enum.NormalId.Top, Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
					Rate = 0.4, Speed = NumberRange.new(0.01), Lifetime = NumberRange.new(0.9), Size = seq({ { 0, 0.6 }, { 1, 2.6 } }),
					Transparency = seq({ { 0, 0.35 }, { 1, 1 } }), Color = ColorSequence.new(COL.Foam), LightEmission = 0.2,
				})
			end
		end
	end

	-- a few twinkles on the pool surface
	if spec.Pool then
		local r = spec.Pool.R * W
		local pad = Instance.new("Part")
		pad.Name = "PoolSparkle"
		pad.Anchored, pad.CanCollide, pad.CanQuery, pad.CanTouch, pad.CastShadow = true, false, false, false, false
		pad.Transparency = 1
		pad.Size = Vector3.new(r * 1.6, 0.1, r * 1.6)
		pad.CFrame = CFrame.new(base + Vector3.new(0, spec.Pool.Y * H + 0.15, 0))
		pad.Parent = folder
		emitter(pad, "Sparkle", {
			Texture = TEX.Sparkle, Rate = 4, Speed = NumberRange.new(0), Lifetime = NumberRange.new(0.8, 1.2),
			Size = seq({ { 0, 0 }, { 0.25, 0.5 }, { 1, 0 } }), Transparency = seq({ { 0, 0.1 }, { 1, 0.4 } }),
			Color = ColorSequence.new(COL.Foam, COL.Gold), LightEmission = 1, ZOffset = 0.5,
			Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-60, 60),
		})
	end

	-- the Halo fountain's floating ring is part of its model: a warm glow and slow sparkles around it (one light; the
	-- map keeps under 40)
	if spec.Halo then
		local glow = Instance.new("Part")
		glow.Name = "HaloGlow"
		glow.Anchored, glow.CanCollide, glow.CanQuery, glow.CanTouch, glow.CastShadow = true, false, false, false, false
		glow.Transparency = 1
		local d = spec.Halo.R * W * 2
		glow.Size = Vector3.new(d, 0.4, d)
		glow.CFrame = CFrame.new(base + Vector3.new(0, spec.Halo.Y * H, 0))
		glow.Parent = folder
		local light = Instance.new("PointLight")
		light.Color = COL.Halo
		light.Range = 14
		light.Brightness = 1.2
		light.Shadows = false
		light.Parent = glow
		emitter(glow, "HaloSparkle", {
			Texture = TEX.Sparkle, Rate = 3, Speed = NumberRange.new(0.3, 0.8), SpreadAngle = Vector2.new(180, 180),
			Lifetime = NumberRange.new(1, 1.6), Size = seq({ { 0, 0 }, { 0.3, 0.45 }, { 1, 0 } }),
			Color = ColorSequence.new(COL.Halo, COL.Foam), LightEmission = 1, Transparency = seq({ { 0, 0.1 }, { 1, 0.5 } }),
		})
	end
	applyRates()
end

local function consider(inst)
	local spec = SPECS[inst.Name]
	if not spec or not inst:IsA("Model") then return end
	task.defer(function()
		if inst.Parent then
			local ok, err = pcall(build, inst, spec)
			if not ok then warn("[" .. TAG .. "] build failed for " .. inst:GetFullName() .. ": " .. tostring(err)) end
		end
	end)
end

function FountainFx.Init(registry)
	C = registry
end

function FountainFx.Start()
	if S.Started then return end
	S.Started = true
	for _, d in workspace:GetDescendants() do consider(d) end
	workspace.DescendantAdded:Connect(consider)
	local st = C and C.Settings
	if type(st) == "table" and type(st.Changed) == "table" then
		st.Changed:Connect(function() pcall(applyRates) end)
	end
	pcall(function() GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(function() pcall(applyRates) end) end)
	print("[FountainFx] started")
end

-- test aid (Studio Edit preview through require): build on one model now, no listeners; the caller removes the
-- model's "WaterFx" folder afterwards
function FountainFx.BuildOn(model)
	local spec = typeof(model) == "Instance" and SPECS[model.Name]
	if not spec then return false end
	S.Built[model] = nil
	build(model, spec)
	return true
end

-- test aid: how many emitters / beams this client built
function FountainFx.Stats()
	local beams = 0
	for model in S.Built do
		local f = model:FindFirstChild("WaterFx")
		if f then
			for _, d in f:GetDescendants() do if d:IsA("Beam") then beams += 1 end end
		end
	end
	return { Emitters = #S.Emitters, Beams = beams }
end

return FountainFx
]]></ProtectedString>
					<string name="ScriptGuid">{46F52323-B629-43B9-92F1-21ECDE6F6340}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">FountainFx</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">00a781d6b8ab04140ad785ab00006377</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX05F9DA89961248318BDC7AF4D954447F">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Keep Roblox's default camera attached when the server replaces an avatar with a costume rig.
-- A23-51 (user 2026-10-06): the camera turns with the RIGHT mouse drag only, owned by Roblox's default PlayerModule
-- camera (nothing here touches it); a left drag never turns the camera. A left press on the world = one attack:
-- PrimaryClick fires on the press, holding or dragging never repeats it. Touch and gamepad stay with Roblox.
-- A23-65 (user 2026-10-07 "캐릭터가 움직일 때 카메라도 같이 움직이면 좋겠어. 캐릭터의 뒤를 따라서!"): while I walk, the
-- camera turns slowly around me toward my walking direction (I end up seen from behind). It is a yaw-only turn of the
-- camera around its Focus, after Roblox's camera each frame (render step HHC_CameraFollow), capped per second and
-- eased (45 deg/s), slower with 'Screen shake' off. It never turns while I stand, while I walk toward the camera (no spinning
-- when backing up), for FOLLOW.ManualHold s after a hand turn (right drag, a finger drag on the camera side, the right
-- stick), for FOLLOW.AttackHold s after my swing / skill (FaceTarget / the server turning my body never whips the
-- camera), in shift lock or first person, and whenever blocked() (windows, the opening, menus, loading). Settings
-- "Cam" = "Free" turns it off. The right-drag turn itself stays Roblox's (A23-51).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local CameraFollow = {}
local primaryClick = Instance.new("BindableEvent")
CameraFollow.PrimaryClick = primaryClick.Event
local registry = nil
local started, queued = false, false
local character = nil
local characterConnections, cameraConnections = {}, {}
local FOLLOW = {
	-- max turn speed (rad / s); 'Screen shake' off = slow. Studio 2026-10-07: at 110 deg/s a held sideways key (the
	-- stick to one side) chased its own camera-relative direction into an 8-stud circle; 45 deg/s makes a wide arc
	Rate = math.rad(45), SlowRate = math.rad(25),
	Ease = 1.2, SlowEase = 0.7, -- share of the remaining angle turned per second
	DeadZone = math.rad(6), -- a smaller misalignment is left alone
	-- only while walking mostly forward (walk . camera look >= MinDot; 검수 2026-10-07: a sidestep or a walk toward the
	-- camera never turns it - sideways it kept circling)
	MinDot = 0.5,
	MinMove = 0.2, -- MoveDirection length that counts as walking
	ManualHold = 1.5, AttackHold = 0.5, -- s
	CameraSide = 0.4, -- a finger drag that starts right of this share of the screen turns the camera (not the stick)
	LastManual = -math.huge, LastAttack = -math.huge, Touches = {},
}

local function blocked()
	if GuiService.MenuIsOpen or UserInputService:GetFocusedTextBox() then return true end
	if LocalPlayer:GetAttribute("DataLoaded") ~= true then return true end
	for _, name in { "FactionPicker", "ClassPicker", "Panels", "WorldMap" } do
		local module = registry and registry[name]
		if module and type(module.IsOpen) == "function" and module.IsOpen() then return true end
	end
	local camera = workspace.CurrentCamera
	return not camera or camera.CameraType ~= Enum.CameraType.Custom
		or not character or character ~= LocalPlayer.Character
		or not character:IsDescendantOf(workspace)
end

-- one attack per left press on the world (a press on a GUI is processed and never attacks)
local function onPrimaryBegan(input, processed)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 or processed or blocked() then return end
	primaryClick:Fire()
end

-- the settings value (C.Settings), default when unknown
local function setting(key, default)
	local st = registry and registry.Settings
	if type(st) ~= "table" or type(st.Get) ~= "function" then return default end
	local ok, v = pcall(st.Get, key)
	if not ok or v == nil then return default end
	return v
end

-- one frame of the follow turn (after Roblox's camera, priority Camera + 1)
function FOLLOW.Step(dt)
	if setting("Cam", "Follow") == "Free" or blocked() then return end
	local now = os.clock()
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then FOLLOW.LastManual = now end
	if now - FOLLOW.LastManual < FOLLOW.ManualHold or now - FOLLOW.LastAttack < FOLLOW.AttackHold then return end
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then return end -- shift lock turns me itself
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local move = humanoid and humanoid.MoveDirection
	if not move or move.Magnitude < FOLLOW.MinMove then return end
	local camera = workspace.CurrentCamera
	local cf, focus = camera.CFrame, camera.Focus.Position
	if (focus - cf.Position).Magnitude < 1 then return end -- first person
	local look = cf.LookVector
	local cx, cz, mx, mz = look.X, look.Z, move.X, move.Z
	local cl, ml = math.sqrt(cx * cx + cz * cz), math.sqrt(mx * mx + mz * mz)
	if cl < 0.05 or ml < 0.05 then return end
	cx, cz, mx, mz = cx / cl, cz / cl, mx / ml, mz / ml
	local dot = cx * mx + cz * mz
	if dot < FOLLOW.MinDot then return end
	-- signed yaw (about +Y) from the camera heading to the walking heading
	local angle = math.atan2(cz * mx - cx * mz, dot)
	if math.abs(angle) < FOLLOW.DeadZone then return end
	local slow = setting("Shake", true) == false
	local rate, ease = slow and FOLLOW.SlowRate or FOLLOW.Rate, slow and FOLLOW.SlowEase or FOLLOW.Ease
	local a = math.clamp(angle * math.min(1, ease * dt), -rate * dt, rate * dt)
	local c, sn = math.cos(a), math.sin(a)
	local function yaw(v) return Vector3.new(v.X * c + v.Z * sn, v.Y, -v.X * sn + v.Z * c) end
	local pos = focus + yaw(cf.Position - focus)
	camera.CFrame = CFrame.lookAt(pos, pos + yaw(look))
end

-- a hand turn: mouse movement with the right button down, a finger drag on the camera side, the right stick
function FOLLOW.OnInputChanged(input, processed)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseMovement then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then FOLLOW.LastManual = os.clock() end
	elseif kind == Enum.UserInputType.Touch then
		if not processed and FOLLOW.Touches[input] then FOLLOW.LastManual = os.clock() end
	elseif input.KeyCode == Enum.KeyCode.Thumbstick2 and input.Position.Magnitude > 0.25 then
		FOLLOW.LastManual = os.clock()
	end
end

-- touches that start on the camera side (right of CameraSide) and not on a GUI can turn the camera
function FOLLOW.OnInputBegan(input, processed)
	if input.UserInputType ~= Enum.UserInputType.Touch or processed then return end
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize
	local width = size and size.X or 0
	if width > 0 and input.Position.X > width * FOLLOW.CameraSide then FOLLOW.Touches[input] = true end
end

function FOLLOW.OnInputEnded(input)
	FOLLOW.Touches[input] = nil
end

-- my own swing / skill (the server's Fx, manual and auto): hold the follow for AttackHold s
function FOLLOW.OnFx(kind, data)
	if (kind == "Swing" or kind == "Release" or kind == "Skill") and type(data) == "table"
		and data.UserId == LocalPlayer.UserId then
		FOLLOW.LastAttack = os.clock()
	end
end

local function disconnect(connections)
	for _, connection in connections do connection:Disconnect() end
	table.clear(connections)
end

local function updateSubject()
	queued = false
	local camera = workspace.CurrentCamera
	-- Scriptable cutscenes and other explicit camera modes retain their own subject.
	if not camera or camera.CameraType ~= Enum.CameraType.Custom then return end
	if not character or character ~= LocalPlayer.Character or not character:IsDescendantOf(workspace) then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and camera.CameraSubject ~= humanoid then
		camera.CameraSubject = humanoid
	end
end

local function queueUpdate()
	if queued then return end
	queued = true
	task.defer(updateSubject)
end

local function bindCharacter(nextCharacter)
	disconnect(characterConnections)
	character = nextCharacter
	if character then
		-- CharacterAdded may arrive before parenting or the Humanoid replicates.
		table.insert(characterConnections, character.AncestryChanged:Connect(queueUpdate))
		for _, signal in { character.ChildAdded, character.ChildRemoved } do
			table.insert(characterConnections, signal:Connect(function(child)
				if child:IsA("Humanoid") then queueUpdate() end
			end))
		end
	end
	queueUpdate()
end

local function bindCamera()
	disconnect(cameraConnections)
	local camera = workspace.CurrentCamera
	if camera then
		for _, property in { "CameraSubject", "CameraType" } do
			table.insert(cameraConnections, camera:GetPropertyChangedSignal(property):Connect(queueUpdate))
		end
	end
	queueUpdate()
end

function CameraFollow.Init(nextRegistry)
	registry = nextRegistry
end

function CameraFollow.Start()
	if started then return end
	started = true
	UserInputService.InputBegan:Connect(onPrimaryBegan)
	-- A23-65: the follow turn
	UserInputService.InputBegan:Connect(FOLLOW.OnInputBegan)
	UserInputService.InputChanged:Connect(FOLLOW.OnInputChanged)
	UserInputService.InputEnded:Connect(FOLLOW.OnInputEnded)
	RunService:BindToRenderStep("HHC_CameraFollow", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local ok, err = pcall(FOLLOW.Step, dt)
		if not ok then warn("[CameraFollow] follow: " .. tostring(err)) end
	end)
	task.spawn(function()
		local shared = ReplicatedStorage:WaitForChild("Shared", 30)
		local okNet, Net = pcall(function() return require(shared:WaitForChild("Net")) end)
		if okNet and type(Net) == "table" then
			pcall(function() Net.Get("Fx").OnClientEvent:Connect(FOLLOW.OnFx) end)
		end
	end)
	LocalPlayer.CharacterAdded:Connect(bindCharacter)
	LocalPlayer.CharacterRemoving:Connect(function(removing)
		if character == removing then bindCharacter(nil) end
	end)
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCharacter(LocalPlayer.Character)
	bindCamera()
end

CameraFollow.Follow = FOLLOW -- test aid (tools/test_camera_input.py follow group)

return CameraFollow
]]></ProtectedString>
					<string name="ScriptGuid">{06B72875-8105-413D-991C-3329EA58200A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CameraFollow</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">651f00f5fb550dbf0ad72e530002153b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC20139F5D21147BCB431B2F62EFB7B5C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- WorldMap.luau : full-screen world map (SPEC_ADDENDUM A12, owner G13).
-- Players never see the whole world from the ground; this panel is the only place it is shown. Everything is drawn
-- from Config (lands, sea + rivers, zones with name / level / danger colour, roads, bridges, mountain pass, faction
-- town icons, Crossroads landmarks, the sky crown) plus live markers: the local player's arrow (10x/s while open),
-- the golden goose while GameState says it is active, the active kaiju and, for Halo players only, grudge-sack
-- carriers (the same attributes EventHUD reads). Pan by drag, zoom with wheel / pinch / buttons (0.5x-3x), close with
-- X / the map key (Keybinds "Map", default M) / Escape / gamepad B. Presentation only: reads attributes, never sends
-- anything to the server.
--
-- Public API: WorldMap.Init(C), WorldMap.Start(), WorldMap.Open(), WorldMap.Close(), WorldMap.Toggle(), WorldMap.IsOpen()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local LocalPlayer = Players.LocalPlayer

local WorldMap = {}

local TAG = "WorldMap"
local C = nil -- client registry (set in Init)

----------------------------------------------------------------- tuning (logical px = reference 1280x720 at UIScale 1)
local UI_CFG = Config.UI or {}
local MIN_TEXT = UI_CFG.MinTextSize or 11 -- addendum M1
local TOP_PAD = UI_CFG.TopInsetPad or 8 -- addendum H4
local TOP_FALLBACK = UI_CFG.TopInsetFallback or 64

local Z_ROOT = 60 -- above Panels (50), below UIKit toasts (95) and UIKit.Confirm (100)
local TICK = 0.1 -- arrow / marker refresh while open (10x/s)
local ZOOM_MIN, ZOOM_MAX = 0.5, 3
local ZOOM_STEP = 1.2 -- per wheel notch / button press
local PAN_MARGIN = 80 -- real px of sea allowed past the map edge when zoomed in
local SIDE_PAD, BOTTOM_PAD = 12, 12
local WORLD_PAD = 12 -- studs of sea around the drawn world
local ROAD_HALF = 7 -- studs
local SHALLOW = 16 -- studs of lighter shallow water around each land
local PASS_CORRIDOR = 20 -- road corridor |z| < 20 through the mountain pass (A10)
local MAX_SACKS = 10
local ICON_PPS = 0.55 -- logical px per stud from which Crossroads landmark icons are shown
local LABEL_PPS = 1.1 -- ... and their labels
local HINT_MIN_WIDTH = 760 -- logical px; the hint line hides on narrow screens
local EXTREME_MIN_LEVEL = 25 -- PvP zones from this level use the "extreme" danger colour (same rule as MapBuilder)

local ACTION_TOGGLE = "WorldMapToggle"
local ACTION_CLOSE = "WorldMapClose"
local ACTION_WHEEL = "WorldMapWheel"
local ACTION_PRIORITY = Enum.ContextActionPriority.High.Value + 10

----------------------------------------------------------------- v3 world fallback (SPEC_ADDENDUM A10)
-- Used only while Config has not been patched to v3: Lands / Bridges individually when missing; when Config.Map.Lands
-- is missing the zone centers, Bounds and PassX also come from here so the drawing matches the v3 world in Studio.
local V3 = {
	Bounds = { MinX = -130, MaxX = 1320, MinZ = -520, MaxZ = 520 },
	PassX = 915,
	Lands = {
		{ Name = "LandCrossroads", MinX = -110, MaxX = 115, MinZ = -175, MaxZ = 175 },
		{ Name = "LandMeadow", MinX = 155, MaxX = 490, MinZ = -175, MaxZ = 175 },
		{ Name = "LandWild", MinX = 530, MaxX = 1300, MinZ = -175, MaxZ = 175 },
		{ Name = "IslandHalo", MinX = -110, MaxX = 110, MinZ = -500, MaxZ = -300 },
		{ Name = "IslandHorns", MinX = -110, MaxX = 110, MinZ = 300, MaxZ = 500 },
	},
	Bridges = {
		{ Name = "Meadow", From = Vector3.new(113, 0, 0), To = Vector3.new(157, 0, 0), Width = 18 },
		{ Name = "Goblin", From = Vector3.new(488, 0, 0), To = Vector3.new(532, 0, 0), Width = 18 },
		{ Name = "Halo", From = Vector3.new(0, 0, -173), To = Vector3.new(0, 0, -302), Width = 18 },
		{ Name = "Horns", From = Vector3.new(0, 0, 173), To = Vector3.new(0, 0, 302), Width = 18 },
	},
	ZoneCenters = {
		Crossroads = Vector3.new(0, 0, 0),
		HaloTown = Vector3.new(0, 0, -400),
		HornsTown = Vector3.new(0, 0, 400),
		SlimeMeadow = Vector3.new(330, 0, 0),
		GoblinWoods = Vector3.new(720, 0, 0),
		SkeletonRuins = Vector3.new(1120, 0, 0),
	},
}
-- Crossroads landmarks without a Config position (tools/preview_map.lua); the live workspace.Map wins when present
local MARKET_FALLBACK = Vector3.new(-30, 0, -36)
local GUILD_FALLBACK = Vector3.new(44, 0, 58)

