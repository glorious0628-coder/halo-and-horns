			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- MonsterService.luau : monster rigs (procedural or custom visual), spawn/respawn with zone density and spawn spread,
-- AI loop, monster HP, kill rewards (MonsterKilled) and personal (tutorial) monsters.
-- World is Terrain (A10/A11): spawn/wander points are raycast onto walkable ground; monsters stay inside their own zone
-- rect, never chase into water and are recovered home when knocked out / sunk (A10-V3-2); stuck detection (A11-R5).
-- A15 hit feel: attacks are telegraphed (WindupAt -> AttackSeq), damage bumps HurtSeq, player hits shove (Shove).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local MonsterService = {}

-- fired once PER CONTRIBUTOR: (player, info). info.WarPoints = personal war points, info.WarShare = this player's
-- part of the faction pool points (WarPoints / same-faction contributors, CR-M18)
MonsterService.MonsterKilled = Util.Signal.new()

------------------------------------------------------------------ constants
local TAG = "MonsterService"
local MC = Config.Monsters

-- A3-M2 / A5-C1 density (fallbacks keep the service working if a Config key is missing)
local DENSITY = Config.MonsterDensity or {}
local EXTRA_PER_PLAYER = DENSITY.ExtraPerPlayer or 2
local MAX_ZONE_MULT = DENSITY.MaxZoneMult or 2
local REEVAL_INTERVAL = DENSITY.ReevalInterval or 5
local MAX_SPAWNS_PER_KIND_PER_PASS = 8 -- smooths bursts when many players enter a zone at once

-- A7-1 spawn spread
local SPREAD = Config.SpawnSpread or {}
local SPREAD_ENABLED = SPREAD.Enabled ~= false
local SPREAD_THRESHOLD = SPREAD.StarvedThreshold or 2
local SPREAD_MIN = SPREAD.MinDist or 18
local SPREAD_MAX = SPREAD.MaxDist or 28
local SPREAD_TRIES = SPREAD.Tries or 6
local SPREAD_COUNT_RADIUS = 30

-- shared Config keys (G1) with fallbacks
local TUTORIAL = Config.Tutorial or {}
local CUSTOM = Config.CustomModels or {}
local CUSTOM_FOLDER = CUSTOM.FolderName or "CustomModels"
local GOLDEN_FILL_TRANSPARENCY = CUSTOM.GoldenFillTransparency or 0.5
local MIN_TEXT_SIZE = (Config.UI and Config.UI.MinTextSize) or 11
local NO_REAGGRO_SECONDS = MC.ReaggroDelay or 3 -- A3-M4
local PERSONAL_DISTANCE = TUTORIAL.SpawnDistance or 8 -- A4: ~8 studs in front of the player
local PERSONAL_LIFETIME = TUTORIAL.Lifetime or 120 -- A4: despawn after 120 s

-- AI tuning that is not in Config (private)
local RETURN_DONE_DIST = 6
local WANDER_RADIUS = 15
local WANDER_MIN, WANDER_MAX = 4, 8
local WANDER_TRIES = 4
local PERSONAL_FOLLOW_RADIUS = 80 -- A5-C3: a personal monster only tracks its owner when the owner is this close
local ZONE_MOVE_INSET = 6 -- A10-V3-2 (b): every MoveTo destination stays this far inside the monster's zone rect
local OUT_Y = -3 -- A10-V3-2 (c): root below this (water) -> walk home, no re-aggro
local DEEP_Y = -8 -- A10-V3-2 (c): root below this for more than DEEP_SECONDS -> PivotTo(Home)
local DEEP_SECONDS = 2
local MAX_SLOPE_ANGLE = 46 -- A11-R2: Terrain ridges (>= 50 deg) cannot be walked over
local STUCK_WINDOW = 1.5 -- A11-R5: moved < STUCK_MIN_MOVE in this many seconds while moving -> new destination
local STUCK_MIN_MOVE = 1
local ARRIVE_DIST = 3 -- "still trying to move" while the destination is farther than this
local DETOUR_MIN, DETOUR_MAX = 8, 14
local DETOUR_SECONDS = 2
local DETOUR_TRIES = 4
local CHASE_STUCK_GIVEUP = 2 -- stuck this many times on one target -> give up and go home

-- ground probing (A11-R1: Include only Terrain, Map.Ground and the Map.Decor "Bridge_*" models)
local GROUND_RAY_TOP = 150 -- above every ridge top
local GROUND_RAY_LENGTH = 320
local GROUND_MIN_Y, GROUND_MAX_Y = -2, 6 -- walkable valley floor (zone ground top is Y = 0); higher = ridge, lower = shore
local GROUND_PARAMS_REFRESH = 10
local SPAWN_TRIES = 8

-- visuals
local BAR_MAX_DISTANCE = 80
local DEATH_FADE = 0.3
local DEATH_DESTROY = 0.4
local DEATH_PARTICLES = 15
local BOB_PERIOD = 0.55
local BOB_FRACTION = 0.06 -- custom visual bob height as a fraction of the body height
-- every visible part is welded to VisualRoot, which hangs off the root by the Weld VisualJoint (C0 = C1 = identity).
-- Clients tween VisualJoint.C0 locally (Fx.luau attack lunge / hit recoil); the server never writes C0 after spawn.
local VISUAL_ROOT_NAME = "VisualRoot"
local VISUAL_JOINT_NAME = "VisualJoint"
local VISUAL_ROOT_SIZE = 0.2
local ATTACK_SEQ_ATTR = "AttackSeq" -- +1 when a monster attack lands on a player (clients play the attack lunge)
local FACE_TARGET_DOT = 0.85 -- attacking: turn to the target when it is more than ~30 deg off the look direction
-- A15 hit feel (server half): attack telegraph, pain reactions, swing shove. Tunables live in Config.HitReact (shared
-- with the client Fx); the fallbacks keep the service working without it. Model attribute contract for clients:
-- "WindupAt" changed -> wind-up pose (the hit follows REACT.WINDUP s later unless cancelled), "AttackSeq" +1 -> lunge
-- (the damage lands now), "HurtSeq" +1 -> pain reaction ("HurtBig" is written first: true = crit / big hit).
local HIT_REACT = Config.HitReact or {}
local REACT = {
	WINDUP = HIT_REACT.MonsterWindup or 0.28, -- s from "WindupAt" to the hit
	WINDUP_LEEWAY = HIT_REACT.WindupLeeway or 2, -- the hit still lands while the target is within AttackRange + this
	HURT_GAP = HIT_REACT.MonsterHurtGap or 0.15, -- at most one "HurtSeq" bump per monster per this many seconds
	BIG_FRACTION = HIT_REACT.BigHitFraction or 0.5, -- a hit of >= this fraction of MaxHP is "big"
	SHOVE_MAX = HIT_REACT.ShoveMax or 2, -- studs, upper bound of any shove (divided by the monster's body scale)
	SHOVE_TIME = HIT_REACT.ShoveTime or 0.12, -- s the shove slide takes
	SHOVE_GAP = HIT_REACT.ShoveGap or 0.5, -- min seconds between two shoves of one monster (no push-locking)
}
local WINDUP_AT_ATTR = "WindupAt" -- workspace:GetServerTimeNow() when the monster starts winding up an attack
local HURT_SEQ_ATTR = "HurtSeq" -- +1 when the monster takes damage and survives (throttled by REACT.HURT_GAP)
local HURT_BIG_ATTR = "HurtBig" -- written right before HurtSeq: true = crit or >= BIG_FRACTION of its MaxHP
local BAR_HIGH = Color3.fromRGB(80, 220, 120)
local BAR_LOW = Color3.fromRGB(255, 80, 80)
local EYE_COLOR = Color3.fromRGB(20, 20, 20)

local DISABLED_STATES = { -- A3-H2
	Enum.HumanoidStateType.Dead,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.Seated,
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Swimming,
	Enum.HumanoidStateType.PlatformStanding,
}

------------------------------------------------------------------ state
local S = nil
local records = {} -- [Id] = MonsterRecord (alive only)
local nextId = 0
local pending = {} -- [Kind] = respawns scheduled but not yet executed
local personal = {} -- [Player] = { [MonsterRecord] = true }
local monstersFolder = nil
local lastWarn = {} -- [key] = os.clock()
local groundParams, groundParamsAt = nil, -math.huge

local GLOBAL_CAP
do
	if type(DENSITY.GlobalCap) == "number" then
		GLOBAL_CAP = DENSITY.GlobalCap
	else
		local sum = 0
		for _, kind in Config.MonsterTypeOrder do
			local def = Config.MonsterTypes[kind]
			if def then sum += def.Count end
		end
		GLOBAL_CAP = math.floor(sum * 1.7 + 0.5)
	end
end

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarn[key]
	if last and now - last < 10 then return end
	lastWarn[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function getMonstersFolder()
	if monstersFolder and monstersFolder.Parent then return monstersFolder end
	monstersFolder = Util.GetFolder(workspace, "Monsters")
	return monstersFolder
end

local function readyPlayers()
	if not S or not S.PlayerService then return {} end
	local ok, list = pcall(S.PlayerService.GetReadyPlayers)
	if ok and type(list) == "table" then return list end
	return {}
end

local function isPlayerInTown(player, pos)
	if Config.ZoneAt(pos).Town == true then return true end
	if S and S.ZoneService then
		local ok, town = pcall(S.ZoneService.IsTown, player)
		if ok and town == true then return true end
	end
	return false
end

-- CR-M18: faction id the war pool uses (same lookup as WarService: FactionService first, then the attribute)
local function factionOf(player)
	if S and S.FactionService and S.FactionService.GetFaction then
		local ok, f = pcall(S.FactionService.GetFaction, player)
		if ok and type(f) == "string" then return f end
	end
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

-- CR-M5: zone id of the player's root (nil without a character); attackers must stand in the monster's zone
local function zoneIdOf(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then return nil end
	local r = Util.GetRoot(player)
	return r and Config.ZoneAt(r.Position).Id or nil
end

-- CR-M5: personal monsters only for their owner (any zone); zone monsters only for a player standing in their zone
-- (A10-V3-2a both ways: a monster that never chases out of its zone cannot be farmed from just outside it)
local function visibleTo(rec, forPlayer, forZone)
	if forPlayer == nil then return true end
	if rec.Owner ~= nil then return rec.Owner == forPlayer end
	return forZone ~= nil and rec.ZoneId == forZone
end

local function insideZone(zone, p, inset)
	return math.abs(p.X - zone.Center.X) <= zone.Size.X / 2 - inset
		and math.abs(p.Z - zone.Center.Z) <= zone.Size.Z / 2 - inset
end

-- A10-V3-2 (b): clamp a destination into the zone rect inset by ZONE_MOVE_INSET (keeps Y)
local function clampToZone(zone, p)
	if not zone then return p end
	local hx = math.max(0, zone.Size.X / 2 - ZONE_MOVE_INSET)
	local hz = math.max(0, zone.Size.Z / 2 - ZONE_MOVE_INSET)
	return Vector3.new(
		math.clamp(p.X, zone.Center.X - hx, zone.Center.X + hx),
		p.Y,
		math.clamp(p.Z, zone.Center.Z - hz, zone.Center.Z + hz)
	)
end

-- A11-R1: ground raycasts only see Terrain, workspace.Map.Ground and the bridge models (rebuilt every few seconds
-- so a late MapBuilder pass is picked up). Water is NOT ignored, so a hit on the sea/river reports Material Water.
local function getGroundParams()
	local now = os.clock()
	if groundParams and now - groundParamsAt < GROUND_PARAMS_REFRESH then return groundParams end
	local list = { workspace.Terrain }
	local map = workspace:FindFirstChild("Map")
	if map then
		local ground = map:FindFirstChild("Ground")
		if ground then table.insert(list, ground) end
		local decor = map:FindFirstChild("Decor")
		if decor then
			for _, c in decor:GetChildren() do
				if string.sub(c.Name, 1, 7) == "Bridge_" then table.insert(list, c) end
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = list
	params.IgnoreWater = false
	groundParams, groundParamsAt = params, now
	return params
end

-- ground under (x, z): returns (groundY, isWater), or nil when nothing was hit
local function probeGround(x, z)
	local hit = workspace:Raycast(Vector3.new(x, GROUND_RAY_TOP, z), Vector3.new(0, -GROUND_RAY_LENGTH, 0), getGroundParams())
	if not hit then return nil, false end
	return hit.Position.Y, hit.Material == Enum.Material.Water
end

-- CR-L14: solid decoration a monster must not stand in (King Slime hill, goblin tents, broken pillars / arches):
-- Map.Decor children except the "Bridge_*" decks, plus Map.Landmarks. Non-collidable props (canopies, flowers, glows)
-- never count. Rebuilt every GROUND_PARAMS_REFRESH s like the ground params.
local blockCast = { Params = nil, At = -math.huge, Any = false }
local function getBlockParams()
	local now = os.clock()
	if blockCast.Params and now - blockCast.At < GROUND_PARAMS_REFRESH then return blockCast.Params end
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		local decor = map:FindFirstChild("Decor")
		if decor then
			for _, c in decor:GetChildren() do
				if string.sub(c.Name, 1, 7) ~= "Bridge_" then table.insert(list, c) end
			end
		end
		local landmarks = map:FindFirstChild("Landmarks")
		if landmarks then table.insert(list, landmarks) end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)
	blockCast.Params, blockCast.At, blockCast.Any = params, now, #list > 0
	return params
end

-- CR-L14: true when a solid decor / landmark part stands on the ground point (ray from y + 40 down to y + 0.5)
local function occupied(x, y, z)
	local params = getBlockParams()
	if not blockCast.Any then return false end
	local ok, hit = pcall(function()
		return workspace:Raycast(Vector3.new(x, y + 40, z), Vector3.new(0, -39.5, 0), params)
	end)
	return ok and hit ~= nil
end

-- walkable ground point at (x, z) or nil (water, ridge, shore, inside solid decor). Second result: true when the ray
-- hit nothing at all (bare test place without Terrain / Map.Ground), so callers can fall back to the legacy flat Y = 0
-- behaviour.
local function groundPoint(x, z)
	local y, water = probeGround(x, z)
	if y == nil then return nil, true end
	if water or y < GROUND_MIN_Y or y > GROUND_MAX_Y then return nil, false end
	if occupied(x, y, z) then return nil, false end -- CR-L14
	return Vector3.new(x, y, z), false
end

-- unanchored monster part
local function newPart(props)
	local p = Instance.new(props.ClassName or "Part")
	if props.Shape then p.Shape = props.Shape end
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "ClassName" and k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	return p
end

local function getCustomTemplate(id)
	local folder = ServerStorage:FindFirstChild(CUSTOM_FOLDER)
	if not folder then return nil end
	local t = folder:FindFirstChild(id)
	if t and (t:IsA("Model") or t:IsA("BasePart")) then return t end
	return nil
end

------------------------------------------------------------------ counting (non-personal)
local function aliveCountOf(kind)
	local n = 0
	for _, rec in records do
		if rec.Alive and rec.Owner == nil and rec.Kind == kind then n += 1 end
	end
	return n
end

local function totalNonPersonal()
	local n = 0
	for _, rec in records do
		if rec.Alive and rec.Owner == nil then n += 1 end
	end
	for _, c in pending do n += c end
	return n
end

local function playersPerZone()
	local counts = {}
	for _, p in readyPlayers() do
		local root = Util.GetRoot(p)
		if root then
			local id = Config.ZoneAt(root.Position).Id
			counts[id] = (counts[id] or 0) + 1
		end
	end
	return counts
end

local function targetCount(kind, zoneCounts)
	local def = Config.MonsterTypes[kind]
	if not def then return 0 end
	local n = (zoneCounts or playersPerZone())[def.Zone] or 0
	return math.min(def.Count + EXTRA_PER_PLAYER * math.max(0, n - 1), def.Count * MAX_ZONE_MULT)
end

-- CR-L13: { [kind] = target } where the extras above each base Count share the GLOBAL_CAP room (GLOBAL_CAP - base
-- sum) in proportion to what each kind asks for (largest remainder), instead of MonsterTypeOrder filling the cap
-- first (busy meadow -> the ruins stayed at their base density).
local function cappedTargets(zoneCounts)
	zoneCounts = zoneCounts or playersPerZone()
	local targets, extras = {}, {}
	local baseSum, extraSum = 0, 0
	for _, kind in Config.MonsterTypeOrder do
		local def = Config.MonsterTypes[kind]
		if def and targets[kind] == nil then
			local t = targetCount(kind, zoneCounts)
			local base = math.min(def.Count, t)
			targets[kind] = base
			extras[kind] = math.max(0, t - base)
			baseSum += base
			extraSum += extras[kind]
		end
	end
	if extraSum <= 0 then return targets end
	local room = math.max(0, GLOBAL_CAP - baseSum)
	if room >= extraSum then
		for kind, e in extras do
			targets[kind] += e
		end
		return targets
	end
	local used, fracs = 0, {}
	for _, kind in Config.MonsterTypeOrder do
		local e = extras[kind]
		if e and e > 0 then
			extras[kind] = 0 -- a kind listed twice is shared out once
			local share = e * room / extraSum
			local whole = math.floor(share)
			targets[kind] += whole
			used += whole
			table.insert(fracs, { Kind = kind, F = share - whole, I = #fracs + 1 })
		end
	end
	table.sort(fracs, function(a, b)
		if a.F ~= b.F then return a.F > b.F end
		return a.I < b.I
	end)
	for _, fr in fracs do
		if used >= room then break end
		targets[fr.Kind] += 1
		used += 1
	end
	return targets
end

------------------------------------------------------------------ public queries
-- forPlayer (optional): only the monsters that player may hit (own personal ones + zone monsters of the zone the
-- player stands in, CR-M5). nil = every alive monster.
function MonsterService.GetMonstersInRadius(position, radius, forPlayer)
	local out = {}
	if typeof(position) ~= "Vector3" or type(radius) ~= "number" then return out end
	local fz = zoneIdOf(forPlayer) -- CR-M5
	for _, rec in records do
		if rec.Alive and visibleTo(rec, forPlayer, fz) then
			local root = rec.Root
			if root and root.Parent and Util.FlatDistance(root.Position, position) <= radius then
				table.insert(out, rec)
			end
		end
	end
	return out
end

function MonsterService.GetNearest(position, radius, maxCount, forPlayer)
	local out = {}
	if typeof(position) ~= "Vector3" or type(radius) ~= "number" then return out end
	local found = {}
	local fz = zoneIdOf(forPlayer) -- CR-M5
	for _, rec in records do
		if rec.Alive and visibleTo(rec, forPlayer, fz) then
			local root = rec.Root
			if root and root.Parent then
				local d = Util.FlatDistance(root.Position, position)
				if d <= radius then
					table.insert(found, { Rec = rec, D = d })
				end
			end
		end
	end
	table.sort(found, function(a, b) return a.D < b.D end)
	local limit = (type(maxCount) == "number" and maxCount >= 0) and math.floor(maxCount) or #found
	for i = 1, math.min(limit, #found) do
		out[i] = found[i].Rec
	end
	return out
end

function MonsterService.CountInRadius(position, radius, forPlayer)
	if typeof(position) ~= "Vector3" or type(radius) ~= "number" then return 0 end
	local n = 0
	local fz = zoneIdOf(forPlayer) -- CR-M5
	for _, rec in records do
		if rec.Alive and visibleTo(rec, forPlayer, fz) then
			local root = rec.Root
			if root and root.Parent and Util.FlatDistance(root.Position, position) <= radius then
				n += 1
			end
		end
	end
	return n
end

------------------------------------------------------------------ spawn point (A7-1, grounded on Terrain per A10/A11)
-- Returns a point ON the ground (Y = ground height) inside def.Zone, or nil when every try landed on water / a ridge
-- (the density pass retries a few seconds later).
local function pickSpawnPoint(def)
	local zone = Config.Zones[def.Zone]
	if not zone then return nil end
	local inset = MC.SpawnInset
	local anyHit = false
	local function try(pt)
		local g, noHit = groundPoint(pt.X, pt.Z)
		if not noHit then anyHit = true end
		if g and Config.ZoneAt(g).Id == def.Zone then return g end
		return nil
	end
	if SPREAD_ENABLED then
		local bestPos, bestCount = nil, nil
		for _, p in readyPlayers() do
			if Util.IsAlive(p) then
				local root = Util.GetRoot(p)
				if root then
					local pos = root.Position
					local z = Config.ZoneAt(pos)
					if z.Id == def.Zone and not z.Town then
						local c = MonsterService.CountInRadius(pos, SPREAD_COUNT_RADIUS, p)
						if bestCount == nil or c < bestCount then
							bestPos, bestCount = pos, c
						end
					end
				end
			end
		end
		if bestPos and bestCount < SPREAD_THRESHOLD then
			for _ = 1, SPREAD_TRIES do
				local a = Util.Random:NextNumber(0, math.pi * 2)
				local d = Util.Random:NextNumber(SPREAD_MIN, SPREAD_MAX)
				local pt = Vector3.new(bestPos.X + math.cos(a) * d, 0, bestPos.Z + math.sin(a) * d)
				if insideZone(zone, pt, inset) then
					local g = try(pt)
					if g then return g end
				end
			end
		end
	end
	for _ = 1, SPAWN_TRIES do
		local g = try(Util.RandomPointInZone(zone, inset))
		if g then return g end
	end
	if not anyHit then
		-- no Terrain / Map.Ground under the zone at all (bare test place): legacy flat ground at Y = 0
		return Util.RandomPointInZone(zone, inset)
	end
	warnThrottled("spawnpoint_" .. def.Zone, "no walkable ground found in " .. def.Zone .. " this pass (water/ridge); retrying later")
	return nil
end

------------------------------------------------------------------ rig construction
local function makeBar(root, text, golden, offsetY)
	local bb = Instance.new("BillboardGui")
	bb.Name = "MonsterBar"
	bb.Size = UDim2.fromOffset(150, 34)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = BAR_MAX_DISTANCE
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false

	local name = Instance.new("TextLabel")
	name.Name = "NameLabel"
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 20)
	name.Font = Enum.Font.GothamBold
	name.Text = text
	name.TextColor3 = golden and MC.GoldenColor or Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.TextScaled = true
	local tsc = Instance.new("UITextSizeConstraint")
	tsc.MaxTextSize = 16
	tsc.MinTextSize = MIN_TEXT_SIZE
	tsc.Parent = name
	name.Parent = bb

	local back = Instance.new("Frame")
	back.Name = "Bar"
	back.Position = UDim2.new(0.1, 0, 0, 23)
	back.Size = UDim2.new(0.8, 0, 0, 8)
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	back.BackgroundTransparency = 0.2
	back.BorderSizePixel = 0
	local c1 = Instance.new("UICorner")
	c1.CornerRadius = UDim.new(0, 4)
	c1.Parent = back
	back.Parent = bb

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = BAR_HIGH
	fill.BorderSizePixel = 0
	local c2 = Instance.new("UICorner")
	c2.CornerRadius = UDim.new(0, 4)
	c2.Parent = fill
	fill.Parent = back

	bb.Parent = root
	return fill
end

local function updateBar(rec)
	local fill = rec._fill
	if not fill or not fill.Parent then return end
	local r = (rec.MaxHP > 0) and math.clamp(rec.HP / rec.MaxHP, 0, 1) or 0
	fill.Size = UDim2.fromScale(r, 1)
	fill.BackgroundColor3 = BAR_LOW:Lerp(BAR_HIGH, r)
end

-- A1: clone a custom visual, scale it to the procedural body height, sit it on the floor facing the root.
-- Returns (visualModel, parts) or nil when the template is unusable.
local function buildCustomVisual(template, rootCF, bodyHeight, floorY)
	local clone = template:Clone()
	local visual
	if clone:IsA("BasePart") then
		visual = Instance.new("Model")
		clone.Parent = visual
		visual.PrimaryPart = clone
	else
		visual = clone
	end
	visual.Name = "CustomVisual"

	for _, d in visual:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") or d:IsA("Humanoid") then
			d:Destroy()
		end
	end

	local parts = {}
	for _, d in visual:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			table.insert(parts, d)
		end
	end
	if #parts == 0 then
		visual:Destroy()
		return nil
	end

	-- face the root's look direction (the template's pivot orientation is treated as its "front")
	visual:PivotTo(CFrame.new(visual:GetPivot().Position) * rootCF.Rotation)

	-- scale so the bounding-box height matches the procedural body height
	local _, size = visual:GetBoundingBox()
	if size.Y > 0.01 then
		local factor = bodyHeight / size.Y
		local okScale, cur = pcall(visual.GetScale, visual)
		if not okScale or type(cur) ~= "number" or cur <= 0 then cur = 1 end
		pcall(visual.ScaleTo, visual, cur * factor)
	end

	-- bottom on the floor, centered under the root
	local bbCF, bbSize = visual:GetBoundingBox()
	local rootPos = rootCF.Position
	local delta = Vector3.new(
		rootPos.X - bbCF.Position.X,
		(floorY + bbSize.Y / 2) - bbCF.Position.Y,
		rootPos.Z - bbCF.Position.Z
	)
	visual:PivotTo(visual:GetPivot() + delta)
	return visual, parts
end

-- builds the model (not parented yet). Returns a table with Model, Root, VisualRoot, Humanoid, Fill, Parts, VisualParts,
-- BodyHeight, Hip.
local function buildRig(kind, def, golden, groundPos, faceTo)
	local s = def.Scale or 1
	local isSlime = def.Shape == "Slime"
	local rootSize, hip, bodyHeight, topAboveRoot
	if isSlime then
		rootSize = Vector3.new(2 * s, 2 * s, 2 * s)
		hip = 0.5 * s
		bodyHeight = 3 * s -- ball diameter; root center sits 1.5s above the floor
		topAboveRoot = 1.5 * s -- ball top
	else
		rootSize = Vector3.new(2 * s, 2 * s, 1 * s)
		hip = 2 * s
		bodyHeight = 5 * s -- legs bottom at the floor, head top 5s above it
		topAboveRoot = 2 * s -- head top
	end

	local floorY = groundPos.Y
	local rootY = floorY + hip + rootSize.Y / 2
	local rootPos = Vector3.new(groundPos.X, rootY, groundPos.Z)
	local rootCF
	if typeof(faceTo) == "Vector3" and Util.FlatDistance(faceTo, rootPos) > 0.1 then
		rootCF = CFrame.lookAt(rootPos, Vector3.new(faceTo.X, rootY, faceTo.Z))
	else
		rootCF = CFrame.new(rootPos) * CFrame.Angles(0, Util.Random:NextNumber(0, math.pi * 2), 0)
	end

	local model = Instance.new("Model")
	model.Name = kind

	local root = newPart({
		Name = "HumanoidRootPart",
		Size = rootSize,
		CFrame = rootCF,
		Transparency = 1,
		Massless = false,
	})
	root.Parent = model
	model.PrimaryPart = root

	-- invisible anchor for every visible part (see VISUAL_ROOT_NAME); starts exactly on the root
	local visualRoot = newPart({
		Name = VISUAL_ROOT_NAME,
		Size = Vector3.new(VISUAL_ROOT_SIZE, VISUAL_ROOT_SIZE, VISUAL_ROOT_SIZE),
		CFrame = rootCF,
		Transparency = 1,
		CanQuery = false,
		CastShadow = false,
	})
	visualRoot.Parent = model
	local joint = Instance.new("Weld")
	joint.Name = VISUAL_JOINT_NAME
	joint.Part0 = root
	joint.Part1 = visualRoot
	joint.C0 = CFrame.identity
	joint.C1 = CFrame.identity
	joint.Parent = visualRoot

	local bodyColor = golden and MC.GoldenColor or def.Color
	local darkColor = golden and MC.GoldenColor or def.Color:Lerp(Color3.new(0, 0, 0), 0.25)
	local parts = {}
	local function add(props, offset)
		props.CFrame = rootCF * offset
		local p = newPart(props)
		p.Parent = model
		table.insert(parts, p)
		return p
	end

	if isSlime then
		add({ Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.new(3 * s, 3 * s, 3 * s), Color = bodyColor, Transparency = 0 },
			CFrame.new())
		for side = -1, 1, 2 do
			add({ Name = side < 0 and "EyeL" or "EyeR", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45 * s, 0.45 * s, 0.45 * s), Color = EYE_COLOR },
				CFrame.new(side * 0.5 * s, 0.35 * s, -1.33 * s))
		end
	else
		add({ Name = "Torso", Size = Vector3.new(2 * s, 2 * s, 1 * s), Color = darkColor }, CFrame.new())
		add({ Name = "Head", Size = Vector3.new(2 * s, 1 * s, 1 * s), Color = bodyColor }, CFrame.new(0, 1.5 * s, 0))
		add({ Name = "Left Arm", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = bodyColor }, CFrame.new(-1.5 * s, 0, 0))
		add({ Name = "Right Arm", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = bodyColor }, CFrame.new(1.5 * s, 0, 0))
		add({ Name = "Left Leg", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = darkColor }, CFrame.new(-0.5 * s, -2 * s, 0))
		add({ Name = "Right Leg", Size = Vector3.new(1 * s, 2 * s, 1 * s), Color = darkColor }, CFrame.new(0.5 * s, -2 * s, 0))
		for side = -1, 1, 2 do
			add({ Name = side < 0 and "EyeL" or "EyeR", Size = Vector3.new(0.3 * s, 0.3 * s, 0.05 * s), Color = EYE_COLOR },
				CFrame.new(side * 0.45 * s, 1.6 * s, -0.52 * s))
		end
	end

	-- A1 custom visual (procedural parts stay as an invisible hitbox)
	local visualParts = nil
	local template = getCustomTemplate(kind)
	if template then
		local ok, visual, vparts = pcall(buildCustomVisual, template, rootCF, bodyHeight, floorY)
		if ok and visual then
			for _, p in parts do p.Transparency = 1 end
			visual.Parent = model
			visualParts = vparts
			if golden then
				local h = Instance.new("Highlight")
				h.Name = "GoldenTint"
				h.FillColor = MC.GoldenColor
				h.FillTransparency = GOLDEN_FILL_TRANSPARENCY
				h.OutlineColor = MC.GoldenColor
				h.OutlineTransparency = 0.3
				h.DepthMode = Enum.HighlightDepthMode.Occluded
				h.Parent = visual
			end
		elseif not ok then
			warnThrottled("custom_" .. kind, "custom model for " .. kind .. " failed: " .. tostring(visual))
		end
	end

	if golden then
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "GoldenSparkle"
		pe.Color = ColorSequence.new(MC.GoldenColor)
		pe.Rate = 8
		pe.Lifetime = NumberRange.new(0.6, 1.1)
		pe.Speed = NumberRange.new(1, 3)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LightEmission = 0.8
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Parent = root
		local light = Instance.new("PointLight")
		light.Name = "GoldenLight"
		light.Color = MC.GoldenColor
		light.Range = 10 * s
		light.Brightness = 1.5
		light.Parent = root
	end

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = hip
	hum.WalkSpeed = def.Speed
	hum.AutoJumpEnabled = false
	hum.MaxSlopeAngle = MAX_SLOPE_ANGLE -- A11-R2
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.MaxHealth = 100
	hum.Health = 100
	hum.Parent = model

	local label = golden and ("황금 " .. def.Name) or def.Name
	local fill = makeBar(root, label, golden, topAboveRoot + 1.6)

	model:SetAttribute("MonsterKind", kind)
	model:SetAttribute("Golden", golden)
	-- body size for the client attack motion (lunge distance, lean pivot at the floor)
	model:SetAttribute("BodyHeight", bodyHeight)
	model:SetAttribute("RootHeight", rootY - floorY)

	return {
		Model = model,
		Root = root,
		VisualRoot = visualRoot,
		Humanoid = hum,
		Fill = fill,
		Parts = parts,
		VisualParts = visualParts,
		BodyHeight = bodyHeight,
		Hip = hip,
		Scale = s,
		RootOffset = rootY - floorY, -- root center height above the floor (used by PivotTo(Home))
	}
end

------------------------------------------------------------------ spawn / despawn
local function spawnMonster(kind, opts)
	local def = Config.MonsterTypes[kind]
	if not def then return nil end
	opts = opts or {}
	local owner = opts.Owner

	local golden
	if owner ~= nil or opts.Golden ~= nil then
		golden = opts.Golden == true
	else
		golden = Util.Random:NextNumber() < MC.GoldenChance
	end

	-- point is ON the ground (its Y = ground height); never assume a flat Part floor (A10/A11 Terrain world)
	local point = opts.Position
	if typeof(point) ~= "Vector3" then
		point = pickSpawnPoint(def)
		if not point then return nil end
	end
	local rig = buildRig(kind, def, golden, point, opts.FaceTo)

	local maxHP
	if type(opts.HP) == "number" and opts.HP > 0 and opts.HP == opts.HP then
		maxHP = opts.HP
	else
		maxHP = def.HP * (golden and MC.GoldenHPMult or 1)
	end

	if owner then
		rig.Model:SetAttribute("OwnerUserId", owner.UserId)
	end

	-- parent, weld (visible parts to VisualRoot, which is jointed to the root), network owner, humanoid states.
	-- Gameplay (hits, AI, knockback) only uses the root; parts follow it through the joints.
	rig.Model.Parent = getMonstersFolder()
	local anchor = rig.VisualRoot or rig.Root
	for _, p in rig.Parts do
		Util.Weld(anchor, p)
	end
	if rig.VisualParts then
		for _, p in rig.VisualParts do
			Util.Weld(anchor, p)
		end
	end
	pcall(rig.Root.SetNetworkOwner, rig.Root, nil)
	for _, st in DISABLED_STATES do
		pcall(rig.Humanoid.SetStateEnabled, rig.Humanoid, st, false)
	end

	-- A1: simple "alive" bob for custom visuals (moves the whole rig a little via HipHeight)
	local bob = nil
	if rig.VisualParts then
		local ok, tw = pcall(function()
			return TweenService:Create(
				rig.Humanoid,
				TweenInfo.new(BOB_PERIOD, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ HipHeight = rig.Hip + rig.BodyHeight * BOB_FRACTION }
			)
		end)
		if ok and tw then
			bob = tw
			tw:Play()
		end
	end

	nextId += 1
	local rec = {
		Id = nextId,
		Kind = kind,
		Def = def,
		ZoneId = def.Zone,
		Model = rig.Model,
		Root = rig.Root,
		Humanoid = rig.Humanoid,
		HP = maxHP,
		MaxHP = maxHP,
		Golden = golden,
		Home = point,
		Alive = true,
		Owner = owner,
		-- private
		_fill = rig.Fill,
		_bob = bob,
		_scale = rig.Scale,
		_rootOffset = rig.RootOffset,
		_contributors = {},
		_nextAttackAt = 0,
		_nextWanderAt = os.clock() + Util.Random:NextNumber(1, WANDER_MAX),
		_noAggroUntil = 0,
		_returning = false,
		_target = nil,
		_goal = nil, -- last MoveTo destination (stuck detection, A11-R5)
		_stuckAt = nil,
		_stuckPos = nil,
		_chaseStuck = 0,
		_detour = nil,
		_detourUntil = 0,
		_deepSince = nil, -- A10-V3-2 (c): when the root first went below DEEP_Y
		_windup = nil, -- A15: token of the attack being wound up (the hit lands REACT.WINDUP s after it started)
		_hurtAt = -math.huge, -- A15: os.clock() of the last HurtSeq bump
		_shoveReadyAt = 0, -- A15: os.clock() when the next shove is allowed
	}
	records[rec.Id] = rec
	return rec
end

local function emitDeathParticles(pos, color, scale)
	local fx = Instance.new("Part")
	fx.Name = "MonsterPop"
	fx.Anchored = true
	fx.CanCollide = false
	fx.CanQuery = false
	fx.CanTouch = false
	fx.Transparency = 1
	fx.Size = Vector3.new(1, 1, 1)
	fx.CFrame = CFrame.new(pos)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.4, 0.8)
	pe.Speed = NumberRange.new(8, 16)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -25, 0)
	pe.LightEmission = 0.4
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7 * scale), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = fx
	fx.Parent = Util.GetFolder(workspace, "Effects")
	pe:Emit(DEATH_PARTICLES)
	Debris:AddItem(fx, 1.5)
end

-- shrink/fade 0.3 s, particle burst, destroy after 0.4 s
local function deathPop(rec, withParticles)
	local model, root, hum = rec.Model, rec.Root, rec.Humanoid
	if rec._bob then
		pcall(function() rec._bob:Cancel() end)
		rec._bob = nil
	end
	if not model then return end
	if hum and hum.Parent then
		hum.WalkSpeed = 0
	end
	if root and root.Parent then
		root.Anchored = true
		local bar = root:FindFirstChild("MonsterBar")
		if bar then bar.Enabled = false end
		if withParticles then
			emitDeathParticles(root.Position, rec.Golden and MC.GoldenColor or rec.Def.Color, rec._scale or 1)
		end
	end
	local info = TweenInfo.new(DEATH_FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d ~= root and d.Name ~= VISUAL_ROOT_NAME then -- the invisible joint anchor keeps its size
				TweenService:Create(d, info, { Size = d.Size * 0.2, Transparency = 1 }):Play()
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Highlight") then
			d.Enabled = false
		end
	end
	task.delay(DEATH_DESTROY, function()
		if model then model:Destroy() end
	end)
end

local function removePersonalRef(rec)
	local owner = rec.Owner
	if not owner then return end
	local set = personal[owner]
	if set then
		set[rec] = nil
		if next(set) == nil then personal[owner] = nil end
	end
end

local scheduleRespawn -- forward

-- removes a record without rewards (timeout, owner left, model lost)
local function despawn(rec, fade)
	if not rec.Alive then return end
	rec.Alive = false
	records[rec.Id] = nil
	removePersonalRef(rec)
	if fade then
		deathPop(rec, false)
	elseif rec.Model then
		rec.Model:Destroy()
	end
end

scheduleRespawn = function(kind)
	pending[kind] = (pending[kind] or 0) + 1
	task.delay(MC.RespawnDelay, function()
		pending[kind] = math.max(0, (pending[kind] or 0) - 1)
		local ok, err = pcall(function()
			local target = cappedTargets()[kind] or targetCount(kind) -- CR-L13
			if aliveCountOf(kind) < target and totalNonPersonal() < GLOBAL_CAP then
				spawnMonster(kind)
			end
		end)
		if not ok then warnThrottled("respawn", err) end
	end)
end

------------------------------------------------------------------ damage / death
local function killRecord(rec)
	rec.Alive = false
	rec.HP = 0
	records[rec.Id] = nil
	updateBar(rec)

	local def = rec.Def
	local pos = (rec.Root and rec.Root.Parent) and rec.Root.Position or rec.Home
	local isPersonal = rec.Owner ~= nil
	local warPoints = 0
	if not isPersonal then
		warPoints = rec.Golden and Config.War.GoldenPoints or Config.War.MonsterPoints
	end
	local info = {
		Kind = rec.Kind,
		ZoneId = rec.ZoneId,
		Golden = rec.Golden,
		Position = pos,
		XP = def.XP * (rec.Golden and MC.GoldenXPMult or 1),
		Gold = def.Gold * (rec.Golden and MC.GoldenGoldMult or 1),
		WarPoints = warPoints,
		Personal = isPersonal,
	}

	-- CR-M18: every contributor keeps the full personal WarPoints, but one kill adds WarPoints to a faction pool only
	-- once: WarShare = WarPoints / (contributors of that faction) (WarService.AddPoints(player, n, poolN))
	local now = os.clock()
	local eligible, perFaction = {}, {}
	for p, t in rec._contributors do
		if p.Parent and now - t <= MC.ContributorWindow then
			local okF, f = pcall(factionOf, p)
			if not okF or type(f) ~= "string" then f = "None" end
			table.insert(eligible, { Player = p, Faction = f })
			perFaction[f] = (perFaction[f] or 0) + 1
		end
	end
	rec._contributors = {}
	for _, e in eligible do
		local i = table.clone(info)
		i.WarShare = info.WarPoints / math.max(1, perFaction[e.Faction] or 1)
		i.SkillHit = type(rec._skillBy) == "table" and rec._skillBy[e.Player] == true -- story S0: "basic attacks only"
		MonsterService.MonsterKilled:Fire(e.Player, i)
	end

	deathPop(rec, true)
	if isPersonal then
		removePersonalRef(rec)
	else
		scheduleRespawn(rec.Kind)
	end
end

-- A15: pain reaction for clients ("HurtBig" first, then "HurtSeq" +1), at most once per REACT.HURT_GAP s per monster
local function markHurt(rec, amount, crit)
	local now = os.clock()
	if now - rec._hurtAt < REACT.HURT_GAP then return end
	local model = rec.Model
	if not model or not model.Parent then return end
	rec._hurtAt = now
	local big = crit == true or (rec.MaxHP > 0 and amount >= rec.MaxHP * REACT.BIG_FRACTION)
	model:SetAttribute(HURT_BIG_ATTR, big)
	local seq = model:GetAttribute(HURT_SEQ_ATTR)
	model:SetAttribute(HURT_SEQ_ATTR, (type(seq) == "number" and seq or 0) + 1)
end

-- crit (optional): the hit was a critical hit (only used for the "HurtBig" pain reaction)
function MonsterService.DamageMonster(record, amount, player, crit)
	if type(record) ~= "table" or not record.Alive then return false end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then return false end
	if record.Owner and record.Owner ~= player then return false end -- A5-C2
	-- CR-M5: a zone monster takes no damage from a player standing outside its zone (no HP change, no contribution)
	if record.Owner == nil and player and zoneIdOf(player) ~= record.ZoneId then return false end
	if player then
		record._contributors[player] = os.clock()
	end
	record.HP -= amount
	if record.HP > 0 then
		updateBar(record)
		local okHurt, errHurt = pcall(markHurt, record, amount, crit)
		if not okHurt then warnThrottled("hurt", errHurt) end
		return false
	end
	killRecord(record) -- the killing hit plays the death pop instead of a pain reaction
	return true
end

function MonsterService.ApplyKnockback(record, fromPosition, power)
	if type(record) ~= "table" or not record.Alive then return end
	if typeof(fromPosition) ~= "Vector3" or type(power) ~= "number" then return end
	local root = record.Root
	if not root or not root.Parent or root.Anchored then return end
	local d = root.Position - fromPosition
	local flat = Vector3.new(d.X, 0, d.Z)
	local dir = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
	root.AssemblyLinearVelocity = dir * power + Vector3.new(0, 25, 0)
end

-- A15: shove sweep params (Terrain + every collidable part under workspace.Map; water ignored), rebuilt like the
-- ground params so a late MapBuilder pass is picked up
local shoveSweep = { Params = nil, At = -math.huge }
local function getShoveParams()
	local now = os.clock()
	if shoveSweep.Params and now - shoveSweep.At < GROUND_PARAMS_REFRESH then return shoveSweep.Params end
	local list = { workspace.Terrain }
	local map = workspace:FindFirstChild("Map")
	if map then table.insert(list, map) end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true -- invisible zone / pad volumes never block a shove
	end)
	shoveSweep.Params, shoveSweep.At = params, now
	return params
end

-- A15: subtle shove of a monster a player's hit landed on: the root slides `studs` (capped by REACT.SHOVE_MAX, divided
-- by the body scale so big monsters barely move) away from `fromPosition` over REACT.SHOVE_TIME. Skipped for anchored
-- (dying) roots, other players' personal monsters, a monster shoved less than REACT.SHOVE_GAP s ago, and whenever the
-- end point is not walkable ground (water / ridge / shore) in the zone the monster stands in (zone monsters: inside
-- their own zone rect inset by ZONE_MOVE_INSET, like every MoveTo). Returns true when a shove started.
function MonsterService.Shove(record, fromPosition, studs, player)
	if type(record) ~= "table" or not record.Alive then return false end
	if typeof(fromPosition) ~= "Vector3" then return false end
	if type(studs) ~= "number" or studs ~= studs or studs <= 0 then return false end
	if record.Owner and record.Owner ~= player then return false end -- A5-C2
	local now = os.clock()
	if now < record._shoveReadyAt then return false end
	local root = record.Root
	if not root or not root.Parent or root.Anchored then return false end

	local pos = root.Position
	local flat = Vector3.new(pos.X - fromPosition.X, 0, pos.Z - fromPosition.Z)
	if flat.Magnitude < 0.05 then
		local lv = root.CFrame.LookVector
		flat = Vector3.new(-lv.X, 0, -lv.Z) -- hit from right on top of it: push it backwards
		if flat.Magnitude < 0.05 then return false end
	end
	local dist = math.min(studs, REACT.SHOVE_MAX) / math.max(1, record._scale or 1)
	local delta = flat.Unit * dist
	local dest = pos + delta

	local here = Config.ZoneAt(pos).Id
	if Config.ZoneAt(dest).Id ~= here then return false end
	if record.Owner == nil then
		local zone = Config.Zones[record.ZoneId]
		if here ~= record.ZoneId or (zone and not insideZone(zone, dest, ZONE_MOVE_INSET)) then return false end
	end
	local g, noHit = groundPoint(dest.X, dest.Z)
	if not g and not noHit then return false end -- water / ridge / shore (noHit = bare test place: flat ground)
	-- never into a wall / gate / tree / rock / hillside at body height
	if workspace:Raycast(pos, delta + flat.Unit * 0.5, getShoveParams()) then return false end

	record._shoveReadyAt = now + REACT.SHOVE_GAP
	task.spawn(function()
		local ok, err = pcall(function()
			local done = 0
			while true do
				task.wait()
				if not record.Alive or not root.Parent or root.Anchored then break end
				local t = math.clamp((os.clock() - now) / math.max(REACT.SHOVE_TIME, 0.01), 0, 1)
				local f = 1 - (1 - t) * (1 - t) -- ease out
				root.CFrame = root.CFrame + delta * (f - done)
				done = f
				if t >= 1 then break end
			end
		end)
		if not ok then warnThrottled("shove", err) end
	end)
	return true
end

------------------------------------------------------------------ personal monsters (A4 / A5-C2..C4)
function MonsterService.SpawnPersonal(player, monsterId, opts)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then return nil end
	if type(monsterId) ~= "string" or Config.MonsterTypes[monsterId] == nil then return nil end
	if type(opts) ~= "table" then opts = {} end

	-- one living personal monster of a kind per player: reuse it
	local set = personal[player]
	if set then
		for rec in set do
			if rec.Alive and rec.Kind == monsterId and rec.Model and rec.Model.Parent then
				return rec.Model
			end
		end
	end

	-- ~8 studs in front of the player on walkable ground (then the sides / behind); fallback: the home-zone spawn
	local pos, faceTo
	local root = Util.GetRoot(player)
	if root then
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
		local base = root.Position
		for _, ang in { 0, math.pi / 2, -math.pi / 2, math.pi } do
			local c, s = math.cos(ang), math.sin(ang)
			local dir = Vector3.new(flat.X * c - flat.Z * s, 0, flat.X * s + flat.Z * c)
			local p = base + dir * PERSONAL_DISTANCE
			local g, noHit = groundPoint(p.X, p.Z)
			if g then
				pos = g
			elseif noHit then
				pos = Vector3.new(p.X, 0, p.Z) -- bare test place: legacy flat ground
			end
			if pos then break end
		end
		faceTo = base
	end
	if not pos then
		local faction = player:GetAttribute("Faction")
		local zone = Config.Zones[Config.HomeZoneId(type(faction) == "string" and faction or "None")] or Config.Zones.Crossroads
		local p = zone.Spawn + Vector3.new(0, 0, -PERSONAL_DISTANCE)
		local y, water = probeGround(p.X, p.Z)
		pos = Vector3.new(p.X, (y and not water) and y or 0, p.Z)
		faceTo = faceTo or zone.Spawn
	end

	local ok, rec = pcall(spawnMonster, monsterId, {
		Owner = player,
		Golden = opts.Golden == true,
		HP = tonumber(opts.HP),
		Position = pos,
		FaceTo = faceTo,
	})
	if not ok then
		warnThrottled("personal", rec)
		return nil
	end
	if not rec then return nil end

	personal[player] = personal[player] or {}
	personal[player][rec] = true

	task.delay(PERSONAL_LIFETIME, function()
		if rec.Alive then despawn(rec, true) end
	end)
	return rec.Model
end

local function onOwnerLeaving(player)
	local set = personal[player]
	if not set then return end
	personal[player] = nil
	for rec in set do
		if rec.Alive then
			rec.Alive = false
			records[rec.Id] = nil
			if rec.Model then rec.Model:Destroy() end
		end
	end
end

------------------------------------------------------------------ AI
local function findInfo(plist, player)
	for _, info in plist do
		if info.Player == player then return info end
	end
	return nil
end

-- A10-V3-2 (a) + A3-M4: a player this (non-personal) monster may chase: in the monster's own zone, not in a town,
-- not in the water
local function targetable(rec, info)
	return not info.Town and info.Zone == rec.ZoneId and info.Pos.Y >= OUT_Y
end

-- turns the root (whole assembly) toward the target on the floor plane when it is far off the look direction
local function faceTarget(rec, targetPos)
	local root = rec.Root
	if root.Anchored then return end
	local pos = root.Position
	local flat = Vector3.new(targetPos.X - pos.X, 0, targetPos.Z - pos.Z)
	if flat.Magnitude < 0.1 then return end
	local dir = flat.Unit
	if root.CFrame.LookVector:Dot(dir) >= FACE_TARGET_DOT then return end
	root.CFrame = CFrame.lookAt(pos, pos + dir)
end

-- A15: the wound-up hit lands only if this wind-up is still the current one, the monster is alive and in the world
-- and the target is alive, still a valid target (owner / zone / town / water rules) and within AttackRange + leeway.
-- Bumps AttackSeq at the impact (clients play the lunge), then deals the damage.
local function landAttack(rec, token, target)
	if rec._windup ~= token then return end
	rec._windup = nil
	if not rec.Alive or records[rec.Id] ~= rec then return end
	local model, root = rec.Model, rec.Root
	if not model or not model.Parent or not root or not root.Parent or root.Anchored then return end
	if typeof(target) ~= "Instance" or not target:IsA("Player") or target.Parent == nil or not Util.IsAlive(target) then
		return
	end
	local troot = Util.GetRoot(target)
	if not troot then return end
	local tpos = troot.Position
	if Util.FlatDistance(root.Position, tpos) > MC.AttackRange + REACT.WINDUP_LEEWAY then return end
	if rec.Owner then
		if target ~= rec.Owner or tpos.Y < OUT_Y or isPlayerInTown(target, tpos) then return end
	else
		if rec._returning then return end
		local info = { Pos = tpos, Town = isPlayerInTown(target, tpos), Zone = Config.ZoneAt(tpos).Id }
		if not targetable(rec, info) then return end
	end

	-- the client lunge goes along the look direction: face where the target is now
	local okFace, errFace = pcall(faceTarget, rec, tpos)
	if not okFace then warnThrottled("face", errFace) end
	local seq = model:GetAttribute(ATTACK_SEQ_ATTR)
	model:SetAttribute(ATTACK_SEQ_ATTR, (type(seq) == "number" and seq or 0) + 1)
	if S and S.CombatService then
		S.CombatService.DamagePlayer(target, rec.Def.Damage, nil)
	end
end

-- in reach: stand still and start a wind-up when the cooldown allows (the cooldown counts from the wind-up start; one
-- wind-up at a time, so a monster never hits twice for one attack)
local function attack(rec, info, now)
	rec._goal = nil
	rec.Humanoid:MoveTo(rec.Root.Position)
	if rec._windup ~= nil or now < rec._nextAttackAt then return end
	rec._nextAttackAt = now + MC.AttackCooldown
	-- the wind-up pose leans along the look direction, so face the target first
	local okFace, errFace = pcall(faceTarget, rec, info.Pos)
	if not okFace then warnThrottled("face", errFace) end
	local model = rec.Model
	if model then
		model:SetAttribute(WINDUP_AT_ATTR, workspace:GetServerTimeNow())
	end
	local token = {}
	rec._windup = token
	local target = info.Player
	task.delay(REACT.WINDUP, function()
		local ok, err = pcall(landAttack, rec, token, target)
		if rec._windup == token then rec._windup = nil end -- landAttack threw before clearing it
		if not ok then warnThrottled("attack", err) end
	end)
end

-- A10-V3-2 (c): put the monster back on its home point (sunk in water / cannot walk back)
local function pivotHome(rec)
	local root = rec.Root
	local p = rec.Home + Vector3.new(0, rec._rootOffset or 3, 0)
	local lv = root.CFrame.LookVector
	local flat = Vector3.new(lv.X, 0, lv.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
	rec.Model:PivotTo(CFrame.lookAt(p, p + flat.Unit))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	rec.Humanoid:MoveTo(p)
	rec._goal = nil
	rec._stuckAt = nil
	rec._detour = nil
	rec._deepSince = nil
end

-- A10-V3-2 (c): below DEEP_Y for more than DEEP_SECONDS -> PivotTo(Home). Returns true when it teleported.
local function deepRecovery(rec, pos, now)
	if pos.Y >= DEEP_Y then
		rec._deepSince = nil
		return false
	end
	if rec._deepSince == nil then
		rec._deepSince = now
		return false
	end
	if now - rec._deepSince > DEEP_SECONDS then
		pivotHome(rec)
		return true
	end
	return false
end

-- A11-R5: true when the monster moved < STUCK_MIN_MOVE during the last STUCK_WINDOW s while trying to move
local function isStuck(rec, pos, now, trying)
	if not trying then
		rec._stuckAt = nil
		return false
	end
	if rec._stuckAt == nil then
		rec._stuckAt, rec._stuckPos = now, pos
		return false
	end
	if now - rec._stuckAt < STUCK_WINDOW then return false end
	local moved = Util.FlatDistance(pos, rec._stuckPos)
	rec._stuckAt, rec._stuckPos = now, pos
	return moved < STUCK_MIN_MOVE
end

-- A11-R5: a short sideways detour (8-14 studs, 60-150 deg off the blocked direction) on walkable ground in the zone
local function startDetour(rec, zone, pos, goal, now)
	local to = goal and Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z) or Vector3.zero
	local baseAng = to.Magnitude > 0.01 and math.atan2(to.Z, to.X) or Util.Random:NextNumber(0, math.pi * 2)
	for _ = 1, DETOUR_TRIES do
		local side = Util.Random:NextNumber() < 0.5 and -1 or 1
		local a = baseAng + side * Util.Random:NextNumber(math.rad(60), math.rad(150))
		local r = Util.Random:NextNumber(DETOUR_MIN, DETOUR_MAX)
		local p = clampToZone(zone, Vector3.new(pos.X + math.cos(a) * r, pos.Y, pos.Z + math.sin(a) * r))
		local g, noHit = groundPoint(p.X, p.Z)
		if noHit then g = p end
		if g and Util.FlatDistance(g, pos) > ARRIVE_DIST then
			rec._detour = g
			rec._detourUntil = now + DETOUR_SECONDS
			return
		end
	end
	rec._detour = nil
end

-- every non-personal MoveTo goes through here; `dest` is already clamped into the zone (A10-V3-2 b)
local function steer(rec, dest, pos, now)
	local d = rec._detour
	if d then
		if now < rec._detourUntil and Util.FlatDistance(pos, d) > ARRIVE_DIST then
			dest = d
		else
			rec._detour = nil
		end
	end
	rec._goal = dest
	rec.Humanoid:MoveTo(dest)
end

-- wander point within WANDER_RADIUS of Home, clamped into the zone and on walkable ground (never water / ridge)
local function pickWanderPoint(rec, zone)
	for _ = 1, WANDER_TRIES do
		local a = Util.Random:NextNumber(0, math.pi * 2)
		local r = Util.Random:NextNumber(0, WANDER_RADIUS)
		local p = clampToZone(zone, rec.Home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		local g, noHit = groundPoint(p.X, p.Z)
		if g then return g end
		if noHit then return p end -- bare test place without Terrain / Map.Ground: legacy flat behaviour
	end
	return nil
end

local function personalStep(rec, plist, now, pos)
	local owner = rec.Owner
	if owner.Parent == nil then
		despawn(rec, false)
		return
	end
	local info = findInfo(plist, owner)
	if not info or info.Town or info.Pos.Y < OUT_Y then
		rec.Humanoid:MoveTo(pos) -- sandbag: stand still (also never follow the owner into the water)
		return
	end
	local d = Util.FlatDistance(pos, info.Pos)
	if d > PERSONAL_FOLLOW_RADIUS then
		rec.Humanoid:MoveTo(pos)
	elseif d <= MC.AttackRange then
		attack(rec, info, now)
	else
		rec.Humanoid:MoveTo(info.Pos)
	end
end

local function aiStep(rec, plist, now)
	local root, hum = rec.Root, rec.Humanoid
	if not root or not root.Parent or not hum or not hum.Parent or not rec.Model or not rec.Model.Parent then
		-- model lost (destroyed externally / fell out of the world)
		local kind, wasPersonal = rec.Kind, rec.Owner ~= nil
		despawn(rec, false)
		if not wasPersonal then scheduleRespawn(kind) end
		return
	end
	local pos = root.Position

	-- A10-V3-2 (c): sunk deep (water, knocked off a cliff) for > 2 s -> back home. Also for personal monsters.
	if deepRecovery(rec, pos, now) then return end

	if rec.Owner then
		personalStep(rec, plist, now, pos)
		return
	end

	local zone = Config.Zones[rec.ZoneId]
	local homeDist = Util.FlatDistance(pos, rec.Home)

	-- A10-V3-2 (c): out of its own zone (knockback, slid off) or in the water -> walk home, no re-aggro for 3 s.
	-- If it makes no progress (river bank, cliff) it is put back home.
	if Config.ZoneAt(pos).Id ~= rec.ZoneId or pos.Y < OUT_Y then
		rec._target = nil
		rec._returning = true
		rec._detour = nil
		rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
		if isStuck(rec, pos, now, homeDist > ARRIVE_DIST) then
			pivotHome(rec)
			return
		end
		local homeDest = clampToZone(zone, rec.Home)
		rec._goal = homeDest
		hum:MoveTo(homeDest)
		return
	end

	-- leash: go home and do not re-aggro for a moment (anti-jitter). (A monster standing in a town is out of its zone
	-- and already handled above.)
	if homeDist > MC.LeashRadius then
		rec._returning = true
		rec._target = nil
		rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
	end

	-- A3-M4 / A10-V3-2 (a): the current target stepped into a town, left this zone or went into the water
	-- -> return home, no re-aggro for 3 s
	if rec._target then
		local tinfo = findInfo(plist, rec._target)
		if not tinfo then
			rec._target = nil
		elseif not targetable(rec, tinfo) then
			rec._target = nil
			rec._returning = true
			rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
		end
	end

	-- A11-R5: stuck on terrain while moving -> pick a different destination
	local trying = rec._goal ~= nil and Util.FlatDistance(pos, rec._goal) > ARRIVE_DIST
	if isStuck(rec, pos, now, trying) then
		if rec._returning then
			startDetour(rec, zone, pos, rec.Home, now)
		elseif rec._target then
			rec._chaseStuck += 1
			if rec._chaseStuck >= CHASE_STUCK_GIVEUP then
				-- the target is unreachable (ridge slope etc.): give up, go home, no re-aggro for a moment
				rec._chaseStuck = 0
				rec._target = nil
				rec._returning = true
				rec._noAggroUntil = math.max(rec._noAggroUntil, now + NO_REAGGRO_SECONDS)
			else
				startDetour(rec, zone, pos, rec._goal, now)
			end
		else
			rec._goal = nil
			rec._detour = nil
			rec._nextWanderAt = now -- wander somewhere else right away
		end
	end

	if rec._returning then
		if homeDist <= RETURN_DONE_DIST or (now >= rec._noAggroUntil and homeDist <= MC.LeashRadius * 0.75) then
			rec._returning = false
		else
			steer(rec, clampToZone(zone, rec.Home), pos, now)
			return
		end
	end

	-- target = nearest alive player within AggroRadius standing in THIS zone, outside towns and water (A10-V3-2 a)
	local best, bestD = nil, nil
	if now >= rec._noAggroUntil then
		for _, info in plist do
			if targetable(rec, info) then
				local d = Util.FlatDistance(pos, info.Pos)
				if d <= MC.AggroRadius and (bestD == nil or d < bestD) then
					best, bestD = info, d
				end
			end
		end
	end

	if best then
		if rec._target ~= best.Player then rec._chaseStuck = 0 end
		rec._target = best.Player
		if bestD <= MC.AttackRange then
			rec._chaseStuck = 0
			attack(rec, best, now)
		else
			steer(rec, clampToZone(zone, best.Pos), pos, now) -- A10-V3-2 (b)
		end
		return
	end

	rec._target = nil
	if now >= rec._nextWanderAt then
		rec._nextWanderAt = now + Util.Random:NextNumber(WANDER_MIN, WANDER_MAX)
		local dest = pickWanderPoint(rec, zone)
		if dest then
			rec._detour = nil
			steer(rec, dest, pos, now)
		end
	end
end

local function aiTick()
	local now = os.clock()
	local plist = {}
	for _, p in readyPlayers() do
		if p.Parent and Util.IsAlive(p) then
			local root = Util.GetRoot(p)
			if root then
				local pos = root.Position
				table.insert(plist, { Player = p, Pos = pos, Town = isPlayerInTown(p, pos), Zone = Config.ZoneAt(pos).Id })
			end
		end
	end
	local list = {}
	for _, rec in records do
		table.insert(list, rec)
	end
	for _, rec in list do
		if rec.Alive then
			local ok, err = pcall(aiStep, rec, plist, now)
			if not ok then warnThrottled("ai", err) end
		end
	end
end

------------------------------------------------------------------ density (A3-M2 / A5-C1)
local function reevaluate()
	local zoneCounts = playersPerZone()
	local targets = cappedTargets(zoneCounts) -- CR-L13
	local total = totalNonPersonal()
	for _, kind in Config.MonsterTypeOrder do
		if total >= GLOBAL_CAP then break end
		local target = targets[kind] or targetCount(kind, zoneCounts)
		local have = aliveCountOf(kind) + (pending[kind] or 0)
		local spawned = 0
		while have < target and total < GLOBAL_CAP and spawned < MAX_SPAWNS_PER_KIND_PER_PASS do
			local rec = spawnMonster(kind)
			if not rec then break end
			have += 1
			total += 1
			spawned += 1
		end
	end
end

------------------------------------------------------------------ lifecycle
function MonsterService.Init(registry)
	S = registry
	getMonstersFolder()
	Util.GetFolder(workspace, "Effects")
	Util.GetFolder(ServerStorage, CUSTOM_FOLDER) -- A1: may stay empty
	if S.PlayerService and S.PlayerService.PlayerLeaving then
		S.PlayerService.PlayerLeaving:Connect(function(player)
			onOwnerLeaving(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		onOwnerLeaving(player)
	end)
end

function MonsterService.Start()
	for _, id in Config.MonsterTypeOrder do
		print(("[MonsterService] custom model for %s: %s"):format(id, getCustomTemplate(id) and "yes" or "no"))
	end

	local total = 0
	for _, kind in Config.MonsterTypeOrder do
		local def = Config.MonsterTypes[kind]
		if def then
			for _ = 1, def.Count do
				if total >= GLOBAL_CAP then break end
				local ok, rec = pcall(spawnMonster, kind)
				if ok and rec then
					total += 1
				elseif not ok then
					warnThrottled("spawn_" .. kind, rec)
				end
			end
		end
	end

	task.spawn(function()
		while true do
			task.wait(MC.AIInterval)
			local ok, err = pcall(aiTick)
			if not ok then warnThrottled("aiLoop", err) end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(REEVAL_INTERVAL)
			local ok, err = pcall(reevaluate)
			if not ok then warnThrottled("density", err) end
		end
	end)

	print("[MonsterService] started")
end

return MonsterService
]]></ProtectedString>
				<string name="ScriptGuid">{4367CFC4-8C01-4106-8193-236256882304}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">MonsterService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f68800000915</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXE8CC822DB6094B26B4B5C76E234DE849">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PlayerService.luau : join/leave lifecycle, attribute mirroring, leaderstats, spawn/respawn, MaxHealth/WalkSpeed,
-- playtime, Regular's Luck minutes, the no-player-collision group (addendum A7-5), slope limit (A11-R2), camera zoom
-- limits (A12), anti-collusion pair cooldowns (CR-M4) and BindToClose. Fall rescue (A10) is owned by ZoneService.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local TAG = "PlayerService"

local PlayerService = {}

-- public signals (top level so they exist before any Init)
PlayerService.PlayerReady = Util.Signal.new() -- (player, data)
PlayerService.PlayerLeaving = Util.Signal.new() -- (player, data) fired once, BEFORE the final save
PlayerService.CharacterSpawned = Util.Signal.new() -- (player, character, humanoid, cosmetic: boolean?)
PlayerService.CharacterDied = Util.Signal.new() -- (player, character)

local S = nil

local ready = {} -- [Player] = true
local joining = {} -- [Player] = true while the data load runs
local finalizing = {} -- [Player] = true while FinalizeLeave runs
-- CR-M2: [Player] = true once onClose fired PlayerLeaving (ready kept); "saving" while that player's release runs
local leftFired = {}
local removed = setmetatable({}, { __mode = "k" }) -- [Player] = true once PlayerRemoving fired
local conns = {} -- [Player] = { RBXScriptConnection }
local lastActive = {} -- [Player] = os.clock() of the last input/combat
local regularMinutes = {} -- [Player] = active minutes on this server
local mirrored = {} -- [key] = true for every key of Config.Data.Mirrored
local characterLoading = {} -- [Player] = true while a normal spawn is being installed
local respawnQueued = {} -- [Player] = one additional requested respawn while the current load yields
local cosmeticContext = setmetatable({}, { __mode = "k" }) -- [Model] = server-only snapshot for an appearance replacement
local nativeRestore = {} -- [Player] = pending engine-owned avatar restoration; registered before CharacterAdded
local deathBound = setmetatable({}, { __mode = "k" }) -- [Humanoid] = death listener installed once
local closing = false

local COLLISION_GROUP = Config.Player.CollisionGroup or "Players"
local collisionGroupOk = false

local CHILD_TIMEOUT = 5 -- seconds to wait for Humanoid / HumanoidRootPart / parenting
local CLOSE_TIMEOUT = 25 -- BindToClose budget
local FINALIZE_WAIT = 30 -- a second FinalizeLeave call waits this long for the first one
local LEADERSTAT_KEYS = { "Level", "BankGold", "CarriedGold", "Rebirths", "Honor", "Infamy", "Faction" }

local MAX_SLOPE_ANGLE = 46 -- A11-R2: Terrain ridges (>= 50 deg) cannot be walked over
local CAMERA_MAX_ZOOM = 40 -- A12: players never see the whole world (kaiju may raise it while transformed)
local CAMERA_MIN_ZOOM = 6
-- CR-M4: PairCD entries older than this are dropped at PlayerReady (>= every pair cooldown / window that uses them)
local PAIR = {
	MinKeep = 1800,
	MaxKeys = 200,
	-- { Config table, key } read for the keep window (a longer configured cooldown keeps its entries longer)
	KeepFrom = {
		{ "Kaiju", "PairRewardCooldown" }, { "PvP", "PairRewardCooldown" }, { "Bully", "RepeatWindow" },
		{ "Grudge", "RefundBonusCooldown" }, { "Grudge", "RestealWindow" },
	},
}
------------------------------------------------------------------ helpers
local lastLoopWarn = {}
local function loopWarn(loopName, err)
	local now = os.clock()
	if now - (lastLoopWarn[loopName] or -math.huge) >= 10 then
		lastLoopWarn[loopName] = now
		Util.Warn(TAG, loopName .. ": " .. tostring(err))
	end
end

local function addConn(player, conn)
	local list = conns[player]
	if not list then
		list = {}
		conns[player] = list
	end
	table.insert(list, conn)
end

-- persisted value (data table first, attribute as fallback)
local function stat(player, key, default)
	local data = S.DataService.Get(player)
	local v = data and data[key]
	if v == nil then v = player:GetAttribute(key) end
	if v == nil then return default end
	return v
end

local function classDef(player)
	local cs = S.ClassService
	if cs and cs.GetClassDef then
		local ok, def = pcall(cs.GetClassDef, player)
		if ok and type(def) == "table" then return def end
	end
	return Config.Classes[stat(player, "Class", "Warrior")] or Config.Classes.Warrior
end

local function healthMult(player)
	local js = S.JusticeService
	if js and js.GetHealthMult then
		local ok, m = pcall(js.GetHealthMult, player)
		if ok and type(m) == "number" and m == m and m > 0 and m < math.huge then return m end
	end
	return 1
end

local function computeMaxHealth(player)
	local level = tonumber(stat(player, "Level", 1)) or 1
	local faction = stat(player, "Faction", "None")
	local class = stat(player, "Class", "Warrior")
	return math.max(1, math.floor(Config.MaxHealth(level, faction, class) * healthMult(player)))
end

-- health/speed formula on a given humanoid (used on spawn and by RefreshCharacter)
local function applyStats(player, humanoid, fullHeal)
	local maxHP = computeMaxHealth(player)
	if humanoid.Health <= 0 then
		humanoid.MaxHealth = maxHP -- never revive
		return
	end
	local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
	humanoid.MaxHealth = maxHP
	if fullHeal then
		humanoid.Health = maxHP
	else
		humanoid.Health = math.clamp(ratio * maxHP, 1, maxHP)
	end
	humanoid.WalkSpeed = Config.Player.WalkSpeed * (classDef(player).WalkSpeedMult or 1)
end

local function spawnCFrame(zoneId)
	local zs = S.ZoneService
	if zs and zs.GetSpawnCFrame then
		local ok, cf = pcall(zs.GetSpawnCFrame, zoneId)
		if ok and typeof(cf) == "CFrame" then return cf end
		if not ok then Util.Warn(TAG, "GetSpawnCFrame failed: " .. tostring(cf)) end
	end
	local z = Config.Zones[zoneId] or Config.Zones.Crossroads
	return CFrame.new(z.Spawn + Vector3.new(0, 4, 0))
end

-- CR-H2: tell ZoneService's movement check that the server is about to move this player (no false "teleport" log)
local function markTeleported(player, seconds)
	local zs = S.ZoneService
	if zs and zs.MarkTeleported then
		local ok, err = pcall(zs.MarkTeleported, player, seconds)
		if not ok then loopWarn("MarkTeleported", err) end
	end
end

local function loadCharacter(player)
	if player.Parent == nil or not ready[player] then return end
	if characterLoading[player] then
		respawnQueued[player] = true
		return
	end
	characterLoading[player] = true
	-- CR-H2: the new character appears at a spawn point first; onCharacterAdded marks again before placing it
	markTeleported(player, (Config.AntiCheat and Config.AntiCheat.SpawnGrace) or 2)
	local ok, err = pcall(function()
		player:LoadCharacter() -- A23-5: always the player's own Roblox avatar (no costume rig)
	end)
	characterLoading[player] = nil
	if not ok then
		Util.Warn(TAG, "LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
	if respawnQueued[player] then
		respawnQueued[player] = nil
		if ready[player] and player.Parent then task.defer(loadCharacter, player) end
	end
end

-- A12: on join and on every CharacterAdded (max first, so min never exceeds max)
local function applyCameraLimits(player)
	local ok, err = pcall(function()
		player.CameraMaxZoomDistance = CAMERA_MAX_ZOOM
		player.CameraMinZoomDistance = CAMERA_MIN_ZOOM
	end)
	if not ok then
		loopWarn("camera limits", err)
	end
end

------------------------------------------------------------------ pair cooldowns (CR-M4)
local function pairKeepSeconds()
	local keep = PAIR.MinKeep
	for _, ref in PAIR.KeepFrom do
		local t = Config[ref[1]]
		local v = type(t) == "table" and tonumber(t[ref[2]]) or nil
		if v and v == v and v > keep and v < math.huge then keep = v end
	end
	local b = Config.Bully
	if type(b) == "table" then -- PvPService's bully bounty window (DecaySeconds * MaxStacks)
		local v = (tonumber(b.DecaySeconds) or 0) * (tonumber(b.MaxStacks) or 0)
		if v == v and v > keep and v < math.huge then keep = v end
	end
	return keep
end

-- os.time() of an entry: a number, or the newest of a { t1, t2 } list ("kolog:<victimUserId>")
local function pairStamp(v)
	if type(v) == "table" then
		local newest = nil
		for _, item in v do
			local t = tonumber(item)
			if t and t == t and (newest == nil or t > newest) then newest = t end
		end
		return newest
	end
	local t = tonumber(v)
	if t and t == t then return t end
	return nil
end

-- drops entries older than the keep window (or far in the future: bad clock), then the oldest above MaxKeys
local function prunePairCD(data)
	if type(data) ~= "table" then return end
	if type(data.PairCD) ~= "table" then
		data.PairCD = {}
		return
	end
	local cd = data.PairCD
	local now = os.time()
	local keep = pairKeepSeconds()
	local list = {}
	for k, v in cd do
		local t = pairStamp(v)
		if type(k) ~= "string" or t == nil or now - t > keep or t - now > keep then
			cd[k] = nil
		else
			table.insert(list, { K = k, T = t })
		end
	end
	if #list > PAIR.MaxKeys then
		table.sort(list, function(a, b) return a.T < b.T end)
		for i = 1, #list - PAIR.MaxKeys do
			cd[list[i].K] = nil
		end
	end
end

------------------------------------------------------------------ collision group (A7-5)
local function setupCollisionGroup()
	local ok, err = pcall(function()
		if not PhysicsService:IsCollisionGroupRegistered(COLLISION_GROUP) then
			PhysicsService:RegisterCollisionGroup(COLLISION_GROUP)
		end
		PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, COLLISION_GROUP, false)
	end)
	collisionGroupOk = ok
	if not ok then
		Util.Warn(TAG, "collision group setup failed: " .. tostring(err))
	end
end

local function setPartGroup(inst)
	if inst:IsA("BasePart") then
		inst.CollisionGroup = COLLISION_GROUP
	end
end

local function assignCollisionGroup(character)
	if not collisionGroupOk then return end
	for _, d in character:GetDescendants() do
		setPartGroup(d)
	end
	-- the connection dies with the character
	character.DescendantAdded:Connect(setPartGroup)
end

------------------------------------------------------------------ leaderstats
local function toInt(v)
	v = tonumber(v) or 0
	if v ~= v or v == math.huge or v == -math.huge then return 0 end
	return math.floor(v)
end

local function buildLeaderstats(player)
	local old = player:FindFirstChild("leaderstats")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local function intValue(name)
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = folder
		return v
	end
	-- creation order = column order in the player list
	local levelV = intValue("레벨")
	local goldV = intValue("골드")
	local rebirthV = intValue("환생")
	local fameV = intValue("명성")

	local function update()
		levelV.Value = toInt(player:GetAttribute("Level"))
		goldV.Value = toInt(player:GetAttribute("BankGold")) + toInt(player:GetAttribute("CarriedGold"))
		rebirthV.Value = toInt(player:GetAttribute("Rebirths"))
		local f = player:GetAttribute("Faction")
		if f == "Halo" then
			fameV.Value = toInt(player:GetAttribute("Honor"))
		elseif f == "Horns" then
			fameV.Value = toInt(player:GetAttribute("Infamy"))
		else
			fameV.Value = 0 -- None / Neutral (phase 2 adds 장인 명성)
		end
	end
	update()
	folder.Parent = player

	for _, key in LEADERSTAT_KEYS do
		addConn(player, player:GetAttributeChangedSignal(key):Connect(update))
	end
end

------------------------------------------------------------------ character lifecycle
-- Humanoid.HipHeight uses different standing-height formulas for R15 and R6.
local function standingHeight(character, humanoid, root)
	if not character or not humanoid or not root or not root:IsA("BasePart") then return nil end
	local height = humanoid.HipHeight + root.Size.Y * 0.5
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		if not leg or not leg:IsA("BasePart") then return nil end
		height += leg.Size.Y
	end
	return height == height and height > 0 and height < math.huge and height or nil
end

local function cosmeticPivot(character, humanoid, root, context)
	local pivot = context.OriginalPivot or context.Pivot
	local height = standingHeight(character, humanoid, root)
	if height and context.StandingHeight then
		-- World Y only: preserve the feet's height, XZ, facing and airborne offset.
		pivot += Vector3.new(0, height - context.StandingHeight, 0)
	end
	context.Pivot = pivot -- recompute from OriginalPivot after spawn handlers scale the new rig
	return pivot
end

local function bindCharacterDeath(player, character, humanoid)
	if deathBound[humanoid] then return end
	deathBound[humanoid] = true
	local handled = false
	local function died()
		if handled or not ready[player] or player.Parent == nil or player.Character ~= character then return end
		handled = true
		PlayerService.CharacterDied:Fire(player, character)
		task.delay(Config.Player.RespawnTime, function()
			if player.Parent and player.Character == character and ready[player] then loadCharacter(player) end
		end)
	end
	humanoid.Died:Once(died)
	if humanoid.Health <= 0 then died() end -- CharacterAdded may arrive after an engine-load death.
end

local function onCharacterAdded(player, character)
	local context = cosmeticContext[character]
	cosmeticContext[character] = nil
	local native = nativeRestore[player]
	if not context and native and character ~= native.ExpectedOld and player.Character == character then
		context = native
	end
	if context and context.Native then context.Character = character end
	local humanoid = character:WaitForChild("Humanoid", CHILD_TIMEOUT)
	if not humanoid or not humanoid:IsA("Humanoid") then return end
	bindCharacterDeath(player, character, humanoid)
	-- A deferred engine callback must never turn an expired cosmetic request into a fresh spawn.
	if character:GetAttribute("HHC_RestoreCancelled") then return end
	if context and context.Native then
		if nativeRestore[player] == context then nativeRestore[player] = nil end
		context.Character = character
		character:SetAttribute("HHC_OriginalRestore", true)
		-- The engine installs the owner's native controllers/appearance after CharacterAdded.
		-- Do not place or scale its unfinished avatar and do not replace its Animate/joint setup.
		local started = os.clock()
		while not context.NativeReady and player.Character == character and ready[player]
			and os.clock() - started < 30 do task.wait() end
		if not context.NativeReady or context.Cancelled or context.Failed then
			context.Failed = true
			return
		end
	end
	assignCollisionGroup(character)

	local root = character:WaitForChild("HumanoidRootPart", CHILD_TIMEOUT)
	if not humanoid or not root or not humanoid:IsA("Humanoid") then
		if player.Character == character then
			Util.Warn(TAG, "character of " .. player.Name .. " has no Humanoid/HumanoidRootPart; skipped")
		end
		return
	end
	humanoid.MaxSlopeAngle = MAX_SLOPE_ANGLE -- A11-R2 (Swimming stays enabled for players, A10)
	if player.Character ~= character or not ready[player] then return end
	applyCameraLimits(player)

	-- CharacterAdded can fire before the model is parented: wait until it is in the world before placing it
	local t0 = os.clock()
	while character.Parent == nil and os.clock() - t0 < CHILD_TIMEOUT do
		task.wait()
	end
	if player.Character ~= character or character.Parent == nil or not ready[player] then return end
	if context and (context.Cancelled or context.Failed or humanoid.Health <= 0) then
		context.Failed = true
		return
	end

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	applyStats(player, humanoid, true)
	if context then humanoid.Health = math.min(context.Health, humanoid.MaxHealth) end
	if not context then markTeleported(player, (Config.AntiCheat and Config.AntiCheat.SpawnGrace) or 2) end -- CR-H2
	character:PivotTo(context and cosmeticPivot(character, humanoid, root, context)
		or spawnCFrame(Config.HomeZoneId(stat(player, "Faction", "None"))))

	PlayerService.CharacterSpawned:Fire(player, character, humanoid, context ~= nil)
	if context and player.Character == character and character.Parent and humanoid.Health > 0 then
		-- JusticeService may scale the new rig; recalculate its standing height without accumulating an offset.
		character:PivotTo(cosmeticPivot(character, humanoid, root, context))
		root.AssemblyLinearVelocity = context.LinearVelocity
		root.AssemblyAngularVelocity = context.AngularVelocity
	end
	if context and context.MovementTrack and S.ZoneService and S.ZoneService.RestoreMovementTrack then
		-- Spawn handlers (including JusticeService scale/lift) are synchronous and may mark a teleport.
		-- Restore after all of them: a cosmetic switch neither resets the position sample nor renews grace.
		S.ZoneService.RestoreMovementTrack(player, context.MovementTrack, character)
	end
	if context then context.Completed = true end
end

------------------------------------------------------------------ join
local function onJoin(player)
	if ready[player] or joining[player] or finalizing[player] then return end
	applyCameraLimits(player) -- A12: before the first character
	joining[player] = true
	local ok, data = pcall(S.DataService.Load, player)
	if not ok then
		Util.Warn(TAG, "load error for " .. player.Name .. ": " .. tostring(data))
		data = nil
	end

	-- left (or the server started closing) while the load was finishing: hand the data straight back.
	-- CR-L2: joining stays set until the release finished, so onClose waits for this save too
	if data ~= nil and (player.Parent == nil or removed[player] or closing) then
		local okRel, errRel = pcall(S.DataService.Release, player)
		if not okRel then Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(errRel)) end
		joining[player] = nil
		return
	end
	joining[player] = nil
	if player.Parent == nil then return end
	if data == nil then
		player:Kick(string.format(Config.Text.LoadFailed))
		return
	end

	local okPrune, errPrune = pcall(prunePairCD, data) -- CR-M4
	if not okPrune then Util.Warn(TAG, "PairCD prune failed for " .. player.Name .. ": " .. tostring(errPrune)) end

	for _, key in Config.Data.Mirrored do
		local v = data[key]
		if v ~= nil and type(v) ~= "table" then
			player:SetAttribute(key, v)
		end
	end
	regularMinutes[player] = 0
	-- A saved nickname is untrusted until the global reservation and current text filter are verified.
	player:SetAttribute("Nickname", "")
	player:SetAttribute("NicknameVerified", false)
	player:SetAttribute("NicknameStatus", "Loading")
	player:SetAttribute("RegularMinutes", 0)
	buildLeaderstats(player)

	-- connected before PlayerReady so a Respawn() from a PlayerReady handler is never missed
	addConn(player, player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end))

	ready[player] = true
	player:SetAttribute("DataLoaded", true)
	PlayerService.PlayerReady:Fire(player, data)

	if ready[player] then
		loadCharacter(player)
	end
end

------------------------------------------------------------------ shutdown
local function onClose()
	closing = true
	local targets = {}
	for _, p in Players:GetPlayers() do
		targets[p] = true
	end
	for p in ready do
		targets[p] = true
	end

	-- CR-M2: fire PlayerLeaving for every ready player BEFORE any of them is released, keeping ready set, so
	-- cross-player handlers (e.g. a thief's sack refund to a victim) still land in the other player's data.
	-- FinalizeLeave then only runs the final save (leftFired branch).
	local pre = {}
	for p in ready do
		table.insert(pre, p)
	end
	for _, p in pre do
		if ready[p] and not finalizing[p] and not leftFired[p] then
			finalizing[p] = true -- a concurrent FinalizeLeave (PlayerRemoving) waits while the handlers run
			local okFire, errFire = pcall(function()
				PlayerService.PlayerLeaving:Fire(p, S.DataService.Get(p))
			end)
			if not okFire then Util.Warn(TAG, "PlayerLeaving on close failed: " .. tostring(errFire)) end
			leftFired[p] = true
		end
	end

	local pending = 0
	for p in targets do
		pending += 1
		task.spawn(function()
			local ok, err = pcall(PlayerService.FinalizeLeave, p)
			if not ok then Util.Warn(TAG, "FinalizeLeave on close failed: " .. tostring(err)) end
			pending -= 1
		end)
	end

	local t0 = os.clock()
	while (pending > 0 or next(finalizing) ~= nil or next(joining) ~= nil) and os.clock() - t0 < CLOSE_TIMEOUT do
		task.wait(0.1)
	end
end

------------------------------------------------------------------ public API
function PlayerService.Init(registry)
	S = registry
	Players.CharacterAutoLoads = false
	for _, key in Config.Data.Mirrored do
		mirrored[key] = true
	end
	setupCollisionGroup()
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onJoin, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		removed[player] = true
		PlayerService.FinalizeLeave(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end

	game:BindToClose(onClose)

	-- playtime
	task.spawn(function()
		local step = Config.Player.PlaytimeTick
		while true do
			task.wait(step)
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(PlayerService.AddStat, p, "PlaytimeSeconds", step)
				if not ok then loopWarn("playtime loop", err) end
			end
		end
	end)

	-- Regular's Luck: one minute counts if the player had input/combat within it
	task.spawn(function()
		local period = Config.Luck.MinuteSeconds
		while true do
			task.wait(period)
			local now = os.clock()
			for _, p in PlayerService.GetReadyPlayers() do
				local ok, err = pcall(function()
					local t = lastActive[p]
					if t and now - t <= period then
						local n = (regularMinutes[p] or 0) + 1
						regularMinutes[p] = n
						p:SetAttribute("RegularMinutes", n)
					end
				end)
				if not ok then loopWarn("regular-minutes loop", err) end
			end
		end
	end)

	print("[PlayerService] started")
end

function PlayerService.IsReady(player)
	return player ~= nil and ready[player] == true
end

function PlayerService.GetReadyPlayers()
	local out = {}
	for _, p in Players:GetPlayers() do
		if ready[p] then
			table.insert(out, p)
		end
	end
	return out
end

function PlayerService.GetData(player)
	return S.DataService.Get(player)
end

function PlayerService.SetStat(player, key, value)
	local data = S.DataService.Get(player)
	if not data then return end
	data[key] = value
	if mirrored[key] then
		player:SetAttribute(key, value)
	end
end

function PlayerService.AddStat(player, key, delta)
	local data = S.DataService.Get(player)
	if not data then return 0 end
	local newValue = (tonumber(data[key]) or 0) + (tonumber(delta) or 0)
	PlayerService.SetStat(player, key, newValue)
	return newValue
end

function PlayerService.Respawn(player)
	if not ready[player] or player.Parent == nil then return end
	task.spawn(loadCharacter, player)
end

function PlayerService.IsSpawning(player)
	return characterLoading[player] == true
end

-- Server-owned character installation. Appearance swaps do not fire CharacterDied or grant a new spawn shield.
local function installCharacter(player, character, context, expectedOld)
	if not ready[player] or player.Parent ~= Players or player.Character ~= expectedOld then return false end
	if typeof(character) ~= "Instance" or not character:IsA("Model") or character.Parent ~= nil then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then return false end
	local ok, err = pcall(function()
		character.Name = player.Name
		character.PrimaryPart = root
		if context then
			context.OriginalPivot = context.Pivot
			for _, child in character:GetChildren() do
				if child:IsA("ForceField") then child:Destroy() end
			end
			character:PivotTo(cosmeticPivot(character, humanoid, root, context))
			cosmeticContext[character] = context
		end
		character.Parent = workspace
		-- The context is registered before CharacterAdded fires, for both immediate and deferred signal modes.
		player.Character = character
	end)
	if not ok then
		cosmeticContext[character] = nil
		pcall(character.Destroy, character)
		Util.Warn(TAG, "character installation failed: " .. tostring(err))
		return false
	end
	if expectedOld and expectedOld ~= character then
		-- Move existing shields rather than cloning them: their original expiration callbacks still apply.
		if context then
			for _, child in expectedOld:GetChildren() do
				if child:IsA("ForceField") then child.Parent = character end
			end
		end
		pcall(expectedOld.Destroy, expectedOld)
	end
	pcall(root.SetNetworkOwner, root, player)
	return true
end

function PlayerService.SpawnCharacter(player, character)
	return installCharacter(player, character, nil, player.Character)
end

function PlayerService.ReplaceCharacter(player, character, expectedOld)
	local old = player.Character
	if old ~= expectedOld or characterLoading[player] or not Util.IsAlive(player) then return false end
	local humanoid = Util.GetHumanoid(player)
	local root = Util.GetRoot(player)
	local context = {
		Health = humanoid.Health,
		Pivot = old:GetPivot(),
		StandingHeight = standingHeight(old, humanoid, root),
		LinearVelocity = root.AssemblyLinearVelocity,
		AngularVelocity = root.AssemblyAngularVelocity,
	}
	if S.ZoneService and S.ZoneService.CaptureMovementTrack then
		context.MovementTrack = S.ZoneService.CaptureMovementTrack(player)
	end
	return installCharacter(player, character, context, old)
end

-- OFF uses the player's engine spawn path. Manually assigning a detached native avatar can leave
-- current R15 AnimationConstraint/controller physics uninitialized on the owning client.
function PlayerService.RestoreOwnerCharacter(player, description, expectedOld, stillWanted)
	if not ready[player] or player.Parent ~= Players or player.Character ~= expectedOld
		or characterLoading[player] or not Util.IsAlive(player) then return false end
	if typeof(description) ~= "Instance" or not description:IsA("HumanoidDescription") then return false end
	local copiedOk, copied = pcall(description.Clone, description)
	if not copiedOk or not copied then return false end
	local old = player.Character
	local humanoid, root = Util.GetHumanoid(player), Util.GetRoot(player)
	if not humanoid or not root or (stillWanted and not stillWanted()) then copied:Destroy(); return false end
	local context = {
		ExpectedOld = old, Health = humanoid.Health, OriginalPivot = old:GetPivot(), Pivot = old:GetPivot(),
		StandingHeight = standingHeight(old, humanoid, root),
		LinearVelocity = root.AssemblyLinearVelocity, AngularVelocity = root.AssemblyAngularVelocity,
		Native = true, NativeReady = false, Completed = false,
	}
	if S.ZoneService and S.ZoneService.CaptureMovementTrack then
		context.MovementTrack = S.ZoneService.CaptureMovementTrack(player)
	end
	local holder = Instance.new("Folder")
	holder.Name = "CosmeticRestoreShields"
	holder.Parent = ServerStorage
	local shields = {}
	for _, child in old:GetChildren() do
		if child:IsA("ForceField") then shields[child] = true; child.Parent = holder end
	end
	local added = player.CharacterAdded:Connect(function(character)
		if character == old then return end
		-- Delete only the engine's newly granted spawn shield. Original shield instances keep their deadlines.
		for _, child in character:GetChildren() do
			if child:IsA("ForceField") and not shields[child] then child:Destroy() end
		end
		character.DescendantAdded:Connect(function(child)
			if not context.NativeReady and child:IsA("ForceField") and not shields[child] then child:Destroy() end
		end)
	end)
	characterLoading[player] = true
	nativeRestore[player] = context
	local ok, err = pcall(player.LoadCharacterWithHumanoidDescriptionAsync, player, copied)
	copied:Destroy()
	added:Disconnect()
	if not ok then context.Failed = true end
	context.NativeReady = true
	local current = player.Character
	-- In deferred signal mode the engine call may finish before CharacterAdded runs. Register
	-- that exact model before clearing the player slot so the cosmetic snapshot cannot be lost.
	if current and current ~= old and not context.Character then cosmeticContext[current] = context end
	if nativeRestore[player] == context then nativeRestore[player] = nil end
	if current and current.Parent and ready[player] then
		for _, child in current:GetChildren() do
			if child:IsA("ForceField") and not shields[child] then child:Destroy() end
		end
		for _, child in holder:GetChildren() do child.Parent = current end
	end
	holder:Destroy()
	local started = os.clock()
	while ok and not context.Completed and not context.Failed and player.Character == current
		and player.Parent == Players and ready[player] and os.clock() - started < CHILD_TIMEOUT do task.wait() end
	local restored = ok and context.Completed and not context.Failed and player.Character == current
		and current ~= old and Util.IsAlive(player)
	if not restored then
		context.Cancelled, context.Failed = true, true
		if current and current ~= old then
			if cosmeticContext[current] == context then cosmeticContext[current] = nil end
			current:SetAttribute("HHC_RestoreCancelled", true)
		end
	end
	characterLoading[player] = nil
	if respawnQueued[player] then
		respawnQueued[player] = nil
		if ready[player] and player.Parent then task.defer(loadCharacter, player) end
	end
	if not ok then Util.Warn(TAG, "owner avatar restore failed: " .. tostring(err)) end
	return restored
end

-- recompute MaxHealth + WalkSpeed of the current character (keeps the HP ratio unless fullHeal)
function PlayerService.RefreshCharacter(player, fullHeal)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid then return end
	applyStats(player, humanoid, fullHeal == true)
end

-- idempotent: PlayerLeaving + final save once; always clears per-player state
function PlayerService.FinalizeLeave(player)
	if leftFired[player] == true then
		-- CR-M2: onClose already fired PlayerLeaving (ready was kept for cross-player refunds): only the save is left
		leftFired[player] = "saving" -- a concurrent call takes the finalizing branch below and waits
		ready[player] = nil
		local ok, err = pcall(S.DataService.Release, player)
		if not ok then
			Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(err))
		end
		finalizing[player] = nil
	elseif finalizing[player] then
		local t0 = os.clock()
		while finalizing[player] and os.clock() - t0 < FINALIZE_WAIT do
			task.wait(0.1)
		end
		return
	elseif ready[player] then
		finalizing[player] = true
		PlayerService.PlayerLeaving:Fire(player, S.DataService.Get(player))
		ready[player] = nil -- loops and remotes stop touching the player while the final save runs
		local ok, err = pcall(S.DataService.Release, player)
		if not ok then
			Util.Warn(TAG, "release failed for " .. player.Name .. ": " .. tostring(err))
		end
		finalizing[player] = nil
	end

	ready[player] = nil
	leftFired[player] = nil
	Util.ClearPlayer(player)
	lastActive[player] = nil
	regularMinutes[player] = nil
	characterLoading[player] = nil
	respawnQueued[player] = nil
	nativeRestore[player] = nil
	local list = conns[player]
	conns[player] = nil
	if list then
		for _, c in list do
			c:Disconnect()
		end
	end
end

function PlayerService.MarkActive(player)
	if ready[player] then
		lastActive[player] = os.clock()
	end
end

-- CR-M20: os.clock() of the player's last input/combat (MarkActive); 0 = none yet on this server
function PlayerService.GetLastActive(player)
	return (player ~= nil and lastActive[player]) or 0
end

-- CR-M2: true once BindToClose started (the server is shutting down; leaves are not the players' choice)
function PlayerService.IsShuttingDown()
	return closing
end

-- CR-M4: anti-collusion pair cooldown kept in the HOLDER's save (key "<kind>:<otherUserId>" = os.time()), so it
-- follows the player across servers. true = the last commit is at least `cooldown` s old (or there is none);
-- commit ~= false records now on true. false when the holder has no loaded data (no reward).
function PlayerService.PairReady(holder, otherUserId, kind, cooldown, commit)
	if holder == nil or otherUserId == nil or type(kind) ~= "string" then return false end
	local d = S.DataService.Get(holder)
	if type(d) ~= "table" then return false end
	if type(d.PairCD) ~= "table" then d.PairCD = {} end
	local cd = d.PairCD
	local k = kind .. ":" .. tostring(otherUserId)
	local now = os.time()
	local last = tonumber(cd[k]) or 0
	if last ~= last then last = 0 end
	local need = tonumber(cooldown) or 0
	if need ~= need then need = 0 end
	if now - last < need then return false end
	if commit ~= false then
		local isNew = cd[k] == nil
		cd[k] = now
		if isNew then
			-- bound growth within a long session too (PlayerReady prunes the rest)
			local n = 0
			for _ in cd do
				n += 1
			end
			if n > PAIR.MaxKeys then
				local okPrune, errPrune = pcall(prunePairCD, d)
				if not okPrune then loopWarn("PairCD prune", errPrune) end
			end
		end
	end
	return true
end

function PlayerService.GetRegularMinutes(player)
	return regularMinutes[player] or 0
end

return PlayerService
]]></ProtectedString>
				<string name="ScriptGuid">{278DF18C-1FC3-4133-9DF6-06DFF2D70139}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PlayerService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">715f89632ec8bc970ad4f68800000917</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8D33D231675C42A98A1172D73B1F79FF">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- ProgressionService.luau : XP / levels, carried + bank gold, auto-bank, reward multipliers, monster kill rewards,
-- turncoat rebirth (TECH_SPEC §4.18 + SPEC_ADDENDUM A6 Neutral; A23-14: resets only Level/XP) and ResetLevel
-- (free class change).
-- Gold is changed ONLY through this service; Level/XP only through AddXP / ResetLevel / rebirth.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "ProgressionService"

local M = {}

-- public signals (created at module load so they exist before any Init)
M.GoldEarned = Util.Signal.new() -- (player, amount, source)
M.LeveledUp = Util.Signal.new() -- (player, newLevel)
M.Rebirthed = Util.Signal.new() -- (player, rebirths, { From, To, Bonus, Mark })
M.LevelReset = Util.Signal.new() -- (player) CR-M6: free class change dropped the player to Lv1 (QuestService remakes extras)

local S = nil

local BANK_TICK = 1 -- seconds between town-bank / auto-bank checks
local WARN_THROTTLE = 10

-- A6: Neutral is a valid rebirth target next to Halo and Horns ("None" never is)
local REBIRTH_TARGETS = { Halo = true, Horns = true, Neutral = true }

local lastAutoBank = {} -- [Player] = os.clock() of the last courier run (or of PlayerReady)
local lastLoopWarn = {} -- [loopName] = os.clock()

------------------------------------------------------------------ helpers
local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default or 0
end

local function loopWarn(loopName, err)
	local now = os.clock()
	local last = lastLoopWarn[loopName]
	if last and now - last < WARN_THROTTLE then return end
	lastLoopWarn[loopName] = now
	Util.Warn(TAG, loopName .. ": " .. tostring(err))
end

local function connectSignal(serviceName, signalName, fn)
	local service = S and S[serviceName]
	local signal = service and service[signalName]
	if type(signal) == "table" and type(signal.Connect) == "function" then
		signal:Connect(fn)
	else
		Util.Warn(TAG, "missing signal " .. serviceName .. "." .. signalName)
	end
end

-- live data table of a READY player, else nil
local function getData(player)
	if S == nil or player == nil then return nil end
	if not S.PlayerService.IsReady(player) then return nil end
	local data = S.PlayerService.GetData(player)
	if type(data) ~= "table" then return nil end
	return data
end

local function getFaction(player)
	local f = S.FactionService.GetFaction(player)
	if type(f) ~= "string" then return "None" end
	return f
end

local function getPerks(player)
	local perks = S.FactionService.GetPerks(player)
	if type(perks) ~= "table" then perks = Config.Factions.None end
	return perks
end

local function getStars(player)
	return num(S.PvPService.GetStars(player))
end

local function hasBlessing(player)
	return S.WarService.HasBlessing(player) == true
end

local function rootPosition(player)
	local root = Util.GetRoot(player)
	if root then return root.Position end
	return nil
end

local function getKaijuState(player)
	local ks = S.KaijuService
	if not ks or type(ks.GetState) ~= "function" then return "None" end
	local ok, state = pcall(ks.GetState, player)
	if ok and type(state) == "string" then return state end
	return "None"
end

local function bullyStacks(player)
	local js = S.JusticeService
	if not js or type(js.GetBullyStacks) ~= "function" then return 0 end
	local ok, stacks = pcall(js.GetBullyStacks, player)
	return ok and num(stacks) or 0
end

-- CR-M2: no combat-log penalty while the server itself is closing
local function isShuttingDown()
	local ps = S.PlayerService
	if not ps or type(ps.IsShuttingDown) ~= "function" then return false end
	local ok, closing = pcall(ps.IsShuttingDown)
	return ok and closing == true
end

------------------------------------------------------------------ multipliers
function M.GetGoldMult(player)
	local data = getData(player)
	if not data then return 1 end
	local perks = getPerks(player)
	local mult = 1
		+ num(perks.GoldBonus)
		+ getStars(player) * Config.PvP.StarGoldBonus
		+ (hasBlessing(player) and Config.War.BlessingGold or 0)
		+ num(data.RebirthBonus)
		+ num(data.FallMarks) * Config.Rebirth.FallGoldPer
	return math.max(0, mult)
end

function M.GetXPMult(player)
	local data = getData(player)
	if not data then return 1 end
	local perks = getPerks(player)
	local mult = 1
		+ num(perks.XPBonus)
		+ (hasBlessing(player) and Config.War.BlessingXP or 0)
		+ num(data.RebirthBonus)
		+ num(data.RedeemMarks) * Config.Rebirth.RedeemXPPer
	return math.max(0, mult)
end

------------------------------------------------------------------ XP / levels
-- raw amount (no multiplier); handles level-ups
function M.AddXP(player, amount)
	amount = math.floor(num(amount))
	if amount <= 0 then return end
	local data = getData(player)
	if not data then return end

	local maxLevel = Config.Levels.MaxLevel
	local startLevel = math.clamp(math.floor(num(data.Level, 1)), 1, maxLevel)
	local level = startLevel
	local xp = math.max(0, num(data.XP)) + amount

	while level < maxLevel do
		local need = Config.XPToNext(level)
		if xp < need then break end
		xp -= need
		level += 1
	end
	if level >= maxLevel then
		level = maxLevel
		xp = math.min(xp, Config.XPToNext(maxLevel))
	end

	if level ~= data.Level then
		S.PlayerService.SetStat(player, "Level", level)
	end
	S.PlayerService.SetStat(player, "XP", xp)

	if level > startLevel then
		-- CR-M16: no full heal mid-fight (e.g. claiming a finished daily during PvP) or as an active kaiju
		local fullHeal = not S.CombatService.IsInCombat(player) and getKaijuState(player) ~= "Active"
		S.PlayerService.RefreshCharacter(player, fullHeal)
		-- CR-L23: the LevelUp Fx already shows the level-up announcement on the owner's screen (no extra toast)
		Net.Fx(nil, "LevelUp", {
			UserId = player.UserId,
			Level = level,
			Pos = rootPosition(player) or Vector3.zero,
		})
		M.LeveledUp:Fire(player, level)
	end
end

-- Level 1, XP 0, full heal (free class change). Gold, bank, weapon, rebirth bonus, marks, tickets, quests are kept
-- (unclaimed quest/vacation rewards are capped to the current level when claimed: QuestService CR-M6).
function M.ResetLevel(player)
	if not getData(player) then return end
	S.PlayerService.SetStat(player, "Level", 1)
	S.PlayerService.SetStat(player, "XP", 0)
	S.PlayerService.RefreshCharacter(player, true)
	M.LevelReset:Fire(player) -- CR-M6
end

------------------------------------------------------------------ gold
function M.AddCarriedGold(player, amount, source)
	amount = math.floor(num(amount))
	if amount <= 0 then return end
	if not getData(player) then return end
	S.PlayerService.AddStat(player, "CarriedGold", amount)
	M.GoldEarned:Fire(player, amount, source or "Other")
end

function M.AddBankGold(player, amount, source)
	amount = math.floor(num(amount))
	if amount <= 0 then return end
	if not getData(player) then return end
	S.PlayerService.AddStat(player, "BankGold", amount)
	M.GoldEarned:Fire(player, amount, source or "Other")
end

-- clamped to [0, carried]; no signal. Returns the amount actually taken.
function M.TakeCarriedGold(player, amount)
	local data = getData(player)
	if not data then return 0 end
	local carried = math.floor(math.max(0, num(data.CarriedGold)))
	local taken = math.clamp(math.floor(num(amount)), 0, carried)
	if taken > 0 then
		S.PlayerService.SetStat(player, "CarriedGold", carried - taken)
	end
	return taken
end

-- carried first, then bank; false = nothing changed
function M.SpendGold(player, amount)
	amount = math.ceil(num(amount, -1))
	if amount < 0 then return false end
	local data = getData(player)
	if not data then return false end
	local carried = math.floor(math.max(0, num(data.CarriedGold)))
	local bank = math.floor(math.max(0, num(data.BankGold)))
	if carried + bank < amount then return false end
	if amount == 0 then return true end
	local fromCarried = math.min(carried, amount)
	local fromBank = amount - fromCarried
	if fromCarried > 0 then
		S.PlayerService.SetStat(player, "CarriedGold", carried - fromCarried)
	end
	if fromBank > 0 then
		S.PlayerService.SetStat(player, "BankGold", bank - fromBank)
	end
	return true
end

function M.GetTotalGold(player)
	local data = getData(player)
	if not data then return 0 end
	return math.max(0, num(data.CarriedGold)) + math.max(0, num(data.BankGold))
end

-- moves every carried coin to the bank; returns the banked amount
function M.BankAll(player, silent)
	local data = getData(player)
	if not data then return 0 end
	local carried = math.floor(math.max(0, num(data.CarriedGold)))
	if carried <= 0 then return 0 end
	S.PlayerService.SetStat(player, "CarriedGold", 0)
	S.PlayerService.AddStat(player, "BankGold", carried)
	if not silent then
		Net.Fx(player, "Bank", { Amount = carried }) -- CR-L23: the Bank Fx shows the only toast
	end
	return carried
end

------------------------------------------------------------------ auto-bank loop body
local function bankTick(player, now)
	local data = getData(player)
	if not data then return end
	local carried = math.floor(math.max(0, num(data.CarriedGold)))

	-- CR-M9: a siren / active kaiju keeps its pouch (the raid pool), even in Crossroads (Town = true)
	local ks = getKaijuState(player)
	if ks == "Siren" or ks == "Active" then return end

	-- towns (every faction's home, incl. Crossroads for Neutral) bank everything
	if S.ZoneService.IsTown(player) then
		if carried > 0 then
			M.BankAll(player, false)
		end
		return
	end

	-- faction courier (Halo: half of the carried gold every 90 s); Neutral/Horns/None have interval 0
	local perks = getPerks(player)
	local interval = num(perks.AutoBankInterval)
	if interval <= 0 then return end
	local last = lastAutoBank[player]
	if last == nil then
		lastAutoBank[player] = now
		return
	end
	if now - last < interval then return end
	lastAutoBank[player] = now

	local amount = math.floor(carried * num(perks.AutoBankFraction))
	if amount <= 0 then return end
	S.PlayerService.SetStat(player, "CarriedGold", carried - amount)
	S.PlayerService.AddStat(player, "BankGold", amount)
	Net.Fx(player, "Bank", { Amount = amount, Courier = true }) -- CR-L23: Fx shows the HaloCourier text (one toast)
end

------------------------------------------------------------------ turncoat rebirth
-- A6: ratios are Halo vs Horns only; Neutral targets always get the normal bonus.
-- CR-L7: counts skip rookies and 120 s idlers (FactionService.GetUnderdogCounts), so Lv1 alts cannot fake an underdog.
local function rebirthBonusFor(player, oldFaction, target)
	if target ~= "Halo" and target ~= "Horns" then
		return Config.Rebirth.BonusNormal
	end
	local fs = S.FactionService
	local halo, horns = nil, nil
	local selfCounted = true
	if type(fs.GetUnderdogCounts) == "function" then
		local ok, h, r = pcall(fs.GetUnderdogCounts)
		if ok and type(h) == "number" and type(r) == "number" then
			halo, horns = h, r
			-- the rebirthing player is active (MarkActive in onRebirthRemote); only a rookie is left out there
			local okR, rookie = pcall(S.PvPService.IsRookie, player)
			selfCounted = not (okR and rookie == true)
		end
	end
	if halo == nil then
		halo, horns = fs.GetCounts()
	end
	halo, horns = math.max(0, num(halo)), math.max(0, num(horns))
	if selfCounted then
		if oldFaction == "Halo" then
			halo = math.max(0, halo - 1)
		elseif oldFaction == "Horns" then
			horns = math.max(0, horns - 1)
		end
	end
	return Config.RebirthBonusFor(target == "Halo" and halo or horns, halo + horns)
end

-- turncoat marks only for Halo <-> Horns switches (A6)
local function markFor(oldFaction, target)
	if oldFaction == "Halo" and target == "Horns" then return "Fall" end
	if oldFaction == "Horns" and target == "Halo" then return "Redeem" end
	return "None"
end

function M.TryRebirth(player, factionId)
	if type(factionId) ~= "string" or not REBIRTH_TARGETS[factionId] then
		return false, nil
	end
	local data = getData(player)
	if not data then return false, nil end

	local rebirths = math.max(0, math.floor(num(data.Rebirths)))
	local needLevel = Config.RebirthLevel(rebirths)
	if num(data.Level, 1) < needLevel then
		return false, string.format(Config.Text.RebirthNeed, needLevel)
	end
	if getStars(player) > 0 then
		return false, string.format(Config.Text.BlockedStars)
	end
	if S.GrudgeService.HasSack(player) then
		return false, string.format(Config.Text.BlockedSack)
	end
	local kaijuState = S.KaijuService.GetState(player)
	if kaijuState ~= nil and kaijuState ~= "None" then
		return false, string.format(Config.Text.BlockedKaiju)
	end
	if S.CombatService.IsInCombat(player) then
		return false, string.format(Config.Text.TravelBlockedCombat)
	end
	-- CR-L9: the guild has no bully stacks, so becoming Neutral would wipe them; wait until they decay
	if factionId == "Neutral" and bullyStacks(player) > 0 then
		return false, string.format(Config.Text.BlockedBully or "깡패 단계가 모두 풀린 뒤에 장인 길드로 갈 수 있어요.")
	end

	local old = getFaction(player)
	local bonus = rebirthBonusFor(player, old, factionId)
	local mark = markFor(old, factionId)
	local pos = rootPosition(player) or Vector3.zero

	-- A23-14 (user 2026-10-05): rebirth resets ONLY the level and its XP. Carried + bank gold, the equipped weapon
	-- (WeaponTier), every owned weapon incl. the legendary (WeaponOwnedMask), per-tier enhancement (WeaponEnhance),
	-- items/materials (Items) and LootFlags are kept untouched (replaces A3-L2 / GDD §9 / A23-4 "reset gold + weapons").
	S.PlayerService.SetStat(player, "Level", 1)
	S.PlayerService.SetStat(player, "XP", 0)

	local newRebirths = rebirths + 1
	S.PlayerService.SetStat(player, "Rebirths", newRebirths)
	S.PlayerService.SetStat(player, "RebirthBonus", math.floor((num(data.RebirthBonus) + bonus) * 100 + 0.5) / 100)

	local markMax = Config.Rebirth.MarkMax
	if mark == "Fall" then
		S.PlayerService.SetStat(player, "FallMarks", math.min(markMax, math.floor(num(data.FallMarks)) + 1))
	elseif mark == "Redeem" then
		S.PlayerService.SetStat(player, "RedeemMarks", math.min(markMax, math.floor(num(data.RedeemMarks)) + 1))
	end

	if factionId ~= old then
		-- a rebirth faction change starts the altar cooldown too, so a player cannot bank the underdog bonus / a
		-- turncoat mark and then switch straight back for free at the altar (rebirth itself still ignores the cooldown)
		S.PlayerService.SetStat(player, "LastSwitchTime", os.time())
		S.FactionService.SetFaction(player, factionId, "Rebirth")
		S.PlayerService.Respawn(player)
	else
		S.PlayerService.RefreshCharacter(player, true)
	end

	Net.Fx(nil, "Rebirth", { UserId = player.UserId, Rebirths = newRebirths, Pos = pos, Mark = mark })
	Net.Notify(player, string.format(Config.Text.RebirthDone, math.floor(bonus * 100 + 0.5)), "reward")
	if mark == "Fall" then
		Net.Notify(player, string.format(Config.Story.Fall), "announce")
	elseif mark == "Redeem" then
		Net.Notify(player, string.format(Config.Story.Redeem), "announce")
	end
	Net.NotifyAll(string.format(Config.Text.RebirthAnnounce, Util.PlayerDisplayName(player), newRebirths))
	M.Rebirthed:Fire(player, newRebirths, { From = old, To = factionId, Bonus = bonus, Mark = mark })
	return true, nil
end

------------------------------------------------------------------ handlers
local function onMonsterKilled(player, info)
	if type(info) ~= "table" or not getData(player) then return end
	local gold = math.floor(num(info.Gold) * M.GetGoldMult(player) + 0.5)
	local xp = math.floor(num(info.XP) * M.GetXPMult(player) + 0.5)
	M.AddCarriedGold(player, gold, "Monster")
	M.AddXP(player, xp)
	S.PlayerService.AddStat(player, "TotalKills", 1)
	local pos = info.Position
	if typeof(pos) ~= "Vector3" then
		pos = rootPosition(player) or Vector3.zero
	end
	Net.Fx(player, "Reward", { Pos = pos, Gold = gold, XP = xp, Golden = info.Golden == true })
end

local function onPlayerReady(player, _data)
	lastAutoBank[player] = os.clock()
	local data = getData(player)
	if data and num(data.CarriedGold) > 0 then
		M.BankAll(player, true) -- leftover from a crash
	end
end

-- fired once BEFORE the final save: mutate the data table directly (attributes no longer matter)
local function onPlayerLeaving(player, data)
	lastAutoBank[player] = nil
	if type(data) ~= "table" then
		data = S.PlayerService.GetData(player)
	end
	if type(data) ~= "table" then return end
	local carried = math.floor(math.max(0, num(data.CarriedGold)))
	-- CR-M2: a server shutdown (update) is not a combat log
	if carried > 0 and S.CombatService.IsInCombat(player) and not isShuttingDown() then
		carried = math.floor(carried * (1 - Config.PvP.CombatLogPenalty))
	end
	data.BankGold = math.max(0, num(data.BankGold)) + carried
	data.CarriedGold = 0
end

local function onRebirthRemote(player, factionId)
	if not S.PlayerService.IsReady(player) then return end
	if type(factionId) ~= "string" then return end
	if not Util.RateLimit(player, "Rebirth", Config.RateLimits.Rebirth) then return end
	if type(S.PlayerService.MarkActive) == "function" then
		S.PlayerService.MarkActive(player) -- CR-L7: pressing rebirth is input, so the player counts as active
	end
	local ok, reason = M.TryRebirth(player, factionId)
	if not ok and reason then
		Net.Notify(player, reason, "bad")
	end
end

------------------------------------------------------------------ lifecycle
function M.Init(registry)
	S = registry
	connectSignal("MonsterService", "MonsterKilled", onMonsterKilled)
	connectSignal("PlayerService", "PlayerReady", onPlayerReady)
	connectSignal("PlayerService", "PlayerLeaving", onPlayerLeaving)
end

function M.Start()
	Net.Get("Rebirth").OnServerEvent:Connect(onRebirthRemote)

	task.spawn(function()
		while true do
			task.wait(BANK_TICK)
			local now = os.clock()
			for _, player in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(bankTick, player, now)
				if not ok then loopWarn("bank loop", err) end
			end
		end
	end)

	print("[ProgressionService] started")
end

return M
]]></ProtectedString>
				<string name="ScriptGuid">{9C3EE836-64B7-4C10-AB2D-8D3B33F9102B}</string>
