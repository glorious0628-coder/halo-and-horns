	-- shared change options (A7-4)
	Selected = "Selected",
	FreeButton = "Change for Free",
	TicketButtonF = "Use a Ticket (you have %d)",
	TicketKeepAll = "Keep everything",
	TicketBuyHint = "You have 0 · after buying, tap again to change",
