				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ClassService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c0500000897</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX49EAC934C2C7495E97AF1AD68056B6CA">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- PvPService.luau : PvP rules (CanAttack, rookie / spawn protection), bully detection, KO outcomes
-- (plunder -> grudge sack, honor, bounty), Wanted stars + bounty, revenge marks and the Most Wanted board.
-- Server only. See TECH_SPEC §4.13 and SPEC_ADDENDUM A6 / A10-V3-3.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "PvPService"

-- (the A3-M3 "under attack while auto-attack is ON" hint is sent by CombatService.DamagePlayer only)
local LOOP_INTERVAL = 1
local PRUNE_INTERVAL = 60 -- seconds between prunes of the bait damage log
local LOOP_WARN_INTERVAL = 10

-- review-fix tuning knobs (grouped to keep the chunk's local count low)
local GUARD = {
	DmgLogMax = 64, -- CR-M15: hits kept per attacker/victim pair (oldest dropped first)
	RecentHitSeconds = 3, -- CR-L4: a non-PvP death without damage this recent (reset / fall) keeps the stars
	KoLogKeep = math.max(1, Config.Bully.RepeatKOs - 1), -- CR-M4: KO times kept per killer/victim pair ({ t1, t2 })
	-- BB10 D2: a pair with no hit for this long starts a new fight (whose first hit decides self-defense)
	EngageGap = 2 * Config.Ranking.DefenseWindowSeconds,
}

-- Most Wanted board lines (TECH_SPEC §4.13 board text)
local BOARD_ROWS = 3 -- BB11: top 3 of each weekly board + the wanted line (texts: Config.Ranking.Text.Board)

local PvPService = {}

PvPService.PlayerKO = Util.Signal.new() -- (killer, victim, info)

local S = nil

-- per-player state (Player keys; cleaned on PlayerLeaving)
local stars = {} -- [Player] = number
local lastStarChange = {} -- [Player] = os.clock()
local protectedUntil = {} -- [Player] = os.clock() (0 = not protected)
local graceUntil = {} -- [Player] = os.clock() end of the A23-18 graduation grace
local wasRookie = {} -- [Player] = last rookie state seen by tickPlayer (graduation edge)
local spawnedAt = {} -- [Player] = os.clock() of the last CharacterSpawned
-- CR-M15: [attacker][victim] = { { T = os.clock(), A = damage }, ... } within Config.Bully.BaitWindow (bait check)
local dmgLog = {}
-- BB10 D2: ["<lo>:<hi>" UserIds] = { By = the player who struck first, T = os.clock() of that hit, Last = of the latest
-- hit either way, A / B = the two players } (a new fight starts after GUARD.EngageGap without a hit)
local engage = {}
local revenge = {} -- [Player] = { Target = Player, Until = os.clock() }

-- CR-M4: pair state (minted KO reward, repeat-KO log, claimed bully bounty) lives in the saved PairCD of the player
-- it belongs to, so a server hop or rejoin cannot reset it (pairReady / logKO below; pruned by PlayerService)

-- anti-farm: the minted bully part of a bounty is paid at most once per victim (any killer) per this window,
-- the time a max-stack bully needs to decay back to clean. Stored in the victim's PairCD as "bully:0".
local BULLY_BOUNTY_COOLDOWN = Config.Bully.DecaySeconds * Config.Bully.MaxStacks

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

-- BB37: every server-wide line names players through AnnounceService.PublicName (hidden -> "<faction> 한 명")
local function publicName(p, honorific)
	local A = S.AnnounceService
	if A and A.PublicName then
		local ok, name = pcall(A.PublicName, p, honorific)
		if ok and type(name) == "string" then return name end
	end
	return Util.PlayerDisplayName(p) .. (honorific and Config.Announce.Text.Honorific or "")
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind)
	if isPlaying(p) then
		Net.Notify(p, text, kind)
	end
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function faction(p)
	return S.FactionService.GetFaction(p)
end

-- only Halo and Horns ever take part in PvP ("Neutral" and "None" never do; addendum A6)
local function isFighter(f)
	return f == "Halo" or f == "Horns"
end

local function kstate(p)
	local kaiju = S.KaijuService
	if kaiju and kaiju.GetState then
		return kaiju.GetState(p) or "None"
	end
	return "None"
end

-- persisted stat: live data table first, mirrored attribute as fallback
local function num(p, key, default)
	local data = S.PlayerService.GetData(p)
	local v = data and data[key]
	if v == nil then
		v = p:GetAttribute(key)
	end
	return tonumber(v) or default
end

local function bullyStacksOf(p)
	return tonumber(S.JusticeService.GetBullyStacks(p)) or 0
end

local function classOf(p)
	local C = S.ClassService
	return (C and C.GetClass and C.GetClass(p)) or "Warrior"
end

-- CR-M4: pair cooldown kept in the holder's saved PairCD ("<kind>:<otherUserId>" = os.time()). PlayerService.PairReady
-- owns it; the inline copy follows the same contract. commit = false only checks. No data -> false (no reward).
local function pairReady(holder, otherUserId, kind, cooldown, commit)
	if not holder then
		return false
	end
	local PS = S.PlayerService
	if PS.PairReady then
		local ok, res = pcall(PS.PairReady, holder, otherUserId, kind, cooldown, commit)
		return ok and res == true
	end
	local d = PS.GetData(holder)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = kind .. ":" .. tostring(otherUserId)
	local t = os.time()
	if t - (tonumber(d.PairCD[k]) or 0) < cooldown then
		return false
	end
	if commit ~= false then
		d.PairCD[k] = t
	end
	return true
end

-- CR-M4: the killer's recent KO times on this victim live in the killer's PairCD as "kolog:<victimUserId>" =
-- { t1, t2 } (os.time, oldest first). Records this KO; true when it is the RepeatKOs-th within RepeatWindow.
local function logKO(killer, victim)
	local B = Config.Bully
	local d = S.PlayerService.GetData(killer)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = "kolog:" .. tostring(victim.UserId)
	local t = os.time()
	local times = {}
	local old = d.PairCD[k]
	if type(old) == "table" then
		for _, v in old do
			local x = tonumber(v)
			if x and t - x <= B.RepeatWindow then
				table.insert(times, x)
			end
		end
		table.sort(times)
	end
	table.insert(times, t)
	local repeated = #times >= B.RepeatKOs
	while #times > GUARD.KoLogKeep do
		table.remove(times, 1)
	end
	d.PairCD[k] = times
	return repeated
end

-- bully stacks that still carry a bounty: 0 while this bully's bounty was already claimed (BULLY_BOUNTY_COOLDOWN,
-- the victim's PairCD "bully:0"). The stacks themselves (size / damage penalty, "깡패" tag) stay with JusticeService.
-- A23-23 D3: this week's outlaw counts as (at least) one bully stack for the bounty (Config.Bounty: units >= 1 and
-- x BountyMult once, so bully + outlaw is still at most x2), with the same claim cooldown.
local function bountyBullyStacks(p)
	local n = bullyStacksOf(p)
	if p:GetAttribute("Outlaw") == true then n = math.max(n, 1) end
	if n <= 0 or not pairReady(p, 0, "bully", BULLY_BOUNTY_COOLDOWN, false) then
		return 0
	end
	return n
end

-- marks this bully's bounty as claimed (by any killer) for BULLY_BOUNTY_COOLDOWN
local function claimBullyBounty(p)
	pairReady(p, 0, "bully", 0)
end

-- CR-L5: weak-victim check power WITHOUT the rebirth bonus (that bonus is gold / XP only)
local function combatPower(p)
	local J = S.JusticeService
	if J and J.GetCombatPower then
		local ok, v = pcall(J.GetCombatPower, p)
		if ok and type(v) == "number" then
			return v
		end
	end
	local level = math.max(1, num(p, "Level", 1))
	local tier = math.clamp(math.floor(num(p, "WeaponTier", 0)), 0, Config.MaxWeaponTier) -- A23-34: 0 = bare hands
	-- review B5: the equipped scroll +N counts. Read the attribute directly: data.WeaponEnhance is the per-tier table.
	return Config.CombatPower(level, tier, tonumber(p:GetAttribute("WeaponEnhance")) or 0) -- BB4 (same as Justice)
end

-- A23-18 boldness: x2 vs a much stronger victim, x0.5 vs a much weaker one (honor / infamy / war points only)
function PvPService.BoldMult(killer, victim)
	local P = Config.PvP
	local mine, theirs = combatPower(killer), combatPower(victim)
	if type(mine) ~= "number" or type(theirs) ~= "number" or mine ~= mine or theirs ~= theirs or mine <= 0 then return 1 end
	local ratio = theirs / mine
	if ratio >= P.BoldStrongRatio then return P.BoldStrongMult end
	if ratio < P.BoldWeakRatio then return P.BoldWeakMult end
	return 1
end

-- integer points x mult with fair rounding (x0.5 of 1 point = 50% chance of 1), so weak KOs still average half
function PvPService.ScalePoints(points, mult)
	local v = (tonumber(points) or 0) * (tonumber(mult) or 1)
	local whole = math.floor(v)
	if Util.Random:NextNumber() < v - whole then whole += 1 end
	return whole
end

-- addendum A10-V3-3: inside a PvP zone, or combat-tagged (Config.PvP.CombatTagTime) anywhere outside a town
-- (Outskirts, bridges, safe hunting land), so a fight or a sack chase does not end at a zone edge
local function inPvP(p)
	return S.ZoneService.IsPvPZone(p) or (not S.ZoneService.IsTown(p) and S.CombatService.IsInCombat(p))
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

-- CR-M15: remove every hit with T < cutoff from an ascending dmgLog list
local function pruneHits(hits, cutoff)
	while hits[1] ~= nil and hits[1].T < cutoff do
		table.remove(hits, 1)
	end
end

-- CR-M15: total damage `attacker` dealt to `victim` within Config.Bully.BaitWindow
local function recentDamage(attacker, victim, now)
	local byVictim = dmgLog[attacker]
	local hits = byVictim and byVictim[victim]
	if not hits then
		return 0
	end
	local sum = 0
	for _, h in hits do
		if now - h.T <= Config.Bully.BaitWindow then
			sum += h.A
		end
	end
	return sum
end

local function engageKey(a, b)
	return tostring(math.min(a.UserId, b.UserId)) .. ":" .. tostring(math.max(a.UserId, b.UserId))
end

-- BB10 D2 self-defense (never an unfair KO): the current fight between the two began with the victim's hit and the KO
-- landed within Config.Ranking.DefenseWindowSeconds of that first hit
local function victimStruckFirst(victim, killer, now)
	local e = engage[engageKey(victim, killer)]
	return e ~= nil and now - e.Last <= GUARD.EngageGap and e.By == victim
		and now - e.T <= Config.Ranking.DefenseWindowSeconds
end

-- BB37 (검수): the bounty line; a hidden knight is "빛의 기사단 한 명" already, so the hidden line has no faction prefix
local function bountyLine(p, bounty)
	local A = S.AnnounceService
	local okHidden, hidden = false, false
	if A and A.IsHidden then okHidden, hidden = pcall(A.IsHidden, p) end
	if not okHidden then hidden = p:GetAttribute("HideAnnounceName") == true end
	return fmt(hidden == true and "BountyAnnounceHidden" or "BountyAnnounce", publicName(p, true), Util.FormatNumber(bounty))
end

-- BB10: the ranking verdict of one PvP KO ({ Fair, Unfair?, Exempt?, Reason? }; { Fair = false } without RankingService)
local function judgeKO(killer, victim, facts)
	local R = S.RankingService
	if R and R.JudgeKO then
		local ok, v = pcall(R.JudgeKO, killer, victim, facts)
		if ok and type(v) == "table" then return v end
		if not ok then Util.Warn(TAG, "JudgeKO: " .. tostring(v)) end
	end
	return { Fair = false }
end

-- BB10: Honor / Infamy from PvP go through PlayerService.GrantFame (the stat + the fair weekly board points)
local function grantFame(p, stat, n, verdict, victim)
	S.PlayerService.GrantFame(p, stat, n, { PvP = true, Fair = verdict.Fair == true, Victim = victim })
end

local function computeBounty(p)
	if not isFighter(faction(p)) then
		return 0
	end
	return Config.Bounty(num(p, "Level", 1), stars[p] or 0, bountyBullyStacks(p))
end

local function refreshStarAttrs(p)
	if not isPlaying(p) then
		return
	end
	setAttr(p, "WantedStars", stars[p] or 0)
	setAttr(p, "Bounty", computeBounty(p))
end

-- the newbie PvP shield is meaningless for Neutral (never in PvP at all; addendum A6)
local function rookieAttr(p)
	return faction(p) ~= "Neutral" and PvPService.IsRookie(p)
end

local function announceIfMostWanted(p, before, after)
	if before < Config.PvP.AnnounceStars and after >= Config.PvP.AnnounceStars then
		Net.NotifyAll(fmt("MostWanted", publicName(p, true), Util.FormatNumber(computeBounty(p))))
	end
end

local function addStar(killer)
	local before = stars[killer] or 0
	local after = math.min(Config.PvP.MaxStars, before + 1)
	stars[killer] = after
	lastStarChange[killer] = os.clock()
	refreshStarAttrs(killer)
	announceIfMostWanted(killer, before, after)
end

local function destroyForceFields(p)
	local character = p.Character
	if not character then
		return
	end
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
end

local function clearRevenge(p)
	revenge[p] = nil
	if isPlaying(p) then
		setAttr(p, "RevengeTargetId", 0)
		setAttr(p, "RevengeUntil", 0)
	end
end

-- clears p's own revenge mark and every other player's mark that targets p
local function clearRevengeInvolving(p)
	local holders = {}
	for holder, r in revenge do
		if holder == p or r.Target == p then
			table.insert(holders, holder)
		end
	end
	for _, holder in holders do
		clearRevenge(holder)
	end
end

------------------------------------------------------------------ public API
function PvPService.GetStars(player)
	return (player and stars[player]) or 0
end

function PvPService.ResetStars(player)
	if not player then
		return
	end
	stars[player] = 0
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
end

function PvPService.DebugSetStars(player, n)
	if not isPlaying(player) then
		return
	end
	local before = stars[player] or 0
	local after = math.clamp(math.floor(tonumber(n) or 0), 0, Config.PvP.MaxStars)
	stars[player] = after
	lastStarChange[player] = os.clock()
	refreshStarAttrs(player)
	announceIfMostWanted(player, before, after)
end

-- Rebirths == 0 and (Level < RookieLevel or PlaytimeSeconds < RookiePlaytime)
function PvPService.IsRookie(player)
	if not player then
		return false
	end
	if num(player, "Rebirths", 0) ~= 0 then
		return false
	end
	return num(player, "Level", 1) < Config.PvP.RookieLevel
		or num(player, "PlaytimeSeconds", 0) < Config.PvP.RookiePlaytime
end

-- A23-18 graduation grace (review of c08c382): started on the rookie -> graduate edge for Halo / Horns only, saved as
-- an absolute time (data.GraduateGraceUntil) so a rejoin keeps the rest; checked lazily wherever PvP damage is decided
local function startGrace(p, seconds)
	if seconds <= 0 then return end
	graceUntil[p] = os.clock() + seconds
	local data = S.PlayerService.GetData(p)
	if type(data) == "table" then data.GraduateGraceUntil = os.time() + math.ceil(seconds) end
	setAttr(p, "GraduateGraceUntil", Util.Now() + seconds)
end

local function checkGraduation(p)
	if not isPlaying(p) then return end
	local isRookie = PvPService.IsRookie(p)
	local f = faction(p)
	if wasRookie[p] == true and not isRookie and (f == "Halo" or f == "Horns") and not graceUntil[p] then
		startGrace(p, Config.PvP.GraduateGraceSeconds)
		notify(p, fmt("GraduateStart"), "reward")
	end
	wasRookie[p] = isRookie
end

function PvPService.InGrace(p)
	if not p then return false end
	checkGraduation(p) -- closes the up-to-1 s gap before the next tick
	return (graceUntil[p] or 0) > os.clock()
end

-- rookie shield or graduation grace: no PvP damage either way (CanAttack, kaiju stomp)
function PvPService.IsShielded(p)
	return PvPService.IsRookie(p) or PvPService.InGrace(p)
end

function PvPService.HasRevenge(attacker, victim)
	local r = attacker and revenge[attacker]
	return r ~= nil and victim ~= nil and r.Target == victim and os.clock() < r.Until
end

function PvPService.Protect(player, seconds)
	if not isPlaying(player) then
		return
	end
	seconds = tonumber(seconds) or 0
	if seconds <= 0 then
		return
	end
	local character = player.Character
	if character and character.Parent and not character:FindFirstChildOfClass("ForceField") then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = character
	end
	protectedUntil[player] = math.max(protectedUntil[player] or 0, os.clock() + seconds)
	setAttr(player, "Protected", true)
end

function PvPService.BreakProtection(player)
	if not player then
		return
	end
	-- cheap early-out: CombatService calls this after every PvP hit
	if (protectedUntil[player] or 0) == 0 and player:GetAttribute("Protected") ~= true then
		return
	end
	protectedUntil[player] = 0
	destroyForceFields(player)
	if isPlaying(player) then
		setAttr(player, "Protected", false)
	end
end

-- (allowed: boolean, reasonKey: string?)
function PvPService.CanAttack(attacker, victim)
	if attacker == nil or victim == nil or attacker == victim then
		return false, "Self"
	end
	local PS = S.PlayerService
	if not PS.IsReady(attacker) or not PS.IsReady(victim) then
		return false, "NotReady"
	end
	if not Util.IsAlive(attacker) or not Util.IsAlive(victim) then
		return false, "Dead"
	end
	local fa, fv = faction(attacker), faction(victim)
	if fa == "Neutral" or fv == "Neutral" then
		return false, "Neutral" -- addendum A6: Neutral never hits / is hit by players, anywhere
	end
	if not isFighter(fa) or not isFighter(fv) or fa == fv then
		return false, "SameFaction"
	end
	-- kaiju exception: Halo may hit the Active kaiju in any zone (rookies allowed, protection ignored)
	if fa == "Halo" and kstate(victim) == "Active" then
		return true, nil
	end
	if not inPvP(attacker) or not inPvP(victim) then
		return false, "SafeZone"
	end
	if PvPService.IsRookie(attacker) or PvPService.IsRookie(victim) then
		return false, "Rookie"
	end
	if PvPService.InGrace(attacker) or PvPService.InGrace(victim) then
		return false, "Rookie" -- A23-18: 60 s graduation grace, both ways
	end
	if victim:GetAttribute("Protected") == true then
		return false, "Protected"
	end
	return true, nil
end

-- called ONLY by CombatService's death pipeline (no kill credit: monster, fall, reset)
function PvPService.HandleNonPvPDeath(victim)
	if not victim then
		return
	end
	if (stars[victim] or 0) >= 1 then
		-- CR-L4: a death in town or without damage in the last few seconds (reset, fall) keeps the stars and bounty:
		-- carried gold is 0 in town, so a reset there would otherwise wipe them for free
		local lastHit = tonumber(S.CombatService.GetLastDamagedAt(victim)) or 0
		if S.ZoneService.IsTown(victim) == true or os.clock() - lastHit > GUARD.RecentHitSeconds then
			return
		end
		local carried = num(victim, "CarriedGold", 0)
		local loss = math.floor(carried * Config.PvP.VillainLossOnWantedPvEDeath)
		if loss > 0 then
			S.ProgressionService.TakeCarriedGold(victim, loss)
		end
	end
	PvPService.ResetStars(victim)
end

-- called ONLY by CombatService's death pipeline (after GrudgeService.OnCarrierDown). ctx = { HadSack = the victim
-- carried a grudge sack when it fell (seen before step 1 of the pipeline closed it) }
function PvPService.HandleKO(victim, killer, ctx)
	if not victim then
		return
	end
	if killer == nil or killer == victim or not isPlaying(killer) then
		PvPService.HandleNonPvPDeath(victim)
		return
	end
	local fk, fv = faction(killer), faction(victim)
	if not isFighter(fk) or not isFighter(fv) or fk == fv then
		-- defensive: Neutral / None / same-faction deaths are never PvP KOs (addendum A6)
		PvPService.HandleNonPvPDeath(victim)
		return
	end

	local P = Config.PvP
	local B = Config.Bully
	local Justice = S.JusticeService
	local Progression = S.ProgressionService
	-- the KO's own time (the death pipeline may wait for the friend answer; a respawn after it is not "fresh")
	local now = (type(ctx) == "table" and tonumber(ctx.At)) or os.clock()

	-- 1. snapshot + KO log (CR-M4: the log is kept in the killer's save)
	local starsBefore = stars[victim] or 0
	local bullyBefore = bullyStacksOf(victim)
	-- the victim's bully stacks that still pay a bounty (0 once claimed; anti-farm, see BULLY_BOUNTY_COOLDOWN)
	local bountyBully = bountyBullyStacks(victim)
	local repeated = logKO(killer, victim)

	-- 2. bully check (any faction pairing)
	local weak = combatPower(victim) < B.WeakPowerRatio * combatPower(killer) -- CR-L5
	-- CR-M15: bait = the victim dealt >= BaitMinPct of the killer's base MaxHealth to the killer within BaitWindow
	local baitNeed = (B.BaitMinPct or 0.2) * Config.MaxHealth(num(killer, "Level", 1), fk, classOf(killer))
	local baitDealt = recentDamage(victim, killer, now)
	local baited = baitDealt > 0 and baitDealt >= baitNeed
	if weak and baited then
		weak = false -- anti-bait: the victim attacked the killer first
	end
	local victimOutlaw = victim:GetAttribute("Outlaw") == true -- A23-23: an outlaw is hunted like a bully
	if weak and B.WantedIgnoresWeakRule and (starsBefore > 0 or bullyBefore > 0 or victimOutlaw) then
		weak = false
	end
	local spawned = spawnedAt[victim]
	local fresh = spawned ~= nil and spawned <= now and now - spawned < B.FreshSpawnSeconds
	local bully = weak or fresh or repeated
	-- CR-M14: a fresh / repeat KO of a victim who baited the killer is self-defense (no bully stack, no rewards),
	-- and a kaiju never becomes a bully (that would double its kaiju pool)
	local defense = baited and (fresh or repeated)
	if defense or kstate(killer) ~= "None" then
		bully = false
	end

	-- BB10 / A23-23: the weekly ranking verdict, decided before the revenge marks below change. A fair KO (PvPCreditOK)
	-- lets the Honor / Infamy below reach the weekly board; an unfair one (weak / idle / new / 4th of the week / fresh)
	-- that no exemption covers adds 1 to the killer's PvP board inside JudgeKO. Never yields: the death pipeline already
	-- asked IsFriendsWith (RankingService.ResolveFriends), so JudgeKO reads the friend cache only (NoYield).
	local bold = PvPService.BoldMult(killer, victim) -- A23-18: honor / infamy / war points only
	local killerMark = revenge[killer]
	local verdict = judgeKO(killer, victim, {
		Bold = bold, Fresh = fresh, Repeated = repeated,
		Defense = defense or victimStruckFirst(victim, killer, now),
		Revenge = killerMark ~= nil and killerMark.Target == victim and now < killerMark.Until,
		VictimWanted = starsBefore > 0, VictimBully = bullyBefore > 0, VictimOutlaw = victimOutlaw,
		VictimKaiju = kstate(victim) ~= "None", KillerKaiju = kstate(killer) == "Active", -- D2: a killer who IS a kaiju
		VictimHadSack = type(ctx) == "table" and ctx.HadSack == true, NoYield = true,
	})

	-- 3. revenge (always)
	revenge[victim] = { Target = killer, Until = now + Config.Revenge.Duration }
	setAttr(victim, "RevengeTargetId", killer.UserId)
	setAttr(victim, "RevengeUntil", Util.Now() + Config.Revenge.Duration)
	notify(victim, fmt("Revenge", Util.PlayerDisplayName(killer)), "info")
	local killerRevenge = revenge[killer]
	if killerRevenge and killerRevenge.Target == victim then
		local wasActive = now < killerRevenge.Until
		clearRevenge(killer)
		if wasActive then
			notify(killer, fmt("RevengeDone"), "good")
		end
	end

	local info
	if defense then
		-- CR-M14: self-defense KO: no bully stack, stars, plunder, honor/infamy, bounty or war points
		info = { Kind = "Defense", Bully = false, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	elseif bully then
		-- 4. bully KO: no plunder, stars, honor/infamy, bounty or war points
		local n = math.floor(tonumber(Justice.AddBullyStack(killer)) or 0)
		notify(killer, fmt("BullyKO", n), "bad")
		notify(victim, fmt("BullyVictim"), "info")
		refreshStarAttrs(killer) -- bounty doubles while a bully
		info = { Kind = "Bully", Bully = true, VictimStars = starsBefore, Stolen = 0, Bounty = 0, Rewarded = false }
	else
		-- 5. pair cooldown for minted rewards (CR-M4: kept in the killer's save as "ko:<victimUserId>")
		local pairOk = pairReady(killer, victim.UserId, "ko", P.PairRewardCooldown)
		if pairOk and bold > 1 then notify(killer, fmt("BoldStrong"), "reward")
		elseif pairOk and bold < 1 then notify(killer, fmt("BoldWeak"), "info") end
		local vLevel = num(victim, "Level", 1)

		if fk == "Horns" then
			-- 6a. Horns KO Halo: plunder into the grudge sack
			if pairOk then
				addStar(killer) -- CR-M3: a farmed pair (inside the cooldown) adds no star
			end
			local stolen = 0
			if not S.GrudgeService.CanSteal(killer, victim) then
				notify(killer, fmt("PlunderTooSoon"), "info")
			else
				local carried = num(victim, "CarriedGold", 0)
				local safeFloor = P.SafeFloorPerLevel * vLevel
				stolen = math.min(math.floor(math.max(0, carried - safeFloor) * P.PlunderRate), P.PlunderCapPerLevel * vLevel)
				if stolen > 0 then
					stolen = math.floor(tonumber(Progression.TakeCarriedGold(victim, stolen)) or 0)
				end
				if stolen > 0 then
					-- A23-18 boldness; BB10: the sack also carries the fair weekly points (paid only if the thief keeps it)
					local inf = pairOk and PvPService.ScalePoints(1, bold) or 0
					local rankPts = verdict.Fair == true and inf or 0
					S.GrudgeService.AddToSack(killer, victim, stolen, inf, rankPts)
					if rankPts > 0 and S.RankingService and S.RankingService.CommitFair then
						pcall(S.RankingService.CommitFair, killer, victim)
					end
					local from, to = rootPos(victim), rootPos(killer)
					if from and to then
						Net.Fx(nil, "Plunder", { From = from, To = to, Amount = stolen })
					end
					notify(victim, fmt("Plundered", Util.PlayerDisplayName(killer), Util.FormatNumber(stolen)), "bad")
					notify(killer, fmt("PlunderGain", Util.FormatNumber(stolen), stars[killer] or 0), "reward")
				end
			end
			if stolen == 0 and pairOk then
				local inf = PvPService.ScalePoints(1, bold) -- A23-18 boldness
				if inf > 0 then grantFame(killer, "Infamy", inf, verdict, victim) end -- no sack to carry it
			end
			local bullyBounty = 0
			if bountyBully > 0 and pairOk then
				bullyBounty = Config.Bounty(vLevel, 0, bountyBully)
				if bullyBounty > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
					Progression.AddBankGold(killer, bullyBounty, "Bounty")
					notify(killer, fmt("BullyBountyGain", Util.FormatNumber(bullyBounty)), "reward")
				end
			end
			info = {
				Kind = "Plunder", Bully = false, VictimStars = starsBefore,
				Stolen = stolen, Bounty = bullyBounty, Rewarded = pairOk, BoldMult = bold,
			}
		elseif starsBefore == 0 and bountyBully == 0 then
			-- 6b. Halo KO a clean Horns (or a bully whose bounty was already claimed): honor
			if pairOk then
				local honor = PvPService.ScalePoints(P.HonorPerKOMin, bold) -- A23-18 boldness
				if honor > 0 then
					grantFame(killer, "Honor", honor, verdict, victim)
					notify(killer, fmt("HonorGain", honor), "reward")
				end
			end
			info = { Kind = "Honor", Bully = false, VictimStars = 0, Stolen = 0, Bounty = 0, Rewarded = pairOk, BoldMult = bold }
		else
			-- 6c. Halo KO a Wanted (or bully) Horns: bounty
			local bounty = pairOk and Config.Bounty(vLevel, starsBefore, bountyBully) or 0
			if bounty > 0 then
				if bountyBully > 0 then
					claimBullyBounty(victim) -- claimed: no bully bounty on this victim for any killer for a while
				end
				Progression.AddBankGold(killer, bounty, "Bounty")
			end
			local honor = pairOk and PvPService.ScalePoints(math.max(1, starsBefore), bold) or 0 -- A23-18 boldness
			if honor > 0 then
				grantFame(killer, "Honor", honor, verdict, victim)
			end
			if starsBefore > 0 then
				local carried = num(victim, "CarriedGold", 0)
				local loss = math.floor(carried * P.VillainLossOnBountyKO)
				if loss > 0 then
					Progression.TakeCarriedGold(victim, loss)
				end
			end
			if bounty > 0 or honor > 0 then
				notify(killer, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
			end
			if starsBefore >= P.GlowStars and bounty > 0 then
				Net.NotifyAll(bountyLine(killer, bounty))
			end
			info = {
				Kind = "Bounty", Bully = false, VictimStars = starsBefore,
				Stolen = 0, Bounty = bounty, Rewarded = pairOk, BoldMult = bold,
			}
		end
	end

	-- 7. victim's stars are gone; tell everyone
	PvPService.ResetStars(victim)
	PvPService.PlayerKO:Fire(killer, victim, info)
end

------------------------------------------------------------------ board
-- RichText-safe player text on the board (nicknames are validated, Roblox names too; escaped anyway)
local function boardEsc(text)
	return (string.gsub(tostring(text), "[&<>\"]", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;" }))
end

-- BB11 (검수 2026-10-06): the crossroads board shows THIS server's weekly boards (Honor / Infamy / Artisan / PvP, the
-- same numbers as the ranking window, ties share a rank) and one wanted line. Names through PublicName; the red outlaw
-- tag only for players who ARE outlaws this week (shown even when the name is hidden, A23-23).
local function updateBoard()
	local ok, label = pcall(function()
		return S.MapBuilder.GetBoardLabel()
	end)
	if not ok or not label then
		return
	end
	local T = Config.Ranking.Text.Board
	local outlawTag = ' <font color="#FF4A4A">' .. Config.Ranking.Text.OutlawTag .. "</font>"
	local R = S.RankingService
	local lines = { T.Header }
	for _, board in Config.Ranking.Order do
		local rows = {}
		if R and R.ServerTop then
			local okTop, top = pcall(R.ServerTop, board, BOARD_ROWS)
			if okTop and type(top) == "table" then rows = top end
		end
		local parts = {}
		for _, row in rows do
			local text = string.format(T.Row, row.Rank, boardEsc(row.Name), Util.FormatNumber(row.Value))
			if row.Outlaw then text ..= outlawTag end
			table.insert(parts, text)
		end
		table.insert(lines, "<b>" .. T.Titles[board] .. "</b>  " .. (#parts > 0 and table.concat(parts, T.Sep) or T.Empty))
	end

	local wanted = {}
	for _, p in S.PlayerService.GetReadyPlayers() do
		local bounty = tonumber(p:GetAttribute("Bounty")) or 0
		if bounty > 0 then
			table.insert(wanted, { P = p, Name = publicName(p), Bounty = bounty, Stars = stars[p] or 0, Bully = bullyStacksOf(p) })
		end
	end
	table.sort(wanted, function(a, b)
		if a.Bounty ~= b.Bounty then
			return a.Bounty > b.Bounty
		end
		return a.P.UserId < b.P.UserId
	end)
	local parts = {}
	for i = 1, math.min(BOARD_ROWS, #wanted) do
		local w = wanted[i]
		local text = string.format("%d. %s", i, boardEsc(w.Name))
		if w.Stars > 0 then
			text ..= " " .. string.rep("★", w.Stars)
		end
		text ..= " " .. Util.FormatNumber(w.Bounty) .. T.Gold
		if w.Bully > 0 then
			text ..= " " .. T.Bully
		end
		if w.P:GetAttribute("Outlaw") == true then text ..= outlawTag end
		table.insert(parts, text)
	end
	table.insert(lines, "<b>" .. T.Wanted .. "</b>  " .. (#parts > 0 and table.concat(parts, T.Sep) or T.Empty))

	local text = table.concat(lines, "\n")
	if label.RichText ~= true then label.RichText = true end
	if label.Text ~= text then
		label.Text = text
	end
end

------------------------------------------------------------------ loops
local function tickPlayer(p, now)
	-- protection expiry
	local pu = protectedUntil[p]
	if pu and pu > 0 and now >= pu then
		protectedUntil[p] = 0
		destroyForceFields(p)
		setAttr(p, "Protected", false)
	end

	-- star decay: one star per StarDecaySeconds, paused while queued / siren / active kaiju
	local s = stars[p] or 0
	if s > 0 then
		if kstate(p) ~= "None" then
			lastStarChange[p] = now
		elseif now - (lastStarChange[p] or now) >= Config.PvP.StarDecaySeconds then
			stars[p] = s - 1
			lastStarChange[p] = now
		end
	end
	refreshStarAttrs(p)
	checkGraduation(p)
	if graceUntil[p] and now >= graceUntil[p] then
		graceUntil[p] = nil
		local data = S.PlayerService.GetData(p)
		if type(data) == "table" then data.GraduateGraceUntil = 0 end
		setAttr(p, "GraduateGraceUntil", 0)
		notify(p, fmt("GraduateEnd"), "info")
	end
	setAttr(p, "Rookie", rookieAttr(p))

	-- revenge expiry
	local r = revenge[p]
	if r and (now >= r.Until or not isPlaying(r.Target)) then
		clearRevenge(p)
	end
end

-- CR-M15: drop bait-log hits older than BaitWindow (pair state itself is in the saves, CR-M4); BB10: finished fights
local function pruneDmgLog(now)
	for key, e in engage do
		if now - e.Last > GUARD.EngageGap then engage[key] = nil end
	end
	local cutoff = now - Config.Bully.BaitWindow
	for attacker, byVictim in dmgLog do
		for victim, hits in byVictim do
			pruneHits(hits, cutoff)
			if #hits == 0 then
				byVictim[victim] = nil
			end
		end
		if next(byVictim) == nil then
			dmgLog[attacker] = nil
		end
	end
end

-- CR-M12: stars saved at leave come back on the next join minus the decay for the time away, capped below the kaiju
-- threshold. Clears the saved fields. Returns (stars, seconds already spent toward the next decay step).
local function takeSavedStars(player, data)
	if type(data) ~= "table" then
		return 0, 0
	end
	local saved = math.floor(tonumber(data.SavedStars) or 0)
	local at = tonumber(data.SavedStarsAt) or 0
	data.SavedStars = 0
	data.SavedStarsAt = 0
	if saved <= 0 or at <= 0 or not isFighter(faction(player)) then
		return 0, 0
	end
	local step = math.max(1, Config.PvP.StarDecaySeconds)
	local away = math.max(0, os.time() - at)
	local decayed = math.floor(away / step)
	local needed = (Config.Kaiju and Config.Kaiju.StarsNeeded) or Config.PvP.MaxStars
	local cap = math.max(0, math.min(Config.PvP.MaxStars, needed - 1))
	local n = math.clamp(saved - decayed, 0, cap)
	return n, away - decayed * step
end

-- CR-M11: a Wanted Horns logging out while combat-tagged pays the bounty (+ honor, like a bounty KO) to the last Halo
-- attacker, once per pair per PairRewardCooldown. Returns true when paid (the stars count as claimed).
local function payLeaveBounty(player)
	-- CR-M11 / CR-M2: a server shutdown is not the player's choice; keep the stars (saved by CR-M12) instead
	local PS = S.PlayerService
	if PS and type(PS.IsShuttingDown) == "function" then
		local okS, closing = pcall(PS.IsShuttingDown)
		if okS and closing == true then
			return false
		end
	end
	local s = stars[player] or 0
	if s < 1 or faction(player) ~= "Horns" or kstate(player) == "Active" then
		return false -- an Active kaiju's logout is resolved by KaijuService
	end
	local C = S.CombatService
	if not C.IsInCombat(player) then
		return false
	end
	local a = C.GetLastPvPAttacker(player)
	if a == nil or a == player or not isPlaying(a) or not S.PlayerService.IsReady(a) or faction(a) ~= "Halo" then
		return false
	end
	if not pairReady(a, player.UserId, "ko", Config.PvP.PairRewardCooldown) then
		return false
	end
	local bully = bountyBullyStacks(player) -- 0 when this bully's bounty was already claimed
	local bounty = Config.Bounty(num(player, "Level", 1), s, bully)
	local bold = PvPService.BoldMult(a, player)
	local honor = PvPService.ScalePoints(math.max(1, s), bold) -- A23-18 boldness (same as a KO)
	-- BB10: judged like a KO with the leaver as the victim (their data is still loaded here); Wanted = never unfair
	local lastMark = revenge[a]
	local verdict = judgeKO(a, player, {
		Bold = bold, Fresh = false, Repeated = false, Defense = victimStruckFirst(player, a, os.clock()),
		Revenge = lastMark ~= nil and lastMark.Target == player and os.clock() < lastMark.Until,
		VictimWanted = true, VictimBully = bully > 0, VictimOutlaw = player:GetAttribute("Outlaw") == true,
		VictimKaiju = kstate(player) ~= "None", KillerKaiju = kstate(a) == "Active", VictimHadSack = false,
		NoYield = true, -- a PlayerLeaving handler: no web call (friends cache only)
	})
	if bounty > 0 then
		if bully > 0 then
			claimBullyBounty(player)
		end
		S.ProgressionService.AddBankGold(a, bounty, "Bounty")
	end
	if honor > 0 then grantFame(a, "Honor", honor, verdict, player) end
	notify(a, fmt("BountyGain", Util.FormatNumber(bounty), honor), "reward")
	if s >= Config.PvP.GlowStars and bounty > 0 then
		Net.NotifyAll(bountyLine(a, bounty))
	end
	return true
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player, data)
	-- CR-M12: bring back the stars saved at the last leave (decayed); failures just start clean
	local okSaved, restored, partial = pcall(takeSavedStars, player, data or S.PlayerService.GetData(player))
	if not okSaved then
		Util.Warn(TAG, "saved stars restore failed: " .. tostring(restored))
		restored, partial = 0, 0
	end
	stars[player] = restored
	lastStarChange[player] = os.clock() - (restored > 0 and partial or 0)
	protectedUntil[player] = 0
	player:SetAttribute("WantedStars", 0)
	player:SetAttribute("Bounty", 0)
	player:SetAttribute("Rookie", rookieAttr(player))
	wasRookie[player] = PvPService.IsRookie(player) -- graduation edge starts from the loaded state
	local saved = tonumber(type(data) == "table" and data.GraduateGraceUntil or 0) or 0
	if saved > os.time() then
		startGrace(player, saved - os.time()) -- a rejoin keeps the rest of the 60 s grace
	else
		player:SetAttribute("GraduateGraceUntil", 0)
	end
	player:SetAttribute("Protected", false)
	player:SetAttribute("RevengeTargetId", 0)
	player:SetAttribute("RevengeUntil", 0)
	if restored > 0 then
		refreshStarAttrs(player)
	end
end

local function cleanupPlayer(player)
	clearRevengeInvolving(player)
	stars[player] = nil
	lastStarChange[player] = nil
	protectedUntil[player] = nil
	spawnedAt[player] = nil
	revenge[player] = nil
	dmgLog[player] = nil
	for _, byVictim in dmgLog do
		byVictim[player] = nil
	end
	for key, e in engage do
		if e.A == player or e.B == player then engage[key] = nil end
	end
end

local function onPlayerLeaving(player, data)
	graceUntil[player], wasRookie[player] = nil, nil
	-- CR-M11: runs before KaijuService's handler (init order) and while JusticeService still reports the bully
	-- stacks (CR-L1 defers their cleanup)
	local okPay, paid = pcall(payLeaveBounty, player)
	if not okPay then
		Util.Warn(TAG, "leave bounty failed: " .. tostring(paid))
		paid = false
	end
	-- CR-M12: save the unclaimed stars so a rejoin cannot wipe them; a paid leave bounty or an Active kaiju
	-- (KaijuService resolves it) leaves none
	local d = data or S.PlayerService.GetData(player)
	if type(d) == "table" then
		local keep = (paid == true or kstate(player) == "Active") and 0 or (stars[player] or 0)
		-- CR-M12: like SavedBullyAt, back-date by the time already spent toward the next decay step this session
		-- (a queued / siren kaiju refreshes lastStarChange every tick, so into ~ 0 there)
		local step = math.max(1, Config.PvP.StarDecaySeconds)
		local now = os.clock()
		local into = math.clamp(math.floor(now - (lastStarChange[player] or now)), 0, step - 1)
		d.SavedStars = keep
		d.SavedStarsAt = keep > 0 and (os.time() - into) or 0
	end
	-- other services' PlayerLeaving handlers (e.g. KaijuService) may still call ResetStars; clean up after them
	clearRevengeInvolving(player)
	task.defer(cleanupPlayer, player)
end

local function onCharacterSpawned(player, _character, _humanoid, cosmetic)
	if cosmetic then return end -- replacing an appearance never renews spawn protection / the spawn clock
	spawnedAt[player] = os.clock()
	PvPService.Protect(player, Config.PvP.SpawnProtection)
end

-- CR-M15: log each PvP hit with its damage (the applied amount once CR-M10 lands) for the bait check
local function onPlayerDamaged(victim, amount, attacker)
	if victim == nil or attacker == nil then
		return
	end
	-- BB10 D2: who struck first in this fight (any hit, even one a shield blocked)
	local nowFight = os.clock()
	local key = engageKey(attacker, victim)
	local e = engage[key]
	if e == nil or nowFight - e.Last > GUARD.EngageGap then
		engage[key] = { By = attacker, T = nowFight, Last = nowFight, A = attacker, B = victim }
	else
		e.Last = nowFight
	end
	amount = tonumber(amount) or 0
	if amount ~= amount or amount <= 0 then
		return
	end
	local now = os.clock()
	local byVictim = dmgLog[attacker]
	if not byVictim then
		byVictim = {}
		dmgLog[attacker] = byVictim
	end
	local hits = byVictim[victim]
	if not hits then
		hits = {}
		byVictim[victim] = hits
	end
	pruneHits(hits, now - Config.Bully.BaitWindow)
	table.insert(hits, { T = now, A = amount })
	while #hits > GUARD.DmgLogMax do
		table.remove(hits, 1)
	end
end

local function onFactionChanged(player)
	PvPService.ResetStars(player)
	-- revenge marks never cross a faction change (and Neutral never gives/gets revenge; A6)
	clearRevengeInvolving(player)
	if isPlaying(player) then
		setAttr(player, "Rookie", rookieAttr(player))
	end
end

------------------------------------------------------------------ lifecycle
function PvPService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.PlayerService.CharacterSpawned:Connect(onCharacterSpawned)
	S.CombatService.PlayerDamaged:Connect(onPlayerDamaged)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
end

function PvPService.Start()
	local okBoard, errBoard = pcall(updateBoard)
	if not okBoard then
		Util.Warn(TAG, "board update failed: " .. tostring(errBoard))
	end

	task.spawn(function()
		local boardAcc = 0
		local pruneAcc = 0
		while true do
			task.wait(LOOP_INTERVAL)
			local now = os.clock()
			for _, p in S.PlayerService.GetReadyPlayers() do
				local ok, err = pcall(tickPlayer, p, now)
				if not ok then
					warnLoop(err)
				end
			end

			boardAcc += LOOP_INTERVAL
			if boardAcc >= Config.PvP.BoardRefresh then
				boardAcc = 0
				local ok, err = pcall(updateBoard)
				if not ok then
					warnLoop(err)
				end
			end

			pruneAcc += LOOP_INTERVAL
			if pruneAcc >= PRUNE_INTERVAL then
				pruneAcc = 0
				local ok, err = pcall(pruneDmgLog, now)
				if not ok then
					warnLoop(err)
				end
			end
		end
	end)

	print("[PvPService] started")
end

return PvPService
]]></ProtectedString>
				<string name="ScriptGuid">{F3D8A9F0-B593-4BB6-B6B4-446D5C7B4B0B}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PvPService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050001b0f8</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXF046557E3DD3471A944D7946A9390870">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- SettingsService.luau : BB2 (docs/design/beta_basics_2026-10-05.md) one saved settings blob per account, so changed
-- keys and options follow the player to the next visit and to other servers.
-- data.Settings = Config.SanitizeSettings(...) = { V, Keys (sparse action id -> key name or "", changes only), Sfx,
-- Shake, DmgNum, Tags, KeyBadges, Lang, BagSort }. Not mirrored; Version stays 3 (DataService.fillDefaults sanitizes old
-- and broken saves). HideAnnounceName / AutoCombatEnabled / IntroSeen keep their own remotes and fields.
-- Remotes:
--   c->s "SetSettings"(blob?): zero args = "send me mine"; else one table with at most Config.Settings.MaxBlobKeys
--     top-level keys, blob.Seq = an integer clamped to 0..2^31. Needs PlayerService.IsReady and Util.RateLimit
--     (Config.RateLimits.SetSettings); a dropped call gets no answer. Saves Config.SanitizeSettings(blob) and echoes.
--   s->c "Settings" { Seq, Settings } to the owner only: the echo of every accepted call (Seq of that blob, 0 for "send
--     me mine") and once on PlayerReady (Seq 0). The client ignores echoes older than its newest sent Seq.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local SettingsService = {}
local S = nil
local TAG = "SettingsService"
local MAX_SEQ = 2 ^ 31

local function getData(player)
	local ok, data = pcall(S.PlayerService.GetData, player)
	return ok and type(data) == "table" and data or nil
end

-- the saved settings of a loaded player (repairs a missing table), or nil
function SettingsService.Get(player)
	local data = getData(player)
	if not data then return nil end
	if type(data.Settings) ~= "table" then data.Settings = Config.SanitizeSettings(nil) end
	return data.Settings
end

-- full action -> key name map of this player (server view: every action whose Flag is on), for {Auto}-style texts
function SettingsService.KeyMap(player)
	local settings = SettingsService.Get(player)
	return (Config.KeyMap(settings and settings.Keys or nil, nil))
end

local function send(player, seq, settings)
	if type(settings) ~= "table" then return end
	local ok, err = pcall(function()
		Net.Get("Settings"):FireClient(player, { Seq = seq, Settings = Util.DeepCopy(settings) })
	end)
	if not ok then Util.Warn(TAG, "send: " .. tostring(err)) end
end

local function onSetSettings(player, ...)
	local n = select("#", ...)
	if n > 1 then return end
	local blob = ...
	local seq = 0
	if n == 1 then
		if type(blob) ~= "table" then return end
		local count = 0
		for _ in blob do
			count += 1
			if count > (Config.Settings.MaxBlobKeys or 16) then return end
		end
		local s = blob.Seq
		if type(s) == "number" and s == s then seq = math.clamp(math.floor(s), 0, MAX_SEQ) end
	end
	if not S.PlayerService.IsReady(player) then return end
	if not Util.RateLimit(player, "SetSettings", Config.RateLimits.SetSettings or 1) then return end
	local data = getData(player)
	if not data then return end
	if n == 1 then data.Settings = Config.SanitizeSettings(blob) end
	send(player, seq, SettingsService.Get(player))
end

function SettingsService.Init(registry)
	S = registry
end

function SettingsService.Start()
	Net.Get("SetSettings").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onSetSettings, player, ...)
		if not ok then Util.Warn(TAG, "SetSettings: " .. tostring(err)) end
	end)
	S.PlayerService.PlayerReady:Connect(function(player)
		local ok, err = pcall(function() send(player, 0, SettingsService.Get(player)) end)
		if not ok then Util.Warn(TAG, "ready: " .. tostring(err)) end
	end)

	-- BB3 settings footer: GameState SaveOK = false while DataService runs in memory mode (no saving on this server);
	-- the DataStore probe finishes after start and can fall back later, so it is checked again every 30 s (a delay
	-- chain, no waiting thread)
	local function publishSaveOK()
		local okMode, memory = pcall(function() return S.DataService.IsMemoryMode() end)
		if okMode then pcall(function() Net.GameState():SetAttribute("SaveOK", memory ~= true) end) end
		task.delay(30, publishSaveOK)
	end
	publishSaveOK()
	print("[SettingsService] started")
end

return SettingsService
]]></ProtectedString>
				<string name="ScriptGuid">{E1B5D838-2FA5-4453-897D-06BB36BE16D3}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">SettingsService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050001b0fc</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX9EE31DC5A07642BBB1CB8899EB9CF1F4">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- GrudgeService.luau : the grudge sack ("원한 돈자루"). Gold plundered by a Horns thief rides in ONE sack on the
-- thief's back; its 45 s countdown ticks only inside PvP zones. Survive -> Paid to the thief. A Halo KO in time ->
-- Avenged (victims get 120% to the bank, the avenger a bonus). Any other death / leaving -> Returned (100%).
-- P3 (2026-10-05): a victim who is not on this server gets their share by grudge mail at the next join.
-- A23-18: the respawned victim can hold the sack ([유령으로 붙잡기], +2 s per 3 s, max +10 s per sack).
-- Server only. See TECH_SPEC §4.14.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local TAG = "GrudgeService"

local LOOP_WARN_INTERVAL = 10
local MAX_TICK_STEP = 1 -- clamp for the elapsed time of one tick after a server hitch

local GrudgeService = {}

GrudgeService.SackResolved = Util.Signal.new() -- (thief, outcome: "Paid" | "Avenged" | "Returned", total)

local S = nil

-- [thief: Player] = { Entries = { [victimUserId] = { Amount, Name, Rebirths } }, Total, Remaining, Infamy,
-- RankInfamy (BB10: the fair weekly-board part of Infamy, credited only when the sack is Paid), LastVictimName }. Entry.Rebirths = the victim's Rebirths when stolen (CR-M6: no refund across a rebirth).
local sacks = {}
-- CR-M4 / CR-L6: anti-collusion cooldowns live in the saved PairCD (follows the player across servers):
-- victim data "steal:<thiefUserId>" (RestealWindow), "refund:0" (extra 20%, per victim);
-- avenger data "avenge:0" (avenger bonus, per avenger)

local lastLoopWarn = 0

------------------------------------------------------------------ helpers
local function isPlaying(p)
	return p ~= nil and p.Parent ~= nil
end

local function warnLoop(err)
	local now = os.clock()
	if now - lastLoopWarn >= LOOP_WARN_INTERVAL then
		lastLoopWarn = now
		Util.Warn(TAG, "loop error: " .. tostring(err))
	end
end

-- BB37: every server-wide line names players through AnnounceService.PublicName (hidden -> "<faction> 한 명")
local function publicName(p, honorific)
	local A = S.AnnounceService
	if A and A.PublicName then
		local ok, name = pcall(A.PublicName, p, honorific)
		if ok and type(name) == "string" then return name end
	end
	return Util.PlayerDisplayName(p) .. (honorific and Config.Announce.Text.Honorific or "")
end

local function fmt(key, ...)
	return string.format(Config.Text[key], ...)
end

local function notify(p, text, kind)
	if isPlaying(p) then
		Net.Notify(p, text, kind)
	end
end

-- CR-M4: pair cooldown kept in the holder's saved PairCD ("<kind>:<otherUserId>" = os.time()). PlayerService.PairReady
-- owns it; the inline copy follows the same contract. commit = false only checks. No data -> false.
local function pairReady(holder, otherUserId, kind, cooldown, commit)
	if not holder then
		return false
	end
	local PS = S.PlayerService
	if PS.PairReady then
		local ok, res = pcall(PS.PairReady, holder, otherUserId, kind, cooldown, commit)
		return ok and res == true
	end
	local d = PS.GetData(holder)
	if type(d) ~= "table" then
		return false
	end
	if type(d.PairCD) ~= "table" then
		d.PairCD = {}
	end
	local k = kind .. ":" .. tostring(otherUserId)
	local t = os.time()
	if t - (tonumber(d.PairCD[k]) or 0) < cooldown then
		return false
	end
	if commit ~= false then
		d.PairCD[k] = t
	end
	return true
end

-- CR-M6: a share is refunded only to the same "life" it was stolen from (a rebirth resets the bank on purpose)
local function sameLife(victim, entry)
	return (tonumber(victim:GetAttribute("Rebirths")) or 0) == (tonumber(entry.Rebirths) or 0)
end

local function rootPos(p)
	local root = Util.GetRoot(p)
	return root and root.Position or nil
end

local function setAttr(p, key, value)
	if p:GetAttribute(key) ~= value then
		p:SetAttribute(key, value)
	end
end

local function publish(thief, sack)
	if not isPlaying(thief) then
		return
	end
	if sack then
		setAttr(thief, "SackGold", sack.Total)
		setAttr(thief, "SackSeconds", math.max(0, math.ceil(sack.Remaining)))
		setAttr(thief, "SackVictimName", sack.LastVictimName)
	else
		setAttr(thief, "SackGold", 0)
		setAttr(thief, "SackSeconds", 0)
		setAttr(thief, "SackVictimName", "")
	end
end

-- victim still in this server (a rejoin counts: entries are keyed by UserId) and ready
local function presentVictim(userId)
	local victim = Players:GetPlayerByUserId(userId)
	if victim and S.PlayerService.IsReady(victim) then
		return victim
	end
	return nil
end

-- removes the sack, resets the thief's attributes, tells the thief (unless leaving) and fires SackResolved
local pointVictim -- A23-18 hold-button target (defined below with the grudge mail; closeSack calls it)

local function closeSack(thief, sack, outcome, tellThief)
	sacks[thief] = nil
	publish(thief, nil)
	if isPlaying(thief) then thief:SetAttribute("SackHeldUntil", 0) end
	for userId in sack.Entries do -- A23-18: the hold button moves to another open sack with my share, or hides
		local v = Players:GetPlayerByUserId(userId)
		if v then pointVictim(v) end
	end
	if tellThief and outcome ~= "Paid" then
		notify(thief, fmt("SackLost"), "bad")
	end
	GrudgeService.SackResolved:Fire(thief, outcome, sack.Total)
end

------------------------------------------------------------------ P3 grudge mail
local MAIL = { Store = nil, Tried = false, Pending = 0 }

function MAIL.Get()
	if not MAIL.Tried then
		MAIL.Tried = true
		local ok, store = pcall(DataStoreService.GetDataStore, DataStoreService, Config.Grudge.MailStore)
		MAIL.Store = ok and store or nil
		if not ok then
			Util.Warn(TAG, "grudge mail store unavailable: " .. tostring(store))
			task.delay(60, function() MAIL.Tried = false end) -- try again later instead of never
		end
	end
	return MAIL.Store
end

-- in-flight letters (PlayerService's BindToClose waits for them)
function GrudgeService.MailPending()
	return MAIL.Pending
end

-- a share for a victim who is not here: { Id, A = amount, R = rebirths when stolen, K = "Avenged" | "Returned", T }.
-- Id = thief + sack start + kind, so a retried write never adds the same letter twice (review of 735419e).
-- A taken (paid) letter leaves a tombstone { Id, Done = true, T } for MAIL.TombSeconds, so a Send retry whose first
-- reply was lost cannot add it back after the victim already took it (review of 74345bf: no double pay).
MAIL.TombSeconds = 600 -- far longer than Send's retry span (1 + 2 + 4 s)

local function live(m)
	return type(m) == "table" and m.Done ~= true and (tonumber(m.A) or 0) > 0
end

-- drop old tombstones, then trim to MailMax: tombstones go first, then the oldest letters
local function tidy(list)
	local out, now = {}, os.time()
	for _, m in list do
		if type(m) == "table" and (live(m) or (m.Done == true and now - (tonumber(m.T) or 0) < MAIL.TombSeconds)) then
			table.insert(out, m)
		end
	end
	while #out > Config.Grudge.MailMax do
		local drop = 1
		for i, m in out do
			if m.Done == true then drop = i break end
		end
		table.remove(out, drop)
	end
	return out
end

function MAIL.Send(userId, entry, kind, letterId)
	local amount = math.floor(tonumber(entry.Amount) or 0)
	if amount <= 0 then return end
	MAIL.Pending += 1
	task.spawn(function()
		local store = MAIL.Get()
		for attempt = 1, 4 do
			if not store then break end
			local ok, err = pcall(store.UpdateAsync, store, "M_" .. tostring(userId), function(old)
				local list = tidy(type(old) == "table" and old or {})
				for _, m in list do
					if type(m) == "table" and m.Id == letterId then return nil end -- already written (or already taken)
				end
				table.insert(list, { Id = letterId, A = amount, R = tonumber(entry.Rebirths) or 0, K = kind, T = os.time() })
				return tidy(list)
			end)
			if ok then break end
			Util.Warn(TAG, ("grudge mail send %d/4 failed: %s"):format(attempt, tostring(err)))
			if attempt < 4 then task.wait(2 ^ (attempt - 1)) end
		end
		MAIL.Pending -= 1
	end)
end

local function canPay(victim)
	return isPlaying(victim) and S.PlayerService.IsReady(victim) and type(S.PlayerService.GetData(victim)) == "table"
end

-- the victim could not be paid after the take: the letters go back (in FRONT of newer ones, tombstones removed);
-- retried like Send, merged by Id so a lost reply never duplicates a letter
function MAIL.WriteBack(store, key, letters)
	for attempt = 1, 4 do
		local ok, err = pcall(store.UpdateAsync, store, key, function(old)
			local ids, list = {}, {}
			for _, m in letters do
				if live(m) and (m.Id == nil or not ids[m.Id]) then
					if m.Id ~= nil then ids[m.Id] = true end
					table.insert(list, m)
				end
			end
			for _, m in (type(old) == "table" and old or {}) do
				if type(m) == "table" and (m.Id == nil or not ids[m.Id]) then table.insert(list, m) end
			end
			return tidy(list)
		end)
		if ok then return end
		Util.Warn(TAG, ("grudge mail write-back %d/4 failed: %s"):format(attempt, tostring(err)))
		if attempt < 4 then task.wait(2 ^ (attempt - 1)) end
	end
	Util.Warn(TAG, "grudge mail write-back gave up (letters lost, never paid twice)")
end

-- at join: take every letter, pay those from this "life"; the 120% bonus needs Avenged and the victim's refund
-- cooldown, and only the first such letter gets it. If the victim cannot be paid after the mailbox was emptied
-- (left / not ready), the letters go back in (nothing was paid yet, so nothing can be paid twice).
-- Counted in MAIL.Pending, so BindToClose waits for a take / write-back in flight.
function MAIL.Receive(victim)
	local store = MAIL.Get()
	if not store or not canPay(victim) then return end
	local shutting = S.PlayerService.IsShuttingDown and S.PlayerService.IsShuttingDown()
	if shutting then return end -- the letters wait for the next join
	MAIL.Pending += 1
	local ok, err = pcall(MAIL.Take, store, victim)
	MAIL.Pending -= 1
	if not ok then Util.Warn(TAG, "grudge mail receive failed: " .. tostring(err)) end
end

function MAIL.Take(store, victim)
	local key = "M_" .. tostring(victim.UserId)
	local letters = nil
	local ok, err = pcall(store.UpdateAsync, store, key, function(old)
		letters = {}
		local keep = {}
		for _, m in tidy(type(old) == "table" and old or {}) do
			if live(m) then
				table.insert(letters, m)
				if m.Id ~= nil then table.insert(keep, { Id = m.Id, Done = true, T = os.time() }) end -- tombstone
			else
				table.insert(keep, m)
			end
		end
		if #letters == 0 then return nil end
		return keep
	end)
	if not ok then Util.Warn(TAG, "grudge mail read failed: " .. tostring(err)) return end
	if type(letters) ~= "table" or #letters == 0 then return end
	if not canPay(victim) then
		MAIL.WriteBack(store, key, letters)
		return
	end
	local rebirths = tonumber(victim:GetAttribute("Rebirths")) or 0
	local total, bonusUsed, seen = 0, false, {}
	for i, m in letters do
		local amount = math.floor(tonumber(type(m) == "table" and m.A or 0) or 0)
		local id = m.Id or i -- letters without an Id (first build) are each their own
		if amount > 0 and not seen[id] and (tonumber(m.R) or 0) == rebirths then -- CR-M6 sameLife
			seen[id] = true
			local rate = Config.Grudge.ReturnRate
			if m.K == "Avenged" and not bonusUsed and pairReady(victim, 0, "refund", Config.Grudge.RefundBonusCooldown) then
				rate, bonusUsed = Config.Grudge.AvengeRefundRate, true
			end
			total += math.floor(amount * rate)
		end
	end
	if total > 0 then
		S.ProgressionService.AddBankGold(victim, total, "Refund")
		notify(victim, fmt("GrudgeMail", Util.FormatNumber(total)), "good")
	end
end

-- A23-18: point the victim's hold button at an open sack that still carries their share from this life
-- (several thieves: when one sack closes, the button moves to the next one instead of disappearing)
function pointVictim(victim)
	if not isPlaying(victim) then return end
	local target = 0
	for thief, sack in sacks do
		local entry = sack.Entries[victim.UserId]
		if entry and isPlaying(thief) and sameLife(victim, entry) and (tonumber(entry.Amount) or 0) > 0 then
			target = thief.UserId
		end
	end
	if victim:GetAttribute("GrudgeThiefId") ~= target then victim:SetAttribute("GrudgeThiefId", target) end
end

------------------------------------------------------------------ outcomes
-- Paid: the thief survived 45 s of PvP-zone time
local function pay(thief, sack)
	S.ProgressionService.AddCarriedGold(thief, sack.Total, "Plunder")
	if sack.Infamy > 0 then
		-- BB10: the stat gets every point; the weekly board only the fair part (sack.RankInfamy, never sack.Infamy)
		S.PlayerService.GrantFame(thief, "Infamy", sack.Infamy, { RankPoints = sack.RankInfamy or 0 })
	end
	notify(thief, fmt("SackPaid", Util.FormatNumber(sack.Total)), "reward")
	closeSack(thief, sack, "Paid", true)
end

-- Returned: every present victim gets 100% back to the bank; shares of victims who left (or rebirthed since,
-- CR-M6) are destroyed
local function returnShares(sack)
	for userId, entry in sack.Entries do
		local victim = presentVictim(userId)
		if victim and sameLife(victim, entry) then
			local amount = math.floor(entry.Amount * Config.Grudge.ReturnRate)
			if amount > 0 then
				S.ProgressionService.AddBankGold(victim, amount, "Refund")
				notify(victim, fmt("GrudgeReturned", Util.FormatNumber(amount)), "good")
			end
		elseif not victim then
			MAIL.Send(userId, entry, "Returned", sack.Id .. ":Returned") -- P3: paid at the next join (sameLife then)
		end
	end
end

-- Avenged: a Halo player KO'd the thief in time
local function avenge(thief, sack, killer)
	local G = Config.Grudge
	local thiefPos = rootPos(thief)

	for userId, entry in sack.Entries do
		local victim = presentVictim(userId)
		if victim and sameLife(victim, entry) then -- CR-M6
			-- CR-L6: the extra 20% is once per VICTIM per RefundBonusCooldown whatever the thief (victim's save, CR-M4)
			local bonusOk = pairReady(victim, 0, "refund", G.RefundBonusCooldown)
			local refund = math.floor(entry.Amount * (bonusOk and G.AvengeRefundRate or G.ReturnRate))
			if refund > 0 then
				S.ProgressionService.AddBankGold(victim, refund, "Refund")
				notify(victim, fmt("GrudgeRefund", Util.PlayerDisplayName(killer), Util.FormatNumber(refund)), "good")
				local victimPos = rootPos(victim)
				if thiefPos and victimPos then
					Net.Fx(victim, "Plunder", { From = thiefPos, To = victimPos, Amount = refund })
				end
			end
		elseif not victim then
			MAIL.Send(userId, entry, "Avenged", sack.Id .. ":Avenged") -- P3: 120% decided at the next join
		end
	end

	-- "복수 대행" bonus, once per AVENGER per PairRewardCooldown whatever the thief (CR-L6; avenger's save, CR-M4)
	if pairReady(killer, 0, "avenge", Config.PvP.PairRewardCooldown) then
		S.ProgressionService.AddBankGold(killer, G.AvengerBonus, "Bounty")
		notify(killer, fmt("AvengerBonus", Util.FormatNumber(G.AvengerBonus)), "reward")
	end

	Net.NotifyAll(fmt("GrudgeAvengedAll", publicName(killer, true), publicName(thief, true)), "info")
end

local function returnSack(thief, tellThief)
	local sack = sacks[thief]
	if not sack then
		return
	end
	returnShares(sack)
	closeSack(thief, sack, "Returned", tellThief)
end

------------------------------------------------------------------ public API
function GrudgeService.HasSack(player)
	return player ~= nil and sacks[player] ~= nil
end

function GrudgeService.GetSackTotal(player)
	local sack = player and sacks[player]
	return sack and sack.Total or 0
end

-- false if this thief stole from this victim less than RestealWindow ago (CR-M4: checked in the victim's save;
-- AddToSack records it)
function GrudgeService.CanSteal(thief, victim)
	if not thief or not victim then
		return false
	end
	return pairReady(victim, thief.UserId, "steal", Config.Grudge.RestealWindow, false)
end

-- amount was already taken from the victim's carried gold (PvPService.HandleKO). rankPts (BB10) = the part of infamy
-- that passed the fair-points check (RankingService.JudgeKO); it reaches the weekly board only if the sack is Paid.
function GrudgeService.AddToSack(thief, victim, amount, infamy, rankPts)
	if not thief or not victim then
		return
	end
	amount = math.floor(tonumber(amount) or 0)
	infamy = math.max(0, math.floor(tonumber(infamy) or 0))
	rankPts = math.clamp(math.floor(tonumber(rankPts) or 0), 0, infamy)
	if amount <= 0 then
		return
	end

	local sack = sacks[thief]
	if not sack then
		sack = { Entries = {}, Total = 0, Remaining = 0, Infamy = 0, RankInfamy = 0, LastVictimName = "", Held = 0,
			Id = tostring(thief.UserId) .. ":" .. tostring(os.time()) } -- grudge mail letter ids
		sacks[thief] = sack
	end
	-- CR-M6: remember the victim's rebirth count; a share stolen before a rebirth is never refunded after it
	local rebirths = tonumber(victim:GetAttribute("Rebirths")) or 0
	local entry = sack.Entries[victim.UserId]
	if entry then
		if not sameLife(victim, entry) then
			entry.Amount = 0 -- the older share stays in the sack (thief's Paid total) but is no longer refundable
		end
		entry.Amount += amount
		entry.Name = Util.PlayerDisplayName(victim)
		entry.Rebirths = rebirths
	else
		sack.Entries[victim.UserId] = { Amount = amount, Name = Util.PlayerDisplayName(victim), Rebirths = rebirths }
	end
	sack.Total += amount
	-- every new steal restarts the countdown, keeping any ghost-hold seconds already added (never shortens it)
	sack.Held = sack.Held or 0
	sack.Remaining = math.max(sack.Remaining, Config.Grudge.SackSeconds + sack.Held)
	victim:SetAttribute("GrudgeThiefId", thief.UserId) -- A23-18: the victim's [유령으로 붙잡기] button targets this sack
	sack.Infamy += infamy
	sack.RankInfamy = (sack.RankInfamy or 0) + rankPts
	sack.LastVictimName = Util.PlayerDisplayName(victim)
	pairReady(victim, thief.UserId, "steal", 0) -- CR-M4: record the steal in the victim's save (RestealWindow)
	publish(thief, sack)
end

-- death pipeline step 1 (CombatService); no-op without a sack
function GrudgeService.OnCarrierDown(player, killer)
	local sack = player and sacks[player]
	if not sack then
		return
	end
	if killer ~= nil and killer ~= player and isPlaying(killer) and S.FactionService.GetFaction(killer) == "Halo" then
		avenge(player, sack, killer)
		closeSack(player, sack, "Avenged", true)
	else
		returnShares(sack)
		closeSack(player, sack, "Returned", true)
	end
end

------------------------------------------------------------------ loop
local function tickSack(thief, dt)
	local sack = sacks[thief]
	if not sack then
		return
	end
	if not isPlaying(thief) then
		-- defensive: left without PlayerLeaving resolving it; leaving never pays the thief
		returnSack(thief, false)
		return
	end
	-- a dead carrier is resolved by the death pipeline; never pay or tick in that window
	if not Util.IsAlive(thief) then
		return
	end
	if not S.ZoneService.IsPvPZone(thief) then
		return
	end
	sack.Remaining -= dt
	if sack.Remaining <= 0 then
		pay(thief, sack)
		return
	end
	setAttr(thief, "SackSeconds", math.max(0, math.ceil(sack.Remaining)))
end

local function tickAll(dt)
	local thieves = {}
	for thief in sacks do
		table.insert(thieves, thief)
	end
	for _, thief in thieves do
		local ok, err = pcall(tickSack, thief, dt)
		if not ok then
			warnLoop(err)
		end
	end
end

------------------------------------------------------------------ A23-18 grudge ghost hold
local function onGhostHold(victim, ...)
	if select("#", ...) ~= 0 or not isPlaying(victim) or not S.PlayerService.IsReady(victim) then return end
	if not Util.IsAlive(victim) then return end -- the respawned victim holds, not the corpse
	if not Util.RateLimit(victim, "GhostHold", Config.RateLimits.GhostHold or Config.Grudge.HoldCooldown) then return end
	local G = Config.Grudge
	local thief = Players:GetPlayerByUserId(tonumber(victim:GetAttribute("GrudgeThiefId")) or 0)
	local sack = thief and sacks[thief]
	local entry = sack and sack.Entries[victim.UserId]
	if not entry or not sameLife(victim, entry) then
		pointVictim(victim) -- stale target (other life / sack moved): fix the button instead of failing silently
		return
	end
	local room = G.HoldMaxSeconds - (sack.Held or 0)
	if room <= 0 then
		notify(victim, fmt("GhostHoldMax", G.HoldMaxSeconds), "info")
		return
	end
	local add = math.min(G.HoldAddSeconds, room)
	sack.Held = (sack.Held or 0) + add
	sack.Remaining += add
	publish(thief, sack)
	-- the ghost above the thief glows hard while held, so other knights see the chase is on (no chat needed)
	local glowUntil = Util.Now() + G.HoldGlowSeconds
	thief:SetAttribute("SackHeldUntil", glowUntil)
	task.delay(G.HoldGlowSeconds + 0.1, function()
		if isPlaying(thief) and thief:GetAttribute("SackHeldUntil") == glowUntil then thief:SetAttribute("SackHeldUntil", 0) end
	end)
	notify(victim, fmt("GhostHoldOk", add, G.HoldMaxSeconds), "good")
	notify(thief, fmt("GhostHeld"), "bad")
	S.PlayerService.MarkActive(victim)
end

------------------------------------------------------------------ signal handlers
local function onPlayerReady(player)
	player:SetAttribute("SackGold", 0)
	player:SetAttribute("SackSeconds", 0)
	player:SetAttribute("SackVictimName", "")
	player:SetAttribute("SackHeldUntil", 0)
	player:SetAttribute("GrudgeThiefId", 0)
	pointVictim(player) -- a rejoin on THIS server while a thief still carries my share: the hold button comes back
	task.spawn(function() -- P3: shares mailed while this victim was away
		local ok, err = pcall(MAIL.Receive, player)
		if not ok then Util.Warn(TAG, "grudge mail: " .. tostring(err)) end
	end)
end

local function onPlayerLeaving(player)
	-- leaving with a sack -> Returned (the thief is never paid)
	if sacks[player] then
		returnSack(player, false)
	end
end

local function onFactionChanged(player)
	-- defensive: faction changes are blocked while carrying a sack (Altar / rebirth); never keep one across a switch
	if sacks[player] then
		returnSack(player, true)
	end
end

------------------------------------------------------------------ lifecycle
function GrudgeService.Init(registry)
	S = registry
	S.PlayerService.PlayerReady:Connect(onPlayerReady)
	S.PlayerService.PlayerLeaving:Connect(onPlayerLeaving)
	S.FactionService.FactionChanged:Connect(onFactionChanged)
	if S.ProgressionService and S.ProgressionService.Rebirthed then
		-- a rebirth starts a new "life": older shares are no longer mine to hold (CR-M6)
		S.ProgressionService.Rebirthed:Connect(function(player) pcall(pointVictim, player) end)
	end
end

function GrudgeService.Start()
	Net.Get("GhostHold").OnServerEvent:Connect(function(player, ...)
		local ok, err = pcall(onGhostHold, player, ...)
		if not ok then warnLoop(err) end
	end)
	-- (the anti-collusion cooldowns are in the saves now, CR-M4; PlayerService prunes them at PlayerReady)
	task.spawn(function()
		while true do
			local elapsed = task.wait(Config.Grudge.Tick)
			local dt = math.clamp(tonumber(elapsed) or Config.Grudge.Tick, 0, MAX_TICK_STEP)
			tickAll(dt)
		end
	end)

	print("[GrudgeService] started")
end

return GrudgeService
]]></ProtectedString>
				<string name="ScriptGuid">{7843ADF4-A806-41A3-B81B-B81432F79498}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GrudgeService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050000089f</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXE909F8286B9340D19D92C830AFE6B3D7">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- HalloweenService.luau : the Halloween season (Config.Halloween). The seasonal monster kinds spawn through
-- MonsterService's regular pool (Config.EffectiveMonsterCounts), one family per field (A23-45): pumpkins in the
-- PumpkinPatch, bat goblins in the GoblinWoods, ghosts in the HauntedHollow. This service runs the minibosses of
-- Config.Halloween.Bosses (the Pumpkin King, then the Ghost King 10 minutes later): each first FirstDelay s after server
-- start, then every Interval s (counted from its previous appearance) at one of its SpawnSpots, for at most Lifetime s.
-- Defeated -> every ELIGIBLE contributor is paid by MonsterService's normal kill path (A23-27: own hits >=
-- RewardMinHits and damage >= RewardMinDamageFrac of MaxHP; MonsterKilled once each: XP / gold / war points /
-- LootService drops; nothing extra here) and everyone gets one chat line; not defeated in time -> it leaves with a
-- friendly line. A boss never targets a player below SafeBelowLevel or with less than SafePlaySeconds played
-- (MonsterService.targetable). Season off (Enabled = false, or past EndsAt: A23-28 HW-13, checked every tick) -> no
-- schedule, no HUD line, a boss that is still here leaves, and the PumpkinPatch road sign (MapBuilder) is hidden.
-- GameState for EventHUD, per boss Key: <Key>NextAt (Util.Now server time of the next appearance, 0 = season off),
-- <Key>Active, <Key>EndsAt (PumpkinKing*, GhostKing*).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Net = require(Shared:WaitForChild("Net"))

local HalloweenService = {}
local S = nil
local TAG = "HalloweenService"
local H = Config.Halloween or {}
-- BOSSES[i] = { Kind, Key, FirstDelay, Interval, Lifetime, Spots, Rec (living MonsterService record or nil),
--   NextAt / EndsAt (Util.Now() times), Debug }
local BOSSES = {}
local K = { WarnAt = {}, SignOn = nil }

local function warnThrottled(key, msg)
	local now = os.clock()
	if now - (K.WarnAt[key] or -math.huge) < 10 then return end
	K.WarnAt[key] = now
	Util.Warn(TAG, tostring(msg))
end

local function num(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then return v end
	return default or 0
end

-- Enabled and before Config.Halloween.EndsAt (Config.SeasonOn reads the server clock)
local function seasonOn()
	return Config.SeasonOn("Halloween")
end

-- the PumpkinPatch road sign (MapBuilder: Map.Landmarks.PumpkinPatchSign) shows only while the season is on
local function showSign(on)
	if K.SignOn == on then return end
	local map = workspace:FindFirstChild("Map")
	local lm = map and map:FindFirstChild("Landmarks")
	local sign = lm and lm:FindFirstChild("PumpkinPatchSign")
	if not sign then return end -- MapBuilder has not built it yet: try again next tick
	K.SignOn = on
	for _, d in sign:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = on and (d:GetAttribute("ShownTransparency") or 0) or 1
			d.CanCollide = on and d:GetAttribute("ShownCollide") == true
		elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
			d.Enabled = on
		end
	end
end

-- Config.Halloween.Bosses (A23-45), or the single legacy King; kinds missing from Config.MonsterTypes are skipped
local function buildBosses()
	table.clear(BOSSES)
	local list = type(H.Bosses) == "table" and H.Bosses or { { Kind = H.King, Key = "PumpkinKing" } }
	for _, e in list do
		local kind = type(e) == "table" and e.Kind or nil
		if type(kind) == "string" and type(Config.MonsterTypes[kind]) == "table" then
			table.insert(BOSSES, {
				Kind = kind,
				Key = type(e.Key) == "string" and e.Key or kind,
				FirstDelay = num(e.FirstDelay, num(H.FirstDelay, 360)),
				Interval = math.max(60, num(e.Interval, num(H.Interval, 1200))),
				Lifetime = math.max(1, num(e.Lifetime, num(H.Lifetime, 300))),
				Spots = type(e.SpawnSpots) == "table" and e.SpawnSpots or (type(H.SpawnSpots) == "table" and H.SpawnSpots or nil),
				Rec = nil, NextAt = 0, EndsAt = 0, Debug = nil,
			})
		end
	end
end

local function bossOf(kind)
	for _, b in BOSSES do
		if b.Kind == kind then return b end
	end
	return nil
end

local function setGame(key, value)
	local ok, gs = pcall(Net.GameState)
	if ok and gs then gs:SetAttribute(key, value) end
end

local function publish(b)
	local active = b.Rec ~= nil
	setGame(b.Key .. "Active", active)
	setGame(b.Key .. "EndsAt", active and b.EndsAt or 0)
	setGame(b.Key .. "NextAt", seasonOn() and b.NextAt or 0)
end

-- one server-wide chat line (Config.Announce.Events key); never blocks the schedule
local function announce(key)
	local svc = S and S.AnnounceService
	if type(svc) ~= "table" or type(svc.Broadcast) ~= "function" then
		warnThrottled("announce", "AnnounceService.Broadcast missing")
		return
	end
	local ok, err = pcall(svc.Broadcast, key)
	if not ok then warnThrottled("announce", "Broadcast " .. tostring(key) .. ": " .. tostring(err)) end
end

-- spawns the boss at one of its spots (or its zone's center); true when it appeared
local function appear(b, now)
	if b.Rec ~= nil then return false end
	local svc = S and S.MonsterService
	if type(svc) ~= "table" or type(svc.SpawnEvent) ~= "function" then
		warnThrottled("spawn", "MonsterService.SpawnEvent missing")
		return false
	end
	local zone = Config.Zones[Config.MonsterTypes[b.Kind].Zone]
	local spots = b.Spots
	local near = spots and #spots > 0 and spots[math.random(1, #spots)] or (zone and zone.Center or nil)
	local ok, rec = pcall(svc.SpawnEvent, b.Kind, { Near = near, Radius = num(H.SpawnRadius, 12) })
	if not ok or type(rec) ~= "table" then
		if not ok then warnThrottled("spawn" .. b.Kind, rec) end
		return false
	end
	b.Rec = rec
	b.EndsAt = now + b.Lifetime
	publish(b)
	announce(b.Key .. "Appear")
	return true
end

-- the boss is gone: defeated (rewards were already paid by MonsterService) or leaving (removed without rewards)
local function finish(b, defeated)
	local rec = b.Rec
	b.Rec = nil
	b.EndsAt = 0
	b.Debug = nil
	if not defeated and type(rec) == "table" and rec.Alive then
		local svc = S and S.MonsterService
		if type(svc) == "table" and type(svc.RemoveEvent) == "function" then
			local ok, err = pcall(svc.RemoveEvent, rec, true, true) -- goes home: floats up and fades, no death splat
			if not ok then warnThrottled("remove", err) end
		end
	end
	publish(b)
	announce(b.Key .. (defeated and "Defeat" or "Leave"))
end

local function tickBoss(b, now, on)
	if not on and b.NextAt > 0 then
		b.NextAt = 0 -- the season just ended (HW-13): no more appearances, the HUD line goes away
		publish(b)
	end
	local rec = b.Rec
	if rec ~= nil then
		if not rec.Alive then
			-- MonsterService's kill sets HP to 0; a lost model (fell out of the world) is removed with its HP left
			finish(b, num(rec.HP, 1) <= 0)
		elseif now >= b.EndsAt or (not on and not b.Debug) then
			finish(b, false)
		elseif b.NextAt > 0 and now >= b.NextAt then
			b.NextAt += b.Interval -- a slot that comes while one is still here (Studio debug spawn) is skipped
			publish(b)
		end
		return
	end
	if not on or b.NextAt <= 0 or now < b.NextAt then return end
	if appear(b, now) then
		b.NextAt = now + b.Interval
	else
		b.NextAt = now + math.max(1, num(H.RetryDelay, 10)) -- no walkable spot this time
	end
	publish(b)
end

local function tick()
	local now = Util.Now()
	local on = seasonOn()
	showSign(on)
	for _, b in BOSSES do
		local ok, err = pcall(tickBoss, b, now, on)
		if not ok then warnThrottled("tick" .. b.Kind, err) end
	end
end

function HalloweenService.Init(registry)
	S = registry
end

function HalloweenService.Start()
	buildBosses()
	local now, on = Util.Now(), seasonOn()
	for _, b in BOSSES do
		b.NextAt = on and (now + math.max(0, b.FirstDelay)) or 0
		publish(b)
	end
	task.spawn(function()
		while true do
			task.wait(math.max(0.1, num(H.Tick, 0.5)))
			local ok, err = pcall(tick)
			if not ok then warnThrottled("tick", err) end
		end
	end)
	print(("[HalloweenService] started (season %s, %d bosses)"):format(on and "on" or "off", #BOSSES))
end

-- true while any miniboss (or the given kind) is alive
function HalloweenService.IsKingActive(kind)
	for _, b in BOSSES do
		if (kind == nil or b.Kind == kind) and b.Rec ~= nil and b.Rec.Alive == true then return true end
	end
	return false
end

-- Studio test aid (Main DebugCommand "PumpkinKing" / "GhostKing"): that boss appears now; its regular schedule is
-- unchanged. It needs the season on: with it off Config.ZoneAt skips the seasonal fields, so there is no boss ground
function HalloweenService.DebugSpawn(kind)
	local b = bossOf(kind or (BOSSES[1] and BOSSES[1].Kind))
	if not b then return "no such boss in Config.Halloween.Bosses: " .. tostring(kind) end
	if b.Rec ~= nil then
		if b.Rec.Alive then return "already here" end
		finish(b, num(b.Rec.HP, 1) <= 0) -- the previous one is gone but the tick has not closed it yet
	end
	local ok = appear(b, Util.Now())
	b.Debug = ok and not seasonOn() or nil -- a Studio boss with the season off stays its Lifetime
	return ok and "spawned" or "no walkable spot found (try again)"
end

return HalloweenService
]]></ProtectedString>
				<string name="ScriptGuid">{53CFFFEC-6BED-4798-8FFD-56BBB43E66D6}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">HalloweenService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c050000cdfd</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX415098F7BA984DCB8C055004BD1C65DD">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- WarService.luau : crown war meter ("왕관 쟁탈전") — 10-minute rounds, faction points, blessing, sky color, war chests.
--
-- Story: each round decides which side "holds the crown"; the sky turns the crown's color (Dawn gold / Eclipse blood).
-- Only Halo and Horns take part (addendum A6): Neutral and None never earn war points, never get a chest and never
-- hold the blessing; per-capita scores use FactionService.GetCounts (Halo vs Horns only), averaged over the round
-- (CR-M19). One monster kill adds its WarPoints to the faction pool once, split between contributors (CR-M18).
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local WarService = {}

local TAG = "WarService"
local WAR_FACTIONS = { Halo = true, Horns = true }
local WARN_INTERVAL = 10

-- docs/ART_DIRECTION.md 3.1: fixed lighting applied once in Start (this service owns Lighting; no Atmosphere, A9-3).
-- A23-29/30 (user pick 'E' = 'B' bright toy light + the new ground tiles, docs/design/world_blend_2026-10-06.md):
-- sky light reaches the monsters (EnvironmentDiffuse 1.0, Specular 0.6, ShadowSoftness 0.5), softer bloom and tint.
-- tools/preview_map.lua bakes the same Neutral values so Edit and the server start look alike.
local LIGHTING_FIXED = {
	GlobalShadows = true, ShadowSoftness = 0.5, GeographicLatitude = 35,
	EnvironmentDiffuseScale = 1.0, EnvironmentSpecularScale = 0.6,
}
local TINT_FIXED = { Brightness = 0, Contrast = 0.05, Saturation = 0.1 } -- only TintColor is tweened
local SKY_FIXED = { SunAngularSize = 14, MoonAngularSize = 18, StarCount = 3000 }
local BLOOM_FIXED = { Size = 24, Threshold = 2.2 }
local SUNRAYS_FIXED = { Spread = 0.4 }
-- ART_DIRECTION 3.2 per-sky values used only where Config.Sky[name] has no key of its own (Config.Sky stays the source
-- for everything it carries: FogStart / ExposureCompensation / BloomIntensity are read from the preset first).
-- Exposures = the client ZoneLook base light (SKY table there) so a war-sky change never flickers between the two.
local SKY_EXTRAS = {
	Neutral = { Exposure = -0.2, Bloom = 0.2, SunRays = 0.04, Clouds = Color3.fromRGB(255, 255, 255) },
	Dawn = { Exposure = -0.15, Bloom = 0.6, SunRays = 0.12, Clouds = Color3.fromRGB(255, 225, 190) },
	Eclipse = { Exposure = 0.45, Bloom = 0.5, SunRays = 0, Clouds = Color3.fromRGB(110, 40, 50) }, -- monsters stay visible at night
}

local S = nil
local points = { Halo = 0, Horns = 0 } -- faction pools of the current round
local personal = {} -- [Player] = personal points of the current round
local blessing = "None" -- faction holding the crown (decided at each round end, lasts one round)
local roundEndsAt = 0
local warTint = nil
local skyTweens = {}
local lastWarnAt = {}
-- CR-M19: head counts summed every tick of the current round; the per-capita divisor is the round AVERAGE, so a
-- last-second exodus cannot flip the result
local presence = { Halo = 0, Horns = 0, Ticks = 0 }
-- CR-L20: ClockTime is tweened through this NumberValue (always forward, wrapping at 24)
local clock = { Value = nil, Conn = nil }

------------------------------------------------------------------ helpers
local function warnThrottled(key, msg)
	local now = os.clock()
	local last = lastWarnAt[key]
	if last and now - last < WARN_INTERVAL then return end
	lastWarnAt[key] = now
	Util.Warn(TAG, msg)
end

local function isPlayer(x)
	return typeof(x) == "Instance" and x:IsA("Player")
end

local function getFaction(player)
	if S and S.FactionService then
		local ok, f = pcall(S.FactionService.GetFaction, player)
		if ok and type(f) == "string" then return f end
	end
	local f = player:GetAttribute("Faction")
	return type(f) == "string" and f or "None"
end

local function isValidAmount(n)
	return type(n) == "number" and n == n and n > 0 and n < math.huge
end

local function round1(x)
	return math.floor(x * 10 + 0.5) / 10
end

local function setPersonal(player, value)
	personal[player] = value
	if player.Parent then
		player:SetAttribute("WarPoints", value)
	end
end

------------------------------------------------------------------ sky
-- sets each property in its own pcall (newer Lighting properties may be missing on older engines)
local function setProps(inst, props)
	for k, v in props do
		local ok, err = pcall(function()
			inst[k] = v
		end)
		if not ok then
			warnThrottled("prop:" .. k, ("could not set %s.%s: %s"):format(inst.ClassName, k, tostring(err)))
		end
	end
end

local function findOrCreate(parent, className)
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Parent = parent
	end
	return inst
end

local function ensureTint()
	if warTint and warTint.Parent == Lighting then return warTint end
	local existing = Lighting:FindFirstChild("WarTint")
	if existing and existing:IsA("ColorCorrectionEffect") then
		warTint = existing
	else
		if existing then
			existing.Name = "WarTint_Old" -- something else took the contract name; keep it, but out of the way
		end
		warTint = Instance.new("ColorCorrectionEffect")
		warTint.Name = "WarTint"
		setProps(warTint, TINT_FIXED)
		warTint.Parent = Lighting
	end
	return warTint
end

-- ART_DIRECTION 3.1, once in Start
local function bootstrapLighting()
	pcall(function()
		Lighting.LightingStyle = Enum.LightingStyle.Soft
	end)
	pcall(function()
		Lighting.PrioritizeLightingQuality = true
	end)
	setProps(Lighting, LIGHTING_FIXED)
	setProps(ensureTint(), TINT_FIXED)
	setProps(findOrCreate(Lighting, "Sky"), SKY_FIXED)
	setProps(findOrCreate(Lighting, "BloomEffect"), BLOOM_FIXED)
	setProps(findOrCreate(Lighting, "SunRaysEffect"), SUNRAYS_FIXED)
	if Lighting:FindFirstChildOfClass("Atmosphere") then
		Util.Warn(TAG, "Lighting has an Atmosphere: it hides the FogColor/FogEnd war sky (addendum A9-3). Remove it.")
	end
end

local function skyNameFor(winner)
	if winner == "Halo" then return "Dawn" end
	if winner == "Horns" then return "Eclipse" end
	return "Neutral"
end

local function num(v)
	return (type(v) == "number" and v == v) and v or nil
end

-- CR-L20: a tween of ClockTime toward `target` that only runs FORWARD (to < from -> to + 24, written back as v % 24);
-- a plain number tween ran the sun backwards (16.8 -> 0.5). nil when there is nothing to tween or it failed.
local function clockTween(target, info)
	local from = Lighting.ClockTime
	local to = target
	if to < from then
		to += 24
	end
	if to - from < 1e-3 then return nil end
	if not clock.Value then
		local nv = Instance.new("NumberValue")
		nv.Name = "WarClock"
		clock.Value = nv
		clock.Conn = nv.Changed:Connect(function(v)
			Lighting.ClockTime = v % 24
		end)
	end
	clock.Value.Value = from
	local ok, tweenOrErr = pcall(TweenService.Create, TweenService, clock.Value, info, { Value = to })
	if not ok then
		warnThrottled("clock", "clock tween failed: " .. tostring(tweenOrErr))
		setProps(Lighting, { ClockTime = target })
		return nil
	end
	return tweenOrErr
end

-- applies Config.Sky[name] to Lighting + WarTint (FogStart / ExposureCompensation / BloomIntensity when the preset has
-- them, addendum A9-4/A11/A12), plus the ART_DIRECTION extras for whatever the preset does not carry
local function applySky(name, animate)
	local preset = Config.Sky[name]
	if type(preset) ~= "table" then return end
	local extras = SKY_EXTRAS[name] or SKY_EXTRAS.Neutral
	for _, t in skyTweens do
		t:Cancel()
	end
	table.clear(skyTweens)

	-- ClockTime is not in the goal: it is tweened forward on its own (CR-L20)
	local lightingGoal = {
		Brightness = preset.Brightness, Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient, FogColor = preset.FogColor, FogEnd = preset.FogEnd,
		FogStart = num(preset.FogStart), -- nil (left as is) when the preset has none
		ExposureCompensation = num(preset.ExposureCompensation) or extras.Exposure,
	}
	local fogStart, fogEnd = lightingGoal.FogStart, num(preset.FogEnd)
	if fogStart and fogEnd and fogStart >= fogEnd then
		lightingGoal.FogStart = math.max(0, fogEnd - 1) -- FogStart must stay below FogEnd
	end
	local goals = { { Lighting, lightingGoal } }
	if preset.Tint then
		table.insert(goals, { ensureTint(), { TintColor = preset.Tint } })
	end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then table.insert(goals, { bloom, { Intensity = num(preset.BloomIntensity) or extras.Bloom } }) end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then table.insert(goals, { rays, { Intensity = extras.SunRays } }) end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then table.insert(goals, { clouds, { Color = extras.Clouds } }) end
	local clockTarget = num(preset.ClockTime)

	if animate then
		local info = TweenInfo.new(Config.Sky.TweenTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		for _, g in goals do
			local ok, tweenOrErr = pcall(TweenService.Create, TweenService, g[1], info, g[2])
			if ok then
				table.insert(skyTweens, tweenOrErr)
				tweenOrErr:Play()
			else
				warnThrottled("tween", "sky tween failed: " .. tostring(tweenOrErr))
				setProps(g[1], g[2])
			end
		end
		local clockT = clockTarget and clockTween(clockTarget, info)
		if clockT then
			table.insert(skyTweens, clockT)
			clockT:Play()
		end
	else
		for _, g in goals do
			setProps(g[1], g[2])
		end
		if clockTarget then
			setProps(Lighting, { ClockTime = clockTarget }) -- no animation: set at once (CR-L20)
		end
	end
end

------------------------------------------------------------------ round state
local function getCounts()
	if not (S and S.FactionService) then return 0, 0 end
	local ok, halo, horns = pcall(S.FactionService.GetCounts)
	if not ok then
		warnThrottled("counts", "GetCounts failed: " .. tostring(halo))
		return 0, 0
	end
	return tonumber(halo) or 0, tonumber(horns) or 0
end

-- CR-M19: adds this tick's head counts to the round sums; returns the round-average counts (an average below 0.5 -
-- a side that was barely online this round - counts as 0)
local function averageCounts(halo, horns)
	presence.Halo += halo
	presence.Horns += horns
	presence.Ticks += 1
	local aH = presence.Halo / presence.Ticks
	local aR = presence.Horns / presence.Ticks
	if aH < 0.5 then aH = 0 end
	if aR < 0.5 then aR = 0 end
	return aH, aR
end

local function modeFor(halo, horns)
	if halo == 0 and horns == 0 then return "Idle" end
	if halo == 0 or horns == 0 then return "Siege" end
	return "Normal"
end

-- writes the per-capita scores, mode and round end to GameState; returns (haloScore, hornsScore, mode).
-- halo / horns = head counts (the round averages during a round, CR-M19; may be fractional)
local function publish(halo, horns)
	local haloScore = points.Halo / math.max(1, halo)
	local hornsScore = points.Horns / math.max(1, horns)
	local mode = modeFor(halo, horns)
	local gs = Net.GameState()
	gs:SetAttribute("WarHaloScore", round1(haloScore))
	gs:SetAttribute("WarHornsScore", round1(hornsScore))
	gs:SetAttribute("WarRoundEndsAt", roundEndsAt)
	gs:SetAttribute("WarMode", mode)
	return haloScore, hornsScore, mode
end

local function decideWinner(mode, haloScore, hornsScore, halo, horns)
	if mode == "Normal" then
		if haloScore > hornsScore then return "Halo" end
		if hornsScore > haloScore then return "Horns" end
		return "None"
	elseif mode == "Siege" then
		local present = (halo > 0) and "Halo" or "Horns"
		local score = (present == "Halo") and haloScore or hornsScore
		if score >= Config.War.SiegeTarget then return present end
		return "None"
	end
	return "None" -- Idle
end

local function payChests(winner, snapshot)
	for _, player in S.PlayerService.GetReadyPlayers() do
		local ok, err = pcall(function()
			local f = getFaction(player)
			if not WAR_FACTIONS[f] then return end
			if (snapshot[player] or 0) < Config.War.ChestMinPoints then return end
			local level = tonumber(player:GetAttribute("Level")) or 1
			local perLevel = (winner ~= "None" and f == winner) and Config.War.WinnerChestPerLevel or Config.War.LoserChestPerLevel
			local amount = math.floor(level * perLevel)
			if amount <= 0 then return end
			S.ProgressionService.AddBankGold(player, amount, "War")
			Net.Notify(player, string.format(Config.Text.WarChest, Util.FormatNumber(amount)), "reward")
		end)
		if not ok then
			warnThrottled("chest", "war chest error: " .. tostring(err))
		end
	end
end

-- halo / horns = round-average head counts (decide the winner); curHalo / curHorns = counts now (next round's publish)
local function endRound(mode, haloScore, hornsScore, halo, horns, curHalo, curHorns)
	-- advance + reset first so a failure below can never re-trigger the same round end every tick
	local snapshot = table.clone(personal)
	roundEndsAt = Util.Now() + Config.War.RoundSeconds
	points.Halo = 0
	points.Horns = 0
	presence.Halo = 0 -- CR-M19
	presence.Horns = 0
	presence.Ticks = 0
	for player in snapshot do
		setPersonal(player, 0)
	end

	local winner = decideWinner(mode, haloScore, hornsScore, halo, horns)
	blessing = winner
	Net.GameState():SetAttribute("WarBlessing", winner)
	applySky(skyNameFor(winner), true)

	payChests(winner, snapshot)

	if mode ~= "Idle" then
		if winner ~= "None" and Config.Story.WarWin[winner] then
			Net.NotifyAll(string.format(Config.Story.WarWin[winner]))
		else
			Net.NotifyAll(string.format(Config.Story.WarDraw))
		end
	end

	publish(curHalo or halo, curHorns or horns) -- new round: no averages yet
end

local function tick()
	local halo, horns = getCounts()
	local aH, aR = averageCounts(halo, horns) -- CR-M19
	local haloScore, hornsScore, mode = publish(aH, aR)
	if Util.Now() >= roundEndsAt then
		endRound(mode, haloScore, hornsScore, aH, aR, halo, horns)
	end
end

------------------------------------------------------------------ public API
-- personal + faction pool (monster kills, rewarded PvP KOs). poolN (optional, CR-M18) = this player's share of the
-- pool: one monster killed by k same-faction contributors adds WarPoints / k each (WarShare), so the pool gets
-- WarPoints once while every contributor still gets n personal points. Invalid / missing poolN -> n (capped at n).
function WarService.AddPoints(player, n, poolN)
	if not isPlayer(player) or not isValidAmount(n) then return end
	if not (S and S.PlayerService.IsReady(player)) then return end
	local f = getFaction(player)
	if not WAR_FACTIONS[f] then return end -- None / Neutral never earn war points
	points[f] += isValidAmount(poolN) and math.min(poolN, n) or n
	setPersonal(player, (personal[player] or 0) + n)
end

-- faction pool only (events: goose, kaiju)
function WarService.AddFactionPoints(factionId, n)
	if not WAR_FACTIONS[factionId] or not isValidAmount(n) then return end
	points[factionId] += n
end

-- blessing faction == player's faction (Halo/Horns only)
function WarService.HasBlessing(player)
	if not isPlayer(player) or blessing == "None" then return false end
	local f = getFaction(player)
	return WAR_FACTIONS[f] == true and f == blessing
end

function WarService.GetBlessingFaction()
	return blessing
end

function WarService.GetPersonalPoints(player)
	return personal[player] or 0
end

-- server time of the current round end; valid after Start
function WarService.GetRoundEndsAt()
	if roundEndsAt <= 0 then
		return Util.Now() + Config.War.RoundSeconds
	end
	return roundEndsAt
end

------------------------------------------------------------------ lifecycle
function WarService.Init(registry)
	S = registry
	ensureTint()

	if S.MonsterService and S.MonsterService.MonsterKilled then
		S.MonsterService.MonsterKilled:Connect(function(player, info)
			if type(info) == "table" then
				WarService.AddPoints(player, info.WarPoints, info.WarShare) -- CR-M18: pool share per contributor
			end
		end)
	else
		Util.Warn(TAG, "MonsterService.MonsterKilled missing; monster kills give no war points")
	end

	if S.PvPService and S.PvPService.PlayerKO then
		S.PvPService.PlayerKO:Connect(function(killer, _victim, info)
			if type(info) == "table" and info.Rewarded == true then
				local stars = tonumber(info.VictimStars) or 0
				local points = Config.War.PvPKOPoints + Config.War.PvPKOPerStar * stars
				local bold = tonumber(info.BoldMult) -- A23-18 boldness (x2 strong victim / x0.5 weak victim)
				if bold and bold > 0 and bold ~= 1 and S.PvPService.ScalePoints then
					points = S.PvPService.ScalePoints(points, bold)
				end
				if points > 0 then WarService.AddPoints(killer, points) end
			end
		end)
	else
		Util.Warn(TAG, "PvPService.PlayerKO missing; PvP KOs give no war points")
	end

	if S.FactionService and S.FactionService.FactionChanged then
		S.FactionService.FactionChanged:Connect(function(player)
			if isPlayer(player) then setPersonal(player, 0) end
		end)
	end

	S.PlayerService.PlayerReady:Connect(function(player)
		setPersonal(player, 0)
	end)
	S.PlayerService.PlayerLeaving:Connect(function(player)
		personal[player] = nil
	end)
end

function WarService.Start()
	bootstrapLighting()
	applySky("Neutral", false)
	roundEndsAt = Util.Now() + Config.War.RoundSeconds
	Net.GameState():SetAttribute("WarBlessing", blessing)
	local halo, horns = getCounts()
	publish(halo, horns)

	task.spawn(function()
		while true do
			task.wait(Config.War.Tick)
			local ok, err = pcall(tick)
			if not ok then
				warnThrottled("tick", "tick error: " .. tostring(err))
			end
		end
	end)

	print("[WarService] started")
end

return WarService
]]></ProtectedString>
				<string name="ScriptGuid">{79D8C1C4-80B7-486F-BF42-9ECFC342344B}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">WarService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">7f75f39798e08f3a0ad61c05000008c5</UniqueId>
			</Properties>
