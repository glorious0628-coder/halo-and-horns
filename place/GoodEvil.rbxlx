	Reward = { W = 440, BannerW = 340, BannerAspect = 512 / 178, TitleSize = 26, SlotSize = 76, SlotGap = 18,
		CompactBelow = 560, WideW = 620, BannerCompact = 270, SlotCompact = 58, ButtonHCompact = 48, LineSize = 18,
