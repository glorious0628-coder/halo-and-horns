local CREEKL = polyline(spline(PLAN.creek.pts, 6))
local CW0, CW1 = PLAN.creek.w[1] / 2, PLAN.creek.w[2] / 2
local CLEAR = PLAN.camp_clearings
local SPOTS = { -- flat spots { x, z, flat radius, free radius }
	{ KEEP.giant[1], KEEP.giant[2], 30, 46 },
	{ KEEP.arrival[1], KEEP.arrival[2], 30, 62 },
}
for _, c in CLEAR do table.insert(SPOTS, { c.c[1], c.c[2], c.r + 4, c.r + 14 }) end
local RoadZ = KEEP.crown_road_z
local ROAD = { Flat = 14, Free = 26 } -- the crown road (z 0, +-9): level across, relief fades in
local FN = { x = FALLS.N[1], z = FALLS.N[2] }
local FS = { x = FN.z, z = -FN.x } -- along the lip

local function flatMask(x, z) -- 0 = exactly flat (road / spots / paths / creek core), 1 = free relief
	local m = 1
	local d = math.abs(z - RoadZ)
	m = math.min(m, smooth((d - ROAD.Flat) / (ROAD.Free - ROAD.Flat)))
	for _, s in SPOTS do
		local r = math.sqrt((x - s[1]) ^ 2 + (z - s[2]) ^ 2)
		m = math.min(m, smooth((r - s[3]) / (s[4] - s[3])))
	end
	for _, p in PATHS do
		local dd = nearest(p.L, x, z)
		m = math.min(m, smooth((dd - (p.W / 2 + 2)) / 8))
	end
	local dc, u = nearest(CREEKL, x, z)
	local hw = lerp(CW0, CW1, u)
	m = math.min(m, smooth((dc - (hw + 3)) / 10))
	return m
end

local function relief(x, z, e) -- free relief before the mask: rolling + mounds + rim
	local r = ROLL.Amp * (0.5 + 0.5 * math.noise(x / ROLL.Scale + 0.31, z / ROLL.Scale + 0.77, 3.7))
	r += 0.35 * math.noise(x / 17 + 0.13, z / 17 + 0.41, 9.1)
	r = math.max(0, r)
	local mh = 0
	for _, m in PLAN.mounds do
		local d = math.sqrt((x - m.c[1]) ^ 2 + (z - m.c[2]) ^ 2)
		if d < m.r then
			local w = 0.5 + 0.5 * math.cos(math.pi * d / m.r)
			mh = math.max(mh, m.h * w * (1 + 0.12 * math.noise(x / 9 + 1.7, z / 9 + 2.9, 1.3)))
		end
	end
	local rim = 0
	if e > G.EdgeFlat then
		local H = lerp(RIM.H0, RIM.H1, 0.5 + 0.5 * math.noise(x / 30 + 0.2, z / 30 + 0.6, 5.5))
		local up = smooth((e - G.EdgeFlat) / RIM.Flat)
		local down = 1 - smooth((e - G.EdgeFlat - RIM.Flat - RIM.Peak) / RIM.Fade)
		rim = H * up * down
	end
	return softcap(r + mh, CAP) + rim
end

local function ledge(x, z) -- the NE-corner ledge behind the lip: height Lh (0 outside)
	local dx, dz = x - FALLS.P0[1], z - FALLS.P0[2]
	local u = dx * FN.x + dz * FN.z -- > 0 toward the pool
	local s = dx * FS.x + dz * FS.z
	local along = 1 - smooth((math.abs(s) - FALLS.Half) / FALLS.Fade)
	local cliff = u < 0 and 1 or (1 - smooth(u / FALLS.Cliff))
	return FALLS.Lh * along * cliff, u, s
end

local function carve(d, hw, depth, land)
	local W = G.WaterTop
	if d < hw then return math.min(land, W - 0.3 - (depth - 0.3) * (1 - (d / hw) ^ 2)), "bed" end
	if d < hw + CREEK.Sand then return math.min(land, lerp(W - 0.3, W + 0.6, smooth((d - hw) / CREEK.Sand))), "sand" end
	if d < hw + CREEK.Sand + CREEK.Bank then
		return lerp(math.min(W + 0.6, land), land, smooth((d - hw - CREEK.Sand) / CREEK.Bank)), "bank"
	end
	return land, nil
end

-- one column: visual height V, water top W (nil = none), tag
local function column(x, z)
	local inZone = x >= LAND.MinX and x <= LAND.MaxX and z >= LAND.MinZ and z <= LAND.MaxZ
	if not inZone then return nil end
	local e = math.min(x - LAND.MinX, LAND.MaxX - x, z - LAND.MinZ, LAND.MaxZ - z)
	local V = relief(x, z, e) * flatMask(x, z)
	local lh = ledge(x, z)
	local tag = nil
	if lh > V then V, tag = lh, (lh > 0.5 and "rocky" or nil) end
	-- creek + pool
	local land = V
	local W = nil
	local dc, u = nearest(CREEKL, x, z)
	local hw = lerp(CW0, CW1, u)
	local pcx = FALLS.P0[1] + FN.x * FALLS.PoolA
	local pcz = FALLS.P0[2] + FN.z * FALLS.PoolA
	local dq = math.sqrt((x - pcx) ^ 2 + (z - pcz) ^ 2)
	local lhere, uu = ledge(x, z)
	local onLedge = lhere > 0.3 and uu < 2 -- on the ledge or its cliff: no water there
	local pv, ptag = carve(dq, FALLS.PoolR, FALLS.PoolDepth, land)
	if ptag and not onLedge then V, W, tag = math.min(V, pv), G.WaterTop, ptag end
	local cv, ctag = carve(dc, hw, PLAN.creek.depth, land)
	if ctag and not onLedge then
		if tag == nil or ctag == "bed" or (ctag == "sand" and tag == "bank") then tag = ctag end
		V = math.min(V, cv)
		if ctag == "bed" then W = G.WaterTop end
	end
	return V, W, tag, e
end

------------------------------------------------------------------ paint (paths, clearings)
local function paintTag(x, z)
	for _, p in PATHS do
		local dd = nearest(p.L, x, z)
		if dd < p.W / 2 + 0.6 * math.noise(x / 6 + 0.5, z / 6 + 0.5, 2.2) then return true end
	end
	for _, c in CLEAR do
		local d = math.sqrt((x - c.c[1]) ^ 2 + (z - c.c[2]) ^ 2)
		local r = c.r * (1 + 0.07 * math.noise(x / 9 + 0.5, z / 9 + 0.5, 4.4))
		if d < r then
			-- the boss clearing is a ring: the middle stays grass
			if not (c.c[1] == KEEP.boss[1] and c.c[2] == KEEP.boss[2] and d < 8) then return true end
		end
	end
	return false
end

------------------------------------------------------------------ the plan
local function colX(i) return G.X0 + (i - 0.5) * G.R end
local function colZ(k) return G.Z0 + (k - 0.5) * G.R end
local function colIdx(i, k) return (i - 1) * G.NZ + k end

local function plan(base)
	local V, W, Tag, M, E = table.create(G.NCOL), table.create(G.NCOL), table.create(G.NCOL), table.create(G.NCOL), table.create(G.NCOL)
	for i = 1, G.NX do
		for k = 1, G.NZ do
			local idx = colIdx(i, k)
			local x, z = colX(i), colZ(k)
			local v, w, tag, e = column(x, z)
			if v == nil then
				V[idx], M[idx] = base.S[idx] + G.Lift, base.M[idx]
			else
				if tag == nil and paintTag(x, z) then tag = "path" end
				V[idx], W[idx], Tag[idx], E[idx] = v, w, tag, e
			end
		end
	end
	local S = table.create(G.NCOL)
	local Slope = table.create(G.NCOL)
	for i = 1, G.NX do
		for k = 1, G.NZ do
			local idx = colIdx(i, k)
			local v = V[idx]
			local gx = ((V[colIdx(math.min(G.NX, i + 1), k)] or v) - (V[colIdx(math.max(1, i - 1), k)] or v)) / (G.R * (i > 1 and i < G.NX and 2 or 1))
			local gz = ((V[colIdx(i, math.min(G.NZ, k + 1))] or v) - (V[colIdx(i, math.max(1, k - 1))] or v)) / (G.R * (k > 1 and k < G.NZ and 2 or 1))
			local sl = math.deg(math.atan(math.sqrt(gx * gx + gz * gz)))
			Slope[idx] = sl
			if E[idx] ~= nil then
				local tag = Tag[idx]
				local mat = base.M[idx]
				if tag == "bed" or tag == "sand" then
					mat = PAINT.Water
				elseif tag == "path" then
					mat = PAINT.Path
				elseif tag == "bank" then
					mat = (mat == "Grass" or mat == "LeafyGrass") and mat or G.Base
				elseif sl > G.RockSlope and v > 1 then
					mat = "Rock"
				end
				M[idx] = mat
			end
			S[idx] = V[idx] - G.Lift
		end
	end
	return { V = V, S = S, M = M, W = W, Tag = Tag, E = E, Slope = Slope }
end

local function stats(P)
	local n, hMax, hMin, slopes, over, water, paths, rocks = 0, -1e9, 1e9, {}, 0, 0, 0, 0
	for i = 1, G.NX do
		for k = 1, G.NZ do
			local idx = colIdx(i, k)
			local x, z = colX(i), colZ(k)
			if P.E[idx] ~= nil then
				if P.W[idx] ~= nil and P.Tag[idx] == "bed" then water += 1 end
				if P.Tag[idx] == "path" then paths += 1 end
				if P.M[idx] == "Rock" then rocks += 1 end
				local hunt = P.E[idx] >= G.Inset and P.W[idx] == nil and P.Tag[idx] ~= "sand" and P.Tag[idx] ~= "bank" and P.Tag[idx] ~= "rocky"
				if hunt then
					n += 1
					local v = P.V[idx]
					hMax, hMin = math.max(hMax, v), math.min(hMin, v)
					table.insert(slopes, P.Slope[idx])
					if v > G.GroundMax or v < G.GroundMin then over += 1 end
				end
			end
		end
	end
	table.sort(slopes)
	local function q(t) return slopes[math.max(1, math.floor(#slopes * t))] or 0 end
	return string.format(
		"hunting ground: %d columns, Y %.2f..%.2f (monster limit %d..%d, outside: %d), slope p50 %.1f p95 %.1f max %.1f deg | water bed columns %d | path/clearing columns %d | rock columns %d",
		n, hMin, hMax, G.GroundMin, G.GroundMax, over, q(0.5), q(0.95), slopes[#slopes] or 0, water, paths, rocks)
end

