local function readSummary()
	local region = Region3.new(Vector3.new(G.X0, G.Y0, G.Z0), Vector3.new(G.X1, G.Y1, G.Z1))
	local ch = Terrain:ReadVoxelChannels(region, G.R, { "SolidMaterial", "SolidOccupancy", "LiquidOccupancy" })
	local sm, so, lo = ch.SolidMaterial, ch.SolidOccupancy, ch.LiquidOccupancy
	local sum = { S = table.create(G.NCOL), M = table.create(G.NCOL), L = table.create(G.NCOL) }
	for i = 1, G.NX do
		for k = 1, G.NZ do
			local total, mHi, mLo, lt = 0, nil, nil, false
			for j = 1, G.NY do
				local mat, o = sm[i][j][k], so[i][j][k]
				local l = lo and lo[i][j][k] or 0
				if mat == Enum.Material.Water then l, o = (lo and l or o), 0 elseif mat == AIR then o = 0 end
				total += o
				if o > 0.02 then mLo = mat end
				if o >= 0.25 then mHi = mat end
				if l > 0.02 then lt = G.Y0 + (j - 0.5) * G.R + G.R * (l - 0.5) end
			end
			local idx = colIdx(i, k)
			sum.S[idx] = G.Y0 + G.R * total
			sum.M[idx] = (mHi or mLo or AIR).Name
			sum.L[idx] = lt
		end
	end
	return sum
end

local MAT_CACHE = {}
local function matEnum(name)
	local m = MAT_CACHE[name]
	if not m then
		local ok, e = pcall(function() return Enum.Material[name] end)
		m = ok and e or Enum.Material.Grass
		MAT_CACHE[name] = m
	end
	return m
end
local function writeChunk(ci, ck, colFn)
	local i0, k0 = (ci - 1) * G.Chunk + 1, (ck - 1) * G.Chunk + 1
	local i1, k1 = math.min(G.NX, i0 + G.Chunk - 1), math.min(G.NZ, k0 + G.Chunk - 1)
	local ni, nk = i1 - i0 + 1, k1 - k0 + 1
	local sm, so, lo = table.create(ni), table.create(ni), table.create(ni)
	for a = 1, ni do
		local mI, oI, lI = table.create(G.NY), table.create(G.NY), table.create(G.NY)
		for j = 1, G.NY do mI[j], oI[j], lI[j] = table.create(nk), table.create(nk), table.create(nk) end
		for c = 1, nk do
			local S, top, W = colFn(colIdx(i0 + a - 1, k0 + c - 1))
			for j = 1, G.NY do
				local cy = G.Y0 + (j - 0.5) * G.R
				local occ = clamp01((S - cy) / G.R + 0.5)
				local lw = occ < 1 and clamp01((W - cy) / G.R + 0.5) or 0
				mI[j][c], oI[j][c], lI[j][c] = occ > 0 and top or AIR, occ, lw
			end
		end
		sm[a], so[a], lo[a] = mI, oI, lI
	end
	local region = Region3.new(Vector3.new(G.X0 + (i0 - 1) * G.R, G.Y0, G.Z0 + (k0 - 1) * G.R),
		Vector3.new(G.X0 + i1 * G.R, G.Y1, G.Z0 + k1 * G.R))
	Terrain:WriteVoxelChannels(region, G.R, { SolidMaterial = sm, SolidOccupancy = so, LiquidOccupancy = lo })
end
local function chunkOf(idx)
	local i, k = (idx - 1) // G.NZ + 1, (idx - 1) % G.NZ + 1
	return ((i - 1) // G.Chunk) * G.CZ + ((k - 1) // G.Chunk) + 1
end
local function chunkCR(c) return (c - 1) // G.CZ + 1, (c - 1) % G.CZ + 1 end

-- store: baseline text (run-length) + spots + hidden pieces
local store = SS:FindFirstChild("WoodsTerrainStore")
local function getStore()
	if not store then
		store = Instance.new("Folder")
		store.Name = "WoodsTerrainStore"
		store:SetAttribute("Box", string.format("%d,%d,%d,%d,%d,%d,%d", G.X0, G.X1, G.Z0, G.Z1, G.Y0, G.Y1, G.R))
		store.Parent = SS
	end
	return store
end
local function encode(sum)
	local out, prev, n = {}, nil, 0
	for idx = 1, G.NCOL do
		local key = string.format("%.2f,%s,%s", sum.S[idx], sum.M[idx], sum.L[idx] and string.format("%.2f", sum.L[idx]) or "-")
		if key == prev then
			n += 1
		else
			if prev then table.insert(out, n .. "*" .. prev .. ";") end
			prev, n = key, 1
		end
	end
	table.insert(out, n .. "*" .. prev .. ";")
	return table.concat(out)
end
local function decode(text)
	local sum = { S = table.create(G.NCOL), M = table.create(G.NCOL), L = table.create(G.NCOL) }
	local idx = 0
	for n, s, m, l in string.gmatch(text, "(%d+)%*([^,]+),([^,]+),([^;]+);") do
		local lv = l ~= "-" and tonumber(l) or false
		for _ = 1, tonumber(n) do
			idx += 1
			sum.S[idx], sum.M[idx], sum.L[idx] = tonumber(s), m, lv
		end
	end
	assert(idx == G.NCOL, "stored baseline has " .. idx .. " columns, expected " .. G.NCOL)
	return sum
end
local PIECE = 40000
local function saveBase(sum)
	local st = getStore()
	local text = encode(sum)
	local n = math.ceil(#text / PIECE)
	for p = 1, n do
		local v = st:FindFirstChild("Base_" .. p) or Instance.new("StringValue")
		v.Name = "Base_" .. p
		v.Value = string.sub(text, (p - 1) * PIECE + 1, p * PIECE)
		v.Parent = st
	end
	for p = n + 1, (st:GetAttribute("BasePieces") or 0) do
		local v = st:FindFirstChild("Base_" .. p)
		if v then v:Destroy() end
	end
	st:SetAttribute("BasePieces", n)
end
local function loadBase()
	local n = store and store:GetAttribute("BasePieces")
	if type(n) ~= "number" or n < 1 then return nil end
	local parts = {}
	for p = 1, n do
		local v = store:FindFirstChild("Base_" .. p)
		if not (v and v:IsA("StringValue")) then return nil end
		parts[p] = v.Value
	end
	return decode(table.concat(parts))
end
if store then
	assert(store:GetAttribute("Box") == string.format("%d,%d,%d,%d,%d,%d,%d", G.X0, G.X1, G.Z0, G.Z1, G.Y0, G.Y1, G.R),
		"WoodsTerrainStore was made for another box: restore with the old script first")
end

-- hide / unhide the old straight trail
local HIDE = { { "Decor", "Roads", "RoadWoodsTrail" } }
local function hiddenFolder(create)
	local f = SS:FindFirstChild("WoodsTerrainHidden")
	if not f and create then
		f = Instance.new("Folder")
		f.Name = "WoodsTerrainHidden"
		f.Parent = SS
	end
	return f
end
local function hidePieces()
	local n = 0
	for _, path in HIDE do
		local node = mapRoot
		for _, seg in path do node = node and node:FindFirstChild(seg) end
		if node then
			node:SetAttribute("WoodsTerrainFrom", table.concat(path, "/", 1, #path - 1))
			node.Parent = hiddenFolder(true)
			n += 1
		end
	end
	return n
end
local function unhidePieces()
	local f = hiddenFolder(false)
	local back = 0
	if f then
		for _, p in f:GetChildren() do
			local dest = mapRoot
			for seg in string.gmatch(p:GetAttribute("WoodsTerrainFrom") or "", "[^/]+") do dest = dest and dest:FindFirstChild(seg) end
			if dest then p.Parent = dest back += 1 end
		end
		if #f:GetChildren() == 0 then f:Destroy() end
	end
	return back
end

------------------------------------------------------------------ the waterfall (a trimmed copy of the meadow's)
local FALLS_NAME = "WoodsWaterfall"
local FALLS_LOOK = { Tex = "rbxassetid://86909517913668", TileU = 12, TileV = 15, TexTransparency = 0.25, Transparency = 0.3, Tint = 0.45,
	FoamTransparency = 0.15, BeamOut = 1.4, BeamSpeed = 1.1 }
local function buildFalls(ledgeTop, poolBottom)
	local decor = mapRoot and mapRoot:FindFirstChild("Decor")
	if not decor then return 0 end
	local old = decor:FindFirstChild(FALLS_NAME)
	if old then old:Destroy() end
	local m = Instance.new("Model")
	m.Name = FALLS_NAME
	local n = Vector3.new(FN.x, 0, FN.z)
	local s = Vector3.new(FS.x, 0, FS.z)
	local p0 = Vector3.new(FALLS.P0[1], 0, FALLS.P0[2])
	local function at(a, y, b) return p0 + n * a + s * b + Vector3.new(0, y, 0) end
	local count = 0
	local function piece(name, size, cf, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size, p.CFrame, p.Color = size, cf, color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = m
		count += 1
		return p
	end
	local okTint, tw = pcall(function() return Terrain.WaterColor end)
	local WATER = (okTint and typeof(tw) == "Color3" and tw or Color3.fromRGB(8, 181, 214)):Lerp(Color3.new(1, 1, 1), FALLS_LOOK.Tint)
	local FOAM = Color3.fromRGB(245, 252, 255)
	local function flowTex(p, face)
		local t = Instance.new("Texture")
		t.Name = "Flow" .. face.Name
		t.Texture = FALLS_LOOK.Tex
		t.Face = face
		t.StudsPerTileU, t.StudsPerTileV = FALLS_LOOK.TileU, FALLS_LOOK.TileV
		t.Transparency = FALLS_LOOK.TexTransparency
		t.Parent = p
	end
	local wt = ledgeTop - 0.2
	local a0 = FALLS.Sheet -- the sheet hugs the cliff face
	-- the water curling over the lip: two slabs from the ledge top out to the sheet
	local curl = { { a0 - 4.0, wt + 0.1 }, { a0 - 1.2, wt - 0.1 }, { a0, wt - 1.3 } }
	for c = 1, #curl - 1 do
		local p, q = at(curl[c][1], curl[c][2], 0), at(curl[c + 1][1], curl[c + 1][2], 0)
		local slab = piece("FallsCurl" .. c, Vector3.new(FALLS.Width, 0.9, (q - p).Magnitude + 0.6), CFrame.lookAt((p + q) / 2, p), WATER)
		slab.Transparency = FALLS_LOOK.Transparency
		flowTex(slab, Enum.NormalId.Top)
	end
	local top, bottom = wt - 1.3, poolBottom - 0.4
	local mid = at(a0, (top + bottom) / 2, 0)
	local sheet = piece("FallsSheet", Vector3.new(FALLS.Width, top - bottom, 0.9), CFrame.lookAt(mid, mid + n), WATER)
	sheet.Transparency = FALLS_LOOK.Transparency
	flowTex(sheet, Enum.NormalId.Front)
	flowTex(sheet, Enum.NormalId.Back)
	for f, spec in { { 0.3, -2.6, 4.2, 3.2 }, { 1.0, 1.6, 5.0, 3.6 } } do
		local c = at(a0 + spec[1], poolBottom + 0.55, spec[2])
		local foam = piece("FallsFoam" .. f, Vector3.new(spec[3], 1.0, spec[4]), CFrame.lookAt(c, c + n), FOAM)
		foam.Transparency = FALLS_LOOK.FoamTransparency
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = foam
	end
	local anchor = piece("FallsAnchor", Vector3.new(1, 1, 1), CFrame.new(mid), WATER)
	anchor.Transparency = 1
	for bIdx = 1, 2 do
		local b = (FALLS.Width / 2 - 1.4) * (2 * (bIdx - 1) - 1)
		local t0, t1 = Instance.new("Attachment"), Instance.new("Attachment")
		t0.Name, t1.Name = "StreakTop" .. bIdx, "StreakBottom" .. bIdx
		t0.Parent, t1.Parent = anchor, anchor
		t0.WorldPosition = at(a0 + FALLS_LOOK.BeamOut, top - 0.3, b)
		t1.WorldPosition = at(a0 + FALLS_LOOK.BeamOut, bottom + 0.6, b)
		local beam = Instance.new("Beam")
		beam.Name = "Streak" .. bIdx
		beam.Attachment0, beam.Attachment1 = t0, t1
		beam.Texture = "rbxasset://textures/particles/smoke_main.dds"
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = 6 + bIdx
		beam.TextureSpeed = FALLS_LOOK.BeamSpeed * (0.9 + 0.12 * bIdx)
		beam.Width0, beam.Width1 = 2.0, 2.4
		beam.FaceCamera = true
		beam.Segments = 1
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(215, 245, 255))
		beam.Transparency = NumberSequence.new(0.3, 0.5)
		beam.LightEmission, beam.LightInfluence = 0.3, 0.5
		beam.ZOffset = 0.3
		beam.Parent = anchor
	end
	local mist = piece("FallsMist", Vector3.new(FALLS.Width + 2, 1, 4), CFrame.lookAt(at(a0 + 0.5, poolBottom + 0.4, 0), at(a0 + 1.5, poolBottom + 0.4, 0)), WATER)
	mist.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Name = "Mist"
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(240, 250, 255))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 7) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(1.6, 2.6)
	e.Speed = NumberRange.new(0.8, 1.6)
	e.Rate = 5
	e.Rotation = NumberRange.new(0, 360)
	e.SpreadAngle = Vector2.new(25, 25)
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = mist
	m.Parent = decor
	return count
end

------------------------------------------------------------------ run
local cur = readSummary()
local base = loadBase()
local function flatCheck(sum)
	local bad = {}
	for _, p in { { 730, 0 }, { 840, 95 }, { 960, -90 }, { 1110, 120 }, { 900, 200 }, { 800, -200 } } do
		local i = math.floor((p[1] - G.X0) / G.R) + 1
		local k = math.floor((p[2] - G.Z0) / G.R) + 1
		local v = sum.S[colIdx(i, k)] + G.Lift
		if math.abs(v) > 1.2 then table.insert(bad, string.format("(%d, %d) Y %.1f", p[1], p[2], v)) end
	end
	return bad
end
if MODE == "rebase" or (base == nil and MODE ~= "restore") then
	local bad = flatCheck(cur)
	if #bad > 0 then
		error("woods terrain is not flat (" .. table.concat(bad, ", ") .. "): restore with the old script first, or run py tools/map_v2_apply.py terrain")
	end
	base = cur
	if MODE ~= "plan" then
		saveBase(base)
		base = loadBase()
		getStore():SetAttribute("CapturedAt", DateTime.now():ToIsoDate())
	end
end
assert(base, "no stored baseline: nothing to restore")

if MODE == "restore" then
	local need = {}
	for idx = 1, G.NCOL do
		if math.abs(cur.S[idx] - base.S[idx]) > 0.15 or cur.M[idx] ~= base.M[idx] then need[chunkOf(idx)] = true end
	end
	local wrote = 0
	for c in need do
		local ci, ck = chunkCR(c)
		writeChunk(ci, ck, function(idx) return base.S[idx], matEnum(base.M[idx]), G.WaterTop end)
		wrote += 1
		task.wait()
	end
	local decor = mapRoot and mapRoot:FindFirstChild("Decor")
	local f = decor and decor:FindFirstChild(FALLS_NAME)
	if f then f:Destroy() end
	local back = unhidePieces()
	if store then for _, a in { "FallsLip", "FallsPool", "CreekLine", "AppliedAt" } do store:SetAttribute(a, nil) end end
	return string.format("woods terrain restore: %d chunks back to the baseline, waterfall removed, %d hidden pieces back", wrote, back)
end

local P = plan(base)
local report = stats(P)
if MODE == "plan" then return "PLAN " .. report end

local planDiff = {}
for idx = 1, G.NCOL do
	if math.abs(P.S[idx] - cur.S[idx]) > 0.15 or P.M[idx] ~= cur.M[idx] then planDiff[chunkOf(idx)] = true end
end
local wrote = 0
for c = 1, G.CX * G.CZ do
	if planDiff[c] then
		local ci, ck = chunkCR(c)
		writeChunk(ci, ck, function(idx) return P.S[idx], matEnum(P.M[idx]), P.W[idx] or G.WaterTop end)
		wrote += 1
		task.wait()
	end
end
local hid = hidePieces()
local nFalls = buildFalls(FALLS.Lh, G.WaterTop - FALLS.PoolDepth)
local st = getStore()
st:SetAttribute("FallsLip", Vector3.new(FALLS.P0[1], FALLS.Lh, FALLS.P0[2]))
st:SetAttribute("FallsPool", Vector3.new(FALLS.P0[1] + FN.x * FALLS.PoolA, G.WaterTop, FALLS.P0[2] + FN.z * FALLS.PoolA))
local pts = {}
for i = 1, #CREEKL.P, 3 do table.insert(pts, string.format("%.0f,%.0f", CREEKL.P[i][1], CREEKL.P[i][2])) end
st:SetAttribute("CreekLine", table.concat(pts, ";"))
st:SetAttribute("AppliedAt", DateTime.now():ToIsoDate())
return string.format("woods terrain applied: %d chunks written, %d falls parts, %d old pieces hidden | %s", wrote, nFalls, hid, report)
