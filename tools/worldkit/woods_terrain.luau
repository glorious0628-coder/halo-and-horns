	for idx = 1, G.NCOL do base.S[idx], base.M[idx], base.L[idx] = -G.Lift, G.Base, false end
	local P = plan(base)
	print(stats(P))
	if DUMP then
		for i = 1, G.NX do
			for k = 1, G.NZ do
				local idx = colIdx(i, k)
				print(string.format("C,%d,%d,%.2f,%s,%s", colX(i), colZ(k), P.V[idx], P.M[idx], tostring(P.Tag[idx])))
			end
		end
	end
	return
end

