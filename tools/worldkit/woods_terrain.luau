	RockSlope = 35, -- degrees: steeper ground shows Rock
	Base = "LeafyGrass",
}
G.NX, G.NZ, G.NY = (G.X1 - G.X0) / G.R, (G.Z1 - G.Z0) / G.R, (G.Y1 - G.Y0) / G.R
G.NCOL = G.NX * G.NZ
G.CX, G.CZ = math.ceil(G.NX / G.Chunk), math.ceil(G.NZ / G.Chunk)
local LAND = PLAN.land
local KEEP = PLAN.keep
local ROLL = { Amp = 1.3, Scale = 42 }
local RIM = { H0 = 3.0, H1 = 4.5, Flat = 8, Peak = 2, Fade = 8 } -- edge distance: flat until EdgeFlat, up over Flat, top to Peak, down over Fade
local CAP = 5.8 -- soft cap of the hunting ground (MonsterService GROUND_MAX_Y 6)
local FALLS = { Lh = 5.5, P0 = { 1170, -238 }, N = { -0.7225, 0.6914 }, Width = 8, Half = 14, Fade = 8, Cliff = 4, PoolA = 12, PoolR = 9,
	PoolDepth = 2.4, Sheet = 1.8 }
local CREEK = { Sand = 2.0, Bank = 7 }
local PAINT = { Path = "Pavement", Water = "Sand" }

------------------------------------------------------------------ math helpers
local function clamp01(t) return t < 0 and 0 or (t > 1 and 1 or t) end
local function smooth(t) t = clamp01(t) return t * t * (3 - 2 * t) end
local function lerp(a, b, t) return a + (b - a) * t end
local function softcap(v, cap) return v <= cap - 0.8 and v or (cap - 0.8 + 0.8 * math.tanh((v - cap + 0.8) / 0.8)) end
local function cr(a0, a1, a2, a3, t)
	return 0.5 * ((2 * a1) + (-a0 + a2) * t + (2 * a0 - 5 * a1 + 4 * a2 - a3) * t * t + (-a0 + 3 * a1 - 3 * a2 + a3) * t * t * t)
end
local function spline(ctrl, step) -- dense smooth polyline through the control points
	local out, n = {}, #ctrl
	for i = 1, n - 1 do
		local p0, p1, p2, p3 = ctrl[math.max(1, i - 1)], ctrl[i], ctrl[i + 1], ctrl[math.min(n, i + 2)]
		local len = math.sqrt((p2[1] - p1[1]) ^ 2 + (p2[2] - p1[2]) ^ 2)
		local m = math.max(1, math.ceil(len / step))
		for s = 0, m - 1 do
			local t = s / m
			table.insert(out, { cr(p0[1], p1[1], p2[1], p3[1], t), cr(p0[2], p1[2], p2[2], p3[2], t) })
		end
	end
	table.insert(out, { ctrl[n][1], ctrl[n][2] })
	return out
end
local function polyline(pts) -- { pts, cumulative lengths, total }
	local cum, tot = { 0 }, 0
	for i = 2, #pts do
		tot += math.sqrt((pts[i][1] - pts[i - 1][1]) ^ 2 + (pts[i][2] - pts[i - 1][2]) ^ 2)
		cum[i] = tot
	end
	return { P = pts, Cum = cum, Tot = tot }
end
local function nearest(L, x, z) -- distance to the polyline, and its parameter u (0 start .. 1 end)
	local best, bu = 1e9, 0
	local P, cum = L.P, L.Cum
	for i = 1, #P - 1 do
		local ax, az, bx, bz = P[i][1], P[i][2], P[i + 1][1], P[i + 1][2]
		local dx, dz = bx - ax, bz - az
		local ll = dx * dx + dz * dz
		local t = ll == 0 and 0 or clamp01(((x - ax) * dx + (z - az) * dz) / ll)
		local d = math.sqrt((x - ax - t * dx) ^ 2 + (z - az - t * dz) ^ 2)
		if d < best then best, bu = d, (cum[i] + t * math.sqrt(ll)) / math.max(1e-6, L.Tot) end
	end
	return best, bu
end

