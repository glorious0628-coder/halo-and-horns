local SS = game:GetService("ServerStorage")
local PhysicsService = game:GetService("PhysicsService")
local kit = SS:FindFirstChild("WorldKit3D")
assert(kit, "ServerStorage.WorldKit3D missing")
local map = workspace:FindFirstChild("Map")
assert(map, "workspace.Map missing")
local decor = map:FindFirstChild("Decor")
assert(decor, "Map.Decor missing")
local gates = map:FindFirstChild("Gates")
local landmarks = map:FindFirstChild("Landmarks")

local T = {
	CellSize = 64, Group = "DecorPlayerOnly", Rect = { MinX = -212, MaxX = 212, MinZ = -712, MaxZ = -322 },
	DeckFrac = 0.6, -- the arch bridge's deck top as a fraction of its model height (tune with the real model)
	TriCap = 900000, PartCap = 1700,
}
local KITNAME = {
	Gate = "Halo_Gate", Cathedral = "Halo_Cathedral", Fountain = "Town_Halo_Fountain3", Tower = "Halo_Tower", DomeHouseA = "Halo_DomeHouseA",
	DomeHouseB = "Halo_DomeHouseB", Shop = "Halo_Shop", Statue = "Halo_Statue", ArchBridge = "Halo_ArchBridge", Stairs = "Halo_Stairs",
	Balustrade = "Halo_Balustrade", Lantern = "Halo_Lantern", Planter = "Halo_Planter", CloudBush = "Halo_CloudBush", Topiary = "Halo_Topiary",
	RoundTree = "Halo_RoundTree", PotFlowers = "Halo_PotFlowers", BannerPole = "Halo_BannerPole", Islet = "Halo_Islet", FarArch = "Halo_FarArch",
}
-- Coll: "solid" = CanCollide + CanQuery, "player" = DecorPlayerOnly group, "post" = mesh walk-through + invisible player-only post, "none" = walk-through,
-- "back" = backdrop (no collide, no query)
local COLL = {
	Cathedral = "solid", Fountain = "solid", Tower = "solid", DomeHouseA = "solid", DomeHouseB = "solid", Shop = "solid", Stairs = "solid", ArchBridge = "solid",
	Statue = "player", Balustrade = "player", Lantern = "player", Planter = "player", BannerPole = "player",
	CloudBush = "post", Topiary = "post", RoundTree = "post", PotFlowers = "none", Islet = "back", FarArch = "back",
}
local SMALL = { Balustrade = true, Lantern = true, Planter = true, BannerPole = true, PotFlowers = true, CloudBush = true, Topiary = true, RoundTree = true } -- color map only
local TRIS = { Gate = 10000, Cathedral = 11000, Fountain = 10000, Tower = 7000, DomeHouseA = 8000, DomeHouseB = 8000, Shop = 8000, Statue = 3000, ArchBridge = 6000,
	Stairs = 1500, Balustrade = 600, Lantern = 600, Planter = 800, CloudBush = 400, Topiary = 700, RoundTree = 1200, PotFlowers = 400, BannerPole = 800, Islet = 2500, FarArch = 2500 }
local OLD = { HaloTower = true, HeroStatue = true, HaloCastle = true, HaloTownTrees = true, Flower = true, ZoneSwap_halo = true }

local function inRect(p)
	return p.X >= T.Rect.MinX and p.X <= T.Rect.MaxX and p.Z >= T.Rect.MinZ and p.Z <= T.Rect.MaxZ
end
local function pivotOf(i)
	if i:IsA("Model") then return i:GetPivot().Position end
	if i:IsA("BasePart") then return i.Position end
	return nil
end
local function pathOf(i) return i.Parent and i.Parent:GetFullName() or "" end
local function findByPath(full)
	local cur = game
	for seg in string.gmatch(full, "[^%.]+") do
		cur = cur and (cur:FindFirstChild(seg) or (cur == game and game:GetService(seg)) or nil)
	end
	return cur
end

local old = SS:FindFirstChild("HaloPropsOld")

local function restoreOld()
	local n = 0
	if old then
		for _, i in old:GetChildren() do
			local p = findByPath(i:GetAttribute("HaloFrom") or "")
			if p then
				i:SetAttribute("HaloFrom", nil)
				i.Parent = p
				n += 1
			end
		end
	end
	return n
end
local function removeOurs()
	local n = 0
	local r = decor:FindFirstChild("HaloProps")
	if r then r:Destroy() n += 1 end
	if gates then
		local g = gates:FindFirstChild("Gate_HaloTown")
		if g and g:GetAttribute("PlacedBy") == "halo_props.luau" then g:Destroy() n += 1 end
	end
	return n
end

if MODE == "restore" then
	local a = removeOurs()
	local b = restoreOld()
	return string.format("halo_props restore: removed %d of ours, put %d old instances back", a, b)
end

------------------------------------------------------------------ plan (counts, kit present?)
local counts, missing, tris, parts = {}, {}, 0, 0
for _, e in PLAN.placements do
	counts[e.kind] = (counts[e.kind] or 0) + 1
	local nm = KITNAME[e.kind]
	if not (nm and kit:FindFirstChild(nm)) then missing[e.kind] = true end
	tris += TRIS[e.kind] or 3000
	parts += 1
end
local function summary()
	local c, m = {}, {}
	for k, v in counts do table.insert(c, k .. "=" .. v) end
	for k in missing do table.insert(m, k) end
	table.sort(c)
	table.sort(m)
	return string.format("%d placements | %s | triangles ~%d | parts ~%d | missing kit: %s", #PLAN.placements, table.concat(c, " "), tris, parts, #m > 0 and table.concat(m, ",") or "none")
end
if MODE == "plan" then return "halo_props PLAN: " .. summary() end
assert(next(missing) == nil, "kit models missing in ServerStorage.WorldKit3D (import them first): " .. summary())
assert(tris <= T.TriCap and parts <= T.PartCap, "over budget: " .. summary())

------------------------------------------------------------------ apply
removeOurs()
restoreOld() -- start from the old state, then stash again below
old = old or Instance.new("Folder")
old.Name = "HaloPropsOld"
old.Parent = SS
local function stash(i)
	i:SetAttribute("HaloFrom", pathOf(i))
	i.Parent = old
end
local stashed = 0
for _, parent in { decor, landmarks } do
	if parent then
		for _, i in parent:GetChildren() do
			local nm = i.Name
			local protected = nm == "Bridge_Halo" or string.sub(nm, 1, 6) == "Bridge" or nm == "Roads" or nm == "HaloProps" or string.sub(nm, 1, 5) == "Gate_"
			local p = pivotOf(i)
			if not protected and ((OLD[nm]) or (string.sub(nm, 1, 10) == "Town_Halo_" and p and inRect(p))) then
				stash(i)
				stashed += 1
			end
		end
	end
end
-- the brown road strip of the old map (the paved spine is the road now)
local roads = decor:FindFirstChild("Roads")
if roads then
	local r = roads:FindFirstChild("RoadNorthIsland")
	if r then stash(r) stashed += 1 end
end

local groupOk = false
pcall(function() groupOk = PhysicsService:IsCollisionGroupRegistered(T.Group) end)
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Include
rp.FilterDescendantsInstances = { workspace.Terrain }
local function groundY(x, z, fallback)
	local hit = workspace:Raycast(Vector3.new(x, 80, z), Vector3.new(0, -160, 0), rp)
	if hit and hit.Material ~= Enum.Material.Water and math.abs(hit.Position.Y - fallback) < 4 then return hit.Position.Y end
	return fallback
end

local root = Instance.new("Model")
root.Name = "HaloProps"
root:SetAttribute("PlacedBy", "halo_props.luau")
local cells = {}
local function cell(x, z)
	local cx, cz = math.floor(x / T.CellSize), math.floor(z / T.CellSize)
	local key = cx .. "_" .. cz
	local m = cells[key]
	if not m then
		m = Instance.new("Model")
		m.Name = "Cell_" .. key
		m.Parent = root
		cells[key] = m
	end
	return m
end
local function clean(m, small)
	for _, d in m:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif small and d:IsA("SurfaceAppearance") then
			d.NormalMap = ""
			d.RoughnessMap = ""
		end
	end
end
local function setColl(m, mode)
	local player = mode == "player" and groupOk
	local hard = mode == "solid" or mode == "player"
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = hard
			p.CanQuery = hard
			p.CanTouch = false
			if mode == "back" then p.CastShadow = false end
			if player then p.CollisionGroup = T.Group end
		end
	end
	if mode == "player" then m:SetAttribute("DecorPlayerOnly", true) end
end
local function post(m, w, h, d, offset)
	local pt = Instance.new("Part")
	pt.Name = "BlockPost"
	pt.Size = Vector3.new(w, h, d)
	pt.CFrame = m:GetPivot() * CFrame.new(offset.X, offset.Y + h / 2, offset.Z)
	pt.Transparency = 1
	pt.Anchored, pt.CanCollide, pt.CanQuery, pt.CanTouch, pt.CastShadow = true, true, false, false, false
	if groupOk then pt.CollisionGroup = T.Group end
	pt.Parent = m
end

local built = 0
for _, e in PLAN.placements do
	if e.kind == "Gate" then continue end
	local src = kit:FindFirstChild(KITNAME[e.kind])
	local m = src:Clone()
	m.Name = (e.kind == "Fountain" and "Town_Halo_Fountain3") or (e.name and ("Halo_ArchBridge_" .. e.name)) or KITNAME[e.kind]
	clean(m, SMALL[e.kind])
	if math.abs(e.s - 1) > 1e-3 then pcall(m.ScaleTo, m, m:GetScale() * e.s) end
	local y = e.backdrop and e.y or groundY(e.x, e.z, e.y)
	local cf
	if e.kind == "ArchBridge" then
		local rise = (e.y1 - e.y0)
		local roll = math.atan2(rise, e.span + 8)
		if e.axis == "x" and e.x < 0 then roll = -roll end
		local _, size = m:GetBoundingBox()
		local deckY = (e.y0 + e.y1) / 2 - T.DeckFrac * size.Y
		cf = CFrame.new(e.x, deckY, e.z) * CFrame.Angles(0, math.rad(e.yaw), roll)
	else
		cf = CFrame.new(e.x, y, e.z) * CFrame.Angles(0, math.rad(e.yaw), 0)
	end
	m:PivotTo(cf)
	setColl(m, COLL[e.kind] or "solid")
	local _, sz = m:GetBoundingBox()
	if COLL[e.kind] == "post" then
		if e.kind == "CloudBush" then
			post(m, sz.X * 0.6, sz.Y * 0.6, sz.Z * 0.6, Vector3.zero)
		else
			post(m, 1.6, sz.Y * 0.7, 1.6, Vector3.zero)
		end
	end
	if e.backdrop then m:SetAttribute("Backdrop", true) end
	if SMALL[e.kind] or e.backdrop then m:SetAttribute("DecorTier", "lite") end -- a phone lite pass may hide these (zone_check #33)
	m.Parent = cell(e.x, e.z)
	built += 1
end
root.Parent = decor

------------------------------------------------------------------ the gate
local gateInfo = "no gate in the plan"
for _, e in PLAN.placements do
	if e.kind ~= "Gate" then continue end
	assert(gates, "Map.Gates missing")
	local oldGate = gates:FindFirstChild("Gate_HaloTown")
	if oldGate then stash(oldGate) stashed += 1 end
	local g = Instance.new("Model")
	g.Name = "Gate_HaloTown"
	g:SetAttribute("PlacedBy", "halo_props.luau")
	local look = kit:FindFirstChild(KITNAME.Gate):Clone()
	look.Name = "Look"
	clean(look, false)
	for _, p in look:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		end
	end
	local base = CFrame.new(e.x, groundY(e.x, e.z, e.y), e.z) * CFrame.Angles(0, math.rad(e.yaw), 0)
	look:PivotTo(base)
	look.Parent = g
	local function inv(name, size, cf, collide)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Transparency = 1
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, collide, collide, false, false
		p.Parent = g
		return p
	end
	local lp = e.lintel
	local lintel = inv("Lintel", Vector3.new(6, 1, 1), CFrame.new(lp[1], lp[2] + base.Y, lp[3]), false)
	g.PrimaryPart = lintel
	local ts = e.tower_size
	for i, t in e.towers do
		inv("TowerBlock" .. i, Vector3.new(ts[1], ts[2], ts[3]), base * CFrame.new(t[1], t[2], t[3]), true)
	end
	g.Parent = gates
	gateInfo = string.format("Gate_HaloTown at (%.1f, %.1f) lintel (%.1f, %.1f, %.1f), opening free between the two tower blocks", e.x, e.z, lp[1], lp[2] + base.Y, lp[3])
end

return string.format("halo_props applied | built %d + gate | stashed %d old | %s | %s | collision group %s", built, stashed, summary(), gateInfo, groupOk and T.Group or "NOT registered (player-only solids block everyone)")
