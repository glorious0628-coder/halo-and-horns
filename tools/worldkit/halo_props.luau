removeOurs()
restoreOld() -- start from the old state, then stash again below
old = old or Instance.new("Folder")
old.Name = "HaloPropsOld"
old.Parent = SS
local function stash(i)
	i:SetAttribute("HaloFrom", pathOf(i))
	i.Parent = old
end
local stashed = 0
for _, parent in { decor, landmarks } do
	if parent then
		for _, i in parent:GetChildren() do
			local nm = i.Name
			local protected = nm == "Bridge_Halo" or string.sub(nm, 1, 6) == "Bridge" or nm == "Roads" or nm == "HaloProps" or string.sub(nm, 1, 5) == "Gate_"
			local p = pivotOf(i)
			if not protected and not (nm == "Cathedral" and SKIP.Cathedral) and ((OLD[nm] and p and inRect(p)) or (string.sub(nm, 1, 10) == "Town_Halo_" and p and inRect(p))) then
				stash(i)
				stashed += 1
			end
		end
	end
end
-- the brown road strip of the old map (the paved spine is the road now)
local roads = decor:FindFirstChild("Roads")
if roads then
	local r = roads:FindFirstChild("RoadNorthIsland")
	if r then stash(r) stashed += 1 end
end

local groupOk = false
pcall(function() groupOk = PhysicsService:IsCollisionGroupRegistered(T.Group) end)
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Include
rp.FilterDescendantsInstances = { workspace.Terrain }
local function groundY(x, z, fallback)
	local hit = workspace:Raycast(Vector3.new(x, 80, z), Vector3.new(0, -160, 0), rp)
	if hit and hit.Material ~= Enum.Material.Water and math.abs(hit.Position.Y - fallback) < 4 then return hit.Position.Y end
	return fallback
end
-- the terrain top wherever it is (gold lines and medallions on the raised terraces: groundY above only accepts a hit near its
-- fallback, which buried them at Y 0 on tiers 2-4 until 2026-10-10)
local function groundTop(x, z)
	local hit = workspace:Raycast(Vector3.new(x, 80, z), Vector3.new(0, -160, 0), rp)
	if not hit or hit.Material == Enum.Material.Water then return 0 end
	-- the ray meets the paved voxels below the rendered surface on the raised tiers (measured 10/10 with decal plates:
	-- tier 2 hit 8.0 on Concrete, 8.98 on grass, the visible paving at ~10): snap to the nearest flat top of
	-- halo_terrain.luau and add the rendered rise (1 stud on the raised tops, 0 on the 0.2 gate/spawn tier)
	local y = hit.Position.Y
	for _, top in { 0.2, 3, 9, 12, 20, 22, 33 } do
		if y >= top - 1.6 and y <= top + 0.5 then return top > 1 and top + 1 or top end
	end
	return y
end

local root = Instance.new("Model")
root.Name = "HaloProps"
root:SetAttribute("PlacedBy", "halo_props.luau")
local cells = {}
local function cell(x, z)
	local cx, cz = math.floor(x / T.CellSize), math.floor(z / T.CellSize)
	local key = cx .. "_" .. cz
	local m = cells[key]
	if not m then
		m = Instance.new("Model")
		m.Name = "Cell_" .. key
		m.Parent = root
		cells[key] = m
	end
	return m
end
local function clean(m, small)
	for _, d in m:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
		-- 2026-10-10 (A23-107 재질): small props keep all four SurfaceAppearance maps too (the old colour-only cut made
		-- stone, gold and leaves read as the same flat plastic); `small` now only feeds the DecorTier lite flag below
	end
end
local function setColl(m, mode)
	local player = mode == "player" and groupOk
	local hard = mode == "solid" or mode == "player"
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = hard
			p.CanQuery = hard
			p.CanTouch = false
			if player then p.CollisionGroup = T.Group end
		end
	end
	if mode == "player" then m:SetAttribute("DecorPlayerOnly", true) end
end
local function post(m, w, h, d, offset)
	local pt = Instance.new("Part")
	pt.Name = "BlockPost"
	pt.Size = Vector3.new(w, h, d)
	pt.CFrame = m:GetPivot() * CFrame.new(offset.X, offset.Y + h / 2, offset.Z)
	pt.Transparency = 1
	pt.Anchored, pt.CanCollide, pt.CanQuery, pt.CanTouch, pt.CastShadow = true, true, false, false, false
	if groupOk then pt.CollisionGroup = T.Group end
	pt.Parent = m
end

local built = 0
for _, e in PLAN.placements do
	if e.kind == "Gate" or SKIP[e.kind] then continue end
	local src = kit:FindFirstChild(KITNAME[e.kind])
	local m = src:Clone()
	m.Name = (e.kind == "Fountain" and "Town_Halo_Fountain3") or (e.name and ("Halo_ArchBridge_" .. e.name)) or KITNAME[e.kind]
	clean(m, SMALL[e.kind])
	if e.sv then -- non-uniform stretch of the single MeshPart (the stairs fit their ramp): x width, y rise, z run
		for _, mp in m:GetDescendants() do
			if mp:IsA("MeshPart") then
				mp.Size = Vector3.new(mp.Size.X * e.sv[1], mp.Size.Y * e.sv[2], mp.Size.Z * e.sv[3])
				mp.PivotOffset = CFrame.new(0, -mp.Size.Y / 2, 0)
			end
		end
	elseif math.abs(e.s - 1) > 1e-3 then
		pcall(m.ScaleTo, m, m:GetScale() * e.s)
	end
	local _, sz0 = m:GetBoundingBox() -- model-local extents (the clone still sits unrotated at the origin): X width, Y height, Z depth, front = -Z
	local y = (e.backdrop or e.ramp) and e.y or groundY(e.x, e.z, e.y)
	local cf
	if e.kind == "ArchBridge" then
		local rise = (e.y1 - e.y0)
		local roll = math.atan2(rise, e.span + 8)
		if e.axis == "x" and e.x < 0 then roll = -roll end
		local _, size = m:GetBoundingBox()
		local deckY = (e.y0 + e.y1) / 2 - T.DeckFrac * size.Y
		cf = CFrame.new(e.x, deckY, e.z) * CFrame.Angles(0, math.rad(e.yaw), roll)
	else
		cf = CFrame.new(e.x, y, e.z) * CFrame.Angles(0, math.rad(e.yaw), 0)
	end
	m:PivotTo(cf)
	setColl(m, COLL[e.kind] or "solid")
	local sz = sz0
	if COLL[e.kind] == "post" then
		if e.kind == "CloudBush" then
			post(m, sz.X * 0.6, sz.Y * 0.6, sz.Z * 0.6, Vector3.zero)
		else
			post(m, 1.6, sz.Y * 0.7, 1.6, Vector3.zero)
		end
	end
	local dd = DOOR[e.kind]
	if dd then
		m:SetAttribute("Door", true)
		m:SetAttribute("DoorSize", Vector2.new(dd[1] * e.s, dd[2] * e.s))
		m:SetAttribute("DoorFront", Vector3.new(0, dd[3] * e.s, -(sz.Z / 2) - 1.5)) -- a point 1.5 studs in front of the door, model-local (pivot = bottom centre, front = -Z)
		if dd[4] then m:SetAttribute("DoorTooSmall", true) end
	end
	lampSeen[e.kind] = (lampSeen[e.kind] or 0) + 1
	local lampSpots = LAMP[e.kind] and LAMP_EVERY[e.kind] and (lampSeen[e.kind] - 1) % LAMP_EVERY[e.kind] == 0 and LAMP[e.kind] or nil
	if lampSpots then -- night lamps (이미지 개발 WeatherFx switches them on): LampLight = true + one disabled PointLight per lit spot
		m:SetAttribute("LampLight", true)
		for i, off in lampSpots do
			if i > LAMP_SPOTS[e.kind] then break end
			local lp = Instance.new("Part")
			lp.Name = "LampLightPart" .. i
			lp.Size = Vector3.new(0.4, 0.4, 0.4)
			lp.Transparency = 1
			lp.Anchored, lp.CanCollide, lp.CanQuery, lp.CanTouch, lp.CastShadow = true, false, false, false, false
			lp.CFrame = m:GetPivot() * CFrame.new(off * e.s)
			local pl = Instance.new("PointLight")
			pl.Name = "LampLight"
			pl.Color = Color3.fromRGB(255, 214, 130)
			pl.Brightness = 1.2
			pl.Range = 16
			pl.Shadows = false
			pl.Enabled = false
			pl.Parent = lp
			lp.Parent = m
		end
	end
	if NOSHADOW[e.kind] then
		for _, p in m:GetDescendants() do
			if p:IsA("BasePart") then p.CastShadow = false end
		end
	end
	if e.shopkind and SIGN[e.shopkind] then -- a thin board standing OUT of the wall (perpendicular), readable from both sides while walking past (검수)
		m:SetAttribute("ShopKind", e.shopkind)
		local side = 7 * e.s / 1.9
		local board = Instance.new("Part")
		board.Name = "SignBoard"
		board.Size = Vector3.new(0.2, side, side) -- X thickness, Y height, Z reach out of the wall
		board.Transparency = 1
		board.Anchored, board.CanCollide, board.CanQuery, board.CanTouch, board.CastShadow = true, false, false, false, false
		board.CFrame = m:GetPivot() * CFrame.new(sz.X / 2 - 3.5, sz.Y * 0.40, -(sz.Z / 2) - side / 2)
		for _, face in { Enum.NormalId.Right, Enum.NormalId.Left } do
			local gui = Instance.new("SurfaceGui")
			gui.Face = face
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 60
			gui.LightInfluence = 0
			gui.Parent = board
			local img = Instance.new("ImageLabel")
			img.BackgroundTransparency = 1
			img.Size = UDim2.fromScale(1, 1)
			img.Image = SIGN[e.shopkind]
			if face == Enum.NormalId.Left then -- the far side shows the board mirrored so the wall bracket still sits at the wall
				img.ImageRectOffset = Vector2.new(1024, 0)
				img.ImageRectSize = Vector2.new(-1024, 1024)
			end
			img.Parent = gui
		end
		board.Parent = m
	end
	if e.backdrop then m:SetAttribute("Backdrop", true) end
	if SMALL[e.kind] or e.backdrop then m:SetAttribute("DecorTier", "lite") end -- a phone lite pass may hide these (zone_check #33)
	m.Parent = cell(e.x, e.z)
	built += 1
end
root.Parent = decor

------------------------------------------------------------------ the gate
local gateInfo = "no gate in the plan"
for _, e in PLAN.placements do
	if e.kind ~= "Gate" then continue end
	assert(gates, "Map.Gates missing")
	local oldGate = gates:FindFirstChild("Gate_HaloTown")
	if oldGate then stash(oldGate) stashed += 1 end
	local g = Instance.new("Model")
	g.Name = "Gate_HaloTown"
	g:SetAttribute("PlacedBy", "halo_props.luau")
	local look = kit:FindFirstChild(KITNAME.Gate):Clone()
	look.Name = "Look"
	clean(look, false)
	-- 2026-10-10 (검수 ①): the split gate tiles collide with PreciseConvexDecomposition — the raised passage floor (a hump up to
	-- 7.6 studs), the lantern pedestals and the low walls are now solid, and rays at y 9..18 through the arch stay clear
	-- (measured in WorldKit), so the two invisible tower blocks are gone
	for _, p in look:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, true, true, false
		end
	end
	local base = CFrame.new(e.x, groundY(e.x, e.z, e.y), e.z) * CFrame.Angles(0, math.rad(e.yaw), 0)
	look:PivotTo(base)
	look.Parent = g
	local function inv(name, size, cf, collide)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Transparency = 1
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, collide, collide, false, false
		p.Parent = g
		return p
	end
	local lp = e.lintel
	local lintel = inv("Lintel", Vector3.new(6, 1, 1), CFrame.new(lp[1], lp[2] + base.Y, lp[3]), false)
	g.PrimaryPart = lintel
	g:SetAttribute("LampLight", true)
	for i, off in LAMP.Gate do
		if i > LAMP_SPOTS.Gate then break end
		local lpart = inv("LampLightPart" .. i, Vector3.new(0.4, 0.4, 0.4), base * CFrame.new(off), false)
		local pl = Instance.new("PointLight")
		pl.Name = "LampLight"
		pl.Color = Color3.fromRGB(255, 214, 130)
		pl.Brightness = 1.2
		pl.Range = 16
		pl.Shadows = false
		pl.Enabled = false
		pl.Parent = lpart
	end
	g.Parent = gates
	gateInfo = string.format("Gate_HaloTown at (%.1f, %.1f) lintel (%.1f, %.1f, %.1f), mesh collision (PreciseConvexDecomposition), passage open", e.x, e.z, lp[1], lp[2] + base.Y, lp[3])
end


------------------------------------------------------------------ gold inlay lines on the paving (thin Parts, one per ~6 studs, laid on the terrain surface)
local goldFolder = Instance.new("Model")
goldFolder.Name = "HaloGold"
goldFolder:SetAttribute("PlacedBy", "halo_props.luau")
local goldCount = 0
local GOLD_COLOR = Color3.fromRGB(236, 194, 88)
for _, poly in PLAN.gold or {} do
	local ys = {}
	for i, pt in poly do
		ys[i] = groundTop(pt[1], pt[2])
	end
	for i = 1, #poly - 1 do
		local a = Vector3.new(poly[i][1], ys[i] + 0.09, poly[i][2])
		local b = Vector3.new(poly[i + 1][1], ys[i + 1] + 0.09, poly[i + 1][2])
		local len = (b - a).Magnitude
		if len > 0.5 and len < 14 and math.abs(b.Y - a.Y) < 6 then -- skip a segment that jumps a wall / stair step
			local seg = Instance.new("Part")
			seg.Name = "GoldLine"
			seg.Size = Vector3.new(0.7, 0.12, len + 0.15)
			seg.CFrame = CFrame.lookAt((a + b) / 2, b)
			seg.Color = GOLD_COLOR
			seg.Material = Enum.Material.Metal
			seg.Reflectance = 0.08
			seg.Anchored, seg.CanCollide, seg.CanQuery, seg.CanTouch, seg.CastShadow = true, false, false, false, false
			seg.Parent = goldFolder
			goldCount += 1
		end
	end
end
-- floor medallions (이미지 생성 2 HaloFloor_Medallion_A, 검수 10/10): a round Decal on a thin invisible plate at each spot
-- (plaza, gate road, cathedral forecourt), laid on the paving; kept inside HaloGold so remove/apply clears them together
local MEDALLION = "rbxassetid://103293671792155"
local medCount = 0
for _, m in PLAN.medallions or {} do
	local y = groundTop(m.x, m.z)
	local plate = Instance.new("Part")
	plate.Name = "Medallion"
	plate.Size = Vector3.new(m.r * 2, 0.05, m.r * 2)
	plate.CFrame = CFrame.new(m.x, y + 0.06, m.z)
	plate.Transparency = 1
	plate.Anchored, plate.CanCollide, plate.CanQuery, plate.CanTouch, plate.CastShadow = true, false, false, false, false
	local d = Instance.new("Decal")
	d.Texture = MEDALLION
	d.Face = Enum.NormalId.Top
	d.Parent = plate
	plate.Parent = goldFolder
	medCount += 1
end
goldFolder.Parent = decor

return string.format("halo_props applied | built %d + gate + %d gold lines + %d medallions | stashed %d old | %s | %s | collision group %s", built, goldCount, medCount, stashed, summary(), gateInfo, groupOk and T.Group or "NOT registered (player-only solids block everyone)")
