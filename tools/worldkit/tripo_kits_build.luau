local out = {}
for _, k in K do
  local name, cm, nm, mm, rm, two = k[1], k[2], k[3], k[4], k[5], k[6]
  local src = workspace:FindFirstChild(name .. "_TU")
  local mp0 = src and src:FindFirstChildWhichIsA("MeshPart", true)
  if not mp0 then table.insert(out, name .. " MISSING"); continue end
  local old = F:FindFirstChild(name); if old then old:Destroy() end
  local mp = mp0:Clone()
  for _, c in mp:GetChildren() do c:Destroy() end
  mp.Name = name; mp.Anchored = true; mp.TextureID = ""
  local sa = Instance.new("SurfaceAppearance")
  sa.ColorMap = cm; sa.NormalMap = nm; sa.MetalnessMap = mm; sa.RoughnessMap = rm; sa.Parent = mp
  pcall(function() mp.DoubleSided = two end)
  local R0 = mp0.CFrame - mp0.CFrame.Position
  mp.CFrame = CFrame.new(0, mp.Size.Y / 2, 0) * R0   -- the imported mesh already faces -Z (10/13: an extra 180 turned every kit backwards)
  local m = Instance.new("Model"); m.Name = name
  mp.Parent = m   -- no PrimaryPart: WorldPivot stays the bottom centre (10/13 fix)
  m.WorldPivot = CFrame.new(0, 0, 0)
  m:SetAttribute("TripoKit", true); m:SetAttribute("SrcMesh", mp.MeshId)
  m.Parent = F
  table.insert(out, string.format("%s ok %.2f", name, mp.Size.Y))
end
return table.concat(out, " | ")
