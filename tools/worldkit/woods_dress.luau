------------------------------------------------------------------ helpers
local function kitModel(name) return kitFolder:FindFirstChild(name) end
local SIZE = {}
local function info(name) -- { radius at scale 1, parts }
	local s = SIZE[name]
	if s ~= nil then return s end
	local src = kitModel(name)
	if not src then
		SIZE[name] = false
		return false
	end
	local size = src:IsA("Model") and select(2, src:GetBoundingBox()) or src.Size
	local n = 0
	for _, d in src:GetDescendants() do if d:IsA("BasePart") then n += 1 end end
	if src:IsA("BasePart") then n = 1 end
	s = { R = math.max(size.X, size.Z) / 2, H = size.Y, Parts = n }
	SIZE[name] = s
	return s
end
local function flat(a, b) return math.sqrt((a.X - b.X) ^ 2 + (a.Z - b.Z) ^ 2) end
local function yawToward(from, to)
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if d.Magnitude < 1e-3 then return 0 end
	return math.deg(math.atan2(-d.X, -d.Z))
end
local function segDist(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local ll = dx * dx + dz * dz
	local t = ll == 0 and 0 or math.clamp(((px - ax) * dx + (pz - az) * dz) / ll, 0, 1)
	return math.sqrt((px - ax - t * dx) ^ 2 + (pz - az - t * dz) ^ 2)
end
local function polyDist(pts, x, z)
	local best = math.huge
	for i = 1, #pts - 1 do best = math.min(best, segDist(x, z, pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2])) end
	return best
end
local function inLand(x, z, inset)
	return x >= LAND.MinX + inset and x <= LAND.MaxX - inset and z >= LAND.MinZ + inset and z <= LAND.MaxZ - inset
end
local function edgeDist(x, z) return math.min(x - LAND.MinX, LAND.MaxX - x, z - LAND.MinZ, LAND.MaxZ - z) end

-- eyes: remember / restore the colour
local function eyes(color)
	local n = 0
	for _, d in decor:GetChildren() do
		if d.Name == "RedEye" and d:IsA("BasePart") then
			if color then
				if d:GetAttribute("WoodsDressWas") == nil then d:SetAttribute("WoodsDressWas", d.Color) end
				d.Color = color
			else
				local was = d:GetAttribute("WoodsDressWas")
				if typeof(was) == "Color3" then d.Color = was end
				d:SetAttribute("WoodsDressWas", nil)
			end
			n += 1
		end
	end
	return n
end

-- arrival landmark (검수 2026-10-09): the face-less W_Totem from woods_kit_place grows 1.5x (pivot = bottom centre, so it
-- stays on the ground); "old" shrinks it back. W_Gate (the primitive Gate_GoblinWoods swap) is a gates job: T.Gate stays false.
local TOTEM_SCALE = 1.5
local function totem(grow)
	local wk = decor:FindFirstChild("WoodsKit")
	local n = 0
	if not wk then return 0 end
	for _, m in wk:GetChildren() do
		if m.Name == "W_Totem" and m:IsA("Model") then
			local done = m:GetAttribute("WoodsDressGrown") == true
			if grow and not done then
				m:ScaleTo(m:GetScale() * TOTEM_SCALE)
				m:SetAttribute("WoodsDressGrown", true)
				n += 1
			elseif not grow and done then
				m:ScaleTo(m:GetScale() / TOTEM_SCALE)
				m:SetAttribute("WoodsDressGrown", nil)
				n += 1
			end
		end
	end
	return n
end

if MODE == "old" then
	local old = decor:FindFirstChild("WoodsDress")
	if old then old:Destroy() end
	return "WoodsDress removed | eyes restored: " .. eyes(nil) .. " | totem shrunk: " .. totem(false)
end

------------------------------------------------------------------ ground
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Include
rp.FilterDescendantsInstances = { workspace.Terrain, map:FindFirstChild("Ground") }
local function ground(x, z)
	local hit = workspace:Raycast(Vector3.new(x, 300, z), Vector3.new(0, -600, 0), rp)
	if not hit or hit.Material == Enum.Material.Water then return nil end
	return hit.Position.Y, hit.Normal, hit.Material.Name
end

