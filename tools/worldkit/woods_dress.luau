	o = o or {}
	local n = rng:NextInteger(1, 2) == 1 and "W_Boulder_A" or "W_Boulder_B"
	o.Gap = o.Gap or 0.9
	return put(n, x, z, o)
end
local creekLine = {}
for i, q in CREEK do creekLine[i] = q end
local function creekAt(t) -- point at fraction t along the creek polyline (by index, good enough for bank rocks)
	local f = t * (#creekLine - 1) + 1
	local i = math.min(#creekLine - 1, math.floor(f))
	local u = f - i
	return creekLine[i][1] + (creekLine[i + 1][1] - creekLine[i][1]) * u, creekLine[i][2] + (creekLine[i + 1][2] - creekLine[i][2]) * u
end
do
	local wf = PLAN.waterfall
	for _, a in { 40, 90, 140 } do -- both flanks of the falls: rocks on the ledge sides and at the pool
		local ang = math.rad(a)
		boulder(wf.c[1] - math.cos(ang) * 13, wf.c[2] + math.sin(ang) * 13, { S = rng:NextNumber(1.2, 1.7), AnyGround = true })
	end
	for k = 0, 7 do -- creek banks, both sides, alternating
		local t = (k + 0.5) / 8
		local x, z = creekAt(t)
		local side = (k % 2 == 0) and 1 or -1
		boulder(x + rng:NextNumber(-3, 3), z + side * rng:NextNumber(9, 12), { AnyGround = true })
	end
	for _, g in PLAN.boulder_groups do -- the plan's groups: 1 big moss boulder + (n-1) rocks around
		local c, n = g[1], g[2]
		if n >= 3 then boulder(c[1], c[2], { AnyGround = true }) else put("Kit_W_MossRock", c[1], c[2], { AnyGround = true }) end
		for k = 1, n - 1 do
			local a = rng:NextNumber(0, math.pi * 2)
			put("Kit_W_MossRock", c[1] + math.cos(a) * rng:NextNumber(5, 8), c[2] + math.sin(a) * rng:NextNumber(5, 8), {})
		end
	end
	local rimHits = 0 -- big boulders on the forest rim (edge distance 12..24), spaced
	for k = 1, 160 do
		if rimHits >= 8 then break end
		local side = rng:NextInteger(1, 4)
		local u = rng:NextNumber(0, 1)
		local d = rng:NextNumber(12, 24)
		local x = side == 1 and LAND.MinX + d or (side == 2 and LAND.MaxX - d or LAND.MinX + u * (LAND.MaxX - LAND.MinX))
		local z = side == 3 and LAND.MinZ + d or (side == 4 and LAND.MaxZ - d or LAND.MinZ + u * (LAND.MaxZ - LAND.MinZ))
		if boulder(x, z, { Gap = 1.3 }) then rimHits += 1 end
	end
end

------------------------------------------------------------------ tier 3: step stones where the paths meet the creek
for _, x in { 880, 1030 } do
	local zc = -150 - 20 -- from the trail toward the creek
	local zEnd = -205
	for k = 0, 2 do
		local z = zc + (zEnd - zc) * (k / 2)
		put("Kit_W_StepStones", x + rng:NextNumber(-1.5, 1.5), z, { Paths = true, Gap = 0.3, S = 1.2, Yaw = rng:NextNumber(0, 360) })
	end
end

-- option A (검수 2026-10-09): camps 1 and 2 read as one cluster: stones on the camp1to2 dirt path, moss rocks along it
do
	local path
	for _, p in PLAN.paths do if p.name == "camp1to2" then path = p.pts end end
	if path then
		local pts = {}
		local total = 0
		for i = 1, #path - 1 do total += math.sqrt((path[i + 1][1] - path[i][1]) ^ 2 + (path[i + 1][2] - path[i][2]) ^ 2) end
		local function along(f)
			local want, acc = f * total, 0
			for i = 1, #path - 1 do
				local d = math.sqrt((path[i + 1][1] - path[i][1]) ^ 2 + (path[i + 1][2] - path[i][2]) ^ 2)
				if acc + d >= want then
					local t = (want - acc) / d
					return path[i][1] + (path[i + 1][1] - path[i][1]) * t, path[i][2] + (path[i + 1][2] - path[i][2]) * t, path[i + 1][1] - path[i][1], path[i + 1][2] - path[i][2]
				end
				acc += d
			end
			return path[#path][1], path[#path][2], 1, 0
		end
		for k = 1, 8 do
			local x, z, dx, dz = along((k - 0.5) / 8)
			local len = math.max(1e-3, math.sqrt(dx * dx + dz * dz))
			local nx, nz = -dz / len, dx / len
			local side = (k % 2 == 0) and 1 or -1
			if k % 3 == 1 then
				put("Kit_W_StepStones", x, z, { Paths = true, AnyGround = true, Gap = 0.3, S = 1.15, Yaw = math.deg(math.atan2(-dx, -dz)) })
			end
			put("Kit_W_MossRock", x + nx * side * 5.5, z + nz * side * 5.5, { Gap = 0.8 })
		end
	end
end

------------------------------------------------------------------ tier 4: undergrowth (jittered grid, weighted)
local function weight(x, z)
	local e = edgeDist(x, z)
	local w = 0.28
	if e < 60 then w += 0.62 * (1 - e / 60) end -- thicker on the rim: the forest wall
	local dp = math.huge
	for _, p in PATHS do dp = math.min(dp, polyDist(p.Pts, x, z) - p.W / 2) end
	if dp < 16 then w += 0.30 * (1 - dp / 16) end -- along the dirt paths
	for _, c in PLAN.camp_clearings do
		local d = flat({ X = x, Z = z }, { X = c.c[1], Z = c.c[2] }) - c.r
		if d > 0 and d < 14 then w += 0.35 * (1 - d / 14) end -- round the camps
	end
	for _, q in trees do
		local d = flat({ X = x, Z = z }, { X = q[1], Z = q[2] }) - q[3]
		if d > 0 and d < 8 then w += 0.30 * (1 - d / 8) end -- at tree feet
	end
	return math.min(w, 1)
end
local LAYERS = { -- Max = pieces per layer (the phone budget, in the order of what the eye needs first)
	{ Name = "mushroom", Kinds = { "Kit_W_Mushrooms" }, Cell = 26, Gap = 0.8, Scale = 0.5, Max = 15 },
	{ Name = "rock", Kinds = { "Kit_W_MossRock" }, Cell = 24, Gap = 0.9, Scale = 0.6, Max = 24 },
	{ Name = "bush", Kinds = { "Kit_W_BushA", "Kit_W_BushB" }, Cell = 15, Gap = 0.8, Max = 80 },
	{ Name = "fern", Kinds = { "Kit_W_Fern" }, Cell = 10, Gap = 0.7, Max = 50 },
}
for _, L in LAYERS do
	local cand = {}
	for gx = LAND.MinX + T.Inset, LAND.MaxX - T.Inset, L.Cell do
		for gz = LAND.MinZ + T.Inset, LAND.MaxZ - T.Inset, L.Cell do
			local x = gx + rng:NextNumber(0, L.Cell)
			local z = gz + rng:NextNumber(0, L.Cell)
			local w = weight(x, z) * (L.Scale or 1)
			local pick = rng:NextNumber()
			local kind = L.Kinds[rng:NextInteger(1, #L.Kinds)]
			if pick < w then table.insert(cand, { x, z, kind, w }) end
		end
	end
	for i = #cand, 2, -1 do -- deterministic shuffle: the cap never favours one side of the map
		local j = rng:NextInteger(1, i)
		cand[i], cand[j] = cand[j], cand[i]
	end
	local n = 0
	for _, c in cand do
		if n >= L.Max then break end
		if put(c[3], c[1], c[2], { Gap = L.Gap }) then n += 1 end
	end
end

------------------------------------------------------------------ report / plan
local function counts()
	local c, names = {}, {}
	for _, e in plan do
		if not c[e.Name] then table.insert(names, e.Name) end
		c[e.Name] = (c[e.Name] or 0) + 1
	end
	table.sort(names)
	local out = {}
	for _, k in names do table.insert(out, k .. " x" .. c[k]) end
	return table.concat(out, ", ")
end
local function why()
	local out = {}
	for k, v in refused do table.insert(out, k .. " " .. v) end
	table.sort(out)
	return table.concat(out, ", ")
end
local summary = string.format("%d pieces, %d parts, %d triangles (cap %d), whole-map parts %d -> %d (cap %d) | WoodsKit pieces seen %d | %s\nrefused: %s",
	#plan, partsPlanned, tris, T.TriCap, partCount, partCount + partsPlanned, T.PartCap, wkCount, counts(), why())
if MODE == "dry" then return "dry: " .. summary end
if MODE == "plan" then
	local rows = {}
	for _, e in plan do table.insert(rows, string.format("%s,%.1f,%.1f,%.1f,%.0f", e.Name, e.X, e.Z, info(e.Name).R * e.S, e.Yaw)) end
	return table.concat(rows, ";")
end

------------------------------------------------------------------ build
local old = decor:FindFirstChild("WoodsDress")
if old then old:Destroy() end
local groupOk = false
pcall(function() groupOk = PhysicsService:IsCollisionGroupRegistered(T.PlayerOnlyGroup) end)
local root = Instance.new("Model")
root.Name = "WoodsDress"
root:SetAttribute("PlacedBy", "woods_dress.luau")
local cells = {}
local function cell(x, z)
	local cx, cz = math.floor(x / T.CellSize), math.floor(z / T.CellSize)
	local key = cx .. "_" .. cz
	local m = cells[key]
	if not m then
		m = Instance.new("Model")
		m.Name = "Cell_" .. key
		m.Parent = root
		cells[key] = m
	end
	return m
end
local function sit(m, y)
	local cf, size = m:GetBoundingBox()
	m:PivotTo(m:GetPivot() + Vector3.new(0, y - (cf.Position.Y - size.Y / 2), 0))
end
for _, e in plan do
	local src = kitModel(e.Name)
	local m = src:Clone()
	m.Name = e.Name
	for _, d in m:GetDescendants() do
		if d:IsA("LuaSourceContainer") then d:Destroy() end
	end
	if KIND[e.Name].Moss and T.Moss[e.Name] then
		for _, sa in m:GetDescendants() do
			if sa:IsA("SurfaceAppearance") then sa.ColorMap = T.Moss[e.Name] end
		end
	end
	if e.Name == "Kit_W_CampFence" then
		for _, mp in m:GetDescendants() do
			if mp:IsA("MeshPart") then mp.TextureID = T.FenceTex end
		end
	end
	if math.abs(e.S - 1) > 1e-3 then pcall(m.ScaleTo, m, m:GetScale() * e.S) end
	m:PivotTo(CFrame.new(e.X, e.Y, e.Z) * CFrame.Angles(0, math.rad(e.Yaw), 0))
	sit(m, e.Y - 0.05)
	if e.Tilt and e.Tilt > 0 and e.N then -- lean onto the ground normal round the bottom centre
		local up = Vector3.yAxis
		local nrm = up:Lerp(e.N, e.Tilt).Unit
		local axis = up:Cross(nrm)
		if axis.Magnitude > 1e-4 then
			local rot = CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(up:Dot(nrm), -1, 1)))
			local base = CFrame.new(e.X, e.Y - 0.05, e.Z)
			m:PivotTo(base * rot * base:ToObjectSpace(m:GetPivot()))
		end
	end
	local playerOnly = e.Coll == "player" and groupOk
	local hard = e.Coll == "player"
	local longest = math.max(info(e.Name).R * 2 * e.S, info(e.Name).H * e.S)
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = hard
			p.CanQuery = hard
			p.CanTouch = false
			p.CastShadow = longest >= 4
			if playerOnly then p.CollisionGroup = T.PlayerOnlyGroup end
		end
	end
	if hard then m:SetAttribute("DecorPlayerOnly", true) end
	m.Parent = cell(e.X, e.Z)
end
root.Parent = decor

