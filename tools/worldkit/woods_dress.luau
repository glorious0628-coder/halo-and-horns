local plan = {} -- { Name, X, Z, Y, N, Yaw, S, Tier, Why }
local refused = {}
local tris, partsPlanned = 0, 0
local placed = {} -- spatial list for spacing checks { x, z, r, solid }
local function refuse(why) refused[why] = (refused[why] or 0) + 1 end

local function blocked(name, x, z, r, o)
	o = o or {}
	if not inLand(x, z, T.Inset) then return "edge" end
	if not o.Road and math.abs(z - KEEP.crown_road_z) < T.RoadHalf then return "road" end
	if not o.Paths then
		for _, p in PATHS do
			if polyDist(p.Pts, x, z) < p.W / 2 + T.PathPad + r * 0.5 then return "path" end
		end
	end
	if flat({ X = x, Z = z }, { X = KEEP.giant[1], Z = KEEP.giant[2] }) < T.GiantClear then return "giant" end
	if flat({ X = x, Z = z }, { X = KEEP.boss[1], Z = KEEP.boss[2] }) < T.BossClear then return "boss" end
	if flat({ X = x, Z = z }, { X = KEEP.arrival[1], Z = KEEP.arrival[2] }) < T.ArrivalClear then return "arrival" end
	if not o.Camp then
		for _, c in PLAN.camp_clearings do
			if flat({ X = x, Z = z }, { X = c.c[1], Z = c.c[2] }) < c.r + 2 + r * 0.5 then return "camp" end
		end
	end
	if not o.NoReserve then
		for _, q in reserved do
			if flat({ X = x, Z = z }, { X = q[1], Z = q[2] }) < q[3] + r * 0.6 then return "piece" end
		end
	end
	for _, q in trees do
		if flat({ X = x, Z = z }, { X = q[1], Z = q[2] }) < q[3] + r * 0.5 + 0.5 then return "trunk" end
	end
	local gap = o.Gap or 0.85
	for _, q in placed do
		if flat({ X = x, Z = z }, { X = q[1], Z = q[2] }) < (q[3] + r) * gap then return "crowd" end
	end
	return nil
end

local partCount = 0
for _, d in map:GetDescendants() do if d:IsA("BasePart") then partCount += 1 end end
local oldDress = decor:FindFirstChild("WoodsDress")
if oldDress then for _, d in oldDress:GetDescendants() do if d:IsA("BasePart") then partCount -= 1 end end end

-- try one piece; returns true when placed
local rng = Random.new(T.Seed)
local function put(name, x, z, o)
	o = o or {}
	local def, inf = KIND[name], info(name)
	if not (def and inf) then return refuse("missing kit " .. name) end
	local s = o.S or rng:NextNumber(def.S[1], def.S[2])
	local r = inf.R * s * (o.RScale or 1)
	local y, n, mat = ground(x, z)
	if not y then return refuse("ground") end
	if y < T.MinY or y > T.MaxY then return refuse("height") end
	if n.Y < T.MaxSlope then return refuse("steep") end
	if not (def.Ground[mat] or o.AnyGround) then return refuse("material " .. mat) end
	local why = blocked(name, x, z, r, o)
	if why then return refuse(why) end
	if tris + def.Tris > T.TriCap then return refuse("tri cap") end
	if partCount + partsPlanned + inf.Parts > T.PartCap then return refuse("part cap") end
	tris += def.Tris
	partsPlanned += inf.Parts
	table.insert(plan, { Name = name, X = x, Z = z, Y = y, N = n, Yaw = o.Yaw or rng:NextNumber(0, 360), S = s, Coll = def.Coll, Tilt = o.Tilt or def.Tilt })
	if not o.NoSpace then table.insert(placed, { x, z, r, def.Coll ~= nil }) end
	return true
end

------------------------------------------------------------------ tier 1: camps
local CAMPS = {
	{ Pos = Vector3.new(PLAN.camp_clearings[1].c[1], 0, PLAN.camp_clearings[1].c[2]), Road = Vector3.new(0, 0, -1) },
	{ Pos = Vector3.new(PLAN.camp_clearings[2].c[1], 0, PLAN.camp_clearings[2].c[2]), Road = Vector3.new(0, 0, -1) },
	{ Pos = Vector3.new(PLAN.camp_clearings[3].c[1], 0, PLAN.camp_clearings[3].c[2]), Road = Vector3.new(-1, 0, 0) },
}
for i, c in CAMPS do
	local back = -c.Road
	local side = Vector3.new(-c.Road.Z, 0, c.Road.X)
	local function at(b, s) return c.Pos + back * b + side * s end
		-- stake fence: the ring continues past woods_kit_place's arcs (a 50..100 deg) to the entrance gap (a 170..190)
	for _, s in { 1, -1 } do
		for _, a in { 125, 142, 158 } do
			local p = at(math.cos(math.rad(a)) * 16, s * math.sin(math.rad(a)) * 16)
			put("Kit_W_CampFence", p.X, p.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0.4, Yaw = yawToward(p, c.Pos), S = 1 })
		end
		for _, a in { 62, 87, 112, 137 } do -- an outer second row, offset between the first
			local p = at(math.cos(math.rad(a)) * 19.5, s * math.sin(math.rad(a)) * 19.5)
			put("Kit_W_CampFence", p.X, p.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0.4, Yaw = yawToward(p, c.Pos), S = 1 })
		end
	end
	for k = 0, 5 do -- log stools round the fire
		local a = math.rad(30 + k * 60)
		local p = c.Pos + Vector3.new(math.cos(a) * 6.2, 0, math.sin(a) * 6.2)
		put("Kit_W_LogStool", p.X, p.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0.4, Yaw = yawToward(p, c.Pos) + rng:NextNumber(-12, 12), S = 1 })
	end
	put("Kit_W_Campfire", c.Pos.X, c.Pos.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0, Yaw = i * 40, S = 1, NoSpace = true, NoReserve = true })
	local aw = at(10, -9.5)
	put("Kit_W_Awning", aw.X, aw.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0.3, Yaw = yawToward(aw, c.Pos), S = 1.1 })
	for _, s in { 1, -1 } do
		local b = at(-13, s * 6)
		put("Kit_W_Banner", b.X, b.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0.3, Yaw = yawToward(b, c.Pos), S = 1 })
	end
	for _, a in { 62, -62, 150, -150 } do -- lantern posts (the model's own glow, no light)
		local p = at(math.cos(math.rad(a)) * 12.5, math.sin(math.rad(a)) * 12.5)
		put("Kit_W_LanternPost", p.X, p.Z, { Camp = true, AnyGround = true, Paths = true, Road = true, Gap = 0.3, Yaw = yawToward(p, c.Pos), S = 1 })
	end
end

